function RimuruEvol2_Start takes unit c,boolean b returns nothing
    local real r8= 0
    local integer k2= GetPlayerId(GetOwningPlayer(c))
    local real tmp_y= 0
    local integer k= 0
    local real x= GetUnitX(c)
    local real y= GetUnitY(c)
    local integer k3= RimuruEvol2_Counter
    if b == true then
        if s__frameRimuru2_pas1[k2] == null then
            set s__frameRimuru2_pas1[k2]= BlzCreateFrameByType("BACKDROP", "SS", BlzGetFrameByName("ConsoleUIBackdrop", 0), "", 0)
            call BlzFrameSetAbsPoint(s__frameRimuru2_pas1[k2], FRAMEPOINT_CENTER, 0.055, 0.18 + tmp_y)
            call BlzFrameSetSize(s__frameRimuru2_pas1[k2], 0.135, 0.035)
