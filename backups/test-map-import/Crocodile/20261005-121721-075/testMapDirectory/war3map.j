            set s__FrierenSpells__FrierenSpells_Q2_check[this]=0
            set s__FrierenSpells__FrierenSpells_Q2_g3[this]=LoadGroupHandle(hs, GetHandleId(s__FrierenSpells__FrierenSpells_Q2_c[this]), StringHash("frieren q group"))
            set s__FrierenSpells__FrierenSpells_Q2_targetCount[this]=GetUnitsCountInGroup(s__FrierenSpells__FrierenSpells_Q2_g3[this] , GetUnitX(s__FrierenSpells__FrierenSpells_Q2_c[this]) , GetUnitY(s__FrierenSpells__FrierenSpells_Q2_c[this]))
            set s__FrierenSpells__FrierenSpells_Q2_shotsOnTarget[this]=0
            call SaveInteger(hs, GetHandleId(GetOwningPlayer(s__FrierenSpells__FrierenSpells_Q2_c[this])), StringHash(I2S(FrierenQ_ID)), 1)
            if s__FrierenSpells__FrierenSpells_Q2_targetCount[this] == 1 then
                set s__FrierenSpells__FrierenSpells_Q2_shotsPerTarget[this]=4
            elseif s__FrierenSpells__FrierenSpells_Q2_targetCount[this] == 2 then
                set s__FrierenSpells__FrierenSpells_Q2_shotsPerTarget[this]=2
            elseif s__FrierenSpells__FrierenSpells_Q2_targetCount[this] == 3 then
                set s__FrierenSpells__FrierenSpells_Q2_shotsPerTarget[this]=2 // Первая цель получит два выстрела
