                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_yc_shockwave_b.mdl" , s__TakeshiSpells__TakeshiSpells_G_x[this] , s__TakeshiSpells__TakeshiSpells_G_y[this] , 1 , 0.8 , 2 , 175))
