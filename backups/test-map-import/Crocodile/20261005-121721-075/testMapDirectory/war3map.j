        set s__CrocodileSpells___CrocodileT2KS_e[this]=EffectSpawnColor("war3mapImported\\Gear_mr.war3_sxxq3.mdx" , GetUnitX(s__CrocodileSpells___CrocodileT2KS_c[this]) , GetUnitY(s__CrocodileSpells___CrocodileT2KS_c[this]) , s__CrocodileSpells___CrocodileT2KS_a[this] * bj_RADTODEG , 1.50 , 7.00 , 0.00 , 255 , 1 , 1 , 255)
        set s__CrocodileSpells___CrocodileT2KS_e2[this]=AddSpecialEffectTarget("war3mapImported\\ly-r-sg.mdx", s__CrocodileSpells___CrocodileT2KS_c[this], "chest")
