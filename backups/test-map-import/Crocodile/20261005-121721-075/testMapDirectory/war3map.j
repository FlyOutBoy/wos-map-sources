     function ShikiClone takes unit c,integer k,real r5,real timescale returns nothing
            local unit d= CreateUnit(GetOwningPlayer(c), DarkShiki_Clone_ID, GetUnitX(c), GetUnitY(c), GetUnitFacing(c))
            call SetScale(d , BlzGetUnitRealField(c, UNIT_RF_SCALING_VALUE))
            call SetUnitVertexColor(d, 255, 255, 255, 255)
            call SetUnitTimeScale(d, timescale)
            call SetFly(d , GetUnitFlyHeight(c))
            call SetUnitAnimationByIndex(d, k)
            call s__GearSystems2___KS_RemoveUnit_MyRemoveUnit_Start((d ) , (( r5 )*1.0) , 1 , (( 0)*1.0) , - 1 , "") // INLINED!!
            call ColorDummy2(d , 0.06 , 255 , 255 , 255 , 255 , 0.33)
            call s__GearSystems2___KS_RemoveUnit_MyRemoveUnit_Start((d ) , (( 0.39)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
            set d=null
    endfunction
        function s__DarkShikiSpells__DarkShikiPas_KS_Loop_DarkShikiPas takes nothing returns nothing
            local integer this
            local integer i= 0
            local integer h
            local integer sh
            loop
                exitwhen i > s__DarkShikiSpells__DarkShikiPas_KS_MUI_DarkShikiPas
                set this=s__DarkShikiSpells__DarkShikiPas_KS_m_DarkShikiPas[i]
                if SpellBoolCaster(s__DarkShikiSpells__DarkShikiPas_KS_c[this]) and SpellBoolCaster(s__DarkShikiSpells__DarkShikiPas_KS_td[this]) and s__DarkShikiSpells__DarkShikiPas_KS_r[this] < s__DarkShikiSpells__DarkShikiPas_KS_rmax[this] and LoadUnitHandle(hs, GetHandleId(s__DarkShikiSpells__DarkShikiPas_KS_c[this]), StringHash("passive target")) == s__DarkShikiSpells__DarkShikiPas_KS_td[this] and CheckCoordsInRect(gg_rct_Base , GetUnitX(s__DarkShikiSpells__DarkShikiPas_KS_td[this]) , GetUnitY(s__DarkShikiSpells__DarkShikiPas_KS_td[this])) == false then
                    if LoadInteger(hs, GetHandleId(s__DarkShikiSpells__DarkShikiPas_KS_c[this]), StringHash("shiki_spell_pause")) == 0 then
                        set s__DarkShikiSpells__DarkShikiPas_KS_r[this]=s__DarkShikiSpells__DarkShikiPas_KS_r[this] + 0.03
                        call BlzSetSpecialEffectTimeScale(s__DarkShikiSpells__DarkShikiPas_KS_e3[this], s__DarkShikiSpells__DarkShikiPas_KS_r5[this])
                    else
                        call BlzSetSpecialEffectTimeScale(s__DarkShikiSpells__DarkShikiPas_KS_e3[this], 0)
                    endif
                    set s__DarkShikiSpells__DarkShikiPas_KS_r[this]=S2R(R2SW(s__DarkShikiSpells__DarkShikiPas_KS_r[this], 0, 3))
                    set s__DarkShikiSpells__DarkShikiPas_KS_x[this]=GetUnitX(s__DarkShikiSpells__DarkShikiPas_KS_td[this])
                    set s__DarkShikiSpells__DarkShikiPas_KS_y[this]=GetUnitY(s__DarkShikiSpells__DarkShikiPas_KS_td[this])
                    call EffVision(s__DarkShikiSpells__DarkShikiPas_KS_e2[this] , s__DarkShikiSpells__DarkShikiPas_KS_td[this])
                    call EffVision2(s__DarkShikiSpells__DarkShikiPas_KS_e3[this] , s__DarkShikiSpells__DarkShikiPas_KS_c[this])
                    set h=GetHandleId(s__DarkShikiSpells__DarkShikiPas_KS_td[this])
                    set sh=StringHash("DarkShiki pas")
                    set s__DarkShikiSpells__DarkShikiPas_KS_fly[this]=GetUnitFlyHeight(s__DarkShikiSpells__DarkShikiPas_KS_td[this])
                    if LoadInteger(hs, h, sh) > s__DarkShikiSpells__DarkShikiPas_KS_check[this] then
                        set s__DarkShikiSpells__DarkShikiPas_KS_check[this]=LoadInteger(hs, h, sh)
                        set s__DarkShikiSpells__DarkShikiPas_KS_r[this]=0
