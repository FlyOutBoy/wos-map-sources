                    set s__FrierenSpells__FrierenSpells_F_r[this]=RoundReal(s__FrierenSpells__FrierenSpells_F_r[this] + 0.03 , 3)
                    if s__FrierenSpells__FrierenSpells_F_phase[this] == 0 and s__FrierenSpells__FrierenSpells_F_r[this] >= 3.78 then
                        set s__FrierenSpells__FrierenSpells_F_phase[this]=1
