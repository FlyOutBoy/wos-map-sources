        function s__AstaSpells__AstaSpells_F_Loop_AstaF takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__AstaSpells__AstaSpells_F_MUI_AstaF
                set this=s__AstaSpells__AstaSpells_F_m_AstaF[i]
                if GetUnitCurrentOrder(s__AstaSpells__AstaSpells_F_c[this]) == OrderId("magicdefense") then
                    set s__AstaSpells__AstaSpells_F_r[this]=RoundReal(s__AstaSpells__AstaSpells_F_r[this] + 0.03 , 3)
                    set s__AstaSpells__AstaSpells_F_x[this]=GetUnitX(s__AstaSpells__AstaSpells_F_c[this])
                    set s__AstaSpells__AstaSpells_F_y[this]=GetUnitY(s__AstaSpells__AstaSpells_F_c[this])
                    if s__AstaSpells__AstaSpells_F_r3[this] > 0.16 then
                        set s__AstaSpells__AstaSpells_F_r3[this]=0
                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_krk (1971).mdl" , GetUnitX(s__AstaSpells__AstaSpells_F_c[this]) , GetUnitY(s__AstaSpells__AstaSpells_F_c[this]) , GetRandomReal(0, 359) , 0.90 , 1.25 , 1))
                    else
                        set s__AstaSpells__AstaSpells_F_r3[this]=s__AstaSpells__AstaSpells_F_r3[this] + 0.03
                    endif
                    call BlzSetSpecialEffectPosition(s__AstaSpells__AstaSpells_F_e[this], s__AstaSpells__AstaSpells_F_x[this], s__AstaSpells__AstaSpells_F_y[this], 0)
                    if s__AstaSpells__AstaSpells_F_r2[this] > 0.12 then
                        set s__AstaSpells__AstaSpells_F_r2[this]=0
                        set s__AstaSpells__AstaSpells_F_r5[this]=0
                        call GroupEnumUnitsInRange(s__AstaSpells__AstaSpells_F_g[this], s__AstaSpells__AstaSpells_F_x[this], s__AstaSpells__AstaSpells_F_y[this], s__AstaSpells__AstaSpells_F_aoe[this], Condition(function NoDecor_Filter))
                        loop
                            set s__AstaSpells__AstaSpells_F_u[this]=FirstOfGroup(s__AstaSpells__AstaSpells_F_g[this])
                            exitwhen s__AstaSpells__AstaSpells_F_u[this] == null
                            if IsUnitEnemy(s__AstaSpells__AstaSpells_F_u[this], GetOwningPlayer(s__AstaSpells__AstaSpells_F_c[this])) == false and SpellBool(s__AstaSpells__AstaSpells_F_u[this]) then
                                call DebuffClear(s__AstaSpells__AstaSpells_F_u[this])
                            endif
                            if s__AstaSpells__AstaSpells_F_c[this] != s__AstaSpells__AstaSpells_F_u[this] and SpellBool(s__AstaSpells__AstaSpells_F_u[this]) then
                            set s__AstaSpells__AstaSpells_F_r5[this]=( GetUnitState(s__AstaSpells__AstaSpells_F_u[this], UNIT_STATE_MAX_MANA) * ( AstaF_ManaSteal / 100 ) ) / 4.5
                            if s__AstaSpells__AstaSpells_F_r5[this] > 0 then
                                call SetMpCurrent(s__AstaSpells__AstaSpells_F_c[this] , s__AstaSpells__AstaSpells_F_r5[this])
                                 call SetMpCurrent(s__AstaSpells__AstaSpells_F_u[this] , - s__AstaSpells__AstaSpells_F_r5[this])
                            endif
                            endif
                            call GroupRemoveUnit(s__AstaSpells__AstaSpells_F_g[this], s__AstaSpells__AstaSpells_F_u[this])
                        endloop
                    else
                        set s__AstaSpells__AstaSpells_F_r2[this]=s__AstaSpells__AstaSpells_F_r2[this] + 0.03
                    endif
                else
                    call ColorEffDummy3(s__AstaSpells__AstaSpells_F_e[this] , 0 , 255 , 255 , 255 , 0.35)
                    call DestroyGroup(s__AstaSpells__AstaSpells_F_g[this])
                    set s__AstaSpells__AstaSpells_F_e[this]=null
                    set s__AstaSpells__AstaSpells_F_g[this]=null
                    set s__AstaSpells__AstaSpells_F_c[this]=null
                    set s__AstaSpells__AstaSpells_F_m_AstaF[i]=s__AstaSpells__AstaSpells_F_m_AstaF[s__AstaSpells__AstaSpells_F_MUI_AstaF]
                    set s__AstaSpells__AstaSpells_F_MUI_AstaF=s__AstaSpells__AstaSpells_F_MUI_AstaF - 1
                    if s__AstaSpells__AstaSpells_F_MUI_AstaF == - 1 then
                        call PauseTimer(s__AstaSpells__AstaSpells_F_t_AstaF)
                    endif
                    call s__AstaSpells__AstaSpells_F_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction

