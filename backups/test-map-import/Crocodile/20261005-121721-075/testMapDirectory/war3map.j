    endfunction
    function MahoragaE_Start takes unit c,real x,real y returns nothing
        call s__MahoragaSpells__MahoragaSpells_E_MahoragaE_Start(c , x , y)
    endfunction
    function MahoragaE2_Start takes unit c returns nothing
