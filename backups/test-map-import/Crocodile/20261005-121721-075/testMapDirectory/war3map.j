                                    call GroupEnumUnitsInRange(s__MilimSpells___MilimQKS_g[this], GetUnitX(s__MilimSpells___MilimQKS_c[this]), GetUnitY(s__MilimSpells___MilimQKS_c[this]), s__MilimSpells___MilimQKS_aoe[this] + 25, NoDecor_Cond)
                                    loop
                                        set s__MilimSpells___MilimQKS_u[this]=FirstOfGroup(s__MilimSpells___MilimQKS_g[this])
                                        exitwhen s__MilimSpells___MilimQKS_u[this] == null or s__MilimSpells___MilimQKS_check[this] == 1
                                        if SpellBool(s__MilimSpells___MilimQKS_u[this]) and IsUnitEnemy(s__MilimSpells___MilimQKS_u[this], GetOwningPlayer(s__MilimSpells___MilimQKS_c[this])) then
                                            set s__MilimSpells___MilimQKS_check[this]=1
