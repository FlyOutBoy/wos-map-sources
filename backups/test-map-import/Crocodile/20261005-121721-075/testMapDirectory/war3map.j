            set s__OkarunSpells__OkarunQ_KS_dmg[this]=s__OkarunSpells__OkarunQ_KS_dmg[this] + ( LoadReal(hs, GetHandleId(s__OkarunSpells__OkarunQ_KS_c[this]), StringHash("current speed1")) * ( ( OkarunQ_DamageSpeedBonusBase + ( OkarunQ_DamageSpeedBonusStep * ( GetUnitAbilityLevel(s__OkarunSpells__OkarunQ_KS_c[this], OkarunQ_ID) - 1 ) ) ) / 100 ) )
