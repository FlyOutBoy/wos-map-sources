                    call BlzSetUnitFacingEx(s__ErzaQSpells___ErzaQ_KS_c[this], s__ErzaQSpells___ErzaQ_KS_a[this] * bj_RADTODEG)
                            call MoveUnit(s__ErzaQSpells___ErzaQ_KS_c[this] , s__ErzaQSpells___ErzaQ_KS_move[this] , s__ErzaQSpells___ErzaQ_KS_a[this])
