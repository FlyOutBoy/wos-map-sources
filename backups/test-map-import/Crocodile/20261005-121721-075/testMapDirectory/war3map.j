                    set s__RimuruSpells__Rimuru3T_KS_MUI_Rimuru3T=s__RimuruSpells__Rimuru3T_KS_MUI_Rimuru3T - 1
                    if s__RimuruSpells__Rimuru3T_KS_MUI_Rimuru3T == - 1 then
                        call PauseTimer(s__RimuruSpells__Rimuru3T_KS_t_Rimuru3T)
                    endif
                    call s__RimuruSpells__Rimuru3T_KS_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction
        function s__RimuruSpells__Rimuru3T_KS_Rimuru3T_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__RimuruSpells__Rimuru3T_KS__allocate()
            local integer ring= 15
            set s__RimuruSpells__Rimuru3T_KS_MUI_Rimuru3T=s__RimuruSpells__Rimuru3T_KS_MUI_Rimuru3T + 1
            set s__RimuruSpells__Rimuru3T_KS_m_Rimuru3T[s__RimuruSpells__Rimuru3T_KS_MUI_Rimuru3T]=this
            set s__RimuruSpells__Rimuru3T_KS_c[this]=NewC
            set s__RimuruSpells__Rimuru3T_KS_x[this]=NewX
            set s__RimuruSpells__Rimuru3T_KS_y[this]=NewY
            set s__RimuruSpells__Rimuru3T_KS_r[this]=0
            set s__RimuruSpells__Rimuru3T_KS_r5[this]=0
            set s__RimuruSpells__Rimuru3T_KS_r2[this]=0
            set s__RimuruSpells__Rimuru3T_KS_r3[this]=0 // FIX: explicitly zero r3/r4 so leftover values from a
            set s__RimuruSpells__Rimuru3T_KS_r4[this]=0 //      previous struct allocation don't corrupt phase math
            set s__RimuruSpells__Rimuru3T_KS_check[this]=0
            set s__RimuruSpells__Rimuru3T_KS_check2[this]=0
            set s__RimuruSpells__Rimuru3T_KS_u[this]=null
            set s__RimuruSpells__Rimuru3T_KS_k3[this]=0
            set s__RimuruSpells__Rimuru3T_KS_e[this]=null // FIX: null e so cleanup DestroyEffect(e) is safe if r==0.3 never fires
            set s__RimuruSpells__Rimuru3T_KS_e2[this]=null
            set s__RimuruSpells__Rimuru3T_KS_g[this]=CreateGroup()
            set s__RimuruSpells__Rimuru3T_KS_g2[this]=CreateGroup()
            // FIX: zero all lightning slots so null-guards in Loop work on first cycle
            set s__RimuruSpells__Rimuru3T_KS_k[this]=0
            loop
                exitwhen s__RimuruSpells__Rimuru3T_KS_k[this] == ring * 3 // ring is 15, constant
                set s___RimuruSpells__Rimuru3T_KS_ls[s__RimuruSpells__Rimuru3T_KS_ls[this]+s__RimuruSpells__Rimuru3T_KS_k[this]]=null
                set s__RimuruSpells__Rimuru3T_KS_k[this]=s__RimuruSpells__Rimuru3T_KS_k[this] + 1
            endloop
            set s__RimuruSpells__Rimuru3T_KS_aoe[this]=RimuruT3_DamageAoe
            set s__RimuruSpells__Rimuru3T_KS_r6[this]=800
            set s__RimuruSpells__Rimuru3T_KS_move[this]=s__RimuruSpells__Rimuru3T_KS_sr[this] / 20
            set s__RimuruSpells__Rimuru3T_KS_a[this]=GAngle2(s__RimuruSpells__Rimuru3T_KS_c[this] , s__RimuruSpells__Rimuru3T_KS_x[this] , s__RimuruSpells__Rimuru3T_KS_y[this])
            set s__RimuruSpells__Rimuru3T_KS_rmax[this]=9.7
            //call StartSpellUnit(c)
            if LoadInteger(hs, GetHandleId(s__RimuruSpells__Rimuru3T_KS_c[this]), StringHash("rim main stat")) == 0 then
                set s__RimuruSpells__Rimuru3T_KS_dmg[this]=GetHeroInt(s__RimuruSpells__Rimuru3T_KS_c[this], true) * RimuruT3_DamageIntBase
            else
                set s__RimuruSpells__Rimuru3T_KS_dmg[this]=GetHeroAgi(s__RimuruSpells__Rimuru3T_KS_c[this], true) * RimuruT3_DamageIntBase
            endif
            call SetUnitFacing(s__RimuruSpells__Rimuru3T_KS_c[this], s__RimuruSpells__Rimuru3T_KS_a[this] * bj_RADTODEG)
            call SetUnitAnimationByIndex(s__RimuruSpells__Rimuru3T_KS_c[this], 6)
            call SetUnitTimeScale(s__RimuruSpells__Rimuru3T_KS_c[this], 1.6)
            call MakeSound("war3mapimported\\Hero_Rimuru3_T")
            if s__RimuruSpells__Rimuru3T_KS_MUI_Rimuru3T == 0 then
                call TimerStart(s__RimuruSpells__Rimuru3T_KS_t_Rimuru3T, 0.03, true, function s__RimuruSpells__Rimuru3T_KS_Loop_Rimuru3T)
            endif
        endfunction


