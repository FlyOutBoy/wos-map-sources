                            exitwhen s__LaxusSpells__LaxusT_KS_u[this] == null
                            if SpellBool(s__LaxusSpells__LaxusT_KS_u[this]) and IsUnitEnemy(s__LaxusSpells__LaxusT_KS_u[this], GetOwningPlayer(s__LaxusSpells__LaxusT_KS_c[this])) then
                                call dmgmag(s__LaxusSpells__LaxusT_KS_c[this] , s__LaxusSpells__LaxusT_KS_u[this] , s__LaxusSpells__LaxusT_KS_dmg[this])
                                call SilenceUnit(s__LaxusSpells__LaxusT_KS_c[this] , s__LaxusSpells__LaxusT_KS_u[this] , LaxusT_Silence)
                            endif
                            call GroupRemoveUnit(s__LaxusSpells__LaxusT_KS_g[this], s__LaxusSpells__LaxusT_KS_u[this])
                        endloop
