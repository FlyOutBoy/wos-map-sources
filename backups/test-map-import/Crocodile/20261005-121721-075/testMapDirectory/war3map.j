                        set s__PatriotSpells__PatriotSpells_Q_x1[this]=LoadReal(hs, GetHandleId(s__PatriotSpells__PatriotSpells_Q_c[this]), StringHash("w x"))
                        set s__PatriotSpells__PatriotSpells_Q_y1[this]=LoadReal(hs, GetHandleId(s__PatriotSpells__PatriotSpells_Q_c[this]), StringHash("w y"))
                        set x2=LoadReal(hs, GetHandleId(s__PatriotSpells__PatriotSpells_Q_c[this]), StringHash("r x"))
