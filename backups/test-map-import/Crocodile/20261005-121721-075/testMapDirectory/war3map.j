            endif
            call SetUnitTimeScale(s__FrierenSpells__FrierenSpells_TQ_c[this], 1.5)
            set s__FrierenSpells__FrierenSpells_TQ_dmg[this]=GetHeroInt(s__FrierenSpells__FrierenSpells_TQ_statSource[this], true) * ( FrierenQ3_DamageIntBase + ( FrierenQ3_DamageIntStep * ( GetUnitAbilityLevel(s__FrierenSpells__FrierenSpells_TQ_statSource[this], FrierenQ_ID) - 1 ) ) )
            set s__FrierenSpells__FrierenSpells_TQ_dmg[this]=s__FrierenSpells__FrierenSpells_TQ_dmg[this] + FrierenQ3_Damage2StaticBase + ( FrierenQ3_Damage2StaticStep * ( GetUnitAbilityLevel(s__FrierenSpells__FrierenSpells_TQ_statSource[this], FrierenQ_ID) - 1 ) )
