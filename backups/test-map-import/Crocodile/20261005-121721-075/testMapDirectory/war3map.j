                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_1mt_shui1.mdl" , GetUnitX(s__TakeshiSpells__TakeshiSpells_G_c[this]) + 0 * Cos(s__TakeshiSpells__TakeshiSpells_G_a[this]) , GetUnitY(s__TakeshiSpells__TakeshiSpells_G_c[this]) + 0 * Sin(s__TakeshiSpells__TakeshiSpells_G_a[this]) , s__TakeshiSpells__TakeshiSpells_G_a[this] * bj_RADTODEG , 1 , 2.25 , 150))
