        set s__CrocodileSpells___CrocodileRKS_e3[this]=EffectSpawnScale("war3mapImported\\wos_xtyball2.mdx" , GetUnitX(s__CrocodileSpells___CrocodileRKS_c[this]) + add * Cos(s__CrocodileSpells___CrocodileRKS_a[this]) , GetUnitY(s__CrocodileSpells___CrocodileRKS_c[this]) + add * Sin(s__CrocodileSpells___CrocodileRKS_a[this]) , s__CrocodileSpells___CrocodileRKS_a[this] * bj_RADTODEG , 1.00 , 1 , 0.00 , 0.75 , 1 , 1.85)
        
