                        call VisionTimed(GetOwningPlayer(s__LaxusSpells__LaxusT_KS_c[this]) , s__LaxusSpells__LaxusT_KS_x[this] , s__LaxusSpells__LaxusT_KS_y[this] , s__LaxusSpells__LaxusT_KS_aoe[this] , 1.5)
                            set impactEffect=EffectSpawnScale("war3mapImported\\wos_by_wood_bashenan_juqi_2_2_yellow.mdl" , s__LaxusSpells__LaxusT_KS_x[this] , s__LaxusSpells__LaxusT_KS_y[this] , GetRandomReal(0, 359) , 0.65 , 1 , 150 , 0.3 , 1 , 17 * s__LaxusSpells__LaxusT_KS_scale[this])
                            call EHeightSet(impactEffect , 0.3 , 650)
                            call s__GearSystems2___KS_RemoveEffect_MyRemoveEff_Start((impactEffect ) , (( 0.4 )*1.0) , 1 , (( 10)*1.0) , - 1 , "") // INLINED!!
                            call ColorEffDummy3(impactEffect , 0.5 , 255 , 255 , 255 , 0.1)
                            set impactEffect=null
                            call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_HakkeStartWhite.mdx" , s__LaxusSpells__LaxusT_KS_x[this] , s__LaxusSpells__LaxusT_KS_y[this] , GetRandomReal(0, 359) , 1.4 , 2.75 * s__LaxusSpells__LaxusT_KS_scale[this] , 0 , 255 , 255 , 125 , 255))

                            call DestroyEffect(EffectSpawnScale("war3mapImported\\wos_by_wood_effect_order_dange_yueyun_3yellowlightclear.mdl" , s__LaxusSpells__LaxusT_KS_x[this] , s__LaxusSpells__LaxusT_KS_y[this] , GetRandomReal(0, 359) , 0.65 , 1 , 1 , 0.3 , 0.01 , 2.8 * s__LaxusSpells__LaxusT_KS_scale[this]))
                        call GroupClear(s__LaxusSpells__LaxusT_KS_g[this])
                        call GroupEnumUnitsInRange(s__LaxusSpells__LaxusT_KS_g[this], s__LaxusSpells__LaxusT_KS_x[this], s__LaxusSpells__LaxusT_KS_y[this], s__LaxusSpells__LaxusT_KS_aoe[this], NoDecor_Cond)
                        loop
