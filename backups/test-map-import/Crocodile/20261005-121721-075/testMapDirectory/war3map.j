                                    set kek2=GetUnitFacing(s__StarrkSpells__StarrkSpells_T_td[this]) * bj_DEGTORAD //GetRandomReal(0, 359) * bj_DEGTORAD
                                    call s__StarrkSpells__StarrkSpells_T_StarrkT2_Start(s__StarrkSpells__StarrkSpells_T_c[this] , s__StarrkSpells__StarrkSpells_T_td[this] , null , s__StarrkSpells__StarrkSpells_T_g2[this] , s__StarrkSpells__StarrkSpells_T_x[this] + kek1 * Cos(GetUnitFacing(s__StarrkSpells__StarrkSpells_T_td[this]) * bj_DEGTORAD) , s__StarrkSpells__StarrkSpells_T_y[this] + kek1 * Sin(GetUnitFacing(s__StarrkSpells__StarrkSpells_T_td[this]) * bj_DEGTORAD) , s__StarrkSpells__StarrkSpells_T_g[this] , s__StarrkSpells__StarrkSpells_T_k[this] , 1)
                                    call GroupRemoveUnit(s__StarrkSpells__StarrkSpells_T_g3[this], s__StarrkSpells__StarrkSpells_T_td[this])
                                endif
                                set s__StarrkSpells__StarrkSpells_T_k2[this]=s__StarrkSpells__StarrkSpells_T_k2[this] + 1
                            endloop
                            set s__StarrkSpells__StarrkSpells_T_u[this]=null
                            call SaveGroupHandle(hs, GetHandleId(s__StarrkSpells__StarrkSpells_T_c[this]), StringHash("wolf group"), s__StarrkSpells__StarrkSpells_T_g2[this])
                        endif
                    endif
                else
                    call DestroyGroup(s__StarrkSpells__StarrkSpells_T_g3[this])
                    call StopSpellUnit(s__StarrkSpells__StarrkSpells_T_c[this])
                    set s__StarrkSpells__StarrkSpells_T_g3[this]=null
                    call SaveInteger(hs, GetHandleId(GetOwningPlayer(s__StarrkSpells__StarrkSpells_T_c[this])), StringHash("wolf ult"), 0)
                    call DestroyGroup(s__StarrkSpells__StarrkSpells_T_g[this])
                    set s__StarrkSpells__StarrkSpells_T_g[this]=null
                    set s__StarrkSpells__StarrkSpells_T_td[this]=null
                    set s__StarrkSpells__StarrkSpells_T_c[this]=null
                    set s__StarrkSpells__StarrkSpells_T_m_StarrkT3[i]=s__StarrkSpells__StarrkSpells_T_m_StarrkT3[s__StarrkSpells__StarrkSpells_T_MUI_StarrkT3]
                    set s__StarrkSpells__StarrkSpells_T_MUI_StarrkT3=s__StarrkSpells__StarrkSpells_T_MUI_StarrkT3 - 1
                    if s__StarrkSpells__StarrkSpells_T_MUI_StarrkT3 == - 1 then
                        call PauseTimer(s__StarrkSpells__StarrkSpells_T_t_StarrkT3)
                    endif
                    call s__StarrkSpells__StarrkSpells_T_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction

        function s__StarrkSpells__StarrkSpells_T_StarrkT3_Start takes unit NewC,real NewX,real NewY,integer NewK returns nothing
            local integer this= s__StarrkSpells__StarrkSpells_T__allocate()
            set s__StarrkSpells__StarrkSpells_T_MUI_StarrkT3=s__StarrkSpells__StarrkSpells_T_MUI_StarrkT3 + 1
            set s__StarrkSpells__StarrkSpells_T_m_StarrkT3[s__StarrkSpells__StarrkSpells_T_MUI_StarrkT3]=this
            set s__StarrkSpells__StarrkSpells_T_c[this]=NewC
            set s__StarrkSpells__StarrkSpells_T_x[this]=NewX
            set s__StarrkSpells__StarrkSpells_T_y[this]=NewY
            set s__StarrkSpells__StarrkSpells_T_k[this]=0
            set s__StarrkSpells__StarrkSpells_T_check[this]=NewK
            set s__StarrkSpells__StarrkSpells_T_aoe[this]=300
            set s__StarrkSpells__StarrkSpells_T_r[this]=0
            set s__StarrkSpells__StarrkSpells_T_g2[this]=LoadGroupHandle(hs, GetHandleId(s__StarrkSpells__StarrkSpells_T_c[this]), StringHash("wolf group"))
            set s__StarrkSpells__StarrkSpells_T_g3[this]=CreateGroup()
            set s__StarrkSpells__StarrkSpells_T_g[this]=CreateGroup()
            set s__StarrkSpells__StarrkSpells_T_a[this]=GAngle2(s__StarrkSpells__StarrkSpells_T_c[this] , s__StarrkSpells__StarrkSpells_T_x[this] , s__StarrkSpells__StarrkSpells_T_y[this]) // Angle Between points
            call SaveInteger(hs, GetHandleId(s__StarrkSpells__StarrkSpells_T_c[this]), StringHash("stark t"), 0)
            call SetPlayerAbilityAvailable(Player(s__StarrkSpells__StarrkSpells_T_check2[this]), StarrkR2_ID, true)
            call UnitRemoveAbility(s__StarrkSpells__StarrkSpells_T_c[this], StarrkR3_ID)
            call SetPlayerAbilityAvailable(Player(s__StarrkSpells__StarrkSpells_T_check2[this]), StarrkT_ID, true)
            call UnitRemoveAbility(s__StarrkSpells__StarrkSpells_T_c[this], StarrkT2_ID)
            if s__StarrkSpells__StarrkSpells_T_check[this] == 0 then
                call MakeSound("war3mapimported\\Hero_Starrk_TT2")
            else
               call StartSpellUnit(s__StarrkSpells__StarrkSpells_T_c[this])
            endif
            call MakeSound("war3mapimported\\Hero_Starrk_TT1")
            call SaveInteger(hs, GetHandleId(GetOwningPlayer(s__StarrkSpells__StarrkSpells_T_c[this])), StringHash("wolf ult"), 1)
            set s__StarrkSpells__StarrkSpells_T_rmax[this]=8
            call VisionTimed(GetOwningPlayer(s__StarrkSpells__StarrkSpells_T_c[this]) , s__StarrkSpells__StarrkSpells_T_x[this] , s__StarrkSpells__StarrkSpells_T_y[this] , 1600 , 3)
            if s__StarrkSpells__StarrkSpells_T_MUI_StarrkT3 == 0 then
                call TimerStart(s__StarrkSpells__StarrkSpells_T_t_StarrkT3, 0.05, true, function s__StarrkSpells__StarrkSpells_T_Loop_StarrkT3)
            endif
        endfunction


    //----------------------------Starrk-----------------------------------------------
      
    function StarrkPas takes unit c returns nothing
        local group g= CreateGroup()
        local unit u= null
        local real x= GetUnitX(c)
        local real y= GetUnitY(c)
        local real aoe= 0
        local real scale= 1
        local integer lvl= GetHeroLevel(c)
        local real hp= GetUnitState(c, UNIT_STATE_MAX_LIFE) * 0.01
        local real mp= GetUnitState(c, UNIT_STATE_MAX_MANA) * 0.01
        local boolean b= false
        local integer check= 0
        if lvl >= 12 then
            if lvl >= 35 then
                set aoe=StarkG_Aoe35
                set scale=1.5
            elseif lvl >= 25 then
                set aoe=StarkG_Aoe25
                set scale=1.25
            else
                set aoe=StarkG_Aoe12
            endif
            call GroupEnumUnitsInRange(g, x, y, aoe, null)
            loop
                set u=FirstOfGroup(g)
                exitwhen u == null
                if IsUnitAlly(u, GetOwningPlayer(c)) and GetOwningPlayer(u) != Player(PLAYER_NEUTRAL_PASSIVE) and u != c then
                    set check=check + 1
                endif
                call GroupRemoveUnit(g, u)
            endloop
            if check == 0 then
                set b=true
            endif
            if b == true then
                if GetUnitAbilityLevel(c, Starrk_Pas1ID) == 0 then
                    call UnitAddAbility(c, Starrk_Pas1ID)
                    call s__GearSystems2___KS_RemoveAbility_RemoveAbility_Start((c ) , (( StarkG_TimeStatAdd )*1.0) , ( Starrk_Pas1ID ) , ( 1)) // INLINED!!
                elseif GetUnitAbilityLevel(c, Starrk_Pas2ID) == 0 then
                    call UnitAddAbility(c, Starrk_Pas2ID)
                    call s__GearSystems2___KS_RemoveAbility_RemoveAbility_Start((c ) , (( StarkG_TimeStatAdd )*1.0) , ( Starrk_Pas2ID ) , ( 1)) // INLINED!!
                elseif GetUnitAbilityLevel(c, Starrk_Pas3ID) == 0 and lvl >= 25 then
                    call UnitAddAbility(c, Starrk_Pas3ID)
                    call s__GearSystems2___KS_RemoveAbility_RemoveAbility_Start((c ) , (( StarkG_TimeStatAdd )*1.0) , ( Starrk_Pas3ID ) , ( 1)) // INLINED!!
                elseif GetUnitAbilityLevel(c, Starrk_Pas4ID) == 0 and lvl >= 25 then
                    call UnitAddAbility(c, Starrk_Pas4ID)
                    call s__GearSystems2___KS_RemoveAbility_RemoveAbility_Start((c ) , (( StarkG_TimeStatAdd )*1.0) , ( Starrk_Pas4ID ) , ( 1)) // INLINED!!
                elseif GetUnitAbilityLevel(c, Starrk_Pas5ID) == 0 and lvl >= 35 then
                    call UnitAddAbility(c, Starrk_Pas5ID)
                    call s__GearSystems2___KS_RemoveAbility_RemoveAbility_Start((c ) , (( StarkG_TimeStatAdd )*1.0) , ( Starrk_Pas5ID ) , ( 1)) // INLINED!!
                elseif GetUnitAbilityLevel(c, Starrk_Pas6ID) == 0 and lvl >= 35 then
                    call UnitAddAbility(c, Starrk_Pas6ID)
                    call s__GearSystems2___KS_RemoveAbility_RemoveAbility_Start((c ) , (( StarkG_TimeStatAdd )*1.0) , ( Starrk_Pas6ID ) , ( 1)) // INLINED!!
                endif
                call SetHpCurrent2(c , c , hp * scale)
                call SetMpCurrent(c , mp * scale)
                call DestroyEffect(AddSpecialEffectTarget("war3mapimported\\wos_longskill_point_39.mdx", c, "origin"))
            endif
        endif
        call DestroyGroup(g)
        set u=null
        set g=null
    endfunction
    function StarrkQ_Start takes unit c,real x,real y returns nothing
        call s__StarrkSpells__StarrkSpells_Q_StarrkQ_Start(c , x , y)
    endfunction
    function StarrkW_Start takes unit c,unit td returns nothing
        call s__StarrkSpells__StarrkSpells_W_StarrkW_Start(c , td)
    endfunction
    function StarrkR_Start takes unit c,unit td returns nothing
        call s__StarrkSpells__StarrkSpells_R_StarrkR3_Start(c , td)
    endfunction
    function StarrkE_Attack_Start takes unit c,real x,real y returns nothing
        local real dmg= GetAttack(c)
        call s__StarrkSpells__StarrkSpells_Utility_StarrkPas2_Start(c , x , y , dmg)
        call SaveReal(hs, GetHandleId(c), StringHash("atk base dmg"), 0)
    endfunction
    function StarrkE2_Start takes unit c,real x,real y returns nothing
        local real sr
        local real max= StarrkE2_RangeBase + ( StarrkE2_RangeStep * ( GetUnitAbilityLevel(c, StarrkE_ID) - 1 ) )
        local real a= GAngle2(c , x , y)
        if GetUnitAbilityLevel(c, StarrkE_ID) == 5 then
            set max=StarrkE2_RangeBase + ( StarrkE2_RangeStep * ( GetUnitAbilityLevel(c, StarrkE_ID) - 2 ) )
        endif
        call MakeSound("war3mapimported\\Hero_Starrk_EE")
        if SR3(c , x , y) > max then
            set sr=max
        else
            set sr=SR3(c , x , y)
        endif
        set x=GetUnitX(c) + sr * Cos(a)
        set y=GetUnitY(c) + sr * Sin(a)
        call DestroyEffect(EffectSpawn("war3mapImported\\wos_Mdx_Effect_MirrorImage_Black.mdx" , GetUnitX(c) , GetUnitY(c) , GetUnitFacing(c) , 1.5 , 1.8 , 0))
        call PosUnit(c , x , y)
        call DestroyEffect(EffectSpawn("war3mapImported\\wos_Mdx_Effect_MirrorImage_Black.mdx" , GetUnitX(c) , GetUnitY(c) , GetUnitFacing(c) , 1.5 , 1.8 , 0))
    endfunction
    function StarrkE_Start takes unit c returns nothing
        if LoadInteger(hs, GetHandleId(GetOwningPlayer(c)), StringHash("morph e")) == 0 then
            call s__StarrkSpells__StarrkSpells_E_StarrkE_Start(c)
        else
            //call IssueImmediateOrder(c, "stop")
            call DisplayTimedTextToPlayer(GetOwningPlayer(c), 0, 0, 0.1, "|c00FF0303You already in morph , stop doing that|r")
        endif
    endfunction
    function StarrkR3_Start takes unit c returns nothing
        call s__StarrkSpells__StarrkSpells_T_StarrkT3_Start(c , GetUnitX(c) , GetUnitY(c) , 1)
    endfunction
    function StarrkR2_Start takes unit c,real x,real y returns nothing
        call s__StarrkSpells__StarrkSpells_R_StarrkR_Start(c , x , y)
    endfunction
    function StarrkT_Start takes unit c returns nothing
        call s__StarrkSpells__StarrkSpells_T_StarrkT_Start(c)
    endfunction
    function StarrkT2_Start takes unit c,real x,real y returns nothing
        call s__StarrkSpells__StarrkSpells_T_StarrkT3_Start(c , x , y , 0)
    endfunction
    

//library StarrkSpells ends
//library TakeshiSpells:
    function TakeshiGAdd_Start takes unit c,real dmg returns nothing
local integer k2= GetPlayerId(GetOwningPlayer(c))
local real dmg2= LoadReal(hs, GetHandleId(c), StringHash("takeshi dmg")) + dmg
local real rmax= TakeshiG_TakenDamageToEnter
if GetHeroLevel(c) >= 35 then
if s__frameTakeshi_pas1[k2] == null then
                set s__frameTakeshi_pas1[k2]= BlzCreateFrameByType("BACKDROP", "SS", BlzGetFrameByName("ConsoleUIBackdrop", 0), "", 0)
                call BlzFrameSetAbsPoint(s__frameTakeshi_pas1[k2], FRAMEPOINT_CENTER, 0.055, 0.18)
                call BlzFrameSetSize(s__frameTakeshi_pas1[k2], 0.135, 0.035)
                call BlzFrameSetTexture(s__frameTakeshi_pas1[k2], "UI\\Feedback\\XPBar\\human-xpbar-border.blp", 0, false)
                call BlzFrameSetVisible(s__frameTakeshi_pas1[k2], false)
                if GetLocalPlayer() == GetOwningPlayer(c) then
                    call BlzFrameSetVisible(s__frameTakeshi_pas1[k2], true)
                endif
                set s__frameTakeshi_pas2[k2]= BlzCreateFrame("EscMenuControlBackdropTemplate", s__frameTakeshi_pas1[k2], 0, 0)
                call BlzFrameSetAbsPoint(s__frameTakeshi_pas2[k2], FRAMEPOINT_CENTER, 0.07, 0.185)
                call BlzFrameSetSize(s__frameTakeshi_pas2[k2], 0.1, 0.019)
                set s__frameTakeshi_pas3[k2]= BlzCreateFrameByType("STATUSBAR", "", s__frameTakeshi_pas1[k2], "", 0)
                call BlzFrameSetSize(s__frameTakeshi_pas3[k2], 0.1, 0.035)
                call BlzFrameSetScale(s__frameTakeshi_pas3[k2], 0.5)
                call BlzFrameSetModel(s__frameTakeshi_pas3[k2], "ui/feedback/XpBar/XpBarConsole.mdx", 0)
                call BlzFrameSetAbsPoint(s__frameTakeshi_pas3[k2], FRAMEPOINT_CENTER, 0.05, 0.175)
                call BlzFrameSetMinMaxValue(s__frameTakeshi_pas3[k2], 0, rmax + 2)
                call BlzFrameSetValue(s__frameTakeshi_pas3[k2], 0)
                set s__frameTakeshi_pas4[k2]= BlzCreateFrameByType("BACKDROP", "SS", s__frameTakeshi_pas1[k2], "", 0)
                call BlzFrameSetAbsPoint(s__frameTakeshi_pas4[k2], FRAMEPOINT_CENTER, 0.005, 0.18)
                call BlzFrameSetSize(s__frameTakeshi_pas4[k2], 0.03, 0.03)
                call BlzFrameSetTexture(s__frameTakeshi_pas4[k2], "ReplaceableTextures\\CommandButtons\\BTNHero_Takeshi_G2", 0, false)
                set s__frameTakeshi_pas5[k2]= BlzCreateFrameByType("TEXT", "MyPlayerName", s__frameTakeshi_pas1[k2], "", 0)
                call BlzFrameSetAbsPoint(s__frameTakeshi_pas5[k2], FRAMEPOINT_CENTER, 0.07, 0.185)
                call BlzFrameSetText(s__frameTakeshi_pas5[k2], "|c00FFFF00Cambio Damage:|r")
                call BlzFrameSetScale(s__frameTakeshi_pas5[k2], 0.9)
                set s__frameTakeshi_pas6[k2]= BlzCreateFrameByType("TEXT", "MyPlayerName", s__frameTakeshi_pas1[k2], "", 0)
                call BlzFrameSetAbsPoint(s__frameTakeshi_pas6[k2], FRAMEPOINT_CENTER, 0.07, 0.17)
                call BlzFrameSetText(s__frameTakeshi_pas6[k2], "|c00FFFF00" + I2S(R2I(dmg2)) + "/" + I2S(R2I(rmax)) + "|r")
                call BlzFrameSetScale(s__frameTakeshi_pas6[k2], 0.9)
            else
                
                if LoadInteger(hs, GetHandleId(c), StringHash("mode g")) == 0 then
                if dmg2 >= rmax then
                set dmg2=rmax
                if TakeshiDummy == null then
                set TakeshiDummy=CreateUnit(GetOwningPlayer(c), TakeshiDummy_ID, GetRectCenterX(gg_rct_Caster), GetRectCenterY(gg_rct_Caster), 1)
                endif
                else
                if dmg2 < 0 then
                set dmg2=0
                endif
                if TakeshiDummy != null then
                call RemoveUnit(TakeshiDummy)
                set TakeshiDummy=null
                endif
                endif
                call SaveReal(hs, GetHandleId(c), StringHash("takeshi dmg"), dmg2)
                call BlzFrameSetText(s__frameTakeshi_pas6[k2], "|c00FFFF00" + I2S(R2I(dmg2)) + "/" + I2S(R2I(rmax)) + "|r")
                call BlzFrameSetValue(s__frameTakeshi_pas3[k2], dmg2)
                endif
            endif
            endif
endfunction

        function s__TakeshiSpells__TakeshiSpells_Q_Loop_TakeshiQ takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__TakeshiSpells__TakeshiSpells_Q_MUI_TakeshiQ
                set this=s__TakeshiSpells__TakeshiSpells_Q_m_TakeshiQ[i]
                if SpellBoolCaster(s__TakeshiSpells__TakeshiSpells_Q_c[this]) and s__TakeshiSpells__TakeshiSpells_Q_r[this] <= s__TakeshiSpells__TakeshiSpells_Q_rmax[this] then
                    set s__TakeshiSpells__TakeshiSpells_Q_r[this]=s__TakeshiSpells__TakeshiSpells_Q_r[this] + 0.03
                    call DebugUnit2(s__TakeshiSpells__TakeshiSpells_Q_c[this])
                    if s__TakeshiSpells__TakeshiSpells_Q_r[this] == 0.15 then
                        call SetUnitTimeScale(s__TakeshiSpells__TakeshiSpells_Q_c[this], 0)
                    endif
                    if s__TakeshiSpells__TakeshiSpells_Q_r[this] == 0.36 then
                        set s__TakeshiSpells__TakeshiSpells_Q_x1[this]=GetUnitX(s__TakeshiSpells__TakeshiSpells_Q_c[this])
                        set s__TakeshiSpells__TakeshiSpells_Q_y1[this]=GetUnitY(s__TakeshiSpells__TakeshiSpells_Q_c[this])
                        call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_tx-ha_nitu.mdl" , GetUnitX(s__TakeshiSpells__TakeshiSpells_Q_c[this]) , GetUnitY(s__TakeshiSpells__TakeshiSpells_Q_c[this]) , s__TakeshiSpells__TakeshiSpells_Q_a[this] * bj_RADTODEG , 2 , 1.25 , 1 , 255 , 255 , 255 , 255))
                        call DecorRemove(s__TakeshiSpells__TakeshiSpells_Q_c[this] , s__TakeshiSpells__TakeshiSpells_Q_x[this] , s__TakeshiSpells__TakeshiSpells_Q_y[this] , s__TakeshiSpells__TakeshiSpells_Q_aoe[this] , 25)
                        call MakeSound("war3mapimported\\Hero_Takeshi_Q3")
                        set s__TakeshiSpells__TakeshiSpells_Q_e2[this]=EffectSpawn("war3mapImported\\wos_water dash.mdl" , GetUnitX(s__TakeshiSpells__TakeshiSpells_Q_c[this]) - 165 * Cos(s__TakeshiSpells__TakeshiSpells_Q_a[this]) , GetUnitY(s__TakeshiSpells__TakeshiSpells_Q_c[this]) - 165 * Sin(s__TakeshiSpells__TakeshiSpells_Q_a[this]) , s__TakeshiSpells__TakeshiSpells_Q_a[this] * bj_RADTODEG , 1 , 1.65 , 0)
                        set s__TakeshiSpells__TakeshiSpells_Q_r5[this]=0
                    endif
                    if s__TakeshiSpells__TakeshiSpells_Q_r[this] > 0.45 then
                        if s__TakeshiSpells__TakeshiSpells_Q_r2[this] > 0.03 then
                            set s__TakeshiSpells__TakeshiSpells_Q_r2[this]=0
                            call EffectSpawn2("war3mapImported\\wos_Bubbles2.mdx" , s__TakeshiSpells__TakeshiSpells_Q_x1[this] , s__TakeshiSpells__TakeshiSpells_Q_y1[this] , GetRandomReal(0, 359) , 1 , 6 , GetRandomReal(50, 150) , 0.21)
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_BY_Wood_Effect_Kula_2_YiYingCun0.mdl" , s__TakeshiSpells__TakeshiSpells_Q_x1[this] + 100 * Cos(s__TakeshiSpells__TakeshiSpells_Q_a[this]) , s__TakeshiSpells__TakeshiSpells_Q_y1[this] + 100 * Sin(s__TakeshiSpells__TakeshiSpells_Q_a[this]) , s__TakeshiSpells__TakeshiSpells_Q_a[this] * bj_RADTODEG , 0.5 , 2.5 , 75))
                        else
                            set s__TakeshiSpells__TakeshiSpells_Q_r2[this]=s__TakeshiSpells__TakeshiSpells_Q_r2[this] + 0.03
                        endif
                        set s__TakeshiSpells__TakeshiSpells_Q_r5[this]=s__TakeshiSpells__TakeshiSpells_Q_r5[this] + s__TakeshiSpells__TakeshiSpells_Q_move[this]
                        if s__TakeshiSpells__TakeshiSpells_Q_r5[this] >= s__TakeshiSpells__TakeshiSpells_Q_r8[this] then
                            set s__TakeshiSpells__TakeshiSpells_Q_r[this]=s__TakeshiSpells__TakeshiSpells_Q_rmax[this]
                        endif
                        if LoadInteger(hs, GetHandleId(s__TakeshiSpells__TakeshiSpells_Q_c[this]), StringHash("def t")) > 0 then
                        set s__TakeshiSpells__TakeshiSpells_Q_x2[this]=LoadReal(hs, GetHandleId(s__TakeshiSpells__TakeshiSpells_Q_c[this]), StringHash("t x"))
                        set s__TakeshiSpells__TakeshiSpells_Q_y2[this]=LoadReal(hs, GetHandleId(s__TakeshiSpells__TakeshiSpells_Q_c[this]), StringHash("t y"))
                        if SR0(GetUnitX(s__TakeshiSpells__TakeshiSpells_Q_c[this]) + s__TakeshiSpells__TakeshiSpells_Q_move[this] * Cos(s__TakeshiSpells__TakeshiSpells_Q_a[this]) , GetUnitY(s__TakeshiSpells__TakeshiSpells_Q_c[this]) + s__TakeshiSpells__TakeshiSpells_Q_move[this] * Sin(s__TakeshiSpells__TakeshiSpells_Q_a[this]) , s__TakeshiSpells__TakeshiSpells_Q_x2[this] , s__TakeshiSpells__TakeshiSpells_Q_y2[this]) < TakeshiT_DamageAoe - 220 then
                        call MoveUnit(s__TakeshiSpells__TakeshiSpells_Q_c[this] , s__TakeshiSpells__TakeshiSpells_Q_move[this] , s__TakeshiSpells__TakeshiSpells_Q_a[this])
                        endif
                        else
                        call MoveUnit(s__TakeshiSpells__TakeshiSpells_Q_c[this] , s__TakeshiSpells__TakeshiSpells_Q_move[this] , s__TakeshiSpells__TakeshiSpells_Q_a[this])
                        endif
