        call ScaleDummy(s__KenjakuSpells___KenjakuSummon_KS_d[this] , 0.51 , 0.01 , 1)
        if GetUnitTypeId(s__KenjakuSpells___KenjakuSummon_KS_d[this]) == KenjakuE2_Dummy_ID then
            call DestroyEffect(EffectSpawnColor("war3mapimported\\wos_BY_Wood_Effect_Void_DaiTu_ShenWei_FangChu.mdl" , s__KenjakuSpells___KenjakuSummon_KS_x[this] , s__KenjakuSpells___KenjakuSummon_KS_y[this] , 1 , 0.75 , 3 , 135 , 255 , 25 , 25 , 255))
            call ColorEffDummy3(EffectSpawnColor("war3mapimported\\wos_afb (43).mdl" , s__KenjakuSpells___KenjakuSummon_KS_x[this] , s__KenjakuSpells___KenjakuSummon_KS_y[this] , 1 , 1 , 0.45 , 1 , 255 , 25 , 25 , 255) , 0 , 255 , 255 , 255 , 1.1)
            call DestroyEffect(EffectSpawnColor("war3mapimported\\wos_afb (58).mdl" , s__KenjakuSpells___KenjakuSummon_KS_x[this] , s__KenjakuSpells___KenjakuSummon_KS_y[this] , 1 , 0.95 , 1.98 , 1 , 255 , 25 , 25 , 255))
        else
            call DestroyEffect(EffectSpawn("war3mapimported\\wos_BY_Wood_Effect_Void_DaiTu_ShenWei_FangChu.mdl" , s__KenjakuSpells___KenjakuSummon_KS_x[this] , s__KenjakuSpells___KenjakuSummon_KS_y[this] , 1 , 0.75 , 3 , 135))
            call ColorEffDummy3(EffectSpawn("war3mapimported\\wos_afb (43).mdl" , s__KenjakuSpells___KenjakuSummon_KS_x[this] , s__KenjakuSpells___KenjakuSummon_KS_y[this] , 1 , 1 , 0.45 , 1) , 0 , 255 , 255 , 255 , 1.1)
