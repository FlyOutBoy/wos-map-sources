        function s__AinzSpells__AinzE_KS_CreatePathingBlockers takes integer this returns nothing
            local real maxSlope= 4.00 * AinzE_WallCurve / AinzE_WallLength
            local real projectedSpacing= AinzE_WallBlockerSpacing / SquareRoot(1.00 + maxSlope * maxSlope)
            local integer halfCount= R2I(( AinzE_WallLength * 0.50 ) / projectedSpacing) + 1
            local integer index= - halfCount
            local real localLength
            local real actualSpacing= ( AinzE_WallLength * 0.50 ) / I2R(halfCount)
            local real normalized
            local real curveOffset
            local real blockX
            local real blockY
            local real lengthAngle= s__AinzSpells__AinzE_KS_a[this] + bj_PI * 0.50
            local destructable d

            // Odd symmetric layout: one blocker is exactly at the center and
            // both sides always receive the same number of blockers.
            loop
                exitwhen index > halfCount
                set localLength=I2R(index) * actualSpacing
                set normalized=localLength / ( AinzE_WallLength * 0.50 )
                // The middle blocker stays exactly at x/y when ForwardOffset
                // is zero. Positive curve bends the wall toward the target
                // relative to its ends without pushing its center forward.
                set curveOffset=AinzE_WallForwardOffset - AinzE_WallCurve * normalized * normalized
                set blockX=s__AinzSpells__AinzE_KS_x[this] + localLength * Cos(lengthAngle) + curveOffset * Cos(s__AinzSpells__AinzE_KS_a[this])
                set blockY=s__AinzSpells__AinzE_KS_y[this] + localLength * Sin(lengthAngle) + curveOffset * Sin(s__AinzSpells__AinzE_KS_a[this])
                set d=CreateDestructable(AinzE_PathBlockerId, blockX, blockY, s__AinzSpells__AinzE_KS_a[this] * bj_RADTODEG, 1.00, 0)
                call SaveDestructableHandle(hs, this, s__AinzSpells__AinzE_KS_blockerCount[this], d)
                set s__AinzSpells__AinzE_KS_blockerCount[this]=s__AinzSpells__AinzE_KS_blockerCount[this] + 1
                set index=index + 1
            endloop
            set d=null
        endfunction

        function s__AinzSpells__AinzE_KS_CreateWallEffects takes integer this returns nothing
            local integer index= 0
            local integer count= AinzE_WallEffectCount
            local real localLength
            local real normalized
            local real curveOffset
            local real effectX
            local real effectY
            local real lengthAngle= s__AinzSpells__AinzE_KS_a[this] + bj_PI * 0.50

            if count < 2 then
                set count=2
            endif

            // Called once from AinzE_Start. The visual count is independent
            // from the much larger pathing-blocker count.
            loop
                exitwhen index >= count
                set localLength=- AinzE_WallLength * 0.50 + I2R(index) * AinzE_WallLength / I2R(count - 1)
                set normalized=localLength / ( AinzE_WallLength * 0.50 )
                set curveOffset=AinzE_WallForwardOffset - AinzE_WallCurve * normalized * normalized
                set effectX=s__AinzSpells__AinzE_KS_x[this] + localLength * Cos(lengthAngle) + curveOffset * Cos(s__AinzSpells__AinzE_KS_a[this])
                set effectY=s__AinzSpells__AinzE_KS_y[this] + localLength * Sin(lengthAngle) + curveOffset * Sin(s__AinzSpells__AinzE_KS_a[this])
                call DestroyEffect(EffectSpawn("war3mapimported\\wos_1baozha_90.mdl" , effectX , effectY , GetRandomReal(0, 359) , 0.5 , 1.25 , 0))
                call DestroyEffect(EffectSpawn(AinzE_WallEffectModel , effectX , effectY , GetRandomReal(0.00, 359.00) , 0.50 , 1.50 , 0.00))
                set index=index + 1
            endloop
        endfunction

