//library PatriotSpells:
    function PatriotPas takes unit c,unit td returns nothing
    local real x= GetUnitX(td)
    local real y= GetUnitY(td)
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", td, "chest"))
        call s__GearSystems2___KS_MoveEffectToUnit_MoveEffectToUnit_Start((EffectSpawn("war3mapImported\\wos_Satsu-WWSFX-1.mdx" , x , y , 0 * bj_RADTODEG , 1.25 , 2. , 75) ) , (( 0.76 )*1.0) , (( 75 )*1.0) , ( td) , 0 , 1 , null) // INLINED!!
        call s__GearSystems2___KS_DelayedDamage_NextDmg_Start((c ) , ( td ) , (( PatriotG_DamageAgiBase * GetHeroAgi(c, true) )*1.0) , ( 0 ) , (( 0.1)*1.0)) // INLINED!!
        call s__GearSystems2___KS_FakeCooldown_FakeCD_Start1((c ) , ( PatriotG_ID ) , (( PatriotG_CD )*1.0) , ( 0 ) , ( 0)) // INLINED!!
    endfunction
    function BuffUnitPat takes unit c,unit u,integer level returns nothing
            local integer i= GetPlayerId(GetOwningPlayer(c))
            if patdummy1[i] == null or GetWidgetLife(patdummy1[i]) < 1 then
                set patdummy1[i]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'h0C9', GetRectCenterX(gg_rct_Caster), GetRectCenterY(gg_rct_Caster), 0)
                call UnitAddAbility(patdummy1[i], 'A0EG')
            endif
            if level > 0 then
                if GetUnitAbilityLevel(patdummy1[i], 'A0EG') == 0 then
                    call UnitAddAbility(patdummy1[i], 'A0EG')
                endif
                call SetUnitAbilityLevel(patdummy1[i], 'A0EG', level)
                call SetUnitFacing(patdummy1[i], GAngle(patdummy1[i] , u) * bj_RADTODEG)
                call IssueTargetOrder(patdummy1[i], "innerfire", u)
            endif
    endfunction

    function s__PatriotSpells__PatriotSpells_E_Loop_PatriotE takes nothing returns nothing
        local integer this
        local integer i= 0
        local real random= 0
        loop
            exitwhen i > s__PatriotSpells__PatriotSpells_E_MUI_PatriotE
            set this=s__PatriotSpells__PatriotSpells_E_m_PatriotE[i]
            if SpellBoolCaster(s__PatriotSpells__PatriotSpells_E_c[this]) and s__PatriotSpells__PatriotSpells_E_r[this] <= s__PatriotSpells__PatriotSpells_E_rmax[this] then
                if IsUnitPaused(s__PatriotSpells__PatriotSpells_E_c[this]) == false then
                    set s__PatriotSpells__PatriotSpells_E_r[this]=RoundReal(s__PatriotSpells__PatriotSpells_E_r[this] + 0.03 , 3)
                endif
                if s__PatriotSpells__PatriotSpells_E_r[this] == 0.03 then
                    if GetLocalPlayer() == GetOwningPlayer(s__PatriotSpells__PatriotSpells_E_c[this]) then
                        call ClearSelection()
                        call SelectUnit(s__PatriotSpells__PatriotSpells_E_c[this], true)
                        call PanCameraToTimed(GetUnitX(s__PatriotSpells__PatriotSpells_E_c[this]), GetUnitY(s__PatriotSpells__PatriotSpells_E_c[this]), 0)
                    endif
                endif
                set s__PatriotSpells__PatriotSpells_E_dmg[this]=GetUnitState(s__PatriotSpells__PatriotSpells_E_c[this], UNIT_STATE_MAX_LIFE) * 0.1
                call SetUnitState(s__PatriotSpells__PatriotSpells_E_c[this], UNIT_STATE_LIFE, s__PatriotSpells__PatriotSpells_E_dmg[this])
                call BlzFrameSetValue(s___PatriotSpells__PatriotSpells_E_frame_pas3[s__PatriotSpells__PatriotSpells_E_frame_pas3[this]+s__PatriotSpells__PatriotSpells_E_k2[this]], s__PatriotSpells__PatriotSpells_E_rmax[this] - ( s__PatriotSpells__PatriotSpells_E_r[this] + 0.05 ))
                if s__PatriotSpells__PatriotSpells_E_rmax[this] - s__PatriotSpells__PatriotSpells_E_r[this] >= 0 then
                    call BlzFrameSetText(s___PatriotSpells__PatriotSpells_E_frame_pas6[s__PatriotSpells__PatriotSpells_E_frame_pas6[this]+s__PatriotSpells__PatriotSpells_E_k2[this]], "|c00FFFF00" + R2SW(s__PatriotSpells__PatriotSpells_E_rmax[this] - s__PatriotSpells__PatriotSpells_E_r[this], 0, 2) + "|r")
                endif
                set s__PatriotSpells__PatriotSpells_E_x1[this]=GetUnitX(s__PatriotSpells__PatriotSpells_E_c[this])
                set s__PatriotSpells__PatriotSpells_E_y1[this]=GetUnitY(s__PatriotSpells__PatriotSpells_E_c[this])
                   
            else
                  //  call StopSpellUnit(c)
                call KillUnit(s__PatriotSpells__PatriotSpells_E_c[this])
                if GetLocalPlayer() == GetOwningPlayer(s__PatriotSpells__PatriotSpells_E_c[this]) then
                    call BlzFrameSetVisible(s___PatriotSpells__PatriotSpells_E_frame_pas1[s__PatriotSpells__PatriotSpells_E_frame_pas1[this]+s__PatriotSpells__PatriotSpells_E_k2[this]], false)
                endif
                call SaveInteger(hs, GetHandleId(s__PatriotSpells__PatriotSpells_E_c[this]), StringHash("patriot ee"), 0)
                call DestroyEffect(s__PatriotSpells__PatriotSpells_E_e[this])
                call DestroyEffect(s__PatriotSpells__PatriotSpells_E_e2[this])
                set s__PatriotSpells__PatriotSpells_E_c[this]=null
                set s__PatriotSpells__PatriotSpells_E_e[this]=null
                set s__PatriotSpells__PatriotSpells_E_m_PatriotE[i]=s__PatriotSpells__PatriotSpells_E_m_PatriotE[s__PatriotSpells__PatriotSpells_E_MUI_PatriotE]
                set s__PatriotSpells__PatriotSpells_E_MUI_PatriotE=s__PatriotSpells__PatriotSpells_E_MUI_PatriotE - 1
                if s__PatriotSpells__PatriotSpells_E_MUI_PatriotE == - 1 then
                    call PauseTimer(s__PatriotSpells__PatriotSpells_E_t_PatriotE)
                endif
                call s__PatriotSpells__PatriotSpells_E_deallocate(this)
                set i=i - 1
            endif
            set i=i + 1
        endloop
    endfunction

    function s__PatriotSpells__PatriotSpells_E_PatriotE_Start takes unit NewC returns nothing
        local integer this= s__PatriotSpells__PatriotSpells_E__allocate()
        local real tmp_y= 0
            local real cd1
    local real cd2
        set s__PatriotSpells__PatriotSpells_E_MUI_PatriotE=s__PatriotSpells__PatriotSpells_E_MUI_PatriotE + 1
        set s__PatriotSpells__PatriotSpells_E_m_PatriotE[s__PatriotSpells__PatriotSpells_E_MUI_PatriotE]=this
        set s__PatriotSpells__PatriotSpells_E_c[this]=NewC
        set cd1=BlzGetUnitAbilityCooldownRemaining(s__PatriotSpells__PatriotSpells_E_c[this], PatriotT_ID)
        set cd2=BlzGetUnitAbilityCooldownRemaining(s__PatriotSpells__PatriotSpells_E_c[this], PatriotT2_ID)
        set s__PatriotSpells__PatriotSpells_E_r[this]=0
        set s__PatriotSpells__PatriotSpells_E_r2[this]=10
        set s__PatriotSpells__PatriotSpells_E_r3[this]=10
        set s__PatriotSpells__PatriotSpells_E_check[this]=0
        set s__PatriotSpells__PatriotSpells_E_check2[this]=0
        set s__PatriotSpells__PatriotSpells_E_r5[this]=0.39
        set s__PatriotSpells__PatriotSpells_E_k2[this]=GetPlayerId(GetOwningPlayer(s__PatriotSpells__PatriotSpells_E_c[this]))
        call ReviveHero(s__PatriotSpells__PatriotSpells_E_c[this], GetUnitX(s__PatriotSpells__PatriotSpells_E_c[this]), GetUnitY(s__PatriotSpells__PatriotSpells_E_c[this]), true)
           // set aoe = PatriotE_DamageAoe
        set s__PatriotSpells__PatriotSpells_E_g[this]=CreateGroup()
            //set dmg = GetHeroAgi( c , true) * PatriotE_DamageAgiBase
          //  call StartSpellUnit(c)
        set s__PatriotSpells__PatriotSpells_E_x[this]=GetUnitX(s__PatriotSpells__PatriotSpells_E_c[this])
        set s__PatriotSpells__PatriotSpells_E_y[this]=GetUnitY(s__PatriotSpells__PatriotSpells_E_c[this])
        call SetPlayerAbilityAvailable(GetOwningPlayer(s__PatriotSpells__PatriotSpells_E_c[this]), PatriotF_ID, false)
        call SetPlayerAbilityAvailable(GetOwningPlayer(s__PatriotSpells__PatriotSpells_E_c[this]), PatriotT_ID, false)
        call SetPlayerAbilityAvailable(GetOwningPlayer(s__PatriotSpells__PatriotSpells_E_c[this]), PatriotF2_ID, true)
        call SetPlayerAbilityAvailable(GetOwningPlayer(s__PatriotSpells__PatriotSpells_E_c[this]), PatriotT2_ID, true)
        call UnitAddAbility(s__PatriotSpells__PatriotSpells_E_c[this], PatriotF2_ID)
        if GetUnitAbilityLevel(s__PatriotSpells__PatriotSpells_E_c[this], PatriotT_ID) > 0 then
        call UnitAddAbility(s__PatriotSpells__PatriotSpells_E_c[this], PatriotT2_ID)
        call BlzStartUnitAbilityCooldown(s__PatriotSpells__PatriotSpells_E_c[this], PatriotT2_ID, cd1)
        endif
        call AddUnitAnimationProperties(s__PatriotSpells__PatriotSpells_E_c[this], "alternate", true)
        call s__GearSystems2___KS_RemoveUnit_MyRemoveUnit_Start((s__PatriotSpells__PatriotSpells_E_c[this] ) , (( 0.03 )*1.0) , 2 , - 1 , ( 8) , "") // INLINED!!
        call SaveInteger(hs, GetHandleId(s__PatriotSpells__PatriotSpells_E_c[this]), StringHash("patriot e"), 1)
        call AddSpellLevel(s__PatriotSpells__PatriotSpells_E_c[this] , 'A01C' , 10 , true)
        call BlzSetAbilityIcon(PatriotE_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Patriot_E2.blp")
        call SaveInteger(hs, GetHandleId(s__PatriotSpells__PatriotSpells_E_c[this]), StringHash("patriot e"), 1)
        call SaveInteger(hs, GetHandleId(s__PatriotSpells__PatriotSpells_E_c[this]), StringHash("patriot ee"), 1)
        set s__PatriotSpells__PatriotSpells_E_rmax[this]=PatriotEE_Duration
        if s___PatriotSpells__PatriotSpells_E_frame_pas1[s__PatriotSpells__PatriotSpells_E_frame_pas1[this]+s__PatriotSpells__PatriotSpells_E_k2[this]] == null then
            set s___PatriotSpells__PatriotSpells_E_frame_pas1[s__PatriotSpells__PatriotSpells_E_frame_pas1[this]+s__PatriotSpells__PatriotSpells_E_k2[this]]=BlzCreateFrameByType("BACKDROP", "SS", BlzGetFrameByName("ConsoleUIBackdrop", 0), "", 0)
