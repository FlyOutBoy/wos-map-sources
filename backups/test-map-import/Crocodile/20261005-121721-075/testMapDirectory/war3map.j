        function s__FrierenSpells__FrierenSpells_TQ_FrierenTQ_Start takes unit NewC,unit NewStatSource,unit NewTd returns nothing
            local integer this= s__FrierenSpells__FrierenSpells_TQ__allocate()
            set s__FrierenSpells__FrierenSpells_TQ_MUI_FrierenTQ=s__FrierenSpells__FrierenSpells_TQ_MUI_FrierenTQ + 1
