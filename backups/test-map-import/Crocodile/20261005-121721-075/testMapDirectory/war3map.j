                            set s__MilimSpells___MilimQKS_y[this]=GetUnitY(s__MilimSpells___MilimQKS_td[this])
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_az_hitheavy.mdl" , s__MilimSpells___MilimQKS_x[this] , s__MilimSpells___MilimQKS_y[this] , s__MilimSpells___MilimQKS_a[this] * bj_RADTODEG , 0.5 , 4.25 , 125))
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_BDEF (124)2.mdx" , s__MilimSpells___MilimQKS_x[this] , s__MilimSpells___MilimQKS_y[this] , GetRandomReal(0, 359) , 1 , 2.5 , 125))
                            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", s__MilimSpells___MilimQKS_td[this], "chest"))
                            call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_tx-ha_nitu.mdl" , GetUnitX(s__MilimSpells___MilimQKS_c[this]) , GetUnitY(s__MilimSpells___MilimQKS_c[this]) , s__MilimSpells___MilimQKS_a[this] * bj_RADTODEG , 2 , 2.45 , 2 , 255 , 255 , 255 , 255))
                        call DestroyEffect(EffectSpawn("war3mapImported\\senji-wind-impact-2.mdx" , s__MilimSpells___MilimQKS_x[this] + 190 * Cos(s__MilimSpells___MilimQKS_a[this]) , s__MilimSpells___MilimQKS_y[this] + 190 * Sin(s__MilimSpells___MilimQKS_a[this]) , s__MilimSpells___MilimQKS_a[this] * bj_RADTODEG , 2 , 1.15 , 85))
                        call DestroyEffect(EffectSpawn("war3mapImported\\senji-wind-impact-2.mdx" , s__MilimSpells___MilimQKS_x[this] + 290 * Cos(s__MilimSpells___MilimQKS_a[this]) , s__MilimSpells___MilimQKS_y[this] + 290 * Sin(s__MilimSpells___MilimQKS_a[this]) , s__MilimSpells___MilimQKS_a[this] * bj_RADTODEG , 1.9 , 1.35 , 85))
                        call DestroyEffect(EffectSpawn("war3mapImported\\senji-wind-impact-2.mdx" , s__MilimSpells___MilimQKS_x[this] + 390 * Cos(s__MilimSpells___MilimQKS_a[this]) , s__MilimSpells___MilimQKS_y[this] + 390 * Sin(s__MilimSpells___MilimQKS_a[this]) , s__MilimSpells___MilimQKS_a[this] * bj_RADTODEG , 1.8 , 1.55 , 85))
                        call EffectSpawn2("war3mapimported\\wos_LD2209 (157).mdx" , s__MilimSpells___MilimQKS_x[this] , s__MilimSpells___MilimQKS_y[this] , GetRandomReal(0, 359) , 1 , 0.8 , 0 , 1)
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_bloodex-special-23.mdl" , GetUnitX(s__MilimSpells___MilimQKS_td[this]) , GetUnitY(s__MilimSpells___MilimQKS_td[this]) , GetRandomReal(0, 359) , 2.5 , 2 , 80))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_az_hitheavy.mdl" , s__MilimSpells___MilimQKS_x[this] + 25 * Cos(s__MilimSpells___MilimQKS_a[this]) , s__MilimSpells___MilimQKS_y[this] + 25 * Sin(s__MilimSpells___MilimQKS_a[this]) , s__MilimSpells___MilimQKS_a[this] * bj_RADTODEG , 1 , 2.25 , 125))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_cf2.mdx" , s__MilimSpells___MilimQKS_x[this] + 125 * Cos(s__MilimSpells___MilimQKS_a[this]) , s__MilimSpells___MilimQKS_y[this] + 125 * Sin(s__MilimSpells___MilimQKS_a[this]) , s__MilimSpells___MilimQKS_a[this] * bj_RADTODEG , 0.6 , 1.45 , 15))
                          call DecorRemove(s__MilimSpells___MilimQKS_c[this] , s__MilimSpells___MilimQKS_x[this] , s__MilimSpells___MilimQKS_y[this] , MilimQ_DamageAoe2 , 25)
                                set s__MilimSpells___MilimQKS_r[this]=99999
                                call GroupEnumUnitsInRange(s__MilimSpells___MilimQKS_g[this], s__MilimSpells___MilimQKS_x[this], s__MilimSpells___MilimQKS_y[this], MilimQ_DamageAoe2, NoDecor_Cond)
                        loop
                            set s__MilimSpells___MilimQKS_u[this]=FirstOfGroup(s__MilimSpells___MilimQKS_g[this])
                            exitwhen s__MilimSpells___MilimQKS_u[this] == null
                            if SpellBool(s__MilimSpells___MilimQKS_u[this]) and IsUnitEnemy(s__MilimSpells___MilimQKS_u[this], GetOwningPlayer(s__MilimSpells___MilimQKS_c[this])) then
                                call dmgphys(s__MilimSpells___MilimQKS_c[this] , s__MilimSpells___MilimQKS_u[this] , s__MilimSpells___MilimQKS_dmg[this])
                                call MUE(s__MilimSpells___MilimQKS_u[this] , MilimQ_PushRange , MilimQ_PushDuration , s__MilimSpells___MilimQKS_a[this])
                            endif
                            call GroupRemoveUnit(s__MilimSpells___MilimQKS_g[this], s__MilimSpells___MilimQKS_u[this])
                        endloop
                           endif
                           endif
                else
                    
                        call StopSpellUnit2(s__MilimSpells___MilimQKS_c[this])
                    call SetUnitTimeScale(s__MilimSpells___MilimQKS_c[this], 1)
                    call DestroyEffect(s__MilimSpells___MilimQKS_e[this])
                    call DestroyEffect(s__MilimSpells___MilimQKS_e2[this])
                    call DestroyEffect(s__MilimSpells___MilimQKS_e3[this])
                    call DestroyGroup(s__MilimSpells___MilimQKS_g[this])
                    call DestroyGroup(s__MilimSpells___MilimQKS_g2[this])
                    set s__MilimSpells___MilimQKS_g[this]=null
                    set s__MilimSpells___MilimQKS_g2[this]=null
                    set s__MilimSpells___MilimQKS_c[this]=null
                    set s__MilimSpells___MilimQKS_e[this]=null
                    set s__MilimSpells___MilimQKS_e2[this]=null
                    set s__MilimSpells___MilimQKS_e3[this]=null
                    set s__MilimSpells___MilimQKS_u[this]=null
