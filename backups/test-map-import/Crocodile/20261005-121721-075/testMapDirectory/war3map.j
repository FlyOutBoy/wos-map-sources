                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_BY_Wood_Eff_Ord_YeYe_Eat_DiBanZhaKai2.mdx" , s__CrocodileSpells___CrocodileT2KS_x1[this] , s__CrocodileSpells___CrocodileT2KS_y1[this] , GetRandomReal(0, 359) , 2 , 1.85 , 0))
                        call DestroyEffect(EffectSpawnColor("war3mapimported\\wos_Mdx_Effect_05 Mikoto AZ_Dust Rush 01.mdl" , s__CrocodileSpells___CrocodileT2KS_x1[this] , s__CrocodileSpells___CrocodileT2KS_y1[this] , s__CrocodileSpells___CrocodileT2KS_a[this] * bj_RADTODEG , 1 , 1.5 , 1 , 255 , 255 , 255 , 115))
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_1baozha_90.mdl" , s__CrocodileSpells___CrocodileT2KS_x1[this] , s__CrocodileSpells___CrocodileT2KS_y1[this] , 1 , 0.5 , 2.5 , 1))
                            call DestroyEffect(EffectSpawnColor("war3mapimported\\wos_cf2.mdx" , s__CrocodileSpells___CrocodileT2KS_x1[this] , s__CrocodileSpells___CrocodileT2KS_y1[this] , s__CrocodileSpells___CrocodileT2KS_a[this] * bj_RADTODEG , 1 , 1.8 , 15 , 255 , 255 , 255 , 125))
                    else
                        set s__CrocodileSpells___CrocodileT2KS_beamRingTimer[this]=s__CrocodileSpells___CrocodileT2KS_beamRingTimer[this] + 0.03
                    endif
                    endif
                    // Eiie?aneia AOE: io 20% aicea eanoa?a ai 65% a eiioa eo?a.
                    // ?aaeon iaiyaony ieaaii ioiineoaeuii i?ieaaiiie aeeiu.
                    set s__CrocodileSpells___CrocodileT2KS_aoe[this]=CrocodileT2_DamageAoe * ( s__CrocodileSpells___CrocodileT2KS_AOE_START_FACTOR + ( s__CrocodileSpells___CrocodileT2KS_AOE_END_FACTOR - s__CrocodileSpells___CrocodileT2KS_AOE_START_FACTOR ) * s__CrocodileSpells___CrocodileT2KS_move[this] / CrocodileT2_BeamRange )
                    set s__CrocodileSpells___CrocodileT2KS_x1[this]=s__CrocodileSpells___CrocodileT2KS_x[this] + s__CrocodileSpells___CrocodileT2KS_move[this] * Cos(s__CrocodileSpells___CrocodileT2KS_a[this])
                    set s__CrocodileSpells___CrocodileT2KS_y1[this]=s__CrocodileSpells___CrocodileT2KS_y[this] + s__CrocodileSpells___CrocodileT2KS_move[this] * Sin(s__CrocodileSpells___CrocodileT2KS_a[this])
                    call DecorRemove(s__CrocodileSpells___CrocodileT2KS_c[this] , s__CrocodileSpells___CrocodileT2KS_x1[this] , s__CrocodileSpells___CrocodileT2KS_y1[this] , CrocodileT2_DamageAoe , 100)
                    call GroupClear(s__CrocodileSpells___CrocodileT2KS_g[this])
                    call GroupEnumUnitsInRange(s__CrocodileSpells___CrocodileT2KS_g[this], s__CrocodileSpells___CrocodileT2KS_x1[this], s__CrocodileSpells___CrocodileT2KS_y1[this], CrocodileT2_DamageAoe, NoDecor_Cond)
                    loop
                        set s__CrocodileSpells___CrocodileT2KS_u[this]=FirstOfGroup(s__CrocodileSpells___CrocodileT2KS_g[this])
                        exitwhen s__CrocodileSpells___CrocodileT2KS_u[this] == null
                        if SpellBool(s__CrocodileSpells___CrocodileT2KS_u[this]) and IsUnitEnemy(s__CrocodileSpells___CrocodileT2KS_u[this], GetOwningPlayer(s__CrocodileSpells___CrocodileT2KS_c[this])) and not IsUnitInGroup(s__CrocodileSpells___CrocodileT2KS_u[this], s__CrocodileSpells___CrocodileT2KS_g2[this]) then
                            call GroupAddUnit(s__CrocodileSpells___CrocodileT2KS_g2[this], s__CrocodileSpells___CrocodileT2KS_u[this])
                            call SaveInteger(hs, GetHandleId(s__CrocodileSpells___CrocodileT2KS_g2[this]), GetHandleId(s__CrocodileSpells___CrocodileT2KS_u[this]), 0)
