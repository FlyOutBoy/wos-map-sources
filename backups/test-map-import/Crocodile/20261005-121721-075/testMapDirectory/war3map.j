        call SetUnitAnimationByIndex(s__PatriotSpells__PatriotSpells_W_c[this], 3)
        call SetUnitTimeScale(s__PatriotSpells__PatriotSpells_W_c[this], 1)
        call VisionTimed(GetOwningPlayer(s__PatriotSpells__PatriotSpells_W_c[this]) , s__PatriotSpells__PatriotSpells_W_x[this] , s__PatriotSpells__PatriotSpells_W_y[this] , 750 , 6)
        if s__PatriotSpells__PatriotSpells_W_MUI_PatriotW == 0 then
            call TimerStart(s__PatriotSpells__PatriotSpells_W_t_PatriotW, 0.03, true, function s__PatriotSpells__PatriotSpells_W_Loop_PatriotW)
