                            set s__TakeshiSpells__TakeshiSpells_G_y1[this]=GetUnitY(s__TakeshiSpells__TakeshiSpells_G_c[this])
                            call EffectSpawn2("war3mapImported\\wos_Bubbles2.mdx" , s__TakeshiSpells__TakeshiSpells_G_x1[this] , s__TakeshiSpells__TakeshiSpells_G_y1[this] , GetRandomReal(0, 359) , 1 , 6 , GetRandomReal(50, 150) , 0.15)
