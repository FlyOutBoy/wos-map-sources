                        call MakeSound("war3mapimported\\Hero_Takeshi_GR2")
                        set s__TakeshiSpells__TakeshiSpells_G_r[this]=9999
                    endif
                endif
            else
                call StopSpellUnit2(s__TakeshiSpells__TakeshiSpells_G_td[this])
                call StopSpellUnit2(s__TakeshiSpells__TakeshiSpells_G_c[this])
                call DestroyEffect(s__TakeshiSpells__TakeshiSpells_G_e[this])
                set s__TakeshiSpells__TakeshiSpells_G_c[this]=null
