                    // Yooaeou ?ani?aaaeaiu ii anae oe?eia i?yiioaieuieea:
                    // iaa e?ay, i?eia?ii 1/3 e 2/3 iaeanoe. Aey 10 nia?yaia yoi
                    // neiou 0, 3, 6 e 9 — iie iaeneiaeuii oaaeaiu a?oa io a?oaa.
                    set createExplosionFx=slotIndex == 0 or slotIndex == ( s__CrocodileSpells___CrocodileRKS_MISSILE_COUNT - 1 ) / 3 or slotIndex == ( s__CrocodileSpells___CrocodileRKS_MISSILE_COUNT - 1 ) * 2 / 3 or slotIndex == s__CrocodileSpells___CrocodileRKS_MISSILE_COUNT - 1

                    // Ii iaiie neo?aeiie oi?ea a ea?aie iieina i?yiioaieuieea RECT_WIDTH.
                    set slotWidth=s__CrocodileSpells___CrocodileRKS_RECT_WIDTH / I2R(s__CrocodileSpells___CrocodileRKS_MISSILE_COUNT)
                    set lateralOffset=- s__CrocodileSpells___CrocodileRKS_RECT_WIDTH * 0.50 + slotWidth * I2R(slotIndex) + GetRandomReal(0.00, slotWidth)
                    set forwardOffset=GetRandomReal(- s__CrocodileSpells___CrocodileRKS_RECT_DEPTH * 0.50, s__CrocodileSpells___CrocodileRKS_RECT_DEPTH * 0.50)
                    set targetX=s__CrocodileSpells___CrocodileRKS_x[this] + forwardOffset * Cos(s__CrocodileSpells___CrocodileRKS_a[this]) + lateralOffset * Cos(s__CrocodileSpells___CrocodileRKS_a[this] + 90.00 * bj_DEGTORAD)
                    set targetY=s__CrocodileSpells___CrocodileRKS_y[this] + forwardOffset * Sin(s__CrocodileSpells___CrocodileRKS_a[this]) + lateralOffset * Sin(s__CrocodileSpells___CrocodileRKS_a[this] + 90.00 * bj_DEGTORAD)

                    // ?ai iic?a aueaoae nia?ya, oai iaiuoa a?aiy iie?oa.
                    // Ana oanou i?eeaoa?o i?eia?ii a iaei iiiaio.
                    set flightTime=s__CrocodileSpells___CrocodileRKS_MISSILE_MIN_FLIGHT_TIME + s__CrocodileSpells___CrocodileRKS_MISSILE_RELEASE_WINDOW - releaseOffset

                    // CAOU?EA: ei?ioeee yooaeo i?e auionea ea?aiai nia?yaa.
                    call DestroyEffect(EffectSpawn("war3mapImported\\effect lvse-magic-shousuo blue.mdl" , GetUnitX(s__CrocodileSpells___CrocodileRKS_c[this]) + add * Cos(s__CrocodileSpells___CrocodileRKS_a[this]) , GetUnitY(s__CrocodileSpells___CrocodileRKS_c[this]) + add * Sin(s__CrocodileSpells___CrocodileRKS_a[this]) , GetRandomReal(0, 359) , 1.00 , 2.00 , 120.00))
                    call SaveInteger(hs, GetHandleId(s__CrocodileSpells___CrocodileRKS_g[this]), StringHash("CrocodileR projectiles left"), LoadInteger(hs, GetHandleId(s__CrocodileSpells___CrocodileRKS_g[this]), StringHash("CrocodileR projectiles left")) + 1)
                    call s__CrocodileSpells___CrocodileRProjectileKS_CrocodileRProjectile_Start(s__CrocodileSpells___CrocodileRKS_c[this] , GetUnitX(s__CrocodileSpells___CrocodileRKS_c[this]) + add * Cos(s__CrocodileSpells___CrocodileRKS_a[this]) , GetUnitY(s__CrocodileSpells___CrocodileRKS_c[this]) + add * Sin(s__CrocodileSpells___CrocodileRKS_a[this]) , targetX , targetY , arcSide , GetRandomReal(s__CrocodileSpells___CrocodileRKS_ARC_MIN, s__CrocodileSpells___CrocodileRKS_ARC_MAX) , GetUnitFlyHeight(s__CrocodileSpells___CrocodileRKS_c[this]) + GetRandomReal(110.00, 230.00) , flightTime , s__CrocodileSpells___CrocodileRKS_dmg[this] , s__CrocodileSpells___CrocodileRKS_g[this] , createExplosionFx)
                    set s__CrocodileSpells___CrocodileRKS_launched[this]=s__CrocodileSpells___CrocodileRKS_launched[this] + 1
                endif
            else
                call PauseUnit(s__CrocodileSpells___CrocodileRKS_c[this], false)
                call StopSpellUnit(s__CrocodileSpells___CrocodileRKS_c[this])
                call SetUnitTimeScale(s__CrocodileSpells___CrocodileRKS_c[this], 1.00)
                call DestroyEffect(s__CrocodileSpells___CrocodileRKS_e[this])
                call DestroyEffect(s__CrocodileSpells___CrocodileRKS_e2[this])
                call DestroyEffect(s__CrocodileSpells___CrocodileRKS_e3[this])
                if LoadInteger(hs, GetHandleId(s__CrocodileSpells___CrocodileRKS_g[this]), StringHash("CrocodileR projectiles left")) <= 0 then
                    call FlushChildHashtable(hs, GetHandleId(s__CrocodileSpells___CrocodileRKS_g[this]))
                    call DestroyGroup(s__CrocodileSpells___CrocodileRKS_g[this])
                endif
                set s__CrocodileSpells___CrocodileRKS_e[this]=null
                set s__CrocodileSpells___CrocodileRKS_e2[this]=null
                set s__CrocodileSpells___CrocodileRKS_e3[this]=null
                set s__CrocodileSpells___CrocodileRKS_g[this]=null
                set s__CrocodileSpells___CrocodileRKS_c[this]=null

                set s__CrocodileSpells___CrocodileRKS_m_CrocodileR[i]=s__CrocodileSpells___CrocodileRKS_m_CrocodileR[s__CrocodileSpells___CrocodileRKS_MUI_CrocodileR]
                set s__CrocodileSpells___CrocodileRKS_MUI_CrocodileR=s__CrocodileSpells___CrocodileRKS_MUI_CrocodileR - 1
                if s__CrocodileSpells___CrocodileRKS_MUI_CrocodileR == - 1 then
                    call PauseTimer(s__CrocodileSpells___CrocodileRKS_t_CrocodileR)
                endif
                call s__CrocodileSpells___CrocodileRKS_deallocate(this)
                set i=i - 1
            endif

            set i=i + 1
        endloop
    endfunction

    function s__CrocodileSpells___CrocodileRKS_CrocodileR_Start takes unit NewC,real NewX,real NewY returns nothing
        local integer this= s__CrocodileSpells___CrocodileRKS__allocate()

        set s__CrocodileSpells___CrocodileRKS_MUI_CrocodileR=s__CrocodileSpells___CrocodileRKS_MUI_CrocodileR + 1
        set s__CrocodileSpells___CrocodileRKS_m_CrocodileR[s__CrocodileSpells___CrocodileRKS_MUI_CrocodileR]=this
        set s__CrocodileSpells___CrocodileRKS_c[this]=NewC
        set s__CrocodileSpells___CrocodileRKS_x[this]=NewX
        set s__CrocodileSpells___CrocodileRKS_y[this]=NewY
        set s__CrocodileSpells___CrocodileRKS_a[this]=GAngle2(s__CrocodileSpells___CrocodileRKS_c[this] , s__CrocodileSpells___CrocodileRKS_x[this] , s__CrocodileSpells___CrocodileRKS_y[this])
        set s__CrocodileSpells___CrocodileRKS_r[this]=0.00
        set s__CrocodileSpells___CrocodileRKS_launched[this]=0

        // E?aie ?ieo iieo?aao yoio iieiue o?ii oieuei io ia?aiai iiiaaoaai nia?yaa.
        set s__CrocodileSpells___CrocodileRKS_dmg[this]=GetHeroAgi(s__CrocodileSpells___CrocodileRKS_c[this], true) * ( CrocodileR_DamageAgiBase + CrocodileR_DamageAgiStep * ( GetUnitAbilityLevel(s__CrocodileSpells___CrocodileRKS_c[this], CrocodileR_ID) - 1 ) )

        set s__CrocodileSpells___CrocodileRKS_g[this]=CreateGroup()
        call SaveInteger(hs, GetHandleId(s__CrocodileSpells___CrocodileRKS_g[this]), StringHash("CrocodileR projectiles left"), 0)

        call SaveInteger(hs, GetHandleId(GetOwningPlayer(s__CrocodileSpells___CrocodileRKS_c[this])), StringHash(I2S(CrocodileR_ID)), 0)
        call StartSpellUnit(s__CrocodileSpells___CrocodileRKS_c[this])
        call SetUnitAnimationByIndex(s__CrocodileSpells___CrocodileRKS_c[this], 7)
        call MakeSound("war3mapimported\\Hero_Crocodile_R 1")
        call MakeSound("war3mapimported\\Hero_Crocodile_R 2")
        // CAOU?EA: yooaeo iiaaioiaee e auioneo nia?yaia.

        if s__CrocodileSpells___CrocodileRKS_MUI_CrocodileR == 0 then
            call TimerStart(s__CrocodileSpells___CrocodileRKS_t_CrocodileR, 0.03, true, function s__CrocodileSpells___CrocodileRKS_Loop_CrocodileR)
        endif
    endfunction



