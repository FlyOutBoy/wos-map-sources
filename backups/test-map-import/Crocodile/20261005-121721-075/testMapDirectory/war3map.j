       //set e2 = AddSpecialEffectTarget("war3mapImported\\wos_YellowMissile.mdl", c, "hand right")
            if s__FrierenSpells__FrierenSpells_TQ_MUI_FrierenTQ == 0 then
                call FrierenSpells__FrierenTimer03Acquire()
            endif
        endfunction
