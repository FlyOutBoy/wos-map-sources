        function s__ErzaQSpells___ErzaPas_KS_Loop_ErzaE2 takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__ErzaQSpells___ErzaPas_KS_MUI_ErzaE2
                set this=s__ErzaQSpells___ErzaPas_KS_m_ErzaE2[i]
                if SpellBoolCaster(s__ErzaQSpells___ErzaPas_KS_c[this]) and s__ErzaQSpells___ErzaPas_KS_r[this] <= s__ErzaQSpells___ErzaPas_KS_rmax[this] then
                    set s__ErzaQSpells___ErzaPas_KS_r[this]=s__ErzaQSpells___ErzaPas_KS_r[this] + 0.03
                    set s__ErzaQSpells___ErzaPas_KS_aoe[this]=s__ErzaQSpells___ErzaPas_KS_aoe[this] + s__ErzaQSpells___ErzaPas_KS_r5[this]
                    call DecorRemove(s__ErzaQSpells___ErzaPas_KS_c[this] , s__ErzaQSpells___ErzaPas_KS_x[this] , s__ErzaQSpells___ErzaPas_KS_y[this] , s__ErzaQSpells___ErzaPas_KS_aoe[this] , 20)
                    call GroupEnumUnitsInRange(s__ErzaQSpells___ErzaPas_KS_g[this], s__ErzaQSpells___ErzaPas_KS_x[this], s__ErzaQSpells___ErzaPas_KS_y[this], s__ErzaQSpells___ErzaPas_KS_aoe[this], NoDecor_Cond)
                    loop
                        set s__ErzaQSpells___ErzaPas_KS_u[this]=FirstOfGroup(s__ErzaQSpells___ErzaPas_KS_g[this])
                        exitwhen s__ErzaQSpells___ErzaPas_KS_u[this] == null
                        if IsUnitEnemy(s__ErzaQSpells___ErzaPas_KS_u[this], GetOwningPlayer(s__ErzaQSpells___ErzaPas_KS_c[this])) and SpellBool(s__ErzaQSpells___ErzaPas_KS_u[this]) and IsUnitInGroup(s__ErzaQSpells___ErzaPas_KS_u[this], s__ErzaQSpells___ErzaPas_KS_g2[this]) == false then
                            call dmgmag(s__ErzaQSpells___ErzaPas_KS_c[this] , s__ErzaQSpells___ErzaPas_KS_u[this] , s__ErzaQSpells___ErzaPas_KS_dmg[this])
                            call ErzaPassive(s__ErzaQSpells___ErzaPas_KS_c[this] , s__ErzaQSpells___ErzaPas_KS_u[this] , 1)
                            call GroupAddUnit(s__ErzaQSpells___ErzaPas_KS_g2[this], s__ErzaQSpells___ErzaPas_KS_u[this])
                        endif
                        call GroupRemoveUnit(s__ErzaQSpells___ErzaPas_KS_g[this], s__ErzaQSpells___ErzaPas_KS_u[this])
                    endloop
                else
                    call DestroyGroup(s__ErzaQSpells___ErzaPas_KS_g[this])
                    set s__ErzaQSpells___ErzaPas_KS_g[this]=null
                    call DestroyGroup(s__ErzaQSpells___ErzaPas_KS_g2[this])
                    set s__ErzaQSpells___ErzaPas_KS_g2[this]=null
                    set s__ErzaQSpells___ErzaPas_KS_c[this]=null
                    set s__ErzaQSpells___ErzaPas_KS_u[this]=null
                    set s__ErzaQSpells___ErzaPas_KS_m_ErzaE2[i]=s__ErzaQSpells___ErzaPas_KS_m_ErzaE2[s__ErzaQSpells___ErzaPas_KS_MUI_ErzaE2]
                    set s__ErzaQSpells___ErzaPas_KS_MUI_ErzaE2=s__ErzaQSpells___ErzaPas_KS_MUI_ErzaE2 - 1
                    if s__ErzaQSpells___ErzaPas_KS_MUI_ErzaE2 == - 1 then
                        call PauseTimer(s__ErzaQSpells___ErzaPas_KS_t_ErzaE2)
                    endif
                    call s__ErzaQSpells___ErzaPas_KS_deallocate(this)
                endif
