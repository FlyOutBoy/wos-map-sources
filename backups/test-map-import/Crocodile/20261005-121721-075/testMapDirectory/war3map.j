                                set s__InoriSpells___InoriQ_KS_e2[this]=EffectSpawn("war3mapImported\\wos_Marco bullet.mdl" , s__InoriSpells___InoriQ_KS_x1[this] , s__InoriSpells___InoriQ_KS_y1[this] , s__InoriSpells___InoriQ_KS_a[this] * bj_RADTODEG , 0.5 , 0.7 , 150)
                                call ColorEffDummy3(EffectSpawn("war3mapImported\\wos_alucard bullet_backward.mdl" , s__InoriSpells___InoriQ_KS_x1[this] + 130 * Cos(s__InoriSpells___InoriQ_KS_a[this]) , GetUnitY(s__InoriSpells___InoriQ_KS_c[this]) + 130 * Sin(s__InoriSpells___InoriQ_KS_a[this]) , GetRandomReal(0, 359) , 1 , 1 , 0) , 1 , 255 , 255 , 255 , 1)
                                set s__InoriSpells___InoriQ_KS_rmax[this]=2
                                set s__InoriSpells___InoriQ_KS_r[this]=0
                            endif
                        elseif s__InoriSpells___InoriQ_KS_check[this] == 1 then
