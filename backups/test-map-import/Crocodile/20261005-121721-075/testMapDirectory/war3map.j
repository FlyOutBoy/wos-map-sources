                    set s__LaxusSpells__LaxusQ_KS_r2[this]=s__LaxusSpells__LaxusQ_KS_r7[this] + 10
                endif

                call MoveLightningEx(s__LaxusSpells__LaxusQ_KS_l[this], false, GetUnitX(s__LaxusSpells__LaxusQ_KS_c[this]) + s__LaxusSpells__LaxusQ_KS_r2[this] * Cos(s__LaxusSpells__LaxusQ_KS_a[this]), GetUnitY(s__LaxusSpells__LaxusQ_KS_c[this]) + s__LaxusSpells__LaxusQ_KS_r2[this] * Sin(s__LaxusSpells__LaxusQ_KS_a[this]), GetUnitFlyHeight(s__LaxusSpells__LaxusQ_KS_c[this]) + LaxusQ_CasterLightningHeight2, s__LaxusSpells__LaxusQ_KS_x[this], s__LaxusSpells__LaxusQ_KS_y[this], GetUnitFlyHeight(s__LaxusSpells__LaxusQ_KS_c[this]) + LaxusQ_CasterLightningHeight2)

                // Destroy only after the tail has actually reached the head.
                if s__LaxusSpells__LaxusQ_KS_r2[this] >= s__LaxusSpells__LaxusQ_KS_r7[this] + 10 then
                    set s__LaxusSpells__LaxusQ_KS_r[this]=999999
                endif
            endif

        else
            call SetUnitAnimation(s__LaxusSpells__LaxusQ_KS_c[this], "stand")
            call SetUnitTimeScale(s__LaxusSpells__LaxusQ_KS_c[this], 1)
            call StopSpellUnit2(s__LaxusSpells__LaxusQ_KS_c[this])
            call DestroyEffect(s__LaxusSpells__LaxusQ_KS_e[this])
            call DestroyLightning(s__LaxusSpells__LaxusQ_KS_l[this])
            call DestroyGroup(s__LaxusSpells__LaxusQ_KS_g[this])
            call DestroyGroup(s__LaxusSpells__LaxusQ_KS_g2[this])
            set s__LaxusSpells__LaxusQ_KS_g[this]=null
            set s__LaxusSpells__LaxusQ_KS_g2[this]=null
            set s__LaxusSpells__LaxusQ_KS_l[this]=null
            set s__LaxusSpells__LaxusQ_KS_e[this]=null
            set s__LaxusSpells__LaxusQ_KS_c[this]=null
            set s__LaxusSpells__LaxusQ_KS_u[this]=null
            set s__LaxusSpells__LaxusQ_KS_m_LaxusQ2[i]=s__LaxusSpells__LaxusQ_KS_m_LaxusQ2[s__LaxusSpells__LaxusQ_KS_MUI_LaxusQ2]
            set s__LaxusSpells__LaxusQ_KS_MUI_LaxusQ2=s__LaxusSpells__LaxusQ_KS_MUI_LaxusQ2 - 1
            if s__LaxusSpells__LaxusQ_KS_MUI_LaxusQ2 == - 1 then
                call LaxusSpells__LaxusTimer03Release()
            endif
            call s__LaxusSpells__LaxusQ_KS_deallocate(this)
            set i=i - 1
        endif

        set i=i + 1
    endloop
endfunction

        function s__LaxusSpells__LaxusQ_KS_LaxusQ2_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__LaxusSpells__LaxusQ_KS__allocate()
            set s__LaxusSpells__LaxusQ_KS_MUI_LaxusQ2=s__LaxusSpells__LaxusQ_KS_MUI_LaxusQ2 + 1
            set s__LaxusSpells__LaxusQ_KS_m_LaxusQ2[s__LaxusSpells__LaxusQ_KS_MUI_LaxusQ2]=this
            set s__LaxusSpells__LaxusQ_KS_c[this]=NewC
            set s__LaxusSpells__LaxusQ_KS_x[this]=NewX
            set s__LaxusSpells__LaxusQ_KS_y[this]=NewY
            set s__LaxusSpells__LaxusQ_KS_r[this]=0
             set s__LaxusSpells__LaxusQ_KS_check[this]=0
 set s__LaxusSpells__LaxusQ_KS_r2[this]=10
 set s__LaxusSpells__LaxusQ_KS_r7[this]=0
 set s__LaxusSpells__LaxusQ_KS_r4[this]=1
            set s__LaxusSpells__LaxusQ_KS_r3[this]=1
            call DebugUnit2(s__LaxusSpells__LaxusQ_KS_c[this])
            set s__LaxusSpells__LaxusQ_KS_move[this]=120
            set s__LaxusSpells__LaxusQ_KS_rmax[this]=1.5

            set s__LaxusSpells__LaxusQ_KS_a[this]=GAngle2(s__LaxusSpells__LaxusQ_KS_c[this] , s__LaxusSpells__LaxusQ_KS_x[this] , s__LaxusSpells__LaxusQ_KS_y[this]) // Angle Between points
            set s__LaxusSpells__LaxusQ_KS_g[this]=CreateGroup()
            set s__LaxusSpells__LaxusQ_KS_g2[this]=CreateGroup()
            set s__LaxusSpells__LaxusQ_KS_scale[this]=0.25
            call SetUnitAnimationByIndex(s__LaxusSpells__LaxusQ_KS_c[this], 5)
            set s__LaxusSpells__LaxusQ_KS_u[this]=null
            set s__LaxusSpells__LaxusQ_KS_x[this]=GetUnitX(s__LaxusSpells__LaxusQ_KS_c[this]) + 100 * Cos(s__LaxusSpells__LaxusQ_KS_a[this])
                    set s__LaxusSpells__LaxusQ_KS_y[this]=GetUnitY(s__LaxusSpells__LaxusQ_KS_c[this]) + 100 * Sin(s__LaxusSpells__LaxusQ_KS_a[this])
            set s__LaxusSpells__LaxusQ_KS_aoe[this]=LaxusQ2_DamageAoe
            set s__LaxusSpells__LaxusQ_KS_dmg[this]=GetHeroStr(s__LaxusSpells__LaxusQ_KS_c[this], true) * ( LaxusQ_DamageStrBase + ( LaxusQ_DamageStrStep * ( GetUnitAbilityLevel(s__LaxusSpells__LaxusQ_KS_c[this], LaxusQ_ID) - 1 ) ) )
            set s__LaxusSpells__LaxusQ_KS_dmg[this]=s__LaxusSpells__LaxusQ_KS_dmg[this] + LaxusQ_Damage2StaticBase + ( LaxusQ_Damage2StaticStep * ( GetUnitAbilityLevel(s__LaxusSpells__LaxusQ_KS_c[this], LaxusQ_ID) - 1 ) )
            set s__LaxusSpells__LaxusQ_KS_check2[this]=0
            if LoadInteger(hs, GetHandleId(s__LaxusSpells__LaxusQ_KS_c[this]), StringHash("mode g")) == 1 then
                set s__LaxusSpells__LaxusQ_KS_dmg[this]=s__LaxusSpells__LaxusQ_KS_dmg[this] + GetHeroStr(s__LaxusSpells__LaxusQ_KS_c[this], true) * LaxusGQ_DamageStrBonus
                if LoadInteger(hs, GetHandleId(s__LaxusSpells__LaxusQ_KS_c[this]), StringHash("lvl5")) == 1 then
                    set s__LaxusSpells__LaxusQ_KS_check2[this]=1
                    set s__LaxusSpells__LaxusQ_KS_dmg[this]=s__LaxusSpells__LaxusQ_KS_dmg[this] + GetHeroStr(s__LaxusSpells__LaxusQ_KS_c[this], true) * LaxusGQ2_DamageStrBonus
                endif
            endif
            call MakeSound("war3mapimported\\Hero_Laxus_Q3")
            if s__LaxusSpells__LaxusQ_KS_check2[this] == 1 then
                set s__LaxusSpells__LaxusQ_KS_e[this]=EffectSpawn("war3mapImported\\wos_Lighting collection_red.mdl" , GetUnitX(s__LaxusSpells__LaxusQ_KS_c[this]) + 150 * Cos(s__LaxusSpells__LaxusQ_KS_a[this]) , GetUnitY(s__LaxusSpells__LaxusQ_KS_c[this]) + 150 * Sin(s__LaxusSpells__LaxusQ_KS_a[this]) , s__LaxusSpells__LaxusQ_KS_a[this] * bj_RADTODEG , 1 , 2 , 120)
            else
                set s__LaxusSpells__LaxusQ_KS_e[this]=EffectSpawn("war3mapImported\\wos_Lighting collection.mdl" , GetUnitX(s__LaxusSpells__LaxusQ_KS_c[this]) + 150 * Cos(s__LaxusSpells__LaxusQ_KS_a[this]) , GetUnitY(s__LaxusSpells__LaxusQ_KS_c[this]) + 150 * Sin(s__LaxusSpells__LaxusQ_KS_a[this]) , s__LaxusSpells__LaxusQ_KS_a[this] * bj_RADTODEG , 1 , 2 , 120)
            endif
            call SetUnitTimeScale(s__LaxusSpells__LaxusQ_KS_c[this], 0.55)
            call SetUnitFacing(s__LaxusSpells__LaxusQ_KS_c[this], s__LaxusSpells__LaxusQ_KS_a[this] * bj_RADTODEG)
            set s__LaxusSpells__LaxusQ_KS_r7[this]=0
            if s__LaxusSpells__LaxusQ_KS_MUI_LaxusQ2 == 0 then
                call LaxusSpells__LaxusTimer03Acquire()
            endif
        endfunction
    function s__LaxusSpells__LaxusQ_KS_Loop_LaxusQ takes nothing returns nothing
        local integer this
        local integer i= 0
        local real progress
        loop
            exitwhen i > s__LaxusSpells__LaxusQ_KS_MUI_LaxusQ
            set this=s__LaxusSpells__LaxusQ_KS_m_LaxusQ[i]

            if SpellBoolCaster(s__LaxusSpells__LaxusQ_KS_c[this]) then
                set s__LaxusSpells__LaxusQ_KS_r[this]=RoundReal(s__LaxusSpells__LaxusQ_KS_r[this] + 0.03 , 3)

                // Keep the caster paused for the whole spell.
                call DebugUnit2(s__LaxusSpells__LaxusQ_KS_c[this])
                if s__LaxusSpells__LaxusQ_KS_check[this] == 0 and s__LaxusSpells__LaxusQ_KS_r[this] >= LaxusQ_WaitTime then
                set s__LaxusSpells__LaxusQ_KS_check[this]=1
                call s__GearSystems2___KS_DelayedSound_NextSound_Start(("war3mapimported\\Hero_Laxus_Q1" ) , (( 0.3)*1.0)) // INLINED!!
                call SetUnitAnimationByIndex(s__LaxusSpells__LaxusQ_KS_c[this], 11)
                call SetUnitTimeScale(s__LaxusSpells__LaxusQ_KS_c[this], 1.25)
                endif
                // After 0.5 sec the effect starts descending.
                if s__LaxusSpells__LaxusQ_KS_r[this] >= LaxusQ_WaitTime then
                    set s__LaxusSpells__LaxusQ_KS_fallTime[this]=s__LaxusSpells__LaxusQ_KS_r[this] - LaxusQ_WaitTime
                    set progress=s__LaxusSpells__LaxusQ_KS_fallTime[this] / LaxusQ_FallTime

                    if progress > 1 then
                        set progress=1
                    endif

                    set s__LaxusSpells__LaxusQ_KS_effectZ[this]=s__LaxusSpells__LaxusQ_KS_startZ[this] * ( 1. - progress )
                    call BlzSetSpecialEffectPosition(s__LaxusSpells__LaxusQ_KS_e[this], s__LaxusSpells__LaxusQ_KS_x[this], s__LaxusSpells__LaxusQ_KS_y[this], s__LaxusSpells__LaxusQ_KS_effectZ[this])
                endif

                // The lightning is permanently attached to the moving hero
                // and to the descending effect.
                set s__LaxusSpells__LaxusQ_KS_r2[this]=s__LaxusSpells__LaxusQ_KS_r2[this] + 1.65
                call MoveLightningEx(s__LaxusSpells__LaxusQ_KS_l[this], false, GetUnitX(s__LaxusSpells__LaxusQ_KS_c[this]) + s__LaxusSpells__LaxusQ_KS_r2[this] * Cos(s__LaxusSpells__LaxusQ_KS_a[this]), GetUnitY(s__LaxusSpells__LaxusQ_KS_c[this]) + s__LaxusSpells__LaxusQ_KS_r2[this] * Sin(s__LaxusSpells__LaxusQ_KS_a[this]), GetUnitFlyHeight(s__LaxusSpells__LaxusQ_KS_c[this]) + LaxusQ_CasterLightningHeight - ( 120 * ( progress ) ), s__LaxusSpells__LaxusQ_KS_x[this], s__LaxusSpells__LaxusQ_KS_y[this], s__LaxusSpells__LaxusQ_KS_effectZ[this] + 200)

            endif

            // Damage and all finishing logic are kept directly in the timer.
            if SpellBoolCaster(s__LaxusSpells__LaxusQ_KS_c[this]) == false or s__LaxusSpells__LaxusQ_KS_fallTime[this] >= LaxusQ_FallTime then
                if SpellBoolCaster(s__LaxusSpells__LaxusQ_KS_c[this]) and s__LaxusSpells__LaxusQ_KS_fallTime[this] >= LaxusQ_FallTime then
                call MakeSound("war3mapimported\\Hero_Laxus_Q2")
                call DestroyEffect(EffectSpawn("war3mapImported\\wos_OPm (513)yellow.mdl" , s__LaxusSpells__LaxusQ_KS_x[this] , s__LaxusSpells__LaxusQ_KS_y[this] , GetRandomReal(0, 359) , 1 , 0.65 , 1))

                       call DestroyEffect(EffectSpawn("war3mapImported\\wos_[DoFT]EF501Item.mdl" , s__LaxusSpells__LaxusQ_KS_x[this] , s__LaxusSpells__LaxusQ_KS_y[this] , GetRandomReal(0, 359) , 1 , 4 , 1))
                call DestroyEffect(EffectSpawn("war3mapImported\\wos_File00229.mdl" , s__LaxusSpells__LaxusQ_KS_x[this] , s__LaxusSpells__LaxusQ_KS_y[this] , GetRandomReal(0, 359) , 0.5 , 8 , 1))
                //            call EffectSpawn2("war3mapImported\\wos_yellowspark.mdl", x , y , GetRandomReal(0, 359), 1, 4*scale, 200, 0.45)
                    call DecorRemove(s__LaxusSpells__LaxusQ_KS_c[this] , s__LaxusSpells__LaxusQ_KS_x[this] , s__LaxusSpells__LaxusQ_KS_y[this] , s__LaxusSpells__LaxusQ_KS_aoe[this] , 50)
                    call GroupClear(s__LaxusSpells__LaxusQ_KS_g[this])
                    call GroupEnumUnitsInRange(s__LaxusSpells__LaxusQ_KS_g[this], s__LaxusSpells__LaxusQ_KS_x[this], s__LaxusSpells__LaxusQ_KS_y[this], s__LaxusSpells__LaxusQ_KS_aoe[this], NoDecor_Cond)

                    loop
                        set s__LaxusSpells__LaxusQ_KS_u[this]=FirstOfGroup(s__LaxusSpells__LaxusQ_KS_g[this])
                        exitwhen s__LaxusSpells__LaxusQ_KS_u[this] == null

                        if SpellBool(s__LaxusSpells__LaxusQ_KS_u[this]) and IsUnitEnemy(s__LaxusSpells__LaxusQ_KS_u[this], GetOwningPlayer(s__LaxusSpells__LaxusQ_KS_c[this])) then
                            call dmgmag(s__LaxusSpells__LaxusQ_KS_c[this] , s__LaxusSpells__LaxusQ_KS_u[this] , s__LaxusSpells__LaxusQ_KS_dmg[this])
                        endif

                        call GroupRemoveUnit(s__LaxusSpells__LaxusQ_KS_g[this], s__LaxusSpells__LaxusQ_KS_u[this])
                    endloop
                    set s__LaxusSpells__LaxusQ_KS_u[this]=null
                    call ColorEffDummy3(EffectSpawnColor("war3mapimported\\wos_almagest1.mdl" , s__LaxusSpells__LaxusQ_KS_x[this] , s__LaxusSpells__LaxusQ_KS_y[this] , 1 , 2 , 3 * s__LaxusSpells__LaxusQ_KS_scale[this] , 155 , 75 , 225 , 255 , 0) , 0.3 , 255 , 225 , 95 , 0.3)
                endif
                call StopSpellUnit2(s__LaxusSpells__LaxusQ_KS_c[this])
                call SetUnitAnimation(s__LaxusSpells__LaxusQ_KS_c[this], "stand")
                call SetUnitTimeScale(s__LaxusSpells__LaxusQ_KS_c[this], 1)
                call DestroyLightning(s__LaxusSpells__LaxusQ_KS_l[this])
                call BlzSetSpecialEffectTimeScale(s__LaxusSpells__LaxusQ_KS_e[this], 0.75)
                call DestroyEffect(s__LaxusSpells__LaxusQ_KS_e[this])
                call DestroyEffect(s__LaxusSpells__LaxusQ_KS_e2[this])
                call DestroyEffect(s__LaxusSpells__LaxusQ_KS_e3[this])
                call DestroyEffect(s__LaxusSpells__LaxusQ_KS_e4[this])
                call DestroyGroup(s__LaxusSpells__LaxusQ_KS_g[this])

                set s__LaxusSpells__LaxusQ_KS_l[this]=null
                set s__LaxusSpells__LaxusQ_KS_e[this]=null
                set s__LaxusSpells__LaxusQ_KS_e2[this]=null
                set s__LaxusSpells__LaxusQ_KS_e3[this]=null
                set s__LaxusSpells__LaxusQ_KS_e4[this]=null
                set s__LaxusSpells__LaxusQ_KS_g[this]=null
                set s__LaxusSpells__LaxusQ_KS_c[this]=null
                set s__LaxusSpells__LaxusQ_KS_u[this]=null

                set s__LaxusSpells__LaxusQ_KS_m_LaxusQ[i]=s__LaxusSpells__LaxusQ_KS_m_LaxusQ[s__LaxusSpells__LaxusQ_KS_MUI_LaxusQ]
                set s__LaxusSpells__LaxusQ_KS_MUI_LaxusQ=s__LaxusSpells__LaxusQ_KS_MUI_LaxusQ - 1

                if s__LaxusSpells__LaxusQ_KS_MUI_LaxusQ == - 1 then
                    call LaxusSpells__LaxusTimer03Release()
                endif

                call s__LaxusSpells__LaxusQ_KS_deallocate(this)
                set i=i - 1
            endif

            set i=i + 1
        endloop
    endfunction

    function s__LaxusSpells__LaxusQ_KS_LaxusQ_Start takes unit NewC,real NewX,real NewY returns nothing
        local integer this= s__LaxusSpells__LaxusQ_KS__allocate()
        local integer level= GetUnitAbilityLevel(NewC, LaxusQ_ID)
        set s__LaxusSpells__LaxusQ_KS_MUI_LaxusQ=s__LaxusSpells__LaxusQ_KS_MUI_LaxusQ + 1
        set s__LaxusSpells__LaxusQ_KS_m_LaxusQ[s__LaxusSpells__LaxusQ_KS_MUI_LaxusQ]=this
        set s__LaxusSpells__LaxusQ_KS_c[this]=NewC
        set s__LaxusSpells__LaxusQ_KS_u[this]=null
        set s__LaxusSpells__LaxusQ_KS_x[this]=NewX
        set s__LaxusSpells__LaxusQ_KS_y[this]=NewY
        set s__LaxusSpells__LaxusQ_KS_r[this]=0.
        set s__LaxusSpells__LaxusQ_KS_check[this]=0
        set s__LaxusSpells__LaxusQ_KS_fallTime[this]=0.
        set s__LaxusSpells__LaxusQ_KS_startZ[this]=LaxusQ_EffectHeight
        set s__LaxusSpells__LaxusQ_KS_effectZ[this]=s__LaxusSpells__LaxusQ_KS_startZ[this]
        set s__LaxusSpells__LaxusQ_KS_aoe[this]=LaxusQ_DamageAoe
        set s__LaxusSpells__LaxusQ_KS_scale[this]=s__LaxusSpells__LaxusQ_KS_aoe[this] / 575
        set s__LaxusSpells__LaxusQ_KS_g[this]=CreateGroup()
        set s__LaxusSpells__LaxusQ_KS_a[this]=GAngle2(s__LaxusSpells__LaxusQ_KS_c[this] , s__LaxusSpells__LaxusQ_KS_x[this] , s__LaxusSpells__LaxusQ_KS_y[this])
        set s__LaxusSpells__LaxusQ_KS_dmg[this]=GetHeroStr(s__LaxusSpells__LaxusQ_KS_c[this], true) * ( LaxusQ_DamageStrBase + LaxusQ_DamageStrStep * ( level - 1 ) )
        set s__LaxusSpells__LaxusQ_KS_dmg[this]=s__LaxusSpells__LaxusQ_KS_dmg[this] + LaxusQ_Damage2StaticBase + LaxusQ_Damage2StaticStep * ( level - 1 )
        if LoadInteger(hs, GetHandleId(s__LaxusSpells__LaxusQ_KS_c[this]), StringHash("mode g")) == 1 then
                set s__LaxusSpells__LaxusQ_KS_dmg[this]=s__LaxusSpells__LaxusQ_KS_dmg[this] + GetHeroStr(s__LaxusSpells__LaxusQ_KS_c[this], true) * LaxusGQ_DamageStrBonus
                if LoadInteger(hs, GetHandleId(s__LaxusSpells__LaxusQ_KS_c[this]), StringHash("lvl5")) == 1 then
                    set s__LaxusSpells__LaxusQ_KS_check2[this]=1
                    set s__LaxusSpells__LaxusQ_KS_dmg[this]=s__LaxusSpells__LaxusQ_KS_dmg[this] + GetHeroStr(s__LaxusSpells__LaxusQ_KS_c[this], true) * LaxusGQ2_DamageStrBonus
                endif
            endif
        call MakeSound("war3mapimported\\Hero_Laxus_Q")
        // StartSpellUnit2 pauses the hero but does not grant Avul.
        call StartSpellUnit2(s__LaxusSpells__LaxusQ_KS_c[this])
        call SetUnitFacing(s__LaxusSpells__LaxusQ_KS_c[this], GAngle2(s__LaxusSpells__LaxusQ_KS_c[this] , s__LaxusSpells__LaxusQ_KS_x[this] , s__LaxusSpells__LaxusQ_KS_y[this]) * bj_RADTODEG)
        call SetUnitAnimationByIndex(s__LaxusSpells__LaxusQ_KS_c[this], 10)
        set s__LaxusSpells__LaxusQ_KS_r2[this]=10
        set s__LaxusSpells__LaxusQ_KS_e[this]=AddSpecialEffect("war3mapImported\\wos_YellowMissile2.mdl", s__LaxusSpells__LaxusQ_KS_x[this], s__LaxusSpells__LaxusQ_KS_y[this])
        call BlzSetSpecialEffectPosition(s__LaxusSpells__LaxusQ_KS_e[this], s__LaxusSpells__LaxusQ_KS_x[this], s__LaxusSpells__LaxusQ_KS_y[this], s__LaxusSpells__LaxusQ_KS_effectZ[this])
        call ScaleEffDummy(s__LaxusSpells__LaxusQ_KS_e[this] , 0.3 , 0.01 , 1 * s__LaxusSpells__LaxusQ_KS_scale[this])
        set s__LaxusSpells__LaxusQ_KS_e2[this]=EffectSpawn("war3mapImported\\wos_kss (498).mdx" , s__LaxusSpells__LaxusQ_KS_x[this] , s__LaxusSpells__LaxusQ_KS_y[this] , 0 , 1 , 1 , 1)
        call ScaleEffDummy(s__LaxusSpells__LaxusQ_KS_e2[this] , 0.3 , 0.01 , 1.1 * s__LaxusSpells__LaxusQ_KS_scale[this])
        set s__LaxusSpells__LaxusQ_KS_l[this]=AddLightningEx("LX00", false, GetUnitX(s__LaxusSpells__LaxusQ_KS_c[this]) + s__LaxusSpells__LaxusQ_KS_r2[this] * Cos(s__LaxusSpells__LaxusQ_KS_a[this]), GetUnitY(s__LaxusSpells__LaxusQ_KS_c[this]) + s__LaxusSpells__LaxusQ_KS_r2[this] * Sin(s__LaxusSpells__LaxusQ_KS_a[this]), GetUnitFlyHeight(s__LaxusSpells__LaxusQ_KS_c[this]) + LaxusQ_CasterLightningHeight, s__LaxusSpells__LaxusQ_KS_x[this], s__LaxusSpells__LaxusQ_KS_y[this], s__LaxusSpells__LaxusQ_KS_effectZ[this] + 100)
        set s__LaxusSpells__LaxusQ_KS_e3[this]=AddSpecialEffectTarget("war3mapImported\\wos_YellowMissile.mdl", s__LaxusSpells__LaxusQ_KS_c[this], "hand right")
        set s__LaxusSpells__LaxusQ_KS_e4[this]=AddSpecialEffectTarget("war3mapImported\\wos_YellowMissile.mdl", s__LaxusSpells__LaxusQ_KS_c[this], "hand left")
        if s__LaxusSpells__LaxusQ_KS_MUI_LaxusQ == 0 then
            call LaxusSpells__LaxusTimer03Acquire()
        endif
    endfunction

        function s__LaxusSpells__LaxusW_KS_Loop_LaxusW2 takes nothing returns nothing
            local integer this
            local integer k= 0
            local integer i= 0
            loop
