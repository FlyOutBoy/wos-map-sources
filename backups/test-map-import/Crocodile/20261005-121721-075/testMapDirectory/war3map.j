        function s__AstaSpells__AstaSpells_T_Loop_AstaT takes nothing returns nothing
            local integer this
            local integer i= 0
            local real random= 0
            loop
                exitwhen i > s__AstaSpells__AstaSpells_T_MUI_AstaT
                set this=s__AstaSpells__AstaSpells_T_m_AstaT[i]
                if SpellBoolCaster(s__AstaSpells__AstaSpells_T_c[this]) and s__AstaSpells__AstaSpells_T_r[this] <= s__AstaSpells__AstaSpells_T_rmax[this] then
                    if IsUnitPaused(s__AstaSpells__AstaSpells_T_c[this]) == false then
                    set s__AstaSpells__AstaSpells_T_r[this]=s__AstaSpells__AstaSpells_T_r[this] + 0.05
                    set s__AstaSpells__AstaSpells_T_r[this]=S2R(R2SW(s__AstaSpells__AstaSpells_T_r[this], 0, 3))
                    endif
                    call BlzFrameSetValue(s___AstaSpells__AstaSpells_T_frame_pas3[s__AstaSpells__AstaSpells_T_frame_pas3[this]+s__AstaSpells__AstaSpells_T_k2[this]], s__AstaSpells__AstaSpells_T_rmax[this] - ( s__AstaSpells__AstaSpells_T_r[this] + 0.05 ))
                    if s__AstaSpells__AstaSpells_T_rmax[this] - s__AstaSpells__AstaSpells_T_r[this] >= 0 then
                        call BlzFrameSetText(s___AstaSpells__AstaSpells_T_frame_pas6[s__AstaSpells__AstaSpells_T_frame_pas6[this]+s__AstaSpells__AstaSpells_T_k2[this]], "|c00FFFF00" + R2SW(s__AstaSpells__AstaSpells_T_rmax[this] - s__AstaSpells__AstaSpells_T_r[this], 0, 2) + "|r")
                    endif
                    set s__AstaSpells__AstaSpells_T_x1[this]=GetUnitX(s__AstaSpells__AstaSpells_T_c[this])
                    set s__AstaSpells__AstaSpells_T_y1[this]=GetUnitY(s__AstaSpells__AstaSpells_T_c[this])
                   
                else
                  //  call StopSpellUnit(c)
                    if GetLocalPlayer() == GetOwningPlayer(s__AstaSpells__AstaSpells_T_c[this]) then
                        call BlzFrameSetVisible(s___AstaSpells__AstaSpells_T_frame_pas1[s__AstaSpells__AstaSpells_T_frame_pas1[this]+s__AstaSpells__AstaSpells_T_k2[this]], false)
                    endif
                    call UnitRemoveAbility(s__AstaSpells__AstaSpells_T_c[this], AstaSword2_ID)
                    call UnitAddAbility(s__AstaSpells__AstaSpells_T_c[this], AstaSword_ID)
                    if GetUnitCurrentOrder(s__AstaSpells__AstaSpells_T_c[this]) == OrderId(BlzGetAbilityStringLevelField(BlzGetUnitAbility(s__AstaSpells__AstaSpells_T_c[this], AstaT2_ID), ABILITY_SLF_BASE_ORDER_ID_NCL6, GetUnitAbilityLevel(s__AstaSpells__AstaSpells_T_c[this], AstaT2_ID) - 1)) then
                    call IssueImmediateOrder(s__AstaSpells__AstaSpells_T_c[this], "stop")
                    endif
                    if GetUnitCurrentOrder(s__AstaSpells__AstaSpells_T_c[this]) == OrderId(BlzGetAbilityStringLevelField(BlzGetUnitAbility(s__AstaSpells__AstaSpells_T_c[this], AstaR2_ID), ABILITY_SLF_BASE_ORDER_ID_NCL6, GetUnitAbilityLevel(s__AstaSpells__AstaSpells_T_c[this], AstaR2_ID) - 1)) then
                    call IssueImmediateOrder(s__AstaSpells__AstaSpells_T_c[this], "stop")
                    endif
                    call SetPlayerAbilityAvailable(GetOwningPlayer(s__AstaSpells__AstaSpells_T_c[this]), AstaT2_ID, false)
                    call SetPlayerAbilityAvailable(GetOwningPlayer(s__AstaSpells__AstaSpells_T_c[this]), AstaT_ID, true)
                    call SetPlayerAbilityAvailable(GetOwningPlayer(s__AstaSpells__AstaSpells_T_c[this]), AstaR2_ID, false)
                    call SetPlayerAbilityAvailable(GetOwningPlayer(s__AstaSpells__AstaSpells_T_c[this]), AstaR_ID, true)
                    call DestroyEffect(s__AstaSpells__AstaSpells_T_e[this])
                    call DestroyEffect(s__AstaSpells__AstaSpells_T_e2[this])
                    set s__AstaSpells__AstaSpells_T_c[this]=null
                    set s__AstaSpells__AstaSpells_T_e[this]=null
                    set s__AstaSpells__AstaSpells_T_e2[this]=null
                    set s__AstaSpells__AstaSpells_T_m_AstaT[i]=s__AstaSpells__AstaSpells_T_m_AstaT[s__AstaSpells__AstaSpells_T_MUI_AstaT]
                    set s__AstaSpells__AstaSpells_T_MUI_AstaT=s__AstaSpells__AstaSpells_T_MUI_AstaT - 1
                    if s__AstaSpells__AstaSpells_T_MUI_AstaT == - 1 then
                        call PauseTimer(s__AstaSpells__AstaSpells_T_t_AstaT)
                    endif
                    call s__AstaSpells__AstaSpells_T_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction

