                                    call SilenceUnit(s__CrocodileSpells___CrocodileT2KS_c[this] , s__CrocodileSpells___CrocodileT2KS_u[this] , CrocodileT2_SilenceDuration)

                                    set damageCount=damageCount + 1
                                    call SaveInteger(hs, GetHandleId(s__CrocodileSpells___CrocodileT2KS_g2[this]), GetHandleId(s__CrocodileSpells___CrocodileT2KS_u[this]), damageCount)
                                endif
                                call GroupAddUnit(s__CrocodileSpells___CrocodileT2KS_g3[this], s__CrocodileSpells___CrocodileT2KS_u[this])
                            endif
                        endloop

                        loop
                            set s__CrocodileSpells___CrocodileT2KS_u[this]=FirstOfGroup(s__CrocodileSpells___CrocodileT2KS_g3[this])
                            exitwhen s__CrocodileSpells___CrocodileT2KS_u[this] == null
                            call GroupRemoveUnit(s__CrocodileSpells___CrocodileT2KS_g3[this], s__CrocodileSpells___CrocodileT2KS_u[this])
                            call GroupAddUnit(s__CrocodileSpells___CrocodileT2KS_g2[this], s__CrocodileSpells___CrocodileT2KS_u[this])
