                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_DustWindFaster3.mdl" , GetUnitX(s__MilimSpells___MilimQKS_c[this]) , GetUnitY(s__MilimSpells___MilimQKS_c[this]) , s__MilimSpells___MilimQKS_a[this] * bj_RADTODEG , 1.25 , 1 , 1))
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_cf1.mdl" , GetUnitX(s__MilimSpells___MilimQKS_c[this]) , GetUnitY(s__MilimSpells___MilimQKS_c[this]) , s__MilimSpells___MilimQKS_a[this] * bj_RADTODEG , 1.25 , 1 , 1))
                        endif
