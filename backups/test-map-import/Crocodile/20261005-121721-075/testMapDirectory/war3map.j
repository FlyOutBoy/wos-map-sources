    function s__PatriotSpells__PatriotSpells_Q_PatriotQ_Start takes unit NewC,real NewX,real NewY returns nothing
        local integer this= s__PatriotSpells__PatriotSpells_Q__allocate()
        set s__PatriotSpells__PatriotSpells_Q_MUI_PatriotQ=s__PatriotSpells__PatriotSpells_Q_MUI_PatriotQ + 1
        set s__PatriotSpells__PatriotSpells_Q_m_PatriotQ[s__PatriotSpells__PatriotSpells_Q_MUI_PatriotQ]=this
        set s__PatriotSpells__PatriotSpells_Q_c[this]=NewC
        set s__PatriotSpells__PatriotSpells_Q_x[this]=NewX
        set s__PatriotSpells__PatriotSpells_Q_y[this]=NewY
        set s__PatriotSpells__PatriotSpells_Q_td[this]=null
        set s__PatriotSpells__PatriotSpells_Q_r[this]=0
        set s__PatriotSpells__PatriotSpells_Q_r5[this]=0
        set s__PatriotSpells__PatriotSpells_Q_k3[this]=0
        set s__PatriotSpells__PatriotSpells_Q_r6[this]=PatriotQ_RangeBase + ( GetUnitAbilityLevel(s__PatriotSpells__PatriotSpells_Q_c[this], PatriotQ_ID) - 1 )
        set s__PatriotSpells__PatriotSpells_Q_r2[this]=1
        set s__PatriotSpells__PatriotSpells_Q_check3[this]=0
        set s__PatriotSpells__PatriotSpells_Q_r7[this]=0
        set s__PatriotSpells__PatriotSpells_Q_g[this]=CreateGroup()
        set s__PatriotSpells__PatriotSpells_Q_g2[this]=CreateGroup()
        call StartSpellUnit2(s__PatriotSpells__PatriotSpells_Q_c[this])
        set s__PatriotSpells__PatriotSpells_Q_k3[this]=0
        set s__PatriotSpells__PatriotSpells_Q_u[this]=null
        set s__PatriotSpells__PatriotSpells_Q_check4[this]=0
        set s__PatriotSpells__PatriotSpells_Q_a[this]=GAngle2(s__PatriotSpells__PatriotSpells_Q_c[this] , s__PatriotSpells__PatriotSpells_Q_x[this] , s__PatriotSpells__PatriotSpells_Q_y[this]) // Angle Between points
        set s__PatriotSpells__PatriotSpells_Q_rmax[this]=2.1
        set s__PatriotSpells__PatriotSpells_Q_move[this]=100
        set s__PatriotSpells__PatriotSpells_Q_aoe[this]=PatriotQ_DamageAoe
        set s__PatriotSpells__PatriotSpells_Q_dmg[this]=GetHeroAgi(s__PatriotSpells__PatriotSpells_Q_c[this], true) * ( PatriotQ_DamageAgiBase + ( PatriotQ_DamageAgiStep * ( GetUnitAbilityLevel(s__PatriotSpells__PatriotSpells_Q_c[this], PatriotQ_ID) - 1 ) ) )
        set s__PatriotSpells__PatriotSpells_Q_dmg[this]=s__PatriotSpells__PatriotSpells_Q_dmg[this] + PatriotQ_Damage2StaticBase + ( PatriotQ_Damage2StaticStep * ( GetUnitAbilityLevel(s__PatriotSpells__PatriotSpells_Q_c[this], PatriotQ_ID) - 1 ) )
        call SetUnitFacing(s__PatriotSpells__PatriotSpells_Q_c[this], s__PatriotSpells__PatriotSpells_Q_a[this] * bj_RADTODEG)
        call SetUnitAnimationByIndex(s__PatriotSpells__PatriotSpells_Q_c[this], 9)
        if LoadInteger(hs, GetHandleId(s__PatriotSpells__PatriotSpells_Q_c[this]), StringHash("patriot e")) == 1 then
        set s__PatriotSpells__PatriotSpells_Q_check4[this]=1
        set s__PatriotSpells__PatriotSpells_Q_dmg[this]=s__PatriotSpells__PatriotSpells_Q_dmg[this] + GetHeroAgi(s__PatriotSpells__PatriotSpells_Q_c[this], true) * 2
