        function s__AinzSpells__AinzTR_KS_Loop_AinzTR takes nothing returns nothing
            local integer this
            local integer i= 0
            local real dx
            local real dy
            local real forward
            local real side
            local real waveX
            local real waveY
            local real waveSide
            local real wallMove
            local boolean checkUnits
            loop
                exitwhen i > s__AinzSpells__AinzTR_KS_MUI_AinzTR
                set this=s__AinzSpells__AinzTR_KS_m_AinzTR[i]
                set checkUnits=false
                if SpellBoolCaster(s__AinzSpells__AinzTR_KS_c[this]) and ( s__AinzSpells__AinzTR_KS_front[this] < AinzTR_MaxRange or s__AinzSpells__AinzTR_KS_r3[this] < 0.50 ) then
                    set s__AinzSpells__AinzTR_KS_r[this]=RoundReal(s__AinzSpells__AinzTR_KS_r[this] + 0.03 , 3)
                    if s__AinzSpells__AinzTR_KS_r[this] < 0.51 then
                    call DebugUnit2(s__AinzSpells__AinzTR_KS_c[this])
                    endif
                    if s__AinzSpells__AinzTR_KS_r[this] == 0.3 then
            call MakeSound("war3mapimported\\Hero_Ainz_TR3")
                    endif
                    if s__AinzSpells__AinzTR_KS_r[this] == 0.51 then
                    
                    call StopSpellUnit2(s__AinzSpells__AinzTR_KS_c[this])
                    endif
                    if s__AinzSpells__AinzTR_KS_r[this] > 0.51 then
                    if s__AinzSpells__AinzTR_KS_front[this] < AinzTR_MaxRange then
                    set s__AinzSpells__AinzTR_KS_r2[this]=s__AinzSpells__AinzTR_KS_r2[this] + 0.03
                    set s__AinzSpells__AinzTR_KS_lastFront[this]=s__AinzSpells__AinzTR_KS_front[this]
                    set s__AinzSpells__AinzTR_KS_front[this]=s__AinzSpells__AinzTR_KS_front[this] + AinzTR_GrowSpeed
                    if s__AinzSpells__AinzTR_KS_front[this] > AinzTR_MaxRange then
                        set s__AinzSpells__AinzTR_KS_front[this]=AinzTR_MaxRange
                    endif
                    set checkUnits=true

                    call BlzSetSpecialEffectScale(s__AinzSpells__AinzTR_KS_e[this], 0.10 + 1.50 * s__AinzSpells__AinzTR_KS_front[this] / 2350.00)
                    if s__AinzSpells__AinzTR_KS_r2[this] >= AinzTR_EffectPeriod then
                        set s__AinzSpells__AinzTR_KS_r2[this]=0.00
                        set waveX=s__AinzSpells__AinzTR_KS_x[this] + ( s__AinzSpells__AinzTR_KS_front[this] - 200 ) * Cos(s__AinzSpells__AinzTR_KS_a[this])
                        set waveY=s__AinzSpells__AinzTR_KS_y[this] + ( s__AinzSpells__AinzTR_KS_front[this] - 200 ) * Sin(s__AinzSpells__AinzTR_KS_a[this])
                        set waveSide=s__AinzSpells__AinzTR_KS_front[this] * AinzTR_ConeWidth
                        set s__AinzSpells__AinzTR_KS_scale[this]=s__AinzSpells__AinzTR_KS_scale[this] + 0.2
                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_cf2.mdl" , waveX , waveY , s__AinzSpells__AinzTR_KS_a[this] * bj_RADTODEG , 0.30 , 1.5 * s__AinzSpells__AinzTR_KS_scale[this] , 0))
                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_cf2.mdl" , waveX + waveSide * Cos(s__AinzSpells__AinzTR_KS_a[this] + bj_PI * 0.50) , waveY + waveSide * Sin(s__AinzSpells__AinzTR_KS_a[this] + bj_PI * 0.50) , s__AinzSpells__AinzTR_KS_a[this] * bj_RADTODEG , 0.30 , 1.5 * s__AinzSpells__AinzTR_KS_scale[this] , 0))
                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_cf2.mdl" , waveX - waveSide * Cos(s__AinzSpells__AinzTR_KS_a[this] + bj_PI * 0.50) , waveY - waveSide * Sin(s__AinzSpells__AinzTR_KS_a[this] + bj_PI * 0.50) , s__AinzSpells__AinzTR_KS_a[this] * bj_RADTODEG , 0.30 , 1.5 * s__AinzSpells__AinzTR_KS_scale[this] , 0))
                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_gnaden_air.mdx" , waveX , waveY , s__AinzSpells__AinzTR_KS_a[this] * bj_RADTODEG , 0.30 , 3 * s__AinzSpells__AinzTR_KS_scale[this] , 0))
                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_gnaden_air.mdx" , waveX + waveSide * Cos(s__AinzSpells__AinzTR_KS_a[this] + bj_PI * 0.50) , waveY + waveSide * Sin(s__AinzSpells__AinzTR_KS_a[this] + bj_PI * 0.50) , s__AinzSpells__AinzTR_KS_a[this] * bj_RADTODEG , 0.30 , 3 * s__AinzSpells__AinzTR_KS_scale[this] , 0))
                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_gnaden_air.mdx" , waveX - waveSide * Cos(s__AinzSpells__AinzTR_KS_a[this] + bj_PI * 0.50) , waveY - waveSide * Sin(s__AinzSpells__AinzTR_KS_a[this] + bj_PI * 0.50) , s__AinzSpells__AinzTR_KS_a[this] * bj_RADTODEG , 0.30 , 3 * s__AinzSpells__AinzTR_KS_scale[this] , 0))
                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_az_siwen2.mdx" , waveX , waveY , s__AinzSpells__AinzTR_KS_a[this] * bj_RADTODEG , 0.30 , 2.25 * s__AinzSpells__AinzTR_KS_scale[this] , 0))
                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_az_siwen2.mdx" , waveX + waveSide * Cos(s__AinzSpells__AinzTR_KS_a[this] + bj_PI * 0.50) , waveY + waveSide * Sin(s__AinzSpells__AinzTR_KS_a[this] + bj_PI * 0.50) , s__AinzSpells__AinzTR_KS_a[this] * bj_RADTODEG , 0.30 , 2.25 * s__AinzSpells__AinzTR_KS_scale[this] , 0))
                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_az_siwen2.mdx" , waveX - waveSide * Cos(s__AinzSpells__AinzTR_KS_a[this] + bj_PI * 0.50) , waveY - waveSide * Sin(s__AinzSpells__AinzTR_KS_a[this] + bj_PI * 0.50) , s__AinzSpells__AinzTR_KS_a[this] * bj_RADTODEG , 0.30 , 2.25 * s__AinzSpells__AinzTR_KS_scale[this] , 0))
                    endif
                    if s__AinzSpells__AinzTR_KS_front[this] == AinzTR_MaxRange then
                        set s__AinzSpells__AinzTR_KS_r2[this]=0.00
                    endif
                    else
                        set s__AinzSpells__AinzTR_KS_r3[this]=RoundReal(s__AinzSpells__AinzTR_KS_r3[this] + 0.03 , 3)
                        set s__AinzSpells__AinzTR_KS_r2[this]=s__AinzSpells__AinzTR_KS_r2[this] + 0.03
                        if s__AinzSpells__AinzTR_KS_r2[this] >= AinzTR_EffectPeriod then
                            set s__AinzSpells__AinzTR_KS_r2[this]=0.00
                            set s__AinzSpells__AinzTR_KS_lastFront[this]=0.00
                            set checkUnits=true
                        endif
                    endif

                    if checkUnits then
                    call DecorRemove(s__AinzSpells__AinzTR_KS_c[this] , s__AinzSpells__AinzTR_KS_x[this] , s__AinzSpells__AinzTR_KS_y[this] , 800 , 100)
                    call GroupClear(s__AinzSpells__AinzTR_KS_g[this])
                    call GroupEnumUnitsInRange(s__AinzSpells__AinzTR_KS_g[this], s__AinzSpells__AinzTR_KS_x[this], s__AinzSpells__AinzTR_KS_y[this], s__AinzSpells__AinzTR_KS_front[this] + AinzTR_HitWidth, NoDecor_Cond)
                    loop
                        set s__AinzSpells__AinzTR_KS_u[this]=FirstOfGroup(s__AinzSpells__AinzTR_KS_g[this])
                        exitwhen s__AinzSpells__AinzTR_KS_u[this] == null
                        if SpellBool(s__AinzSpells__AinzTR_KS_u[this]) and IsUnitEnemy(s__AinzSpells__AinzTR_KS_u[this], GetOwningPlayer(s__AinzSpells__AinzTR_KS_c[this])) and not IsUnitInGroup(s__AinzSpells__AinzTR_KS_u[this], s__AinzSpells__AinzTR_KS_g2[this]) then
                            set dx=GetUnitX(s__AinzSpells__AinzTR_KS_u[this]) - s__AinzSpells__AinzTR_KS_x[this]
                            set dy=GetUnitY(s__AinzSpells__AinzTR_KS_u[this]) - s__AinzSpells__AinzTR_KS_y[this]
                            set forward=dx * Cos(s__AinzSpells__AinzTR_KS_a[this]) + dy * Sin(s__AinzSpells__AinzTR_KS_a[this])
                            set side=dx * Cos(s__AinzSpells__AinzTR_KS_a[this] + bj_PI * 0.50) + dy * Sin(s__AinzSpells__AinzTR_KS_a[this] + bj_PI * 0.50)
                            if side < 0.00 then
                                set side=- side
                            endif
                            if forward >= s__AinzSpells__AinzTR_KS_lastFront[this] - AinzTR_HitWidth and forward <= s__AinzSpells__AinzTR_KS_front[this] + AinzTR_HitWidth and forward >= 0.00 and side <= forward * AinzTR_ConeWidth + AinzTR_HitWidth then
                                call GroupAddUnit(s__AinzSpells__AinzTR_KS_g2[this], s__AinzSpells__AinzTR_KS_u[this])
                                call dmgmag(s__AinzSpells__AinzTR_KS_c[this] , s__AinzSpells__AinzTR_KS_u[this] , s__AinzSpells__AinzTR_KS_dmg[this])
                                 set wallMove=s__UnitMoveWall_GetMoveDistance(s__AinzSpells__AinzTR_KS_u[this] , GetUnitX(s__AinzSpells__AinzTR_KS_u[this]) , GetUnitY(s__AinzSpells__AinzTR_KS_u[this]) , s__AinzSpells__AinzTR_KS_a[this] , AinzR_PushRange)
                                if wallMove < AinzR_PushRange then
                                    if not IsUnitInGroup(s__AinzSpells__AinzTR_KS_u[this], s__AinzSpells__AinzTR_KS_g3[this]) then
                                        call GroupAddUnit(s__AinzSpells__AinzTR_KS_g3[this], s__AinzSpells__AinzTR_KS_u[this])
                                        call dmgmag(s__AinzSpells__AinzTR_KS_c[this] , s__AinzSpells__AinzTR_KS_u[this] , GetHeroInt(s__AinzSpells__AinzTR_KS_c[this], true) * AinzE_WallHitDamageInt)
                                        call StunUnit(s__AinzSpells__AinzTR_KS_c[this] , s__AinzSpells__AinzTR_KS_u[this] , AinzE_WallHitStun)
                                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_1baozha_90.mdl" , GetUnitX(s__AinzSpells__AinzTR_KS_u[this]) , GetUnitY(s__AinzSpells__AinzTR_KS_u[this]) , GetRandomReal(0, 359) , 1.00 , 1.50 , 0))
                                    endif
                                    if wallMove > 0.00 then
                                        call MUE(s__AinzSpells__AinzTR_KS_u[this] , wallMove , AinzR_PushDuration , s__AinzSpells__AinzTR_KS_a[this])
                                    endif
                                else
                                    call MUE(s__AinzSpells__AinzTR_KS_u[this] , AinzR_PushRange , AinzR_PushDuration , s__AinzSpells__AinzTR_KS_a[this])
                                endif
                            endif
                        endif
                        call GroupRemoveUnit(s__AinzSpells__AinzTR_KS_g[this], s__AinzSpells__AinzTR_KS_u[this])
                    endloop
                    set s__AinzSpells__AinzTR_KS_u[this]=null
                    endif
                    endif
                else
                    call DestroyEffect(s__AinzSpells__AinzTR_KS_e[this])
                    call SetUnitTimeScale(s__AinzSpells__AinzTR_KS_c[this], 1.00)
                    call DestroyGroup(s__AinzSpells__AinzTR_KS_g[this])
                    call DestroyGroup(s__AinzSpells__AinzTR_KS_g2[this])
                    call DestroyGroup(s__AinzSpells__AinzTR_KS_g3[this])
                    if s__AinzSpells__AinzTR_KS_r[this] < 0.51 then
                    call StopSpellUnit2(s__AinzSpells__AinzTR_KS_c[this])
                    endif
                    set s__AinzSpells__AinzTR_KS_c[this]=null
                    set s__AinzSpells__AinzTR_KS_u[this]=null
                    set s__AinzSpells__AinzTR_KS_e[this]=null
                    set s__AinzSpells__AinzTR_KS_g[this]=null
                    set s__AinzSpells__AinzTR_KS_g2[this]=null
                    set s__AinzSpells__AinzTR_KS_g3[this]=null
                    set s__AinzSpells__AinzTR_KS_m_AinzTR[i]=s__AinzSpells__AinzTR_KS_m_AinzTR[s__AinzSpells__AinzTR_KS_MUI_AinzTR]
                    set s__AinzSpells__AinzTR_KS_MUI_AinzTR=s__AinzSpells__AinzTR_KS_MUI_AinzTR - 1
                    if s__AinzSpells__AinzTR_KS_MUI_AinzTR == - 1 then
                        call AinzSpells__AinzTimer03Release()
