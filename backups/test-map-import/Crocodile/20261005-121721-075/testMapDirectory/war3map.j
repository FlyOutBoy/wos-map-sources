        function s__TojiSpells__TojiSpells_Q_TojiQ_Start takes unit NewC,unit NewTarget,integer NewMode returns nothing
            local integer this
            local integer abilityId
            local integer level

            if NewC == null or NewTarget == null or GetUnitTypeId(NewC) == 0 or GetUnitTypeId(NewTarget) == 0 or GetWidgetLife(NewTarget) <= 0.405 or not IsUnitEnemy(NewTarget, GetOwningPlayer(NewC)) then
                return
            endif

            if NewMode < 1 or NewMode > 3 then
                set NewMode=1
            endif
            if NewMode == 1 then
                set abilityId=TojiQ_ID
            elseif NewMode == 2 then
                set abilityId=TojiQ2_ID
            else
                set abilityId=TojiQ3_ID
            endif

            set this=s__TojiSpells__TojiSpells_Q__allocate()
            set s__TojiSpells__TojiSpells_Q_MUI_TojiQ=s__TojiSpells__TojiSpells_Q_MUI_TojiQ + 1
            set s__TojiSpells__TojiSpells_Q_m_TojiQ[s__TojiSpells__TojiSpells_Q_MUI_TojiQ]=this
            set s__TojiSpells__TojiSpells_Q_c[this]=NewC
            set s__TojiSpells__TojiSpells_Q_td[this]=NewTarget
            set s__TojiSpells__TojiSpells_Q_g[this]=CreateGroup()
            set s__TojiSpells__TojiSpells_Q_mode[this]=NewMode
            set s__TojiSpells__TojiSpells_Q_state[this]=0
            set s__TojiSpells__TojiSpells_Q_hits[this]=0
            set s__TojiSpells__TojiSpells_Q_r[this]=0.0
            set s__TojiSpells__TojiSpells_Q_damageClock[this]=0.0
            set s__TojiSpells__TojiSpells_Q_effectClock[this]=0.0
            set s__TojiSpells__TojiSpells_Q_chaseClock[this]=0.0
            set level=GetUnitAbilityLevel(NewC, abilityId)
            if level < 1 then
                set level=1
            endif
            set s__TojiSpells__TojiSpells_Q_bonusDmg[this]=TojiSpells__TojiE_ConsumeLeapBonus(NewC)
            if TojiQ_IsInvul then
                call StartSpellUnit(s__TojiSpells__TojiSpells_Q_c[this])
            else
                call StartSpellUnit2(s__TojiSpells__TojiSpells_Q_c[this])
            endif

            if NewMode == 1 then
                set s__TojiSpells__TojiSpells_Q_move[this]=TojiQ_Move
                set s__TojiSpells__TojiSpells_Q_dmg[this]=GetHeroAgi(NewC, true) * ( TojiQ_DamageAgiBase + TojiQ_DamageAgiStep * ( level - 1 ) )
                set s__TojiSpells__TojiSpells_Q_dmg[this]=s__TojiSpells__TojiSpells_Q_dmg[this] + TojiQ_Damage2StaticBase + TojiQ_Damage2StaticStep * ( level - 1 )
                set s__TojiSpells__TojiSpells_Q_dmg[this]=s__TojiSpells__TojiSpells_Q_dmg[this] / 2.0
                set s__TojiSpells__TojiSpells_Q_a[this]=GAngle2(NewC , GetUnitX(NewTarget) , GetUnitY(NewTarget))
                call SetUnitFacing(NewC, s__TojiSpells__TojiSpells_Q_a[this] * bj_RADTODEG)
                set s__TojiSpells__TojiSpells_Q_e[this]=AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdx", s__TojiSpells__TojiSpells_Q_c[this], "hand right")
                call SetUnitAnimationByIndex(NewC, 1)
                call SetUnitTimeScale(NewC, 1)
                call MakeSound("war3mapimported\\Hero_Toji_Q1 1")
            elseif NewMode == 2 then
                set s__TojiSpells__TojiSpells_Q_move[this]=TojiQ2_Move
                set s__TojiSpells__TojiSpells_Q_dmg[this]=GetHeroAgi(NewC, true) * ( TojiQ2_DamageAgiBase + TojiQ2_DamageAgiStep * ( level - 1 ) )
                set s__TojiSpells__TojiSpells_Q_dmg[this]=s__TojiSpells__TojiSpells_Q_dmg[this] + TojiQ2_Damage2StaticBase + TojiQ2_Damage2StaticStep * ( level - 1 )
                set s__TojiSpells__TojiSpells_Q_dmg[this]=s__TojiSpells__TojiSpells_Q_dmg[this] / I2R(TojiQ2_DamageCount)
                set s__TojiSpells__TojiSpells_Q_e[this]=EffectSpawn3("war3mapImported\\wos_SlashAoeOrangeLoop.mdl" , GetUnitX(s__TojiSpells__TojiSpells_Q_c[this]) , GetUnitY(s__TojiSpells__TojiSpells_Q_c[this]) , s__TojiSpells__TojiSpells_Q_a[this] * bj_RADTODEG + 45 , 1 , 0.895 , 100 , - 35)
                set s__TojiSpells__TojiSpells_Q_e2[this]=EffectSpawn3("war3mapImported\\wos_SlashAoeOrangeLoop.mdl" , GetUnitX(s__TojiSpells__TojiSpells_Q_c[this]) , GetUnitY(s__TojiSpells__TojiSpells_Q_c[this]) , s__TojiSpells__TojiSpells_Q_a[this] * bj_RADTODEG + 45 , 1 , 0.895 , 100 , - 35)
                set s__TojiSpells__TojiSpells_Q_e3[this]=AddSpecialEffectTarget("war3mapimported\\wos_SlidingDustWithRocks.mdx", s__TojiSpells__TojiSpells_Q_c[this], "origin")
                call BlzSetSpecialEffectAlpha(s__TojiSpells__TojiSpells_Q_e[this], 125)
                call BlzSetSpecialEffectAlpha(s__TojiSpells__TojiSpells_Q_e2[this], 125)
                set s__TojiSpells__TojiSpells_Q_a[this]=GAngle2(NewC , GetUnitX(NewTarget) , GetUnitY(NewTarget))
                call SetUnitFacing(NewC, s__TojiSpells__TojiSpells_Q_a[this] * bj_RADTODEG)
                call SetUnitAnimationByIndex(NewC, 6)
                call SetUnitTimeScale(NewC, 1.55)
                call MakeSound("war3mapimported\\Hero_Toji_Q2 1")
                call MakeSound("war3mapimported\\Hero_Toji_Q2 3")
            else
                set s__TojiSpells__TojiSpells_Q_move[this]=0.0
                set s__TojiSpells__TojiSpells_Q_dmg[this]=GetHeroAgi(NewC, true) * ( TojiQ3_DamageAgiBase + TojiQ3_DamageAgiStep * ( level - 1 ) )
                set s__TojiSpells__TojiSpells_Q_dmg[this]=s__TojiSpells__TojiSpells_Q_dmg[this] + TojiQ3_DamageStaticBase + TojiQ3_DamageStaticStep * ( level - 1 )
                set s__TojiSpells__TojiSpells_Q_e[this]=AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdx", s__TojiSpells__TojiSpells_Q_c[this], "hand right")
                set s__TojiSpells__TojiSpells_Q_e2[this]=AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdx", s__TojiSpells__TojiSpells_Q_c[this], "hand left")
                set s__TojiSpells__TojiSpells_Q_e3[this]=AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdx", s__TojiSpells__TojiSpells_Q_c[this], "chest")
                set s__TojiSpells__TojiSpells_Q_a[this]=GAngle2(NewC , GetUnitX(NewTarget) , GetUnitY(NewTarget))
                call SetUnitFacing(NewC, s__TojiSpells__TojiSpells_Q_a[this] * bj_RADTODEG)
                call SetUnitAnimationByIndex(NewC, 9)
                call SetUnitTimeScale(NewC, 0.10)
                call MakeSound("war3mapimported\\Hero_Toji_Q3 1")
            endif

            if s__TojiSpells__TojiSpells_Q_MUI_TojiQ == 0 then
                call TojiSpells__TojiTimer03Acquire()
            endif
        endfunction



        function s__TojiSpells__TojiSpells_W_Loop_TojiW takes nothing returns nothing
            local integer i= 0
            local integer this
            local unit picked
            local real step
            local real dx
            local real dy
            local real distance
            local real angle
            local boolean remove
            loop
                exitwhen i > s__TojiSpells__TojiSpells_W_MUI_TojiW
                set this=s__TojiSpells__TojiSpells_W_m_TojiW[i]
                set remove=false

                if s__TojiSpells__TojiSpells_W_c[this] == null or GetUnitTypeId(s__TojiSpells__TojiSpells_W_c[this]) == 0 or GetWidgetLife(s__TojiSpells__TojiSpells_W_c[this]) <= 0.405 then
                    set remove=true

                elseif s__TojiSpells__TojiSpells_W_state[this] == 0 then
                    if s__TojiSpells__TojiSpells_W_r6[this] < s__TojiSpells__TojiSpells_W_r7[this] then
                        set step=s__TojiSpells__TojiSpells_W_move[this]
                        if s__TojiSpells__TojiSpells_W_r6[this] + step > s__TojiSpells__TojiSpells_W_r7[this] then
                            set step=s__TojiSpells__TojiSpells_W_r7[this] - s__TojiSpells__TojiSpells_W_r6[this]
                        endif
                        set s__TojiSpells__TojiSpells_W_x[this]=s__TojiSpells__TojiSpells_W_x[this] + step * Cos(s__TojiSpells__TojiSpells_W_a[this])
                        set s__TojiSpells__TojiSpells_W_y[this]=s__TojiSpells__TojiSpells_W_y[this] + step * Sin(s__TojiSpells__TojiSpells_W_a[this])
                        set s__TojiSpells__TojiSpells_W_r6[this]=s__TojiSpells__TojiSpells_W_r6[this] + step
                        call BlzSetSpecialEffectPosition(s__TojiSpells__TojiSpells_W_e[this], s__TojiSpells__TojiSpells_W_x[this], s__TojiSpells__TojiSpells_W_y[this], TojiW_ProjectileHeight)
                        call MoveLightningEx(s__TojiSpells__TojiSpells_W_chain[this], true, GetUnitX(s__TojiSpells__TojiSpells_W_c[this]), GetUnitY(s__TojiSpells__TojiSpells_W_c[this]), TojiW_ProjectileHeight, s__TojiSpells__TojiSpells_W_x[this], s__TojiSpells__TojiSpells_W_y[this], TojiW_ProjectileHeight)
                        if s__TojiSpells__TojiSpells_W_r2[this] > 0.0 then
                            set s__TojiSpells__TojiSpells_W_r2[this]=0.0
                            call DecorRemove(s__TojiSpells__TojiSpells_W_c[this] , s__TojiSpells__TojiSpells_W_x[this] , s__TojiSpells__TojiSpells_W_y[this] , TojiW_DamageAoe , TojiW_DecorDamage)
                            call VisionTimed(GetOwningPlayer(s__TojiSpells__TojiSpells_W_c[this]) , s__TojiSpells__TojiSpells_W_x[this] , s__TojiSpells__TojiSpells_W_y[this] , 450 , 1.5)
                        else
                            set s__TojiSpells__TojiSpells_W_r2[this]=s__TojiSpells__TojiSpells_W_r2[this] + 0.03
                        endif
                        call GroupClear(s__TojiSpells__TojiSpells_W_g[this])
                        call GroupEnumUnitsInRange(s__TojiSpells__TojiSpells_W_g[this], s__TojiSpells__TojiSpells_W_x[this], s__TojiSpells__TojiSpells_W_y[this], TojiW_DamageAoe, Condition(function NoDecor_Filter))
                        loop
                            set picked=FirstOfGroup(s__TojiSpells__TojiSpells_W_g[this])
                            exitwhen picked == null or s__TojiSpells__TojiSpells_W_td[this] != null
                            call GroupRemoveUnit(s__TojiSpells__TojiSpells_W_g[this], picked)
                            if IsUnitEnemy(picked, GetOwningPlayer(s__TojiSpells__TojiSpells_W_c[this])) and SpellBool(picked) then
                                set s__TojiSpells__TojiSpells_W_td[this]=picked
                            endif
                        endloop
                        call GroupClear(s__TojiSpells__TojiSpells_W_g[this])

                        if s__TojiSpells__TojiSpells_W_td[this] != null then
                            set s__TojiSpells__TojiSpells_W_state[this]=1
                            set s__TojiSpells__TojiSpells_W_r[this]=0.0
                            call MakeSound("war3mapimported\\Hero_Toji_W 2")
                            call BuffUnit01(s__TojiSpells__TojiSpells_W_c[this] , s__TojiSpells__TojiSpells_W_td[this] , TojiW_AbiDebuff_ID , "curse" , GetUnitAbilityLevel(s__TojiSpells__TojiSpells_W_c[this], TojiW_ID))
                            call dmgphys(s__TojiSpells__TojiSpells_W_c[this] , s__TojiSpells__TojiSpells_W_td[this] , TojiSpells__TojiAbilityDamage(s__TojiSpells__TojiSpells_W_c[this] , s__TojiSpells__TojiSpells_W_td[this] , s__TojiSpells__TojiSpells_W_dmg[this]))
                            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", s__TojiSpells__TojiSpells_W_td[this], "chest"))
                            call MakeSound("war3mapImported\\Hero_Toji_TW2")
                            call DestroyEffect(s__TojiSpells__TojiSpells_W_e[this])
                            set s__TojiSpells__TojiSpells_W_e[this]=null
                            set s__TojiSpells__TojiSpells_W_e2[this]=AddSpecialEffectTarget(TojiW_TargetEffect, s__TojiSpells__TojiSpells_W_td[this], "chest")
                            call MoveLightningEx(s__TojiSpells__TojiSpells_W_chain[this], true, GetUnitX(s__TojiSpells__TojiSpells_W_c[this]), GetUnitY(s__TojiSpells__TojiSpells_W_c[this]), TojiW_ProjectileHeight, GetUnitX(s__TojiSpells__TojiSpells_W_td[this]), GetUnitY(s__TojiSpells__TojiSpells_W_td[this]), TojiW_ProjectileHeight)
                            if GetUnitAbilityLevel(s__TojiSpells__TojiSpells_W_c[this], TojiW2_ID) == 0 then
                                call UnitAddAbility(s__TojiSpells__TojiSpells_W_c[this], TojiW2_ID)
                                call UnitMakeAbilityPermanent(s__TojiSpells__TojiSpells_W_c[this], true, TojiW2_ID)
                            endif
                            call SetUnitAbilityLevel(s__TojiSpells__TojiSpells_W_c[this], TojiW2_ID, s__TojiSpells__TojiSpells_W_level[this])
                            call SetPlayerAbilityAvailable(GetOwningPlayer(s__TojiSpells__TojiSpells_W_c[this]), TojiW_ID, false)
                            call SetPlayerAbilityAvailable(GetOwningPlayer(s__TojiSpells__TojiSpells_W_c[this]), TojiW2_ID, true)
                            call BlzEndUnitAbilityCooldown(s__TojiSpells__TojiSpells_W_c[this], TojiW2_ID)
                        elseif s__TojiSpells__TojiSpells_W_r6[this] >= s__TojiSpells__TojiSpells_W_r7[this] then
                            set s__TojiSpells__TojiSpells_W_state[this]=2
                        endif
                    else
                        set s__TojiSpells__TojiSpells_W_state[this]=2
                    endif

                elseif s__TojiSpells__TojiSpells_W_state[this] == 1 then
                    if s__TojiSpells__TojiSpells_W_td[this] == null or GetUnitTypeId(s__TojiSpells__TojiSpells_W_td[this]) == 0 or GetWidgetLife(s__TojiSpells__TojiSpells_W_td[this]) <= 0.405 or GetUnitAbilityLevel(s__TojiSpells__TojiSpells_W_td[this], TojiW_Debuff_ID) == 0 then
                        set remove=true
                    else
                        set s__TojiSpells__TojiSpells_W_r[this]=RoundReal(s__TojiSpells__TojiSpells_W_r[this] + 0.03 , 3)
                        set dx=GetUnitX(s__TojiSpells__TojiSpells_W_td[this]) - GetUnitX(s__TojiSpells__TojiSpells_W_c[this])
                        set dy=GetUnitY(s__TojiSpells__TojiSpells_W_td[this]) - GetUnitY(s__TojiSpells__TojiSpells_W_c[this])
                        set distance=SquareRoot(dx * dx + dy * dy)
                        if distance > TojiW_ChainMaxRange then
                            set angle=Atan2(dy, dx)
                            call PosUnit(s__TojiSpells__TojiSpells_W_td[this] , GetUnitX(s__TojiSpells__TojiSpells_W_c[this]) + TojiW_ChainMaxRange * Cos(angle) , GetUnitY(s__TojiSpells__TojiSpells_W_c[this]) + TojiW_ChainMaxRange * Sin(angle))
                        endif
                        call MoveLightningEx(s__TojiSpells__TojiSpells_W_chain[this], true, GetUnitX(s__TojiSpells__TojiSpells_W_c[this]), GetUnitY(s__TojiSpells__TojiSpells_W_c[this]), TojiW_ProjectileHeight, GetUnitX(s__TojiSpells__TojiSpells_W_td[this]), GetUnitY(s__TojiSpells__TojiSpells_W_td[this]), TojiW_ProjectileHeight)
                        if s__TojiSpells__TojiSpells_W_r[this] >= TojiW_ChainDuration then
                            set remove=true
                        endif
                    endif

                elseif s__TojiSpells__TojiSpells_W_state[this] == 2 then
                    set dx=GetUnitX(s__TojiSpells__TojiSpells_W_c[this]) - s__TojiSpells__TojiSpells_W_x[this]
                    set dy=GetUnitY(s__TojiSpells__TojiSpells_W_c[this]) - s__TojiSpells__TojiSpells_W_y[this]
                    set distance=SquareRoot(dx * dx + dy * dy)
                    set step=s__TojiSpells__TojiSpells_W_move[this] + TojiW_ReturnMoveBonus
                    if distance <= step then
                        set remove=true
                    else
                        set angle=Atan2(dy, dx)
                        set s__TojiSpells__TojiSpells_W_x[this]=s__TojiSpells__TojiSpells_W_x[this] + step * Cos(angle)
                        set s__TojiSpells__TojiSpells_W_y[this]=s__TojiSpells__TojiSpells_W_y[this] + step * Sin(angle)
                        call BlzSetSpecialEffectPosition(s__TojiSpells__TojiSpells_W_e[this], s__TojiSpells__TojiSpells_W_x[this], s__TojiSpells__TojiSpells_W_y[this], TojiW_ProjectileHeight)
                        call MoveLightningEx(s__TojiSpells__TojiSpells_W_chain[this], true, GetUnitX(s__TojiSpells__TojiSpells_W_c[this]), GetUnitY(s__TojiSpells__TojiSpells_W_c[this]), TojiW_ProjectileHeight, s__TojiSpells__TojiSpells_W_x[this], s__TojiSpells__TojiSpells_W_y[this], TojiW_ProjectileHeight)
                    endif

                elseif s__TojiSpells__TojiSpells_W_state[this] == 3 then
                    if s__TojiSpells__TojiSpells_W_td[this] == null or GetUnitTypeId(s__TojiSpells__TojiSpells_W_td[this]) == 0 or GetWidgetLife(s__TojiSpells__TojiSpells_W_td[this]) <= 0.405 or GetUnitAbilityLevel(s__TojiSpells__TojiSpells_W_td[this], TojiW_Debuff_ID) == 0 then
                        set remove=true
                    else
                        set s__TojiSpells__TojiSpells_W_r[this]=RoundReal(s__TojiSpells__TojiSpells_W_r[this] + 0.03 , 3)
                        set s__TojiSpells__TojiSpells_W_pullElapsed[this]=RoundReal(s__TojiSpells__TojiSpells_W_pullElapsed[this] + 0.03 , 3)
                        set step=s__TojiSpells__TojiSpells_W_pullMove[this]
                        if step > s__TojiSpells__TojiSpells_W_pullRemaining[this] then
                            set step=s__TojiSpells__TojiSpells_W_pullRemaining[this]
                        endif
                        if step > 0.0 then
                            call MoveUnit(s__TojiSpells__TojiSpells_W_td[this] , step , s__TojiSpells__TojiSpells_W_pullAngle[this])
                            set s__TojiSpells__TojiSpells_W_pullRemaining[this]=s__TojiSpells__TojiSpells_W_pullRemaining[this] - step
                        endif
                        if s__TojiSpells__TojiSpells_W_pullElapsed[this] >= TojiW2_PullDuration or s__TojiSpells__TojiSpells_W_pullRemaining[this] <= 0.5 then
                            set s__TojiSpells__TojiSpells_W_state[this]=1
                        endif
                        set dx=GetUnitX(s__TojiSpells__TojiSpells_W_td[this]) - GetUnitX(s__TojiSpells__TojiSpells_W_c[this])
                        set dy=GetUnitY(s__TojiSpells__TojiSpells_W_td[this]) - GetUnitY(s__TojiSpells__TojiSpells_W_c[this])
                        set distance=SquareRoot(dx * dx + dy * dy)
                        if distance > TojiW_ChainMaxRange then
                            set angle=Atan2(dy, dx)
                            if s__TojiSpells__TojiSpells_W_r2[this] > 0.0 then
                                set s__TojiSpells__TojiSpells_W_r2[this]=0.0
                                call DecorRemove(s__TojiSpells__TojiSpells_W_c[this] , GetUnitX(s__TojiSpells__TojiSpells_W_td[this]) , GetUnitY(s__TojiSpells__TojiSpells_W_td[this]) , TojiW_DamageAoe , TojiW_DecorDamage)
                                call VisionTimed(GetOwningPlayer(s__TojiSpells__TojiSpells_W_c[this]) , GetUnitX(s__TojiSpells__TojiSpells_W_td[this]) , GetUnitY(s__TojiSpells__TojiSpells_W_td[this]) , 450 , 1.5)
                            else
                                set s__TojiSpells__TojiSpells_W_r2[this]=s__TojiSpells__TojiSpells_W_r2[this] + 0.03
                            endif
                            call PosUnit(s__TojiSpells__TojiSpells_W_td[this] , GetUnitX(s__TojiSpells__TojiSpells_W_c[this]) + TojiW_ChainMaxRange * Cos(angle) , GetUnitY(s__TojiSpells__TojiSpells_W_c[this]) + TojiW_ChainMaxRange * Sin(angle))
                        endif
                        call MoveLightningEx(s__TojiSpells__TojiSpells_W_chain[this], true, GetUnitX(s__TojiSpells__TojiSpells_W_c[this]), GetUnitY(s__TojiSpells__TojiSpells_W_c[this]), TojiW_ProjectileHeight, GetUnitX(s__TojiSpells__TojiSpells_W_td[this]), GetUnitY(s__TojiSpells__TojiSpells_W_td[this]), TojiW_ProjectileHeight)
                        if s__TojiSpells__TojiSpells_W_r[this] >= TojiW_ChainDuration then
                            set remove=true
                        endif
                    endif
                endif

                if remove then
                    if s__TojiSpells__TojiSpells_W_c[this] != null then
                        call SetPlayerAbilityAvailable(GetOwningPlayer(s__TojiSpells__TojiSpells_W_c[this]), TojiW2_ID, false)
                        call SetPlayerAbilityAvailable(GetOwningPlayer(s__TojiSpells__TojiSpells_W_c[this]), TojiW_ID, true)
                    endif
                    if s__TojiSpells__TojiSpells_W_e[this] != null then
                        call DestroyEffect(s__TojiSpells__TojiSpells_W_e[this])
                    endif
                    if s__TojiSpells__TojiSpells_W_e2[this] != null then
                        call DestroyEffect(s__TojiSpells__TojiSpells_W_e2[this])
                    endif
                    if s__TojiSpells__TojiSpells_W_chain[this] != null then
                        call DestroyLightning(s__TojiSpells__TojiSpells_W_chain[this])
                    endif
                    if s__TojiSpells__TojiSpells_W_g[this] != null then
                        call DestroyGroup(s__TojiSpells__TojiSpells_W_g[this])
                    endif
                    set s__TojiSpells__TojiSpells_W_e[this]=null
                    set s__TojiSpells__TojiSpells_W_e2[this]=null
                    set s__TojiSpells__TojiSpells_W_chain[this]=null
                    set s__TojiSpells__TojiSpells_W_g[this]=null
                    set s__TojiSpells__TojiSpells_W_td[this]=null
                    set s__TojiSpells__TojiSpells_W_c[this]=null
                    call s__TojiSpells__TojiSpells_W_deallocate(this)
                    set s__TojiSpells__TojiSpells_W_m_TojiW[i]=s__TojiSpells__TojiSpells_W_m_TojiW[s__TojiSpells__TojiSpells_W_MUI_TojiW]
                    set s__TojiSpells__TojiSpells_W_MUI_TojiW=s__TojiSpells__TojiSpells_W_MUI_TojiW - 1
                    if s__TojiSpells__TojiSpells_W_MUI_TojiW == - 1 then
                        call TojiSpells__TojiTimer03Release()
                    endif
                else
                    set i=i + 1
                endif
            endloop
            set picked=null
        endfunction

        function s__TojiSpells__TojiSpells_W_TojiW_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__TojiSpells__TojiSpells_W__allocate()
            set s__TojiSpells__TojiSpells_W_MUI_TojiW=s__TojiSpells__TojiSpells_W_MUI_TojiW + 1
            set s__TojiSpells__TojiSpells_W_m_TojiW[s__TojiSpells__TojiSpells_W_MUI_TojiW]=this
            set s__TojiSpells__TojiSpells_W_c[this]=NewC
            set s__TojiSpells__TojiSpells_W_td[this]=null
            set s__TojiSpells__TojiSpells_W_g[this]=CreateGroup()
            set s__TojiSpells__TojiSpells_W_state[this]=0
            set s__TojiSpells__TojiSpells_W_level[this]=GetUnitAbilityLevel(NewC, TojiW_ID)
            if s__TojiSpells__TojiSpells_W_level[this] < 1 then
                set s__TojiSpells__TojiSpells_W_level[this]=1
            endif
            set s__TojiSpells__TojiSpells_W_a[this]=GAngle2(NewC , NewX , NewY)
            set s__TojiSpells__TojiSpells_W_x[this]=GetUnitX(NewC) + 75.0 * Cos(s__TojiSpells__TojiSpells_W_a[this])
            set s__TojiSpells__TojiSpells_W_y[this]=GetUnitY(NewC) + 75.0 * Sin(s__TojiSpells__TojiSpells_W_a[this])
            set s__TojiSpells__TojiSpells_W_r[this]=0.0
            set s__TojiSpells__TojiSpells_W_r6[this]=0.0
            set s__TojiSpells__TojiSpells_W_r7[this]=TojiW_RangeBase + TojiW_RangeStep * ( s__TojiSpells__TojiSpells_W_level[this] - 1 )
            set s__TojiSpells__TojiSpells_W_move[this]=TojiW_MoveBase + TojiW_MoveStep * ( s__TojiSpells__TojiSpells_W_level[this] - 1 )
            set s__TojiSpells__TojiSpells_W_dmg[this]=GetHeroAgi(NewC, true) * ( TojiW_DamageAgiBase + TojiW_DamageAgiStep * ( s__TojiSpells__TojiSpells_W_level[this] - 1 ) )
            set s__TojiSpells__TojiSpells_W_dmg[this]=s__TojiSpells__TojiSpells_W_dmg[this] + TojiW_Damage2StaticBase + TojiW_Damage2StaticStep * ( s__TojiSpells__TojiSpells_W_level[this] - 1 )
            set s__TojiSpells__TojiSpells_W_dmg[this]=s__TojiSpells__TojiSpells_W_dmg[this] + TojiSpells__TojiE_ConsumeLeapBonus(NewC)
            call MakeSound("war3mapimported\\Hero_Toji_W 1")
            set s__TojiSpells__TojiSpells_W_tdMoveSpeed[this]=0.0
            set s__TojiSpells__TojiSpells_W_tdSlowSpeed[this]=0.0
            set s__TojiSpells__TojiSpells_W_e2[this]=null
            set s__TojiSpells__TojiSpells_W_pullAngle[this]=0.0
            set s__TojiSpells__TojiSpells_W_pullMove[this]=0.0
            set s__TojiSpells__TojiSpells_W_pullRemaining[this]=0.0
            set s__TojiSpells__TojiSpells_W_pullElapsed[this]=0.0
            set s__TojiSpells__TojiSpells_W_e[this]=AddSpecialEffect(TojiW_ProjectileEffect, s__TojiSpells__TojiSpells_W_x[this], s__TojiSpells__TojiSpells_W_y[this])
            call BlzSetSpecialEffectScale(s__TojiSpells__TojiSpells_W_e[this], TojiW_ProjectileScale)
            call BlzSetSpecialEffectYaw(s__TojiSpells__TojiSpells_W_e[this], s__TojiSpells__TojiSpells_W_a[this])
            call BlzSetSpecialEffectZ(s__TojiSpells__TojiSpells_W_e[this], TojiW_ProjectileHeight)
            set s__TojiSpells__TojiSpells_W_chain[this]=AddLightningEx(TojiW_LightningCode, true, GetUnitX(NewC), GetUnitY(NewC), TojiW_ProjectileHeight, s__TojiSpells__TojiSpells_W_x[this], s__TojiSpells__TojiSpells_W_y[this], TojiW_ProjectileHeight)
            call SetUnitFacing(NewC, s__TojiSpells__TojiSpells_W_a[this] * bj_RADTODEG)
            call SetUnitAnimationByIndex(NewC, 13)
            call MakeSound("war3mapImported\\Hero_Toji_W")
            call VisionTimed(GetOwningPlayer(NewC) , NewX , NewY , 750 , 6)
            if s__TojiSpells__TojiSpells_W_MUI_TojiW == 0 then
                call TojiSpells__TojiTimer03Acquire()
            endif
        endfunction

        function s__TojiSpells__TojiSpells_W_TojiW2_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer i= 0
            local integer this
            local real casterX
            local real casterY
            local real targetX
            local real targetY
            local real baseAngle
            local real difference
            local real distance
            local real inward
            local real sideAngle
            local real pullDistance
            loop
                exitwhen i > s__TojiSpells__TojiSpells_W_MUI_TojiW
                set this=s__TojiSpells__TojiSpells_W_m_TojiW[i]
                if s__TojiSpells__TojiSpells_W_c[this] == NewC and s__TojiSpells__TojiSpells_W_state[this] == 1 then
                    set casterX=GetUnitX(NewC)
                    set casterY=GetUnitY(NewC)
                    set targetX=GetUnitX(s__TojiSpells__TojiSpells_W_td[this])
                    set targetY=GetUnitY(s__TojiSpells__TojiSpells_W_td[this])
                    set baseAngle=Atan2(targetY - casterY, targetX - casterX)
                    set difference=( NewX - targetX ) * Cos(baseAngle + bj_PI * 0.5) + ( NewY - targetY ) * Sin(baseAngle + bj_PI * 0.5)
                    set distance=SquareRoot(( targetX - casterX ) * ( targetX - casterX ) + ( targetY - casterY ) * ( targetY - casterY ))
                    if difference <= TojiW2_SideClickDeadzone and difference >= - TojiW2_SideClickDeadzone then
                        set inward=TojiW2_CenterPullRange
                        if inward > distance - 125.0 then
                            set inward=distance - 125.0
                        endif
                        if inward < 0.0 then
                            set inward=0.0
                        endif
                        set s__TojiSpells__TojiSpells_W_pullX[this]=targetX + inward * Cos(baseAngle + bj_PI)
                        set s__TojiSpells__TojiSpells_W_pullY[this]=targetY + inward * Sin(baseAngle + bj_PI)
                    else
                        set inward=TojiW2_SideInwardRange
                        if inward > distance - 125.0 then
                            set inward=distance - 125.0
                        endif
                        if inward < 0.0 then
                            set inward=0.0
                        endif
                        if difference > 0.0 then
                            set sideAngle=baseAngle + bj_PI * 0.5
                        else
                            set sideAngle=baseAngle - bj_PI * 0.5
                        endif
                        set s__TojiSpells__TojiSpells_W_pullX[this]=targetX + TojiW2_SidePullRange * Cos(sideAngle) + inward * Cos(baseAngle + bj_PI)
                        set s__TojiSpells__TojiSpells_W_pullY[this]=targetY + TojiW2_SidePullRange * Sin(sideAngle) + inward * Sin(baseAngle + bj_PI)
                    endif
                    set pullDistance=SquareRoot(( s__TojiSpells__TojiSpells_W_pullX[this] - targetX ) * ( s__TojiSpells__TojiSpells_W_pullX[this] - targetX ) + ( s__TojiSpells__TojiSpells_W_pullY[this] - targetY ) * ( s__TojiSpells__TojiSpells_W_pullY[this] - targetY ))
                    set s__TojiSpells__TojiSpells_W_pullAngle[this]=Atan2(s__TojiSpells__TojiSpells_W_pullY[this] - targetY, s__TojiSpells__TojiSpells_W_pullX[this] - targetX)
                    set s__TojiSpells__TojiSpells_W_pullRemaining[this]=pullDistance
                    set s__TojiSpells__TojiSpells_W_pullElapsed[this]=0.0
                    if TojiW2_PullDuration > 0.03 then
                        set s__TojiSpells__TojiSpells_W_pullMove[this]=pullDistance / ( TojiW2_PullDuration / 0.03 )
                    else
                        set s__TojiSpells__TojiSpells_W_pullMove[this]=pullDistance
                    endif
                    if s__TojiSpells__TojiSpells_W_pullMove[this] < 0.0 then
                        set s__TojiSpells__TojiSpells_W_pullMove[this]=0.0
                    endif
                    set s__TojiSpells__TojiSpells_W_state[this]=3
                    call MakeSound("war3mapImported\\Hero_Toji_W2 1")
                    set i=s__TojiSpells__TojiSpells_W_MUI_TojiW + 1
                else
                    set i=i + 1
                endif
            endloop
        endfunction



        function s__TojiSpells__TojiSpells_E_Loop_TojiE takes nothing returns nothing
            local integer i= 0
            local integer this
            local unit target
            local real step
            local boolean remove
            loop
                exitwhen i > s__TojiSpells__TojiSpells_E_MUI_TojiE
                set this=s__TojiSpells__TojiSpells_E_m_TojiE[i]
                set remove=false

                if s__TojiSpells__TojiSpells_E_c[this] == null or GetUnitTypeId(s__TojiSpells__TojiSpells_E_c[this]) == 0 or GetWidgetLife(s__TojiSpells__TojiSpells_E_c[this]) <= 0.405 then
                    set remove=true
                elseif s__TojiSpells__TojiSpells_E_traveled[this] < s__TojiSpells__TojiSpells_E_distance[this] then
                    set step=s__TojiSpells__TojiSpells_E_move[this]
                    if s__TojiSpells__TojiSpells_E_r2[this] > 0.0 then
                        set s__TojiSpells__TojiSpells_E_r2[this]=0.0
                        call DecorRemove(s__TojiSpells__TojiSpells_E_c[this] , GetUnitX(s__TojiSpells__TojiSpells_E_c[this]) , GetUnitY(s__TojiSpells__TojiSpells_E_c[this]) , TojiE_HitAoe , TojiE_DecorDamage)
                    else
                        set s__TojiSpells__TojiSpells_E_r2[this]=s__TojiSpells__TojiSpells_E_r2[this] + 0.03
                    endif
                    call MoveUnit(s__TojiSpells__TojiSpells_E_c[this] , step , s__TojiSpells__TojiSpells_E_a[this])
                    call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_blackblink.mdx" , GetUnitX(s__TojiSpells__TojiSpells_E_c[this]) , GetUnitY(s__TojiSpells__TojiSpells_E_c[this]) , s__TojiSpells__TojiSpells_E_a[this] * bj_RADTODEG + 90 , 3 , 1.35 , GetUnitFlyHeight(s__TojiSpells__TojiSpells_E_c[this]) , 0 , 0 , 0 , 255))
                    set s__TojiSpells__TojiSpells_E_traveled[this]=s__TojiSpells__TojiSpells_E_traveled[this] + step
                    call BlzSetSpecialEffectPosition(s__TojiSpells__TojiSpells_E_e[this], GetUnitX(s__TojiSpells__TojiSpells_E_c[this]), GetUnitY(s__TojiSpells__TojiSpells_E_c[this]), 50.0)

                    if s__TojiSpells__TojiSpells_E_level25[this] then
                        call GroupClear(s__TojiSpells__TojiSpells_E_scanGroup[this])
                        call GroupEnumUnitsInRange(s__TojiSpells__TojiSpells_E_scanGroup[this], GetUnitX(s__TojiSpells__TojiSpells_E_c[this]), GetUnitY(s__TojiSpells__TojiSpells_E_c[this]), TojiE_HitAoe, Condition(function NoDecor_Filter))
                        loop
                            set target=FirstOfGroup(s__TojiSpells__TojiSpells_E_scanGroup[this])
                            exitwhen target == null
                            call GroupRemoveUnit(s__TojiSpells__TojiSpells_E_scanGroup[this], target)
                            if IsUnitEnemy(target, GetOwningPlayer(s__TojiSpells__TojiSpells_E_c[this])) and SpellBool(target) and not IsUnitInGroup(target, s__TojiSpells__TojiSpells_E_hitGroup[this]) then
                                call GroupAddUnit(s__TojiSpells__TojiSpells_E_hitGroup[this], target)
                                call dmgphys(s__TojiSpells__TojiSpells_E_c[this] , target , TojiSpells__TojiAbilityDamage(s__TojiSpells__TojiSpells_E_c[this] , target , s__TojiSpells__TojiSpells_E_attackDamage[this]))
                                call MUE(target , TojiE_Level25ThrowRange , TojiE_Level25ThrowDuration , s__TojiSpells__TojiSpells_E_a[this])
                                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", target, "chest"))
                            endif
                        endloop
                    endif
                    if s__TojiSpells__TojiSpells_E_traveled[this] >= s__TojiSpells__TojiSpells_E_distance[this] then
                        set remove=true
                    endif
                else
                    set remove=true
                endif

                if remove then
                    if s__TojiSpells__TojiSpells_E_c[this] != null then
                        call SetUnitTimeScale(s__TojiSpells__TojiSpells_E_c[this], 1.0)
                    endif
                    if s__TojiSpells__TojiSpells_E_e[this] != null then
                        call DestroyEffect(s__TojiSpells__TojiSpells_E_e[this])
                    endif
                    call DestroyGroup(s__TojiSpells__TojiSpells_E_scanGroup[this])
                    call DestroyGroup(s__TojiSpells__TojiSpells_E_hitGroup[this])
                    set s__TojiSpells__TojiSpells_E_e[this]=null
                    set s__TojiSpells__TojiSpells_E_scanGroup[this]=null
                    set s__TojiSpells__TojiSpells_E_hitGroup[this]=null
                    set s__TojiSpells__TojiSpells_E_c[this]=null
                    set target=null
                    call s__TojiSpells__TojiSpells_E_deallocate(this)
                    set s__TojiSpells__TojiSpells_E_m_TojiE[i]=s__TojiSpells__TojiSpells_E_m_TojiE[s__TojiSpells__TojiSpells_E_MUI_TojiE]
                    set s__TojiSpells__TojiSpells_E_MUI_TojiE=s__TojiSpells__TojiSpells_E_MUI_TojiE - 1
                    if s__TojiSpells__TojiSpells_E_MUI_TojiE == - 1 then
                        call TojiSpells__TojiTimer03Release()
                    endif
                else
                    set i=i + 1
                endif
            endloop
            set target=null
        endfunction

        function s__TojiSpells__TojiSpells_E_InitCharges takes unit whichUnit returns nothing
            local integer abilityLevel= GetUnitAbilityLevel(whichUnit, TojiE_ID)
            local real recharge
            if abilityLevel < 1 then
                set abilityLevel=1
            elseif abilityLevel > 5 then
                set abilityLevel=5
            endif
            set recharge=TojiE_RechargeBase - TojiE_RechargeStep * ( abilityLevel - 1 )
            call s__KS_SpellStacks_MyAddSpellStacks_Start((whichUnit ) , ( TojiE_ID ) , ( 0 ) , ( TojiE_MaxCharges ) , (( recharge)*1.0)) // INLINED!!
        endfunction

        function s__TojiSpells__TojiSpells_E_TojiE_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer abilityLevel= GetUnitAbilityLevel(NewC, TojiE_ID)
            local integer diceCount
            local integer diceSides
            local integer dice= 0
            local real startX= GetUnitX(NewC)
            local real startY= GetUnitY(NewC)
            local real dx= NewX - startX
            local real dy= NewY - startY
            local real targetDistance= SquareRoot(dx * dx + dy * dy)
            local real maxDistance
            local integer this
            
            if abilityLevel < 1 then
                set abilityLevel=1
            endif
            set maxDistance=TojiE_RangeBase + TojiE_RangeStep * ( abilityLevel - 1 )
            set targetDistance=maxDistance
            call s__TojiSpells__TojiSpells_E_InitCharges(NewC)
            if (LoadInteger(hs, GetHandleId(((NewC))), StringHash("stack_count"))) <= 0 and BlzGetUnitAbilityCooldownRemaining(NewC, TojiE_ID) <= 0.00 then // INLINED!!
                call s__KS_SpellStacks_AddStacks((NewC ) , ( 1)) // INLINED!!
            endif
            if not SpellStacksTryUse(NewC) then
                return
            endif

            if targetDistance <= 1.0 then
                if GetHeroLevel(NewC) >= 25 then
                    call TojiSpells__TojiE_AddLeapBuff(NewC)
                endif
                return
            endif

            set this=s__TojiSpells__TojiSpells_E__allocate()
            set s__TojiSpells__TojiSpells_E_MUI_TojiE=s__TojiSpells__TojiSpells_E_MUI_TojiE + 1
            set s__TojiSpells__TojiSpells_E_m_TojiE[s__TojiSpells__TojiSpells_E_MUI_TojiE]=this
            set s__TojiSpells__TojiSpells_E_c[this]=NewC
            set s__TojiSpells__TojiSpells_E_scanGroup[this]=CreateGroup()
            set s__TojiSpells__TojiSpells_E_hitGroup[this]=CreateGroup()
            set s__TojiSpells__TojiSpells_E_a[this]=Atan2(dy, dx)
            set s__TojiSpells__TojiSpells_E_traveled[this]=0.0
            call ColorDummy32(s__TojiSpells__TojiSpells_E_c[this] , 0 , 255 , 255 , 255 , 0.15)
            call ColorDummy4(s__TojiSpells__TojiSpells_E_c[this] , 0.3 , 255 , 255 , 255 , 0.15)
            set s__TojiSpells__TojiSpells_E_distance[this]=targetDistance
            if TojiE_DashDuration > 0.03 then
                set s__TojiSpells__TojiSpells_E_move[this]=targetDistance / ( TojiE_DashDuration / 0.03 )
            else
                set s__TojiSpells__TojiSpells_E_move[this]=targetDistance
            endif
            if s__TojiSpells__TojiSpells_E_move[this] < 1.0 then
                set s__TojiSpells__TojiSpells_E_move[this]=1.0
            endif
            set s__TojiSpells__TojiSpells_E_level25[this]=GetHeroLevel(NewC) >= 25
            set s__TojiSpells__TojiSpells_E_attackDamage[this]=0.0
            if s__TojiSpells__TojiSpells_E_level25[this] then
                set diceCount=BlzGetUnitDiceNumber(NewC, 0)
                set diceSides=BlzGetUnitDiceSides(NewC, 0)
                set s__TojiSpells__TojiSpells_E_attackDamage[this]=I2R(BlzGetUnitBaseDamage(NewC, 0)) + GetHeroAgi(NewC, true)
                loop
                    exitwhen dice >= diceCount
                    set s__TojiSpells__TojiSpells_E_attackDamage[this]=s__TojiSpells__TojiSpells_E_attackDamage[this] + GetRandomInt(1, diceSides)
                    set dice=dice + 1
                endloop
                call TojiSpells__TojiE_AddLeapBuff(NewC)
            endif
            
            call BlzSetUnitFacingEx(s__TojiSpells__TojiSpells_E_c[this], s__TojiSpells__TojiSpells_E_a[this] * bj_RADTODEG)
            call SetUnitAnimationByIndex(NewC, 4)
            call s__GearSystems2___KS_RemoveUnit_MyRemoveUnit_Start((s__TojiSpells__TojiSpells_E_c[this] ) , (( 0.03 )*1.0) , 2 , - 1 , ( 4) , "") // INLINED!!
            call SetUnitTimeScale(NewC, 2.0)
            set s__TojiSpells__TojiSpells_E_e[this]=AddSpecialEffectTarget(TojiE_DashEffect, s__TojiSpells__TojiSpells_E_c[this], "origin")
            if IntegerCd(s__TojiSpells__TojiSpells_E_c[this] , "sound e cd" , 10) then
                if GetRandomInt(1, 2) == 1 then
                    call MakeSound("war3mapimported\\Hero_Toji_E3")
                else
                    call MakeSound("war3mapimported\\Hero_Toji_E4")
                endif
            endif
            if GetRandomInt(1, 2) == 1 then
                call MakeSound("war3mapimported\\Hero_Toji_E")
            else
                call MakeSound("war3mapimported\\Hero_Toji_E2")
            endif
            if s__TojiSpells__TojiSpells_E_MUI_TojiE == 0 then
                call TojiSpells__TojiTimer03Acquire()
            endif
        endfunction



        function s__TojiSpells__TojiSpells_R_Insectoids_Loop_TojiRI takes nothing returns nothing
            local integer i= 0
            local integer n
            local integer hid
            local integer invisLevel
            local integer this
            local unit target
            local effect mosquito
            local group swapGroup
            local real progress
            local real targetX
            local real targetY
            local real targetZ
            local real moveX
            local real moveY
            local real moveZ
            local real moveAngle
            local real moveDistance
            local real moveStart
            local real boundaryDistance
            local real dx
            local real dy
            local real damage
            local boolean inside
            local boolean hit
            local boolean remove
            loop
                exitwhen i > s__TojiSpells__TojiSpells_R_Insectoids_MUI_TojiRI
                set this=s__TojiSpells__TojiSpells_R_Insectoids_m_TojiRI[i]
                set remove=false

                if s__TojiSpells__TojiSpells_R_Insectoids_c[this] == null or GetUnitTypeId(s__TojiSpells__TojiSpells_R_Insectoids_c[this]) == 0 then
                    set remove=true
                else
                    set s__TojiSpells__TojiSpells_R_Insectoids_elapsed[this]=RoundReal(s__TojiSpells__TojiSpells_R_Insectoids_elapsed[this] + 0.03 , 3)

                    if s__TojiSpells__TojiSpells_R_Insectoids_elapsed[this] <= TojiR_MosquitoTravelDuration then
                        set progress=s__TojiSpells__TojiSpells_R_Insectoids_elapsed[this] / TojiR_MosquitoTravelDuration
                        if progress > 1.0 then
                            set progress=1.0
                        endif
                        set n=0
                        loop
                            exitwhen n >= TojiR_MosquitoCount
                            set mosquito=LoadEffectHandle(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], n)
                            set targetX=LoadReal(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 1000 + n)
                            set targetY=LoadReal(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 2000 + n)
                            set targetZ=LoadReal(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 3000 + n)
                            if mosquito != null then
                                call BlzSetSpecialEffectPosition(mosquito, s__TojiSpells__TojiSpells_R_Insectoids_startX[this] + ( targetX - s__TojiSpells__TojiSpells_R_Insectoids_startX[this] ) * progress, s__TojiSpells__TojiSpells_R_Insectoids_startY[this] + ( targetY - s__TojiSpells__TojiSpells_R_Insectoids_startY[this] ) * progress, 70.0 + ( targetZ - 70.0 ) * progress)
                            endif
                            set n=n + 1
                        endloop
                    else
                        set n=0
                        loop
                            exitwhen n >= TojiR_MosquitoCount
                            set mosquito=LoadEffectHandle(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], n)
                            if mosquito != null then
                                if LoadInteger(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 12000 + n) == 0 and s__TojiSpells__TojiSpells_R_Insectoids_elapsed[this] >= LoadReal(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 4000 + n) then
                                    set targetX=LoadReal(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 1000 + n)
                                    set targetY=LoadReal(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 2000 + n)
                                    set targetZ=LoadReal(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 3000 + n)
                                    set moveAngle=GetRandomReal(0.0, 2.0 * bj_PI)
                                    set moveDistance=GetRandomReal(TojiR_MosquitoMoveDistanceMin, TojiR_MosquitoMoveDistanceMax)
                                    set moveX=targetX + moveDistance * Cos(moveAngle)
                                    set moveY=targetY + moveDistance * Sin(moveAngle)

                                    set dx=moveX - s__TojiSpells__TojiSpells_R_Insectoids_centerX[this]
                                    set dy=moveY - s__TojiSpells__TojiSpells_R_Insectoids_centerY[this]
                                    set boundaryDistance=SquareRoot(dx * dx + dy * dy)
                                    if boundaryDistance > TojiR_Aoe + 135.0 then
                                        set moveAngle=Atan2(s__TojiSpells__TojiSpells_R_Insectoids_centerY[this] - targetY, s__TojiSpells__TojiSpells_R_Insectoids_centerX[this] - targetX) + GetRandomReal(- 0.75, 0.75)
                                        set moveX=targetX + moveDistance * Cos(moveAngle)
                                        set moveY=targetY + moveDistance * Sin(moveAngle)
                                        set dx=moveX - s__TojiSpells__TojiSpells_R_Insectoids_centerX[this]
                                        set dy=moveY - s__TojiSpells__TojiSpells_R_Insectoids_centerY[this]
                                        set boundaryDistance=SquareRoot(dx * dx + dy * dy)
                                        if boundaryDistance > TojiR_Aoe + 135.0 then
                                            set moveX=s__TojiSpells__TojiSpells_R_Insectoids_centerX[this] + dx * ( ( TojiR_Aoe + 135.0 ) / boundaryDistance )
                                            set moveY=s__TojiSpells__TojiSpells_R_Insectoids_centerY[this] + dy * ( ( TojiR_Aoe + 135.0 ) / boundaryDistance )
                                        endif
                                    endif

                                    set moveZ=GetRandomReal(TojiR_MosquitoMinHeight, TojiR_MosquitoMaxHeight)

                                    call SaveReal(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 5000 + n, targetX)
                                    call SaveReal(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 6000 + n, targetY)
                                    call SaveReal(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 7000 + n, targetZ)
                                    call SaveReal(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 8000 + n, moveX)
                                    call SaveReal(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 9000 + n, moveY)
                                    call SaveReal(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 10000 + n, moveZ)
                                    call SaveReal(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 11000 + n, s__TojiSpells__TojiSpells_R_Insectoids_elapsed[this])
                                    call SaveReal(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 4000 + n, s__TojiSpells__TojiSpells_R_Insectoids_elapsed[this] + GetRandomReal(TojiR_MosquitoMoveIntervalMin, TojiR_MosquitoMoveIntervalMax))
                                    call SaveInteger(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 12000 + n, 1)
                                    call BlzSetSpecialEffectYaw(mosquito, Atan2(moveY - targetY, moveX - targetX))
                                endif

                                if LoadInteger(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 12000 + n) == 1 then
                                    set targetX=LoadReal(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 5000 + n)
                                    set targetY=LoadReal(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 6000 + n)
                                    set targetZ=LoadReal(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 7000 + n)
                                    set moveX=LoadReal(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 8000 + n)
                                    set moveY=LoadReal(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 9000 + n)
                                    set moveZ=LoadReal(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 10000 + n)
                                    set moveStart=LoadReal(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 11000 + n)
                                    set progress=( s__TojiSpells__TojiSpells_R_Insectoids_elapsed[this] - moveStart ) / TojiR_MosquitoMoveDuration
                                    if progress >= 1.0 then
                                        set progress=1.0
                                        call SaveReal(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 1000 + n, moveX)
                                        call SaveReal(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 2000 + n, moveY)
                                        call SaveReal(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 3000 + n, moveZ)
                                        call SaveInteger(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 12000 + n, 0)
                                    endif
                                    call BlzSetSpecialEffectPosition(mosquito, targetX + ( moveX - targetX ) * progress, targetY + ( moveY - targetY ) * progress, targetZ + ( moveZ - targetZ ) * progress)
                                endif
                            endif
                            set n=n + 1
                        endloop

                        set s__TojiSpells__TojiSpells_R_Insectoids_scanClock[this]=RoundReal(s__TojiSpells__TojiSpells_R_Insectoids_scanClock[this] + 0.03 , 3)
                        set s__TojiSpells__TojiSpells_R_Insectoids_damageClock[this]=RoundReal(s__TojiSpells__TojiSpells_R_Insectoids_damageClock[this] + 0.03 , 3)
                        set inside=false
                        if GetWidgetLife(s__TojiSpells__TojiSpells_R_Insectoids_c[this]) > 0.405 then
                            set dx=GetUnitX(s__TojiSpells__TojiSpells_R_Insectoids_c[this]) - s__TojiSpells__TojiSpells_R_Insectoids_centerX[this]
                            set dy=GetUnitY(s__TojiSpells__TojiSpells_R_Insectoids_c[this]) - s__TojiSpells__TojiSpells_R_Insectoids_centerY[this]
                            set inside=dx * dx + dy * dy <= TojiR_Aoe * TojiR_Aoe
                        endif

                        if inside then
                            set s__TojiSpells__TojiSpells_R_Insectoids_casterInside[this]=true
                            call UnitRemoveAbility(s__TojiSpells__TojiSpells_R_Insectoids_c[this], TojiR_SlowBuff_ID)
                            call UnitRemoveAbility(s__TojiSpells__TojiSpells_R_Insectoids_c[this], 'B01B')
                            call UnitRemoveAbility(s__TojiSpells__TojiSpells_R_Insectoids_c[this], 'B01A')
                            call UnitRemoveAbility(s__TojiSpells__TojiSpells_R_Insectoids_c[this], 'B01C')
                            call UnitRemoveAbility(s__TojiSpells__TojiSpells_R_Insectoids_c[this], 'B019')
                            call UnitRemoveAbility(s__TojiSpells__TojiSpells_R_Insectoids_c[this], 'B00T')
                            if not s__TojiSpells__TojiSpells_R_Insectoids_invisPrepared[this] then
                                set invisLevel=GetUnitAbilityLevel(s__TojiSpells__TojiSpells_R_Insectoids_c[this], TojiR_InvisAbility2_ID)
                                if invisLevel == 0 then
                                    call UnitAddAbility(s__TojiSpells__TojiSpells_R_Insectoids_c[this], TojiR_InvisAbility2_ID)
                                    call UnitMakeAbilityPermanent(s__TojiSpells__TojiSpells_R_Insectoids_c[this], true, TojiR_InvisAbility2_ID)
                                    call SetPlayerAbilityAvailable(GetOwningPlayer(s__TojiSpells__TojiSpells_R_Insectoids_c[this]), TojiR_InvisAbility2_ID, true)
                                    set s__TojiSpells__TojiSpells_R_Insectoids_invisAdded[this]=true
                                endif
                                set s__TojiSpells__TojiSpells_R_Insectoids_invisPrepared[this]=true
                            endif
                            
                            if GetUnitAbilityLevel(s__TojiSpells__TojiSpells_R_Insectoids_c[this], TojiR_InvisBuff_ID) == 0 then
                                call SetPlayerAbilityAvailable(GetOwningPlayer(s__TojiSpells__TojiSpells_R_Insectoids_c[this]), TojiR_InvisAbility2_ID, true)
                                call IssueImmediateOrder(s__TojiSpells__TojiSpells_R_Insectoids_c[this], "windwalk")
                            else
                                call SetPlayerAbilityAvailable(GetOwningPlayer(s__TojiSpells__TojiSpells_R_Insectoids_c[this]), TojiR_InvisAbility2_ID, false)
                            endif
                        elseif s__TojiSpells__TojiSpells_R_Insectoids_casterInside[this] then
                            set s__TojiSpells__TojiSpells_R_Insectoids_casterInside[this]=false
                            call UnitRemoveAbility(s__TojiSpells__TojiSpells_R_Insectoids_c[this], TojiR_InvisBuff_ID)
                            if s__TojiSpells__TojiSpells_R_Insectoids_invisAdded[this] then
                                call UnitRemoveAbility(s__TojiSpells__TojiSpells_R_Insectoids_c[this], TojiR_InvisAbility2_ID)
                                set s__TojiSpells__TojiSpells_R_Insectoids_invisAdded[this]=false
                            else
                                call SetPlayerAbilityAvailable(GetOwningPlayer(s__TojiSpells__TojiSpells_R_Insectoids_c[this]), TojiR_InvisAbility2_ID, true)
                            endif
                            set s__TojiSpells__TojiSpells_R_Insectoids_invisPrepared[this]=false
                        endif

                        if s__TojiSpells__TojiSpells_R_Insectoids_scanClock[this] >= 0.12 then
                            set s__TojiSpells__TojiSpells_R_Insectoids_scanClock[this]=RoundReal(s__TojiSpells__TojiSpells_R_Insectoids_scanClock[this] - 0.12 , 3)
                            call GroupClear(s__TojiSpells__TojiSpells_R_Insectoids_scanGroup[this])
                            call GroupEnumUnitsInRange(s__TojiSpells__TojiSpells_R_Insectoids_scanGroup[this], s__TojiSpells__TojiSpells_R_Insectoids_centerX[this], s__TojiSpells__TojiSpells_R_Insectoids_centerY[this], TojiR_Aoe, Condition(function NoDecor_Filter))
                            call GroupClear(s__TojiSpells__TojiSpells_R_Insectoids_keepGroup[this])

                            loop
                                set target=FirstOfGroup(s__TojiSpells__TojiSpells_R_Insectoids_affectedGroup[this])
                                exitwhen target == null
                                call GroupRemoveUnit(s__TojiSpells__TojiSpells_R_Insectoids_affectedGroup[this], target)
                                if IsUnitInGroup(target, s__TojiSpells__TojiSpells_R_Insectoids_scanGroup[this]) and IsUnitEnemy(target, GetOwningPlayer(s__TojiSpells__TojiSpells_R_Insectoids_c[this])) and SpellBool(target) then
                                    call GroupAddUnit(s__TojiSpells__TojiSpells_R_Insectoids_keepGroup[this], target)
                                endif
                            endloop

                            loop
                                set target=FirstOfGroup(s__TojiSpells__TojiSpells_R_Insectoids_scanGroup[this])
                                exitwhen target == null
                                call GroupRemoveUnit(s__TojiSpells__TojiSpells_R_Insectoids_scanGroup[this], target)
                                if IsUnitEnemy(target, GetOwningPlayer(s__TojiSpells__TojiSpells_R_Insectoids_c[this])) and SpellBool(target) then
                                    set hid=GetHandleId(target)
                                    if not IsUnitInGroup(target, s__TojiSpells__TojiSpells_R_Insectoids_keepGroup[this]) then
                                        call GroupAddUnit(s__TojiSpells__TojiSpells_R_Insectoids_keepGroup[this], target)
                                    endif
                                    call SlowUnit(s__TojiSpells__TojiSpells_R_Insectoids_c[this] , target , TojiR_SlowPercent , 4)
                                endif
                            endloop
                            set swapGroup=s__TojiSpells__TojiSpells_R_Insectoids_affectedGroup[this]
                            set s__TojiSpells__TojiSpells_R_Insectoids_affectedGroup[this]=s__TojiSpells__TojiSpells_R_Insectoids_keepGroup[this]
                            set s__TojiSpells__TojiSpells_R_Insectoids_keepGroup[this]=swapGroup
                            set swapGroup=null
                        endif

                        if s__TojiSpells__TojiSpells_R_Insectoids_damageClock[this] >= TojiR_DamageInterval then
                            set s__TojiSpells__TojiSpells_R_Insectoids_damageClock[this]=RoundReal(s__TojiSpells__TojiSpells_R_Insectoids_damageClock[this] - TojiR_DamageInterval , 3)
                            set damage=s__TojiSpells__TojiSpells_R_Insectoids_damagePerSecond[this] * TojiR_DamageInterval + s__TojiSpells__TojiSpells_R_Insectoids_leapBonus[this]
                            set hit=false
                            call GroupClear(s__TojiSpells__TojiSpells_R_Insectoids_damageGroup[this])
                            call GroupEnumUnitsInRange(s__TojiSpells__TojiSpells_R_Insectoids_damageGroup[this], s__TojiSpells__TojiSpells_R_Insectoids_centerX[this], s__TojiSpells__TojiSpells_R_Insectoids_centerY[this], TojiR_Aoe, Condition(function NoDecor_Filter))
                            loop
                                set target=FirstOfGroup(s__TojiSpells__TojiSpells_R_Insectoids_damageGroup[this])
                                exitwhen target == null
                                call GroupRemoveUnit(s__TojiSpells__TojiSpells_R_Insectoids_damageGroup[this], target)
                                if IsUnitEnemy(target, GetOwningPlayer(s__TojiSpells__TojiSpells_R_Insectoids_c[this])) and SpellBool(target) then
                                    call dmgphys(s__TojiSpells__TojiSpells_R_Insectoids_c[this] , target , TojiSpells__TojiAbilityDamage(s__TojiSpells__TojiSpells_R_Insectoids_c[this] , target , damage))
                                    set hit=true
                                endif
                            endloop
                            if hit then
                                set s__TojiSpells__TojiSpells_R_Insectoids_leapBonus[this]=0.0
                            endif
                        endif

                        if s__TojiSpells__TojiSpells_R_Insectoids_elapsed[this] >= TojiR_MosquitoTravelDuration + s__TojiSpells__TojiSpells_R_Insectoids_r5[this] then
                            set remove=true
                        endif
                    endif
                endif

                if remove then
                    if s__TojiSpells__TojiSpells_R_Insectoids_c[this] != null and GetUnitTypeId(s__TojiSpells__TojiSpells_R_Insectoids_c[this]) != 0 and s__TojiSpells__TojiSpells_R_Insectoids_invisPrepared[this] then
                        call UnitRemoveAbility(s__TojiSpells__TojiSpells_R_Insectoids_c[this], TojiR_InvisBuff_ID)
                        if s__TojiSpells__TojiSpells_R_Insectoids_invisAdded[this] then
                            call UnitRemoveAbility(s__TojiSpells__TojiSpells_R_Insectoids_c[this], TojiR_InvisAbility2_ID)
                        else
                            call SetPlayerAbilityAvailable(GetOwningPlayer(s__TojiSpells__TojiSpells_R_Insectoids_c[this]), TojiR_InvisAbility2_ID, true)
                        endif
                    endif

                    set n=0
                    loop
                        exitwhen n >= TojiR_MosquitoCount
                        set mosquito=LoadEffectHandle(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], n)
                        if mosquito != null then
                            call ColorEffDummy3(mosquito , 0 , 255 , 255 , 255 , 0.3)
                        endif
                        set n=n + 1
                    endloop
                    call FlushChildHashtable(TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this])
                    call DestroyGroup(s__TojiSpells__TojiSpells_R_Insectoids_scanGroup[this])
                    call DestroyGroup(s__TojiSpells__TojiSpells_R_Insectoids_damageGroup[this])
                    call DestroyGroup(s__TojiSpells__TojiSpells_R_Insectoids_affectedGroup[this])
                    call DestroyGroup(s__TojiSpells__TojiSpells_R_Insectoids_keepGroup[this])
                    set s__TojiSpells__TojiSpells_R_Insectoids_scanGroup[this]=null
                    set s__TojiSpells__TojiSpells_R_Insectoids_damageGroup[this]=null
                    set s__TojiSpells__TojiSpells_R_Insectoids_affectedGroup[this]=null
                    set s__TojiSpells__TojiSpells_R_Insectoids_keepGroup[this]=null
                    set s__TojiSpells__TojiSpells_R_Insectoids_c[this]=null
                    set target=null
                    set mosquito=null
                    call s__TojiSpells__TojiSpells_R_Insectoids_deallocate(this)
                    set s__TojiSpells__TojiSpells_R_Insectoids_m_TojiRI[i]=s__TojiSpells__TojiSpells_R_Insectoids_m_TojiRI[s__TojiSpells__TojiSpells_R_Insectoids_MUI_TojiRI]
                    set s__TojiSpells__TojiSpells_R_Insectoids_MUI_TojiRI=s__TojiSpells__TojiSpells_R_Insectoids_MUI_TojiRI - 1
                    if s__TojiSpells__TojiSpells_R_Insectoids_MUI_TojiRI == - 1 then
                        call TojiSpells__TojiTimer03Release()
                    endif
                else
                    set i=i + 1
                endif
            endloop
            set target=null
            set mosquito=null
            set swapGroup=null
        endfunction

        function s__TojiSpells__TojiSpells_R_Insectoids_TojiR_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__TojiSpells__TojiSpells_R_Insectoids__allocate()
            local integer n= 0
            local integer level
            local real angle
            local real radius
            local real targetX
            local real targetY
            local real targetZ
            local effect mosquito
            local integer red
            local integer green
            local integer blue
