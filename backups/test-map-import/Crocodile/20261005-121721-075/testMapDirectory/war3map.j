            endif
            set s__FrierenSpells__FrierenSpells_Q2_a[this]=GAngle(s__FrierenSpells__FrierenSpells_Q2_c[this] , FirstOfGroup(s__FrierenSpells__FrierenSpells_Q2_g3[this]))
            call SetUnitFacing(s__FrierenSpells__FrierenSpells_Q2_c[this], s__FrierenSpells__FrierenSpells_Q2_a[this] * bj_RADTODEG)
            call SetUnitTimeScale(s__FrierenSpells__FrierenSpells_Q2_c[this], 0.65)
            call SetUnitAnimationByIndex(s__FrierenSpells__FrierenSpells_Q2_c[this], 2)
            if FrierenSpells__FrierenCloneCheck(s__FrierenSpells__FrierenSpells_Q2_c[this]) then
                call MakeSound("war3mapimported\\Hero_Frieren_Q2 2")
                call MakeSound("war3mapimported\\Hero_Frieren_Q2 3")
            endif
            set s__FrierenSpells__FrierenSpells_Q2_rmax[this]=3
            if s__FrierenSpells__FrierenSpells_Q2_MUI_FrierenQ2 == 0 then
                call FrierenSpells__FrierenTimer03Acquire()
            endif
        endfunction
        function s__FrierenSpells__FrierenSpells_TQ_Loop_FrierenTQ takes nothing returns nothing
