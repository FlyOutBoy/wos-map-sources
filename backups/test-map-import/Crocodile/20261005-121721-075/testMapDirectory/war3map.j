    function InoriEPas_Start takes unit c returns nothing
        local group g= CreateGroup()
        local unit u
        local real x= GetUnitX(c)
        local integer check= 0
        local real y= GetUnitY(c)
        local real aoe= InoriE_AoeSearch
        call GroupClear(g)
        call GroupEnumUnitsInRange(g, x, y, aoe, null)
        loop
            set u=FirstOfGroup(g)
            exitwhen u == null
            if GetUnitTypeId(u) == Inori_ID and IsUnitAlly(u, GetOwningPlayer(c)) and IsUnitIllusion(u) == false and GetHeroLevel(u) >= 6 then
                set check=LoadInteger(hs, GetHandleId(u), StringHash("Inori E"))
                if check < 4 and LoadInteger(hs, GetHandleId(u), StringHash("pas cd")) == 0 then
                    call SaveInteger(hs, GetHandleId(u), StringHash("Inori E"), check + 1)
                    call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\wos_A_194-9F68D.mdl", u, "origin"))
                endif
            endif
            call GroupRemoveUnit(g, u)
        endloop
        call DestroyGroup(g)
        set g=null
        set u=null
    endfunction
