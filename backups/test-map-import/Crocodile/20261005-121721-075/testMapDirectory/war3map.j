                    call dmgmag(s__FrierenSpells__FrierenSpells_F_c[this] , s__FrierenSpells__FrierenSpells_F_td[this] , s__FrierenSpells__FrierenSpells_F_dmg[this])
                    call SaveReal(hs, GetHandleId(s__FrierenSpells__FrierenSpells_F_td[this]), StringHash("frieren f dmg"), 0)
                    set s__FrierenSpells__FrierenSpells_F_td[this]=null
                    set s__FrierenSpells__FrierenSpells_F_c[this]=null
                    set s__FrierenSpells__FrierenSpells_F_m_FrierenF[i]=s__FrierenSpells__FrierenSpells_F_m_FrierenF[s__FrierenSpells__FrierenSpells_F_MUI_FrierenF]
                    set s__FrierenSpells__FrierenSpells_F_m_FrierenF[s__FrierenSpells__FrierenSpells_F_MUI_FrierenF]=0
