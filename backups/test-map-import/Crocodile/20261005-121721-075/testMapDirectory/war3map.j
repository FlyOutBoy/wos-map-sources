                        set y3=LoadReal(hs, GetHandleId(s__PatriotSpells__PatriotSpells_Q_c[this]), StringHash("t y"))
                        if s__PatriotSpells__PatriotSpells_Q_r5[this] >= s__PatriotSpells__PatriotSpells_Q_r6[this] then
