                            set damageCount=LoadInteger(hs, GetHandleId(s__CrocodileSpells___CrocodileT2KS_g2[this]), GetHandleId(s__CrocodileSpells___CrocodileT2KS_u[this]))

                            if SpellBool(s__CrocodileSpells___CrocodileT2KS_u[this]) and IsUnitEnemy(s__CrocodileSpells___CrocodileT2KS_u[this], GetOwningPlayer(s__CrocodileSpells___CrocodileT2KS_c[this])) then
                                if damageCount < CrocodileT2_DamageTicks then
                                    call dmgmag(s__CrocodileSpells___CrocodileT2KS_c[this] , s__CrocodileSpells___CrocodileT2KS_u[this] , s__CrocodileSpells___CrocodileT2KS_dmg[this])
                                    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", s__CrocodileSpells___CrocodileT2KS_u[this], "chest"))

