                call BlzSetSpecialEffectPosition(s__CrocodileSpells___CrocodileRProjectileKS_e2[this], s__CrocodileSpells___CrocodileRProjectileKS_currentX[this], s__CrocodileSpells___CrocodileRProjectileKS_currentY[this], s__CrocodileSpells___CrocodileRProjectileKS_fly[this])
