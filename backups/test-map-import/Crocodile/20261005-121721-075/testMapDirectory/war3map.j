        function s__GojoSpells__GojoSpells_Q_Loop_GojoQ takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__GojoSpells__GojoSpells_Q_MUI_GojoQ
                set this=s__GojoSpells__GojoSpells_Q_m_GojoQ[i]
                if SpellBoolCaster(s__GojoSpells__GojoSpells_Q_c[this]) and s__GojoSpells__GojoSpells_Q_r[this] <= s__GojoSpells__GojoSpells_Q_rmax[this] then
                    set s__GojoSpells__GojoSpells_Q_r[this]=RoundReal(s__GojoSpells__GojoSpells_Q_r[this] + 0.03 , 3)
                    if s__GojoSpells__GojoSpells_Q_k2[this] == 0 then
                        if s__GojoSpells__GojoSpells_Q_r[this] == 0.45 then
                            call StopSpellUnit2(s__GojoSpells__GojoSpells_Q_c[this])
                        endif
                        if s__GojoSpells__GojoSpells_Q_r[this] == 0.51 then
                            set s__GojoSpells__GojoSpells_Q_r2[this]=0
                            call MakeSound("war3mapimported\\Hero_Gojo_Q2")
                            call MakeSound("war3mapimported\\Hero_Gojo_Q2 2")
                            call VisionTimed(GetOwningPlayer(s__GojoSpells__GojoSpells_Q_c[this]) , s__GojoSpells__GojoSpells_Q_x[this] , s__GojoSpells__GojoSpells_Q_y[this] , 650 , 2)
                        endif
                        if s__GojoSpells__GojoSpells_Q_r[this] > 0.51 and s__GojoSpells__GojoSpells_Q_r2[this] > 0.06 then
                            set s__GojoSpells__GojoSpells_Q_r2[this]=0
                            set s__GojoSpells__GojoSpells_Q_k[this]=0
                            call GroupClear(s__GojoSpells__GojoSpells_Q_g[this])
                            call DecorRemove(s__GojoSpells__GojoSpells_Q_c[this] , s__GojoSpells__GojoSpells_Q_x1[this] + ( s__GojoSpells__GojoSpells_Q_sr[this] + 250 ) * Cos(s__GojoSpells__GojoSpells_Q_a[this]) , s__GojoSpells__GojoSpells_Q_y1[this] + ( s__GojoSpells__GojoSpells_Q_sr[this] + 250 ) * Sin(s__GojoSpells__GojoSpells_Q_a[this]) , s__GojoSpells__GojoSpells_Q_aoe[this] * 1.2 , 20)
                            call GroupEnumUnitsInRange(s__GojoSpells__GojoSpells_Q_g[this], s__GojoSpells__GojoSpells_Q_x1[this] + ( s__GojoSpells__GojoSpells_Q_sr[this] + 250 ) * Cos(s__GojoSpells__GojoSpells_Q_a[this]), s__GojoSpells__GojoSpells_Q_y1[this] + ( s__GojoSpells__GojoSpells_Q_sr[this] + 250 ) * Sin(s__GojoSpells__GojoSpells_Q_a[this]), s__GojoSpells__GojoSpells_Q_aoe[this], NoDecor_Cond)
                            loop
                                set s__GojoSpells__GojoSpells_Q_u[this]=FirstOfGroup(s__GojoSpells__GojoSpells_Q_g[this])
                                exitwhen s__GojoSpells__GojoSpells_Q_u[this] == null
                                if SpellBool(s__GojoSpells__GojoSpells_Q_u[this]) and IsUnitEnemy(s__GojoSpells__GojoSpells_Q_u[this], GetOwningPlayer(s__GojoSpells__GojoSpells_Q_c[this])) and IsUnitInGroup(s__GojoSpells__GojoSpells_Q_u[this], s__GojoSpells__GojoSpells_Q_g2[this]) == false then
                                    call GroupAddUnit(s__GojoSpells__GojoSpells_Q_g2[this], s__GojoSpells__GojoSpells_Q_u[this])
                                    call SaveInteger(hs, GetHandleId(s__GojoSpells__GojoSpells_Q_u[this]), StringHash("blue"), 1)
                                    call s__GearSystems2___KS_Flush_Start((GetHandleId(s__GojoSpells__GojoSpells_Q_u[this]) ) , ( StringHash("blue") ) , ( 0 ) , (( 1.75)*1.0)) // INLINED!!
                                    if LoadInteger(hs, GetHandleId(s__GojoSpells__GojoSpells_Q_u[this]), StringHash("red")) > 0 then
                                        call SaveInteger(hs, GetHandleId(s__GojoSpells__GojoSpells_Q_u[this]), StringHash("blue"), 0)
                                        call dmgphys(s__GojoSpells__GojoSpells_Q_c[this] , s__GojoSpells__GojoSpells_Q_u[this] , s__GojoSpells__GojoSpells_Q_dmg[this] + ( s__GojoSpells__GojoSpells_Q_dmg[this] * ( GojoQWLvl1_BonusDmg / 100 ) ))
                                        call StunUnit(s__GojoSpells__GojoSpells_Q_c[this] , s__GojoSpells__GojoSpells_Q_u[this] , GojoQLvl1_QW_StunTime)
                                        call s__GearSystems2___KS_MoveEffectToUnit_MoveEffectToUnit_Start((EffectSpawn("war3mapImported\\wos_purple wave explosion.mdl" , GetUnitX(s__GojoSpells__GojoSpells_Q_u[this]) , GetUnitY(s__GojoSpells__GojoSpells_Q_u[this]) , s__GojoSpells__GojoSpells_Q_a[this] * bj_RADTODEG , 1.5 , 0.65 , 1) ) , (( 1.25 )*1.0) , (( 5 )*1.0) , ( s__GojoSpells__GojoSpells_Q_u[this]) , 0 , 1 , null) // INLINED!!
                                    else
                                        call dmgphys(s__GojoSpells__GojoSpells_Q_c[this] , s__GojoSpells__GojoSpells_Q_u[this] , s__GojoSpells__GojoSpells_Q_dmg[this])
                                    endif
                                    if SR2(s__GojoSpells__GojoSpells_Q_c[this] , s__GojoSpells__GojoSpells_Q_u[this]) < GojoQ_PushRange + 100 then
                                        call MUE(s__GojoSpells__GojoSpells_Q_u[this] , SR2(s__GojoSpells__GojoSpells_Q_c[this] , s__GojoSpells__GojoSpells_Q_u[this]) - 50 , GojoQ_PushDuration , s__GojoSpells__GojoSpells_Q_a[this] + bj_DEGTORAD * 180)
                                    else
                                        call MUE(s__GojoSpells__GojoSpells_Q_u[this] , GojoQ_PushRange , GojoQ_PushDuration , s__GojoSpells__GojoSpells_Q_a[this] + bj_DEGTORAD * 180)
                                    endif
                                endif
                                call GroupRemoveUnit(s__GojoSpells__GojoSpells_Q_g[this], s__GojoSpells__GojoSpells_Q_u[this])
                            endloop
                            set s__GojoSpells__GojoSpells_Q_u[this]=null
