        endfunction

        function s__AinzSpells__AinzF_KS_AinzF_Start takes unit NewC returns nothing
            local integer this= s__AinzSpells__AinzF_KS__allocate()
            set s__AinzSpells__AinzF_KS_c[this]=NewC
            set s__AinzSpells__AinzF_KS_r[this]=0.00
            set s__AinzSpells__AinzF_KS_phase[this]=0
            call SaveInteger(hs, GetHandleId(GetOwningPlayer(s__AinzSpells__AinzF_KS_c[this])), StringHash(I2S(AinzQ_ID)), 0)
            call s__KS_SpellStacks_PauseStacks((s__AinzSpells__AinzF_KS_c[this]) , false) // INLINED!!
            call SetUnitAnimationByIndex(s__AinzSpells__AinzF_KS_c[this], 9)
            call SetUnitTimeScale(s__AinzSpells__AinzF_KS_c[this], 1.10)
            call StopSound(gg_snd_Hero_Ainz_F, false, false)
            call StartSound(gg_snd_Hero_Ainz_F)
            if GetHeroLevel(s__AinzSpells__AinzF_KS_c[this]) >= 35 then
            set s__AinzSpells__AinzF_KS_rmax[this]=999
            elseif GetHeroLevel(s__AinzSpells__AinzF_KS_c[this]) >= 25 then
            set s__AinzSpells__AinzF_KS_rmax[this]=5.82
            elseif GetHeroLevel(s__AinzSpells__AinzF_KS_c[this]) >= 12 then
            set s__AinzSpells__AinzF_KS_rmax[this]=2.13
            endif
            call s__AinzSpells__AinzF_KS_ClearBuffs(s__AinzSpells__AinzF_KS_c[this])
            call BuffUnit01(s__AinzSpells__AinzF_KS_c[this] , s__AinzSpells__AinzF_KS_c[this] , AinzF_BuffSpell_ID , AinzF_BuffOrder , 1)
            set s__AinzSpells__AinzF_KS_e[this]=AddSpecialEffectTarget("war3mapimported\\wos_ChuShou_BY_Wood_Effect_Glow_GuiPaiQiGong_XuLiblue.mdx", s__AinzSpells__AinzF_KS_c[this], "hand right")
            set s__AinzSpells__AinzF_KS_MUI_AinzF=s__AinzSpells__AinzF_KS_MUI_AinzF + 1
            set s__AinzSpells__AinzF_KS_m_AinzF[s__AinzSpells__AinzF_KS_MUI_AinzF]=this
            if s__AinzSpells__AinzF_KS_MUI_AinzF == 0 then
                call AinzSpells__AinzTimer03Acquire()
            endif
        endfunction


        function s__AinzSpells__AinzG_KS_Loop_AinzG takes nothing returns nothing
            local integer this
            local integer i= 0
            local real x
            local integer k= 0
            local real y
            loop
                exitwhen i > s__AinzSpells__AinzG_KS_MUI_AinzG
                set this=s__AinzSpells__AinzG_KS_m_AinzG[i]
                if SpellBoolCaster(s__AinzSpells__AinzG_KS_c[this]) and s__AinzSpells__AinzG_KS_count[this] < AinzG_DamageCount then
                    set s__AinzSpells__AinzG_KS_r[this]=RoundReal(s__AinzSpells__AinzG_KS_r[this] + 0.03 , 3)
                    if s__AinzSpells__AinzG_KS_r[this] < AinzG_PrepareTime then
                        call DebugUnit2(s__AinzSpells__AinzG_KS_c[this])
                        if s__AinzSpells__AinzG_KS_r[this] == 1.02 then
                    call BlzPlaySpecialEffect(s__AinzSpells__AinzG_KS_e[this], ANIM_TYPE_DEATH)
                    call BlzSetSpecialEffectTimeScale(s__AinzSpells__AinzG_KS_e[this], 2)
                    call MakeSound("war3mapimported\\Hero_Ainz_G2")
                        endif
                        if s__AinzSpells__AinzG_KS_r[this] == 1.56 then
                    call ScaleEffDummy(s__AinzSpells__AinzG_KS_e[this] , 0.15 , 2.25 , 1.45)
                    endif
                    elseif s__AinzSpells__AinzG_KS_r[this] == AinzG_PrepareTime then
                    
                        set s__AinzSpells__AinzG_KS_x1[this]=GetUnitX(s__AinzSpells__AinzG_KS_c[this])
                        set s__AinzSpells__AinzG_KS_y1[this]=GetUnitY(s__AinzSpells__AinzG_KS_c[this])
                        set x=GetUnitX(s__AinzSpells__AinzG_KS_c[this])
                        set y=GetUnitY(s__AinzSpells__AinzG_KS_c[this])
                   // call MyRemoveEff(EffectSpawnScale("war3mapImported\\wos_bluebeamfromair.mdl",x,y,1,1.4,1,0,0.75,1,1.4),2.4)
                    call s__GearSystems2___KS_RemoveEffect_MyRemoveEff_Start((EffectSpawnScale("war3mapImported\\wos_bluebeamfromair.mdl" , x , y , 1 , 1.4 , 1 , 0 , 1.02 , 1 , 3.4) ) , (( 2.4)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
                    call s__GearSystems2___KS_RemoveEffect_MyRemoveEff_Start((EffectSpawnScale("war3mapImported\\wos_bluebeamfromair.mdl" , x , y , 1 , 1.4 , 1 , 0 , 1.02 , 1 , 5.4) ) , (( 2.4)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
                    
                    call BlzSetSpecialEffectTimeScale(s__AinzSpells__AinzG_KS_e[this], 0.75)
                    call MakeSound("war3mapimported\\Hero_Ainz_G3")
                    elseif s__AinzSpells__AinzG_KS_count[this] == 0 or s__AinzSpells__AinzG_KS_r2[this] >= AinzG_DamagePeriod then
                        set s__AinzSpells__AinzG_KS_r2[this]=0.00
                        
                        set x=GetUnitX(s__AinzSpells__AinzG_KS_c[this])
                        set y=GetUnitY(s__AinzSpells__AinzG_KS_c[this])
                        set k=0
                        if s__AinzSpells__AinzG_KS_count[this] < AinzG_DamageCount - 1 then
                        loop
                        exitwhen k == 4
                        call DestroyEffect(EffectSpawnColor("war3mapimported\\wos_dustwave222.mdx" , x , y , GetRandomReal(0, 359) , 0.65 , 6 + s__AinzSpells__AinzG_KS_count[this] + k * 0.1 , 1 , 255 , 255 , 255 , 90))
                            set k=k + 1
                            endloop
                            endif
                       // call DestroyEffect(EffectSpawn("war3mapimported\\wos_OPm (431232).mdl", x, y, GetRandomReal(0, 359), 1.5, 2.15, 35))
                          //      call DestroyEffect(EffectSpawn("war3mapimported\\wos_blue--zhendi31_3_x2.mdl", x, y, GetRandomReal(0, 359), 1, 1, 1))
                          //      call DestroyEffect(EffectSpawnColor("war3mapimported\\wos_by_wood_effect_order_dange_yueyun_2withoutblue2.mdl", x, y, GetRandomReal(0, 359), 2.35, 1.5, 1, 255, 255, 255, 55))
                        call DecorRemove(s__AinzSpells__AinzG_KS_c[this] , x , y , AinzG_Aoe , 100)
                        //call DestroyEffect(EffectSpawn(AinzG_EffectModel, x, y, GetRandomReal(0, 359), 0.80, 2.00, 0))
                        call GroupEnumUnitsInRange(s__AinzSpells__AinzG_KS_g[this], x, y, AinzG_Aoe, NoDecor_Cond)
                        loop
                            set s__AinzSpells__AinzG_KS_u[this]=FirstOfGroup(s__AinzSpells__AinzG_KS_g[this])
                            exitwhen s__AinzSpells__AinzG_KS_u[this] == null
                            if SpellBool(s__AinzSpells__AinzG_KS_u[this]) and IsUnitEnemy(s__AinzSpells__AinzG_KS_u[this], GetOwningPlayer(s__AinzSpells__AinzG_KS_c[this])) then
                                call dmgmag(s__AinzSpells__AinzG_KS_c[this] , s__AinzSpells__AinzG_KS_u[this] , s__AinzSpells__AinzG_KS_dmg[this])
                                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", s__AinzSpells__AinzG_KS_u[this], "chest"))
                            endif
                            call GroupRemoveUnit(s__AinzSpells__AinzG_KS_g[this], s__AinzSpells__AinzG_KS_u[this])
                        endloop
                        set s__AinzSpells__AinzG_KS_count[this]=s__AinzSpells__AinzG_KS_count[this] + 1
                    else
                        set s__AinzSpells__AinzG_KS_r2[this]=s__AinzSpells__AinzG_KS_r2[this] + 0.03
                        call PosUnit(s__AinzSpells__AinzG_KS_c[this] , s__AinzSpells__AinzG_KS_x1[this] , s__AinzSpells__AinzG_KS_y1[this])
                        call DebugUnit2(s__AinzSpells__AinzG_KS_c[this])
                    endif
                else
                    call StopSpellUnit2(s__AinzSpells__AinzG_KS_c[this])
            call SaveInteger(hs, GetHandleId(GetOwningPlayer(s__AinzSpells__AinzG_KS_c[this])), StringHash("tomioka f invul"), 0)
                    call ColorEffDummy3(s__AinzSpells__AinzG_KS_e[this] , 0 , 255 , 255 , 255 , 0.15)
                    call DestroyGroup(s__AinzSpells__AinzG_KS_g[this])
                    set s__AinzSpells__AinzG_KS_c[this]=null
                    set s__AinzSpells__AinzG_KS_u[this]=null
                    set s__AinzSpells__AinzG_KS_e[this]=null
                    set s__AinzSpells__AinzG_KS_g[this]=null
                    set s__AinzSpells__AinzG_KS_m_AinzG[i]=s__AinzSpells__AinzG_KS_m_AinzG[s__AinzSpells__AinzG_KS_MUI_AinzG]
                    set s__AinzSpells__AinzG_KS_MUI_AinzG=s__AinzSpells__AinzG_KS_MUI_AinzG - 1
                    if s__AinzSpells__AinzG_KS_MUI_AinzG == - 1 then
                        call AinzSpells__AinzTimer03Release()
                    endif
                    call s__AinzSpells__AinzG_KS_deallocate(this)
                    set i=i - 1
                endif
                set i=i + 1
            endloop
        endfunction

        function s__AinzSpells__AinzG_KS_AinzG_Start takes unit NewC returns nothing
            local integer this= s__AinzSpells__AinzG_KS__allocate()
            local integer level= GetUnitAbilityLevel(NewC, AinzG_ID)
            if level < 1 then
                set level=1
            endif
            set s__AinzSpells__AinzG_KS_c[this]=NewC
            set s__AinzSpells__AinzG_KS_u[this]=null
            set s__AinzSpells__AinzG_KS_g[this]=CreateGroup()
            set s__AinzSpells__AinzG_KS_r[this]=0.00
            set s__AinzSpells__AinzG_KS_r2[this]=0.00
            set s__AinzSpells__AinzG_KS_count[this]=0
            set s__AinzSpells__AinzG_KS_dmg[this]=GetHeroInt(s__AinzSpells__AinzG_KS_c[this], true) * ( AinzG_DamageIntBase + AinzG_DamageIntStep * ( level - 1 ) )
            set s__AinzSpells__AinzG_KS_dmg[this]=s__AinzSpells__AinzG_KS_dmg[this] / 8
            call StartSpellUnit2(s__AinzSpells__AinzG_KS_c[this])
            call MakeSound("war3mapimported\\Hero_Ainz_G1")
            set s__AinzSpells__AinzG_KS_e[this]=EffectSpawn("war3mapImported\\wos_gatmofazhen.mdl" , GetUnitX(s__AinzSpells__AinzG_KS_c[this]) , GetUnitY(s__AinzSpells__AinzG_KS_c[this]) , 0 , 1.5 , 1 , 0)
            call BlzSetSpecialEffectAlpha(s__AinzSpells__AinzG_KS_e[this], 0)
            call ColorEffDummy4(s__AinzSpells__AinzG_KS_e[this] , 0 , 255 , 255 , 255 , 0.51)
            call BlzSetSpecialEffectScale(s__AinzSpells__AinzG_KS_e[this], 2.25)
            call SetUnitAnimationByIndex(s__AinzSpells__AinzG_KS_c[this], 13)
            call SetUnitTimeScale(s__AinzSpells__AinzG_KS_c[this], 0.55)
            call SaveInteger(hs, GetHandleId(GetOwningPlayer(s__AinzSpells__AinzG_KS_c[this])), StringHash("tomioka f invul"), 1)
            set s__AinzSpells__AinzG_KS_MUI_AinzG=s__AinzSpells__AinzG_KS_MUI_AinzG + 1
            set s__AinzSpells__AinzG_KS_m_AinzG[s__AinzSpells__AinzG_KS_MUI_AinzG]=this
            if s__AinzSpells__AinzG_KS_MUI_AinzG == 0 then
                call AinzSpells__AinzTimer03Acquire()
            endif
        endfunction









    function AinzSpells__AinzTimer03Loop takes nothing returns nothing
        call s__AinzSpells__AinzQ_KS_Loop_AinzQ()
        call s__AinzSpells__AinzTQ_KS_Loop_AinzTQ()
        call s__AinzSpells__AinzTW_KS_Loop_AinzTW()
        call s__AinzSpells__AinzW_KS_Loop_AinzW()
        call s__AinzSpells__AinzW_KS_Loop_AinzW2()
        call s__AinzSpells__AinzW_KS_Loop_AinzW3()
        call s__AinzSpells__AinzE_KS_Loop_AinzE()
        call s__AinzSpells__AinzTR_KS_Loop_AinzTR()
        call s__AinzSpells__AinzR_KS_Loop_AinzR()
        call s__AinzSpells__AinzT_KS_Loop_AinzT()
        call s__AinzSpells__AinzF_KS_Loop_AinzF()
        call s__AinzSpells__AinzG_KS_Loop_AinzG()
    endfunction

    function AinzSpells__InitAinzSpells takes nothing returns nothing
        set AinzSpells__AinzTimer03=CreateTimer()
        set AinzSpells__AinzTQEnumGroup=CreateGroup()
        set AinzSpells__AinzTimer03Callback=function AinzSpells__AinzTimer03Loop
        call s__AinzSpells__AinzW_KS_InitknightEvents()
    endfunction

    //----------------------------Ainz-----------------------------------------------
     
    // Can be used by the spell trigger/charge system before the cost is spent.
    function AinzQ_IsMinePositionFree takes real x,real y returns boolean
        return s__AinzSpells__AinzQ_KS_IsMinePositionFree(x , y)
    endfunction

    function AinzQ2_IsMineRingFree takes real x,real y returns boolean
        return (s__AinzSpells__AinzQ_KS_CanPlaceRing(((x )*1.0) , (( y)*1.0))) // INLINED!!
    endfunction

    function AinzQ_Start takes unit c,real x,real y returns nothing
     if (s__AinzSpells__AinzQ_KS_IsMinePositionFree(((x )*1.0) , (( y)*1.0))) == true then // INLINED!!
     call s__KS_SpellStacks_MyRemoveStack((c)) // INLINED!!
        endif
        call s__AinzSpells__AinzQ_KS_AinzQ_Start(c , x , y)
    endfunction
    function AinzQ2_Start takes unit c,real x,real y returns nothing
     if (s__AinzSpells__AinzQ_KS_CanPlaceRing(((((x )*1.0) )*1.0) , (( (( y)*1.0))*1.0))) == true then // INLINED!!
     call s__KS_SpellStacks_MyRemoveStack((c)) // INLINED!!
        endif
        call s__AinzSpells__AinzQ_KS_AinzQ2_Start(c , x , y)
    endfunction
    function AinzTQ_Start takes unit c,unit target returns nothing
        call s__AinzSpells__AinzTQ_KS_AinzTQ_Start(c , target)
    endfunction
    function AinzW_Start takes unit c returns nothing
        call s__AinzSpells__AinzW_KS_AinzW_Start(c)
    endfunction
    function AinzW2SaveCaster takes unit ainz,unit protectedUnit returns nothing
        if ainz == null or protectedUnit == null then
            return
        endif
        call SaveUnitHandle(hs, GetHandleId(protectedUnit), StringHash("AinzW2 ally caster"), ainz)
    endfunction
    function AinzW2_Start takes unit c,unit td returns nothing
        // Обычная W2: рыцарь телепортируется к самому Аинзу.
   if IsUnitEnemy(td, GetOwningPlayer(c)) then
        call s__AinzSpells__AinzW_KS_AinzW2_Start(c , c , td)
        else
        call AinzW2SaveCaster(c , td)
         call BuffUnit01(c , td , AinzF_BuffSpell_ID , AinzF_BuffOrder , 8)
        endif
    endfunction

    // Вызывается при выдаче союзнику баффа W2.
    // Сохраняет, какому Аинзу принадлежит защитный бафф этого юнита.
    

    // Можно вызвать, если бафф закончился без срабатывания.
    function AinzW2ClearCaster takes unit protectedUnit returns nothing
        if protectedUnit != null then
            call RemoveSavedHandle(hs, GetHandleId(protectedUnit), StringHash("AinzW2 ally caster"))
        endif
    endfunction

    // Альтернативная W2 вызывается непосредственно из события получения урона.
    // Нужно передать только потерпевшего: Аинз берётся из хеша, а конечной
    // целью рывка становится источник текущего события урона.
    function AinzW2Alternative_Start takes unit protectedUnit,unit attacker returns nothing
        local unit ainz

        if protectedUnit == null then
            return
        endif

        set ainz=LoadUnitHandle(hs, GetHandleId(protectedUnit), StringHash("AinzW2 ally caster"))
   

        // Бафф одноразовый: после попытки срабатывания привязка удаляется.
        call RemoveSavedHandle(hs, GetHandleId(protectedUnit), StringHash("AinzW2 ally caster"))

        if ainz != null and GetUnitTypeId(ainz) == Ainz_ID and GetWidgetLife(ainz) > 0.405 and attacker != null and GetWidgetLife(attacker) > 0.405 then
            call s__AinzSpells__AinzW_KS_AinzW2_Start(ainz , protectedUnit , attacker)
        endif

        set ainz=null
        set attacker=null
    endfunction
    function AinzW3_Start takes unit c,real x,real y returns nothing
        call s__AinzSpells__AinzW_KS_AinzW3_Start(c , x , y)
    endfunction
    function AinzE_Start takes unit c,real x,real y returns nothing
        call s__AinzSpells__AinzE_KS_AinzE_Start(c , x , y)
    endfunction
    function AinzE2_Start takes unit c,unit td returns nothing
        call s__AinzSpells__AinzE_KS_AinzE2_Start(c , td)
    endfunction
    function AinzR_Start takes unit c,real x,real y returns nothing
        call s__AinzSpells__AinzR_KS_AinzR_Start(c , x , y)
    endfunction
