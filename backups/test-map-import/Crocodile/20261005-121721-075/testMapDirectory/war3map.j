call SetCameraField(CAMERA_FIELD_TARGET_DISTANCE, 4000, 1)
call SelectUnit(Hero[i], true) // выбор ichigo 
call PanCameraToTimed(GetUnitX(Hero[i]), GetUnitY(Hero[i]), 1)
