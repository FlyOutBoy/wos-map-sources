        function s__MahoragaSpells__MahoragaSpells_Q_Loop_MahoragaQ2 takes nothing returns nothing
            local integer this
            local integer i= 0
            local real rr1= 0
            local real rr2= 0
            local real rr3= 0
            local real rr4= 0
            local real rr5= 0
            loop
                exitwhen i > s__MahoragaSpells__MahoragaSpells_Q_MUI_MahoragaQ2
                set this=s__MahoragaSpells__MahoragaSpells_Q_m_MahoragaQ2[i]
                if SpellBoolCaster(s__MahoragaSpells__MahoragaSpells_Q_c[this]) and s__MahoragaSpells__MahoragaSpells_Q_r[this] <= s__MahoragaSpells__MahoragaSpells_Q_rmax[this] then
                    set s__MahoragaSpells__MahoragaSpells_Q_r[this]=s__MahoragaSpells__MahoragaSpells_Q_r[this] + 0.03
                    if s__MahoragaSpells__MahoragaSpells_Q_r[this] == 0.21 then
                        call MakeSound("war3mapimported\\Hero_Mahoraga_Q2 1")
                    endif
                    call DebugUnit2(s__MahoragaSpells__MahoragaSpells_Q_c[this])
                    if s__MahoragaSpells__MahoragaSpells_Q_r2[this] > 0.15 then
                        set s__MahoragaSpells__MahoragaSpells_Q_r2[this]=0
                        set s__MahoragaSpells__MahoragaSpells_Q_x[this]=GetUnitX(s__MahoragaSpells__MahoragaSpells_Q_c[this]) + 250 * Cos(s__MahoragaSpells__MahoragaSpells_Q_a[this])
                        set s__MahoragaSpells__MahoragaSpells_Q_y[this]=GetUnitY(s__MahoragaSpells__MahoragaSpells_Q_c[this]) + 250 * Sin(s__MahoragaSpells__MahoragaSpells_Q_a[this])
                        set rr3=GetRandomReal(- 45, - 15)
                        set rr4=GetRandomReal(8, 9.5)
                        if GetRandomInt(1, 4) > 2 then
                            set rr3=GetRandomReal(- 345, - 315)
                        endif
                        set rr5=GetRandomReal(20, 150)
                        if s__MahoragaSpells__MahoragaSpells_Q_check2[this] == 0 then
                            set s__MahoragaSpells__MahoragaSpells_Q_check2[this]=1
                            call DestroyEffect(EffectSpawn4("war3mapImported\\wos_VergilSlashes.mdl" , GetUnitX(s__MahoragaSpells__MahoragaSpells_Q_c[this]) + rr5 * Cos(s__MahoragaSpells__MahoragaSpells_Q_a[this]) , GetUnitY(s__MahoragaSpells__MahoragaSpells_Q_c[this]) + rr5 * Sin(s__MahoragaSpells__MahoragaSpells_Q_a[this]) , s__MahoragaSpells__MahoragaSpells_Q_a[this] * bj_RADTODEG , 1.5 , rr4 , 255 , rr3))
                        else
                            call ColorEffDummy3(EffectSpawn4("war3mapImported\\wos_VergilSlashes.mdl" , GetUnitX(s__MahoragaSpells__MahoragaSpells_Q_c[this]) + rr5 * Cos(s__MahoragaSpells__MahoragaSpells_Q_a[this]) , GetUnitY(s__MahoragaSpells__MahoragaSpells_Q_c[this]) + rr5 * Sin(s__MahoragaSpells__MahoragaSpells_Q_a[this]) , s__MahoragaSpells__MahoragaSpells_Q_a[this] * bj_RADTODEG , 1.5 , rr4 , 255 , rr3) , 0.3 , 255 , 255 , 255 , 0.03)
                            set s__MahoragaSpells__MahoragaSpells_Q_check2[this]=0
                        endif
                        set rr1=GetRandomReal(20, 165)
                        if GetRandomInt(1, 10) > 5 then
                            set rr2=- 90 * bj_DEGTORAD
                        else
                            set rr2=90 * bj_DEGTORAD
                        endif
                        set s__MahoragaSpells__MahoragaSpells_Q_x1[this]=s__MahoragaSpells__MahoragaSpells_Q_x[this] + rr1 * Cos(s__MahoragaSpells__MahoragaSpells_Q_a[this] + rr2)
                        set s__MahoragaSpells__MahoragaSpells_Q_y1[this]=s__MahoragaSpells__MahoragaSpells_Q_y[this] + rr1 * Sin(s__MahoragaSpells__MahoragaSpells_Q_a[this] + rr2)
                        set rr4=GetRandomReal(- 240, - 30)
                        set rr5=GetRandomReal(0, 150)
                        call DestroyEffect(EffectSpawn3("war3mapImported\\wos_acg_bbb.mdl" , s__MahoragaSpells__MahoragaSpells_Q_x[this] + 150 * Cos(s__MahoragaSpells__MahoragaSpells_Q_a[this]) , s__MahoragaSpells__MahoragaSpells_Q_y[this] + 150 * Sin(s__MahoragaSpells__MahoragaSpells_Q_a[this]) , s__MahoragaSpells__MahoragaSpells_Q_a[this] * bj_RADTODEG , GetRandomReal(0, 359) , 1.35 , 225 , rr4))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_YC_CrossFlash.mdl" , s__MahoragaSpells__MahoragaSpells_Q_x1[this] + 25 * Cos(s__MahoragaSpells__MahoragaSpells_Q_a[this]) , s__MahoragaSpells__MahoragaSpells_Q_y1[this] + 25 * Sin(s__MahoragaSpells__MahoragaSpells_Q_a[this]) , 1 , 1.1 , 1.475 , 125 + rr5))
                        call DecorRemove(s__MahoragaSpells__MahoragaSpells_Q_c[this] , s__MahoragaSpells__MahoragaSpells_Q_x[this] , s__MahoragaSpells__MahoragaSpells_Q_y[this] , s__MahoragaSpells__MahoragaSpells_Q_aoe[this] , 25)
                        call GroupEnumUnitsInRange(s__MahoragaSpells__MahoragaSpells_Q_g[this], s__MahoragaSpells__MahoragaSpells_Q_x[this], s__MahoragaSpells__MahoragaSpells_Q_y[this], s__MahoragaSpells__MahoragaSpells_Q_aoe[this], NoDecor_Cond)
                        loop
                            set s__MahoragaSpells__MahoragaSpells_Q_u[this]=FirstOfGroup(s__MahoragaSpells__MahoragaSpells_Q_g[this])
                            exitwhen s__MahoragaSpells__MahoragaSpells_Q_u[this] == null
                            if SpellBool(s__MahoragaSpells__MahoragaSpells_Q_u[this]) and IsUnitEnemy(s__MahoragaSpells__MahoragaSpells_Q_u[this], GetOwningPlayer(s__MahoragaSpells__MahoragaSpells_Q_c[this])) then
                                call dmgphys(s__MahoragaSpells__MahoragaSpells_Q_c[this] , s__MahoragaSpells__MahoragaSpells_Q_u[this] , s__MahoragaSpells__MahoragaSpells_Q_dmg[this])
                                call StunUnit(s__MahoragaSpells__MahoragaSpells_Q_c[this] , s__MahoragaSpells__MahoragaSpells_Q_u[this] , MahoragaQ2_Stun)
                                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", s__MahoragaSpells__MahoragaSpells_Q_u[this], "chest"))
                            endif
                            call GroupRemoveUnit(s__MahoragaSpells__MahoragaSpells_Q_g[this], s__MahoragaSpells__MahoragaSpells_Q_u[this])
                        endloop
                        set s__MahoragaSpells__MahoragaSpells_Q_u[this]=null
                    else
                        set s__MahoragaSpells__MahoragaSpells_Q_r2[this]=s__MahoragaSpells__MahoragaSpells_Q_r2[this] + 0.03
                    endif
                else
                    call StopSpellUnit2(s__MahoragaSpells__MahoragaSpells_Q_c[this])
                    call SetUnitTimeScale(s__MahoragaSpells__MahoragaSpells_Q_c[this], 1)
                    call DestroyGroup(s__MahoragaSpells__MahoragaSpells_Q_g[this])
                    call SetUnitAnimation(s__MahoragaSpells__MahoragaSpells_Q_c[this], "stand")
                    set s__MahoragaSpells__MahoragaSpells_Q_g[this]=null
                    set s__MahoragaSpells__MahoragaSpells_Q_c[this]=null
                    set s__MahoragaSpells__MahoragaSpells_Q_u[this]=null
                    set s__MahoragaSpells__MahoragaSpells_Q_m_MahoragaQ2[i]=s__MahoragaSpells__MahoragaSpells_Q_m_MahoragaQ2[s__MahoragaSpells__MahoragaSpells_Q_MUI_MahoragaQ2]
                    set s__MahoragaSpells__MahoragaSpells_Q_MUI_MahoragaQ2=s__MahoragaSpells__MahoragaSpells_Q_MUI_MahoragaQ2 - 1
                    if s__MahoragaSpells__MahoragaSpells_Q_MUI_MahoragaQ2 == - 1 then
                        call PauseTimer(s__MahoragaSpells__MahoragaSpells_Q_t_MahoragaQ2)
                    endif
                    call s__MahoragaSpells__MahoragaSpells_Q_deallocate(this)
                endif
