            call BlzFrameSetSize(s__frameRimuru2_pas3[k2], 0.1, 0.035)
            call BlzFrameSetScale(s__frameRimuru2_pas3[k2], 0.5)
            call BlzFrameSetModel(s__frameRimuru2_pas3[k2], "ui/feedback/XpBar/XpBarConsole.mdx", 0)
            call BlzFrameSetAbsPoint(s__frameRimuru2_pas3[k2], FRAMEPOINT_CENTER, 0.05, 0.175 + tmp_y)
            call BlzFrameSetMinMaxValue(s__frameRimuru2_pas3[k2], 0, I2R(k3 + 10))
            call BlzFrameSetValue(s__frameRimuru2_pas3[k2], 0)
            set s__frameRimuru2_pas4[k2]= BlzCreateFrameByType("BACKDROP", "SS", s__frameRimuru2_pas1[k2], "", 0)
            call BlzFrameSetAbsPoint(s__frameRimuru2_pas4[k2], FRAMEPOINT_CENTER, 0.005, 0.18 + tmp_y)
            call BlzFrameSetSize(s__frameRimuru2_pas4[k2], 0.03, 0.03)
            call BlzFrameSetTexture(s__frameRimuru2_pas4[k2], "ReplaceableTextures\\CommandButtons\\BTNHero_Rimuru3_G", 0, false)
            set s__frameRimuru2_pas5[k2]= BlzCreateFrameByType("TEXT", "MyPlayerName", s__frameRimuru2_pas1[k2], "", 0)
            call BlzFrameSetAbsPoint(s__frameRimuru2_pas5[k2], FRAMEPOINT_CENTER, 0.07, 0.185 + tmp_y)
            call BlzFrameSetText(s__frameRimuru2_pas5[k2], "|c00FFFF00Soul Gathered:|r")
            call BlzFrameSetScale(s__frameRimuru2_pas5[k2], 0.9)
            set s__frameRimuru2_pas6[k2]= BlzCreateFrameByType("TEXT", "MyPlayerName", s__frameRimuru2_pas1[k2], "", 0)
            call BlzFrameSetAbsPoint(s__frameRimuru2_pas6[k2], FRAMEPOINT_CENTER, 0.07, 0.17 + tmp_y)
            call BlzFrameSetText(s__frameRimuru2_pas6[k2], "|c00FFFF000/" + I2S(k3) + "|r")
            call BlzFrameSetScale(s__frameRimuru2_pas6[k2], 0.9)
        else
            if GetLocalPlayer() == GetOwningPlayer(c) then
                call BlzFrameSetVisible(s__frameRimuru2_pas1[k2], true)
            endif
            call BlzFrameSetText(s__frameRimuru2_pas6[k2], "|c00FFFF000/" + I2S(k3) + "|r")
            call BlzFrameSetMinMaxValue(s__frameRimuru2_pas3[k2], 0, I2R(k3 + 1))
            call BlzFrameSetValue(s__frameRimuru2_pas3[k2], 0)
            set k=LoadInteger(hs, GetHandleId(Hero[k]), StringHash("evol kill"))
            if k > k3 then
                set k=k3
            endif
            call BlzFrameSetText(s__frameRimuru2_pas6[k2], "|c00FFFF00" + I2S(k) + "/" + I2S(k3) + "|r")
            call BlzFrameSetValue(s__frameRimuru2_pas3[k2], I2R(k))
        endif
    else
        call s__RimuruSpells__Rimuru2Evol_KS_Rimuru2Evol_Start(c)
        if GetLocalPlayer() == GetOwningPlayer(c) then
            call BlzFrameSetVisible(s__frameRimuru2_pas1[k2], false)
        endif
    endif
endfunction
