                                set s__FrierenSpells__FrierenSpells_E_r6[this]=GetRandomReal(0, 360) * bj_DEGTORAD
                                if s__FrierenSpells__FrierenSpells_E_check2[this] == 1 then
                                    set s__FrierenSpells__FrierenSpells_E_r5[this]=GetRandomReal(355, 665)
                                else
                                    set s__FrierenSpells__FrierenSpells_E_r5[this]=GetRandomReal(275, 455)
                                endif
                                set s__FrierenSpells__FrierenSpells_E_x[this]=GetUnitX(s__FrierenSpells__FrierenSpells_E_c[this]) + s__FrierenSpells__FrierenSpells_E_r5[this] * Cos(s__FrierenSpells__FrierenSpells_E_r6[this])
                                set s__FrierenSpells__FrierenSpells_E_y[this]=GetUnitY(s__FrierenSpells__FrierenSpells_E_c[this]) + s__FrierenSpells__FrierenSpells_E_r5[this] * Sin(s__FrierenSpells__FrierenSpells_E_r6[this])
