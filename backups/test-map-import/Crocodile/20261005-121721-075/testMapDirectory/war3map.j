            if LoadInteger(hs, GetHandleId(s__LaxusSpells__LaxusF_KS_c[this]), StringHash("lvl5")) == 1 then
            set s__LaxusSpells__LaxusF_KS_dmg[this]=s__LaxusSpells__LaxusF_KS_dmg[this] + GetHeroStr(s__LaxusSpells__LaxusF_KS_c[this], true) * LaxusGF_DamageStrBonus2
           
                set s__LaxusSpells__LaxusF_KS_check2[this]=1
            endif
        endif
        if LoadInteger(hs, GetHandleId(s__LaxusSpells__LaxusF_KS_c[this]), StringHash("lvl5")) == 1 then
         call MakeSound("war3mapimported\\Hero_Laxus_GW3")
        else
        call MakeSound("war3mapimported\\Hero_Laxus_F1")
        endif
        call SetUnitVertexColor(s__LaxusSpells__LaxusF_KS_c[this], 255, 255, 255, 0)
        if s__LaxusSpells__LaxusF_KS_check2[this] == 1 then
        set s__LaxusSpells__LaxusF_KS_e[this]=EffectSpawn("war3mapImported\\wos_BJT_VFX_ERE_LightningFieldBall_Ore_red.mdl" , GetUnitX(s__LaxusSpells__LaxusF_KS_c[this]) , GetUnitY(s__LaxusSpells__LaxusF_KS_c[this]) , 1 , 1 , 1 , 100)
        set s__LaxusSpells__LaxusF_KS_e2[this]=AddSpecialEffectTarget("war3mapImported\\wos_File00229.mdl", s__LaxusSpells__LaxusF_KS_c[this], "hand left")
        set s__LaxusSpells__LaxusF_KS_e3[this]=AddSpecialEffectTarget("war3mapImported\\wos_BJT_VFX_ERE_LightningFieldBall_Ore_red.mdl", s__LaxusSpells__LaxusF_KS_c[this], "hand left")
                else
        set s__LaxusSpells__LaxusF_KS_e[this]=EffectSpawn("war3mapImported\\wos_BJT_VFX_ERE_LightningFieldBall_Ore.mdl" , GetUnitX(s__LaxusSpells__LaxusF_KS_c[this]) , GetUnitY(s__LaxusSpells__LaxusF_KS_c[this]) , 1 , 1 , 1 , 100)
        set s__LaxusSpells__LaxusF_KS_e2[this]=AddSpecialEffectTarget("war3mapImported\\wos_File00229.mdl", s__LaxusSpells__LaxusF_KS_c[this], "hand left")
        set s__LaxusSpells__LaxusF_KS_e3[this]=AddSpecialEffectTarget("war3mapImported\\wos_BJT_VFX_ERE_LightningFieldBall_Ore.mdl", s__LaxusSpells__LaxusF_KS_c[this], "hand left")
        endif
       //set e = AddSpecialEffectTarget("war3mapImported\\wos_lb_hg2-E12B5.mdx", c, "hand right")
       //set e2 = AddSpecialEffectTarget("war3mapImported\\wos_YellowMissile.mdl", c, "hand right")
        if s__LaxusSpells__LaxusF_KS_MUI_LaxusF == 0 then
            call LaxusSpells__LaxusTimer03Acquire()
        endif
    endfunction

        function s__LaxusSpells__LaxusG_KS_Loop_LaxusG takes nothing returns nothing
            local integer this
            local integer i= 0
            local real remaining
            local real hp
            loop
                exitwhen i > s__LaxusSpells__LaxusG_KS_MUI_LaxusG
                set this=s__LaxusSpells__LaxusG_KS_m_LaxusG[i]
                if SpellBoolCaster(s__LaxusSpells__LaxusG_KS_c[this]) and s__LaxusSpells__LaxusG_KS_r[this] <= s__LaxusSpells__LaxusG_KS_rmax[this] and CheckCoordsInRect(gg_rct_Base , GetUnitX(s__LaxusSpells__LaxusG_KS_c[this]) , GetUnitY(s__LaxusSpells__LaxusG_KS_c[this])) == false then
                    if IsUnitPaused(s__LaxusSpells__LaxusG_KS_c[this]) == false then
                        set s__LaxusSpells__LaxusG_KS_r[this]=RoundReal(s__LaxusSpells__LaxusG_KS_r[this] + 0.03 , 3)
                    endif
                    set remaining=s__LaxusSpells__LaxusG_KS_rmax[this] - s__LaxusSpells__LaxusG_KS_r[this]
                    if remaining < 0 then
                        set remaining=0
                    endif
                    call BlzFrameSetValue(s__LaxusSpells__LaxusG_KS_frame_pas3[s__LaxusSpells__LaxusG_KS_k2[this]], remaining)
                    call BlzFrameSetText(s__LaxusSpells__LaxusG_KS_frame_pas6[s__LaxusSpells__LaxusG_KS_k2[this]], "|c00FFFF00" + R2SW(remaining, 0, 2) + "|r")
                else
                    if GetLocalPlayer() == Player(s__LaxusSpells__LaxusG_KS_k2[this]) then
                        call BlzFrameSetVisible(s__LaxusSpells__LaxusG_KS_frame_pas1[s__LaxusSpells__LaxusG_KS_k2[this]], false)
                    endif

            call SaveInteger(hs, GetHandleId(s__LaxusSpells__LaxusG_KS_c[this]), StringHash("lvl4"), 0)
                    call IssueImmediateOrder(s__LaxusSpells__LaxusG_KS_c[this], "stop")
                    if GetLocalPlayer() == Player(s__LaxusSpells__LaxusG_KS_k2[this]) then
                        call BlzSetAbilityIcon(LaxusQ2_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Laxus_Q2.blp")
                        call BlzSetAbilityIcon(LaxusW_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Laxus_W.blp")
                        call BlzSetAbilityIcon(LaxusW2_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Laxus_W2.blp")
                        call BlzSetAbilityIcon(LaxusE_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Laxus_E.blp")
                        call BlzSetAbilityIcon(LaxusR_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Laxus_R.blp")
                        call BlzSetAbilityIcon(LaxusF_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Laxus_F.blp")
                    endif
                    call SaveInteger(hs, GetHandleId(s__LaxusSpells__LaxusG_KS_c[this]), StringHash("mode g"), 0)
                    call DestroyEffect(s__LaxusSpells__LaxusG_KS_e[this])
                    set hp=GetUnitState(s__LaxusSpells__LaxusG_KS_c[this], UNIT_STATE_LIFE) / GetUnitState(s__LaxusSpells__LaxusG_KS_c[this], UNIT_STATE_MAX_LIFE)
                    call BlzSetUnitMaxHP(s__LaxusSpells__LaxusG_KS_c[this], BlzGetUnitMaxHP(s__LaxusSpells__LaxusG_KS_c[this]) - s__LaxusSpells__LaxusG_KS_scale[this])
            call SetUnitState(s__LaxusSpells__LaxusG_KS_c[this], UNIT_STATE_LIFE, GetUnitState(s__LaxusSpells__LaxusG_KS_c[this], UNIT_STATE_MAX_LIFE) * hp)
         call UnitRemoveAbility(s__LaxusSpells__LaxusG_KS_c[this], 'A0F0')
         
                call SetPlayerAbilityAvailable(GetOwningPlayer(s__LaxusSpells__LaxusG_KS_c[this]), LaxusQ_ID, true)
                    call SetPlayerAbilityAvailable(GetOwningPlayer(s__LaxusSpells__LaxusG_KS_c[this]), LaxusQ2_ID, false)
                call BlzStartUnitAbilityCooldown(s__LaxusSpells__LaxusG_KS_c[this], LaxusQ_ID, BlzGetUnitAbilityCooldownRemaining(s__LaxusSpells__LaxusG_KS_c[this], LaxusQ2_ID))
                    call RemoveUnit(s__LaxusSpells__LaxusG_KS_d[this])
                    set s__LaxusSpells__LaxusG_KS_c[this]=null
                    set s__LaxusSpells__LaxusG_KS_d[this]=null
                    set s__LaxusSpells__LaxusG_KS_e[this]=null
                    set s__LaxusSpells__LaxusG_KS_m_LaxusG[i]=s__LaxusSpells__LaxusG_KS_m_LaxusG[s__LaxusSpells__LaxusG_KS_MUI_LaxusG]
                    set s__LaxusSpells__LaxusG_KS_MUI_LaxusG=s__LaxusSpells__LaxusG_KS_MUI_LaxusG - 1
                    if s__LaxusSpells__LaxusG_KS_MUI_LaxusG == - 1 then
                        call LaxusSpells__LaxusTimer03Release()
                    endif
                    call s__LaxusSpells__LaxusG_KS_deallocate(this)
                    set i=i - 1
                endif
                set i=i + 1
            endloop
        endfunction
