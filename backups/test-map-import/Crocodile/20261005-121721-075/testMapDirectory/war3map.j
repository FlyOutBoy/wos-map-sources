                    set s__LaxusSpells__LaxusT_KS_e3[this]=null
                    set s__LaxusSpells__LaxusT_KS_g[this]=null
                    set s__LaxusSpells__LaxusT_KS_u[this]=null
                    set s__LaxusSpells__LaxusT_KS_m_LaxusT[i]=s__LaxusSpells__LaxusT_KS_m_LaxusT[s__LaxusSpells__LaxusT_KS_MUI_LaxusT]
                    set s__LaxusSpells__LaxusT_KS_MUI_LaxusT=s__LaxusSpells__LaxusT_KS_MUI_LaxusT - 1
                    if s__LaxusSpells__LaxusT_KS_MUI_LaxusT == - 1 then
                        call LaxusSpells__LaxusTimer03Release()
                    endif
                    call s__LaxusSpells__LaxusT_KS_deallocate(this)
                    set i=i - 1
                endif
                set i=i + 1
            endloop
        endfunction
        function s__LaxusSpells__LaxusT_KS_LaxusT_Start takes unit NewC returns nothing
            local integer this= s__LaxusSpells__LaxusT_KS__allocate()
            set s__LaxusSpells__LaxusT_KS_MUI_LaxusT=s__LaxusSpells__LaxusT_KS_MUI_LaxusT + 1
            set s__LaxusSpells__LaxusT_KS_m_LaxusT[s__LaxusSpells__LaxusT_KS_MUI_LaxusT]=this
            set s__LaxusSpells__LaxusT_KS_c[this]=NewC
            set s__LaxusSpells__LaxusT_KS_x[this]=GetUnitX(s__LaxusSpells__LaxusT_KS_c[this])
            set s__LaxusSpells__LaxusT_KS_y[this]=GetUnitY(s__LaxusSpells__LaxusT_KS_c[this])
            set s__LaxusSpells__LaxusT_KS_r[this]=0
            set s__LaxusSpells__LaxusT_KS_rmax[this]=2.1
            set s__LaxusSpells__LaxusT_KS_g[this]=CreateGroup()
            set s__LaxusSpells__LaxusT_KS_dmg[this]=GetHeroStr(s__LaxusSpells__LaxusT_KS_c[this], true) * LaxusT_DamageStrBase
            call StartSpellUnit(s__LaxusSpells__LaxusT_KS_c[this])
           call UnitAddAbility(s__LaxusSpells__LaxusT_KS_c[this], 'Avul')
            set s__LaxusSpells__LaxusT_KS_aoe[this]=LaxusT_DamageAoe
            call SetUnitAnimationByIndex(s__LaxusSpells__LaxusT_KS_c[this], 8)
            set s__LaxusSpells__LaxusT_KS_scale[this]=s__LaxusSpells__LaxusT_KS_aoe[this] / 1600
            call SetUnitTimeScale(s__LaxusSpells__LaxusT_KS_c[this], 0.45)
                    call StopSound(gg_snd_Hero_Laxus_T, false, false)
            call StartSound(gg_snd_Hero_Laxus_T)
                //call EUTU2_3(EffectSpawn("war3mapImported\\wos_5731-sl_8bc718f-F.mdl", GetUnitX(c), GetUnitY(c), 1, 0.5, 1.45, 1), 1.5, 1, c)
               // call MyRemoveEff(EffectSpawnScale("war3mapImported\\wos_lb_hg2-E12B5.mdl", GetUnitX(c), GetUnitY(c), GetRandomReal(0, 359), 0.5, 0.01, 30, 0.3, 0.01, 1), 1.5)
            if s__LaxusSpells__LaxusT_KS_MUI_LaxusT == 0 then
                call LaxusSpells__LaxusTimer03Acquire()
            endif
        endfunction

    function s__LaxusSpells__LaxusF_KS_Loop_LaxusF takes nothing returns nothing
        local integer this
        local real rr1
        local real rr2
        local integer k
        local real x1
        local real y1
        local integer i= 0
        loop
            exitwhen i > s__LaxusSpells__LaxusF_KS_MUI_LaxusF
            set this=s__LaxusSpells__LaxusF_KS_m_LaxusF[i]
            if SpellBoolCaster(s__LaxusSpells__LaxusF_KS_c[this]) and s__LaxusSpells__LaxusF_KS_r[this] <= s__LaxusSpells__LaxusF_KS_rmax[this] and SpellBoolCaster(s__LaxusSpells__LaxusF_KS_td[this]) then
                set s__LaxusSpells__LaxusF_KS_r[this]=RoundReal(s__LaxusSpells__LaxusF_KS_r[this] + 0.03 , 3)
                set s__LaxusSpells__LaxusF_KS_a[this]=GAngle(s__LaxusSpells__LaxusF_KS_c[this] , s__LaxusSpells__LaxusF_KS_td[this])
                call SetUnitFacing(s__LaxusSpells__LaxusF_KS_c[this], s__LaxusSpells__LaxusF_KS_a[this] * bj_RADTODEG)
                if s__LaxusSpells__LaxusF_KS_check[this] == 0 then
                    if s__LaxusSpells__LaxusF_KS_r[this] > 0.45 then
                        if SR2(s__LaxusSpells__LaxusF_KS_c[this] , s__LaxusSpells__LaxusF_KS_td[this]) > 160 then
                            set s__LaxusSpells__LaxusF_KS_x[this]=GetUnitX(s__LaxusSpells__LaxusF_KS_c[this])
                            set s__LaxusSpells__LaxusF_KS_y[this]=GetUnitY(s__LaxusSpells__LaxusF_KS_c[this])

                            // Move toward the target with fast lightning-like
                            // oscillation to the left and right.
                            set s__LaxusSpells__LaxusF_KS_zigzagPhase[this]=s__LaxusSpells__LaxusF_KS_zigzagPhase[this] + 0.5
                            call MoveUnit(s__LaxusSpells__LaxusF_KS_c[this] , s__LaxusSpells__LaxusF_KS_move[this] , s__LaxusSpells__LaxusF_KS_a[this] + 60 * Sin(s__LaxusSpells__LaxusF_KS_zigzagPhase[this]) * bj_DEGTORAD)
                            call MoveEff(s__LaxusSpells__LaxusF_KS_e[this] , s__LaxusSpells__LaxusF_KS_move[this] , s__LaxusSpells__LaxusF_KS_a[this] + 60 * Sin(s__LaxusSpells__LaxusF_KS_zigzagPhase[this]) * bj_DEGTORAD)

                            // The original `r2 >= 0.0` was permanently true,
                            // making DecorRemove and two effects run every 0.03.
                            set s__LaxusSpells__LaxusF_KS_r2[this]=s__LaxusSpells__LaxusF_KS_r2[this] + 0.03
                            if s__LaxusSpells__LaxusF_KS_check2[this] == 0 then
                                    call DestroyEffect(EffectSpawn("war3mapImported\\wos_YellowMissile.mdl" , s__LaxusSpells__LaxusF_KS_x[this] , s__LaxusSpells__LaxusF_KS_y[this] , GetRandomReal(0.0, 359.0) , 1.0 , 1.0 , 100.0))
                                    call DestroyEffect(EffectSpawn("war3mapImported\\wos_YellowSpark.mdl" , s__LaxusSpells__LaxusF_KS_x[this] , s__LaxusSpells__LaxusF_KS_y[this] , GetRandomReal(0.0, 359.0) , 1.0 , 1.45 , 100.0))
                                else
                                    call DestroyEffect(EffectSpawn("war3mapImported\\wos_RedMissile.mdl" , s__LaxusSpells__LaxusF_KS_x[this] , s__LaxusSpells__LaxusF_KS_y[this] , GetRandomReal(0.0, 359.0) , 1.0 , 1.0 , 100.0))
                                    call DestroyEffect(EffectSpawn("war3mapImported\\wos_RedSpark.mdl" , s__LaxusSpells__LaxusF_KS_x[this] , s__LaxusSpells__LaxusF_KS_y[this] , GetRandomReal(0.0, 359.0) , 1.0 , 1.45 , 100.0))
                                endif
                            if s__LaxusSpells__LaxusF_KS_r2[this] >= 0.12 then
                                set s__LaxusSpells__LaxusF_KS_r2[this]=0.0
                                call DecorRemove(s__LaxusSpells__LaxusF_KS_c[this] , s__LaxusSpells__LaxusF_KS_x[this] , s__LaxusSpells__LaxusF_KS_y[this] , 350.0 , 20.0)
                                
                            endif
                        else
                            call SetUnitPosition(s__LaxusSpells__LaxusF_KS_c[this], GetUnitX(s__LaxusSpells__LaxusF_KS_td[this]) - 175 * Cos(s__LaxusSpells__LaxusF_KS_a[this]), GetUnitY(s__LaxusSpells__LaxusF_KS_td[this]) - 175 * Sin(s__LaxusSpells__LaxusF_KS_a[this]))
                            call StartSpellUnit2(s__LaxusSpells__LaxusF_KS_td[this])
                            call DestroyEffect(s__LaxusSpells__LaxusF_KS_e[this])
                            set s__LaxusSpells__LaxusF_KS_e[this]=null
                            if s__LaxusSpells__LaxusF_KS_check2[this] == 0 then
                            call MakeSound("war3mapimported\\Hero_Laxus_F2")
                            endif
                            call SetUnitAnimationByIndex(s__LaxusSpells__LaxusF_KS_c[this], 6)
                            call SetUnitTimeScale(s__LaxusSpells__LaxusF_KS_c[this], 1.25)
                            call SetUnitVertexColor(s__LaxusSpells__LaxusF_KS_c[this], 255, 255, 255, 255)
                            set s__LaxusSpells__LaxusF_KS_r[this]=0
                            set s__LaxusSpells__LaxusF_KS_r2[this]=0
                            set s__LaxusSpells__LaxusF_KS_check[this]=1
                        endif
                    endif
                elseif s__LaxusSpells__LaxusF_KS_check[this] == 1 then
                    call DebugUnit2(s__LaxusSpells__LaxusF_KS_td[this])
                    call DebugUnit(s__LaxusSpells__LaxusF_KS_c[this])
                    if s__LaxusSpells__LaxusF_KS_r[this] == 0.6 then
                call DestroyEffect(s__LaxusSpells__LaxusF_KS_e2[this])
                call DestroyEffect(s__LaxusSpells__LaxusF_KS_e3[this])
                    endif
                    if s__LaxusSpells__LaxusF_KS_r[this] == 0.66 then
                        call dmgphys(s__LaxusSpells__LaxusF_KS_c[this] , s__LaxusSpells__LaxusF_KS_td[this] , s__LaxusSpells__LaxusF_KS_dmg[this])
                        call ErzaPassive(s__LaxusSpells__LaxusF_KS_c[this] , s__LaxusSpells__LaxusF_KS_td[this] , 3)
                         call StunUnit(s__LaxusSpells__LaxusF_KS_c[this] , s__LaxusSpells__LaxusF_KS_td[this] , LaxusF_Stun)
                        call MUE(s__LaxusSpells__LaxusF_KS_td[this] , LaxusF_PushRange , LaxusF_PushDuration , s__LaxusSpells__LaxusF_KS_a[this])
                        call MakeSound("war3mapimported\\Hero_Laxus_F3")
                        set s__LaxusSpells__LaxusF_KS_x[this]=GetUnitX(s__LaxusSpells__LaxusF_KS_td[this])
                        set s__LaxusSpells__LaxusF_KS_y[this]=GetUnitY(s__LaxusSpells__LaxusF_KS_td[this])
                        call DecorRemove(s__LaxusSpells__LaxusF_KS_c[this] , s__LaxusSpells__LaxusF_KS_x[this] , s__LaxusSpells__LaxusF_KS_y[this] , 350 , 20)
                        set s__LaxusSpells__LaxusF_KS_r[this]=99999
                        set s__LaxusSpells__LaxusF_KS_x[this]=GetUnitX(s__LaxusSpells__LaxusF_KS_td[this]) + 130 * Cos(s__LaxusSpells__LaxusF_KS_a[this])
                        set s__LaxusSpells__LaxusF_KS_y[this]=GetUnitY(s__LaxusSpells__LaxusF_KS_td[this]) + 130 * Sin(s__LaxusSpells__LaxusF_KS_a[this])
                        if s__LaxusSpells__LaxusF_KS_check2[this] == 0 then
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_YellowBoom.mdx" , s__LaxusSpells__LaxusF_KS_x[this] , s__LaxusSpells__LaxusF_KS_y[this] , 1 , 1.25 , 4 , 110))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_SlamYellow.mdl" , s__LaxusSpells__LaxusF_KS_x[this] , s__LaxusSpells__LaxusF_KS_y[this] , 1 , 1 , 4 , 1))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_YellowMissile.mdl" , s__LaxusSpells__LaxusF_KS_x[this] , s__LaxusSpells__LaxusF_KS_y[this] , 1 , 1 , 4 , 100))
                       call DestroyEffect(EffectSpawn("war3mapImported\\wos_OPm (513)yellow.mdl" , s__LaxusSpells__LaxusF_KS_x[this] , s__LaxusSpells__LaxusF_KS_y[this] , GetRandomReal(0, 359) , 2 , 0.8 , 1))
                            call DestroyEffect(EffectSpawn("war3mapImported\\modelgh (1).mdl" , s__LaxusSpells__LaxusF_KS_x[this] , s__LaxusSpells__LaxusF_KS_y[this] , 0 , 3 , 1.25 , 100))
                    set k=0
                    loop
                        exitwhen k == 6
                        set rr1=GetRandomReal(150, 200)
                        set rr2=GetRandomReal(0, 360) * bj_DEGTORAD
                        set x1=s__LaxusSpells__LaxusF_KS_x[this] + rr1 * Cos(rr2)
                        set y1=s__LaxusSpells__LaxusF_KS_y[this] + rr1 * Sin(rr2)
                        call EffectSpawn2("war3mapImported\\wos_krk (1849)2.mdx" , x1 , y1 , 60 * k , 1 , 1.45 , 75 , 0.5)
                        set k=k + 1
                    endloop
                       call DestroyEffect(EffectSpawn("war3mapImported\\wos_[DoFT]EF501Item.mdl" , s__LaxusSpells__LaxusF_KS_x[this] , s__LaxusSpells__LaxusF_KS_y[this] , GetRandomReal(0, 359) , 0.65 , 3 , 1))
                   else
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_RedBoom.mdx" , s__LaxusSpells__LaxusF_KS_x[this] , s__LaxusSpells__LaxusF_KS_y[this] , 1 , 1.25 , 4 , 110))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_SlamRed.mdl" , s__LaxusSpells__LaxusF_KS_x[this] , s__LaxusSpells__LaxusF_KS_y[this] , 1 , 1 , 4 , 1))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_RedMissile.mdl" , s__LaxusSpells__LaxusF_KS_x[this] , s__LaxusSpells__LaxusF_KS_y[this] , 1 , 1 , 4 , 100))
                       call DestroyEffect(EffectSpawn("war3mapImported\\wos_OPm (513)red.mdl" , s__LaxusSpells__LaxusF_KS_x[this] , s__LaxusSpells__LaxusF_KS_y[this] , GetRandomReal(0, 359) , 2 , 0.8 , 1))
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_modelgh (1)red.mdl" , s__LaxusSpells__LaxusF_KS_x[this] , s__LaxusSpells__LaxusF_KS_y[this] , 0 , 3 , 1.25 , 100))
                    set k=0
