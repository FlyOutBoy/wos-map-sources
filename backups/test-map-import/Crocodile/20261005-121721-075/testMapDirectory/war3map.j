                        call DestroyEffect(EffectSpawnColor("war3mapimported\\wos_gnaden_air.mdl" , s__TakeshiSpells__TakeshiSpells_G_x[this] , s__TakeshiSpells__TakeshiSpells_G_y[this] , GetRandomReal(0, 359) , 0.4 , 1.5 , 1 , 255 , 255 , 255 , 205))
                        call DestroyEffect(EffectSpawnColor("war3mapimported\\wos_gnaden_air.mdl" , s__TakeshiSpells__TakeshiSpells_G_x[this] , s__TakeshiSpells__TakeshiSpells_G_y[this] , GetRandomReal(0, 359) , 0.3 , 2.5 , 1 , 255 , 255 , 255 , 205))
