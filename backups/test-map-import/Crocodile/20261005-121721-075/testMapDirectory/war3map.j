    function SlowUnitErza takes unit c,unit u,integer lvl returns nothing
        local integer i= GetPlayerId(GetOwningPlayer(c))
        if DummyPlayer2[i] == null or GetWidgetLife(DummyPlayer2[i]) < 1 then
            set DummyPlayer2[i]=CreateUnit(Player(i), 'h0C9', GetRectCenterX(gg_rct_Caster), GetRectCenterY(gg_rct_Caster), 0)
            call UnitAddAbility(DummyPlayer2[i], 'A03U')
        endif
        if lvl < 1 then
        set lvl=1
        endif
        if lvl > 0 then
            if GetUnitAbilityLevel(DummyPlayer2[i], 'A03U') == 0 then
                call UnitAddAbility(DummyPlayer2[i], 'A03U')
            endif
            call SetUnitAbilityLevel(DummyPlayer2[i], 'A03U', lvl)
            call SetUnitFacing(DummyPlayer2[i], GAngle(DummyPlayer2[i] , u) * bj_RADTODEG)
            call IssueTargetOrder(DummyPlayer2[i], "slow", u)
        endif
    endfunction
        function s__AAADest___ErzaDebuffs_Loop_ErzaBar takes nothing returns nothing
            local integer this
            local integer i= 0
            local integer phys
            local integer mag
            local integer result
            loop
                exitwhen i > s__AAADest___ErzaDebuffs_MUI_3
                set this=s__AAADest___ErzaDebuffs_m_3[i]
                if GetUnitTypeId(Hero[s__AAADest___ErzaDebuffs_k2[this]]) == s__AAADest___ErzaDebuffs_id[this] then
                    set s__AAADest___ErzaDebuffs_r[this]=s__AAADest___ErzaDebuffs_r[this] + 0.05
                    set s__AAADest___ErzaDebuffs_r[this]=S2R(R2SW(s__AAADest___ErzaDebuffs_r[this], 0, 5))
                    if s__AAADest___ErzaDebuffs_check[this] == 0 then
                        set phys=LoadInteger(hs, GetHandleId(s__AAADest___ErzaDebuffs_c[this]), StringHash("Erza G2 phys"))
                        set mag=LoadInteger(hs, GetHandleId(s__AAADest___ErzaDebuffs_c[this]), StringHash("Erza G2 mag"))
                        set result=phys + mag
                        if result > ErzaG2_ActivateDamageCond then
                            set result=ErzaG2_ActivateDamageCond
                            set s__AAADest___ErzaDebuffs_check[this]=1
                            if s__ErzaG2_Dummy[s__AAADest___ErzaDebuffs_k2[this]] != null then
                                call RemoveUnit(s__ErzaG2_Dummy[s__AAADest___ErzaDebuffs_k2[this]])
                                set s__ErzaG2_Dummy[s__AAADest___ErzaDebuffs_k2[this]]= null
                            endif
                            set s__ErzaG2_Dummy[s__AAADest___ErzaDebuffs_k2[this]]= CreateUnit(GetOwningPlayer(s__AAADest___ErzaDebuffs_c[this]), ErzaG2_DummyID, s__AAADest___ErzaDebuffs_x[this], s__AAADest___ErzaDebuffs_y[this], 0)
                            call MakeSound("war3mapimported\\Hero_Erza_G2_1")
                            if GetLocalPlayer() == Player(s__AAADest___ErzaDebuffs_k2[this]) then
                                call BlzFrameSetVisible(s___AAADest___ErzaDebuffs_frame2_pas8[s__AAADest___ErzaDebuffs_frame2_pas8[this]+s__AAADest___ErzaDebuffs_k2[this]], true)
