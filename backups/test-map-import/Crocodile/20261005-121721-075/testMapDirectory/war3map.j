                if s__TakeshiSpells__TakeshiSpells_G_MUI_TakeshiGF == - 1 then
                    call PauseTimer(s__TakeshiSpells__TakeshiSpells_G_t_TakeshiGF)
                endif
                call s__TakeshiSpells__TakeshiSpells_G_deallocate(this)
            endif
            set i=i + 1
