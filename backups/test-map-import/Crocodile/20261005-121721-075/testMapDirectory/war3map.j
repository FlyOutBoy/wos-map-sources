    function NatsuPas_Start takes unit c returns nothing
        call s__NatsuSpells___NatsuPas_KS_NatsuPas_Start(c)
    endfunction
    function NatsuF_Start takes unit c returns nothing
        local group g= CreateGroup()
        local unit u
        local real x= GetUnitX(c)
        local real y= GetUnitY(c)
        local real aoe= NatsuF_AoeSearch
        call GroupClear(g)
        call GroupEnumUnitsInRange(g, x, y, aoe, null)
        loop
            set u=FirstOfGroup(g)
            exitwhen u == null
            if IsUnitAlly(u, GetOwningPlayer(c)) and GetWidgetLife(u) > 1 and IsUnitIllusion(u) == false and GetUnitTypeId(u) == Natsu_ID and GetHeroLevel(u) >= NatsuF_LvlCheck then
                if IntegerCd(u , "pas f" , NatsuF_Cd) then
                call s__GearSystems2___KS_FakeCooldown_FakeCD_Start1((u ) , ( NatsuF_ID ) , (( NatsuF_Cd )*1.0) , ( StringHash("pas f") ) , ( 0)) // INLINED!!
                    call s__NatsuSpells___NatsuPas_KS_NatsuPas_Start((u)) // INLINED!!
                endif
            endif
            call GroupRemoveUnit(g, u)
        endloop
        call DestroyGroup(g)
        set g=null
        set u=null
    endfunction
