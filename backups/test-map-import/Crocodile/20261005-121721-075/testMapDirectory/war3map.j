    function HarribelE_Start takes unit c returns nothing
        if LoadInteger(hs, GetHandleId(GetOwningPlayer(c)), StringHash("morph e")) == 0 then
            call s__HarribelSpells__HarribelSpells_E_HarribelE_Start(c)
        endif
    endfunction
