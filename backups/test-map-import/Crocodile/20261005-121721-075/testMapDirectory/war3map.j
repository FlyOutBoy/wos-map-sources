                                call SetUnitAnimationByIndex(s__InoriSpells___InoriQ_KS_c[this], 3)
                                call DestroyEffect(EffectSpawn("war3mapImported\\wos_Alucard bulletfire.mdl" , s__InoriSpells___InoriQ_KS_x1[this] + 35 * Cos(s__InoriSpells___InoriQ_KS_a[this]) , s__InoriSpells___InoriQ_KS_y1[this] + 35 * Sin(s__InoriSpells___InoriQ_KS_a[this]) , s__InoriSpells___InoriQ_KS_a[this] * bj_RADTODEG , 1 , 3 , 100))
