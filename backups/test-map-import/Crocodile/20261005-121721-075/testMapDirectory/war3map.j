            local real lengthAngle= s__AinzSpells__AinzE_KS_a[this] + bj_PI * 0.50
            local real localLength= dx * Cos(lengthAngle) + dy * Sin(lengthAngle)
            local real localWidth= dx * Cos(s__AinzSpells__AinzE_KS_a[this]) + dy * Sin(s__AinzSpells__AinzE_KS_a[this])
            // Length is perpendicular to the caster-to-target direction.
            return localLength >= - AinzE_RectLength * 0.50 and localLength <= AinzE_RectLength * 0.50 and localWidth >= - AinzE_RectWidth * 0.50 and localWidth <= AinzE_RectWidth * 0.50
