        function s__TomiokaSpells___TomiokaQ_KS_Loop_TomiokaQ takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__TomiokaSpells___TomiokaQ_KS_MUI_TomiokaQ
                set this=s__TomiokaSpells___TomiokaQ_KS_m_TomiokaQ[i]
                if SpellBoolCaster(s__TomiokaSpells___TomiokaQ_KS_c[this]) and SpellBoolCaster(s__TomiokaSpells___TomiokaQ_KS_td[this]) and s__TomiokaSpells___TomiokaQ_KS_r[this] <= s__TomiokaSpells___TomiokaQ_KS_rmax[this] then
                    set s__TomiokaSpells___TomiokaQ_KS_r[this]=s__TomiokaSpells___TomiokaQ_KS_r[this] + 0.03
                    call DebugUnit2(s__TomiokaSpells___TomiokaQ_KS_c[this])
                    if s__TomiokaSpells___TomiokaQ_KS_r[this] == 0.45 then
                    call MakeSound("war3mapimported\\Hero_Tomioka_Q2")
                        call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_tx-ha_nitu.mdl" , GetUnitX(s__TomiokaSpells___TomiokaQ_KS_c[this]) , GetUnitY(s__TomiokaSpells___TomiokaQ_KS_c[this]) , s__TomiokaSpells___TomiokaQ_KS_a[this] * bj_RADTODEG , 2 , 1.25 , 1 , 255 , 255 , 255 , 255))
                    endif
                    if s__TomiokaSpells___TomiokaQ_KS_r[this] > 0.45 then
                        if SR2(s__TomiokaSpells___TomiokaQ_KS_c[this] , s__TomiokaSpells___TomiokaQ_KS_td[this]) > 120 then
                            set s__TomiokaSpells___TomiokaQ_KS_a[this]=GAngle(s__TomiokaSpells___TomiokaQ_KS_c[this] , s__TomiokaSpells___TomiokaQ_KS_td[this])
                            call MoveUnit(s__TomiokaSpells___TomiokaQ_KS_c[this] , s__TomiokaSpells___TomiokaQ_KS_move[this] , s__TomiokaSpells___TomiokaQ_KS_a[this])
                            call SetUnitFacing(s__TomiokaSpells___TomiokaQ_KS_c[this], s__TomiokaSpells___TomiokaQ_KS_a[this] * bj_RADTODEG)
                        else
                            set s__TomiokaSpells___TomiokaQ_KS_x[this]=GetUnitX(s__TomiokaSpells___TomiokaQ_KS_td[this])
