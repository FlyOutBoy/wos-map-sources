        set s__KenjakuSpells___KenjakuSummon_KS_y[this]=GetUnitY(s__KenjakuSpells___KenjakuSummon_KS_d[this])
        call StartSpellUnit(s__KenjakuSpells___KenjakuSummon_KS_d[this])
