                                endif
            call SaveInteger(hs, GetHandleId(s__OkarunSpells__OkarunQ_KS_c[this]), StringHash("spell p"), 1)
            set s__OkarunSpells__OkarunQ_KS_a[this]=GAngle2(s__OkarunSpells__OkarunQ_KS_c[this] , s__OkarunSpells__OkarunQ_KS_x[this] , s__OkarunSpells__OkarunQ_KS_y[this]) // Angle Between points
