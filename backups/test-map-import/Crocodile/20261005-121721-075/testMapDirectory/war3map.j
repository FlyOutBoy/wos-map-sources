            call DecorRemove(s__AstaSpells__AstaSpells_R_c[this] , s__AstaSpells__AstaSpells_R_x[this] , s__AstaSpells__AstaSpells_R_y[this] , s__AstaSpells__AstaSpells_R_aoe[this] , 100)
