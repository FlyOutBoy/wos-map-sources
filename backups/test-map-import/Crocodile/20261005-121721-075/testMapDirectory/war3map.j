                            if s__RaidenSpells___RaidenQ_KS_r[this] == s__RaidenSpells___RaidenQ_KS_r_prepare[this] - 0.03 then
                                call SetUnitTimeScale(s__RaidenSpells___RaidenQ_KS_c[this], 1)
                                call SetUnitAnimationByIndex(s__RaidenSpells___RaidenQ_KS_c[this], 40)
                                call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_tx-ha_nitu.mdl" , GetUnitX(s__RaidenSpells___RaidenQ_KS_c[this]) , GetUnitY(s__RaidenSpells___RaidenQ_KS_c[this]) , s__RaidenSpells___RaidenQ_KS_a[this] * bj_RADTODEG , 2 , 1.25 , 1 , 255 , 255 , 255 , 225))
                            endif
