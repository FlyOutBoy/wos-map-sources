function GetLevelPas3Check takes unit c returns integer
local integer k= 0
local integer lvl= GetHeroLevel(c)
if lvl >= 35 then
set k=3
elseif lvl >= 25 then
set k=2
elseif lvl >= 12 then
set k=1
endif
return k
endfunction



