                        set s__PatriotSpells__PatriotSpells_Q_e[this]=EffectSpawn4("war3mapImported\\wos_PatriotsSpear.mdx" , GetUnitX(s__PatriotSpells__PatriotSpells_Q_c[this]) + 150 * Cos(s__PatriotSpells__PatriotSpells_Q_a[this]) , GetUnitY(s__PatriotSpells__PatriotSpells_Q_c[this]) + 150 * Sin(s__PatriotSpells__PatriotSpells_Q_a[this]) , s__PatriotSpells__PatriotSpells_Q_a[this] * bj_RADTODEG , 0.65 , 1 , 155 , - 20)
