                set s__TakeshiSpells__TakeshiSpells_G_m_TakeshiGF[i]=s__TakeshiSpells__TakeshiSpells_G_m_TakeshiGF[s__TakeshiSpells__TakeshiSpells_G_MUI_TakeshiGF]
