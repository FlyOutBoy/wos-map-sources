                            else
                                set s__ErzaQSpells___ErzaQ_KS_r2[this]=s__ErzaQSpells___ErzaQ_KS_r2[this] + 0.03
                            endif
                          endif
                        endif
                        if SR3(s__ErzaQSpells___ErzaQ_KS_c[this] , s__ErzaQSpells___ErzaQ_KS_x[this] , s__ErzaQSpells___ErzaQ_KS_y[this]) < 120 then
