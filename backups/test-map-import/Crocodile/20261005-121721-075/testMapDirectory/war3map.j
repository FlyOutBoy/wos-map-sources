                set i=i + 1
            endloop
        endfunction

        function s__AinzSpells__AinzTR_KS_AinzTR_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__AinzSpells__AinzTR_KS__allocate()
            local integer level= GetUnitAbilityLevel(NewC, AinzR_ID)
            if level < 1 then
                set level=1
            endif
            set s__AinzSpells__AinzTR_KS_c[this]=NewC
            set s__AinzSpells__AinzTR_KS_x[this]=GetUnitX(s__AinzSpells__AinzTR_KS_c[this])
            set s__AinzSpells__AinzTR_KS_y[this]=GetUnitY(s__AinzSpells__AinzTR_KS_c[this])
            set s__AinzSpells__AinzTR_KS_a[this]=GAngle2(s__AinzSpells__AinzTR_KS_c[this] , NewX , NewY)
            set s__AinzSpells__AinzTR_KS_r[this]=0.00
            set s__AinzSpells__AinzTR_KS_r2[this]=0.00
            set s__AinzSpells__AinzTR_KS_r3[this]=0.00
            set s__AinzSpells__AinzTR_KS_front[this]=AinzTR_StartRange
            set s__AinzSpells__AinzTR_KS_lastFront[this]=0.00
            set s__AinzSpells__AinzTR_KS_dmg[this]=GetHeroInt(s__AinzSpells__AinzTR_KS_c[this], true) * ( AinzTR_DamageIntBase + AinzTR_DamageIntStep * ( level - 1 ) )
            set s__AinzSpells__AinzTR_KS_g[this]=CreateGroup()
            set s__AinzSpells__AinzTR_KS_g2[this]=CreateGroup()
            set s__AinzSpells__AinzTR_KS_g3[this]=CreateGroup()
            set s__AinzSpells__AinzTR_KS_u[this]=null
            set s__AinzSpells__AinzTR_KS_e[this]=AddSpecialEffect(AinzTR_EffectModel, s__AinzSpells__AinzTR_KS_x[this] + 250.00 * Cos(s__AinzSpells__AinzTR_KS_a[this]), s__AinzSpells__AinzTR_KS_y[this] + 250.00 * Sin(s__AinzSpells__AinzTR_KS_a[this]))
            call BlzSetSpecialEffectYaw(s__AinzSpells__AinzTR_KS_e[this], s__AinzSpells__AinzTR_KS_a[this])
            call BlzSetSpecialEffectScale(s__AinzSpells__AinzTR_KS_e[this], 0.10)
            call BlzSetSpecialEffectTimeScale(s__AinzSpells__AinzTR_KS_e[this], 0.85)
            call BlzSetUnitFacingEx(s__AinzSpells__AinzTR_KS_c[this], s__AinzSpells__AinzTR_KS_a[this] * bj_RADTODEG)
            set s__AinzSpells__AinzTR_KS_scale[this]=0.5
                    call StartSpellUnit2(s__AinzSpells__AinzTR_KS_c[this])
            call SetUnitAnimationByIndex(s__AinzSpells__AinzTR_KS_c[this], 10)
            call SetUnitTimeScale(s__AinzSpells__AinzTR_KS_c[this], 0.75)

            call MakeSound("war3mapimported\\Hero_Ainz_TR2")
            set s__AinzSpells__AinzTR_KS_MUI_AinzTR=s__AinzSpells__AinzTR_KS_MUI_AinzTR + 1
            set s__AinzSpells__AinzTR_KS_m_AinzTR[s__AinzSpells__AinzTR_KS_MUI_AinzTR]=this
            if s__AinzSpells__AinzTR_KS_MUI_AinzTR == 0 then
                call AinzSpells__AinzTimer03Acquire()
            endif
        endfunction


        // Перед наложением новой стадии удаляем только старые рабочие F-баффы.
        // AinzF_Buff0_ID ('B02I') не трогаем: это отдельный служебный бафф.
        // Благодаря этому на Аинзе одновременно остаётся только одна рабочая стадия.
        function s__AinzSpells__AinzF_KS_ClearBuffs takes unit whichUnit returns nothing
            call UnitRemoveAbility(whichUnit, AinzF_Buff1_ID)
            call UnitRemoveAbility(whichUnit, AinzF_Buff2_ID)
            call UnitRemoveAbility(whichUnit, AinzF_Buff3_ID)
            call UnitRemoveAbility(whichUnit, AinzF_Buff4_ID)
            call UnitRemoveAbility(whichUnit, AinzF_Buff5_ID)
            call UnitRemoveAbility(whichUnit, AinzF_Buff6_ID)
        endfunction

        function s__AinzSpells__AinzF_KS_SetQ2Mode takes unit whichUnit,boolean enabled returns nothing
            if enabled then
                call AinzSpells__AinzSwapPatch(whichUnit , AinzQ_ID , 0)
                call s__GearSystems2___KS_SpellTimer_SpellTimer_Timer_Start((whichUnit ) , (( AinzF_Q2Duration )*1.0) , ( AinzQ2_ID ) , ( AinzQ_ID) , 0) // INLINED!!
                call SetUnitAbilityLevel(whichUnit, AinzQ2_ID, GetUnitAbilityLevel(whichUnit, AinzQ_ID))
                if LoadInteger(hs, GetHandleId(whichUnit), StringHash("mode t")) == 1 then
                    call SetPlayerAbilityAvailable(GetOwningPlayer(whichUnit), AinzQ_ID, false)
                    call SetPlayerAbilityAvailable(GetOwningPlayer(whichUnit), AinzQ2_ID, false)
                    call SetPlayerAbilityAvailable(GetOwningPlayer(whichUnit), AinzQ3_ID, true)
                endif
            else
                if LoadInteger(hs, GetHandleId(whichUnit), StringHash("mode t")) == 0 then
                call AinzSpells__AinzFinishSwap(whichUnit , AinzQ_ID)
                call SetPlayerAbilityAvailable(GetOwningPlayer(whichUnit), AinzQ_ID, LoadInteger(hs, GetHandleId(whichUnit), StringHash("mode t")) == 0)
                call SetPlayerAbilityAvailable(GetOwningPlayer(whichUnit), AinzQ2_ID, false)
                if LoadInteger(hs, GetHandleId(whichUnit), StringHash("mode t")) == 0 then
                    call s__KS_SpellStacks_ResumeStacks((whichUnit) , false) // INLINED!!
                endif
                endif
            endif
        endfunction

        function s__AinzSpells__AinzF_KS_Loop_AinzF takes nothing returns nothing
            local integer this
            local integer i= 0
            local boolean remove
            loop
                exitwhen i > s__AinzSpells__AinzF_KS_MUI_AinzF
                set this=s__AinzSpells__AinzF_KS_m_AinzF[i]
                set remove=false
                if s__AinzSpells__AinzF_KS_phase[this] == 0 then
                    if SpellBoolCaster(s__AinzSpells__AinzF_KS_c[this]) and GetUnitCurrentOrder(s__AinzSpells__AinzF_KS_c[this]) == OrderId(AinzF_ChannelOrder) then
                        set s__AinzSpells__AinzF_KS_r[this]=RoundReal(s__AinzSpells__AinzF_KS_r[this] + 0.03 , 3)
                        if s__AinzSpells__AinzF_KS_r[this] == 0.30 then
                            call s__AinzSpells__AinzF_KS_ClearBuffs(s__AinzSpells__AinzF_KS_c[this])
                            call BuffUnit01(s__AinzSpells__AinzF_KS_c[this] , s__AinzSpells__AinzF_KS_c[this] , AinzF_BuffSpell_ID , AinzF_BuffOrder , 2)
