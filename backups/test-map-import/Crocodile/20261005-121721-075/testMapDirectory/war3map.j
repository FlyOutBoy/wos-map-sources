    //----------------------------Erza-----------------------------------------------
      
    function Erza4Q_Start takes unit c,unit td returns nothing
        call s__ErzaRSpells___Erza4Q_KS_ErzaQ_Start(c , td)
    endfunction
    function Erza4F_Start takes unit c returns nothing
        local integer counter1= 0
        local integer counter2= 0
        local unit u= null
        local integer k1= 0
        local integer k2= 0
        local real x= GetUnitX(c)
        local real y= GetUnitY(c)
        local group g= CreateGroup()
        local real x1= LoadReal(hs, GetHandleId(GetOwningPlayer(c)), StringHash("fire x"))
        local real y1= LoadReal(hs, GetHandleId(GetOwningPlayer(c)), StringHash("fire y"))
        local real x2= LoadReal(hs, GetHandleId(GetOwningPlayer(c)), StringHash("lightning x"))
        local real y2= LoadReal(hs, GetHandleId(GetOwningPlayer(c)), StringHash("lightning y"))
        local real x3= LoadReal(hs, GetHandleId(GetOwningPlayer(c)), StringHash("water x"))
        local real y3= LoadReal(hs, GetHandleId(GetOwningPlayer(c)), StringHash("water y"))
        if x1 != 0 and SR3(c , x1 , y1) <= Erza1R_DamageAoe then
            if counter1 == 0 then
                set counter1=1
            elseif counter2 == 0 then
                set counter2=1
            endif
        endif
        if x2 != 0 and SR3(c , x2 , y2) <= Erza3W_Aoe then
            if counter1 == 0 then
                set counter1=2
            elseif counter2 == 0 then
                set counter2=2
            endif
        endif
        if x3 != 0 and SR3(c , x3 , y3) <= Erza2W_Aoe then
            if counter1 == 0 then
                set counter1=3
            elseif counter2 == 0 then
                set counter2=3
            endif
        endif
        call GroupEnumUnitsInRange(g, x, y, 30000, NoDecor_Cond)
        loop
            set u=FirstOfGroup(g)
            exitwhen u == null
            if IsUnitAlly(u, GetOwningPlayer(c)) then
                if GetUnitTypeId(u) == Gray_ID1 or GetUnitTypeId(u) == Gray_ID2 then
                    set k1=k1 + 1
                endif
                if GetUnitTypeId(u) == Natsu_ID then
                    set k2=k2 + 1
                endif
            endif
            call GroupRemoveUnit(g, u)
        endloop
        call DestroyGroup(g)
        if k1 > 0 and k2 > 0 then
            set counter1=0
            set counter2=0
        endif
        call s__ErzaRSpells___Erza4F_KS_ErzaF_Start(c , counter1 , counter2)
        set g=null
        set u=null
    endfunction
    function Erza4W_Start takes unit c,real x,real y returns nothing
        call s__ErzaRSpells___Erza4W_KS_ErzaW_Start(c , x , y)
    endfunction
    function Erza4E_Start takes unit c returns nothing
        call s__ErzaRSpells___Erza4E_KS_ErzaE_Start(c)
    endfunction
    function Erza4R_Start takes unit c,unit td returns nothing
        call s__ErzaRSpells___Erza4R_KS_ErzaR_Start(c , td)
    endfunction
    function Erza4T_Start takes unit c,unit td returns nothing
        call s__ErzaRSpells___Erza4T_KS_ErzaT_Start(c , td)
    endfunction

//library ErzaRSpells ends
//library ErzaTSpells:
     

        function ErzaTSpells___PassiveType takes integer check2,integer check3 returns integer
            local integer check4= 0
            if check2 > 0 and check3 > 0 then
                if check2 == 1 and check3 == 2 then
                    set check4=4
                endif
                if check2 == 1 and check3 == 3 then
                    set check4=5
