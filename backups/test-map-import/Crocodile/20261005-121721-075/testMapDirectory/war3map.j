call PosUnit(c , x , y)
 call DestroyEffect(EffectSpawn("war3mapImported\\wos_Mdx_Effect_MirrorImage_Black.mdx" , GetUnitX(c) , GetUnitY(c) , GetUnitFacing(c) , 1.5 , 1.8 , 0))
 endif
