                        set x1=s__LaxusSpells__LaxusF_KS_x[this] + rr1 * Cos(rr2)
                        set y1=s__LaxusSpells__LaxusF_KS_y[this] + rr1 * Sin(rr2)
                        call EffectSpawn2("war3mapImported\\wos_krk (1849)4.mdx" , x1 , y1 , 60 * k , 1 , 1.45 , 75 , 0.5)
                        set k=k + 1
                    endloop
                   call DestroyEffect(EffectSpawn("war3mapImported\\wos_OPm (434)3small.mdl" , s__LaxusSpells__LaxusF_KS_x[this] , s__LaxusSpells__LaxusF_KS_y[this] , GetRandomReal(0, 359) , 1 , 3 , 145))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_ZarakiWCrack2.mdx" , s__LaxusSpells__LaxusF_KS_x[this] , s__LaxusSpells__LaxusF_KS_y[this] , GetRandomReal(0, 359) , 1 , 3 , 0))

                   endif

                   endif
                endif
            else
                if s__LaxusSpells__LaxusF_KS_check[this] == 1 then
                    call StopSpellUnit2(s__LaxusSpells__LaxusF_KS_td[this])
                endif
                call DestroyEffect(s__LaxusSpells__LaxusF_KS_e[this])
                call DestroyEffect(s__LaxusSpells__LaxusF_KS_e2[this])
                call DestroyEffect(s__LaxusSpells__LaxusF_KS_e3[this])
                call StopSpellUnit(s__LaxusSpells__LaxusF_KS_c[this])
                call SetUnitTimeScale(s__LaxusSpells__LaxusF_KS_c[this], 1)
                call SetUnitVertexColor(s__LaxusSpells__LaxusF_KS_c[this], 255, 255, 255, 255)
                set s__LaxusSpells__LaxusF_KS_c[this]=null
                set s__LaxusSpells__LaxusF_KS_td[this]=null
                set s__LaxusSpells__LaxusF_KS_e[this]=null
                set s__LaxusSpells__LaxusF_KS_e2[this]=null
                set s__LaxusSpells__LaxusF_KS_e3[this]=null
                set s__LaxusSpells__LaxusF_KS_m_LaxusF[i]=s__LaxusSpells__LaxusF_KS_m_LaxusF[s__LaxusSpells__LaxusF_KS_MUI_LaxusF]
                set s__LaxusSpells__LaxusF_KS_MUI_LaxusF=s__LaxusSpells__LaxusF_KS_MUI_LaxusF - 1
                if s__LaxusSpells__LaxusF_KS_MUI_LaxusF == - 1 then
                    call LaxusSpells__LaxusTimer03Release()
                endif
                call s__LaxusSpells__LaxusF_KS_deallocate(this)
                set i=i - 1
            endif
            set i=i + 1
        endloop
    endfunction
    function s__LaxusSpells__LaxusF_KS_LaxusF_Start takes unit NewC,unit NewTd returns nothing
        local integer this= s__LaxusSpells__LaxusF_KS__allocate()
