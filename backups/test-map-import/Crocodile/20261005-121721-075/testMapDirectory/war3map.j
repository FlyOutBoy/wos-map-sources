    function s__MilimSpells___MilimRProjectileKS_Loop_MilimRProjectile takes nothing returns nothing
        local integer this
        local integer i= 0
        local real progress
        local real ellipseProgress
        local real ellipseOffset
        local real oldX
        local real oldY
        local real x
        local real y
        local integer sharedGroupId
        local integer remainingProjectiles

        loop
            exitwhen i > s__MilimSpells___MilimRProjectileKS_MUI_MilimRProjectile
            set this=s__MilimSpells___MilimRProjectileKS_m_MilimRProjectile[i]

            if s__MilimSpells___MilimRProjectileKS_check[this] == 0 then
                set s__MilimSpells___MilimRProjectileKS_r[this]=s__MilimSpells___MilimRProjectileKS_r[this] + 0.03
                if s__MilimSpells___MilimRProjectileKS_r[this] > s__MilimSpells___MilimRProjectileKS_rmax[this] then
                    set s__MilimSpells___MilimRProjectileKS_r[this]=s__MilimSpells___MilimRProjectileKS_rmax[this]
                endif

                set progress=s__MilimSpells___MilimRProjectileKS_r[this] / s__MilimSpells___MilimRProjectileKS_rmax[this]

                // Iieiaeia yeeeina: noa?o e oeieo niaiaaa?o n caaaiiuie oi?eaie,
                // a arcSide auae?aao cae?oaeaiea ia +90 eee -90 a?aaonia.
                set ellipseProgress=0.50 - 0.50 * Cos(bj_PI * progress)
                set ellipseOffset=Sin(bj_PI * progress) * s__MilimSpells___MilimRProjectileKS_arcSize[this] * s__MilimSpells___MilimRProjectileKS_arcSide[this]
                set oldX=s__MilimSpells___MilimRProjectileKS_currentX[this]
                set oldY=s__MilimSpells___MilimRProjectileKS_currentY[this]
                set s__MilimSpells___MilimRProjectileKS_currentX[this]=s__MilimSpells___MilimRProjectileKS_startX[this] + ( s__MilimSpells___MilimRProjectileKS_targetX[this] - s__MilimSpells___MilimRProjectileKS_startX[this] ) * ellipseProgress + ellipseOffset * Cos(s__MilimSpells___MilimRProjectileKS_a[this] + 90.00 * bj_DEGTORAD)
                set s__MilimSpells___MilimRProjectileKS_currentY[this]=s__MilimSpells___MilimRProjectileKS_startY[this] + ( s__MilimSpells___MilimRProjectileKS_targetY[this] - s__MilimSpells___MilimRProjectileKS_startY[this] ) * ellipseProgress + ellipseOffset * Sin(s__MilimSpells___MilimRProjectileKS_a[this] + 90.00 * bj_DEGTORAD)

                call BlzSetSpecialEffectPosition(s__MilimSpells___MilimRProjectileKS_e[this], s__MilimSpells___MilimRProjectileKS_currentX[this], s__MilimSpells___MilimRProjectileKS_currentY[this], s__MilimSpells___MilimRProjectileKS_fly[this])
                call BlzSetSpecialEffectYaw(s__MilimSpells___MilimRProjectileKS_e[this], Atan2(s__MilimSpells___MilimRProjectileKS_currentY[this] - oldY, s__MilimSpells___MilimRProjectileKS_currentX[this] - oldX))
                call BlzSetSpecialEffectPosition(s__MilimSpells___MilimRProjectileKS_e2[this], s__MilimSpells___MilimRProjectileKS_currentX[this], s__MilimSpells___MilimRProjectileKS_currentY[this], s__MilimSpells___MilimRProjectileKS_fly[this])
                call BlzSetSpecialEffectYaw(s__MilimSpells___MilimRProjectileKS_e2[this], Atan2(s__MilimSpells___MilimRProjectileKS_currentY[this] - oldY, s__MilimSpells___MilimRProjectileKS_currentX[this] - oldX))

                if s__MilimSpells___MilimRProjectileKS_r[this] >= s__MilimSpells___MilimRProjectileKS_rmax[this] then
                    call BlzSetSpecialEffectScale(s__MilimSpells___MilimRProjectileKS_e[this], 0.001)
                    call DestroyEffect(s__MilimSpells___MilimRProjectileKS_e[this])
                    set s__MilimSpells___MilimRProjectileKS_e[this]=null
                    call DestroyEffect(s__MilimSpells___MilimRProjectileKS_e2[this])
                    set s__MilimSpells___MilimRProjectileKS_e2[this]=null
                    set s__MilimSpells___MilimRProjectileKS_currentX[this]=s__MilimSpells___MilimRProjectileKS_targetX[this]
                    set s__MilimSpells___MilimRProjectileKS_currentY[this]=s__MilimSpells___MilimRProjectileKS_targetY[this]

                    // CAOU?EA: yooaeo a oi?ea i?ecaieaiey nia?yaa.
                    set s__MilimSpells___MilimRProjectileKS_e3[this]=EffectSpawn("war3mapImported\\file00000417.mdl" , s__MilimSpells___MilimRProjectileKS_targetX[this] , s__MilimSpells___MilimRProjectileKS_targetY[this] , GetRandomReal(0, 359) , 1.00 , GetRandomReal(1.8, 3.25) , GetRandomReal(125, 400))
                    set s__MilimSpells___MilimRProjectileKS_check[this]=1
                    set s__MilimSpells___MilimRProjectileKS_r[this]=0.00
                endif
            else
                set s__MilimSpells___MilimRProjectileKS_r[this]=s__MilimSpells___MilimRProjectileKS_r[this] + 0.03
                if s__MilimSpells___MilimRProjectileKS_r[this] == 0.15 and IntegerCd(s__MilimSpells___MilimRProjectileKS_c[this] , "cd exp" , 2) then
                call MakeSound("war3mapimported\\Hero_Milim_R 4")
                endif
                if s__MilimSpells___MilimRProjectileKS_r[this] >= 0.30 then
                    call DestroyEffect(s__MilimSpells___MilimRProjectileKS_e3[this])
                    set s__MilimSpells___MilimRProjectileKS_e3[this]=null
                    set x=s__MilimSpells___MilimRProjectileKS_targetX[this]
                    set y=s__MilimSpells___MilimRProjectileKS_targetY[this]

                    // Aecoaeuiue ac?ua nicaa?o oieuei i?ino?ainoaaiii ?acian?iiua nia?yau.
                    // I?iaa?ea o?iia ie?a auiieiyaony o anao nia?yaia aac enee??aiey.
                    if s__MilimSpells___MilimRProjectileKS_showExplosionFx[this] then
                        call DestroyEffect(EffectSpawn("war3mapimported\\by_wood_eff_sel_elp_qiuxingbaozha.mdl" , x , y , GetRandomReal(0, 359) , GetRandomReal(1, 1.35) , GetRandomReal(4.00, 6.50) , 0))
                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_afb (2080).mdl" , x , y , s__MilimSpells___MilimRProjectileKS_a[this] * bj_RADTODEG , 0.85 , 1.9 , 1))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_YC_CrossFlash.mdl" , x + 25 * Cos(s__MilimSpells___MilimRProjectileKS_a[this]) , y + 25 * Sin(s__MilimSpells___MilimRProjectileKS_a[this]) , 0 , 0.5 , 2.94 , GetRandomReal(200, 450)))
                    endif

                    call DecorRemove(s__MilimSpells___MilimRProjectileKS_c[this] , s__MilimSpells___MilimRProjectileKS_targetX[this] , s__MilimSpells___MilimRProjectileKS_targetY[this] , MilimR_DamageAoe , 40)
                    call GroupEnumUnitsInRange(s__MilimSpells___MilimRProjectileKS_g[this], s__MilimSpells___MilimRProjectileKS_targetX[this], s__MilimSpells___MilimRProjectileKS_targetY[this], MilimR_DamageAoe, NoDecor_Cond)
                    loop
                        set s__MilimSpells___MilimRProjectileKS_u[this]=FirstOfGroup(s__MilimSpells___MilimRProjectileKS_g[this])
                        exitwhen s__MilimSpells___MilimRProjectileKS_u[this] == null
                        if SpellBool(s__MilimSpells___MilimRProjectileKS_u[this]) and IsUnitEnemy(s__MilimSpells___MilimRProjectileKS_u[this], GetOwningPlayer(s__MilimSpells___MilimRProjectileKS_c[this])) and not IsUnitInGroup(s__MilimSpells___MilimRProjectileKS_u[this], s__MilimSpells___MilimRProjectileKS_g2[this]) then
                            call GroupAddUnit(s__MilimSpells___MilimRProjectileKS_g2[this], s__MilimSpells___MilimRProjectileKS_u[this])
                            call dmgmag(s__MilimSpells___MilimRProjectileKS_c[this] , s__MilimSpells___MilimRProjectileKS_u[this] , s__MilimSpells___MilimRProjectileKS_dmg[this])
                            call SlowUnit(s__MilimSpells___MilimRProjectileKS_c[this] , s__MilimSpells___MilimRProjectileKS_u[this] , MilimR_Slow , MilimR_SlowDuration)
                        endif
                        call GroupRemoveUnit(s__MilimSpells___MilimRProjectileKS_g[this], s__MilimSpells___MilimRProjectileKS_u[this])
                    endloop

