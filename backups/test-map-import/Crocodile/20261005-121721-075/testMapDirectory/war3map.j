                                set s__FrierenSpells__FrierenSpells_E_td[this]=s__FrierenSpells__FrierenSpells_E_u[this]
                                exitwhen true
                            endif
                        endloop
                        if s__FrierenSpells__FrierenSpells_E_td[this] != null then
    // Столб гарантированно появляется прямо в позиции новой цели.
                            set s__FrierenSpells__FrierenSpells_E_x[this]=GetUnitX(s__FrierenSpells__FrierenSpells_E_td[this])
                            set s__FrierenSpells__FrierenSpells_E_y[this]=GetUnitY(s__FrierenSpells__FrierenSpells_E_td[this])
                        else
                            set tries=0
