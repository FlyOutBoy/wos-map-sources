                        //call DestroyEffect(EffectSpawn("war3mapImported\\wos_corpse explosion.mdl", x + r5 * Cos(a2), y + r5 * Sin(a2), 0, 1.5, 2.15, 0))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_corpse explosion.mdl" , s__AlucardSpells__AlucardSpells_T_x[this] + s__AlucardSpells__AlucardSpells_T_r5[this] * Cos(s__AlucardSpells__AlucardSpells_T_a2[this] + 15 * bj_DEGTORAD) , s__AlucardSpells__AlucardSpells_T_y[this] + s__AlucardSpells__AlucardSpells_T_r5[this] * Sin(s__AlucardSpells__AlucardSpells_T_a2[this] + 15 * bj_DEGTORAD) , 0 , 2. , 2.75 , 0))
                        set s__AlucardSpells__AlucardSpells_T_a2[this]=s__AlucardSpells__AlucardSpells_T_a2[this] + 90 * bj_DEGTORAD
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_corpse explosion.mdl" , s__AlucardSpells__AlucardSpells_T_x[this] + s__AlucardSpells__AlucardSpells_T_r5[this] * Cos(s__AlucardSpells__AlucardSpells_T_a2[this] - 15 * bj_DEGTORAD) , s__AlucardSpells__AlucardSpells_T_y[this] + s__AlucardSpells__AlucardSpells_T_r5[this] * Sin(s__AlucardSpells__AlucardSpells_T_a2[this] - 15 * bj_DEGTORAD) , 0 , 2. , 2.75 , 0))
                        //call DestroyEffect(EffectSpawn("war3mapImported\\wos_corpse explosion.mdl", x + r5 * Cos(a2), y + r5 * Sin(a2), 0, 1.5, 2.15, 0))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_corpse explosion.mdl" , s__AlucardSpells__AlucardSpells_T_x[this] + s__AlucardSpells__AlucardSpells_T_r5[this] * Cos(s__AlucardSpells__AlucardSpells_T_a2[this] + 15 * bj_DEGTORAD) , s__AlucardSpells__AlucardSpells_T_y[this] + s__AlucardSpells__AlucardSpells_T_r5[this] * Sin(s__AlucardSpells__AlucardSpells_T_a2[this] + 15 * bj_DEGTORAD) , 0 , 2. , 2.75 , 0))
                        set s__AlucardSpells__AlucardSpells_T_r5[this]=s__AlucardSpells__AlucardSpells_T_r5[this] + 400
                        set s__AlucardSpells__AlucardSpells_T_aoe[this]=s__AlucardSpells__AlucardSpells_T_aoe[this] + AlucardT2_DamageAoeStep
                    endif
                else
                    call StopSpellUnit(s__AlucardSpells__AlucardSpells_T_c[this])
                    call DestroyGroup(s__AlucardSpells__AlucardSpells_T_g[this])
                    call DestroyGroup(s__AlucardSpells__AlucardSpells_T_g2[this])
                    set s__AlucardSpells__AlucardSpells_T_c[this]=null
                    set s__AlucardSpells__AlucardSpells_T_td[this]=null
                    set s__AlucardSpells__AlucardSpells_T_u[this]=null
                    set s__AlucardSpells__AlucardSpells_T_g[this]=null
                    set s__AlucardSpells__AlucardSpells_T_g2[this]=null
                    set s__AlucardSpells__AlucardSpells_T_m_AlucardT2[i]=s__AlucardSpells__AlucardSpells_T_m_AlucardT2[s__AlucardSpells__AlucardSpells_T_MUI_AlucardT2]
                    set s__AlucardSpells__AlucardSpells_T_MUI_AlucardT2=s__AlucardSpells__AlucardSpells_T_MUI_AlucardT2 - 1
                    if s__AlucardSpells__AlucardSpells_T_MUI_AlucardT2 == - 1 then
                        call PauseTimer(s__AlucardSpells__AlucardSpells_T_t_AlucardT2)
                    endif
                    call s__AlucardSpells__AlucardSpells_T_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction

        function s__AlucardSpells__AlucardSpells_T_AlucardT2_Start takes unit NewC returns nothing
            local integer this= s__AlucardSpells__AlucardSpells_T__allocate()
            set s__AlucardSpells__AlucardSpells_T_MUI_AlucardT2=s__AlucardSpells__AlucardSpells_T_MUI_AlucardT2 + 1
            set s__AlucardSpells__AlucardSpells_T_m_AlucardT2[s__AlucardSpells__AlucardSpells_T_MUI_AlucardT2]=this
            set s__AlucardSpells__AlucardSpells_T_c[this]=NewC
            set s__AlucardSpells__AlucardSpells_T_x[this]=GetUnitX(s__AlucardSpells__AlucardSpells_T_c[this])
            set s__AlucardSpells__AlucardSpells_T_y[this]=GetUnitY(s__AlucardSpells__AlucardSpells_T_c[this])
            set s__AlucardSpells__AlucardSpells_T_r[this]=0
            set s__AlucardSpells__AlucardSpells_T_g[this]=CreateGroup()
            set s__AlucardSpells__AlucardSpells_T_g2[this]=CreateGroup()
            set s__AlucardSpells__AlucardSpells_T_dmg[this]=AlucardT2_DamageAgiBase * GetHeroAgi(s__AlucardSpells__AlucardSpells_T_c[this], true)
            set s__AlucardSpells__AlucardSpells_T_rmax[this]=2.5
            set s__AlucardSpells__AlucardSpells_T_r6[this]=( GetUnitState(s__AlucardSpells__AlucardSpells_T_c[this], UNIT_STATE_LIFE) * ( ( AlucardT2_HpCost / 100 ) ) ) / 40
            set s__AlucardSpells__AlucardSpells_T_aoe[this]=AlucardT2_DamageAoe
            call StartSpellUnit(s__AlucardSpells__AlucardSpells_T_c[this])
            set s__AlucardSpells__AlucardSpells_T_a[this]=GetUnitFacing(s__AlucardSpells__AlucardSpells_T_c[this]) * bj_DEGTORAD
            call ColorEffDummy3(EffectSpawn("war3mapImported\\wos_red and black pool.mdl" , GetUnitX(s__AlucardSpells__AlucardSpells_T_c[this]) , GetUnitY(s__AlucardSpells__AlucardSpells_T_c[this]) , 1 , 1.5 , 0.95 , 1) , 1 , 255 , 255 , 255 , 0.5)
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_ZK-SM_XL8.mdl" , GetUnitX(s__AlucardSpells__AlucardSpells_T_c[this]) , GetUnitY(s__AlucardSpells__AlucardSpells_T_c[this]) , 1 , 0.75 , 2 , 90))
            call MakeSound("war3mapimported\\Hero_Alucard_RT")
            call MakeSound("war3mapimported\\Hero_Alucard_RT2")
             call VisionTimed(GetOwningPlayer(s__AlucardSpells__AlucardSpells_T_c[this]) , s__AlucardSpells__AlucardSpells_T_x[this] , s__AlucardSpells__AlucardSpells_T_y[this] , 2500 , 5)
            if s__AlucardSpells__AlucardSpells_T_MUI_AlucardT2 == 0 then
                call TimerStart(s__AlucardSpells__AlucardSpells_T_t_AlucardT2, 0.03, true, function s__AlucardSpells__AlucardSpells_T_Loop_AlucardT2)
            endif
        endfunction


