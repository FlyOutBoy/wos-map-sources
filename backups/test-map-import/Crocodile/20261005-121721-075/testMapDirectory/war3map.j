            endloop
        endfunction
        function s__ErzaQSpells___ErzaPas_KS_ErzaPas_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__ErzaQSpells___ErzaPas_KS__allocate()
            set s__ErzaQSpells___ErzaPas_KS_MUI_ErzaE2=s__ErzaQSpells___ErzaPas_KS_MUI_ErzaE2 + 1
            set s__ErzaQSpells___ErzaPas_KS_m_ErzaE2[s__ErzaQSpells___ErzaPas_KS_MUI_ErzaE2]=this
            set s__ErzaQSpells___ErzaPas_KS_c[this]=NewC
            set s__ErzaQSpells___ErzaPas_KS_x[this]=NewX
            set s__ErzaQSpells___ErzaPas_KS_y[this]=NewY
            set s__ErzaQSpells___ErzaPas_KS_g2[this]=CreateGroup()
            set s__ErzaQSpells___ErzaPas_KS_aoe[this]=Erza1E_DamageAoe / 2
            set s__ErzaQSpells___ErzaPas_KS_r5[this]=s__ErzaQSpells___ErzaPas_KS_aoe[this] / 18
            set s__ErzaQSpells___ErzaPas_KS_dmg[this]=GetHeroAgi(s__ErzaQSpells___ErzaPas_KS_c[this], true) * ( Erza1E_DamageAgiBase + ( Erza1E_DamageAgiStep * ( GetUnitAbilityLevel(s__ErzaQSpells___ErzaPas_KS_c[this], Erza1E_ID) - 1 ) ) )
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_BY_Wood_Effect_OnePiece_AiSi_DaYanJieYanDi_2.mdx" , s__ErzaQSpells___ErzaPas_KS_x[this] , s__ErzaQSpells___ErzaPas_KS_y[this] , GetRandomReal(0, 359) , 1 , 3.5 , 50))
            set s__ErzaQSpells___ErzaPas_KS_k[this]=0
            loop
                exitwhen s__ErzaQSpells___ErzaPas_KS_k[this] > 7
                set s__ErzaQSpells___ErzaPas_KS_e[this]=EffectSpawn2("war3mapImported\\wos_BY_Wood_Effect_Order_MuZhiBenYing_Fir_Huo_DiMianss2.mdl" , s__ErzaQSpells___ErzaPas_KS_x[this] + s__ErzaQSpells___ErzaPas_KS_aoe[this] * Cos(s__ErzaQSpells___ErzaPas_KS_k[this] * 52 * bj_DEGTORAD) , s__ErzaQSpells___ErzaPas_KS_y[this] + s__ErzaQSpells___ErzaPas_KS_aoe[this] * Sin(s__ErzaQSpells___ErzaPas_KS_k[this] * 52 * bj_DEGTORAD) , GetRandomReal(0, 359) , 2 , 2.5 , 200 , 0.9)
                call EMUE(s__ErzaQSpells___ErzaPas_KS_e[this] , s__ErzaQSpells___ErzaPas_KS_aoe[this] , 0.75 , s__ErzaQSpells___ErzaPas_KS_k[this] * 52 * bj_DEGTORAD)
                set s__ErzaQSpells___ErzaPas_KS_e[this]=null
                set s__ErzaQSpells___ErzaPas_KS_k[this]=s__ErzaQSpells___ErzaPas_KS_k[this] + 1
            endloop
            set s__ErzaQSpells___ErzaPas_KS_r[this]=0
            set s__ErzaQSpells___ErzaPas_KS_g[this]=CreateGroup()
            set s__ErzaQSpells___ErzaPas_KS_u[this]=null
            set s__ErzaQSpells___ErzaPas_KS_rmax[this]=0.54
            if s__ErzaQSpells___ErzaPas_KS_MUI_ErzaE2 == 0 then
                call TimerStart(s__ErzaQSpells___ErzaPas_KS_t_ErzaE2, 0.03, true, function s__ErzaQSpells___ErzaPas_KS_Loop_ErzaE2)
            endif
        endfunction
function ErzaEPas takes unit c,real x,real y returns nothing
        local real cd= Erza1E_CD_TIME_Base - ( Erza1E_CD_TIME_Step * ( GetUnitAbilityLevel(c, Erza1Q_ID) - 1 ) )
        if GetHeroLevel(c) >= 6 then
            if LoadInteger(hs, GetHandleId(c), StringHash("fire armor pas")) == 1 then
                call SaveInteger(hs, GetHandleId(c), StringHash("fire armor pas"), 0)
                call SaveInteger(hs, GetHandleId(c), StringHash("fire armor pas cd"), 999)
                call s__GearSystems2___KS_Flush_Start((GetHandleId(c) ) , ( StringHash("fire armor pas cd") ) , ( 0 ) , (( cd)*1.0)) // INLINED!!
                call s__ErzaQSpells___ErzaPas_KS_ErzaPas_Start(c , x , y)
            endif
        endif
    endfunction
