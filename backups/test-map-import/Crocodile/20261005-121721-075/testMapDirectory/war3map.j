        call s__MahoragaSpells__MahoragaSpells_Q_MahoragaQ2_Start(c)
    endfunction
    function MahoragaW_Start takes unit c returns nothing
        call s__MahoragaSpells__MahoragaSpells_W_MahoragaW_Start(c)
    endfunction
