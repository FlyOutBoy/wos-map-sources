        function s__MahoragaSpells__MahoragaSpells_E_Loop_MahoragaE3 takes nothing returns nothing
            local integer this
            local integer i= 0
            local real rr= 0
            loop
                exitwhen i > s__MahoragaSpells__MahoragaSpells_E_MUI_MahoragaE3
                set this=s__MahoragaSpells__MahoragaSpells_E_m_MahoragaE3[i]
                if SpellBoolCaster(s__MahoragaSpells__MahoragaSpells_E_c[this]) and SpellBoolCaster(s__MahoragaSpells__MahoragaSpells_E_td[this]) and s__MahoragaSpells__MahoragaSpells_E_r[this] <= s__MahoragaSpells__MahoragaSpells_E_rmax[this] then
                    set s__MahoragaSpells__MahoragaSpells_E_r[this]=s__MahoragaSpells__MahoragaSpells_E_r[this] + 0.03
                    call DebugUnit(s__MahoragaSpells__MahoragaSpells_E_c[this])
                    call DebugUnit(s__MahoragaSpells__MahoragaSpells_E_td[this])
            // Phase 1: r <= 1.2 вЂ” Caster rises up (like normal E start)
                    if s__MahoragaSpells__MahoragaSpells_E_r[this] <= 0.6 then
                        call SetFly(s__MahoragaSpells__MahoragaSpells_E_c[this] , GetUnitFlyHeight(s__MahoragaSpells__MahoragaSpells_E_c[this]) + s__MahoragaSpells__MahoragaSpells_E_r5[this])
                        call MoveUnit(s__MahoragaSpells__MahoragaSpells_E_c[this] , s__MahoragaSpells__MahoragaSpells_E_r6[this] , s__MahoragaSpells__MahoragaSpells_E_a2[this])
                    endif
                    if s__MahoragaSpells__MahoragaSpells_E_r[this] == 0.03 then
                        set s__MahoragaSpells__MahoragaSpells_E_x1[this]=GetUnitX(s__MahoragaSpells__MahoragaSpells_E_td[this])
                        set s__MahoragaSpells__MahoragaSpells_E_y1[this]=GetUnitY(s__MahoragaSpells__MahoragaSpells_E_td[this])
                    endif
                    if s__MahoragaSpells__MahoragaSpells_E_r[this] == 0.6 then
                        set s__MahoragaSpells__MahoragaSpells_E_x[this]=GetUnitX(s__MahoragaSpells__MahoragaSpells_E_c[this])
                        set s__MahoragaSpells__MahoragaSpells_E_y[this]=GetUnitY(s__MahoragaSpells__MahoragaSpells_E_c[this])
                        call SetUnitAnimation(s__MahoragaSpells__MahoragaSpells_E_td[this], "death")
                        call SetUnitTimeScale(s__MahoragaSpells__MahoragaSpells_E_td[this], 0.08)
                        call AddSpecialEffectTarget("war3mapimported\\wos_A_[doft]hero_skeletonking_n2s_e_star.mdx", s__MahoragaSpells__MahoragaSpells_E_td[this], "chest")
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_az_hitheavy.mdl" , s__MahoragaSpells__MahoragaSpells_E_x[this] , s__MahoragaSpells__MahoragaSpells_E_y[this] , s__MahoragaSpells__MahoragaSpells_E_a[this] * bj_RADTODEG , 0.5 , 2.45 , GetUnitFlyHeight(s__MahoragaSpells__MahoragaSpells_E_c[this]) + 475))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_BDEF (124)2.mdx" , s__MahoragaSpells__MahoragaSpells_E_x[this] , s__MahoragaSpells__MahoragaSpells_E_y[this] , GetRandomReal(0, 359) , 0.5 , 2.5 , GetUnitFlyHeight(s__MahoragaSpells__MahoragaSpells_E_c[this]) + 475))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_acg_bbb.mdl" , s__MahoragaSpells__MahoragaSpells_E_x[this] , s__MahoragaSpells__MahoragaSpells_E_y[this] , s__MahoragaSpells__MahoragaSpells_E_a[this] * bj_RADTODEG , 1.85 , 1.35 , GetUnitFlyHeight(s__MahoragaSpells__MahoragaSpells_E_c[this]) + 475))
                    endif
                    if s__MahoragaSpells__MahoragaSpells_E_r[this] > 0.6 then
                        call SetUnitFacing(s__MahoragaSpells__MahoragaSpells_E_c[this], s__MahoragaSpells__MahoragaSpells_E_a[this] * bj_RADTODEG)
                        set rr=GetUnitFacing(s__MahoragaSpells__MahoragaSpells_E_c[this]) * bj_DEGTORAD
                        call PosUnit(s__MahoragaSpells__MahoragaSpells_E_td[this] , GetUnitX(s__MahoragaSpells__MahoragaSpells_E_c[this]) + 150 * Cos(rr) , GetUnitY(s__MahoragaSpells__MahoragaSpells_E_c[this]) + 150 * Sin(rr))
                        call SetFly(s__MahoragaSpells__MahoragaSpells_E_td[this] , GetUnitFlyHeight(s__MahoragaSpells__MahoragaSpells_E_c[this]) + 495)
                    endif
                    if s__MahoragaSpells__MahoragaSpells_E_r[this] == 0.72 then
                        call SetUnitTimeScale(s__MahoragaSpells__MahoragaSpells_E_c[this], 0.2)
                    endif
                    if s__MahoragaSpells__MahoragaSpells_E_r[this] < 1.2 then
                        set s__MahoragaSpells__MahoragaSpells_E_x[this]=GetMouseX(GetOwningPlayer(s__MahoragaSpells__MahoragaSpells_E_c[this]))
                        set s__MahoragaSpells__MahoragaSpells_E_y[this]=GetMouseY(GetOwningPlayer(s__MahoragaSpells__MahoragaSpells_E_c[this]))
                      //  call BJDebugMsg(R2S(x)+"  "+R2S(y))
                        if s__MahoragaSpells__MahoragaSpells_E_r2[this] > 0.21 then
                            set s__MahoragaSpells__MahoragaSpells_E_r2[this]=0
                            call VisionTimed(GetOwningPlayer(s__MahoragaSpells__MahoragaSpells_E_c[this]) , s__MahoragaSpells__MahoragaSpells_E_x[this] , s__MahoragaSpells__MahoragaSpells_E_y[this] , s__MahoragaSpells__MahoragaSpells_E_aoe[this] * 2 , 1)
                        else
                            set s__MahoragaSpells__MahoragaSpells_E_r2[this]=s__MahoragaSpells__MahoragaSpells_E_r2[this] + 0.03
                        endif
                        set s__MahoragaSpells__MahoragaSpells_E_a[this]=GAngle4(s__MahoragaSpells__MahoragaSpells_E_x1[this] , s__MahoragaSpells__MahoragaSpells_E_y1[this] , s__MahoragaSpells__MahoragaSpells_E_x[this] , s__MahoragaSpells__MahoragaSpells_E_y[this])
                        if SR0(s__MahoragaSpells__MahoragaSpells_E_x1[this] , s__MahoragaSpells__MahoragaSpells_E_y1[this] , s__MahoragaSpells__MahoragaSpells_E_x[this] , s__MahoragaSpells__MahoragaSpells_E_y[this]) > s__MahoragaSpells__MahoragaSpells_E_scale2[this] then
                            set s__MahoragaSpells__MahoragaSpells_E_x[this]=s__MahoragaSpells__MahoragaSpells_E_x1[this] + s__MahoragaSpells__MahoragaSpells_E_scale2[this] * Cos(s__MahoragaSpells__MahoragaSpells_E_a[this])
                            set s__MahoragaSpells__MahoragaSpells_E_y[this]=s__MahoragaSpells__MahoragaSpells_E_y1[this] + s__MahoragaSpells__MahoragaSpells_E_scale2[this] * Sin(s__MahoragaSpells__MahoragaSpells_E_a[this])
                        endif
                        if SR5(s__MahoragaSpells__MahoragaSpells_E_e[this] , s__MahoragaSpells__MahoragaSpells_E_x[this] , s__MahoragaSpells__MahoragaSpells_E_y[this]) > s__MahoragaSpells__MahoragaSpells_E_move[this] then
                            call MoveEff(s__MahoragaSpells__MahoragaSpells_E_e[this] , s__MahoragaSpells__MahoragaSpells_E_move[this] , GAngle5(s__MahoragaSpells__MahoragaSpells_E_e[this] , s__MahoragaSpells__MahoragaSpells_E_x[this] , s__MahoragaSpells__MahoragaSpells_E_y[this]))
                        else
                            call BlzSetSpecialEffectPosition(s__MahoragaSpells__MahoragaSpells_E_e[this], s__MahoragaSpells__MahoragaSpells_E_x[this], s__MahoragaSpells__MahoragaSpells_E_y[this], 3)
                        endif
                    endif
            // Phase 2: r == 1.2 вЂ” Lock in angle toward td, begin dive
                    if s__MahoragaSpells__MahoragaSpells_E_r[this] == 1.2 then
