                                    set dx=s__FrierenSpells__FrierenSpells_E_x[this] - LoadReal(hs, this, StringHash("FrierenEColumnX" + I2S(j)))
                                    set dy=s__FrierenSpells__FrierenSpells_E_y[this] - LoadReal(hs, this, StringHash("FrierenEColumnY" + I2S(j)))
                                    if dx * dx + dy * dy < 275 * 275 then
                                        set positionOk=false
                                        exitwhen true
                                    endif
                                    set j=j + 1
                                endloop
                                set tries=tries + 1
                                exitwhen positionOk or tries >= 20
                            endloop
                        endif
                        call SaveReal(hs, this, StringHash("FrierenEColumnX" + I2S(s__FrierenSpells__FrierenSpells_E_k[this])), s__FrierenSpells__FrierenSpells_E_x[this])
                        call SaveReal(hs, this, StringHash("FrierenEColumnY" + I2S(s__FrierenSpells__FrierenSpells_E_k[this])), s__FrierenSpells__FrierenSpells_E_y[this])
