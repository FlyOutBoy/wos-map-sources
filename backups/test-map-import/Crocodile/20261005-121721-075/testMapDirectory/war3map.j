        function s__AstaSpells__AstaSpells_Q_Loop_AstaQ takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__AstaSpells__AstaSpells_Q_MUI_AstaQ
                set this=s__AstaSpells__AstaSpells_Q_m_AstaQ[i]
                if SpellBoolCaster(s__AstaSpells__AstaSpells_Q_c[this]) and s__AstaSpells__AstaSpells_Q_r[this] <= s__AstaSpells__AstaSpells_Q_rmax[this] then
                    set s__AstaSpells__AstaSpells_Q_r[this]=RoundReal(s__AstaSpells__AstaSpells_Q_r[this] + 0.03 , 3)
                    if s__AstaSpells__AstaSpells_Q_r[this] < 0.45 then
                        call DebugUnit2(s__AstaSpells__AstaSpells_Q_c[this])
                    endif
                    if s__AstaSpells__AstaSpells_Q_r[this] == 0.39 then
                        call MakeSound("war3mapimported\\Hero_Asta_Q2")
                        call MakeSound("war3mapimported\\Hero_Asta_Q2")
                        set s__AstaSpells__AstaSpells_Q_e[this]=EffectSpawn4("war3mapImported\\wos_blackslash.mdx" , GetUnitX(s__AstaSpells__AstaSpells_Q_c[this]) - 200 * Cos(s__AstaSpells__AstaSpells_Q_a[this]) , GetUnitY(s__AstaSpells__AstaSpells_Q_c[this]) - 200 * Sin(s__AstaSpells__AstaSpells_Q_a[this]) , s__AstaSpells__AstaSpells_Q_a[this] * bj_RADTODEG , 0.65 , 0.5 , 155 , - 20)
                        set s__AstaSpells__AstaSpells_Q_e2[this]=EffectSpawn4("war3mapImported\\wos_blackslash.mdx" , GetUnitX(s__AstaSpells__AstaSpells_Q_c[this]) - 200 * Cos(s__AstaSpells__AstaSpells_Q_a[this]) , GetUnitY(s__AstaSpells__AstaSpells_Q_c[this]) - 200 * Sin(s__AstaSpells__AstaSpells_Q_a[this]) , s__AstaSpells__AstaSpells_Q_a[this] * bj_RADTODEG , 0.65 , 0.5 , 155 , - 340)
                        set s__AstaSpells__AstaSpells_Q_e3[this]=EffectSpawn("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl" , GetUnitX(s__AstaSpells__AstaSpells_Q_c[this]) + 250 * Cos(s__AstaSpells__AstaSpells_Q_a[this]) , GetUnitY(s__AstaSpells__AstaSpells_Q_c[this]) + 250 * Sin(s__AstaSpells__AstaSpells_Q_a[this]) , s__AstaSpells__AstaSpells_Q_a[this] * bj_RADTODEG , 0.65 , 3 , 135)
                        call MoveEff(s__AstaSpells__AstaSpells_Q_e3[this] , 10 , s__AstaSpells__AstaSpells_Q_a[this])
                        set s__AstaSpells__AstaSpells_Q_scale[this]=1
                        set s__AstaSpells__AstaSpells_Q_k3[this]=0
                        if GetUnitAbilityLevel(s__AstaSpells__AstaSpells_Q_c[this], AstaSword2_ID) > 0 then
                            set s__AstaSpells__AstaSpells_Q_scale[this]=( 1 + ( AstaTQ_AoeBonus / 100 ) )
                            set s__AstaSpells__AstaSpells_Q_aoe[this]=s__AstaSpells__AstaSpells_Q_aoe[this] * ( 1 + ( AstaTQ_AoeBonus / 100 ) )
                            set s__AstaSpells__AstaSpells_Q_k3[this]=1
                            set s__AstaSpells__AstaSpells_Q_dmg[this]=s__AstaSpells__AstaSpells_Q_dmg[this] + AstaTQ_DmgBonus * GetHeroAgi(s__AstaSpells__AstaSpells_Q_c[this], true)
                            call BlzSetSpecialEffectHeight(s__AstaSpells__AstaSpells_Q_e[this], BlzGetLocalSpecialEffectZ(s__AstaSpells__AstaSpells_Q_e[this]) * ( 1 + ( AstaTQ_AoeBonus / 100 ) ))
                        endif
                        call ScaleEffDummy(s__AstaSpells__AstaSpells_Q_e[this] , 0.3 , 0.5 , 2.6 * s__AstaSpells__AstaSpells_Q_scale[this])
                        call ScaleEffDummy(s__AstaSpells__AstaSpells_Q_e2[this] , 0.3 , 0.5 , 2.6 * s__AstaSpells__AstaSpells_Q_scale[this])
                    endif
                    if s__AstaSpells__AstaSpells_Q_r[this] == 0.45 then
                        call StopSpellUnit2(s__AstaSpells__AstaSpells_Q_c[this])
                        if GetUnitAbilityLevel(s__AstaSpells__AstaSpells_Q_c[this], AstaQ_ID) >= 5 then
                            call s__GearSystems2___KS_SpellTimer_SpellTimer_Timer_Start((s__AstaSpells__AstaSpells_Q_c[this] ) , (( 4 )*1.0) , ( AstaQ2_ID ) , ( AstaQ_ID) , 0) // INLINED!!
                            call s__GearSystems2___KS_BuffTimer_MyBuffTime_Start((s__AstaSpells__AstaSpells_Q_c[this] ) , 0 , (( 4 )*1.0) , ( "BTNHero_Asta_Q2" ) , ( false ) , - 1 , 1 , 0 , ( 0)) // INLINED!!
                        endif
                    endif
                    if s__AstaSpells__AstaSpells_Q_r[this] >= 0.45 then
                        set s__AstaSpells__AstaSpells_Q_x[this]=(BlzGetLocalSpecialEffectX((s__AstaSpells__AstaSpells_Q_e[this]))) + 280 * Cos(s__AstaSpells__AstaSpells_Q_a[this]) // INLINED!!
                        set s__AstaSpells__AstaSpells_Q_y[this]=(BlzGetLocalSpecialEffectY((s__AstaSpells__AstaSpells_Q_e[this]))) + 280 * Sin(s__AstaSpells__AstaSpells_Q_a[this]) // INLINED!!
                        call MoveEff(s__AstaSpells__AstaSpells_Q_e[this] , s__AstaSpells__AstaSpells_Q_move[this] , s__AstaSpells__AstaSpells_Q_a[this])
                        call MoveEff(s__AstaSpells__AstaSpells_Q_e2[this] , s__AstaSpells__AstaSpells_Q_move[this] , s__AstaSpells__AstaSpells_Q_a[this])
                        call MoveEff(s__AstaSpells__AstaSpells_Q_e3[this] , s__AstaSpells__AstaSpells_Q_move[this] , s__AstaSpells__AstaSpells_Q_a[this])
                        if s__AstaSpells__AstaSpells_Q_move[this] < 100 then
                            set s__AstaSpells__AstaSpells_Q_move[this]=s__AstaSpells__AstaSpells_Q_move[this] + 1.25
                        endif
                        if s__AstaSpells__AstaSpells_Q_r2[this] > 0.03 then
                            set s__AstaSpells__AstaSpells_Q_r2[this]=0
                        call VisionTimed(GetOwningPlayer(s__AstaSpells__AstaSpells_Q_c[this]) , s__AstaSpells__AstaSpells_Q_x[this] , s__AstaSpells__AstaSpells_Q_y[this] , 600 , 2)
                            if s__AstaSpells__AstaSpells_Q_k3[this] == 1 then
                                call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_BY_Wood_Effect_Kula_2_YiYingCun2.mdl" , s__AstaSpells__AstaSpells_Q_x[this] , s__AstaSpells__AstaSpells_Q_y[this] , s__AstaSpells__AstaSpells_Q_a[this] * bj_RADTODEG , 1.2 , 2.75 , 60 , 255 , 255 , 255 , 255))
                            else
                                call ColorEffDummy3(EffectSpawnColor("war3mapImported\\wos_BY_Wood_Eff_Ord_YeYe_Wid_KuoSan_1.mdx" , s__AstaSpells__AstaSpells_Q_x[this] + 00 * Cos(s__AstaSpells__AstaSpells_Q_a[this]) , s__AstaSpells__AstaSpells_Q_y[this] + 00 * Sin(s__AstaSpells__AstaSpells_Q_a[this]) , s__AstaSpells__AstaSpells_Q_a[this] * bj_RADTODEG , 1.25 , 2.65 , 180 , 0 , 0 , 0 , 255) , 0 , 0 , 0 , 0 , 0.3)
                            endif
                        else
                            set s__AstaSpells__AstaSpells_Q_r2[this]=s__AstaSpells__AstaSpells_Q_r2[this] + 0.03
                        endif
                        set s__AstaSpells__AstaSpells_Q_r5[this]=s__AstaSpells__AstaSpells_Q_r5[this] + s__AstaSpells__AstaSpells_Q_move[this]
                        if s__AstaSpells__AstaSpells_Q_r5[this] >= s__AstaSpells__AstaSpells_Q_r6[this] then
                            set s__AstaSpells__AstaSpells_Q_r[this]=9999
                        endif
                        call DecorRemove(s__AstaSpells__AstaSpells_Q_c[this] , s__AstaSpells__AstaSpells_Q_x[this] , s__AstaSpells__AstaSpells_Q_y[this] , s__AstaSpells__AstaSpells_Q_aoe[this] , 20)
                        call GroupClear(s__AstaSpells__AstaSpells_Q_g[this])
                        call GroupEnumUnitsInRange(s__AstaSpells__AstaSpells_Q_g[this], s__AstaSpells__AstaSpells_Q_x[this] + 150 * Cos(s__AstaSpells__AstaSpells_Q_a[this]), s__AstaSpells__AstaSpells_Q_y[this] + 150 * Sin(s__AstaSpells__AstaSpells_Q_a[this]), s__AstaSpells__AstaSpells_Q_aoe[this], NoDecor_Cond)
                        loop
                            set s__AstaSpells__AstaSpells_Q_u[this]=FirstOfGroup(s__AstaSpells__AstaSpells_Q_g[this])
                            exitwhen s__AstaSpells__AstaSpells_Q_u[this] == null
                            if SpellBool(s__AstaSpells__AstaSpells_Q_u[this]) and IsUnitEnemy(s__AstaSpells__AstaSpells_Q_u[this], GetOwningPlayer(s__AstaSpells__AstaSpells_Q_c[this])) and IsUnitInGroup(s__AstaSpells__AstaSpells_Q_u[this], s__AstaSpells__AstaSpells_Q_g2[this]) == false then
                                call GroupAddUnit(s__AstaSpells__AstaSpells_Q_g2[this], s__AstaSpells__AstaSpells_Q_u[this])
                                call dmgphys(s__AstaSpells__AstaSpells_Q_c[this] , s__AstaSpells__AstaSpells_Q_u[this] , s__AstaSpells__AstaSpells_Q_dmg[this])
                                set s__AstaSpells__AstaSpells_Q_r[this]=s__AstaSpells__AstaSpells_Q_rmax[this]
                                call MUE(s__AstaSpells__AstaSpells_Q_u[this] , 150 , 0.3 , s__AstaSpells__AstaSpells_Q_a[this])
                                call DestroyEffect(AddSpecialEffectTarget("war3mapimported\\wos_whiteakihared.mdl", s__AstaSpells__AstaSpells_Q_u[this], "chest"))
                                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", s__AstaSpells__AstaSpells_Q_u[this], "chest"))
                            endif
                            call GroupRemoveUnit(s__AstaSpells__AstaSpells_Q_g[this], s__AstaSpells__AstaSpells_Q_u[this])
                        endloop
                        set s__AstaSpells__AstaSpells_Q_u[this]=null
                    endif
                else
                    set s__AstaSpells__AstaSpells_Q_x[this]=(BlzGetLocalSpecialEffectX((s__AstaSpells__AstaSpells_Q_e[this]))) + 425 * Cos(s__AstaSpells__AstaSpells_Q_a[this]) // INLINED!!
                    set s__AstaSpells__AstaSpells_Q_y[this]=(BlzGetLocalSpecialEffectY((s__AstaSpells__AstaSpells_Q_e[this]))) + 425 * Sin(s__AstaSpells__AstaSpells_Q_a[this]) // INLINED!!
                    call DecorRemove(s__AstaSpells__AstaSpells_Q_c[this] , s__AstaSpells__AstaSpells_Q_x[this] , s__AstaSpells__AstaSpells_Q_y[this] , AstaQ_DamageAoe2 , 40)
                    call GroupClear(s__AstaSpells__AstaSpells_Q_g[this])
                    call GroupEnumUnitsInRange(s__AstaSpells__AstaSpells_Q_g[this], s__AstaSpells__AstaSpells_Q_x[this], s__AstaSpells__AstaSpells_Q_y[this], AstaQ_DamageAoe2, NoDecor_Cond)
                    loop
                        set s__AstaSpells__AstaSpells_Q_u[this]=FirstOfGroup(s__AstaSpells__AstaSpells_Q_g[this])
                        exitwhen s__AstaSpells__AstaSpells_Q_u[this] == null
                        if SpellBool(s__AstaSpells__AstaSpells_Q_u[this]) and IsUnitEnemy(s__AstaSpells__AstaSpells_Q_u[this], GetOwningPlayer(s__AstaSpells__AstaSpells_Q_c[this])) and IsUnitInGroup(s__AstaSpells__AstaSpells_Q_u[this], s__AstaSpells__AstaSpells_Q_g2[this]) == false then
                            call GroupAddUnit(s__AstaSpells__AstaSpells_Q_g2[this], s__AstaSpells__AstaSpells_Q_u[this])
                            call dmgphys(s__AstaSpells__AstaSpells_Q_c[this] , s__AstaSpells__AstaSpells_Q_u[this] , s__AstaSpells__AstaSpells_Q_dmg[this])
                            set s__AstaSpells__AstaSpells_Q_r[this]=s__AstaSpells__AstaSpells_Q_rmax[this]
                            call MUE(s__AstaSpells__AstaSpells_Q_u[this] , 150 , 0.3 , GAngle3(s__AstaSpells__AstaSpells_Q_x[this] , s__AstaSpells__AstaSpells_Q_y[this] , s__AstaSpells__AstaSpells_Q_u[this]))
                            call DestroyEffect(AddSpecialEffectTarget("war3mapimported\\wos_whiteakihared.mdl", s__AstaSpells__AstaSpells_Q_u[this], "chest"))
                            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", s__AstaSpells__AstaSpells_Q_u[this], "chest"))
                        endif
