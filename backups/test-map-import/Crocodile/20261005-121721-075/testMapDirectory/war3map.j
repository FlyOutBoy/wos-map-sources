            endif
            if s__LaxusSpells__LaxusW_KS_check2[this] == 1 then
            set s__LaxusSpells__LaxusW_KS_e[this]=AddSpecialEffectTarget("war3mapImported\\wos_RedMissile.mdl", s__LaxusSpells__LaxusW_KS_c[this], "hand left")
