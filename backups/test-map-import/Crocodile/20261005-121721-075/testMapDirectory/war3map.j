        function s__NatsuSpells___NatsuQ_KS_Loop_NatsuQ takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__NatsuSpells___NatsuQ_KS_MUI_NatsuQ
                set this=s__NatsuSpells___NatsuQ_KS_m_NatsuQ[i]
                if SpellBoolCaster(s__NatsuSpells___NatsuQ_KS_c[this]) and s__NatsuSpells___NatsuQ_KS_r[this] <= s__NatsuSpells___NatsuQ_KS_rmax[this] then
                    set s__NatsuSpells___NatsuQ_KS_r[this]=RoundReal(s__NatsuSpells___NatsuQ_KS_r[this] + 0.03 , 3)
                    if s__NatsuSpells___NatsuQ_KS_k2[this] == 0 then
                        if s__NatsuSpells___NatsuQ_KS_r[this] == s__NatsuSpells___NatsuQ_KS_r_prepare[this] - 0.03 then
                            call SetUnitTimeScale(s__NatsuSpells___NatsuQ_KS_c[this], 1)
                            set s__NatsuSpells___NatsuQ_KS_x[this]=GetUnitX(s__NatsuSpells___NatsuQ_KS_c[this]) + 180 * Cos(s__NatsuSpells___NatsuQ_KS_a[this])
                            set s__NatsuSpells___NatsuQ_KS_y[this]=GetUnitY(s__NatsuSpells___NatsuQ_KS_c[this]) + 180 * Sin(s__NatsuSpells___NatsuQ_KS_a[this])
                            call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_tx-ha_nitu.mdl" , GetUnitX(s__NatsuSpells___NatsuQ_KS_c[this]) , GetUnitY(s__NatsuSpells___NatsuQ_KS_c[this]) , s__NatsuSpells___NatsuQ_KS_a[this] * bj_RADTODEG , 2 , 1.25 , 1 , 255 , 255 , 255 , 225))
                        endif
                        if s__NatsuSpells___NatsuQ_KS_r[this] < s__NatsuSpells___NatsuQ_KS_r_prepare[this] then
                            call DebugUnit2(s__NatsuSpells___NatsuQ_KS_c[this])
                        endif
                        if s__NatsuSpells___NatsuQ_KS_r[this] >= s__NatsuSpells___NatsuQ_KS_r_prepare[this] then
