                        call GroupRemoveUnit(s__CrocodileSpells___CrocodileT2KS_g[this], s__CrocodileSpells___CrocodileT2KS_u[this])
                    endloop

                    set s__CrocodileSpells___CrocodileT2KS_move[this]=s__CrocodileSpells___CrocodileT2KS_move[this] + CrocodileT2_BeamScanStep
                    if s__CrocodileSpells___CrocodileT2KS_move[this] > CrocodileT2_BeamRange then
                        set s__CrocodileSpells___CrocodileT2KS_move[this]=0.00
                    endif

                    if s__CrocodileSpells___CrocodileT2KS_r2[this] + 0.001 >= CrocodileT2_DamagePeriod then
