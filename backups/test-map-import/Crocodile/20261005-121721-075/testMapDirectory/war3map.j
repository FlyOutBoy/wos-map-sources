            endif
            set s__LaxusSpells__LaxusG_KS_scale[this]=rr
            call BlzSetUnitMaxHP(s__LaxusSpells__LaxusG_KS_c[this], BlzGetUnitMaxHP(s__LaxusSpells__LaxusG_KS_c[this]) + rr)
        call SetUnitState(s__LaxusSpells__LaxusG_KS_c[this], UNIT_STATE_LIFE, GetUnitState(s__LaxusSpells__LaxusG_KS_c[this], UNIT_STATE_MAX_LIFE) * hp)
            set s__LaxusSpells__LaxusG_KS_e[this]=AddSpecialEffectTarget("war3mapImported\\wos_Shio_Super_Saiyan_JN_SS-2_laxus2.mdl", s__LaxusSpells__LaxusG_KS_c[this], "origin")
            call BlzFrameSetTexture(s__LaxusSpells__LaxusG_KS_frame_pas4[s__LaxusSpells__LaxusG_KS_k2[this]], "ReplaceableTextures\\CommandButtons\\BTNHero_Laxus_G2.blp", 0, false)
            if GetLocalPlayer() == Player(s__LaxusSpells__LaxusG_KS_k2[this]) then
                call BlzSetAbilityIcon(LaxusQ2_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Laxus_GQ.blp")
                call BlzSetAbilityIcon(LaxusW_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Laxus_GW.blp")
                call BlzSetAbilityIcon(LaxusW2_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Laxus_GW2.blp")
                call BlzSetAbilityIcon(LaxusE_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Laxus_GE.blp")
                call BlzSetAbilityIcon(LaxusR_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Laxus_GR.blp")
                call BlzSetAbilityIcon(LaxusF_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Laxus_GF.blp")
            endif
            endif

            if s__LaxusSpells__LaxusG_KS_MUI_LaxusG == 0 then
                call LaxusSpells__LaxusTimer03Acquire()
            endif
        endfunction

    function LaxusSpells__LaxusTimer03Loop takes nothing returns nothing
        call s__LaxusSpells__LaxusQ_KS_Loop_LaxusQ()
        call s__LaxusSpells__LaxusQ_KS_Loop_LaxusQ2()
        call s__LaxusSpells__LaxusW_KS_Loop_LaxusW()
        call s__LaxusSpells__LaxusW_KS_Loop_LaxusW2()
        call s__LaxusSpells__LaxusE_KS_Loop_LaxusE()
        call s__LaxusSpells__LaxusR_KS_Loop_LaxusR()
        call s__LaxusSpells__LaxusT_KS_Loop_LaxusT()
        call s__LaxusSpells__LaxusF_KS_Loop_LaxusF()
        call s__LaxusSpells__LaxusG_KS_Loop_LaxusG()
    endfunction

    function LaxusSpells__InitLaxusSpells takes nothing returns nothing
        set LaxusSpells__LaxusTimer03=CreateTimer()
        set LaxusSpells__LaxusTimer03Callback=function LaxusSpells__LaxusTimer03Loop
    endfunction

    //----------------------------Laxus-----------------------------------------------
     
    function LaxusFCheck_Start takes unit damaged returns nothing
        local integer i= 0
        local unit responder
        local player damagedOwner= GetOwningPlayer(damaged)
        local real damagedX= GetUnitX(damaged)
        local real damagedY= GetUnitY(damaged)
        local real dx
        local real dy
        local real rangeSquared= LaxusF_AoeSearch * LaxusF_AoeSearch

        // Hero[] is bounded by player slots. This preserves support for more
        // than one Laxus without allocating/enumerating a world group.
        loop
            exitwhen i >= bj_MAX_PLAYER_SLOTS
            set responder=Hero[i]

            if responder != null and GetUnitTypeId(responder) == Laxus_ID and GetWidgetLife(responder) > 1.0 and not IsUnitIllusion(responder) and GetHeroLevel(responder) >= 25 and IsUnitAlly(responder, damagedOwner) then
                set dx=GetUnitX(responder) - damagedX
                set dy=GetUnitY(responder) - damagedY

                if dx * dx + dy * dy <= rangeSquared and IntegerCd(responder , "pas f" , 5.0) then
                    // Kept exactly because h02D may be observed by another
                    // map trigger even though this library does not use it.
                    call s__GearSystems2___KS_RemoveUnit_MyRemoveUnit_Start((CreateUnit(GetOwningPlayer(responder), 'h02D', GetRectCenterX(gg_rct_Caster), GetRectCenterY(gg_rct_Caster), 1.0) ) , (( 30.0)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
                endif
            endif

            set i=i + 1
        endloop

        set responder=null
        set damagedOwner=null
    endfunction
    function LaxusQ_Start takes unit c,real x,real y returns nothing
    if LoadInteger(hs, GetHandleId(c), StringHash("lvl4")) == 0 then
        call s__LaxusSpells__LaxusQ_KS_LaxusQ_Start(c , x , y)
        else
        call s__LaxusSpells__LaxusQ_KS_LaxusQ2_Start(c , x , y)
        endif
    endfunction
    function LaxusQ2_Start takes unit c,real x,real y returns nothing
        call s__LaxusSpells__LaxusQ_KS_LaxusQ2_Start(c , x , y)
    endfunction
    function LaxusW_Start takes unit c,unit td returns nothing
        call s__LaxusSpells__LaxusW_KS_LaxusW_Start(c , td)
    endfunction
    function LaxusW2_Start takes unit c,unit td returns nothing
        call s__LaxusSpells__LaxusW_KS_LaxusW2_Start(c , td)
    endfunction
    function LaxusE_Start takes unit c returns nothing
        call s__LaxusSpells__LaxusE_KS_LaxusE_Start(c)
    endfunction
    function LaxusR_Start takes unit c,unit td returns nothing
    local real x= GetUnitX(td)
    local real y= GetUnitY(td)
    local integer i2= 0
    local integer id= LaxusR_ID
    if IsUnitAlly(td, GetOwningPlayer(c)) and GetHeroLevel(td) >= 25 and GetUnitTypeId(td) == Natsu_ID and LoadInteger(hs, GetHandleId(td), StringHash("mode g")) == 0 and IntegerCd(c , "natsu mode raien" , 60) then
    call DestroyEffect(EffectSpawn("war3mapImported\\wos_YellowBoom.mdx" , x , y , 1 , 1.25 , 4 , 110))
    call DestroyEffect(EffectSpawn("war3mapImported\\wos_by_wood_effect_yubanmeiqin_lightning_zhenzhengdeluolei_yellow.mdl" , x , y , 1 , 1 , 2 , 1))
    call DestroyEffect(EffectSpawn("war3mapImported\\wos_YellowMissile.mdl" , x , y , 1 , 1 , 6 , 100))
    call NatsuG2_Start(td)
    call UnitAddAbility(td, 'A0F8')
    call s__GearSystems2___KS_RemoveAbility_RemoveAbility_Start((td ) , (( 20 )*1.0) , ( 'A0F8' ) , ( 1)) // INLINED!!
    call MakeSound("war3mapimported\\Hero_Laxus_Pick1")
    call MakeSound("war3mapimported\\Hero_Laxus_W2 2")
    elseif IsUnitEnemy(td, GetOwningPlayer(c)) then
    call s__LaxusSpells__LaxusR_KS_LaxusR_Start(c , td)
    else
    call IssueImmediateOrder(c, "stop")
    set i2=BlzGetAbilityIntegerLevelField(BlzGetUnitAbility(c, id), ABILITY_ILF_MANA_COST, GetUnitAbilityLevel(c, id) - 1)
    call s__GearSystems2___KS_AddMana_Start((c ) , (( I2R(i2) )*1.0) , (( 0.03)*1.0)) // INLINED!!
    endif
    endfunction
    function LaxusT_Start takes unit c returns nothing
        call s__LaxusSpells__LaxusT_KS_LaxusT_Start(c)
    endfunction
    function LaxusF_Start takes unit c,unit td returns nothing
        call s__LaxusSpells__LaxusF_KS_LaxusF_Start(c , td)
    endfunction
    function LaxusG_Start takes unit c returns nothing
        call s__LaxusSpells__LaxusG_KS_LaxusG_Start(c)
    endfunction

