    function MilimDodge takes unit c,unit td returns nothing
        local real cd= 0
        local real time= 0.15
        local real push= 250
        call s__GearSystems2___KS_MoveEffectToUnit_MoveEffectToUnit_Start((EffectSpawn("war3mapImported\\wos_az_wsy_gather3.mdl" , GetUnitX(c) , GetUnitY(c) , 1 , 1 , 2 , 90) ) , (( time )*1.0) , (( 90 )*1.0) , ( c) , 0 , 1 , null) // INLINED!!
        call MakeSound("war3mapimported\\Hero_Milim_F")
        if GetHeroLevel(c) >= 35 then
            set cd=MilimF_CD35
        elseif GetHeroLevel(c) >= 25 then
            set cd=MilimF_CD25
        else
            set cd=MilimF_CD12
        endif
        if IsUnitPaused(c) == false then
            call MUE(c , push , time , GAngle(c , td) + GetRandomReal(- 30, 30) * bj_DEGTORAD)
        endif
        call s__GearSystems2___KS_FakeCooldown_FakeCD_Start1((c ) , ( MilimF_ID ) , (( cd )*1.0) , ( 0 ) , ( 0)) // INLINED!!
    endfunction
