                            set s__MahoragaSpells__MahoragaSpells_F_u[this]=null
                        else
                            set s__MahoragaSpells__MahoragaSpells_F_r6[this]=s__MahoragaSpells__MahoragaSpells_F_r6[this] + 0.03
                        endif
                        if s__MahoragaSpells__MahoragaSpells_F_r2[this] >= 0.0 then
                            set s__MahoragaSpells__MahoragaSpells_F_r2[this]=0
                            set s__MahoragaSpells__MahoragaSpells_F_r3[this]=GetRandomReal(1.55, 2.75)
                            set s__MahoragaSpells__MahoragaSpells_F_r7[this]=GetRandomReal(1., 2.1)
                            call s__GearSystems2___KS_RemoveEffect_MyRemoveEff_Start((EffectSpawnColor3("war3mapimported\\wos_az_bujingdule03512.mdl" , s__MahoragaSpells__MahoragaSpells_F_x1[this] + 125 * Cos(s__MahoragaSpells__MahoragaSpells_F_a[this]) , s__MahoragaSpells__MahoragaSpells_F_y1[this] + 125 * Sin(s__MahoragaSpells__MahoragaSpells_F_a[this]) , s__MahoragaSpells__MahoragaSpells_F_a[this] * bj_RADTODEG , s__MahoragaSpells__MahoragaSpells_F_r3[this] , s__MahoragaSpells__MahoragaSpells_F_r7[this] , 125 , - 90 , 255 , 255 , 255 , 75) ) , (( 0.45)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
                            set s__MahoragaSpells__MahoragaSpells_F_r7[this]=s__MahoragaSpells__MahoragaSpells_F_r[this] * 2. + GetRandomReal(0.5, 1.65)
                            set s__MahoragaSpells__MahoragaSpells_F_r3[this]=GetRandomReal(1.75, 2.75)
                            call DestroyEffect(EffectSpawn3("war3mapimported\\wos_white-qiquan-new.mdx" , s__MahoragaSpells__MahoragaSpells_F_x1[this] + 125 * Cos(s__MahoragaSpells__MahoragaSpells_F_a[this]) , s__MahoragaSpells__MahoragaSpells_F_y1[this] + 125 * Sin(s__MahoragaSpells__MahoragaSpells_F_a[this]) , s__MahoragaSpells__MahoragaSpells_F_a[this] * bj_RADTODEG , s__MahoragaSpells__MahoragaSpells_F_r3[this] , s__MahoragaSpells__MahoragaSpells_F_r7[this] , 100 , - 90))
                            call VisionTimed(GetOwningPlayer(s__MahoragaSpells__MahoragaSpells_F_c[this]) , s__MahoragaSpells__MahoragaSpells_F_x1[this] , s__MahoragaSpells__MahoragaSpells_F_y1[this] , 1200 , 1)
                        else
                            set s__MahoragaSpells__MahoragaSpells_F_r2[this]=s__MahoragaSpells__MahoragaSpells_F_r2[this] + 0.03
                        endif
                    endif
                else
                    call StopSpellUnit(s__MahoragaSpells__MahoragaSpells_F_c[this])
                    call SetUnitTimeScale(s__MahoragaSpells__MahoragaSpells_F_c[this], 1)
                    call DestroyEffect(s__MahoragaSpells__MahoragaSpells_F_e[this])
                    call DestroyEffect(s__MahoragaSpells__MahoragaSpells_F_e2[this])
                    call DestroyEffect(s__MahoragaSpells__MahoragaSpells_F_e5[this])
                    call DestroyGroup(s__MahoragaSpells__MahoragaSpells_F_g[this])
                    set s__MahoragaSpells__MahoragaSpells_F_g[this]=null
                    set s__MahoragaSpells__MahoragaSpells_F_c[this]=null
                    set s__MahoragaSpells__MahoragaSpells_F_e[this]=null
                    set s__MahoragaSpells__MahoragaSpells_F_e2[this]=null
                    set s__MahoragaSpells__MahoragaSpells_F_e5[this]=null
                    call DestroyGroup(s__MahoragaSpells__MahoragaSpells_F_g2[this])
                    set s__MahoragaSpells__MahoragaSpells_F_g2[this]=null
                    set s__MahoragaSpells__MahoragaSpells_F_u[this]=null
                    set s__MahoragaSpells__MahoragaSpells_F_m_MahoragaF[i]=s__MahoragaSpells__MahoragaSpells_F_m_MahoragaF[s__MahoragaSpells__MahoragaSpells_F_MUI_MahoragaF]
                    set s__MahoragaSpells__MahoragaSpells_F_MUI_MahoragaF=s__MahoragaSpells__MahoragaSpells_F_MUI_MahoragaF - 1
                    if s__MahoragaSpells__MahoragaSpells_F_MUI_MahoragaF == - 1 then
                        call PauseTimer(s__MahoragaSpells__MahoragaSpells_F_t_MahoragaF)
                    endif
                    call s__MahoragaSpells__MahoragaSpells_F_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction

        function s__MahoragaSpells__MahoragaSpells_F_MahoragaF_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__MahoragaSpells__MahoragaSpells_F__allocate()
            set s__MahoragaSpells__MahoragaSpells_F_MUI_MahoragaF=s__MahoragaSpells__MahoragaSpells_F_MUI_MahoragaF + 1
            set s__MahoragaSpells__MahoragaSpells_F_m_MahoragaF[s__MahoragaSpells__MahoragaSpells_F_MUI_MahoragaF]=this
            set s__MahoragaSpells__MahoragaSpells_F_c[this]=NewC
            set s__MahoragaSpells__MahoragaSpells_F_x[this]=NewX
            set s__MahoragaSpells__MahoragaSpells_F_y[this]=NewY
            set s__MahoragaSpells__MahoragaSpells_F_r[this]=0
            set s__MahoragaSpells__MahoragaSpells_F_r2[this]=0
            set s__MahoragaSpells__MahoragaSpells_F_r3[this]=0
            set s__MahoragaSpells__MahoragaSpells_F_r4[this]=0
            set s__MahoragaSpells__MahoragaSpells_F_r5[this]=0
            set s__MahoragaSpells__MahoragaSpells_F_r6[this]=0
            set s__MahoragaSpells__MahoragaSpells_F_r7[this]=0
            call StartSpellUnit(s__MahoragaSpells__MahoragaSpells_F_c[this])
            set s__MahoragaSpells__MahoragaSpells_F_g[this]=CreateGroup()
            set s__MahoragaSpells__MahoragaSpells_F_g2[this]=CreateGroup()
            set s__MahoragaSpells__MahoragaSpells_F_u[this]=null
            set s__MahoragaSpells__MahoragaSpells_F_a[this]=GAngle2(s__MahoragaSpells__MahoragaSpells_F_c[this] , s__MahoragaSpells__MahoragaSpells_F_x[this] , s__MahoragaSpells__MahoragaSpells_F_y[this]) // Angle Between points
            set s__MahoragaSpells__MahoragaSpells_F_check[this]=0
           // call DestroyEffect(EffectSpawn("war3mapimported\\wos_HakkeStart.mdx", GetUnitX(c), GetUnitY(c), GetRandomReal(0, 359), 0.3, 1.45, 7))
            set s__MahoragaSpells__MahoragaSpells_F_aoe[this]=MahoragaF_DamageAoe
            set s__MahoragaSpells__MahoragaSpells_F_dmg[this]=GetHeroAgi(s__MahoragaSpells__MahoragaSpells_F_c[this], true) * MahoragaF_DamageAgiBase
            set s__MahoragaSpells__MahoragaSpells_F_rmax[this]=3
            call SetUnitAnimationByIndex(s__MahoragaSpells__MahoragaSpells_F_c[this], 3)
            call SetUnitTimeScale(s__MahoragaSpells__MahoragaSpells_F_c[this], 0.5)
            call MakeSound("war3mapimported\\Hero_Mahoraga_F")
            if s__MahoragaSpells__MahoragaSpells_F_MUI_MahoragaF == 0 then
                call TimerStart(s__MahoragaSpells__MahoragaSpells_F_t_MahoragaF, 0.03, true, function s__MahoragaSpells__MahoragaSpells_F_Loop_MahoragaF)
            endif
        endfunction



        function s__MahoragaSpells__MahoragaSpells_G_Loop_MahoragaG takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__MahoragaSpells__MahoragaSpells_G_MUI_MahoragaG
                set this=s__MahoragaSpells__MahoragaSpells_G_m_MahoragaG[i]
                if true then
                    if GetHeroLevel(s__MahoragaSpells__MahoragaSpells_G_c[this]) >= 25 then
                        if CheckCoordsInRect(gg_rct_Base , GetUnitX(s__MahoragaSpells__MahoragaSpells_G_c[this]) , GetUnitY(s__MahoragaSpells__MahoragaSpells_G_c[this])) or IsUnitType(s__MahoragaSpells__MahoragaSpells_G_c[this], UNIT_TYPE_DEAD) then
                            if s__MahoragaSpells__MahoragaSpells_G_d[this] != null then
                                    call SaveInteger(hs, GetHandleId(s__MahoragaSpells__MahoragaSpells_G_c[this]), StringHash("stack 5"), 0)
                                call RemoveUnit(s__MahoragaSpells__MahoragaSpells_G_d[this])
                                call SetPlayerAbilityAvailable(GetOwningPlayer(s__MahoragaSpells__MahoragaSpells_G_c[this]), MahoragaW_ID, true)
                                call SetPlayerAbilityAvailable(GetOwningPlayer(s__MahoragaSpells__MahoragaSpells_G_c[this]), MahoragaW2_ID, false)
                                set s__MahoragaSpells__MahoragaSpells_G_d[this]=null
                            endif
                        else
                            set s__MahoragaSpells__MahoragaSpells_G_k[this]=0
                            set s__MahoragaSpells__MahoragaSpells_G_x[this]=GetUnitX(s__MahoragaSpells__MahoragaSpells_G_c[this])
                            set s__MahoragaSpells__MahoragaSpells_G_y[this]=GetUnitY(s__MahoragaSpells__MahoragaSpells_G_c[this])
                            call GroupEnumUnitsInRange(s__MahoragaSpells__MahoragaSpells_G_g[this], s__MahoragaSpells__MahoragaSpells_G_x[this], s__MahoragaSpells__MahoragaSpells_G_y[this], s__MahoragaSpells__MahoragaSpells_G_aoe[this], NoDecor_Cond)
                            loop
                                set s__MahoragaSpells__MahoragaSpells_G_u[this]=FirstOfGroup(s__MahoragaSpells__MahoragaSpells_G_g[this])
                                exitwhen s__MahoragaSpells__MahoragaSpells_G_u[this] == null
                                if SpellBool(s__MahoragaSpells__MahoragaSpells_G_u[this]) and IsUnitEnemy(s__MahoragaSpells__MahoragaSpells_G_u[this], GetOwningPlayer(s__MahoragaSpells__MahoragaSpells_G_c[this])) and ( GetUnitAbilityLevel(s__MahoragaSpells__MahoragaSpells_G_u[this], MahoragaT_Abi_ID3) > 0 or GetUnitAbilityLevel(s__MahoragaSpells__MahoragaSpells_G_u[this], MahoragaT_Abi_ID4) > 0 or GetUnitAbilityLevel(s__MahoragaSpells__MahoragaSpells_G_u[this], MahoragaT_Abi_ID5) > 0 or GetUnitAbilityLevel(s__MahoragaSpells__MahoragaSpells_G_u[this], MahoragaT_Abi_ID6) > 0 or GetUnitAbilityLevel(s__MahoragaSpells__MahoragaSpells_G_u[this], MahoragaT_Abi_ID7) > 0 or GetUnitAbilityLevel(s__MahoragaSpells__MahoragaSpells_G_u[this], MahoragaT_Abi_ID8) > 0 ) then
                                    set s__MahoragaSpells__MahoragaSpells_G_k[this]=1
                                endif
                                call GroupRemoveUnit(s__MahoragaSpells__MahoragaSpells_G_g[this], s__MahoragaSpells__MahoragaSpells_G_u[this])
                            endloop
                            set s__MahoragaSpells__MahoragaSpells_G_u[this]=null
                            if BlzGetUnitAbilityCooldownRemaining(s__MahoragaSpells__MahoragaSpells_G_c[this], MahoragaW2_ID) != 0 or s__MahoragaSpells__MahoragaSpells_G_d[this] == null then
                                    call SetPlayerAbilityAvailable(GetOwningPlayer(s__MahoragaSpells__MahoragaSpells_G_c[this]), MahoragaW_ID, true)
                                    call SetPlayerAbilityAvailable(GetOwningPlayer(s__MahoragaSpells__MahoragaSpells_G_c[this]), MahoragaW2_ID, false)
                                    else
                                    call SetPlayerAbilityAvailable(GetOwningPlayer(s__MahoragaSpells__MahoragaSpells_G_c[this]), MahoragaW_ID, false)
                                    call SetPlayerAbilityAvailable(GetOwningPlayer(s__MahoragaSpells__MahoragaSpells_G_c[this]), MahoragaW2_ID, true)
                            endif
                            if s__MahoragaSpells__MahoragaSpells_G_k[this] == 1 then
                                if s__MahoragaSpells__MahoragaSpells_G_d[this] == null then
                                    call UnitAddAbility(s__MahoragaSpells__MahoragaSpells_G_c[this], MahoragaW2_ID)
                                    call SaveInteger(hs, GetHandleId(s__MahoragaSpells__MahoragaSpells_G_c[this]), StringHash("stack 5"), 1)
                                    set s__MahoragaSpells__MahoragaSpells_G_d[this]=CreateUnit(GetOwningPlayer(s__MahoragaSpells__MahoragaSpells_G_c[this]), MahoragaT_Unit_ID, GetRectCenterX(gg_rct_Caster), GetRectCenterY(gg_rct_Caster), 1)
                                endif
                            else
                                if s__MahoragaSpells__MahoragaSpells_G_d[this] != null then
                                    call SaveInteger(hs, GetHandleId(s__MahoragaSpells__MahoragaSpells_G_c[this]), StringHash("stack 5"), 0)
                                    call RemoveUnit(s__MahoragaSpells__MahoragaSpells_G_d[this])
                                    set s__MahoragaSpells__MahoragaSpells_G_d[this]=null
                                endif
                            endif
                        endif
                    endif
                else
                    set s__MahoragaSpells__MahoragaSpells_G_c[this]=null
                    set s__MahoragaSpells__MahoragaSpells_G_g[this]=null
                    set s__MahoragaSpells__MahoragaSpells_G_u[this]=null
                    set s__MahoragaSpells__MahoragaSpells_G_m_MahoragaG[i]=s__MahoragaSpells__MahoragaSpells_G_m_MahoragaG[s__MahoragaSpells__MahoragaSpells_G_MUI_MahoragaG]
                    set s__MahoragaSpells__MahoragaSpells_G_MUI_MahoragaG=s__MahoragaSpells__MahoragaSpells_G_MUI_MahoragaG - 1
                    if s__MahoragaSpells__MahoragaSpells_G_MUI_MahoragaG == - 1 then
                        call PauseTimer(s__MahoragaSpells__MahoragaSpells_G_t_MahoragaG)
                    endif
                    call s__MahoragaSpells__MahoragaSpells_G_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction

        function s__MahoragaSpells__MahoragaSpells_G_MahoragaG_Start takes unit NewC returns nothing
            local integer this= s__MahoragaSpells__MahoragaSpells_G__allocate()
            set s__MahoragaSpells__MahoragaSpells_G_MUI_MahoragaG=s__MahoragaSpells__MahoragaSpells_G_MUI_MahoragaG + 1
            set s__MahoragaSpells__MahoragaSpells_G_m_MahoragaG[s__MahoragaSpells__MahoragaSpells_G_MUI_MahoragaG]=this
            set s__MahoragaSpells__MahoragaSpells_G_c[this]=NewC
