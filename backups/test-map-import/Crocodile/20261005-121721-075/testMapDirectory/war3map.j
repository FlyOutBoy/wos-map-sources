                            call DestroyEffect(EffectSpawnColor("war3mapimported\\wos_acg_bbb.mdx" , GetUnitX(s__ErzaQSpells___ErzaQ_KS_c[this]) , GetUnitY(s__ErzaQSpells___ErzaQ_KS_c[this]) , GetRandomReal(0, 359) , 1.85 , 2.25 , 150 , 255 , 255 , 255 , 165))
                    call DecorRemove(s__ErzaQSpells___ErzaQ_KS_c[this] , s__ErzaQSpells___ErzaQ_KS_x[this] , s__ErzaQSpells___ErzaQ_KS_y[this] , s__ErzaQSpells___ErzaQ_KS_aoe[this] , 20)
