                                set s__RaidenSpells___RaidenQ_KS_x[this]=GetUnitX(s__RaidenSpells___RaidenQ_KS_c[this]) + 50 * Cos(s__RaidenSpells___RaidenQ_KS_a[this])
                                set s__RaidenSpells___RaidenQ_KS_y[this]=GetUnitY(s__RaidenSpells___RaidenQ_KS_c[this]) + 50 * Sin(s__RaidenSpells___RaidenQ_KS_a[this])
                                if s__RaidenSpells___RaidenQ_KS_r2[this] > 0.03 then
                                set s__RaidenSpells___RaidenQ_KS_r2[this]=0
