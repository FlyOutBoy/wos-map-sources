            set s__FrierenSpells__FrierenSpells_TQ_r2[this]=0
            set s__FrierenSpells__FrierenSpells_TQ_check[this]=0
            set s__FrierenSpells__FrierenSpells_TQ_move[this]=105
            set s__FrierenSpells__FrierenSpells_TQ_rmax[this]=3
            call StartSpellUnit(s__FrierenSpells__FrierenSpells_TQ_c[this])
            set s__FrierenSpells__FrierenSpells_TQ_g[this]=CreateGroup()
            set s__FrierenSpells__FrierenSpells_TQ_u[this]=null
