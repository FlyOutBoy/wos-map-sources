                set s__LaxusSpells__LaxusR_KS_dmg[this]=s__LaxusSpells__LaxusR_KS_dmg[this] + GetHeroStr(s__LaxusSpells__LaxusR_KS_c[this], true) * LaxusGR_DamageStrBonus2
                endif
            endif
            if s__LaxusSpells__LaxusR_KS_check2[this] == 1 then
                set s__LaxusSpells__LaxusR_KS_e[this]=AddSpecialEffectTarget("war3mapImported\\wos_RedMissile.mdl", s__LaxusSpells__LaxusR_KS_c[this], "hand right")
                set s__LaxusSpells__LaxusR_KS_e2[this]=AddSpecialEffectTarget("war3mapImported\\wos_RedMissile.mdl", s__LaxusSpells__LaxusR_KS_c[this], "hand left")
            else
                set s__LaxusSpells__LaxusR_KS_e[this]=AddSpecialEffectTarget("war3mapImported\\wos_YellowMissile.mdl", s__LaxusSpells__LaxusR_KS_c[this], "hand right")
                set s__LaxusSpells__LaxusR_KS_e2[this]=AddSpecialEffectTarget("war3mapImported\\wos_YellowMissile.mdl", s__LaxusSpells__LaxusR_KS_c[this], "hand left")
            endif
            set s__LaxusSpells__LaxusR_KS_a[this]=GAngle2(s__LaxusSpells__LaxusR_KS_c[this] , s__LaxusSpells__LaxusR_KS_x[this] , s__LaxusSpells__LaxusR_KS_y[this])
            set s__LaxusSpells__LaxusR_KS_aoe[this]=LaxusR_DamageAoe
            set s__LaxusSpells__LaxusR_KS_rmax[this]=2.4
            call SetUnitAnimationByIndex(s__LaxusSpells__LaxusR_KS_c[this], 12)
            call SetUnitTimeScale(s__LaxusSpells__LaxusR_KS_c[this], 1)
            call MakeSound("war3mapimported\\Hero_Laxus_R")
            if s__LaxusSpells__LaxusR_KS_MUI_LaxusR == 0 then
                call LaxusSpells__LaxusTimer03Acquire()
            endif
        endfunction

        function s__LaxusSpells__LaxusT_KS_Loop_LaxusT takes nothing returns nothing
