        function s__TsunaSpells__TsunaQKS_Loop_TsunaQ takes nothing returns nothing
            local integer this
            local integer i= 0
            local real r6= 90
            loop
                exitwhen i > s__TsunaSpells__TsunaQKS_MUI_TsunaQ
                set this=s__TsunaSpells__TsunaQKS_m_TsunaQ[i]
                if SpellBoolCaster(s__TsunaSpells__TsunaQKS_c[this]) and s__TsunaSpells__TsunaQKS_r[this] <= s__TsunaSpells__TsunaQKS_rmax[this] then
                    set s__TsunaSpells__TsunaQKS_r[this]=s__TsunaSpells__TsunaQKS_r[this] + 0.03
                    call DebugUnit2(s__TsunaSpells__TsunaQKS_c[this])
                    if s__TsunaSpells__TsunaQKS_check[this] == 0 then
                        if s__TsunaSpells__TsunaQKS_r[this] > 0.21 then
                            if s__TsunaSpells__TsunaQKS_r5[this] <= s__TsunaSpells__TsunaQKS_r7[this] then
                                set s__TsunaSpells__TsunaQKS_r5[this]=s__TsunaSpells__TsunaQKS_r5[this] + s__TsunaSpells__TsunaQKS_move[this]
                                call MoveUnit(s__TsunaSpells__TsunaQKS_c[this] , s__TsunaSpells__TsunaQKS_move[this] , s__TsunaSpells__TsunaQKS_a[this])
                                call SetUnitFacing(s__TsunaSpells__TsunaQKS_c[this], s__TsunaSpells__TsunaQKS_a[this] * bj_RADTODEG)
                                call GroupClear(s__TsunaSpells__TsunaQKS_g[this])
                                call DecorRemove(s__TsunaSpells__TsunaQKS_c[this] , GetUnitX(s__TsunaSpells__TsunaQKS_c[this]) , GetUnitY(s__TsunaSpells__TsunaQKS_c[this]) , s__TsunaSpells__TsunaQKS_aoe[this] , TsunaQ_DecorDamage)
                                
                                if GetUnitAbilityLevel(s__TsunaSpells__TsunaQKS_c[this], TsunaW_Buff_ID) > 0 then
                                    call GroupEnumUnitsInRange(s__TsunaSpells__TsunaQKS_g[this], GetUnitX(s__TsunaSpells__TsunaQKS_c[this]), GetUnitY(s__TsunaSpells__TsunaQKS_c[this]), s__TsunaSpells__TsunaQKS_aoe[this] + 25, NoDecor_Cond)
                                    loop
                                        set s__TsunaSpells__TsunaQKS_u[this]=FirstOfGroup(s__TsunaSpells__TsunaQKS_g[this])
                                        exitwhen s__TsunaSpells__TsunaQKS_u[this] == null
                                        if SpellBool(s__TsunaSpells__TsunaQKS_u[this]) and IsUnitEnemy(s__TsunaSpells__TsunaQKS_u[this], GetOwningPlayer(s__TsunaSpells__TsunaQKS_c[this])) and IsUnitInGroup(s__TsunaSpells__TsunaQKS_u[this], s__TsunaSpells__TsunaQKS_g2[this]) == false then
                                            call GroupAddUnit(s__TsunaSpells__TsunaQKS_g2[this], s__TsunaSpells__TsunaQKS_u[this])
                                            call dmgatk(s__TsunaSpells__TsunaQKS_c[this] , s__TsunaSpells__TsunaQKS_u[this] , s__TsunaSpells__TsunaQKS_dmg[this])
                                            set s__TsunaSpells__TsunaQKS_check2[this]=s__TsunaSpells__TsunaQKS_check2[this] + 1
                                        endif
                                        call GroupRemoveUnit(s__TsunaSpells__TsunaQKS_g[this], s__TsunaSpells__TsunaQKS_u[this])
                                    endloop
                                else
                                    call GroupEnumUnitsInRange(s__TsunaSpells__TsunaQKS_g[this], GetUnitX(s__TsunaSpells__TsunaQKS_c[this]), GetUnitY(s__TsunaSpells__TsunaQKS_c[this]), s__TsunaSpells__TsunaQKS_aoe[this] + 25, NoDecor_Cond)
                                    loop
                                        set s__TsunaSpells__TsunaQKS_u[this]=FirstOfGroup(s__TsunaSpells__TsunaQKS_g[this])
                                        exitwhen s__TsunaSpells__TsunaQKS_u[this] == null or s__TsunaSpells__TsunaQKS_check[this] == 1
                                        if SpellBool(s__TsunaSpells__TsunaQKS_u[this]) and IsUnitEnemy(s__TsunaSpells__TsunaQKS_u[this], GetOwningPlayer(s__TsunaSpells__TsunaQKS_c[this])) then
                                            set s__TsunaSpells__TsunaQKS_check[this]=1
