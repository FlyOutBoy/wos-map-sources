                                                call s__GearSystems2___KS_DelayedDamage_NextDmg_Start((s__PatriotSpells___PatriotSpells_T_c[this] ) , ( u ) , (( GetAttack(s__PatriotSpells___PatriotSpells_T_c[this]) )*1.0) , ( 2 ) , (( 0.36)*1.0)) // INLINED!!
                                            endif
                                            call dmgphys(s__PatriotSpells___PatriotSpells_T_c[this] , u , s__PatriotSpells___PatriotSpells_T_dmg[this])
                                        endif
                                        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", u, "chest"))
                                        // Soft boundary: normal movement/knockback is
                                        // returned quickly to the inner rim. A blink
                                        // beyond the enumeration radius is untouched.
                                        if distance > s__PatriotSpells___PatriotSpells_T_aoe[this] - PatriotT_EdgeInset then
                                            call MoveUnit3(u , distance - ( s__PatriotSpells___PatriotSpells_T_aoe[this] - PatriotT_EdgeInset ) , GAngle2(u , s__PatriotSpells___PatriotSpells_T_x[this] , s__PatriotSpells___PatriotSpells_T_y[this]))
                                        endif
                                        set s__PatriotSpells___PatriotSpells_T_k[this]=s__PatriotSpells___PatriotSpells_T_k[this] + 1
                                    endif
                                endif
                                call GroupRemoveUnit(s__PatriotSpells___PatriotSpells_T_g[this], u)
                            endloop
                            set s__PatriotSpells___PatriotSpells_T_r3[this]=0.0
                            if s__PatriotSpells___PatriotSpells_T_k[this] > 0 then
                                set s__PatriotSpells___PatriotSpells_T_check2[this]=1
                            endif
                        else
                            set s__PatriotSpells___PatriotSpells_T_r3[this]=s__PatriotSpells___PatriotSpells_T_r3[this] + 0.03
                        endif
                    endif
                endif

                if remove then
