                                call EffectSpawn2("war3mapImported\\wos_BY_Wood_Effect_Order_MuZhiBenYing_Fir_Huo_DiMianss2.mdl" , GetUnitX(s__ErzaQSpells__ErzaQ_KS_c[this]) , GetUnitY(s__ErzaQSpells__ErzaQ_KS_c[this]) , GetRandomReal(0, 359) , 2 , 1 , 0 , 0.25)
                            else
                                set s__ErzaQSpells__ErzaQ_KS_r2[this]=s__ErzaQSpells__ErzaQ_KS_r2[this] + 0.03
                            endif
                          endif
                        endif
                        if SR3(s__ErzaQSpells__ErzaQ_KS_c[this] , s__ErzaQSpells__ErzaQ_KS_x[this] , s__ErzaQSpells__ErzaQ_KS_y[this]) < 120 then
                            set s__ErzaQSpells__ErzaQ_KS_r[this]=s__ErzaQSpells__ErzaQ_KS_rmax[this]
                        endif
                        if s__ErzaQSpells__ErzaQ_KS_r[this] == s__ErzaQSpells__ErzaQ_KS_rmax[this] then
                            set s__ErzaQSpells__ErzaQ_KS_check[this]=1
