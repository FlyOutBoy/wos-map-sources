                            if s__RimuruSpells__Rimuru3T_KS_r2[this] >= 0.5 and s__RimuruSpells__Rimuru3T_KS_check2[this] == 1 then
                                set s__RimuruSpells__Rimuru3T_KS_r3[this]=0.0
                                set s__RimuruSpells__Rimuru3T_KS_r4[this]=0.0
                                set s__RimuruSpells__Rimuru3T_KS_r2[this]=0.0
                                set s__RimuruSpells__Rimuru3T_KS_check2[this]=0
                                // FIX: explicitly destroy ALL 3 banks before resetting.
                                // Without this, next cycle's check==3 would double-live.
                                set s__RimuruSpells__Rimuru3T_KS_k[this]=0
                                loop
                                    exitwhen s__RimuruSpells__Rimuru3T_KS_k[this] == ring
                                    if s___RimuruSpells__Rimuru3T_KS_ls[s__RimuruSpells__Rimuru3T_KS_ls[this]+s__RimuruSpells__Rimuru3T_KS_k[this]] != null then
                                        call DestroyLightning(s___RimuruSpells__Rimuru3T_KS_ls[s__RimuruSpells__Rimuru3T_KS_ls[this]+s__RimuruSpells__Rimuru3T_KS_k[this]])
                                        set s___RimuruSpells__Rimuru3T_KS_ls[s__RimuruSpells__Rimuru3T_KS_ls[this]+s__RimuruSpells__Rimuru3T_KS_k[this]]=null
                                    endif
                                    if s___RimuruSpells__Rimuru3T_KS_ls[s__RimuruSpells__Rimuru3T_KS_ls[this]+s__RimuruSpells__Rimuru3T_KS_k[this] + ring] != null then
                                        call DestroyLightning(s___RimuruSpells__Rimuru3T_KS_ls[s__RimuruSpells__Rimuru3T_KS_ls[this]+s__RimuruSpells__Rimuru3T_KS_k[this] + ring])
                                        set s___RimuruSpells__Rimuru3T_KS_ls[s__RimuruSpells__Rimuru3T_KS_ls[this]+s__RimuruSpells__Rimuru3T_KS_k[this] + ring]=null
                                    endif
