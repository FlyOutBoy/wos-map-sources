                                    set s__BarraganSpells__HeroSpells_Q_y[this]=s__BarraganSpells__HeroSpells_Q_y1[this] + s__BarraganSpells__HeroSpells_Q_move[this] * Sin(s__BarraganSpells__HeroSpells_Q_a[this])
