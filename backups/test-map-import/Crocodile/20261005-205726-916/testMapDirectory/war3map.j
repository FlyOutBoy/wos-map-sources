                    set s__StarrkSpells__StarrkSpells_T_td[this]=null
                    set s__StarrkSpells__StarrkSpells_T_c[this]=null
                    set s__StarrkSpells__StarrkSpells_T_e2[this]=null
                    set s__StarrkSpells__StarrkSpells_T_m_StarrkT[i]=s__StarrkSpells__StarrkSpells_T_m_StarrkT[s__StarrkSpells__StarrkSpells_T_MUI_StarrkT]
                    set s__StarrkSpells__StarrkSpells_T_MUI_StarrkT=s__StarrkSpells__StarrkSpells_T_MUI_StarrkT - 1
                    if s__StarrkSpells__StarrkSpells_T_MUI_StarrkT == - 1 then
                        call PauseTimer(s__StarrkSpells__StarrkSpells_T_t_StarrkT)
                    endif
                    call s__StarrkSpells__StarrkSpells_T_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction

        function s__StarrkSpells__StarrkSpells_T_StarrkT_Start takes unit NewC returns nothing
            local integer this= s__StarrkSpells__StarrkSpells_T__allocate()
            set s__StarrkSpells__StarrkSpells_T_MUI_StarrkT=s__StarrkSpells__StarrkSpells_T_MUI_StarrkT + 1
            set s__StarrkSpells__StarrkSpells_T_m_StarrkT[s__StarrkSpells__StarrkSpells_T_MUI_StarrkT]=this
            set s__StarrkSpells__StarrkSpells_T_c[this]=NewC
            set s__StarrkSpells__StarrkSpells_T_x[this]=GetUnitX(s__StarrkSpells__StarrkSpells_T_c[this])
            set s__StarrkSpells__StarrkSpells_T_y[this]=GetUnitY(s__StarrkSpells__StarrkSpells_T_c[this])
            set s__StarrkSpells__StarrkSpells_T_r[this]=0
            set s__StarrkSpells__StarrkSpells_T_check[this]=0
            set s__StarrkSpells__StarrkSpells_T_a2[this]=0
            set s__StarrkSpells__StarrkSpells_T_r2[this]=10
            set s__StarrkSpells__StarrkSpells_T_check2[this]=GetPlayerId(GetOwningPlayer(s__StarrkSpells__StarrkSpells_T_c[this]))
            set s__StarrkSpells__StarrkSpells_T_move[this]=8
            set s__StarrkSpells__StarrkSpells_T_g[this]=CreateGroup()
            set s__StarrkSpells__StarrkSpells_T_g2[this]=CreateGroup()
            set s__StarrkSpells__StarrkSpells_T_aoe[this]=StarrkT_SearchAoe
            call SaveInteger(hs, GetHandleId(s__StarrkSpells__StarrkSpells_T_c[this]), StringHash("stark t"), 1)
            call AAUniversalTooltips_SetUnitForm(s__StarrkSpells__StarrkSpells_T_c[this] , 2)
            call SaveInteger(hs, GetHandleId(s__StarrkSpells__StarrkSpells_T_c[this]), StringHash("t end"), 0)
            call UnitAddAbility(s__StarrkSpells__StarrkSpells_T_c[this], StarrkF_ID)
            call BlzSetAbilityIcon(StarrkQ_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Starrk_TQ.blp")
            call BlzSetAbilityIcon(StarrkW_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Starrk_TW.blp")
            call SetPlayerAbilityAvailable(Player(s__StarrkSpells__StarrkSpells_T_check2[this]), StarrkR2_ID, false)
            call UnitAddAbility(s__StarrkSpells__StarrkSpells_T_c[this], StarrkR3_ID)
            call SetPlayerAbilityAvailable(Player(s__StarrkSpells__StarrkSpells_T_check2[this]), StarrkT_ID, false)
            call UnitAddAbility(s__StarrkSpells__StarrkSpells_T_c[this], StarrkT2_ID)
            call StartSpellUnit(s__StarrkSpells__StarrkSpells_T_c[this])
            set s__StarrkSpells__StarrkSpells_T_a[this]=GetUnitFacing(s__StarrkSpells__StarrkSpells_T_c[this]) * bj_DEGTORAD // Angle Between points
            call BlzSetUnitFacingEx(s__StarrkSpells__StarrkSpells_T_c[this], s__StarrkSpells__StarrkSpells_T_a[this] * bj_RADTODEG)
            call MakeSound("war3mapimported\\Hero_Starrk_T")
            call MakeSound("war3mapimported\\Hero_Starrk_T2")
            call MakeSound("war3mapimported\\Hero_Starrk_T3")
            set s__StarrkSpells__StarrkSpells_T_dmg[this]=GetHeroAgi(s__StarrkSpells__StarrkSpells_T_c[this], true) * StarrkT_DamageAgiBase
            set s__StarrkSpells__StarrkSpells_T_dmg[this]=s__StarrkSpells__StarrkSpells_T_dmg[this] / 12
            set s__StarrkSpells__StarrkSpells_T_rmax[this]=StarrkT_Duration
            call VisionTimed(GetOwningPlayer(s__StarrkSpells__StarrkSpells_T_c[this]) , s__StarrkSpells__StarrkSpells_T_x[this] , s__StarrkSpells__StarrkSpells_T_y[this] , 1800 , 5)
            if s__StarrkSpells__StarrkSpells_T_MUI_StarrkT == 0 then
                call TimerStart(s__StarrkSpells__StarrkSpells_T_t_StarrkT, 0.05, true, function s__StarrkSpells__StarrkSpells_T_Loop_StarrkT)
            endif
        endfunction

        function s__StarrkSpells__StarrkSpells_T_Loop_StarrkT3 takes nothing returns nothing
            local integer this
            local integer i= 0
            local real kek1= 0
            local real kek2= 0
            loop
                exitwhen i > s__StarrkSpells__StarrkSpells_T_MUI_StarrkT3
                set this=s__StarrkSpells__StarrkSpells_T_m_StarrkT3[i]
                // Keep the shared hit group alive for TT/TR wolves already in flight.
                if s__StarrkSpells__StarrkSpells_T_r[this] <= s__StarrkSpells__StarrkSpells_T_rmax[this] and ( s__StarrkSpells__StarrkSpells_T_b[this] or ( SpellBoolCaster(s__StarrkSpells__StarrkSpells_T_c[this]) and FirstOfGroup(s__StarrkSpells__StarrkSpells_T_g2[this]) != null ) ) then
                    set s__StarrkSpells__StarrkSpells_T_r[this]=s__StarrkSpells__StarrkSpells_T_r[this] + 0.05
                    set s__StarrkSpells__StarrkSpells_T_r[this]=S2R(R2SW(s__StarrkSpells__StarrkSpells_T_r[this], 0, 3))
                    if s__StarrkSpells__StarrkSpells_T_check[this] == 0 then
                        if s__StarrkSpells__StarrkSpells_T_r[this] == 0.05 then
                            call GroupClear(s__StarrkSpells__StarrkSpells_T_g[this])
                            call GroupEnumUnitsOfPlayer(s__StarrkSpells__StarrkSpells_T_g[this], GetOwningPlayer(s__StarrkSpells__StarrkSpells_T_c[this]), null)
                            loop
                                set s__StarrkSpells__StarrkSpells_T_u[this]=FirstOfGroup(s__StarrkSpells__StarrkSpells_T_g[this])
                                exitwhen s__StarrkSpells__StarrkSpells_T_u[this] == null
                                // One T3 order may spend at most ten wolves.
                                if IsUnitInGroup(s__StarrkSpells__StarrkSpells_T_u[this], s__StarrkSpells__StarrkSpells_T_g2[this]) and IsUnitPaused(s__StarrkSpells__StarrkSpells_T_u[this]) == false and s__StarrkSpells__StarrkSpells_T_k[this] < 10 then
                                    call SetUnitFacing(s__StarrkSpells__StarrkSpells_T_u[this], GAngle2(s__StarrkSpells__StarrkSpells_T_u[this] , s__StarrkSpells__StarrkSpells_T_x[this] , s__StarrkSpells__StarrkSpells_T_y[this]) * bj_RADTODEG)
                                    // Do not freeze wolves while TT is being aimed/prepared.
                                    // StarrkT2_Start pauses each wolf only when its attack begins.
                                    call GroupAddUnit(s__StarrkSpells__StarrkSpells_T_g3[this], s__StarrkSpells__StarrkSpells_T_u[this])
                                    call AddSpecialEffectTarget("war3mapImported\\wos_Windwalk Blue Soul.mdl", s__StarrkSpells__StarrkSpells_T_u[this], "chest")
                                    set s__StarrkSpells__StarrkSpells_T_k[this]=s__StarrkSpells__StarrkSpells_T_k[this] + 1
                                endif
                                call GroupRemoveUnit(s__StarrkSpells__StarrkSpells_T_g[this], s__StarrkSpells__StarrkSpells_T_u[this])
                            endloop
                            set s__StarrkSpells__StarrkSpells_T_u[this]=null
                        endif
                        if s__StarrkSpells__StarrkSpells_T_r[this] == 0.6 then
                            set s__StarrkSpells__StarrkSpells_T_k2[this]=0
                            loop
                                exitwhen s__StarrkSpells__StarrkSpells_T_k2[this] >= s__StarrkSpells__StarrkSpells_T_k[this]
                                set s__StarrkSpells__StarrkSpells_T_td[this]=FirstOfGroup(s__StarrkSpells__StarrkSpells_T_g3[this])
                                if s__StarrkSpells__StarrkSpells_T_td[this] != null then
                                    // Deterministic TT formation: every participating wolf
                                    // gets one evenly spaced point on the configured perimeter.
                                    set kek1=StarrkTT_DamageAoe
                                    set kek2=s__StarrkSpells__StarrkSpells_T_a[this] + ( 360.0 / I2R(s__StarrkSpells__StarrkSpells_T_k[this]) ) * I2R(s__StarrkSpells__StarrkSpells_T_k2[this]) * bj_DEGTORAD
                                    call GroupRemoveUnit(s__StarrkSpells__StarrkSpells_T_g2[this], s__StarrkSpells__StarrkSpells_T_td[this])
                                    call s__StarrkSpells__StarrkSpells_T_StarrkT2_Start(s__StarrkSpells__StarrkSpells_T_c[this] , s__StarrkSpells__StarrkSpells_T_td[this] , null , null , s__StarrkSpells__StarrkSpells_T_x[this] + kek1 * Cos(kek2) , s__StarrkSpells__StarrkSpells_T_y[this] + kek1 * Sin(kek2) , s__StarrkSpells__StarrkSpells_T_g[this] , s__StarrkSpells__StarrkSpells_T_k[this] , 0)
                                    call GroupRemoveUnit(s__StarrkSpells__StarrkSpells_T_g3[this], s__StarrkSpells__StarrkSpells_T_td[this])
                                endif
                                set s__StarrkSpells__StarrkSpells_T_k2[this]=s__StarrkSpells__StarrkSpells_T_k2[this] + 1
                            endloop
                            set s__StarrkSpells__StarrkSpells_T_u[this]=null
                            // Keep g alive while all ten wolves are still travelling.
                            // It is the shared hit group that allows each target only one hit.
                            set s__StarrkSpells__StarrkSpells_T_rmax[this]=s__StarrkSpells__StarrkSpells_T_r[this] + 1.2 + StarrkT3_HitGroupDuration
                            set s__StarrkSpells__StarrkSpells_T_b[this]=true
                            // Resume the normal T loop immediately: remaining wolves can
                            // move and perform their usual automatic attacks.
                            
                    call UnitAddAbility(s__StarrkSpells__StarrkSpells_T_c[this], StarrkF_ID)
                            call SaveInteger(hs, GetHandleId(GetOwningPlayer(s__StarrkSpells__StarrkSpells_T_c[this])), StringHash("wolf ult"), 0)
                            call SaveGroupHandle(hs, GetHandleId(s__StarrkSpells__StarrkSpells_T_c[this]), StringHash("wolf group"), s__StarrkSpells__StarrkSpells_T_g2[this])
                        endif
                    elseif s__StarrkSpells__StarrkSpells_T_check[this] == 1 then
                        if s__StarrkSpells__StarrkSpells_T_r[this] == 0.65 then
                            call MakeSound("war3mapimported\\Hero_Starrk_TR")
                        endif
                        if s__StarrkSpells__StarrkSpells_T_r[this] == 0.05 then
                            call GroupClear(s__StarrkSpells__StarrkSpells_T_g[this])
                            call GroupEnumUnitsOfPlayer(s__StarrkSpells__StarrkSpells_T_g[this], GetOwningPlayer(s__StarrkSpells__StarrkSpells_T_c[this]), null)
                            loop
                                set s__StarrkSpells__StarrkSpells_T_u[this]=FirstOfGroup(s__StarrkSpells__StarrkSpells_T_g[this])
                                exitwhen s__StarrkSpells__StarrkSpells_T_u[this] == null
                                // One T3 order may spend at most ten wolves.
                                if IsUnitInGroup(s__StarrkSpells__StarrkSpells_T_u[this], s__StarrkSpells__StarrkSpells_T_g2[this]) and IsUnitPaused(s__StarrkSpells__StarrkSpells_T_u[this]) == false and s__StarrkSpells__StarrkSpells_T_k[this] < 10 then
                                    // Do not freeze wolves while TR is being aimed/prepared.
                                    // StarrkT2_Start pauses each wolf only when its attack begins.
                                    call GroupAddUnit(s__StarrkSpells__StarrkSpells_T_g3[this], s__StarrkSpells__StarrkSpells_T_u[this])
                                    call AddSpecialEffectTarget("war3mapImported\\wos_Windwalk Blue Soul.mdl", s__StarrkSpells__StarrkSpells_T_u[this], "chest")
                                    set s__StarrkSpells__StarrkSpells_T_k[this]=s__StarrkSpells__StarrkSpells_T_k[this] + 1
                                endif
                                call GroupRemoveUnit(s__StarrkSpells__StarrkSpells_T_g[this], s__StarrkSpells__StarrkSpells_T_u[this])
                            endloop
                            set s__StarrkSpells__StarrkSpells_T_u[this]=null
                            set s__StarrkSpells__StarrkSpells_T_k2[this]=0
                            call GroupClear(s__StarrkSpells__StarrkSpells_T_g[this])
                            call GroupEnumUnitsOfPlayer(s__StarrkSpells__StarrkSpells_T_g[this], GetOwningPlayer(s__StarrkSpells__StarrkSpells_T_c[this]), null)
                            loop
                                set s__StarrkSpells__StarrkSpells_T_u[this]=FirstOfGroup(s__StarrkSpells__StarrkSpells_T_g[this])
                                exitwhen s__StarrkSpells__StarrkSpells_T_u[this] == null
                                if IsUnitInGroup(s__StarrkSpells__StarrkSpells_T_u[this], s__StarrkSpells__StarrkSpells_T_g3[this]) then
                                    call DestroyEffect(AddSpecialEffectTarget("war3mapimported\\wos_by_wood_k_baozha_2_blue.mdx", s__StarrkSpells__StarrkSpells_T_u[this], "chest"))
                                    set kek2=GetRandomReal(- 25, 5)
                                    call SetUnitPosition(s__StarrkSpells__StarrkSpells_T_u[this], s__StarrkSpells__StarrkSpells_T_x[this] + ( s__StarrkSpells__StarrkSpells_T_aoe[this] + kek2 ) * Cos(360 / s__StarrkSpells__StarrkSpells_T_k[this] * s__StarrkSpells__StarrkSpells_T_k2[this] * bj_DEGTORAD), s__StarrkSpells__StarrkSpells_T_y[this] + ( s__StarrkSpells__StarrkSpells_T_aoe[this] + kek2 ) * Sin(360 / s__StarrkSpells__StarrkSpells_T_k[this] * s__StarrkSpells__StarrkSpells_T_k2[this] * bj_DEGTORAD))
                                    call SetUnitFacing(s__StarrkSpells__StarrkSpells_T_u[this], 360 / s__StarrkSpells__StarrkSpells_T_k[this] * s__StarrkSpells__StarrkSpells_T_k2[this])
                                    set s__StarrkSpells__StarrkSpells_T_k2[this]=s__StarrkSpells__StarrkSpells_T_k2[this] + 1
                                endif
                                call GroupRemoveUnit(s__StarrkSpells__StarrkSpells_T_g[this], s__StarrkSpells__StarrkSpells_T_u[this])
                            endloop
                            set s__StarrkSpells__StarrkSpells_T_u[this]=null
                        endif
                        if s__StarrkSpells__StarrkSpells_T_r[this] == 1.2 then
                            call UnitRemoveAbility(s__StarrkSpells__StarrkSpells_T_c[this], 'Avul')
                            call PauseUnit(s__StarrkSpells__StarrkSpells_T_c[this], false)
                            set s__StarrkSpells__StarrkSpells_T_k2[this]=0
                            loop
                                exitwhen s__StarrkSpells__StarrkSpells_T_k2[this] >= s__StarrkSpells__StarrkSpells_T_k[this]
                                set s__StarrkSpells__StarrkSpells_T_td[this]=FirstOfGroup(s__StarrkSpells__StarrkSpells_T_g3[this])
                                if s__StarrkSpells__StarrkSpells_T_td[this] != null then
                                    set kek1=GetRandomReal(650, 1000)
                                    set kek2=GetUnitFacing(s__StarrkSpells__StarrkSpells_T_td[this]) * bj_DEGTORAD //GetRandomReal(0, 359) * bj_DEGTORAD
                                    call GroupRemoveUnit(s__StarrkSpells__StarrkSpells_T_g2[this], s__StarrkSpells__StarrkSpells_T_td[this])
                                    call s__StarrkSpells__StarrkSpells_T_StarrkT2_Start(s__StarrkSpells__StarrkSpells_T_c[this] , s__StarrkSpells__StarrkSpells_T_td[this] , null , null , s__StarrkSpells__StarrkSpells_T_x[this] + kek1 * Cos(GetUnitFacing(s__StarrkSpells__StarrkSpells_T_td[this]) * bj_DEGTORAD) , s__StarrkSpells__StarrkSpells_T_y[this] + kek1 * Sin(GetUnitFacing(s__StarrkSpells__StarrkSpells_T_td[this]) * bj_DEGTORAD) , s__StarrkSpells__StarrkSpells_T_g[this] , s__StarrkSpells__StarrkSpells_T_k[this] , 1)
                                    call GroupRemoveUnit(s__StarrkSpells__StarrkSpells_T_g3[this], s__StarrkSpells__StarrkSpells_T_td[this])
                                endif
                                set s__StarrkSpells__StarrkSpells_T_k2[this]=s__StarrkSpells__StarrkSpells_T_k2[this] + 1
                            endloop
                            set s__StarrkSpells__StarrkSpells_T_u[this]=null
                            call SaveGroupHandle(hs, GetHandleId(s__StarrkSpells__StarrkSpells_T_c[this]), StringHash("wolf group"), s__StarrkSpells__StarrkSpells_T_g2[this])
                            call UnitAddAbility(s__StarrkSpells__StarrkSpells_T_c[this], StarrkF_ID)
                    
                            // Keep g alive while all ten wolves are still travelling.
                            // It is the shared hit group that allows each target only one hit.
                            set s__StarrkSpells__StarrkSpells_T_rmax[this]=s__StarrkSpells__StarrkSpells_T_r[this] + 1.2 + StarrkT3_HitGroupDuration
                            set s__StarrkSpells__StarrkSpells_T_b[this]=true
                            // Resume the normal T loop immediately: remaining wolves can
                            // move and perform their usual automatic attacks.
                            call SaveInteger(hs, GetHandleId(GetOwningPlayer(s__StarrkSpells__StarrkSpells_T_c[this])), StringHash("wolf ult"), 0)
                        endif
                    endif
                else
                    call DestroyGroup(s__StarrkSpells__StarrkSpells_T_g3[this])
                    call StopSpellUnit(s__StarrkSpells__StarrkSpells_T_c[this])
                    set s__StarrkSpells__StarrkSpells_T_g3[this]=null
                    call SaveInteger(hs, GetHandleId(GetOwningPlayer(s__StarrkSpells__StarrkSpells_T_c[this])), StringHash("wolf ult"), 0)
                    // T is still running: make both T3 orders available again.
                    if LoadInteger(hs, GetHandleId(s__StarrkSpells__StarrkSpells_T_c[this]), StringHash("stark t")) == 1 then
                    //    call SetPlayerAbilityAvailable(Player(check2), StarrkR3_ID, true)
                   //     call SetPlayerAbilityAvailable(Player(check2), StarrkT2_ID, true)
                    endif
                    call DestroyGroup(s__StarrkSpells__StarrkSpells_T_g[this])
                    set s__StarrkSpells__StarrkSpells_T_g[this]=null
                    set s__StarrkSpells__StarrkSpells_T_td[this]=null
                    set s__StarrkSpells__StarrkSpells_T_c[this]=null
                    set s__StarrkSpells__StarrkSpells_T_m_StarrkT3[i]=s__StarrkSpells__StarrkSpells_T_m_StarrkT3[s__StarrkSpells__StarrkSpells_T_MUI_StarrkT3]
                    set s__StarrkSpells__StarrkSpells_T_MUI_StarrkT3=s__StarrkSpells__StarrkSpells_T_MUI_StarrkT3 - 1
                    if s__StarrkSpells__StarrkSpells_T_MUI_StarrkT3 == - 1 then
                        call PauseTimer(s__StarrkSpells__StarrkSpells_T_t_StarrkT3)
                    endif
                    call s__StarrkSpells__StarrkSpells_T_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction

        function s__StarrkSpells__StarrkSpells_T_StarrkT3_Start takes unit NewC,real NewX,real NewY,integer NewK returns nothing
            local integer this= s__StarrkSpells__StarrkSpells_T__allocate()
            set s__StarrkSpells__StarrkSpells_T_MUI_StarrkT3=s__StarrkSpells__StarrkSpells_T_MUI_StarrkT3 + 1
            set s__StarrkSpells__StarrkSpells_T_m_StarrkT3[s__StarrkSpells__StarrkSpells_T_MUI_StarrkT3]=this
            set s__StarrkSpells__StarrkSpells_T_c[this]=NewC
            set s__StarrkSpells__StarrkSpells_T_x[this]=NewX
            set s__StarrkSpells__StarrkSpells_T_y[this]=NewY
            set s__StarrkSpells__StarrkSpells_T_k[this]=0
            set s__StarrkSpells__StarrkSpells_T_check[this]=NewK
            set s__StarrkSpells__StarrkSpells_T_aoe[this]=300
            set s__StarrkSpells__StarrkSpells_T_r[this]=0
            set s__StarrkSpells__StarrkSpells_T_b[this]=false
            set s__StarrkSpells__StarrkSpells_T_g2[this]=LoadGroupHandle(hs, GetHandleId(s__StarrkSpells__StarrkSpells_T_c[this]), StringHash("wolf group"))
            set s__StarrkSpells__StarrkSpells_T_g3[this]=CreateGroup()
            set s__StarrkSpells__StarrkSpells_T_g[this]=CreateGroup()
                    call UnitRemoveAbility(s__StarrkSpells__StarrkSpells_T_c[this], StarrkF_ID)
            set s__StarrkSpells__StarrkSpells_T_a[this]=GAngle2(s__StarrkSpells__StarrkSpells_T_c[this] , s__StarrkSpells__StarrkSpells_T_x[this] , s__StarrkSpells__StarrkSpells_T_y[this]) // Angle Between points
            set s__StarrkSpells__StarrkSpells_T_check2[this]=GetPlayerId(GetOwningPlayer(s__StarrkSpells__StarrkSpells_T_c[this]))
            // T remains active. Disable both T3 buttons only while this order runs.
            call SetPlayerAbilityAvailable(Player(s__StarrkSpells__StarrkSpells_T_check2[this]), StarrkR3_ID, false)
            call SetPlayerAbilityAvailable(Player(s__StarrkSpells__StarrkSpells_T_check2[this]), StarrkT2_ID, false)
            if s__StarrkSpells__StarrkSpells_T_check[this] == 0 then
                call MakeSound("war3mapimported\\Hero_Starrk_TT2")
            else
               call StartSpellUnit(s__StarrkSpells__StarrkSpells_T_c[this])
            endif
            call MakeSound("war3mapimported\\Hero_Starrk_TT1")
            call SaveInteger(hs, GetHandleId(GetOwningPlayer(s__StarrkSpells__StarrkSpells_T_c[this])), StringHash("wolf ult"), 1)
            set s__StarrkSpells__StarrkSpells_T_rmax[this]=8
            if s__StarrkSpells__StarrkSpells_T_check[this] == 0 then
                call VisionTimed(GetOwningPlayer(s__StarrkSpells__StarrkSpells_T_c[this]) , s__StarrkSpells__StarrkSpells_T_x[this] , s__StarrkSpells__StarrkSpells_T_y[this] , StarrkTT_DamageAoe + StarrkT_DamageAoe , 3)
            else
                call VisionTimed(GetOwningPlayer(s__StarrkSpells__StarrkSpells_T_c[this]) , s__StarrkSpells__StarrkSpells_T_x[this] , s__StarrkSpells__StarrkSpells_T_y[this] , 1600 , 3)
            endif
            if s__StarrkSpells__StarrkSpells_T_MUI_StarrkT3 == 0 then
                call TimerStart(s__StarrkSpells__StarrkSpells_T_t_StarrkT3, 0.05, true, function s__StarrkSpells__StarrkSpells_T_Loop_StarrkT3)
            endif
        endfunction


    //----------------------------Starrk-----------------------------------------------
      
    function StarrkPas takes unit c returns nothing
        local group g= CreateGroup()
        local unit u= null
        local real x= GetUnitX(c)
        local real y= GetUnitY(c)
        local real aoe= 0
        local real scale= 0.85
        local integer lvl= GetHeroLevel(c)
        local real hp= GetUnitState(c, UNIT_STATE_MAX_LIFE) * 0.01
        local real mp= GetUnitState(c, UNIT_STATE_MAX_MANA) * 0.01
        local boolean b= false
        local integer check= 0
        if lvl >= 12 then
            if lvl >= 35 then
                set aoe=StarkG_Aoe35
                set scale=1.25
            elseif lvl >= 25 then
                set aoe=StarkG_Aoe25
                set scale=1.05
            else
                set aoe=StarkG_Aoe12
            endif
            call GroupEnumUnitsInRange(g, x, y, aoe, null)
            loop
                set u=FirstOfGroup(g)
                exitwhen u == null
                if IsUnitAlly(u, GetOwningPlayer(c)) and GetOwningPlayer(u) != Player(PLAYER_NEUTRAL_PASSIVE) and u != c then
                    set check=check + 1
                endif
                call GroupRemoveUnit(g, u)
            endloop
            if check == 0 then
                set b=true
            endif
            if b == true then
                if GetUnitAbilityLevel(c, Starrk_Pas1ID) == 0 then
                    call UnitAddAbility(c, Starrk_Pas1ID)
                    call s__GearSystems2___KS_RemoveAbility_RemoveAbility_Start((c ) , (( StarkG_TimeStatAdd )*1.0) , ( Starrk_Pas1ID ) , ( 1)) // INLINED!!
                elseif GetUnitAbilityLevel(c, Starrk_Pas2ID) == 0 then
                    call UnitAddAbility(c, Starrk_Pas2ID)
                    call s__GearSystems2___KS_RemoveAbility_RemoveAbility_Start((c ) , (( StarkG_TimeStatAdd )*1.0) , ( Starrk_Pas2ID ) , ( 1)) // INLINED!!
                elseif GetUnitAbilityLevel(c, Starrk_Pas3ID) == 0 and lvl >= 25 then
                    call UnitAddAbility(c, Starrk_Pas3ID)
                    call s__GearSystems2___KS_RemoveAbility_RemoveAbility_Start((c ) , (( StarkG_TimeStatAdd )*1.0) , ( Starrk_Pas3ID ) , ( 1)) // INLINED!!
                elseif GetUnitAbilityLevel(c, Starrk_Pas4ID) == 0 and lvl >= 25 then
                    call UnitAddAbility(c, Starrk_Pas4ID)
                    call s__GearSystems2___KS_RemoveAbility_RemoveAbility_Start((c ) , (( StarkG_TimeStatAdd )*1.0) , ( Starrk_Pas4ID ) , ( 1)) // INLINED!!
                elseif GetUnitAbilityLevel(c, Starrk_Pas5ID) == 0 and lvl >= 35 then
                    call UnitAddAbility(c, Starrk_Pas5ID)
                    call s__GearSystems2___KS_RemoveAbility_RemoveAbility_Start((c ) , (( StarkG_TimeStatAdd )*1.0) , ( Starrk_Pas5ID ) , ( 1)) // INLINED!!
                elseif GetUnitAbilityLevel(c, Starrk_Pas6ID) == 0 and lvl >= 35 then
                    call UnitAddAbility(c, Starrk_Pas6ID)
                    call s__GearSystems2___KS_RemoveAbility_RemoveAbility_Start((c ) , (( StarkG_TimeStatAdd )*1.0) , ( Starrk_Pas6ID ) , ( 1)) // INLINED!!
                endif
                call SetHpCurrent2(c , c , hp * scale)
                call SetMpCurrent(c , mp * scale)
                call DestroyEffect(AddSpecialEffectTarget("war3mapimported\\wos_longskill_point_39.mdx", c, "origin"))
            endif
        endif
        call DestroyGroup(g)
        set u=null
        set g=null
    endfunction
    function StarrkQ_Start takes unit c,real x,real y returns nothing
        call s__StarrkSpells__StarrkSpells_Q_StarrkQ_Start(c , x , y)
    endfunction
    function StarrkW_Start takes unit c,unit td returns nothing
        call s__StarrkSpells__StarrkSpells_W_StarrkW_Start(c , td)
    endfunction
    function StarrkR_Start takes unit c,unit td returns nothing
        call s__StarrkSpells__StarrkSpells_R_StarrkR3_Start(c , td)
    endfunction
    function StarrkE_Attack_Start takes unit c,real x,real y returns nothing
        local real dmg= GetAttack(c)
        call s__StarrkSpells__StarrkSpells_Utility_StarrkPas2_Start(c , x , y , dmg)
        call SaveReal(hs, GetHandleId(c), StringHash("atk base dmg"), 0)
    endfunction
    function StarrkE2_Start takes unit c,real x,real y returns nothing
        local real sr
        local real max= StarrkE2_RangeBase + ( StarrkE2_RangeStep * ( GetUnitAbilityLevel(c, StarrkE_ID) - 1 ) )
        local real a= GAngle2(c , x , y)
        if GetUnitAbilityLevel(c, StarrkE_ID) == 5 then
            set max=StarrkE2_RangeBase + ( StarrkE2_RangeStep * ( GetUnitAbilityLevel(c, StarrkE_ID) - 2 ) )
        endif
        call MakeSound("war3mapimported\\Hero_Starrk_EE")
        if SR3(c , x , y) > max then
            set sr=max
        else
            set sr=SR3(c , x , y)
        endif
        set x=GetUnitX(c) + sr * Cos(a)
        set y=GetUnitY(c) + sr * Sin(a)
        call DestroyEffect(EffectSpawn("war3mapImported\\wos_Mdx_Effect_MirrorImage_Black.mdx" , GetUnitX(c) , GetUnitY(c) , GetUnitFacing(c) , 1.5 , 1.8 , 0))
        call PosUnit(c , x , y)
        call DestroyEffect(EffectSpawn("war3mapImported\\wos_Mdx_Effect_MirrorImage_Black.mdx" , GetUnitX(c) , GetUnitY(c) , GetUnitFacing(c) , 1.5 , 1.8 , 0))
    endfunction
    function StarrkE_Start takes unit c returns nothing
        if LoadInteger(hs, GetHandleId(GetOwningPlayer(c)), StringHash("morph e")) == 0 then
            call s__StarrkSpells__StarrkSpells_E_StarrkE_Start(c)
        else
            //call IssueImmediateOrder(c, "stop")
            call DisplayTimedTextToPlayer(GetOwningPlayer(c), 0, 0, 0.1, "|c00FF0303You already in morph , stop doing that|r")
        endif
    endfunction
    function StarrkR3_Start takes unit c returns nothing
        call s__StarrkSpells__StarrkSpells_T_StarrkT3_Start(c , GetUnitX(c) , GetUnitY(c) , 1)
    endfunction
    function StarrkR2_Start takes unit c,real x,real y returns nothing
        call s__StarrkSpells__StarrkSpells_R_StarrkR_Start(c , x , y)
    endfunction
    function StarrkT_Start takes unit c returns nothing
        call s__StarrkSpells__StarrkSpells_T_StarrkT_Start(c)
    endfunction
    function StarrkF_Start takes unit c returns nothing
        call SaveInteger(hs, GetHandleId(c), StringHash("t end"), 1)
    endfunction
    function StarrkT2_Start takes unit c,real x,real y returns nothing
        call s__StarrkSpells__StarrkSpells_T_StarrkT3_Start(c , x , y , 0)
    endfunction
    

