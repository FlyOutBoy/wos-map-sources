    function AAUniversalTooltips_T_Element takes integer elem returns string
        if elem == 1 then
            return "|cffffcc00Applies:|r Fire debuff|n"
        elseif elem == 2 then
            return "|cffffcc00Applies:|r Water debuff|n"
        elseif elem == 3 then
            return "|cffffcc00Applies:|r Electro debuff|n"
        endif
        return ""
    endfunction
    
