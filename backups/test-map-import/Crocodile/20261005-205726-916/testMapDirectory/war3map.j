        call UnitAddAbility(u, 'A0E0')
        call s__GearSystems2___KS_RemoveAbility_RemoveAbility_Start((u ) , (( 1.5 )*1.0) , ( 'A0E0' ) , ( 1)) // INLINED!!
        
        call UnitAddAbility(u, 'A019')
