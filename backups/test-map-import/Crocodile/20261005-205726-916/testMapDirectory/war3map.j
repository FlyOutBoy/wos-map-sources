                set s__AlucardSpells__AlucardSpells_E_scale2[this]=0.3
                set s__AlucardSpells__AlucardSpells_E_e[this]=EffectSpawn("war3mapImported\\wos_[By XeSHTeG]Dog Alucard.mdl" , GetUnitX(s__AlucardSpells__AlucardSpells_E_c[this]) + 100 * Cos(s__AlucardSpells__AlucardSpells_E_a[this]) , GetUnitY(s__AlucardSpells__AlucardSpells_E_c[this]) + 100 * Sin(s__AlucardSpells__AlucardSpells_E_a[this]) , s__AlucardSpells__AlucardSpells_E_a[this] * bj_RADTODEG , 1 , s__AlucardSpells__AlucardSpells_E_scale[this] , 105 * 1.45)
                call ColorEffDummy4(s__AlucardSpells__AlucardSpells_E_e[this] , 0 , 255 , 255 , 255 , 0.5)
                set s__AlucardSpells__AlucardSpells_E_r4[this]=999
                set s__AlucardSpells__AlucardSpells_E_check[this]=1
                set s__AlucardSpells__AlucardSpells_E_r7[this]=s__AlucardSpells__AlucardSpells_E_r7[this] - 350
                call SetUnitAnimationByIndex(s__AlucardSpells__AlucardSpells_E_c[this], 0)
                call SetUnitTimeScale(s__AlucardSpells__AlucardSpells_E_c[this], 1.45)
                call MakeSound("war3mapimported\\Hero_Alucard_RE")
                call MakeSound("war3mapimported\\Hero_Alucard_RE2")
            else
                set s__AlucardSpells__AlucardSpells_E_move[this]=100
                set s__AlucardSpells__AlucardSpells_E_r5[this]=150
                call SetUnitAnimationByIndex(s__AlucardSpells__AlucardSpells_E_c[this], 9)
                call SetUnitTimeScale(s__AlucardSpells__AlucardSpells_E_c[this], 1)
