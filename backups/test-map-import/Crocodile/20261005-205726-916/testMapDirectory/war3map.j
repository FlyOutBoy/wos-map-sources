    call s__AlucardSpells__AlucardSpells_Utility_AlucardPas2_Start((c)) // INLINED!!
    endif
    endif
    if Inori_ID == id then
    if k >= 6 and LoadInteger(hs, GetHandleId(c), StringHash("pas start")) == 0 then
