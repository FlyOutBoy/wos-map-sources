                    set s__GearSystems2___KS_DamageOverTime_r[this]=999
                    set s__GearSystems2___KS_DamageOverTime_dmg[this]=0
                    endif
                    endif
                    call dmgphys(s__GearSystems2___KS_DamageOverTime_c[this] , s__GearSystems2___KS_DamageOverTime_td[this] , s__GearSystems2___KS_DamageOverTime_dmg[this])
                if s__GearSystems2___KS_DamageOverTime_s[this] == "murasume" then
                    set MurasameTrigger=false
                    endif
                elseif s__GearSystems2___KS_DamageOverTime_k[this] == 1 then
                    call dmgmag(s__GearSystems2___KS_DamageOverTime_c[this] , s__GearSystems2___KS_DamageOverTime_td[this] , s__GearSystems2___KS_DamageOverTime_dmg[this])
                else
                    if s__GearSystems2___KS_DamageOverTime_s[this] == "murasume" then
                    set MurasameTrigger=true
                    if GetUnitAbilityLevel(s__GearSystems2___KS_DamageOverTime_td[this], 'B005') > 0 then
                    set s__GearSystems2___KS_DamageOverTime_r[this]=999
                    set s__GearSystems2___KS_DamageOverTime_dmg[this]=0
