            set s__AlucardSpells__AlucardSpells_W_check[this]=1
            set s__AlucardSpells__AlucardSpells_W_dmg[this]=s__AlucardSpells__AlucardSpells_W_dmg[this] + GetHeroAgi(s__AlucardSpells__AlucardSpells_W_c[this], true)
            endif
            if GetRandomInt(1, 2) == 1 then
                call MakeSound("war3mapimported\\Hero_Alucard_W01")
            else
                call MakeSound("war3mapimported\\Hero_Alucard_W02")
            endif
            if s__AlucardSpells__AlucardSpells_W_MUI_AlucardW == 0 then
