                        endif
                    elseif s__RaidenSpells__RaidenQ_KS_k2[this] == 1 then
                        if s__RaidenSpells__RaidenQ_KS_r[this] == s__RaidenSpells__RaidenQ_KS_r_prepare[this] - 0.03 then
                            set s__RaidenSpells__RaidenQ_KS_e[this]=EffectSpawnColor("war3mapImported\\wos_zk_shiki_dash.mdl" , GetUnitX(s__RaidenSpells__RaidenQ_KS_c[this]) + 200 * Cos(s__RaidenSpells__RaidenQ_KS_a[this]) , GetUnitY(s__RaidenSpells__RaidenQ_KS_c[this]) + 200 * Sin(s__RaidenSpells__RaidenQ_KS_a[this]) , s__RaidenSpells__RaidenQ_KS_a[this] * bj_RADTODEG , 0.9 , 1.05 , 10 , 255 , 255 , 255 , 195)
                            call EMUE(s__RaidenSpells__RaidenQ_KS_e[this] , 400 , 0.3 , s__RaidenSpells__RaidenQ_KS_a[this])
