        function s__KiritoSpells__KiritoSpells_Q_Loop_KiritoQ takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__KiritoSpells__KiritoSpells_Q_MUI_KiritoQ
                set this=s__KiritoSpells__KiritoSpells_Q_m_KiritoQ[i]
                if SpellBoolCaster(s__KiritoSpells__KiritoSpells_Q_c[this]) and s__KiritoSpells__KiritoSpells_Q_r[this] <= s__KiritoSpells__KiritoSpells_Q_rmax[this] then
                    set s__KiritoSpells__KiritoSpells_Q_r[this]=RoundReal(s__KiritoSpells__KiritoSpells_Q_r[this] + 0.03 , 3)
                    call DebugUnit2(s__KiritoSpells__KiritoSpells_Q_c[this])
                    set s__KiritoSpells__KiritoSpells_Q_x[this]=GetUnitX(s__KiritoSpells__KiritoSpells_Q_c[this])
                    set s__KiritoSpells__KiritoSpells_Q_y[this]=GetUnitY(s__KiritoSpells__KiritoSpells_Q_c[this])
                    if s__KiritoSpells__KiritoSpells_Q_r[this] == 0.18 then
                        call SetUnitAnimation(s__KiritoSpells__KiritoSpells_Q_c[this], "spell two")
                    endif
                    if s__KiritoSpells__KiritoSpells_Q_r[this] == 0.27 then
                        call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_BY_Wood_Eff_Ord_DanGe_Wid_ChongFengQiLiu.mdl" , s__KiritoSpells__KiritoSpells_Q_x[this] + 300 * Cos(s__KiritoSpells__KiritoSpells_Q_a[this]) , s__KiritoSpells__KiritoSpells_Q_y[this] + 300 * Sin(s__KiritoSpells__KiritoSpells_Q_a[this]) , s__KiritoSpells__KiritoSpells_Q_a[this] * bj_RADTODEG , 1.2 , 1.95 , 0 , 255 , 255 , 255 , 125))
                    endif
                    if s__KiritoSpells__KiritoSpells_Q_r[this] == 0.45 then
                        set s__KiritoSpells__KiritoSpells_Q_e[this]=EffectSpawn("war3mapImported\\wos_BDEF (55).mdl" , GetUnitX(s__KiritoSpells__KiritoSpells_Q_c[this]) + 35 * Cos(s__KiritoSpells__KiritoSpells_Q_a[this]) , GetUnitY(s__KiritoSpells__KiritoSpells_Q_c[this]) + 35 * Sin(s__KiritoSpells__KiritoSpells_Q_a[this]) , s__KiritoSpells__KiritoSpells_Q_a[this] * bj_RADTODEG + 90 , 0.66 , 1.5 , 50)
                        call DestroyEffect(s__KiritoSpells__KiritoSpells_Q_e[this])
                        call BlzSetSpecialEffectAlpha(s__KiritoSpells__KiritoSpells_Q_e[this], 0)
                        call ColorEffDummy4(s__KiritoSpells__KiritoSpells_Q_e[this] , 0 , 255 , 255 , 255 , 0.25)
                        call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_BY_Wood_Eff_Ord_DanGe_Dus_Kuosan_1_2_1.mdl" , s__KiritoSpells__KiritoSpells_Q_x[this] , s__KiritoSpells__KiritoSpells_Q_y[this] , s__KiritoSpells__KiritoSpells_Q_a[this] * bj_RADTODEG , 1.25 , 1.55 , 0 , 255 , 255 , 255 , 125))
                    endif
                    if s__KiritoSpells__KiritoSpells_Q_r[this] >= 0.45 then
                        call MoveUnit(s__KiritoSpells__KiritoSpells_Q_c[this] , s__KiritoSpells__KiritoSpells_Q_move[this] , s__KiritoSpells__KiritoSpells_Q_a[this])
                        call BlzSetSpecialEffectPosition(s__KiritoSpells__KiritoSpells_Q_e[this], GetUnitX(s__KiritoSpells__KiritoSpells_Q_c[this]) + 35 * Cos(s__KiritoSpells__KiritoSpells_Q_a[this]), GetUnitY(s__KiritoSpells__KiritoSpells_Q_c[this]) + 35 * Sin(s__KiritoSpells__KiritoSpells_Q_a[this]), 50)
                        call BlzSetUnitFacingEx(s__KiritoSpells__KiritoSpells_Q_c[this], s__KiritoSpells__KiritoSpells_Q_a[this] * bj_RADTODEG)
                        set s__KiritoSpells__KiritoSpells_Q_r4[this]=s__KiritoSpells__KiritoSpells_Q_r4[this] + s__KiritoSpells__KiritoSpells_Q_move[this]
                        if s__KiritoSpells__KiritoSpells_Q_r4[this] >= s__KiritoSpells__KiritoSpells_Q_r6[this] then
                        set s__KiritoSpells__KiritoSpells_Q_r[this]=9999
                        endif
                        call GroupClear(s__KiritoSpells__KiritoSpells_Q_g[this])
                        call GroupEnumUnitsInRange(s__KiritoSpells__KiritoSpells_Q_g[this], s__KiritoSpells__KiritoSpells_Q_x[this], s__KiritoSpells__KiritoSpells_Q_y[this], s__KiritoSpells__KiritoSpells_Q_aoe[this], NoDecor_Cond)
                        loop
                            set s__KiritoSpells__KiritoSpells_Q_u[this]=FirstOfGroup(s__KiritoSpells__KiritoSpells_Q_g[this])
                            exitwhen s__KiritoSpells__KiritoSpells_Q_u[this] == null
                            if IsUnitEnemy(s__KiritoSpells__KiritoSpells_Q_u[this], GetOwningPlayer(s__KiritoSpells__KiritoSpells_Q_c[this])) and SpellBool(s__KiritoSpells__KiritoSpells_Q_u[this]) then
                                set s__KiritoSpells__KiritoSpells_Q_k2[this]=s__KiritoSpells__KiritoSpells_Q_k2[this] + 1
                                if s__KiritoSpells__KiritoSpells_Q_k2[this] == 1 then
                                    call MakeSound("war3mapImported\\Hero_Kirito_Q2")
                                endif
                                if IsUnitInGroup(s__KiritoSpells__KiritoSpells_Q_u[this], s__KiritoSpells__KiritoSpells_Q_g2[this]) == false then
                                    call dmgphys(s__KiritoSpells__KiritoSpells_Q_c[this] , s__KiritoSpells__KiritoSpells_Q_u[this] , s__KiritoSpells__KiritoSpells_Q_dmg[this])
                                    call GroupAddUnit(s__KiritoSpells__KiritoSpells_Q_g2[this], s__KiritoSpells__KiritoSpells_Q_u[this])
                                    call StunUnit(s__KiritoSpells__KiritoSpells_Q_c[this] , s__KiritoSpells__KiritoSpells_Q_u[this] , KiritoQ_StunDuration)
                                    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", s__KiritoSpells__KiritoSpells_Q_u[this], "chest"))
                                    call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\wos_ZK_BMSword-qi explosion_Lan.mdl", s__KiritoSpells__KiritoSpells_Q_u[this], "chest"))
                                endif
                                if s__KiritoSpells__KiritoSpells_Q_check2[this] == 1 then
                                call MoveUnit(s__KiritoSpells__KiritoSpells_Q_u[this] , s__KiritoSpells__KiritoSpells_Q_move[this] , s__KiritoSpells__KiritoSpells_Q_a[this])
                                else
                                if s__KiritoSpells__KiritoSpells_Q_td[this] == null then
                                set s__KiritoSpells__KiritoSpells_Q_td[this]=s__KiritoSpells__KiritoSpells_Q_u[this]
                                endif
                                call PosUnit(s__KiritoSpells__KiritoSpells_Q_td[this] , GetUnitX(s__KiritoSpells__KiritoSpells_Q_c[this]) + 175 * Cos(s__KiritoSpells__KiritoSpells_Q_a[this]) , GetUnitY(s__KiritoSpells__KiritoSpells_Q_c[this]) + 175 * Sin(s__KiritoSpells__KiritoSpells_Q_a[this]))
                                endif
                            endif
                            call GroupRemoveUnit(s__KiritoSpells__KiritoSpells_Q_g[this], s__KiritoSpells__KiritoSpells_Q_u[this])
                        endloop
                        if s__KiritoSpells__KiritoSpells_Q_r2[this] > 0.0 then
                            set s__KiritoSpells__KiritoSpells_Q_r2[this]=0
                            set s__KiritoSpells__KiritoSpells_Q_x[this]=s__KiritoSpells__KiritoSpells_Q_x[this] + 150 * Cos(s__KiritoSpells__KiritoSpells_Q_a[this])
                            set s__KiritoSpells__KiritoSpells_Q_y[this]=s__KiritoSpells__KiritoSpells_Q_y[this] + 150 * Sin(s__KiritoSpells__KiritoSpells_Q_a[this])
                            set s__KiritoSpells__KiritoSpells_Q_r5[this]=GetRandomReal(0.4, 1)
                            call DecorRemove(s__KiritoSpells__KiritoSpells_Q_c[this] , s__KiritoSpells__KiritoSpells_Q_x[this] , s__KiritoSpells__KiritoSpells_Q_y[this] , s__KiritoSpells__KiritoSpells_Q_aoe[this] , 25)
                            call ColorEffDummy3Alpha((EffectSpawn3("war3mapimported\\wos_xxxxuanfeng2.mdl" , s__KiritoSpells__KiritoSpells_Q_x[this] , s__KiritoSpells__KiritoSpells_Q_y[this] , s__KiritoSpells__KiritoSpells_Q_a[this] * bj_RADTODEG , s__KiritoSpells__KiritoSpells_Q_r5[this] , GetRandomReal(0.75, 1.35) , 100 , - 90) ) , (( 0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.3)*1.0)) // INLINED!!
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_blue-texiao-buff2.mdl" , s__KiritoSpells__KiritoSpells_Q_x[this] , s__KiritoSpells__KiritoSpells_Q_y[this] , GetRandomReal(0, 359) , 1.95 , 5.25 , 0))
                        else
                            set s__KiritoSpells__KiritoSpells_Q_r2[this]=s__KiritoSpells__KiritoSpells_Q_r2[this] + 0.03
                        endif
                        if s__KiritoSpells__KiritoSpells_Q_r3[this] > 0.03 then
                            set s__KiritoSpells__KiritoSpells_Q_r3[this]=0
                            set s__KiritoSpells__KiritoSpells_Q_x[this]=s__KiritoSpells__KiritoSpells_Q_x[this] + 150 * Cos(s__KiritoSpells__KiritoSpells_Q_a[this])
                            set s__KiritoSpells__KiritoSpells_Q_y[this]=s__KiritoSpells__KiritoSpells_Q_y[this] + 150 * Sin(s__KiritoSpells__KiritoSpells_Q_a[this])
                            set s__KiritoSpells__KiritoSpells_Q_r5[this]=GetRandomReal(0.4, 1)
                            if GetUnitAbilityLevel(s__KiritoSpells__KiritoSpells_Q_c[this], KiritoR_AS) > 0 then
                                call DestroyEffect(EffectSpawn("war3mapImported\\wos_acg_dajiqiquan4.mdx" , s__KiritoSpells__KiritoSpells_Q_x[this] , s__KiritoSpells__KiritoSpells_Q_y[this] , GetRandomReal(0, 359) , 1.5 , 2.5 , 3))
                                call DestroyEffect(EffectSpawn("war3mapImported\\wos_BY_Wood_Effect_Kula_2_YiYingCun0.mdl" , s__KiritoSpells__KiritoSpells_Q_x[this] , s__KiritoSpells__KiritoSpells_Q_y[this] , s__KiritoSpells__KiritoSpells_Q_a[this] * bj_RADTODEG , 0.5 , 2.5 , 50))
                            endif
                        else
                            set s__KiritoSpells__KiritoSpells_Q_r3[this]=s__KiritoSpells__KiritoSpells_Q_r3[this] + 0.03
                        endif
                    endif
                else
                    call StopSpellUnit2(s__KiritoSpells__KiritoSpells_Q_c[this])
                    call DestroyGroup(s__KiritoSpells__KiritoSpells_Q_g[this])
                    call DestroyGroup(s__KiritoSpells__KiritoSpells_Q_g2[this])
                    set s__KiritoSpells__KiritoSpells_Q_e[this]=null
                    set s__KiritoSpells__KiritoSpells_Q_g[this]=null
                    set s__KiritoSpells__KiritoSpells_Q_td[this]=null
                    set s__KiritoSpells__KiritoSpells_Q_g2[this]=null
                    set s__KiritoSpells__KiritoSpells_Q_c[this]=null
                    set s__KiritoSpells__KiritoSpells_Q_e[this]=null
                    set s__KiritoSpells__KiritoSpells_Q_m_KiritoQ[i]=s__KiritoSpells__KiritoSpells_Q_m_KiritoQ[s__KiritoSpells__KiritoSpells_Q_MUI_KiritoQ]
                    set s__KiritoSpells__KiritoSpells_Q_MUI_KiritoQ=s__KiritoSpells__KiritoSpells_Q_MUI_KiritoQ - 1
                    if s__KiritoSpells__KiritoSpells_Q_MUI_KiritoQ == - 1 then
