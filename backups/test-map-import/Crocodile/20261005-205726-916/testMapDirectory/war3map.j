                            call MakeSound("Erza1_Q2")
                        endif
                    elseif s__ErzaQSpells__ErzaQ_KS_check[this] == 1 then
                        if s__ErzaQSpells__ErzaQ_KS_r[this] == 0.15 then
                            call DestroyEffect(EffectSpawn("war3mapimported\\wos_bdef (173).mdl" , GetUnitX(s__ErzaQSpells__ErzaQ_KS_c[this]) - 150 * Cos(s__ErzaQSpells__ErzaQ_KS_a[this]) , GetUnitY(s__ErzaQSpells__ErzaQ_KS_c[this]) - 150 * Sin(s__ErzaQSpells__ErzaQ_KS_a[this]) , s__ErzaQSpells__ErzaQ_KS_a[this] * bj_RADTODEG , 0.5 , 2.1 , 110))
                        endif
