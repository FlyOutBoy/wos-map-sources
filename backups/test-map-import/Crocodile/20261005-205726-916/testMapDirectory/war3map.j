                    call SaveReal(hs, GetHandleId(s__PatriotSpells___PatriotSpells_T_c[this]), StringHash("t x"), s__PatriotSpells___PatriotSpells_T_x[this])
                    call SaveReal(hs, GetHandleId(s__PatriotSpells___PatriotSpells_T_c[this]), StringHash("t y"), s__PatriotSpells___PatriotSpells_T_y[this])

                    if s__PatriotSpells___PatriotSpells_T_r[this] > PatriotT_CastTime then
                        if s__PatriotSpells___PatriotSpells_T_r2[this] > 0.95 then
                            call DecorRemove(s__PatriotSpells___PatriotSpells_T_c[this] , s__PatriotSpells___PatriotSpells_T_x[this] , s__PatriotSpells___PatriotSpells_T_y[this] , s__PatriotSpells___PatriotSpells_T_aoe[this] , PatriotT_DecorDamage)
