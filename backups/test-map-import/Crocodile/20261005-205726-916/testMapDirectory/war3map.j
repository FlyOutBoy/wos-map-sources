            set s__ErzaQSpells__ErzaPas_KS_r5[this]=s__ErzaQSpells__ErzaPas_KS_aoe[this] / 18
            set s__ErzaQSpells__ErzaPas_KS_dmg[this]=GetHeroAgi(s__ErzaQSpells__ErzaPas_KS_c[this], true) * ( Erza1E_DamageAgiBase + ( Erza1E_DamageAgiStep * ( GetUnitAbilityLevel(s__ErzaQSpells__ErzaPas_KS_c[this], Erza1E_ID) - 1 ) ) )
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_BY_Wood_Effect_OnePiece_AiSi_DaYanJieYanDi_2.mdx" , s__ErzaQSpells__ErzaPas_KS_x[this] , s__ErzaQSpells__ErzaPas_KS_y[this] , GetRandomReal(0, 359) , 1 , 3.5 , 50))
            set s__ErzaQSpells__ErzaPas_KS_k[this]=0
            loop
                exitwhen s__ErzaQSpells__ErzaPas_KS_k[this] > 7
                set s__ErzaQSpells__ErzaPas_KS_e[this]=EffectSpawn2("war3mapImported\\wos_BY_Wood_Effect_Order_MuZhiBenYing_Fir_Huo_DiMianss2.mdl" , s__ErzaQSpells__ErzaPas_KS_x[this] + s__ErzaQSpells__ErzaPas_KS_aoe[this] * Cos(s__ErzaQSpells__ErzaPas_KS_k[this] * 52 * bj_DEGTORAD) , s__ErzaQSpells__ErzaPas_KS_y[this] + s__ErzaQSpells__ErzaPas_KS_aoe[this] * Sin(s__ErzaQSpells__ErzaPas_KS_k[this] * 52 * bj_DEGTORAD) , GetRandomReal(0, 359) , 2 , 2.5 , 200 , 0.9)
                call EMUE(s__ErzaQSpells__ErzaPas_KS_e[this] , s__ErzaQSpells__ErzaPas_KS_aoe[this] , 0.75 , s__ErzaQSpells__ErzaPas_KS_k[this] * 52 * bj_DEGTORAD)
                set s__ErzaQSpells__ErzaPas_KS_e[this]=null
                set s__ErzaQSpells__ErzaPas_KS_k[this]=s__ErzaQSpells__ErzaPas_KS_k[this] + 1
            endloop
