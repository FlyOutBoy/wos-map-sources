    set s__GearSystems2___KS_DamageOverTime_r3[this]=0 // period accumulator
    set s__GearSystems2___KS_DamageOverTime_r2[this]=NewPeriod
    set s__GearSystems2___KS_DamageOverTime_k[this]=NewTD
