        function s__TojiSpells___TojiSpells_Q_TojiQ_Start takes unit NewC,unit NewTarget,integer NewMode returns nothing
            local integer this
            local integer abilityId
            local integer level

            if NewC == null or NewTarget == null or GetUnitTypeId(NewC) == 0 or GetUnitTypeId(NewTarget) == 0 or GetWidgetLife(NewTarget) <= 0.405 or not IsUnitEnemy(NewTarget, GetOwningPlayer(NewC)) then
                return
            endif

            if NewMode < 1 or NewMode > 3 then
                set NewMode=1
            endif
            if NewMode == 1 then
                set abilityId=TojiQ_ID
            elseif NewMode == 2 then
                set abilityId=TojiQ2_ID
            else
                set abilityId=TojiQ3_ID
            endif

            set this=s__TojiSpells___TojiSpells_Q__allocate()
            set s__TojiSpells___TojiSpells_Q_MUI_TojiQ=s__TojiSpells___TojiSpells_Q_MUI_TojiQ + 1
            set s__TojiSpells___TojiSpells_Q_m_TojiQ[s__TojiSpells___TojiSpells_Q_MUI_TojiQ]=this
            set s__TojiSpells___TojiSpells_Q_c[this]=NewC
            set s__TojiSpells___TojiSpells_Q_td[this]=NewTarget
            set s__TojiSpells___TojiSpells_Q_g[this]=CreateGroup()
            set s__TojiSpells___TojiSpells_Q_mode[this]=NewMode
            set s__TojiSpells___TojiSpells_Q_state[this]=0
            set s__TojiSpells___TojiSpells_Q_hits[this]=0
            set s__TojiSpells___TojiSpells_Q_r[this]=0.0
            set s__TojiSpells___TojiSpells_Q_damageClock[this]=0.0
            set s__TojiSpells___TojiSpells_Q_effectClock[this]=0.0
            set s__TojiSpells___TojiSpells_Q_chaseClock[this]=0.0
            set level=GetUnitAbilityLevel(NewC, abilityId)
            if level < 1 then
                set level=1
            endif
            set s__TojiSpells___TojiSpells_Q_bonusDmg[this]=TojiSpells___TojiE_ConsumeLeapBonus(NewC)
            if TojiQ_IsInvul then
                call StartSpellUnit(s__TojiSpells___TojiSpells_Q_c[this])
            else
                call StartSpellUnit2(s__TojiSpells___TojiSpells_Q_c[this])
            endif

            if NewMode == 1 then
                set s__TojiSpells___TojiSpells_Q_move[this]=TojiQ_Move
                set s__TojiSpells___TojiSpells_Q_dmg[this]=GetHeroAgi(NewC, true) * ( TojiQ_DamageAgiBase + TojiQ_DamageAgiStep * ( level - 1 ) )
                set s__TojiSpells___TojiSpells_Q_dmg[this]=s__TojiSpells___TojiSpells_Q_dmg[this] + TojiQ_Damage2StaticBase + TojiQ_Damage2StaticStep * ( level - 1 )
                set s__TojiSpells___TojiSpells_Q_dmg[this]=s__TojiSpells___TojiSpells_Q_dmg[this] / 2.0
                set s__TojiSpells___TojiSpells_Q_a[this]=GAngle2(NewC , GetUnitX(NewTarget) , GetUnitY(NewTarget))
                call SetUnitFacing(NewC, s__TojiSpells___TojiSpells_Q_a[this] * bj_RADTODEG)
                set s__TojiSpells___TojiSpells_Q_e[this]=AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdx", s__TojiSpells___TojiSpells_Q_c[this], "hand right")
                call SetUnitAnimationByIndex(NewC, 1)
                call SetUnitTimeScale(NewC, 1)
                call MakeSound("war3mapimported\\Hero_Toji_Q1 1")
            elseif NewMode == 2 then
                set s__TojiSpells___TojiSpells_Q_move[this]=TojiQ2_Move
                set s__TojiSpells___TojiSpells_Q_dmg[this]=GetHeroAgi(NewC, true) * ( TojiQ2_DamageAgiBase + TojiQ2_DamageAgiStep * ( level - 1 ) )
                set s__TojiSpells___TojiSpells_Q_dmg[this]=s__TojiSpells___TojiSpells_Q_dmg[this] + TojiQ2_Damage2StaticBase + TojiQ2_Damage2StaticStep * ( level - 1 )
                set s__TojiSpells___TojiSpells_Q_dmg[this]=s__TojiSpells___TojiSpells_Q_dmg[this] / I2R(TojiQ2_DamageCount)
                set s__TojiSpells___TojiSpells_Q_e[this]=EffectSpawn3("war3mapImported\\wos_SlashAoeOrangeLoop.mdl" , GetUnitX(s__TojiSpells___TojiSpells_Q_c[this]) , GetUnitY(s__TojiSpells___TojiSpells_Q_c[this]) , s__TojiSpells___TojiSpells_Q_a[this] * bj_RADTODEG + 45 , 1 , 0.895 , 100 , - 35)
                set s__TojiSpells___TojiSpells_Q_e2[this]=EffectSpawn3("war3mapImported\\wos_SlashAoeOrangeLoop.mdl" , GetUnitX(s__TojiSpells___TojiSpells_Q_c[this]) , GetUnitY(s__TojiSpells___TojiSpells_Q_c[this]) , s__TojiSpells___TojiSpells_Q_a[this] * bj_RADTODEG + 45 , 1 , 0.895 , 100 , - 35)
                set s__TojiSpells___TojiSpells_Q_e3[this]=AddSpecialEffectTarget("war3mapimported\\wos_SlidingDustWithRocks.mdx", s__TojiSpells___TojiSpells_Q_c[this], "origin")
                call BlzSetSpecialEffectAlpha(s__TojiSpells___TojiSpells_Q_e[this], 125)
                call BlzSetSpecialEffectAlpha(s__TojiSpells___TojiSpells_Q_e2[this], 125)
                set s__TojiSpells___TojiSpells_Q_a[this]=GAngle2(NewC , GetUnitX(NewTarget) , GetUnitY(NewTarget))
                call SetUnitFacing(NewC, s__TojiSpells___TojiSpells_Q_a[this] * bj_RADTODEG)
                call SetUnitAnimationByIndex(NewC, 6)
                call SetUnitTimeScale(NewC, 1.55)
                call MakeSound("war3mapimported\\Hero_Toji_Q2 1")
                call MakeSound("war3mapimported\\Hero_Toji_Q2 3")
            else
                set s__TojiSpells___TojiSpells_Q_move[this]=0.0
                set s__TojiSpells___TojiSpells_Q_dmg[this]=GetHeroAgi(NewC, true) * ( TojiQ3_DamageAgiBase + TojiQ3_DamageAgiStep * ( level - 1 ) )
                set s__TojiSpells___TojiSpells_Q_dmg[this]=s__TojiSpells___TojiSpells_Q_dmg[this] + TojiQ3_DamageStaticBase + TojiQ3_DamageStaticStep * ( level - 1 )
                set s__TojiSpells___TojiSpells_Q_e[this]=AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdx", s__TojiSpells___TojiSpells_Q_c[this], "hand right")
                set s__TojiSpells___TojiSpells_Q_e2[this]=AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdx", s__TojiSpells___TojiSpells_Q_c[this], "hand left")
                set s__TojiSpells___TojiSpells_Q_e3[this]=AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdx", s__TojiSpells___TojiSpells_Q_c[this], "chest")
                set s__TojiSpells___TojiSpells_Q_a[this]=GAngle2(NewC , GetUnitX(NewTarget) , GetUnitY(NewTarget))
                call SetUnitFacing(NewC, s__TojiSpells___TojiSpells_Q_a[this] * bj_RADTODEG)
                call SetUnitAnimationByIndex(NewC, 9)
                call SetUnitTimeScale(NewC, 0.10)
                call MakeSound("war3mapimported\\Hero_Toji_Q3 1")
            endif

            if s__TojiSpells___TojiSpells_Q_MUI_TojiQ == 0 then
                call TojiSpells___TojiTimer03Acquire()
            endif
        endfunction



