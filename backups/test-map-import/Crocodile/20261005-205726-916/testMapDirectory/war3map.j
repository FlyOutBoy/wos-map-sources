                                    if SpellBool(s__RimuruSpells__Rimuru3T_KS_u[this]) and IsUnitEnemy(s__RimuruSpells__Rimuru3T_KS_u[this], GetOwningPlayer(s__RimuruSpells__Rimuru3T_KS_c[this])) and SR3(s__RimuruSpells__Rimuru3T_KS_u[this] , s__RimuruSpells__Rimuru3T_KS_x[this] , s__RimuruSpells__Rimuru3T_KS_y[this]) <= s__RimuruSpells__Rimuru3T_KS_aoe[this] then
