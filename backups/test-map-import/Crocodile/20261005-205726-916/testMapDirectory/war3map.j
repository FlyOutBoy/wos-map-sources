        function s__NatsuSpells__NatsuQ_KS_Loop_NatsuQ takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__NatsuSpells__NatsuQ_KS_MUI_NatsuQ
                set this=s__NatsuSpells__NatsuQ_KS_m_NatsuQ[i]
                if SpellBoolCaster(s__NatsuSpells__NatsuQ_KS_c[this]) and s__NatsuSpells__NatsuQ_KS_r[this] <= s__NatsuSpells__NatsuQ_KS_rmax[this] then
                    set s__NatsuSpells__NatsuQ_KS_r[this]=RoundReal(s__NatsuSpells__NatsuQ_KS_r[this] + 0.03 , 3)
                    if s__NatsuSpells__NatsuQ_KS_k2[this] == 0 then
                        if s__NatsuSpells__NatsuQ_KS_r[this] == s__NatsuSpells__NatsuQ_KS_r_prepare[this] - 0.03 then
                            call SetUnitTimeScale(s__NatsuSpells__NatsuQ_KS_c[this], 1)
                            set s__NatsuSpells__NatsuQ_KS_x[this]=GetUnitX(s__NatsuSpells__NatsuQ_KS_c[this]) + 180 * Cos(s__NatsuSpells__NatsuQ_KS_a[this])
                            set s__NatsuSpells__NatsuQ_KS_y[this]=GetUnitY(s__NatsuSpells__NatsuQ_KS_c[this]) + 180 * Sin(s__NatsuSpells__NatsuQ_KS_a[this])
                            call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_tx-ha_nitu.mdl" , GetUnitX(s__NatsuSpells__NatsuQ_KS_c[this]) , GetUnitY(s__NatsuSpells__NatsuQ_KS_c[this]) , s__NatsuSpells__NatsuQ_KS_a[this] * bj_RADTODEG , 2 , 1.25 , 1 , 255 , 255 , 255 , 225))
                        endif
                        if s__NatsuSpells__NatsuQ_KS_r[this] < s__NatsuSpells__NatsuQ_KS_r_prepare[this] then
                            call DebugUnit2(s__NatsuSpells__NatsuQ_KS_c[this])
                        endif
                        if s__NatsuSpells__NatsuQ_KS_r[this] >= s__NatsuSpells__NatsuQ_KS_r_prepare[this] then
                            set s__NatsuSpells__NatsuQ_KS_x[this]=s__NatsuSpells__NatsuQ_KS_x[this] + s__NatsuSpells__NatsuQ_KS_move[this] * Cos(s__NatsuSpells__NatsuQ_KS_a[this])
                            set s__NatsuSpells__NatsuQ_KS_y[this]=s__NatsuSpells__NatsuQ_KS_y[this] + s__NatsuSpells__NatsuQ_KS_move[this] * Sin(s__NatsuSpells__NatsuQ_KS_a[this])
                            set s__NatsuSpells__NatsuQ_KS_r7[this]=s__NatsuSpells__NatsuQ_KS_r7[this] + s__NatsuSpells__NatsuQ_KS_move[this]
                            if s__NatsuSpells__NatsuQ_KS_r7[this] >= NatsuQ_Range then
                                set s__NatsuSpells__NatsuQ_KS_r[this]=999999
                            endif
                            if s__NatsuSpells__NatsuQ_KS_r2[this] > 0.00 then
                                set s__NatsuSpells__NatsuQ_KS_r2[this]=0
                                set s__NatsuSpells__NatsuQ_KS_scale[this]=s__NatsuSpells__NatsuQ_KS_scale[this] + 0.21
                                set s__NatsuSpells__NatsuQ_KS_move[this]=s__NatsuSpells__NatsuQ_KS_move[this] + 5
                                set s__NatsuSpells__NatsuQ_KS_fly[this]=s__NatsuSpells__NatsuQ_KS_fly[this] + 9
                                call EffectSpawn2("war3mapImported\\wos_File00000377.mdl" , s__NatsuSpells__NatsuQ_KS_x[this] , s__NatsuSpells__NatsuQ_KS_y[this] , s__NatsuSpells__NatsuQ_KS_a[this] * bj_RADTODEG , 2 , s__NatsuSpells__NatsuQ_KS_scale[this] , s__NatsuSpells__NatsuQ_KS_fly[this] , 0.275)
                            else
                                set s__NatsuSpells__NatsuQ_KS_r2[this]=s__NatsuSpells__NatsuQ_KS_r2[this] + 0.03
                            endif
                            if s__NatsuSpells__NatsuQ_KS_r3[this] > 0.03 then
                                set s__NatsuSpells__NatsuQ_KS_r3[this]=0
                                call DecorRemove(s__NatsuSpells__NatsuQ_KS_c[this] , s__NatsuSpells__NatsuQ_KS_x[this] , s__NatsuSpells__NatsuQ_KS_y[this] , s__NatsuSpells__NatsuQ_KS_aoe[this] , 20)
                                call VisionTimed(GetOwningPlayer(s__NatsuSpells__NatsuQ_KS_c[this]) , s__NatsuSpells__NatsuQ_KS_x[this] , s__NatsuSpells__NatsuQ_KS_y[this] , s__NatsuSpells__NatsuQ_KS_aoe[this] * 1.5 , 1.5)
                                call ColorEffDummy3Alpha((EffectSpawnScale("war3mapImported\\wos_papsnaz (1050).mdl" , s__NatsuSpells__NatsuQ_KS_x[this] , s__NatsuSpells__NatsuQ_KS_y[this] , GetRandomReal(0, 359) , 1.85 , 0.01 , 0 , 0.12 , 0.01 , s__NatsuSpells__NatsuQ_KS_scale[this] * 0.6) ) , (( 0.3 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.51)*1.0)) // INLINED!!
                            else
                                set s__NatsuSpells__NatsuQ_KS_r3[this]=s__NatsuSpells__NatsuQ_KS_r3[this] + 0.03
                            endif
                            call GroupClear(s__NatsuSpells__NatsuQ_KS_g[this])
                            call GroupEnumUnitsInRange(s__NatsuSpells__NatsuQ_KS_g[this], s__NatsuSpells__NatsuQ_KS_x[this], s__NatsuSpells__NatsuQ_KS_y[this], s__NatsuSpells__NatsuQ_KS_aoe[this], NoDecor_Cond)
                            loop
                                set s__NatsuSpells__NatsuQ_KS_u[this]=FirstOfGroup(s__NatsuSpells__NatsuQ_KS_g[this])
                                exitwhen s__NatsuSpells__NatsuQ_KS_u[this] == null or s__NatsuSpells__NatsuQ_KS_check[this] > 0
                                if SpellBool(s__NatsuSpells__NatsuQ_KS_u[this]) and IsUnitEnemy(s__NatsuSpells__NatsuQ_KS_u[this], GetOwningPlayer(s__NatsuSpells__NatsuQ_KS_c[this])) and IsUnitInGroup(s__NatsuSpells__NatsuQ_KS_u[this], s__NatsuSpells__NatsuQ_KS_g2[this]) == false then
                                    call GroupAddUnit(s__NatsuSpells__NatsuQ_KS_g2[this], s__NatsuSpells__NatsuQ_KS_u[this])
                                    call dmgmag(s__NatsuSpells__NatsuQ_KS_c[this] , s__NatsuSpells__NatsuQ_KS_u[this] , s__NatsuSpells__NatsuQ_KS_dmg[this])
                                endif
                                call GroupRemoveUnit(s__NatsuSpells__NatsuQ_KS_g[this], s__NatsuSpells__NatsuQ_KS_u[this])
                            endloop
                            set s__NatsuSpells__NatsuQ_KS_u[this]=null
                        endif
                    elseif s__NatsuSpells__NatsuQ_KS_k2[this] == 1 then
                        if s__NatsuSpells__NatsuQ_KS_r[this] == s__NatsuSpells__NatsuQ_KS_r_prepare[this] - 0.03 then
                            call SetUnitTimeScale(s__NatsuSpells__NatsuQ_KS_c[this], 1)
                            call MakeSound("war3mapimported\\Hero_Natsu_GQ_02")
                            set s__NatsuSpells__NatsuQ_KS_x[this]=GetUnitX(s__NatsuSpells__NatsuQ_KS_c[this]) + 180 * Cos(s__NatsuSpells__NatsuQ_KS_a[this])
                            set s__NatsuSpells__NatsuQ_KS_y[this]=GetUnitY(s__NatsuSpells__NatsuQ_KS_c[this]) + 180 * Sin(s__NatsuSpells__NatsuQ_KS_a[this])
                            call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_tx-ha_nitu.mdl" , GetUnitX(s__NatsuSpells__NatsuQ_KS_c[this]) , GetUnitY(s__NatsuSpells__NatsuQ_KS_c[this]) , s__NatsuSpells__NatsuQ_KS_a[this] * bj_RADTODEG , 2 , 2.25 , 1 , 255 , 255 , 255 , 225))
                        endif
                        if s__NatsuSpells__NatsuQ_KS_r[this] == 0.21 or s__NatsuSpells__NatsuQ_KS_r[this] == 0.42 or s__NatsuSpells__NatsuQ_KS_r[this] == 0.63 or s__NatsuSpells__NatsuQ_KS_r[this] == 0.84 or s__NatsuSpells__NatsuQ_KS_r[this] == 1.02 or s__NatsuSpells__NatsuQ_KS_r[this] == 1.2 then
                            call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_bdef (383).mdx" , GetUnitX(s__NatsuSpells__NatsuQ_KS_c[this]) , GetUnitY(s__NatsuSpells__NatsuQ_KS_c[this]) , GetRandomReal(0, 359) , 1 , 1.25 , 15 , 255 , 255 , 255 , 155))
                        endif
