    //===========================================================================
    // Базовые утилиты баффов и масштабирования
    //===========================================================================
        function s__BrandishSpells_Utility_BuffUnitBran takes unit c,unit u,integer level returns nothing
            local integer i= GetPlayerId(GetOwningPlayer(c))
            if BrandishSpells___branddummy1[i] == null or GetWidgetLife(BrandishSpells___branddummy1[i]) < 1.0 then
                set BrandishSpells___branddummy1[i]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'h0C9', GetRectCenterX(gg_rct_Caster), GetRectCenterY(gg_rct_Caster), 0.0)
                call UnitAddAbility(BrandishSpells___branddummy1[i], 'A0EN')
            endif
            if level > 0 then
                if GetUnitAbilityLevel(BrandishSpells___branddummy1[i], 'A0EN') == 0 then
                    call UnitAddAbility(BrandishSpells___branddummy1[i], 'A0EN')
                endif
                call SetUnitAbilityLevel(BrandishSpells___branddummy1[i], 'A0EN', level)
                call SetUnitFacing(BrandishSpells___branddummy1[i], GAngle(BrandishSpells___branddummy1[i] , u) * bj_RADTODEG)
                call IssueTargetOrder(BrandishSpells___branddummy1[i], "innerfire", u)
            endif
        endfunction

        function s__BrandishSpells_Utility_BuffUnitBran2 takes unit c,unit u,integer level,boolean isenemy returns nothing
            local integer i= GetPlayerId(GetOwningPlayer(c))
            if BrandishSpells___branddummy2[i] == null or GetWidgetLife(BrandishSpells___branddummy2[i]) < 1.0 then
                set BrandishSpells___branddummy2[i]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'h0C9', GetRectCenterX(gg_rct_Caster), GetRectCenterY(gg_rct_Caster), 0.0)
                call UnitAddAbility(BrandishSpells___branddummy2[i], 'A0EO')
                call UnitAddAbility(BrandishSpells___branddummy2[i], 'A0EP')
            endif
            if level > 0 then
                if GetUnitAbilityLevel(BrandishSpells___branddummy2[i], 'A0EO') == 0 then
                    call UnitAddAbility(BrandishSpells___branddummy2[i], 'A0EO')
                endif
                if GetUnitAbilityLevel(BrandishSpells___branddummy2[i], 'A0EP') == 0 then
                    call UnitAddAbility(BrandishSpells___branddummy2[i], 'A0EP')
                endif
                call SetUnitAbilityLevel(BrandishSpells___branddummy2[i], 'A0EP', level)
                call SetUnitAbilityLevel(BrandishSpells___branddummy2[i], 'A0EO', level)
                call SetUnitFacing(BrandishSpells___branddummy2[i], GAngle(BrandishSpells___branddummy2[i] , u) * bj_RADTODEG)
                if isenemy then
                    call IssueTargetOrder(BrandishSpells___branddummy2[i], "curse", u)
                else
                    call IssueTargetOrder(BrandishSpells___branddummy2[i], "innerfire", u)
                endif
            endif
        endfunction

        function s__BrandishSpells_Utility_GetTotalScale takes unit u returns real
            local real tm= LoadReal(BrandishSpells___hs, GetHandleId(u), StringHash("TMult"))
            local real fm= LoadReal(BrandishSpells___hs, GetHandleId(u), StringHash("FMult"))
            if tm == 0.0 then
                set tm=1.0
            endif
            if fm == 0.0 then
                set fm=1.0
            endif
            return tm * fm
        endfunction

    //===========================================================================
    // Q - Sand Wave
    //===========================================================================


        function s__BrandishSpells___BrandishSpells_Q_Loop_BrandishQ takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__BrandishSpells___BrandishSpells_Q_MUI_BrandishQ
