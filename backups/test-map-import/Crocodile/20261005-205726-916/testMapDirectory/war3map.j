            if ( s__SpellData_statBase[this] != 0 or s__SpellData_staticBase[this] != 0 ) then
                call s__TooltipBuilder_addDamage(builder,s__SpellData_dmgType[this] , AAUniversalTooltips___FormulaList(s__SpellData_statType[this] , s__SpellData_statBase[this] , s__SpellData_statStep[this] , s__SpellData_staticBase[this] , s__SpellData_staticStep[this] , s__SpellData_maxLv[this]))
            endif
