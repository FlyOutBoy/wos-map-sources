                call s__TooltipBuilder_addCustomDamage(builder,s__SpellData_dmgType2[this] , s__SpellData_dmgName2[this] , AAUniversalTooltips___FormulaList(s__SpellData_statType2[this] , s__SpellData_statBase2[this] , s__SpellData_statStep2[this] , s__SpellData_staticBase2[this] , s__SpellData_staticStep2[this] , s__SpellData_maxLv[this]))
            endif
