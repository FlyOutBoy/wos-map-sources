        function s__NeuvilletteSpells__NeuvilletteSpells_Q_NeuvilletteQ_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this
            local integer level
            local real a

            if NewC == null or GetUnitTypeId(NewC) == 0 or GetWidgetLife(NewC) <= 0.405 then
                return
            endif

            set this=s__NeuvilletteSpells__NeuvilletteSpells_Q__allocate()
            set s__NeuvilletteSpells__NeuvilletteSpells_Q_MUI_NeuvilletteQ=s__NeuvilletteSpells__NeuvilletteSpells_Q_MUI_NeuvilletteQ + 1
            set s__NeuvilletteSpells__NeuvilletteSpells_Q_m_NeuvilletteQ[s__NeuvilletteSpells__NeuvilletteSpells_Q_MUI_NeuvilletteQ]=this
            set s__NeuvilletteSpells__NeuvilletteSpells_Q_c[this]=NewC
            set s__NeuvilletteSpells__NeuvilletteSpells_Q_x[this]=NewX
            set s__NeuvilletteSpells__NeuvilletteSpells_Q_y[this]=NewY
            set s__NeuvilletteSpells__NeuvilletteSpells_Q_r[this]=0.0
            set s__NeuvilletteSpells__NeuvilletteSpells_Q_rmax[this]=NeuvilletteQ_CastTime
            set s__NeuvilletteSpells__NeuvilletteSpells_Q_aoe[this]=NeuvilletteQ_DamageAoe
            set s__NeuvilletteSpells__NeuvilletteSpells_Q_g[this]=CreateGroup()

            set level=GetUnitAbilityLevel(s__NeuvilletteSpells__NeuvilletteSpells_Q_c[this], NeuvilletteQ_ID)
            if level < 1 then
                set level=1
            endif

            set s__NeuvilletteSpells__NeuvilletteSpells_Q_dmg[this]=GetHeroInt(s__NeuvilletteSpells__NeuvilletteSpells_Q_c[this], true) * ( NeuvilletteQ_DamageIntBase + NeuvilletteQ_DamageIntStep * ( level - 1 ) )
            set s__NeuvilletteSpells__NeuvilletteSpells_Q_dmg[this]=s__NeuvilletteSpells__NeuvilletteSpells_Q_dmg[this] + NeuvilletteQ_DamageStaticBase + NeuvilletteQ_DamageStaticStep * ( level - 1 )

            set a=GAngle2(s__NeuvilletteSpells__NeuvilletteSpells_Q_c[this] , s__NeuvilletteSpells__NeuvilletteSpells_Q_x[this] , s__NeuvilletteSpells__NeuvilletteSpells_Q_y[this])
            call SetUnitFacing(s__NeuvilletteSpells__NeuvilletteSpells_Q_c[this], a * bj_RADTODEG)

            if NeuvilletteQ_IsInvul then
                call StartSpellUnit(s__NeuvilletteSpells__NeuvilletteSpells_Q_c[this])
            else
                call StartSpellUnit2(s__NeuvilletteSpells__NeuvilletteSpells_Q_c[this])
            endif

            if LoadInteger(hs, GetHandleId(GetOwningPlayer(s__NeuvilletteSpells__NeuvilletteSpells_Q_c[this])), StringHash("nevi sound")) == 1 then
                call MakeSound("war3mapImported\\Hero_Neuvillette2_Q")
            else
                call MakeSound("war3mapImported\\Hero_Neuvillette_Q")
            endif

            call SetUnitAnimationByIndex(s__NeuvilletteSpells__NeuvilletteSpells_Q_c[this], 1)
            call SetUnitTimeScale(s__NeuvilletteSpells__NeuvilletteSpells_Q_c[this], 0.95)
            set s__NeuvilletteSpells__NeuvilletteSpells_Q_e[this]=EffectSpawn("war3mapimported\\wos_tidalerruption.mdl" , s__NeuvilletteSpells__NeuvilletteSpells_Q_x[this] , s__NeuvilletteSpells__NeuvilletteSpells_Q_y[this] , 1 , 0.01 , 3 , 1)

            if s__NeuvilletteSpells__NeuvilletteSpells_Q_MUI_NeuvilletteQ == 0 then
                call NeuvilletteSpells__NeuvilletteTimer03Acquire()
            endif
        endfunction

