            call s__TooltipBuilder_addMechanic(builder,AAUniversalTooltips___ParseLevelTags(s__SpellData_mecha[this] , 0))
            call s__TooltipBuilder_addCooldownEx(builder,AAUniversalTooltips___ListCooldown(s__SpellData_abilId[this] , 1 , s__SpellData_maxLv[this]) , s__SpellData_cdAfterDur[this])
            if ( s__SpellData_decor[this] != "" ) then
                call s__TooltipBuilder_addDecorDamage(builder,AAUniversalTooltips___ParseLevelTags(s__SpellData_decor[this] , 0))
            endif
            call s__TooltipBuilder_addMana(builder,AAUniversalTooltips___ListMana(s__SpellData_abilId[this] , 1 , s__SpellData_maxLv[this]))
            loop
                exitwhen i > s__SpellData_maxLv[this]
                call s__TooltipBuilder_applyToAbilityLearn(builder,s__SpellData_abilId[this] , i)
                set i=i + 1
            endloop
            call s__TooltipBuilder_destroy(builder)
            set i=1
            loop
                exitwhen i > s__SpellData_maxLv[this]
                set builder=s__TooltipBuilder_create()
                call s__TooltipBuilder_addDescription(builder,desc)
                call s__TooltipBuilder_addBonus(builder,AAUniversalTooltips___ParseLevelTags(bns , i))
                if ( s__SpellData_statBase[this] != 0 or s__SpellData_staticBase[this] != 0 ) then
                    call s__TooltipBuilder_addDamage(builder,s__SpellData_dmgType[this] , AAUniversalTooltips___FormulaStr(s__SpellData_statType[this] , s__SpellData_statBase[this] , s__SpellData_statStep[this] , s__SpellData_staticBase[this] , s__SpellData_staticStep[this] , i))
                endif
                if ( s__SpellData_dmgType2[this] != 0 ) then
                    call s__TooltipBuilder_addCustomDamage(builder,s__SpellData_dmgType2[this] , s__SpellData_dmgName2[this] , AAUniversalTooltips___FormulaStr(s__SpellData_statType2[this] , s__SpellData_statBase2[this] , s__SpellData_statStep2[this] , s__SpellData_staticBase2[this] , s__SpellData_staticStep2[this] , i))
                endif
