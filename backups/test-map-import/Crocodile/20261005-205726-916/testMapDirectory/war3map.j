                                call SetUnitTimeScale(s__RaidenSpells__RaidenQ_KS_c[this], 0.8)
                                call SetUnitAnimationByIndex(s__RaidenSpells__RaidenQ_KS_c[this], 5)
                            endif
                            if s__RaidenSpells__RaidenQ_KS_r[this] == 0.72 then
                                set s__RaidenSpells__RaidenQ_KS_scale[this]=7.5
                                if s__RaidenSpells__RaidenQ_KS_check2[this] == 1 then
                                    call ColorEffDummy3Alpha((EffectSpawn("war3mapImported\\wos_RaidenEi-11.mdl" , s__RaidenSpells__RaidenQ_KS_x[this] , s__RaidenSpells__RaidenQ_KS_y[this] , s__RaidenSpells__RaidenQ_KS_a[this] * bj_RADTODEG , 1 , s__RaidenSpells__RaidenQ_KS_scale[this] * 0.125 , 165) ) , (( 1 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.06)*1.0)) // INLINED!!
