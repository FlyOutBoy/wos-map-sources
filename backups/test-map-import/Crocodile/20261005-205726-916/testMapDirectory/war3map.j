                            call UnitRemoveAbility(s__TojiSpells___TojiSpells_R_Insectoids_c[this], 'B01C')
                            call UnitRemoveAbility(s__TojiSpells___TojiSpells_R_Insectoids_c[this], 'B019')
                            call UnitRemoveAbility(s__TojiSpells___TojiSpells_R_Insectoids_c[this], 'B00T')
