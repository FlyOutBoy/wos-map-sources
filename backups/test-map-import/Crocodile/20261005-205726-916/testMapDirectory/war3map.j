                set s__MilimSpells___MilimT2KS_c[this]=null

                set s__MilimSpells___MilimT2KS_m_MilimT2[i]=s__MilimSpells___MilimT2KS_m_MilimT2[s__MilimSpells___MilimT2KS_MUI_MilimT2]
                set s__MilimSpells___MilimT2KS_MUI_MilimT2=s__MilimSpells___MilimT2KS_MUI_MilimT2 - 1
                if s__MilimSpells___MilimT2KS_MUI_MilimT2 == - 1 then
                    call PauseTimer(s__MilimSpells___MilimT2KS_t_MilimT2)
                endif
                call s__MilimSpells___MilimT2KS_deallocate(this)
                set i=i - 1
            endif

            set i=i + 1
        endloop
    endfunction

    function s__MilimSpells___MilimT2KS_MilimT2_Start takes unit NewC,real NewX,real NewY returns nothing
        local integer this= s__MilimSpells___MilimT2KS__allocate()

        set s__MilimSpells___MilimT2KS_MUI_MilimT2=s__MilimSpells___MilimT2KS_MUI_MilimT2 + 1
        set s__MilimSpells___MilimT2KS_m_MilimT2[s__MilimSpells___MilimT2KS_MUI_MilimT2]=this
        set s__MilimSpells___MilimT2KS_c[this]=NewC
        set s__MilimSpells___MilimT2KS_x[this]=NewX
        set s__MilimSpells___MilimT2KS_y[this]=NewY
        set s__MilimSpells___MilimT2KS_baseA[this]=GAngle2(s__MilimSpells___MilimT2KS_c[this] , s__MilimSpells___MilimT2KS_x[this] , s__MilimSpells___MilimT2KS_y[this])
        set s__MilimSpells___MilimT2KS_a[this]=s__MilimSpells___MilimT2KS_baseA[this]
        set s__MilimSpells___MilimT2KS_r[this]=0.00
        set s__MilimSpells___MilimT2KS_r2[this]=0.00
        set s__MilimSpells___MilimT2KS_r3[this]=0.00
        set s__MilimSpells___MilimT2KS_r4[this]=0.00
        set s__MilimSpells___MilimT2KS_beamFxMove[this]=0.00
        set s__MilimSpells___MilimT2KS_beamFxScale[this]=1.20
        set s__MilimSpells___MilimT2KS_beamRingScale[this]=1.25
        set s__MilimSpells___MilimT2KS_beamRingTimer[this]=0.00
        set s__MilimSpells___MilimT2KS_move[this]=0.00
        set s__MilimSpells___MilimT2KS_check[this]=0
        set s__MilimSpells___MilimT2KS_castFrontFx[this]=null
        set s__MilimSpells___MilimT2KS_castFrontGlowFx[this]=null
        set s__MilimSpells___MilimT2KS_castFrontBallFx[this]=null
        set s__MilimSpells___MilimT2KS_aoe[this]=MilimT2_DamageAoe * s__MilimSpells___MilimT2KS_AOE_START_FACTOR
        set s__MilimSpells___MilimT2KS_dmg[this]=GetHeroAgi(s__MilimSpells___MilimT2KS_c[this], true) * MilimT2_DamageAgiBase / I2R(MilimT2_DamageTicks)
        call SetFly(s__MilimSpells___MilimT2KS_c[this] , 150)
        set s__MilimSpells___MilimT2KS_g[this]=CreateGroup()
        set s__MilimSpells___MilimT2KS_g2[this]=CreateGroup()

        call DebuffClear(s__MilimSpells___MilimT2KS_c[this])
        call StartSpellUnit(s__MilimSpells___MilimT2KS_c[this])
        call SetUnitAnimationByIndex(s__MilimSpells___MilimT2KS_c[this], 0)
        call SetUnitTimeScale(s__MilimSpells___MilimT2KS_c[this], 1.50)
        call MouseOn(GetOwningPlayer(s__MilimSpells___MilimT2KS_c[this]))
        set MouseX[GetPlayerId(GetOwningPlayer(s__MilimSpells___MilimT2KS_c[this]))]=s__MilimSpells___MilimT2KS_x[this]
        set MouseY[GetPlayerId(GetOwningPlayer(s__MilimSpells___MilimT2KS_c[this]))]=s__MilimSpells___MilimT2KS_y[this]
        call BlzSetUnitFacingEx(s__MilimSpells___MilimT2KS_c[this], s__MilimSpells___MilimT2KS_a[this] * bj_RADTODEG)
        call MakeSound("war3mapimported\\Hero_Milim_T2 1")
        call SetUnitAnimationByIndex(s__MilimSpells___MilimT2KS_c[this], 7)

        set s__MilimSpells___MilimT2KS_e[this]=EffectSpawnColor("war3mapImported\\wos_mr_war3_sxxq3.mdx" , GetUnitX(s__MilimSpells___MilimT2KS_c[this]) , GetUnitY(s__MilimSpells___MilimT2KS_c[this]) , s__MilimSpells___MilimT2KS_a[this] * bj_RADTODEG , 1.50 , 7.00 , 0.00 , 255 , 1 , 1 , 255)
        set s__MilimSpells___MilimT2KS_e2[this]=AddSpecialEffectTarget("war3mapImported\\wos_ly-r-sg.mdx", s__MilimSpells___MilimT2KS_c[this], "chest")
        set s__MilimSpells___MilimT2KS_e4[this]=EffectSpawn("war3mapImported\\wos_4xpinkpillar_3.mdl" , GetUnitX(s__MilimSpells___MilimT2KS_c[this]) , GetUnitY(s__MilimSpells___MilimT2KS_c[this]) , s__MilimSpells___MilimT2KS_a[this] * bj_RADTODEG , 1.50 , 4.50 , 255.00)

        if s__MilimSpells___MilimT2KS_MUI_MilimT2 == 0 then
            call TimerStart(s__MilimSpells___MilimT2KS_t_MilimT2, 0.03, true, function s__MilimSpells___MilimT2KS_Loop_MilimT2)
        endif
    endfunction


    function s__MilimSpells___MilimGKS_GetMaxDamage takes unit c returns real
        if GetHeroLevel(c) >= 35 then
            return MilimG_DamagetoStats3
        elseif GetHeroLevel(c) >= 25 then
            return MilimG_DamagetoStats2
        endif
        return MilimG_DamagetoStats1
    endfunction

    function s__MilimSpells___MilimGKS_UpdateFrame takes unit c returns nothing
        local integer pid= GetPlayerId(GetOwningPlayer(c))
        local real maxDamage= s__MilimSpells___MilimGKS_GetMaxDamage(c)
        local real damage= LoadReal(hs, GetHandleId(c), StringHash("milim g dmg"))

        if damage > maxDamage then
            set damage=maxDamage
            call SaveReal(hs, GetHandleId(c), StringHash("milim g dmg"), damage)
        endif
        if s__MilimSpells___MilimGKS_frame1[pid] != null then
            call BlzFrameSetMinMaxValue(s__MilimSpells___MilimGKS_frame3[pid], 0.00, maxDamage)
            call BlzFrameSetValue(s__MilimSpells___MilimGKS_frame3[pid], damage)
            call BlzFrameSetText(s__MilimSpells___MilimGKS_frame6[pid], "|c00FFFF00" + I2S(R2I(damage)) + "/" + I2S(R2I(maxDamage)) + "|r")
        endif
    endfunction

    function s__MilimSpells___MilimGKS_Start takes unit c returns nothing
        local integer pid
        local real tmpY= 0.0375
        local real maxDamage

        if c == null or GetHeroLevel(c) < 12 then
            return
        endif

        set pid=GetPlayerId(GetOwningPlayer(c))
        set maxDamage=s__MilimSpells___MilimGKS_GetMaxDamage(c)
        if s__MilimSpells___MilimGKS_frame1[pid] == null then
            set s__MilimSpells___MilimGKS_frame1[pid]=BlzCreateFrameByType("BACKDROP", "SS", main_frame, "", 0)
            call BlzFrameSetAbsPoint(s__MilimSpells___MilimGKS_frame1[pid], FRAMEPOINT_CENTER, 0.055, 0.18 + tmpY)
            call BlzFrameSetSize(s__MilimSpells___MilimGKS_frame1[pid], 0.135, 0.035)
            call BlzFrameSetTexture(s__MilimSpells___MilimGKS_frame1[pid], "UI\\Feedback\\XPBar\\human-xpbar-border.blp", 0, false)
            call BlzFrameSetVisible(s__MilimSpells___MilimGKS_frame1[pid], false)

            set s__MilimSpells___MilimGKS_frame2[pid]=BlzCreateFrame("EscMenuControlBackdropTemplate", s__MilimSpells___MilimGKS_frame1[pid], 0, 0)
            call BlzFrameSetAbsPoint(s__MilimSpells___MilimGKS_frame2[pid], FRAMEPOINT_CENTER, 0.07, 0.185 + tmpY)
            call BlzFrameSetSize(s__MilimSpells___MilimGKS_frame2[pid], 0.1, 0.019)

            set s__MilimSpells___MilimGKS_frame3[pid]=BlzCreateFrameByType("STATUSBAR", "", s__MilimSpells___MilimGKS_frame1[pid], "", 0)
            call BlzFrameSetSize(s__MilimSpells___MilimGKS_frame3[pid], 0.1, 0.035)
            call BlzFrameSetScale(s__MilimSpells___MilimGKS_frame3[pid], 0.5)
            call BlzFrameSetModel(s__MilimSpells___MilimGKS_frame3[pid], "ui/feedback/XpBar/XpBarConsole.mdx", 0)
            call BlzFrameSetAbsPoint(s__MilimSpells___MilimGKS_frame3[pid], FRAMEPOINT_CENTER, 0.05, 0.175 + tmpY)
            call BlzFrameSetMinMaxValue(s__MilimSpells___MilimGKS_frame3[pid], 0.00, maxDamage + 10)
            call BlzFrameSetValue(s__MilimSpells___MilimGKS_frame3[pid], 0.00)

            set s__MilimSpells___MilimGKS_frame4[pid]=BlzCreateFrameByType("BACKDROP", "SS", s__MilimSpells___MilimGKS_frame1[pid], "", 0)
            call BlzFrameSetAbsPoint(s__MilimSpells___MilimGKS_frame4[pid], FRAMEPOINT_CENTER, 0.005, 0.18 + tmpY)
            call BlzFrameSetSize(s__MilimSpells___MilimGKS_frame4[pid], 0.03, 0.03)
            call BlzFrameSetTexture(s__MilimSpells___MilimGKS_frame4[pid], "ReplaceableTextures\\CommandButtons\\BTNHero_Milim_G.blp", 0, false)

            set s__MilimSpells___MilimGKS_frame5[pid]=BlzCreateFrameByType("TEXT", "MyPlayerName", s__MilimSpells___MilimGKS_frame1[pid], "", 0)
            call BlzFrameSetAbsPoint(s__MilimSpells___MilimGKS_frame5[pid], FRAMEPOINT_CENTER, 0.07, 0.185 + tmpY)
            call BlzFrameSetText(s__MilimSpells___MilimGKS_frame5[pid], "|c00FFFF00Damage received:|r")
            call BlzFrameSetScale(s__MilimSpells___MilimGKS_frame5[pid], 0.9)

            set s__MilimSpells___MilimGKS_frame6[pid]=BlzCreateFrameByType("TEXT", "MyPlayerName", s__MilimSpells___MilimGKS_frame1[pid], "", 0)
            call BlzFrameSetAbsPoint(s__MilimSpells___MilimGKS_frame6[pid], FRAMEPOINT_CENTER, 0.07, 0.17 + tmpY)
            call BlzFrameSetScale(s__MilimSpells___MilimGKS_frame6[pid], 0.9)
        endif

        if GetLocalPlayer() == GetOwningPlayer(c) then
            call BlzFrameSetVisible(s__MilimSpells___MilimGKS_frame1[pid], true)
        endif
        call s__MilimSpells___MilimGKS_UpdateFrame(c)
    endfunction

    function s__MilimSpells___MilimGKS_AddDamage takes unit c,real amount returns nothing
        local real oldDamage
        local real newDamage
        local real maxDamage

        if c == null or amount <= 0.00 or GetHeroLevel(c) < 12 then
            return
        endif

        set oldDamage=LoadReal(hs, GetHandleId(c), StringHash("milim g dmg"))
        set maxDamage=s__MilimSpells___MilimGKS_GetMaxDamage(c)
        set newDamage=oldDamage + amount
        if newDamage > maxDamage then
            set newDamage=maxDamage
        endif
        call SaveReal(hs, GetHandleId(c), StringHash("milim g dmg"), newDamage)

        if oldDamage < MilimG_DamagetoStats1 and newDamage >= MilimG_DamagetoStats1 then
            if GetUnitAbilityLevel(c, MilimG_Stat_ID1) == 0 then
                call UnitAddAbility(c, MilimG_Stat_ID1)
                call UnitMakeAbilityPermanent(c, true, MilimG_Stat_ID1)
            endif
            call MakeSound("war3mapimported\\Hero_Milim_G1")
        endif
        if GetHeroLevel(c) >= 25 and oldDamage < MilimG_DamagetoStats2 and newDamage >= MilimG_DamagetoStats2 then
            if GetUnitAbilityLevel(c, MilimG_Stat_ID2) == 0 then
                call UnitAddAbility(c, MilimG_Stat_ID2)
                call UnitMakeAbilityPermanent(c, true, MilimG_Stat_ID2)
            endif
            call MakeSound("war3mapimported\\Hero_Milim_G2")
        endif
        if GetHeroLevel(c) >= 35 and oldDamage < MilimG_DamagetoStats3 and newDamage >= MilimG_DamagetoStats3 then
            if GetUnitAbilityLevel(c, MilimG_Stat_ID3) == 0 then
                call UnitAddAbility(c, MilimG_Stat_ID3)
                call UnitMakeAbilityPermanent(c, true, MilimG_Stat_ID3)
            endif
            call MakeSound("war3mapimported\\Hero_Milim_G3")
        endif

        call s__MilimSpells___MilimGKS_Start(c)
    endfunction

    function s__MilimSpells___MilimGKS_Reset takes unit c returns nothing
        if c == null then
            return
        endif
        call UnitRemoveAbility(c, MilimG_Stat_ID1)
        call UnitRemoveAbility(c, MilimG_Stat_ID2)
        call UnitRemoveAbility(c, MilimG_Stat_ID3)
        call SaveReal(hs, GetHandleId(c), StringHash("milim g dmg"), 0.00)
        if GetHeroLevel(c) >= 12 then
            call s__MilimSpells___MilimGKS_Start(c)
        endif
    endfunction




    
