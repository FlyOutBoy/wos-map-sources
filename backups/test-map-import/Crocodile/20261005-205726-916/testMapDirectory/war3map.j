                            call GroupEnumUnitsInRange(s__TakeshiSpells__TakeshiSpells_Q_g[this], s__TakeshiSpells__TakeshiSpells_Q_x[this], s__TakeshiSpells__TakeshiSpells_Q_y[this], s__TakeshiSpells__TakeshiSpells_Q_aoe[this], NoDecor_Cond)
