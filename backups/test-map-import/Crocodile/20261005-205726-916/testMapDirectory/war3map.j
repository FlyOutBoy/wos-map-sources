                        call SetHpCurrent2(s__KiritoSpells__KiritoSpells_G_c[this] , s__KiritoSpells__KiritoSpells_G_c[this] , s__KiritoSpells__KiritoSpells_G_r5[this])
                        call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\wos_e_buffgreen2a.mdx", s__KiritoSpells__KiritoSpells_G_c[this], "origin"))
                    endif
