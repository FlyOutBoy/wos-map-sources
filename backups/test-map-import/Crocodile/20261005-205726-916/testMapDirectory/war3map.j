                                set s__BarraganSpells__HeroSpells_Q_y1[this]=( GetUnitY(s__BarraganSpells__HeroSpells_Q_c[this]) + 20 * Sin(s__BarraganSpells__HeroSpells_Q_a[this] + 90 * bj_DEGTORAD) ) + 79 * Sin(s__BarraganSpells__HeroSpells_Q_a[this])
                                set s__BarraganSpells__HeroSpells_Q_move[this]=0
                                set s__BarraganSpells__HeroSpells_Q_scale[this]=0.5
                                set s__BarraganSpells__HeroSpells_Q_rmax[this]=1.5
                                set s__BarraganSpells__HeroSpells_Q_r[this]=0
                                set s__BarraganSpells__HeroSpells_Q_r7[this]=0
