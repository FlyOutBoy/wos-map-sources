        function s__MilimSpells___MilimQKS_Loop_MilimQ takes nothing returns nothing
            local integer this
            local integer i= 0
            
            loop
                exitwhen i > s__MilimSpells___MilimQKS_MUI_MilimQ
                set this=s__MilimSpells___MilimQKS_m_MilimQ[i]
                if SpellBoolCaster(s__MilimSpells___MilimQKS_c[this]) and s__MilimSpells___MilimQKS_r[this] <= s__MilimSpells___MilimQKS_rmax[this] then
                    set s__MilimSpells___MilimQKS_r[this]=s__MilimSpells___MilimQKS_r[this] + 0.03
                        call DebugUnit2(s__MilimSpells___MilimQKS_c[this])
                        if s__MilimSpells___MilimQKS_check[this] == 0 then
                        if s__MilimSpells___MilimQKS_r[this] == 0.3 then
                        call SetUnitAnimationByIndex(s__MilimSpells___MilimQKS_c[this], 3)
                        
                call SetUnitTimeScale(s__MilimSpells___MilimQKS_c[this], 1.25)
