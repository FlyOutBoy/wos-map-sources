                        set s__BazzBSpells__BazzBSpells_Q_r5[this]=s__BazzBSpells__BazzBSpells_Q_r5[this] + s__BazzBSpells__BazzBSpells_Q_move[this]
                        set s__BazzBSpells__BazzBSpells_Q_x1[this]=s__BazzBSpells__BazzBSpells_Q_x1[this] + s__BazzBSpells__BazzBSpells_Q_move[this] * Cos(s__BazzBSpells__BazzBSpells_Q_a[this])
                        set s__BazzBSpells__BazzBSpells_Q_y1[this]=s__BazzBSpells__BazzBSpells_Q_y1[this] + s__BazzBSpells__BazzBSpells_Q_move[this] * Sin(s__BazzBSpells__BazzBSpells_Q_a[this])
                        call DecorRemove(s__BazzBSpells__BazzBSpells_Q_c[this] , s__BazzBSpells__BazzBSpells_Q_x1[this] , s__BazzBSpells__BazzBSpells_Q_y1[this] , s__BazzBSpells__BazzBSpells_Q_aoe[this] , BazzBQ_DecorDamage)
                        call GroupClear(s__BazzBSpells__BazzBSpells_Q_g[this])
                        call GroupEnumUnitsInRange(s__BazzBSpells__BazzBSpells_Q_g[this], s__BazzBSpells__BazzBSpells_Q_x1[this], s__BazzBSpells__BazzBSpells_Q_y1[this], s__BazzBSpells__BazzBSpells_Q_aoe[this], Condition(function NoDecor_Filter))
                        loop
                            set u=FirstOfGroup(s__BazzBSpells__BazzBSpells_Q_g[this])
                            exitwhen u == null
                            call GroupRemoveUnit(s__BazzBSpells__BazzBSpells_Q_g[this], u)
                            if SpellBool(u) and IsUnitEnemy(u, GetOwningPlayer(s__BazzBSpells__BazzBSpells_Q_c[this])) and not IsUnitInGroup(u, s__BazzBSpells__BazzBSpells_Q_g2[this]) then
                                call dmgmag(s__BazzBSpells__BazzBSpells_Q_c[this] , u , s__BazzBSpells__BazzBSpells_Q_dmg[this])
                                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", u, "chest"))
                                call GroupAddUnit(s__BazzBSpells__BazzBSpells_Q_g2[this], u)
                            endif
                        endloop

                        if s__BazzBSpells__BazzBSpells_Q_r2[this] >= 0.0 then
                            set s__BazzBSpells__BazzBSpells_Q_r2[this]=0.0
                            call EffectSpawn2("war3mapImported\\wos_BY_Wood_Effect_Order_MuZhiBenYing_Fir_Huo_DiMianss2.mdl" , s__BazzBSpells__BazzBSpells_Q_x1[this] , s__BazzBSpells__BazzBSpells_Q_y1[this] , GetRandomReal(0.0, 359.0) , 2.0 , 1.0 , 0.0 , 0.15)
                            call VisionTimed(GetOwningPlayer(s__BazzBSpells__BazzBSpells_Q_c[this]) , s__BazzBSpells__BazzBSpells_Q_x1[this] , s__BazzBSpells__BazzBSpells_Q_y1[this] , 800.0 , 1.0)
                        else
                            set s__BazzBSpells__BazzBSpells_Q_r2[this]=s__BazzBSpells__BazzBSpells_Q_r2[this] + 0.03
                        endif

                        if s__BazzBSpells__BazzBSpells_Q_r3[this] >= 0.03 then
                            set s__BazzBSpells__BazzBSpells_Q_r3[this]=0.0
                            call VisionTimed(GetOwningPlayer(s__BazzBSpells__BazzBSpells_Q_c[this]) , s__BazzBSpells__BazzBSpells_Q_x1[this] , s__BazzBSpells__BazzBSpells_Q_y1[this] , 800.0 , 1.0)
                        else
                            set s__BazzBSpells__BazzBSpells_Q_r3[this]=s__BazzBSpells__BazzBSpells_Q_r3[this] + 0.03
                        endif
                    endif
                else
                    set remove=true
                endif

                if remove then
                    if s__BazzBSpells__BazzBSpells_Q_check[this] == 1 then
                    
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_firefly-rq-sfx2" , s__BazzBSpells__BazzBSpells_Q_x1[this] , s__BazzBSpells__BazzBSpells_Q_y1[this] , 1.1 , 1.0 , 2.5 , 90.0))
