        call s__GearSystems2___KS_SpellTimer_SpellTimer_Timer_Start((c ) , 0 , ( TsunaW2_ID ) , ( TsunaW_ID ) , ( TsunaW_Buff_ID)) // INLINED!!
        call SetUnitAbilityLevel(c, TsunaW2_ID, GetUnitAbilityLevel(c, TsunaW_ID))
        call s__GearSystems2___KS_BuffTimer_MyBuffTime_Start((c ) , ( TsunaW_Buff_ID ) , (( TsunaW_BuffDuration )*1.0) , ( "BTNHero_Tsuna_W" ) , ( true ) , - 1 , 0 , 0 , ( 2)) // INLINED!!
        call MakeSound("war3mapimported\\Hero_Tsuna_W")
    endfunction
