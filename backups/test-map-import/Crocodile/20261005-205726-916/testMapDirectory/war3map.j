    endif
    if GetUnitAbilityLevel(c, InoriG_ID) == 0 then
    call UnitAddAbility(c, InoriG_ID)
    call UnitMakeAbilityPermanent(c, true, InoriG_ID)
    call UnitAddAbility(c, InoriF_ID)
