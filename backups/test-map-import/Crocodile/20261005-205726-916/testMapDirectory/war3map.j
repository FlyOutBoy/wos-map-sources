                        set s__AstaSpells___AstaSpells_Q_e3[this]=EffectSpawn("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl" , GetUnitX(s__AstaSpells___AstaSpells_Q_c[this]) + 250 * Cos(s__AstaSpells___AstaSpells_Q_a[this]) , GetUnitY(s__AstaSpells___AstaSpells_Q_c[this]) + 250 * Sin(s__AstaSpells___AstaSpells_Q_a[this]) , s__AstaSpells___AstaSpells_Q_a[this] * bj_RADTODEG , 0.65 , 3 , 135)
