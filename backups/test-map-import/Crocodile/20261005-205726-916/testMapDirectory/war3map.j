        function s__PatriotSpells___PatriotSpells_T_Loop_PatriotT takes nothing returns nothing
            local integer i= 0
            local integer this
            local unit u
            local real x1
            local real y1
            local real distance
            local boolean remove

            loop
                exitwhen i > s__PatriotSpells___PatriotSpells_T_MUI_PatriotT
                set this=s__PatriotSpells___PatriotSpells_T_m_PatriotT[i]
                set remove=false

                if s__PatriotSpells___PatriotSpells_T_c[this] == null or GetUnitTypeId(s__PatriotSpells___PatriotSpells_T_c[this]) == 0 or not SpellBoolCaster(s__PatriotSpells___PatriotSpells_T_c[this]) or s__PatriotSpells___PatriotSpells_T_r[this] > s__PatriotSpells___PatriotSpells_T_rmax[this] then
