                                set x1=(BlzGetLocalSpecialEffectX((s___PatriotSpells___PatriotSpells_T_ee[s__PatriotSpells___PatriotSpells_T_ee[this]+s__PatriotSpells___PatriotSpells_T_k[this]]))) // INLINED!!
                                set y1=(BlzGetLocalSpecialEffectY((s___PatriotSpells___PatriotSpells_T_ee[s__PatriotSpells___PatriotSpells_T_ee[this]+s__PatriotSpells___PatriotSpells_T_k[this]]))) // INLINED!!
                                call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_BY_Wood_Effect_Kula_2_YiYingCun2.mdl" , x1 - 250.0 * Cos(( 360.0 / I2R(s__PatriotSpells___PatriotSpells_T_k3[this]) ) * s__PatriotSpells___PatriotSpells_T_k[this] * bj_DEGTORAD) , y1 - 250.0 * Sin(( 360.0 / I2R(s__PatriotSpells___PatriotSpells_T_k3[this]) ) * s__PatriotSpells___PatriotSpells_T_k[this] * bj_DEGTORAD) , ( ( 360.0 / I2R(s__PatriotSpells___PatriotSpells_T_k3[this]) ) * s__PatriotSpells___PatriotSpells_T_k[this] ) + 180.0 , 0.95 , 2.25 , 50.0 , 255 , 255 , 255 , 190))
                                call DestroyEffect(EffectSpawn("war3mapimported\\wos_3yue_5.mdl" , x1 , y1 , GetRandomReal(0, 359) , 1.5 , 0.6 , 0.0))
                                call DestroyEffect(EffectSpawn("war3mapimported\\wos_1baozha_90.mdl" , x1 , y1 , GetRandomReal(0, 359) , 1.0 , 1.25 , 0.0))
                                set s__PatriotSpells___PatriotSpells_T_k[this]=s__PatriotSpells___PatriotSpells_T_k[this] + 1
