                                    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", s__ErzaQSpells__ErzaQ_KS_u[this], "chest"))
                                    call dmgphys(s__ErzaQSpells__ErzaQ_KS_c[this] , s__ErzaQSpells__ErzaQ_KS_u[this] , s__ErzaQSpells__ErzaQ_KS_dmg[this])
                                  //  call ErzaPassive(c, u, 1)
                                endif
                                call GroupRemoveUnit(s__ErzaQSpells__ErzaQ_KS_g[this], s__ErzaQSpells__ErzaQ_KS_u[this])
                            endloop
                            call ErzaEPas(s__ErzaQSpells__ErzaQ_KS_c[this] , s__ErzaQSpells__ErzaQ_KS_x[this] , s__ErzaQSpells__ErzaQ_KS_y[this])
                        endif
