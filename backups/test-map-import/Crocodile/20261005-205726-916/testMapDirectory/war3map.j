    function s__TakeshiSpells__TakeshiSpells_G_TakeshiGF_Start takes unit NewC,unit NewTd returns nothing
        local integer this= s__TakeshiSpells__TakeshiSpells_G__allocate()
        set s__TakeshiSpells__TakeshiSpells_G_MUI_TakeshiGF=s__TakeshiSpells__TakeshiSpells_G_MUI_TakeshiGF + 1
        set s__TakeshiSpells__TakeshiSpells_G_m_TakeshiGF[s__TakeshiSpells__TakeshiSpells_G_MUI_TakeshiGF]=this
        set s__TakeshiSpells__TakeshiSpells_G_c[this]=NewC
        set s__TakeshiSpells__TakeshiSpells_G_td[this]=NewTd
        set s__TakeshiSpells__TakeshiSpells_G_r[this]=0
        set s__TakeshiSpells__TakeshiSpells_G_r2[this]=0
        set s__TakeshiSpells__TakeshiSpells_G_move[this]=70
        set s__TakeshiSpells__TakeshiSpells_G_r5[this]=0
        set s__TakeshiSpells__TakeshiSpells_G_check[this]=0
        call StartSpellUnit2(s__TakeshiSpells__TakeshiSpells_G_c[this])
        set s__TakeshiSpells__TakeshiSpells_G_a[this]=GAngle(s__TakeshiSpells__TakeshiSpells_G_c[this] , s__TakeshiSpells__TakeshiSpells_G_td[this]) // Angle Between points
        set s__TakeshiSpells__TakeshiSpells_G_dmg[this]=GetHeroAgi(s__TakeshiSpells__TakeshiSpells_G_c[this], true) * TakeshiGF_DamageAgiBase
        if GetUnitAbilityLevel(s__TakeshiSpells__TakeshiSpells_G_c[this], TakeshiT_Buff_ID) > 0 then
            set s__TakeshiSpells__TakeshiSpells_G_dmg[this]=s__TakeshiSpells__TakeshiSpells_G_dmg[this] + GetHeroAgi(s__TakeshiSpells__TakeshiSpells_G_c[this], true) * TakeshiT_AddDmg
        endif
        set s__TakeshiSpells__TakeshiSpells_G_rmax[this]=1.5
        call SetUnitAnimationByIndex(s__TakeshiSpells__TakeshiSpells_G_c[this], 16)
        call SetUnitTimeScale(s__TakeshiSpells__TakeshiSpells_G_c[this], 1.95)
        set s__TakeshiSpells__TakeshiSpells_G_e[this]=AddSpecialEffectTarget("war3mapImported\\wos_Windwalk Blue Soul.mdx", s__TakeshiSpells__TakeshiSpells_G_c[this], "hand right")
        call MakeSound("war3mapimported\\Hero_Takeshi_GF")
        if s__TakeshiSpells__TakeshiSpells_G_MUI_TakeshiGF == 0 then
            call TimerStart(s__TakeshiSpells__TakeshiSpells_G_t_TakeshiGF, 0.03, true, function s__TakeshiSpells__TakeshiSpells_G_Loop_TakeshiGF)
        endif
    endfunction


