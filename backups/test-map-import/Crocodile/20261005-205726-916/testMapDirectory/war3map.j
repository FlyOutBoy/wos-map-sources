                        set s___PatriotSpells___PatriotSpells_T_ee[s__PatriotSpells___PatriotSpells_T_ee[this]+s__PatriotSpells___PatriotSpells_T_k[this]]=null
                        set s__PatriotSpells___PatriotSpells_T_k[this]=s__PatriotSpells___PatriotSpells_T_k[this] + 1
                    endloop
                    if s__PatriotSpells___PatriotSpells_T_g[this] != null then
                        call DestroyGroup(s__PatriotSpells___PatriotSpells_T_g[this])
                    endif
                    if s__PatriotSpells___PatriotSpells_T_g2[this] != null then
                        call DestroyGroup(s__PatriotSpells___PatriotSpells_T_g2[this])
                    endif
                    call SaveReal(hs, GetHandleId(s__PatriotSpells___PatriotSpells_T_c[this]), StringHash("t x"), 0.0)
                    call SaveReal(hs, GetHandleId(s__PatriotSpells___PatriotSpells_T_c[this]), StringHash("t y"), 0.0)
                    set s__PatriotSpells___PatriotSpells_T_c[this]=null
                    set s__PatriotSpells___PatriotSpells_T_g[this]=null
                    set s__PatriotSpells___PatriotSpells_T_g2[this]=null
                    set u=null
                    set s__PatriotSpells___PatriotSpells_T_m_PatriotT[i]=s__PatriotSpells___PatriotSpells_T_m_PatriotT[s__PatriotSpells___PatriotSpells_T_MUI_PatriotT]
                    set s__PatriotSpells___PatriotSpells_T_MUI_PatriotT=s__PatriotSpells___PatriotSpells_T_MUI_PatriotT - 1
                    call s__PatriotSpells___PatriotSpells_T_deallocate(this)
