            endif
            if s__AlucardSpells__AlucardSpells_E_MUI_AlucardE == 0 then
                call TimerStart(s__AlucardSpells__AlucardSpells_E_t_AlucardE, 0.03, true, function s__AlucardSpells__AlucardSpells_E_Loop_AlucardE)
            endif
        endfunction



        function s__AlucardSpells__AlucardSpells_R_Loop_AlucardR takes nothing returns nothing
            local integer this
