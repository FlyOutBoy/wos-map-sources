  //  call UnitAddAbility(c,BarraganG4_ID)
   // call UnitMakeAbilityPermanent(c,true,BarraganG4_ID)
    //call SetPlayerAbilityAvailable(GetOwningPlayer(c),BarraganG4_ID,false)
    endif
    endif
