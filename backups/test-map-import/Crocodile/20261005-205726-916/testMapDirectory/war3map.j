        call BlzSetSpecialEffectHeight(e, BlzGetLocalSpecialEffectZ(e) + height)
        call BlzSetSpecialEffectScale(e, scale)
        call BlzSetSpecialEffectYaw(e, facing * bj_DEGTORAD)
        call ScaleEffDummy(e , time , scale1 , scale2)
        return e
    endfunction
