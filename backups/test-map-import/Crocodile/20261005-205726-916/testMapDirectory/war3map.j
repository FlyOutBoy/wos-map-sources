            loop
                exitwhen i > s__GearSystems2___KS_FlushInteger_MUI_30
                set this=s__GearSystems2___KS_FlushInteger_m_30[i]
                if s__GearSystems2___KS_FlushInteger_r[this] < s__GearSystems2___KS_FlushInteger_rmax[this] then
                    if s__GearSystems2___KS_FlushInteger_b[this] == true then
                    set s__GearSystems2___KS_FlushInteger_r[this]=RoundReal(s__GearSystems2___KS_FlushInteger_r[this] + 0.03 , 3)
                    elseif IsUnitPaused(s__GearSystems2___KS_FlushInteger_c[this]) == false then
                    set s__GearSystems2___KS_FlushInteger_r[this]=RoundReal(s__GearSystems2___KS_FlushInteger_r[this] + 0.03 , 3)
                    endif
                    if LoadInteger(hs, s__GearSystems2___KS_FlushInteger_id[this], s__GearSystems2___KS_FlushInteger_child_id[this]) == s__GearSystems2___KS_FlushInteger_value[this] then
                        set s__GearSystems2___KS_FlushInteger_r[this]=9999
                    endif
                else
                    if s__GearSystems2___KS_FlushInteger_r[this] != 9999 then
                        call SaveInteger(hs, s__GearSystems2___KS_FlushInteger_id[this], s__GearSystems2___KS_FlushInteger_child_id[this], s__GearSystems2___KS_FlushInteger_value[this])
                    endif
                    set s__GearSystems2___KS_FlushInteger_c[this]=null
                    set s__GearSystems2___KS_FlushInteger_m_30[i]=s__GearSystems2___KS_FlushInteger_m_30[s__GearSystems2___KS_FlushInteger_MUI_30]
                    set s__GearSystems2___KS_FlushInteger_MUI_30=s__GearSystems2___KS_FlushInteger_MUI_30 - 1
                    if s__GearSystems2___KS_FlushInteger_MUI_30 == - 1 then
