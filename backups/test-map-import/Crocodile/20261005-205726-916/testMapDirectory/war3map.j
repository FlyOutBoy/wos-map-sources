                            set s__BazzBSpells__BazzBSpells_T_r4[this]=s__BazzBSpells__BazzBSpells_T_r4[this] + 0.03
                        endif
                        set s__BazzBSpells__BazzBSpells_T_r5[this]=s__BazzBSpells__BazzBSpells_T_r5[this] + s__BazzBSpells__BazzBSpells_T_move[this]
                        set s__BazzBSpells__BazzBSpells_T_x1[this]=s__BazzBSpells__BazzBSpells_T_x1[this] + s__BazzBSpells__BazzBSpells_T_move[this] * Cos(s__BazzBSpells__BazzBSpells_T_a[this])
                        set s__BazzBSpells__BazzBSpells_T_y1[this]=s__BazzBSpells__BazzBSpells_T_y1[this] + s__BazzBSpells__BazzBSpells_T_move[this] * Sin(s__BazzBSpells__BazzBSpells_T_a[this])

                        if s__BazzBSpells__BazzBSpells_T_r6[this] >= 0.0 then
                            set s__BazzBSpells__BazzBSpells_T_r6[this]=0.0
                            call DecorRemove(s__BazzBSpells__BazzBSpells_T_c[this] , s__BazzBSpells__BazzBSpells_T_x1[this] , s__BazzBSpells__BazzBSpells_T_y1[this] , s__BazzBSpells__BazzBSpells_T_aoe[this] , BazzBT_DecorDamage)
                            call GroupClear(s__BazzBSpells__BazzBSpells_T_g[this])
                            call GroupEnumUnitsInRange(s__BazzBSpells__BazzBSpells_T_g[this], s__BazzBSpells__BazzBSpells_T_x1[this], s__BazzBSpells__BazzBSpells_T_y1[this], s__BazzBSpells__BazzBSpells_T_aoe[this], Condition(function NoDecor_Filter))
                            loop
                                set u=FirstOfGroup(s__BazzBSpells__BazzBSpells_T_g[this])
                                exitwhen u == null
                                call GroupRemoveUnit(s__BazzBSpells__BazzBSpells_T_g[this], u)
                                if SpellBool(u) and IsUnitEnemy(u, GetOwningPlayer(s__BazzBSpells__BazzBSpells_T_c[this])) and not IsUnitInGroup(u, s__BazzBSpells__BazzBSpells_T_g2[this]) then
                                    call dmgmag(s__BazzBSpells__BazzBSpells_T_c[this] , u , s__BazzBSpells__BazzBSpells_T_dmg[this])
                                    call MUE(u , BazzBT_Push , BazzBT_PushDuration , s__BazzBSpells__BazzBSpells_T_a[this])
                                    if BazzBT_StunDuration > 0.0 then
                                        call StunUnit(s__BazzBSpells__BazzBSpells_T_c[this] , u , BazzBT_StunDuration)
                                    endif
                                    call GroupAddUnit(s__BazzBSpells__BazzBSpells_T_g2[this], u)
                                endif
                            endloop
                        else
                            set s__BazzBSpells__BazzBSpells_T_r6[this]=s__BazzBSpells__BazzBSpells_T_r6[this] + 0.03
                        endif

                        if s__BazzBSpells__BazzBSpells_T_r2[this] >= 0.0 then
                            set s__BazzBSpells__BazzBSpells_T_r2[this]=0.0
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_firefly-rq-sfx2.mdl" , s__BazzBSpells__BazzBSpells_T_x1[this] , s__BazzBSpells__BazzBSpells_T_y1[this] , GetRandomReal(0.0, 359.0) , GetRandomReal(1.0, 2.0) , 2.5 , 105.0))
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_opdef (652).mdl" , s__BazzBSpells__BazzBSpells_T_x1[this] , s__BazzBSpells__BazzBSpells_T_y1[this] , GetRandomReal(0.0, 359.0) , 2.0 , 1.0 , 150.0))
                            call VisionTimed(GetOwningPlayer(s__BazzBSpells__BazzBSpells_T_c[this]) , s__BazzBSpells__BazzBSpells_T_x1[this] , s__BazzBSpells__BazzBSpells_T_y1[this] , 1200.0 , 1.0)
                        else
                            set s__BazzBSpells__BazzBSpells_T_r2[this]=s__BazzBSpells__BazzBSpells_T_r2[this] + 0.03
                        endif
                    endif
                else
                    set remove=true
                endif

                if remove then
                    if s__BazzBSpells__BazzBSpells_T_c[this] != null and GetUnitTypeId(s__BazzBSpells__BazzBSpells_T_c[this]) != 0 then
                        call StopSpellUnit(s__BazzBSpells__BazzBSpells_T_c[this])
                        call SetUnitTimeScale(s__BazzBSpells__BazzBSpells_T_c[this], 1.0)
                    endif
                    if s__BazzBSpells__BazzBSpells_T_e[this] != null then
                        call DestroyEffect(s__BazzBSpells__BazzBSpells_T_e[this])
                        set s__BazzBSpells__BazzBSpells_T_e[this]=null
                    endif
                    if s__BazzBSpells__BazzBSpells_T_e2[this] != null then
                        call DestroyEffect(s__BazzBSpells__BazzBSpells_T_e2[this])
                        set s__BazzBSpells__BazzBSpells_T_e2[this]=null
                    endif
                    if s__BazzBSpells__BazzBSpells_T_e3[this] != null then
                        call DestroyEffect(s__BazzBSpells__BazzBSpells_T_e3[this])
                        set s__BazzBSpells__BazzBSpells_T_e3[this]=null
                    endif
                    if s__BazzBSpells__BazzBSpells_T_e4[this] != null then
                        call DestroyEffect(s__BazzBSpells__BazzBSpells_T_e4[this])
                        set s__BazzBSpells__BazzBSpells_T_e4[this]=null
                    endif
                    if s__BazzBSpells__BazzBSpells_T_e5[this] != null then
                        call DestroyEffect(s__BazzBSpells__BazzBSpells_T_e5[this])
                        set s__BazzBSpells__BazzBSpells_T_e5[this]=null
                    endif
                    if s__BazzBSpells__BazzBSpells_T_e6[this] != null then
                        call DestroyEffect(s__BazzBSpells__BazzBSpells_T_e6[this])
                        set s__BazzBSpells__BazzBSpells_T_e6[this]=null
                    endif
                    if s__BazzBSpells__BazzBSpells_T_g[this] != null then
                        call DestroyGroup(s__BazzBSpells__BazzBSpells_T_g[this])
                    endif
                    if s__BazzBSpells__BazzBSpells_T_g2[this] != null then
                        call DestroyGroup(s__BazzBSpells__BazzBSpells_T_g2[this])
                    endif
                    set s__BazzBSpells__BazzBSpells_T_g[this]=null
                    set s__BazzBSpells__BazzBSpells_T_g2[this]=null
                    set s__BazzBSpells__BazzBSpells_T_c[this]=null
                    set u=null
                    set s__BazzBSpells__BazzBSpells_T_m_BazzBT[i]=s__BazzBSpells__BazzBSpells_T_m_BazzBT[s__BazzBSpells__BazzBSpells_T_MUI_BazzBT]
                    set s__BazzBSpells__BazzBSpells_T_MUI_BazzBT=s__BazzBSpells__BazzBSpells_T_MUI_BazzBT - 1
                    call s__BazzBSpells__BazzBSpells_T_deallocate(this)
                    if s__BazzBSpells__BazzBSpells_T_MUI_BazzBT == - 1 then
                        call BazzBSpells__BazzBTimer03Release()
                    endif
                else
                    set i=i + 1
                endif
            endloop
            set u=null
        endfunction

        function s__BazzBSpells__BazzBSpells_T_BazzBT_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this
            if NewC == null or GetUnitTypeId(NewC) == 0 or GetWidgetLife(NewC) <= 0.405 then
                return
            endif
            set this=s__BazzBSpells__BazzBSpells_T__allocate()
            set s__BazzBSpells__BazzBSpells_T_MUI_BazzBT=s__BazzBSpells__BazzBSpells_T_MUI_BazzBT + 1
            set s__BazzBSpells__BazzBSpells_T_m_BazzBT[s__BazzBSpells__BazzBSpells_T_MUI_BazzBT]=this
            set s__BazzBSpells__BazzBSpells_T_c[this]=NewC
            set s__BazzBSpells__BazzBSpells_T_x[this]=NewX
            set s__BazzBSpells__BazzBSpells_T_y[this]=NewY
            set s__BazzBSpells__BazzBSpells_T_r[this]=0.0
            set s__BazzBSpells__BazzBSpells_T_r2[this]=0.0
            set s__BazzBSpells__BazzBSpells_T_r3[this]=0.0
            set s__BazzBSpells__BazzBSpells_T_r4[this]=0.0
            set s__BazzBSpells__BazzBSpells_T_r5[this]=0.0
            set s__BazzBSpells__BazzBSpells_T_r6[this]=0.0
            set s__BazzBSpells__BazzBSpells_T_r7[this]=0.0
            set s__BazzBSpells__BazzBSpells_T_check[this]=0
            call StartSpellUnit(s__BazzBSpells__BazzBSpells_T_c[this])
            set s__BazzBSpells__BazzBSpells_T_g[this]=CreateGroup()
            set s__BazzBSpells__BazzBSpells_T_g2[this]=CreateGroup()
            set s__BazzBSpells__BazzBSpells_T_a[this]=GAngle2(s__BazzBSpells__BazzBSpells_T_c[this] , s__BazzBSpells__BazzBSpells_T_x[this] , s__BazzBSpells__BazzBSpells_T_y[this])
            call DestroyEffect(EffectSpawn("war3mapimported\\wos_HakkeStart.mdx" , GetUnitX(s__BazzBSpells__BazzBSpells_T_c[this]) , GetUnitY(s__BazzBSpells__BazzBSpells_T_c[this]) , GetRandomReal(0.0, 359.0) , 0.3 , 1.45 , 7.0))
            set s__BazzBSpells__BazzBSpells_T_e6[this]=AddSpecialEffectTarget("war3mapImported\\wos_firacharge2.mdx", s__BazzBSpells__BazzBSpells_T_c[this], "hand right")
            set s__BazzBSpells__BazzBSpells_T_aoe[this]=BazzBT_DamageAoe
            set s__BazzBSpells__BazzBSpells_T_dmg[this]=GetHeroAgi(s__BazzBSpells__BazzBSpells_T_c[this], true) * BazzBT_DamageAgiBase
            set s__BazzBSpells__BazzBSpells_T_rmax[this]=3.0
            call s__GearSystems2___KS_RemoveEffect_MyRemoveEff_Start((AddSpecialEffectTarget("war3mapImported\\wos_summon3missle.mdl", s__BazzBSpells__BazzBSpells_T_c[this], "hand right") ) , (( 1.41)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
            call s__GearSystems2___KS_RemoveEffect_MyRemoveEff_Start((AddSpecialEffectTarget("war3mapImported\\wos_summon3missle.mdl", s__BazzBSpells__BazzBSpells_T_c[this], "hand left") ) , (( 1.41)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
            call SetUnitAnimationByIndex(s__BazzBSpells__BazzBSpells_T_c[this], 3)
            call SetUnitTimeScale(s__BazzBSpells__BazzBSpells_T_c[this], 0.65)
            call MakeSound("war3mapimported\\Hero_BazzB_T")
            if s__BazzBSpells__BazzBSpells_T_MUI_BazzBT == 0 then
                call BazzBSpells__BazzBTimer03Acquire()
            endif
        endfunction

    function BazzBSpells__BazzBTimer03Loop takes nothing returns nothing
