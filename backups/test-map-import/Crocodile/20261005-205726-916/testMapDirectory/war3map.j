            set s__TojiSpells___TojiSpells_G_td[this]=NewTd
            set s__TojiSpells___TojiSpells_G_r[this]=0.00
            set s__TojiSpells___TojiSpells_G_r2[this]=0.00
            set s__TojiSpells___TojiSpells_G_move[this]=0.00
            set s__TojiSpells___TojiSpells_G_check[this]=0
            set s__TojiSpells___TojiSpells_G_u[this]=null
            set s__TojiSpells___TojiSpells_G_e[this]=null
            set s__TojiSpells___TojiSpells_G_e2[this]=null
            set s__TojiSpells___TojiSpells_G_g[this]=CreateGroup()
            set s__TojiSpells___TojiSpells_G_g2[this]=CreateGroup()
            set level=GetUnitAbilityLevel(NewC, TojiG_ID)
            if level < 1 then
                set level=1
            endif
            set s__TojiSpells___TojiSpells_G_aoe[this]=TojiG_DamageAoe + 25.00
            set s__TojiSpells___TojiSpells_G_dmg[this]=GetHeroAgi(NewC, true) * ( TojiG_DamageAgiBase + TojiG_DamageAgiStep * ( level - 1 ) )
            set s__TojiSpells___TojiSpells_G_dmg[this]=s__TojiSpells___TojiSpells_G_dmg[this] + TojiG_DamageStaticBase + TojiG_DamageStaticStep * ( level - 1 ) + TojiSpells___TojiE_ConsumeLeapBonus(NewC)
            set s__TojiSpells___TojiSpells_G_a[this]=GAngle(NewC , NewTd)
            if TojiG_IsInvul then
                call StartSpellUnit(NewC)
            else
                call StartSpellUnit2(NewC)
            endif
            call SetUnitFacing(NewC, s__TojiSpells___TojiSpells_G_a[this] * bj_RADTODEG)
            call MakeSound("war3mapimported\\Hero_Toji_G2 1")
            call MakeSound("war3mapimported\\Hero_Toji_G2 2")
            call SetUnitAnimationByIndex(NewC, 5)
            call SetUnitTimeScale(NewC, 0.65)
            call SaveInteger(hs, GetHandleId(NewTd), StringHash("toji bullet"), 1)
            if s__TojiSpells___TojiSpells_G_MUI_TojiG == 0 then
                call TojiSpells___TojiTimer05Acquire()
            endif
        endfunction



        function s__TojiSpells___TojiSpells_T_Loop_TojiT takes nothing returns nothing
            local integer i= 0
            local integer this
            local unit u
            local real x1
            local real y1
            local real rr1
            local real rr2
            local real progress
            local integer k
            local integer k2
            local boolean remove

            loop
                exitwhen i > s__TojiSpells___TojiSpells_T_MUI_TojiT
                set this=s__TojiSpells___TojiSpells_T_m_TojiT[i]
                set remove=false

                if s__TojiSpells___TojiSpells_T_c[this] == null or GetUnitTypeId(s__TojiSpells___TojiSpells_T_c[this]) == 0 or GetWidgetLife(s__TojiSpells___TojiSpells_T_c[this]) <= 0.405 then
                    set remove=true
                else
                    if TojiT_IsInvul then
                        call DebugUnit(s__TojiSpells___TojiSpells_T_c[this])
                    else
                        call DebugUnit2(s__TojiSpells___TojiSpells_T_c[this])
                    endif
                    call PosUnit(s__TojiSpells___TojiSpells_T_c[this] , s__TojiSpells___TojiSpells_T_x[this] , s__TojiSpells___TojiSpells_T_y[this])
                    if s__TojiSpells___TojiSpells_T_state[this] == 0 then
                        set s__TojiSpells___TojiSpells_T_r[this]=RoundReal(s__TojiSpells___TojiSpells_T_r[this] + 0.03 , 3)
                        if s__TojiSpells___TojiSpells_T_r2[this] >= 0.42 then
                            set s__TojiSpells___TojiSpells_T_r2[this]=0.0
                            call MakeSound("war3mapImported\\Hero_Toji_T4")
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_ZarakiWCrack1.mdx" , s__TojiSpells___TojiSpells_T_x[this] , s__TojiSpells___TojiSpells_T_y[this] , GetRandomReal(0, 359) , 1.25 , 2.15 , 0))
                            call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_firefly-rr-sfx9.mdl" , s__TojiSpells___TojiSpells_T_x[this] , s__TojiSpells___TojiSpells_T_y[this] , GetRandomReal(0, 359) , 1.15 , 5.55 , 650 , 255 , 255 , 255 , 145))
                        else
                            set s__TojiSpells___TojiSpells_T_r2[this]=RoundReal(s__TojiSpells___TojiSpells_T_r2[this] + 0.03 , 3)
                        endif
                        if s__TojiSpells___TojiSpells_T_r[this] >= TojiT_HitInterval then
                            call MakeSound("war3mapImported\\Hero_Toji_T3")
                            set s__TojiSpells___TojiSpells_T_r[this]=RoundReal(s__TojiSpells___TojiSpells_T_r[this] - TojiT_HitInterval , 3)
                            set k=0
                            set k2=2
                            loop
                                exitwhen k == k2
                                set rr1=GetRandomReal(0, 359) * bj_DEGTORAD
                                set rr2=GetRandomReal(275, 620)
                                set x1=s__TojiSpells___TojiSpells_T_x[this] + rr2 * Cos(rr1)
                                set y1=s__TojiSpells___TojiSpells_T_y[this] + rr2 * Sin(rr1)
                                call DestroyEffect(EffectSpawn("war3mapImported\\wos_NewDirtEXNofire.mdl" , x1 , y1 , GetRandomReal(0, 359) , 1.15 , 2.05 , 0))
                                set k=k + 1
                            endloop
                      
                            call DecorRemove(s__TojiSpells___TojiSpells_T_c[this] , s__TojiSpells___TojiSpells_T_x[this] , s__TojiSpells___TojiSpells_T_y[this] , TojiT_DamageAoe , TojiT_DecorDamage)
                            call DestroyEffect(EffectSpawn3("war3mapImported\\wos_blue_circular.mdl" , s__TojiSpells___TojiSpells_T_x[this] , s__TojiSpells___TojiSpells_T_y[this] , GetRandomReal(0, 359) , 1.15 , 1.25 , 425 , - 45))
                            call GroupClear(s__TojiSpells___TojiSpells_T_g[this])
                            call GroupEnumUnitsInRange(s__TojiSpells___TojiSpells_T_g[this], s__TojiSpells___TojiSpells_T_x[this], s__TojiSpells___TojiSpells_T_y[this], TojiT_DamageAoe, Condition(function NoDecor_Filter))
                            loop
                                set u=FirstOfGroup(s__TojiSpells___TojiSpells_T_g[this])
                                exitwhen u == null
                                call GroupRemoveUnit(s__TojiSpells___TojiSpells_T_g[this], u)
                                if IsUnitEnemy(u, GetOwningPlayer(s__TojiSpells___TojiSpells_T_c[this])) and SpellBool(u) then
                                    call dmgphys(s__TojiSpells___TojiSpells_T_c[this] , u , TojiSpells___TojiAbilityDamage(s__TojiSpells___TojiSpells_T_c[this] , u , s__TojiSpells___TojiSpells_T_dmg[this]))
                                    call BuffUnit01(s__TojiSpells___TojiSpells_T_c[this] , u , TojiG_AbiShieldPierce_ID , "curse" , 1)
                                    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", u, "chest"))
                                endif
                            endloop

                            set s__TojiSpells___TojiSpells_T_hits[this]=s__TojiSpells___TojiSpells_T_hits[this] + 1
                            if s__TojiSpells___TojiSpells_T_hits[this] >= TojiT_HitCount then
                                set s__TojiSpells___TojiSpells_T_state[this]=1
                                set s__TojiSpells___TojiSpells_T_r[this]=0.0
                            endif
                        endif
                    else
                        set s__TojiSpells___TojiSpells_T_r[this]=RoundReal(s__TojiSpells___TojiSpells_T_r[this] + 0.03 , 3)
                        set progress=s__TojiSpells___TojiSpells_T_r[this] / TojiT_DescendDuration
                        if progress > 1.0 then
                            set progress=1.0
                        endif
                        call SetUnitFlyHeight(s__TojiSpells___TojiSpells_T_c[this], TojiT_FlyHeight * ( 1.0 - progress ), 0.0)
                        if s__TojiSpells___TojiSpells_T_r[this] >= TojiT_DescendDuration then
                            call SetUnitFlyHeight(s__TojiSpells___TojiSpells_T_c[this], 0.0, 0.0)
                            call BlinkEff(s__TojiSpells___TojiSpells_T_c[this])
                            set remove=true
                        endif
                    endif
                endif

                if remove then
                    if s__TojiSpells___TojiSpells_T_c[this] != null and GetUnitTypeId(s__TojiSpells___TojiSpells_T_c[this]) != 0 then
                        call SetUnitFlyHeight(s__TojiSpells___TojiSpells_T_c[this], 0.0, 0.0)
                        call SetUnitTimeScale(s__TojiSpells___TojiSpells_T_c[this], 1.0)
                        if TojiT_IsInvul then
                            call StopSpellUnit(s__TojiSpells___TojiSpells_T_c[this])
                        else
                            call StopSpellUnit2(s__TojiSpells___TojiSpells_T_c[this])
                        endif
                        call ResetUnitAnimation(s__TojiSpells___TojiSpells_T_c[this])
                        if s__TojiSpells___TojiSpells_T_pierceAdded[this] then
                            call UnitRemoveAbility(s__TojiSpells___TojiSpells_T_c[this], TojiT_ShieldPierceBuff_ID)
                        endif
                    endif
                    
                    if s__TojiSpells___TojiSpells_T_g[this] != null then
                        call DestroyGroup(s__TojiSpells___TojiSpells_T_g[this])
                    endif
                    set s__TojiSpells___TojiSpells_T_g[this]=null
                    set s__TojiSpells___TojiSpells_T_c[this]=null
                    set s__TojiSpells___TojiSpells_T_m_TojiT[i]=s__TojiSpells___TojiSpells_T_m_TojiT[s__TojiSpells___TojiSpells_T_MUI_TojiT]
                    set s__TojiSpells___TojiSpells_T_MUI_TojiT=s__TojiSpells___TojiSpells_T_MUI_TojiT - 1
                    call s__TojiSpells___TojiSpells_T_deallocate(this)
                    if s__TojiSpells___TojiSpells_T_MUI_TojiT == - 1 then
                        call TojiSpells___TojiTimer03Release()
                    endif
                else
                    set i=i + 1
                endif
            endloop
            set u=null
        endfunction

        function s__TojiSpells___TojiSpells_T_TojiT_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this
            local real totalDamage

            if NewC == null or GetUnitTypeId(NewC) == 0 or GetWidgetLife(NewC) <= 0.405 then
                return
            endif

            set this=s__TojiSpells___TojiSpells_T__allocate()
            set s__TojiSpells___TojiSpells_T_MUI_TojiT=s__TojiSpells___TojiSpells_T_MUI_TojiT + 1
            set s__TojiSpells___TojiSpells_T_m_TojiT[s__TojiSpells___TojiSpells_T_MUI_TojiT]=this
            set s__TojiSpells___TojiSpells_T_c[this]=NewC
            set s__TojiSpells___TojiSpells_T_g[this]=CreateGroup()
            set s__TojiSpells___TojiSpells_T_state[this]=0
            set s__TojiSpells___TojiSpells_T_hits[this]=0
            set s__TojiSpells___TojiSpells_T_x[this]=NewX
            set s__TojiSpells___TojiSpells_T_y[this]=NewY
            set s__TojiSpells___TojiSpells_T_r[this]=0.0
            set s__TojiSpells___TojiSpells_T_r2[this]=0.30
            set totalDamage=GetHeroAgi(NewC, true) * TojiT_DamageAgi + TojiSpells___TojiE_ConsumeLeapBonus(NewC)
            set s__TojiSpells___TojiSpells_T_dmg[this]=totalDamage / I2R(TojiT_HitCount)
            set s__TojiSpells___TojiSpells_T_pierceAdded[this]=GetUnitAbilityLevel(NewC, TojiT_ShieldPierceBuff_ID) == 0
            if TojiT_IsInvul then
                call StartSpellUnit(s__TojiSpells___TojiSpells_T_c[this])
            else
                call StartSpellUnit2(s__TojiSpells___TojiSpells_T_c[this])
            endif
            call BlinkEff(NewC)
            call PosUnit(NewC , NewX , NewY)
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_Mdx_Effect_MirrorImage_Black.mdx" , GetUnitX(s__TojiSpells___TojiSpells_T_c[this]) , GetUnitY(s__TojiSpells___TojiSpells_T_c[this]) , GetUnitFacing(s__TojiSpells___TojiSpells_T_c[this]) , 1 , 1.8 , 600))

            if GetUnitAbilityLevel(NewC, 'Amrf') == 0 then
                call UnitAddAbility(NewC, 'Amrf')
                call UnitRemoveAbility(NewC, 'Amrf')
            endif
            if s__TojiSpells___TojiSpells_T_pierceAdded[this] then
                call UnitAddAbility(NewC, TojiT_ShieldPierceBuff_ID)
            endif
            call SetUnitFlyHeight(NewC, TojiT_FlyHeight, 0.0)
            call SetUnitAnimationByIndex(NewC, 8)
            call s__GearSystems2___KS_RemoveUnit_MyRemoveUnit_Start((s__TojiSpells___TojiSpells_T_c[this] ) , (( 0.03 )*1.0) , 2 , - 1 , ( 8) , "") // INLINED!!
            call VisionTimed(GetOwningPlayer(NewC) , NewX , NewY , TojiT_DamageAoe , TojiT_HitInterval * TojiT_HitCount + TojiT_DescendDuration)
            call MakeSound("war3mapImported\\Hero_Toji_T")
            call MakeSound("war3mapImported\\Hero_Toji_T2")

            if s__TojiSpells___TojiSpells_T_MUI_TojiT == 0 then
                call TojiSpells___TojiTimer03Acquire()
            endif
        endfunction

        function s__TojiSpells___TojiSpells_F_TojiF_Start takes unit NewC returns nothing
            local integer heroLevel
            local integer abilityLevel
            local integer currentMode
            local integer nextMode
            local integer oldAbilityId
            local integer hid
            local integer key
            local player owner
            local integer pid
            local boolean isMoving

            if NewC == null or GetUnitTypeId(NewC) == 0 then
                return
            endif

            set owner=GetOwningPlayer(NewC)
            set pid=GetPlayerId(owner)
            set isMoving=TojiSpells___Toji_IsMoving[pid]

            set heroLevel=GetHeroLevel(NewC)
            set hid=GetHandleId(NewC)
            set key=StringHash("TojiQ_ArsenalMode")
            set currentMode=LoadInteger(hs, hid, key)
            if currentMode < 1 or currentMode > 3 then
                set currentMode=1
            endif

            if currentMode == 1 then
                set oldAbilityId=TojiQ_ID
                call MakeSoundLocal("war3mapimported\\Hero_Toji_Q2 0" , owner)
                if not isMoving then
                    call s__GearSystems2___KS_RemoveUnit_MyRemoveUnit_Start((NewC ) , (( 0.03 )*1.0) , 2 , - 1 , ( 6) , "") // INLINED!!
                endif
            elseif currentMode == 2 then
                set oldAbilityId=TojiQ2_ID
                call MakeSoundLocal("war3mapimported\\Hero_Toji_Q3 0" , owner)
                if not isMoving then
                    call s__GearSystems2___KS_RemoveUnit_MyRemoveUnit_Start((NewC ) , (( 0.03 )*1.0) , 2 , - 1 , ( 9) , "") // INLINED!!
                endif
            else
                set oldAbilityId=TojiQ3_ID
                call MakeSoundLocal("war3mapimported\\Hero_Toji_Q1 0" , owner)
                if not isMoving then
                    call s__GearSystems2___KS_RemoveUnit_MyRemoveUnit_Start((NewC ) , (( 0.03 )*1.0) , 2 , - 1 , ( 7) , "") // INLINED!!
                endif
            endif
            set abilityLevel=GetUnitAbilityLevel(NewC, oldAbilityId)
            if abilityLevel < 1 then
                set abilityLevel=GetUnitAbilityLevel(NewC, TojiQ_ID)
            endif
            if abilityLevel < 1 then
                set abilityLevel=1
            endif

            if GetUnitAbilityLevel(NewC, TojiQ_ID) == 0 then
                call UnitAddAbility(NewC, TojiQ_ID)
                call UnitMakeAbilityPermanent(NewC, true, TojiQ_ID)
            endif
            call SetUnitAbilityLevel(NewC, TojiQ_ID, abilityLevel)

            if heroLevel >= TojiArsenalQ2HeroLevel then
                if GetUnitAbilityLevel(NewC, TojiQ2_ID) == 0 then
                    call UnitAddAbility(NewC, TojiQ2_ID)
                    call UnitMakeAbilityPermanent(NewC, true, TojiQ2_ID)
                endif
                call SetUnitAbilityLevel(NewC, TojiQ2_ID, abilityLevel)
            endif
            if heroLevel >= TojiArsenalQ3HeroLevel then
                if GetUnitAbilityLevel(NewC, TojiQ3_ID) == 0 then
                    call UnitAddAbility(NewC, TojiQ3_ID)
                    call UnitMakeAbilityPermanent(NewC, true, TojiQ3_ID)
                endif
                call SetUnitAbilityLevel(NewC, TojiQ3_ID, abilityLevel)
            endif

            if heroLevel < TojiArsenalQ2HeroLevel then
                set nextMode=1
            elseif heroLevel < TojiArsenalQ3HeroLevel then
                if currentMode == 1 then
                    set nextMode=2
                else
                    set nextMode=1
                endif
            elseif currentMode == 1 then
                set nextMode=2
            elseif currentMode == 2 then
                set nextMode=3
            else
                set nextMode=1
            endif

            call SetPlayerAbilityAvailable(owner, TojiQ_ID, nextMode == 1)
            call SetPlayerAbilityAvailable(owner, TojiQ2_ID, nextMode == 2)
            call SetPlayerAbilityAvailable(owner, TojiQ3_ID, nextMode == 3)
            call SaveInteger(hs, hid, key, nextMode)
            
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_bdef (383).mdl" , GetUnitX(NewC) , GetUnitY(NewC) , GetRandomReal(0, 359) , 1.25 , 0.6 , 1))
            if GetRandomInt(1, 2) == 1 then
                call MakeSoundLocal("war3mapimported\\Hero_Toji_F" , owner)
            else
                call MakeSoundLocal("war3mapimported\\Hero_Toji_F2" , owner)
            endif

            // Если герой был на бегу — мгновенно продолжаем бег без остановки
            if isMoving then
                call IssuePointOrder(NewC, "move", TojiSpells___Toji_LastOrderX[pid], TojiSpells___Toji_LastOrderY[pid])
            endif

            set owner=null
        endfunction

    function TojiSpells___TojiTimer03Loop takes nothing returns nothing
        call s__TojiSpells___TojiSpells_Q_Loop_TojiQ()
        call s__TojiSpells___TojiSpells_W_Loop_TojiW()
        call s__TojiSpells___TojiSpells_E_Loop_TojiE()
        call s__TojiSpells___TojiSpells_R_Insectoids_Loop_TojiRI()
        call s__TojiSpells___TojiSpells_T_Loop_TojiT()
    endfunction

    function TojiSpells___TojiTimer05Loop takes nothing returns nothing
        call s__TojiSpells___TojiSpells_G_Debuff_Loop_TojiG_Debuff()
        call s__TojiSpells___TojiSpells_G_Loop_TojiG()
    endfunction

    function TojiSpells___InitTojiSpells takes nothing returns nothing
        local trigger trgPoint= CreateTrigger()
        local trigger trgOrder= CreateTrigger()
        local trigger trgTarget= CreateTrigger()

        set TojiSpells___TojiTimer03=CreateTimer()
        set TojiSpells___TojiTimer03Callback=function TojiSpells___TojiTimer03Loop
        set TojiSpells___TojiTimer05=CreateTimer()
        set TojiSpells___TojiTimer05Callback=function TojiSpells___TojiTimer05Loop

        call TriggerRegisterAnyUnitEventBJ(trgPoint, EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
        call TriggerAddCondition(trgPoint, Condition(function TojiSpells___Toji_TrackPointOrder))

        call TriggerRegisterAnyUnitEventBJ(trgOrder, EVENT_PLAYER_UNIT_ISSUED_ORDER)
        call TriggerAddCondition(trgOrder, Condition(function TojiSpells___Toji_TrackStopOrder))

        call TriggerRegisterAnyUnitEventBJ(trgTarget, EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
        call TriggerAddCondition(trgTarget, Condition(function TojiSpells___Toji_TrackTargetOrder))

        set trgPoint=null
        set trgOrder=null
        set trgTarget=null
    endfunction

    function TojiQ_Start takes unit c,unit td returns nothing
        call s__TojiSpells___TojiSpells_Q_TojiQ_Start(c , td , 1)
    endfunction
    function TojiQ2_Start takes unit c,unit td returns nothing
