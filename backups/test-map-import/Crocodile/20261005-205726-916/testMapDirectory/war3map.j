            set s__MilimSpells___MilimTKS_c[this]=NewC
            set hp=GetUnitState(s__MilimSpells___MilimTKS_c[this], UNIT_STATE_LIFE) / GetUnitState(s__MilimSpells___MilimTKS_c[this], UNIT_STATE_MAX_LIFE)
            call BlzSetUnitMaxHP(s__MilimSpells___MilimTKS_c[this], BlzGetUnitMaxHP(s__MilimSpells___MilimTKS_c[this]) + MilimT_MaxHpBonus)
            call SetUnitState(s__MilimSpells___MilimTKS_c[this], UNIT_STATE_LIFE, GetUnitState(s__MilimSpells___MilimTKS_c[this], UNIT_STATE_MAX_LIFE) * hp)
