        function s__PatriotSpells___PatriotSpells_W_PatriotW_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__PatriotSpells___PatriotSpells_W__allocate()
            local integer level= GetUnitAbilityLevel(NewC, PatriotW_ID)
            if level < 1 then
                set level=1
            endif

            set s__PatriotSpells___PatriotSpells_W_MUI_PatriotW=s__PatriotSpells___PatriotSpells_W_MUI_PatriotW + 1
            set s__PatriotSpells___PatriotSpells_W_m_PatriotW[s__PatriotSpells___PatriotSpells_W_MUI_PatriotW]=this
            set s__PatriotSpells___PatriotSpells_W_c[this]=NewC
            set s__PatriotSpells___PatriotSpells_W_r[this]=0.0
            set s__PatriotSpells___PatriotSpells_W_x[this]=NewX
            set s__PatriotSpells___PatriotSpells_W_y[this]=NewY
            set s__PatriotSpells___PatriotSpells_W_r2[this]=10.0
            set s__PatriotSpells___PatriotSpells_W_g[this]=CreateGroup()
            call SaveReal(hs, GetHandleId(s__PatriotSpells___PatriotSpells_W_c[this]), StringHash("w x"), 0.0)
            call SaveReal(hs, GetHandleId(s__PatriotSpells___PatriotSpells_W_c[this]), StringHash("w y"), 0.0)
            call SaveInteger(hs, GetHandleId(s__PatriotSpells___PatriotSpells_W_c[this]), StringHash("w act"), 0)
            if GetHeroLevel(s__PatriotSpells___PatriotSpells_W_c[this]) >= 35 then
            set PatriotW_CastTime=0.03
            endif
            set s__PatriotSpells___PatriotSpells_W_aoe[this]=PatriotW_DamageAoe
            set s__PatriotSpells___PatriotSpells_W_a[this]=GAngle2(s__PatriotSpells___PatriotSpells_W_c[this] , s__PatriotSpells___PatriotSpells_W_x[this] , s__PatriotSpells___PatriotSpells_W_y[this])
            call MakeSound("war3mapImported\\Hero_Patriot_W")
            set s__PatriotSpells___PatriotSpells_W_k2[this]=PatriotW_DurationBase + ( PatriotW_DurationStep * ( level - 1 ) )
            set s__PatriotSpells___PatriotSpells_W_dmg[this]=GetHeroAgi(s__PatriotSpells___PatriotSpells_W_c[this], true) * ( PatriotW_DamageAgiBase + ( PatriotW_DamageAgiStep * ( level - 1 ) ) )
            set s__PatriotSpells___PatriotSpells_W_dmg[this]=s__PatriotSpells___PatriotSpells_W_dmg[this] + PatriotW_Damage2StaticBase + ( PatriotW_Damage2StaticStep * ( level - 1 ) )
            set s__PatriotSpells___PatriotSpells_W_dmg2[this]=GetHeroAgi(s__PatriotSpells___PatriotSpells_W_c[this], true) * ( PatriotW_HealAgiBase + ( PatriotW_HealAgiStep * ( level - 1 ) ) )
            set s__PatriotSpells___PatriotSpells_W_dmg2[this]=s__PatriotSpells___PatriotSpells_W_dmg2[this] + PatriotW_Heal2StaticBase + ( PatriotW_Heal2StaticStep * ( level - 1 ) )
            set s__PatriotSpells___PatriotSpells_W_rmax[this]=15.0
            set s__PatriotSpells___PatriotSpells_W_k3[this]=0
            set s__PatriotSpells___PatriotSpells_W_scale[this]=s__PatriotSpells___PatriotSpells_W_aoe[this] / 800.0

            call SetUnitFacing(s__PatriotSpells___PatriotSpells_W_c[this], s__PatriotSpells___PatriotSpells_W_a[this] * bj_RADTODEG)
            call Patriot_RestoreOrder(s__PatriotSpells___PatriotSpells_W_c[this] , 3)
            call SetUnitTimeScale(s__PatriotSpells___PatriotSpells_W_c[this], 1.0)
            call VisionTimed(GetOwningPlayer(s__PatriotSpells___PatriotSpells_W_c[this]) , s__PatriotSpells___PatriotSpells_W_x[this] , s__PatriotSpells___PatriotSpells_W_y[this] , 750.0 , 6.0)

            if s__PatriotSpells___PatriotSpells_W_MUI_PatriotW == 0 then
                call PatriotSpells___PatriotTimer03Acquire()
            endif
        endfunction

    // ===========================================================================
    // Master Timer Loop
    // ===========================================================================


        function s__PatriotSpells___PatriotSpells_E_Loop_PatriotE takes nothing returns nothing
            local integer i= 0
            local integer this
            local boolean remove

            loop
                exitwhen i > s__PatriotSpells___PatriotSpells_E_MUI_PatriotE
                set this=s__PatriotSpells___PatriotSpells_E_m_PatriotE[i]
                set remove=false

                if s__PatriotSpells___PatriotSpells_E_c[this] == null or GetUnitTypeId(s__PatriotSpells___PatriotSpells_E_c[this]) == 0 or not SpellBoolCaster(s__PatriotSpells___PatriotSpells_E_c[this]) or s__PatriotSpells___PatriotSpells_E_r[this] > s__PatriotSpells___PatriotSpells_E_rmax[this] then
                    set remove=true
                else
                    if not IsUnitPaused(s__PatriotSpells___PatriotSpells_E_c[this]) then
                        set s__PatriotSpells___PatriotSpells_E_r[this]=RoundReal(s__PatriotSpells___PatriotSpells_E_r[this] + 0.03 , 3)
                    endif

                    if s__PatriotSpells___PatriotSpells_E_r[this] == 0.03 then
                        if GetLocalPlayer() == GetOwningPlayer(s__PatriotSpells___PatriotSpells_E_c[this]) then
                            call ClearSelection()
                            call SelectUnit(s__PatriotSpells___PatriotSpells_E_c[this], true)
                            call PanCameraToTimed(GetUnitX(s__PatriotSpells___PatriotSpells_E_c[this]), GetUnitY(s__PatriotSpells___PatriotSpells_E_c[this]), 0.0)
                        endif
                    endif

                    call BlzFrameSetValue(s___PatriotSpells___PatriotSpells_E_frame_pas3[s__PatriotSpells___PatriotSpells_E_frame_pas3[this]+s__PatriotSpells___PatriotSpells_E_k2[this]], s__PatriotSpells___PatriotSpells_E_rmax[this] - ( s__PatriotSpells___PatriotSpells_E_r[this] + 0.05 ))
                    if s__PatriotSpells___PatriotSpells_E_rmax[this] - s__PatriotSpells___PatriotSpells_E_r[this] >= 0.0 then
                        call BlzFrameSetText(s___PatriotSpells___PatriotSpells_E_frame_pas6[s__PatriotSpells___PatriotSpells_E_frame_pas6[this]+s__PatriotSpells___PatriotSpells_E_k2[this]], "|c00FFFF00" + R2SW(s__PatriotSpells___PatriotSpells_E_rmax[this] - s__PatriotSpells___PatriotSpells_E_r[this], 0, 2) + "|r")
                    endif
                    set s__PatriotSpells___PatriotSpells_E_x1[this]=GetUnitX(s__PatriotSpells___PatriotSpells_E_c[this])
                    set s__PatriotSpells___PatriotSpells_E_y1[this]=GetUnitY(s__PatriotSpells___PatriotSpells_E_c[this])
                endif

                if remove then
                    if s__PatriotSpells___PatriotSpells_E_c[this] != null and GetUnitTypeId(s__PatriotSpells___PatriotSpells_E_c[this]) != 0 then
                        call PlayersMsg(GetPlayerVisualColorString(Player(s__PatriotSpells___PatriotSpells_E_id[this])) + GetPlayerName(Player(s__PatriotSpells___PatriotSpells_E_id[this])) + "|r killed " + GetPlayerVisualColorString(Player(s__PatriotSpells___PatriotSpells_E_id2[this])) + GetPlayerName(Player(s__PatriotSpells___PatriotSpells_E_id2[this])) + "|r" , 2)
                        call KillUnit(s__PatriotSpells___PatriotSpells_E_c[this])
                        if GetLocalPlayer() == GetOwningPlayer(s__PatriotSpells___PatriotSpells_E_c[this]) then
                            call BlzFrameSetVisible(s___PatriotSpells___PatriotSpells_E_frame_pas1[s__PatriotSpells___PatriotSpells_E_frame_pas1[this]+s__PatriotSpells___PatriotSpells_E_k2[this]], false)
                        endif
                        call SaveInteger(hs, GetHandleId(s__PatriotSpells___PatriotSpells_E_c[this]), StringHash("patriot ee"), 0)
                        call SaveInteger(hs, GetHandleId(s__PatriotSpells___PatriotSpells_E_c[this]), StringHash("patriot e"), 0)
                        call AddUnitAnimationProperties(s__PatriotSpells___PatriotSpells_E_c[this], "alternate", false)
                        call AAUniversalTooltips_SetUnitForm(s__PatriotSpells___PatriotSpells_E_c[this] , 0)
                    endif
                    if s__PatriotSpells___PatriotSpells_E_e2[this] != null then
                        call DestroyEffect(s__PatriotSpells___PatriotSpells_E_e2[this])
                    endif
                    set s__PatriotSpells___PatriotSpells_E_c[this]=null
                    set s__PatriotSpells___PatriotSpells_E_td[this]=null
                    set s__PatriotSpells___PatriotSpells_E_e2[this]=null
                    set s__PatriotSpells___PatriotSpells_E_m_PatriotE[i]=s__PatriotSpells___PatriotSpells_E_m_PatriotE[s__PatriotSpells___PatriotSpells_E_MUI_PatriotE]
                    set s__PatriotSpells___PatriotSpells_E_MUI_PatriotE=s__PatriotSpells___PatriotSpells_E_MUI_PatriotE - 1
                    call s__PatriotSpells___PatriotSpells_E_deallocate(this)
                    set i=i - 1
                    if s__PatriotSpells___PatriotSpells_E_MUI_PatriotE == - 1 then
                        call PatriotSpells___PatriotTimer03Release()
                    endif
                endif
                set i=i + 1
            endloop
        endfunction

        function s__PatriotSpells___PatriotSpells_E_PatriotE_Start takes unit NewC,unit NewTd returns nothing
            local integer this= s__PatriotSpells___PatriotSpells_E__allocate()
            local real tmp_y= 0.0
            local real cd1
            local real dmg

            set s__PatriotSpells___PatriotSpells_E_MUI_PatriotE=s__PatriotSpells___PatriotSpells_E_MUI_PatriotE + 1
            set s__PatriotSpells___PatriotSpells_E_m_PatriotE[s__PatriotSpells___PatriotSpells_E_MUI_PatriotE]=this
            set s__PatriotSpells___PatriotSpells_E_c[this]=NewC
            set s__PatriotSpells___PatriotSpells_E_td[this]=NewTd
            set s__PatriotSpells___PatriotSpells_E_id[this]=GetPlayerId(GetOwningPlayer(s__PatriotSpells___PatriotSpells_E_td[this]))
            set s__PatriotSpells___PatriotSpells_E_id2[this]=GetPlayerId(GetOwningPlayer(s__PatriotSpells___PatriotSpells_E_c[this]))
            set cd1=BlzGetUnitAbilityCooldownRemaining(s__PatriotSpells___PatriotSpells_E_c[this], PatriotT_ID)
            set s__PatriotSpells___PatriotSpells_E_r[this]=0.0
            set s__PatriotSpells___PatriotSpells_E_k2[this]=GetPlayerId(GetOwningPlayer(s__PatriotSpells___PatriotSpells_E_c[this]))
            set s__PatriotSpells___PatriotSpells_E_rmax[this]=PatriotEE_Duration

            call ReviveHero(s__PatriotSpells___PatriotSpells_E_c[this], GetUnitX(s__PatriotSpells___PatriotSpells_E_c[this]), GetUnitY(s__PatriotSpells___PatriotSpells_E_c[this]), true)
            set dmg=GetUnitState(s__PatriotSpells___PatriotSpells_E_c[this], UNIT_STATE_MAX_LIFE) * 0.10
            call SetUnitState(s__PatriotSpells___PatriotSpells_E_c[this], UNIT_STATE_LIFE, dmg)

            call SetPlayerAbilityAvailable(GetOwningPlayer(s__PatriotSpells___PatriotSpells_E_c[this]), PatriotF_ID, false)
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__PatriotSpells___PatriotSpells_E_c[this]), PatriotT_ID, false)
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__PatriotSpells___PatriotSpells_E_c[this]), PatriotF2_ID, true)
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__PatriotSpells___PatriotSpells_E_c[this]), PatriotT2_ID, true)
            call UnitAddAbility(s__PatriotSpells___PatriotSpells_E_c[this], PatriotF2_ID)
            if GetUnitAbilityLevel(s__PatriotSpells___PatriotSpells_E_c[this], PatriotT_ID) > 0 then
                call UnitAddAbility(s__PatriotSpells___PatriotSpells_E_c[this], PatriotT2_ID)
                call BlzStartUnitAbilityCooldown(s__PatriotSpells___PatriotSpells_E_c[this], PatriotT2_ID, cd1)
