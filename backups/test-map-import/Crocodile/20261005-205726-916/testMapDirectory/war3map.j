        function s__InoriSpells__InoriF_KS_Loop_InoriF takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__InoriSpells__InoriF_KS_MUI_InoriF
                set this=s__InoriSpells__InoriF_KS_m_InoriF[i]
                if SpellBoolCaster(s__InoriSpells__InoriF_KS_c[this]) and s__InoriSpells__InoriF_KS_r[this] <= s__InoriSpells__InoriF_KS_rmax[this] and CheckCoordsInRect(gg_rct_Base , GetUnitX(s__InoriSpells__InoriF_KS_c[this]) , GetUnitY(s__InoriSpells__InoriF_KS_c[this])) == false then
                    set s__InoriSpells__InoriF_KS_r[this]=s__InoriSpells__InoriF_KS_r[this] + 0.1
                    set s__InoriSpells__InoriF_KS_r[this]=S2R(R2SW(s__InoriSpells__InoriF_KS_r[this], 0, 3))
                else
                    call DestroyEffect(s__InoriSpells__InoriF_KS_e[this])
                    call AddSpellLevel(s__InoriSpells__InoriF_KS_c[this] , 'A01C' , 5 , false)
                    call BlzSetAbilityIcon(InoriQ_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Inori_Q.blp")
                    call SaveInteger(hs, GetHandleId(s__InoriSpells__InoriF_KS_c[this]), StringHash("mode f"), 0)
                    set s__InoriSpells__InoriF_KS_c[this]=null
                    set s__InoriSpells__InoriF_KS_e[this]=null
                    set s__InoriSpells__InoriF_KS_m_InoriF[i]=s__InoriSpells__InoriF_KS_m_InoriF[s__InoriSpells__InoriF_KS_MUI_InoriF]
                    set s__InoriSpells__InoriF_KS_MUI_InoriF=s__InoriSpells__InoriF_KS_MUI_InoriF - 1
                    if s__InoriSpells__InoriF_KS_MUI_InoriF == - 1 then
                        call PauseTimer(s__InoriSpells__InoriF_KS_t_InoriF)
                    endif
                    call s__InoriSpells__InoriF_KS_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction
        function s__InoriSpells__InoriF_KS_InoriF_Start takes unit NewC returns nothing
            local integer this= s__InoriSpells__InoriF_KS__allocate()
            set s__InoriSpells__InoriF_KS_MUI_InoriF=s__InoriSpells__InoriF_KS_MUI_InoriF + 1
