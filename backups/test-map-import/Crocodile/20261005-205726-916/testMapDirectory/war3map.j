            set s__AlucardSpells__AlucardSpells_E_g2[this]=CreateGroup()
            set s__AlucardSpells__AlucardSpells_E_aoe[this]=AlucardE_DamageAoe
            set s__AlucardSpells__AlucardSpells_E_a[this]=GAngle2(s__AlucardSpells__AlucardSpells_E_c[this] , s__AlucardSpells__AlucardSpells_E_x[this] , s__AlucardSpells__AlucardSpells_E_y[this]) // Angle Between points
            set s__AlucardSpells__AlucardSpells_E_x1[this]=GetUnitX(s__AlucardSpells__AlucardSpells_E_c[this]) + 400 * Cos(s__AlucardSpells__AlucardSpells_E_a[this])
            set s__AlucardSpells__AlucardSpells_E_y1[this]=GetUnitX(s__AlucardSpells__AlucardSpells_E_c[this]) + 400 * Sin(s__AlucardSpells__AlucardSpells_E_a[this])
            set s__AlucardSpells__AlucardSpells_E_dmg[this]=GetHeroAgi(s__AlucardSpells__AlucardSpells_E_c[this], true) * ( AlucardE_DamageAgiBase + ( AlucardE_DamageAgiStep * ( GetUnitAbilityLevel(s__AlucardSpells__AlucardSpells_E_c[this], AlucardE_ID) - 1 ) ) )
            set s__AlucardSpells__AlucardSpells_E_rmax[this]=2
            set s__AlucardSpells__AlucardSpells_E_r7[this]=AlucardE_RangeBase + ( AlucardE_RangeStep * ( GetUnitAbilityLevel(s__AlucardSpells__AlucardSpells_E_c[this], AlucardE_ID) - 1 ) )
