            set s__PatriotSpells___PatriotSpells_R_rmax[this]=3.0

            if LoadInteger(hs, GetHandleId(s__PatriotSpells___PatriotSpells_R_c[this]), StringHash("patriot e")) == 1 then
                // Стойка Сокрушения: спавн СТРОГО в точке клика курсора
                set xxx=NewX
                set yyy=NewY
                // Направление марша: от точки клика прямо навстречу Патриоту
                set s__PatriotSpells___PatriotSpells_R_a[this]=GAngle4(NewX , NewY , GetUnitX(s__PatriotSpells___PatriotSpells_R_c[this]) , GetUnitY(s__PatriotSpells___PatriotSpells_R_c[this]))
