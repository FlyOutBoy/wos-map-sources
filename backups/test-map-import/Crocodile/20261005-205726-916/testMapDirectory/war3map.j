                call DestroyEffect(EffectSpawn("war3mapImported\\wos_brandi_green_increase.mdl" , GetUnitX(s__BrandishSpells___BrandishSpells_F_td[this]) , GetUnitY(s__BrandishSpells___BrandishSpells_F_td[this]) , 0.0 , 1.25 , 2.00 , 0.0))
                call SaveInteger(BrandishSpells___hs, GetHandleId(s__BrandishSpells___BrandishSpells_F_td[this]), StringHash("brandish g ally"), 1)
                call SaveReal(BrandishSpells___hs, GetHandleId(s__BrandishSpells___BrandishSpells_F_td[this]), StringHash("FMult"), BrandishF_DamageOutputIncreaseScale / 100.0)
                call s__BrandishSpells_Utility_BuffUnitBran2(s__BrandishSpells___BrandishSpells_F_c[this] , s__BrandishSpells___BrandishSpells_F_td[this] , 1 , false)
            endif
            set s__BrandishSpells___BrandishSpells_F_scale2[this]=s__BrandishSpells_Utility_GetTotalScale(s__BrandishSpells___BrandishSpells_F_td[this])
            call ScaleDummy(s__BrandishSpells___BrandishSpells_F_td[this] , 0.50 , s__BrandishSpells___BrandishSpells_F_scale[this] , s__BrandishSpells___BrandishSpells_F_scale2[this])
            set s__BrandishSpells___BrandishSpells_F_rmax[this]=BrandishF_Time
            call Brandish_RestoreOrder(s__BrandishSpells___BrandishSpells_F_c[this] , 5)
            if s__BrandishSpells___BrandishSpells_F_MUI_BrandishF == 0 then
                call BrandishSpells___BrandishTimer05Acquire()
            endif
        endfunction

