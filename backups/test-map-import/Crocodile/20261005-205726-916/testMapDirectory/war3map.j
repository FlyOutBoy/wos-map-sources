    function CrocodileSpells___CrocodileBonus_Refresh takes unit u,integer abilityId returns nothing
            local ability a= BlzGetUnitAbility(u, abilityId)
            local integer level= GetUnitAbilityLevel(u, abilityId)
            local integer levels= BlzGetAbilityIntegerField(a, ABILITY_IF_LEVELS)
            if a != null and level > 0 then
                // Native item bonuses have one level. Ensure Inc really changes
                // level before restoring it, so updated stat fields are applied.
                if levels <= level then
                    call BlzSetAbilityIntegerField(a, ABILITY_IF_LEVELS, level + 1)
                endif
                call IncUnitAbilityLevel(u, abilityId)
                call DecUnitAbilityLevel(u, abilityId)
                if levels <= level then
                    call BlzSetAbilityIntegerField(a, ABILITY_IF_LEVELS, levels)
                endif
            endif
            set a=null
    endfunction

    // PauseUnit is boolean: overlapping owned casts must release only the last lock.
//================================ Crocodile Sand ========================================

        function s__CrocodileSpells___CrocodileSand_Struct_CrocodileSand_CreateVisual takes integer this returns nothing
            local string model="war3mapImported\\wos_ysjsm45.mdl"
            set s__CrocodileSpells___CrocodileSand_Struct_largeVisual[this]=s__CrocodileSpells___CrocodileSand_Struct_radius[this] >= CrocodileSand_LargeAoe
            if s__CrocodileSpells___CrocodileSand_Struct_largeVisual[this] then
                set model="war3mapImported\\wos_ysjsm45.mdl"
            endif
            set s__CrocodileSpells___CrocodileSand_Struct_e[this]=EffectSpawn(model , s__CrocodileSpells___CrocodileSand_Struct_x[this] , s__CrocodileSpells___CrocodileSand_Struct_y[this] , GetRandomReal(0, 359) , 0.5 , s__CrocodileSpells___CrocodileSand_Struct_radius[this] / 165.0 , 0)
            call BlzSetSpecialEffectAlpha(s__CrocodileSpells___CrocodileSand_Struct_e[this], 0)
            call ColorEffDummy4(s__CrocodileSpells___CrocodileSand_Struct_e[this] , 0 , 255 , 255 , 255 , 0.39)
        endfunction


        function s__CrocodileSpells___CrocodileSand_Struct_CrocodileSand_IsOnGround takes unit u,unit source returns boolean
            local integer i= 0
            local integer this
            loop
                exitwhen i > s__CrocodileSpells___CrocodileSand_Struct_MUI
                set this=s__CrocodileSpells___CrocodileSand_Struct_m[i]
                if s__CrocodileSpells___CrocodileSand_Struct_c[this] == source and not s__CrocodileSpells___CrocodileSand_Struct_endNow[this] and SR3(u , s__CrocodileSpells___CrocodileSand_Struct_x[this] , s__CrocodileSpells___CrocodileSand_Struct_y[this]) <= s__CrocodileSpells___CrocodileSand_Struct_radius[this] then
                    return true
                endif
                set i=i + 1
            endloop
            return false
        endfunction

        function s__CrocodileSpells___CrocodileSand_Struct_Loop_CrocodileSand takes nothing returns nothing
            local integer i= 0
            local integer this
            local unit u
            loop
                exitwhen i > s__CrocodileSpells___CrocodileSand_Struct_MUI
                set this=s__CrocodileSpells___CrocodileSand_Struct_m[i]
                set s__CrocodileSpells___CrocodileSand_Struct_r[this]=RoundReal(s__CrocodileSpells___CrocodileSand_Struct_r[this] + CrocodileSpells___CrocodilePeriod , 3)
                set s__CrocodileSpells___CrocodileSand_Struct_pulse[this]=s__CrocodileSpells___CrocodileSand_Struct_pulse[this] + CrocodileSpells___CrocodilePeriod
                set s__CrocodileSpells___CrocodileSand_Struct_slowLife[this]=RMaxBJ(0.0, s__CrocodileSpells___CrocodileSand_Struct_slowLife[this] - CrocodileSpells___CrocodilePeriod)
                if not s__CrocodileSpells___CrocodileSand_Struct_endNow[this] and s__CrocodileSpells___CrocodileSand_Struct_slowLife[this] > 0.0 and s__CrocodileSpells___CrocodileSand_Struct_pulse[this] + 0.001 >= 0.5 then
                    set s__CrocodileSpells___CrocodileSand_Struct_pulse[this]=0.0
                    if CrocodileSpells___CrocodileSand_ScanGroup == null then
                        set CrocodileSpells___CrocodileSand_ScanGroup=CreateGroup()
                    endif
                    call GroupEnumUnitsInRange(CrocodileSpells___CrocodileSand_ScanGroup, s__CrocodileSpells___CrocodileSand_Struct_x[this], s__CrocodileSpells___CrocodileSand_Struct_y[this], s__CrocodileSpells___CrocodileSand_Struct_radius[this], NoDecor_Cond)
                    loop
                        set u=FirstOfGroup(CrocodileSpells___CrocodileSand_ScanGroup)
                        exitwhen u == null
                        call GroupRemoveUnit(CrocodileSpells___CrocodileSand_ScanGroup, u)
                        if SpellBool(u) and IsUnitEnemy(u, GetOwningPlayer(s__CrocodileSpells___CrocodileSand_Struct_c[this])) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) then
                            call SlowUnit(s__CrocodileSpells___CrocodileSand_Struct_c[this] , u , CrocodileSand_Slow , 1)
                        endif
                    endloop
                endif
                if s__CrocodileSpells___CrocodileSand_Struct_endNow[this] or s__CrocodileSpells___CrocodileSand_Struct_r[this] + 0.001 >= s__CrocodileSpells___CrocodileSand_Struct_rmax[this] or GetUnitTypeId(s__CrocodileSpells___CrocodileSand_Struct_c[this]) == 0 or LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(s__CrocodileSpells___CrocodileSand_Struct_c[this]), CrocodileSpells___CrocodileCore_DataKey) == 0 then
                    call ColorEffDummy3Alpha((s__CrocodileSpells___CrocodileSand_Struct_e[this] ) , (( 0.0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( CrocodileSand_FadeTime)*1.0)) // INLINED!!
                    set s__CrocodileSpells___CrocodileSand_Struct_c[this]=null
                    set s__CrocodileSpells___CrocodileSand_Struct_e[this]=null
                    set s__CrocodileSpells___CrocodileSand_Struct_m[i]=s__CrocodileSpells___CrocodileSand_Struct_m[s__CrocodileSpells___CrocodileSand_Struct_MUI]
                    set s__CrocodileSpells___CrocodileSand_Struct_MUI=s__CrocodileSpells___CrocodileSand_Struct_MUI - 1
                    call s__CrocodileSpells___CrocodileSand_Struct_deallocate(this)
                    if s__CrocodileSpells___CrocodileSand_Struct_MUI == - 1 then
                        if CrocodileSpells___CrocodileSand_ScanGroup != null then
                            call DestroyGroup(CrocodileSpells___CrocodileSand_ScanGroup)
                            set CrocodileSpells___CrocodileSand_ScanGroup=null
                        endif
                        call GearTimer03Release()
                    endif
                else
                    set i=i + 1
                endif
            endloop
            set u=null
        endfunction

        function s__CrocodileSpells___CrocodileSand_Struct_CrocodileSand_Start takes unit NewC,real NewX,real NewY,real NewAoe,boolean qHit returns nothing
            local integer i= 0
            local integer this
            local real dx
            local real dy
            loop
                exitwhen i > s__CrocodileSpells___CrocodileSand_Struct_MUI
                set this=s__CrocodileSpells___CrocodileSand_Struct_m[i]
                set dx=s__CrocodileSpells___CrocodileSand_Struct_x[this] - NewX
                set dy=s__CrocodileSpells___CrocodileSand_Struct_y[this] - NewY
                if not s__CrocodileSpells___CrocodileSand_Struct_endNow[this] and s__CrocodileSpells___CrocodileSand_Struct_r[this] < s__CrocodileSpells___CrocodileSand_Struct_rmax[this] and dx * dx + dy * dy + 0.001 < CrocodileSand_MinDistance * CrocodileSand_MinDistance then
                    // All existing sand objects enforce spacing. Only refresh our own.
                    if s__CrocodileSpells___CrocodileSand_Struct_c[this] == NewC and not qHit then
                        set s__CrocodileSpells___CrocodileSand_Struct_radius[this]=RMaxBJ(s__CrocodileSpells___CrocodileSand_Struct_radius[this], NewAoe)
                        set s__CrocodileSpells___CrocodileSand_Struct_r[this]=0.0
                        set s__CrocodileSpells___CrocodileSand_Struct_rmax[this]=CrocodileSand_GroundDuration
                        if not s__CrocodileSpells___CrocodileSand_Struct_largeVisual[this] and s__CrocodileSpells___CrocodileSand_Struct_radius[this] >= CrocodileSand_LargeAoe then
                            // Let the old fade-in finish before releasing its handle.
                            call s__GearSystems2___KS_RemoveEffect_MyRemoveEff_Start((s__CrocodileSpells___CrocodileSand_Struct_e[this] ) , (( 0.42)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
                            call s__CrocodileSpells___CrocodileSand_Struct_CrocodileSand_CreateVisual(this)
                        else
                            call BlzSetSpecialEffectScale(s__CrocodileSpells___CrocodileSand_Struct_e[this], s__CrocodileSpells___CrocodileSand_Struct_radius[this] / 150.0)
                        endif
                    endif
                    return
                endif
                set i=i + 1
            endloop
            set this=s__CrocodileSpells___CrocodileSand_Struct__allocate()
            set s__CrocodileSpells___CrocodileSand_Struct_MUI=s__CrocodileSpells___CrocodileSand_Struct_MUI + 1
            set s__CrocodileSpells___CrocodileSand_Struct_m[s__CrocodileSpells___CrocodileSand_Struct_MUI]=this
            if s__CrocodileSpells___CrocodileSand_Struct_MUI == 0 then
                call GearTimer03Acquire()
            endif
            set s__CrocodileSpells___CrocodileSand_Struct_c[this]=NewC
            set s__CrocodileSpells___CrocodileSand_Struct_x[this]=NewX
            set s__CrocodileSpells___CrocodileSand_Struct_y[this]=NewY
            set s__CrocodileSpells___CrocodileSand_Struct_radius[this]=NewAoe
            set s__CrocodileSpells___CrocodileSand_Struct_r[this]=0.0
            set s__CrocodileSpells___CrocodileSand_Struct_pulse[this]=0.0
            set s__CrocodileSpells___CrocodileSand_Struct_slowLife[this]=0.0
            set s__CrocodileSpells___CrocodileSand_Struct_endNow[this]=false
            if qHit then
                set s__CrocodileSpells___CrocodileSand_Struct_slowLife[this]=CrocodileQ_SandSlowTime
            endif
            set s__CrocodileSpells___CrocodileSand_Struct_rmax[this]=CrocodileSand_GroundDuration
            call s__CrocodileSpells___CrocodileSand_Struct_CrocodileSand_CreateVisual(this)
        endfunction




        function s__CrocodileSpells___CrocodileSand_Debuff_Apply takes unit source,unit target returns boolean
            local integer this
            if target == null or not SpellBool(target) or not IsUnitEnemy(target, GetOwningPlayer(source)) or IsUnitType(target, UNIT_TYPE_STRUCTURE) or GetUnitAbilityLevel(target, 'Aloc') > 0 then
                return false
            endif
            if LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(target), CrocodileSpells___CrocodileSand_DebuffKey) != 0 then
                return false
            endif
            set this=s__CrocodileSpells___CrocodileSand_Debuff__allocate()
            set s__CrocodileSpells___CrocodileSand_Debuff_c[this]=source
            set s__CrocodileSpells___CrocodileSand_Debuff_u[this]=target
            set s__CrocodileSpells___CrocodileSand_Debuff_lastX[this]=GetUnitX(s__CrocodileSpells___CrocodileSand_Debuff_u[this])
            set s__CrocodileSpells___CrocodileSand_Debuff_lastY[this]=GetUnitY(s__CrocodileSpells___CrocodileSand_Debuff_u[this])
            set s__CrocodileSpells___CrocodileSand_Debuff_pulse[this]=0.0
            set s__CrocodileSpells___CrocodileSand_Debuff_r[this]=0.0
            set s__CrocodileSpells___CrocodileSand_Debuff_rmax[this]=CrocodileSand_Duration
            set s__CrocodileSpells___CrocodileSand_Debuff_e[this]=AddSpecialEffectTarget("war3mapImported\\wos_az_f076_clear.mdl", s__CrocodileSpells___CrocodileSand_Debuff_u[this], "origin")
            call SaveInteger(CrocodileSpells___CrocodileTable, GetHandleId(s__CrocodileSpells___CrocodileSand_Debuff_u[this]), CrocodileSpells___CrocodileSand_DebuffKey, this)
            set s__CrocodileSpells___CrocodileSand_Debuff_MUI=s__CrocodileSpells___CrocodileSand_Debuff_MUI + 1
            set s__CrocodileSpells___CrocodileSand_Debuff_m[s__CrocodileSpells___CrocodileSand_Debuff_MUI]=this
            if s__CrocodileSpells___CrocodileSand_Debuff_MUI == 0 then
                call GearTimer03Acquire()
            endif
            return true
        endfunction

        function s__CrocodileSpells___CrocodileSand_Debuff_Loop_CrocodileSandDebuff takes nothing returns nothing
            local integer i= 0
            local integer this
            local real px
            local real py
            local real dx
            local real dy
            loop
                exitwhen i > s__CrocodileSpells___CrocodileSand_Debuff_MUI
                set this=s__CrocodileSpells___CrocodileSand_Debuff_m[i]
                set s__CrocodileSpells___CrocodileSand_Debuff_r[this]=RoundReal(s__CrocodileSpells___CrocodileSand_Debuff_r[this] + CrocodileSpells___CrocodilePeriod , 3)
                if s__CrocodileSpells___CrocodileSand_Debuff_r[this] + 0.001 >= s__CrocodileSpells___CrocodileSand_Debuff_rmax[this] or GetUnitTypeId(s__CrocodileSpells___CrocodileSand_Debuff_u[this]) == 0 or GetWidgetLife(s__CrocodileSpells___CrocodileSand_Debuff_u[this]) <= 0.405 or LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(s__CrocodileSpells___CrocodileSand_Debuff_c[this]), CrocodileSpells___CrocodileCore_DataKey) == 0 then
                    call RemoveSavedInteger(CrocodileSpells___CrocodileTable, GetHandleId(s__CrocodileSpells___CrocodileSand_Debuff_u[this]), CrocodileSpells___CrocodileSand_DebuffKey)
                    call DestroyEffect(s__CrocodileSpells___CrocodileSand_Debuff_e[this])
                    set s__CrocodileSpells___CrocodileSand_Debuff_e[this]=null
                    set s__CrocodileSpells___CrocodileSand_Debuff_u[this]=null
                    set s__CrocodileSpells___CrocodileSand_Debuff_c[this]=null
                    set s__CrocodileSpells___CrocodileSand_Debuff_m[i]=s__CrocodileSpells___CrocodileSand_Debuff_m[s__CrocodileSpells___CrocodileSand_Debuff_MUI]
                    set s__CrocodileSpells___CrocodileSand_Debuff_MUI=s__CrocodileSpells___CrocodileSand_Debuff_MUI - 1
                    call s__CrocodileSpells___CrocodileSand_Debuff_deallocate(this)
                    if s__CrocodileSpells___CrocodileSand_Debuff_MUI == - 1 then
                        call GearTimer03Release()
                    endif
                else
                    set s__CrocodileSpells___CrocodileSand_Debuff_pulse[this]=s__CrocodileSpells___CrocodileSand_Debuff_pulse[this] + CrocodileSpells___CrocodilePeriod
                    if s__CrocodileSpells___CrocodileSand_Debuff_pulse[this] + 0.001 >= CrocodileSpells___CrocodileSand_TrackPeriod and GetUnitTypeId(s__CrocodileSpells___CrocodileSand_Debuff_c[this]) != 0 and IsUnitEnemy(s__CrocodileSpells___CrocodileSand_Debuff_u[this], GetOwningPlayer(s__CrocodileSpells___CrocodileSand_Debuff_c[this])) then
                        set s__CrocodileSpells___CrocodileSand_Debuff_pulse[this]=0.0
                        set px=GetUnitX(s__CrocodileSpells___CrocodileSand_Debuff_u[this])
                        set py=GetUnitY(s__CrocodileSpells___CrocodileSand_Debuff_u[this])
                        set dx=px - s__CrocodileSpells___CrocodileSand_Debuff_lastX[this]
                        set dy=py - s__CrocodileSpells___CrocodileSand_Debuff_lastY[this]
                        if dx * dx + dy * dy >= CrocodileSand_MinDistance * CrocodileSand_MinDistance then
                            call s__CrocodileSpells___CrocodileSand_Struct_CrocodileSand_Start(s__CrocodileSpells___CrocodileSand_Debuff_c[this] , px , py , CrocodileSand_Radius , true)
                            set s__CrocodileSpells___CrocodileSand_Debuff_lastX[this]=px
                            set s__CrocodileSpells___CrocodileSand_Debuff_lastY[this]=py
                        endif
                    endif
                    set i=i + 1
                endif
            endloop
        endfunction

