        function s__CrocodileSpells___CrocodileQ_Struct_CrocodileQ_ClearVisuals takes integer this returns nothing
            local integer trail
            call DestroyEffect(s__CrocodileSpells___CrocodileQ_Struct_e[this])
            set s__CrocodileSpells___CrocodileQ_Struct_e[this]=null
            loop
                exitwhen s__CrocodileSpells___CrocodileQ_Struct_trails[this] == 0
                set trail=s__CrocodileSpells___CrocodileQ_Struct_trails[this]
                set s__CrocodileSpells___CrocodileQ_Struct_trails[this]=s__CrocodileSpells___CrocodileQ_Trail_next[trail]
                call DestroyEffect(s__CrocodileSpells___CrocodileQ_Trail_e[trail])
                set s__CrocodileSpells___CrocodileQ_Trail_e[trail]=null
                call s__CrocodileSpells___CrocodileQ_Trail_deallocate(trail)
            endloop
        endfunction

        function s__CrocodileSpells___CrocodileQ_Struct_CrocodileQ_HitSand takes integer this,unit u returns nothing
            // Only a fresh enemy debuff creates ground sand, at the target's position.
            if s__CrocodileSpells___CrocodileSand_Debuff_Apply(s__CrocodileSpells___CrocodileQ_Struct_c[this] , u) then
                call s__CrocodileSpells___CrocodileSand_Struct_CrocodileSand_Start(s__CrocodileSpells___CrocodileQ_Struct_c[this] , GetUnitX(u) , GetUnitY(u) , CrocodileSand_Radius , true)
            endif
        endfunction

        function s__CrocodileSpells___CrocodileQ_Struct_Loop_CrocodileQ takes nothing returns nothing
            local integer this
            local integer i= 0
            local integer sectionCount
            local unit u
            local real step
            local real projection
            local real px
            local real py
            local real amount
            local real section
            local integer trail
            local boolean removeNow
            loop
                exitwhen i > s__CrocodileSpells___CrocodileQ_Struct_MUI
                set this=s__CrocodileSpells___CrocodileQ_Struct_m[i]
                set removeNow=s__CrocodileSpells___CrocodileQ_Struct_finished[this] and not s__CrocodileSpells___CrocodileQ_Struct_qPauseHeld[this]
                set s__CrocodileSpells___CrocodileQ_Struct_r[this]=RoundReal(s__CrocodileSpells___CrocodileQ_Struct_r[this] + CrocodileSpells___CrocodilePeriod , 3)
                if s__CrocodileSpells___CrocodileQ_Struct_qPauseHeld[this] and ( s__CrocodileSpells___CrocodileQ_Struct_r[this] + 0.001 >= CrocodileQ_PauseTime or not SpellBoolCaster(s__CrocodileSpells___CrocodileQ_Struct_c[this]) or GetUnitTypeId(s__CrocodileSpells___CrocodileQ_Struct_c[this]) == 0 ) then
                    set s__CrocodileSpells___CrocodileQ_Struct_qPauseHeld[this]=false
                    call StopSpellUnit2(s__CrocodileSpells___CrocodileQ_Struct_c[this])
            call MakeSound("war3mapImported\\Hero_Crocodile_Q2")
                endif
                if not s__CrocodileSpells___CrocodileQ_Struct_finished[this] and s__CrocodileSpells___CrocodileQ_Struct_r[this] < s__CrocodileSpells___CrocodileQ_Struct_rmax[this] and SpellBoolCaster(s__CrocodileSpells___CrocodileQ_Struct_c[this]) and LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(s__CrocodileSpells___CrocodileQ_Struct_c[this]), CrocodileSpells___CrocodileCore_DataKey) != 0 then
//---------------- Q cast / moving effect ------------------------------------
                    if s__CrocodileSpells___CrocodileQ_Struct_r[this] + 0.001 >= CrocodileQ_CastTime and s__CrocodileSpells___CrocodileQ_Struct_e[this] == null then
                        set s__CrocodileSpells___CrocodileQ_Struct_e[this]=EffectSpawn("war3mapImported\\wos_File00001240.mdl" , s__CrocodileSpells___CrocodileQ_Struct_startX[this] , s__CrocodileSpells___CrocodileQ_Struct_startY[this] , s__CrocodileSpells___CrocodileQ_Struct_a[this] * bj_RADTODEG , 1 , CrocodileQ_EffectScale * CrocodileQ_SlashScaleMultiplier , CrocodileQ_EffectHeight)
                    endif
                    if s__CrocodileSpells___CrocodileQ_Struct_r[this] + 0.001 >= CrocodileQ_CastTime then
                        set step=RMinBJ(s__CrocodileSpells___CrocodileQ_Struct_move[this], s__CrocodileSpells___CrocodileQ_Struct_maxDistance[this] - s__CrocodileSpells___CrocodileQ_Struct_distance[this])
                        set s__CrocodileSpells___CrocodileQ_Struct_previousDistance[this]=s__CrocodileSpells___CrocodileQ_Struct_distance[this]
                        set s__CrocodileSpells___CrocodileQ_Struct_distance[this]=s__CrocodileSpells___CrocodileQ_Struct_distance[this] + step
                        set s__CrocodileSpells___CrocodileQ_Struct_x[this]=s__CrocodileSpells___CrocodileQ_Struct_startX[this] + s__CrocodileSpells___CrocodileQ_Struct_distance[this] * Cos(s__CrocodileSpells___CrocodileQ_Struct_a[this])
                        set s__CrocodileSpells___CrocodileQ_Struct_y[this]=s__CrocodileSpells___CrocodileQ_Struct_startY[this] + s__CrocodileSpells___CrocodileQ_Struct_distance[this] * Sin(s__CrocodileSpells___CrocodileQ_Struct_a[this])
                        // Keep the configured model-length offset proportional to slash scale.
                        if s__CrocodileSpells___CrocodileQ_Struct_effectDistance[this] < s__CrocodileSpells___CrocodileQ_Struct_effectStop[this] then
                            set s__CrocodileSpells___CrocodileQ_Struct_effectDistance[this]=RMinBJ(s__CrocodileSpells___CrocodileQ_Struct_distance[this], s__CrocodileSpells___CrocodileQ_Struct_effectStop[this])
                            call BlzSetSpecialEffectX(s__CrocodileSpells___CrocodileQ_Struct_e[this], s__CrocodileSpells___CrocodileQ_Struct_startX[this] + s__CrocodileSpells___CrocodileQ_Struct_effectDistance[this] * Cos(s__CrocodileSpells___CrocodileQ_Struct_a[this]))
                            call BlzSetSpecialEffectY(s__CrocodileSpells___CrocodileQ_Struct_e[this], s__CrocodileSpells___CrocodileQ_Struct_startY[this] + s__CrocodileSpells___CrocodileQ_Struct_effectDistance[this] * Sin(s__CrocodileSpells___CrocodileQ_Struct_a[this]))
                        endif
                        loop
                            exitwhen s__CrocodileSpells___CrocodileQ_Struct_nextTrail[this] > s__CrocodileSpells___CrocodileQ_Struct_distance[this]
                            set trail=s__CrocodileSpells___CrocodileQ_Trail__allocate()
                            set s__CrocodileSpells___CrocodileQ_Trail_e[trail]=EffectSpawn("war3mapImported\\wos_File00001240.mdl" , s__CrocodileSpells___CrocodileQ_Struct_startX[this] + ( s__CrocodileSpells___CrocodileQ_Struct_nextTrail[this] - CrocodileQ_TrailSpacing ) * Cos(s__CrocodileSpells___CrocodileQ_Struct_a[this]) , s__CrocodileSpells___CrocodileQ_Struct_startY[this] + ( s__CrocodileSpells___CrocodileQ_Struct_nextTrail[this] - CrocodileQ_TrailSpacing ) * Sin(s__CrocodileSpells___CrocodileQ_Struct_a[this]) , s__CrocodileSpells___CrocodileQ_Struct_a[this] * bj_RADTODEG , 1 , CrocodileQ_EffectScale * CrocodileQ_SlashScaleMultiplier , CrocodileQ_EffectHeight)
                            set s__CrocodileSpells___CrocodileQ_Trail_age[trail]=0.0
                            set s__CrocodileSpells___CrocodileQ_Trail_next[trail]=s__CrocodileSpells___CrocodileQ_Struct_trails[this]
                            set s__CrocodileSpells___CrocodileQ_Struct_trails[this]=trail
                            set s__CrocodileSpells___CrocodileQ_Struct_nextTrail[this]=s__CrocodileSpells___CrocodileQ_Struct_nextTrail[this] + RMaxBJ(1.0, CrocodileQ_TrailSpacing)
                        endloop
//---------------- Q first pass: scan by AoE, not every move tick -------------
                        loop
                            exitwhen s__CrocodileSpells___CrocodileQ_Struct_scanDistance[this] >= s__CrocodileSpells___CrocodileQ_Struct_distance[this] or ( s__CrocodileSpells___CrocodileQ_Struct_distance[this] - s__CrocodileSpells___CrocodileQ_Struct_scanDistance[this] + 0.001 < s__CrocodileSpells___CrocodileQ_Struct_scanStep[this] and s__CrocodileSpells___CrocodileQ_Struct_distance[this] + 0.001 < s__CrocodileSpells___CrocodileQ_Struct_maxDistance[this] )
                            set section=RMinBJ(s__CrocodileSpells___CrocodileQ_Struct_scanStep[this], s__CrocodileSpells___CrocodileQ_Struct_distance[this] - s__CrocodileSpells___CrocodileQ_Struct_scanDistance[this])
                            set px=s__CrocodileSpells___CrocodileQ_Struct_startX[this] + ( s__CrocodileSpells___CrocodileQ_Struct_scanDistance[this] + section / 2 ) * Cos(s__CrocodileSpells___CrocodileQ_Struct_a[this])
                            set py=s__CrocodileSpells___CrocodileQ_Struct_startY[this] + ( s__CrocodileSpells___CrocodileQ_Struct_scanDistance[this] + section / 2 ) * Sin(s__CrocodileSpells___CrocodileQ_Struct_a[this])
                            call GroupEnumUnitsInRange(s__CrocodileSpells___CrocodileQ_Struct_g[this], px, py, s__CrocodileSpells___CrocodileQ_Struct_radius[this] + section / 2, NoDecor_Cond)
                            loop
                                set u=FirstOfGroup(s__CrocodileSpells___CrocodileQ_Struct_g[this])
                                exitwhen u == null
                                call GroupRemoveUnit(s__CrocodileSpells___CrocodileQ_Struct_g[this], u)
                                set projection=RMaxBJ(s__CrocodileSpells___CrocodileQ_Struct_scanDistance[this], RMinBJ(s__CrocodileSpells___CrocodileQ_Struct_scanDistance[this] + section, ( GetUnitX(u) - s__CrocodileSpells___CrocodileQ_Struct_startX[this] ) * Cos(s__CrocodileSpells___CrocodileQ_Struct_a[this]) + ( GetUnitY(u) - s__CrocodileSpells___CrocodileQ_Struct_startY[this] ) * Sin(s__CrocodileSpells___CrocodileQ_Struct_a[this])))
                                set px=s__CrocodileSpells___CrocodileQ_Struct_startX[this] + projection * Cos(s__CrocodileSpells___CrocodileQ_Struct_a[this])
                                set py=s__CrocodileSpells___CrocodileQ_Struct_startY[this] + projection * Sin(s__CrocodileSpells___CrocodileQ_Struct_a[this])
                                if SpellBool(u) and IsUnitEnemy(u, GetOwningPlayer(s__CrocodileSpells___CrocodileQ_Struct_c[this])) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) and not IsUnitInGroup(u, s__CrocodileSpells___CrocodileQ_Struct_g2[this]) and SR3(u , px , py) <= s__CrocodileSpells___CrocodileQ_Struct_radius[this] then
                                    call GroupAddUnit(s__CrocodileSpells___CrocodileQ_Struct_g2[this], u)
                                    call s__CrocodileSpells___CrocodileQ_Struct_CrocodileQ_HitSand(this,u)
                                    call SlowUnit(s__CrocodileSpells___CrocodileQ_Struct_c[this] , u , CrocodileQ_Slow , 2)
                                    if CrocodileQ_PullDuration > 0.0 and SR3(u , px , py) > 1.0 then
                                        call MUE(u , RMinBJ(CrocodileQ_PullDistance, SR3(u , px , py)) , CrocodileQ_PullDuration , Atan2(py - GetUnitY(u), px - GetUnitX(u)))
                                    endif
                                endif
                            endloop
                            set s__CrocodileSpells___CrocodileQ_Struct_scanDistance[this]=s__CrocodileSpells___CrocodileQ_Struct_scanDistance[this] + section
                        endloop
                        if s__CrocodileSpells___CrocodileQ_Struct_distance[this] + 0.001 >= s__CrocodileSpells___CrocodileQ_Struct_maxDistance[this] then
//---------------- Q endpoint fade / original explosion layout --------------
                            set amount=250.0
                            set sectionCount=0
                            loop
                                exitwhen amount > s__CrocodileSpells___CrocodileQ_Struct_distance[this] or sectionCount >= 6
                                call DestroyEffect(EffectSpawn("war3mapImported\\wos_sandSlashUp.mdl" , s__CrocodileSpells___CrocodileQ_Struct_startX[this] + amount * Cos(s__CrocodileSpells___CrocodileQ_Struct_a[this]) , s__CrocodileSpells___CrocodileQ_Struct_startY[this] + amount * Sin(s__CrocodileSpells___CrocodileQ_Struct_a[this]) , s__CrocodileSpells___CrocodileQ_Struct_a[this] * bj_RADTODEG , 1 , CrocodileQ_ExplosionScale , 0))
                                set amount=amount + RMaxBJ(1.0, CrocodileQ_ExplosionSpacing)
                                set sectionCount=sectionCount + 1
                            endloop
                            call s__CrocodileSpells___CrocodileQ_Struct_CrocodileQ_ClearVisuals(this)
                            
            call MakeSound("war3mapImported\\Hero_Crocodile_Q3")
//---------------- Q damage: independent of VFX count; same AoE scan step -----
                            set amount=0.0
                            loop
                                exitwhen amount >= s__CrocodileSpells___CrocodileQ_Struct_distance[this]
                                set section=RMinBJ(s__CrocodileSpells___CrocodileQ_Struct_scanStep[this], s__CrocodileSpells___CrocodileQ_Struct_distance[this] - amount)
                                call GroupEnumUnitsInRange(s__CrocodileSpells___CrocodileQ_Struct_g[this], s__CrocodileSpells___CrocodileQ_Struct_startX[this] + ( amount + section / 2 ) * Cos(s__CrocodileSpells___CrocodileQ_Struct_a[this]), s__CrocodileSpells___CrocodileQ_Struct_startY[this] + ( amount + section / 2 ) * Sin(s__CrocodileSpells___CrocodileQ_Struct_a[this]), s__CrocodileSpells___CrocodileQ_Struct_radius[this] + section / 2, NoDecor_Cond)
                                loop
                                    set u=FirstOfGroup(s__CrocodileSpells___CrocodileQ_Struct_g[this])
                                    exitwhen u == null
                                    call GroupRemoveUnit(s__CrocodileSpells___CrocodileQ_Struct_g[this], u)
                                    set projection=RMaxBJ(amount, RMinBJ(amount + section, ( GetUnitX(u) - s__CrocodileSpells___CrocodileQ_Struct_startX[this] ) * Cos(s__CrocodileSpells___CrocodileQ_Struct_a[this]) + ( GetUnitY(u) - s__CrocodileSpells___CrocodileQ_Struct_startY[this] ) * Sin(s__CrocodileSpells___CrocodileQ_Struct_a[this])))
                                    set px=s__CrocodileSpells___CrocodileQ_Struct_startX[this] + projection * Cos(s__CrocodileSpells___CrocodileQ_Struct_a[this])
                                    set py=s__CrocodileSpells___CrocodileQ_Struct_startY[this] + projection * Sin(s__CrocodileSpells___CrocodileQ_Struct_a[this])
                                    if SpellBool(u) and IsUnitEnemy(u, GetOwningPlayer(s__CrocodileSpells___CrocodileQ_Struct_c[this])) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) and not IsUnitInGroup(u, s__CrocodileSpells___CrocodileQ_Struct_g3[this]) and SR3(u , px , py) <= s__CrocodileSpells___CrocodileQ_Struct_radius[this] then
                                        call GroupAddUnit(s__CrocodileSpells___CrocodileQ_Struct_g3[this], u)
                                        if not IsUnitInGroup(u, s__CrocodileSpells___CrocodileQ_Struct_g2[this]) then
                                            call GroupAddUnit(s__CrocodileSpells___CrocodileQ_Struct_g2[this], u)
                                            call s__CrocodileSpells___CrocodileQ_Struct_CrocodileQ_HitSand(this,u)
                                        endif
                                        call dmgphys(s__CrocodileSpells___CrocodileQ_Struct_c[this] , u , s__CrocodileSpells___CrocodileQ_Struct_dmg[this])
                                    endif
                                endloop
                                set amount=amount + section
                            endloop
                            set s__CrocodileSpells___CrocodileQ_Struct_finished[this]=true // Keep endpoint for W combo this tick.
                        endif
                    endif
                endif
                set trail=s__CrocodileSpells___CrocodileQ_Struct_trails[this]
                loop
                    exitwhen trail == 0
                    set s__CrocodileSpells___CrocodileQ_Trail_age[trail]=s__CrocodileSpells___CrocodileQ_Trail_age[trail] + CrocodileSpells___CrocodilePeriod
                    call BlzSetSpecialEffectAlpha(s__CrocodileSpells___CrocodileQ_Trail_e[trail], R2I(255.0 * ( 1.0 - RMinBJ(1.0, RMaxBJ(0.0, ( s__CrocodileSpells___CrocodileQ_Trail_age[trail] - 0.45 ) / 0.15)) )))
                    set trail=s__CrocodileSpells___CrocodileQ_Trail_next[trail]
                endloop
                if removeNow or s__CrocodileSpells___CrocodileQ_Struct_r[this] >= s__CrocodileSpells___CrocodileQ_Struct_rmax[this] or not SpellBoolCaster(s__CrocodileSpells___CrocodileQ_Struct_c[this]) or LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(s__CrocodileSpells___CrocodileQ_Struct_c[this]), CrocodileSpells___CrocodileCore_DataKey) == 0 then
//---------------- Q cleanup: normal finish OR debug deadline ----------------
                    if s__CrocodileSpells___CrocodileQ_Struct_qPauseHeld[this] then
                        set s__CrocodileSpells___CrocodileQ_Struct_qPauseHeld[this]=false
                        call StopSpellUnit2(s__CrocodileSpells___CrocodileQ_Struct_c[this])
                    endif
                    call s__CrocodileSpells___CrocodileQ_Struct_CrocodileQ_ClearVisuals(this)
                    call DestroyGroup(s__CrocodileSpells___CrocodileQ_Struct_g[this])
                    call DestroyGroup(s__CrocodileSpells___CrocodileQ_Struct_g2[this])
                    call DestroyGroup(s__CrocodileSpells___CrocodileQ_Struct_g3[this])
                    set s__CrocodileSpells___CrocodileQ_Struct_c[this]=null
                    set s__CrocodileSpells___CrocodileQ_Struct_e[this]=null
                    set s__CrocodileSpells___CrocodileQ_Struct_g[this]=null
                    set s__CrocodileSpells___CrocodileQ_Struct_g2[this]=null
                    set s__CrocodileSpells___CrocodileQ_Struct_g3[this]=null
                    set s__CrocodileSpells___CrocodileQ_Struct_m[i]=s__CrocodileSpells___CrocodileQ_Struct_m[s__CrocodileSpells___CrocodileQ_Struct_MUI]
                    set s__CrocodileSpells___CrocodileQ_Struct_MUI=s__CrocodileSpells___CrocodileQ_Struct_MUI - 1
                    call s__CrocodileSpells___CrocodileQ_Struct_deallocate(this)
                    if s__CrocodileSpells___CrocodileQ_Struct_MUI == - 1 then
                        call GearTimer03Release()
                    endif
                else
                    set i=i + 1
                endif
            endloop
            set u=null
        endfunction

        function s__CrocodileSpells___CrocodileQ_Struct_CrocodileQ_Begin takes unit NewC,real NewX,real NewY returns boolean
            local integer this
            if LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(NewC), CrocodileSpells___CrocodileCore_DataKey) == 0 or IsUnitIllusion(NewC) or not SpellBoolCaster(NewC) or LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(NewC), CrocodileSpells___CrocodileT_DataKey) != 0 then
                return false
            endif
            if CrocodileQ_Move <= 0.0 or CrocodileQ_Distance <= 0.0 or CrocodileQ_Aoe <= 0.0 then
                return false
            endif
            set this=s__CrocodileSpells___CrocodileQ_Struct__allocate()
            set s__CrocodileSpells___CrocodileQ_Struct_MUI=s__CrocodileSpells___CrocodileQ_Struct_MUI + 1
            set s__CrocodileSpells___CrocodileQ_Struct_m[s__CrocodileSpells___CrocodileQ_Struct_MUI]=this
            if s__CrocodileSpells___CrocodileQ_Struct_MUI == 0 then
                call GearTimer03Acquire()
            endif
            set s__CrocodileSpells___CrocodileQ_Struct_c[this]=NewC
            set s__CrocodileSpells___CrocodileQ_Struct_x[this]=GetUnitX(s__CrocodileSpells___CrocodileQ_Struct_c[this])
            set s__CrocodileSpells___CrocodileQ_Struct_y[this]=GetUnitY(s__CrocodileSpells___CrocodileQ_Struct_c[this])
            set s__CrocodileSpells___CrocodileQ_Struct_startX[this]=s__CrocodileSpells___CrocodileQ_Struct_x[this]
            set s__CrocodileSpells___CrocodileQ_Struct_startY[this]=s__CrocodileSpells___CrocodileQ_Struct_y[this]
            set s__CrocodileSpells___CrocodileQ_Struct_a[this]=Atan2(NewY - s__CrocodileSpells___CrocodileQ_Struct_y[this], NewX - s__CrocodileSpells___CrocodileQ_Struct_x[this])
            set s__CrocodileSpells___CrocodileQ_Struct_move[this]=CrocodileQ_Move
            set s__CrocodileSpells___CrocodileQ_Struct_distance[this]=0.0
            set s__CrocodileSpells___CrocodileQ_Struct_previousDistance[this]=0.0
            set s__CrocodileSpells___CrocodileQ_Struct_maxDistance[this]=CrocodileQ_Distance
            set s__CrocodileSpells___CrocodileQ_Struct_effectDistance[this]=0.0
            set s__CrocodileSpells___CrocodileQ_Struct_effectStop[this]=RMaxBJ(0.0, s__CrocodileSpells___CrocodileQ_Struct_maxDistance[this] - CrocodileQ_EffectStopDistance * CrocodileQ_SlashScaleMultiplier)
            set s__CrocodileSpells___CrocodileQ_Struct_scanDistance[this]=0.0
            set s__CrocodileSpells___CrocodileQ_Struct_radius[this]=CrocodileQ_Aoe
            set s__CrocodileSpells___CrocodileQ_Struct_scanStep[this]=RMaxBJ(1.0, s__CrocodileSpells___CrocodileQ_Struct_radius[this] - CrocodileQ_ScanOverlap)
            set s__CrocodileSpells___CrocodileQ_Struct_dmg[this]=GetHeroAgi(s__CrocodileSpells___CrocodileQ_Struct_c[this], true) * ( CrocodileQ_DamageAgiBase + CrocodileQ_DamageAgiStep * ( GetUnitAbilityLevel(s__CrocodileSpells___CrocodileQ_Struct_c[this], CrocodileQ_ID) - 1 ) )
            set s__CrocodileSpells___CrocodileQ_Struct_r[this]=0.0
            // At least 3 sec; large distance/slow movement gets a longer deadline.
            set s__CrocodileSpells___CrocodileQ_Struct_rmax[this]=RMaxBJ(CrocodileQ_DebugTime, CrocodileQ_CastTime + s__CrocodileSpells___CrocodileQ_Struct_maxDistance[this] / s__CrocodileSpells___CrocodileQ_Struct_move[this] * CrocodileSpells___CrocodilePeriod + 1.0)
            set s__CrocodileSpells___CrocodileQ_Struct_nextTrail[this]=RMaxBJ(1.0, CrocodileQ_TrailSpacing)
            set s__CrocodileSpells___CrocodileQ_Struct_qPauseHeld[this]=true
            call StartSpellUnit2(s__CrocodileSpells___CrocodileQ_Struct_c[this])
            set s__CrocodileSpells___CrocodileQ_Struct_finished[this]=false
            set s__CrocodileSpells___CrocodileQ_Struct_g[this]=CreateGroup() // Reused for every scan; no CreateGroup in loops.
            set s__CrocodileSpells___CrocodileQ_Struct_g2[this]=CreateGroup() // First-pass slow/pull, once per target.
            set s__CrocodileSpells___CrocodileQ_Struct_g3[this]=CreateGroup() // Final damage, once per target.
            set s__CrocodileSpells___CrocodileQ_Struct_e[this]=null
            set s__CrocodileSpells___CrocodileQ_Struct_trails[this]=0
            call SetUnitAnimationByIndex(s__CrocodileSpells___CrocodileQ_Struct_c[this], CrocodileQ_Animation)
            if GetRandomInt(1, 2) == 1 then
            call MakeSound("war3mapImported\\Hero_Crocodile_Q_2")
            else
            call MakeSound("war3mapImported\\Hero_Crocodile_Q")
            endif
            return true
        endfunction



//================================ Crocodile W - Desert Girasole ========================================


        // Shared only by W cast and Q crossing a pit. One combo per pit.
        function s__CrocodileSpells___CrocodileW_Struct_CrocodileW_Combo takes integer this returns nothing
            local unit u
            local effect e2
            if s__CrocodileSpells___CrocodileW_Struct_combo[this] then
                return
            endif
            set s__CrocodileSpells___CrocodileW_Struct_combo[this]=true
            set e2=EffectSpawn("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl" , s__CrocodileSpells___CrocodileW_Struct_x[this] , s__CrocodileSpells___CrocodileW_Struct_y[this] , 0 , 1 , s__CrocodileSpells___CrocodileW_Struct_radius[this] / 150.0 , 0)
            call s__GearSystems2___KS_RemoveEffect_MyRemoveEff_Start((e2 ) , (( 1.0)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
            call GroupEnumUnitsInRange(s__CrocodileSpells___CrocodileW_Struct_g[this], s__CrocodileSpells___CrocodileW_Struct_x[this], s__CrocodileSpells___CrocodileW_Struct_y[this], s__CrocodileSpells___CrocodileW_Struct_radius[this], NoDecor_Cond)
            loop
                set u=FirstOfGroup(s__CrocodileSpells___CrocodileW_Struct_g[this])
                exitwhen u == null
                call GroupRemoveUnit(s__CrocodileSpells___CrocodileW_Struct_g[this], u)
                if SpellBool(u) and IsUnitEnemy(u, GetOwningPlayer(s__CrocodileSpells___CrocodileW_Struct_c[this])) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) then
                    call dmgphys(s__CrocodileSpells___CrocodileW_Struct_c[this] , u , GetHeroAgi(s__CrocodileSpells___CrocodileW_Struct_c[this], true) * CrocodileW_ComboDamageAgi)
                    call MUE(u , SR3(u , s__CrocodileSpells___CrocodileW_Struct_x[this] , s__CrocodileSpells___CrocodileW_Struct_y[this]) , 0.24 , Atan2(s__CrocodileSpells___CrocodileW_Struct_y[this] - GetUnitY(u), s__CrocodileSpells___CrocodileW_Struct_x[this] - GetUnitX(u)))
                    call StunUnit(s__CrocodileSpells___CrocodileW_Struct_c[this] , u , CrocodileW_ComboStun)
                endif
            endloop
            set u=null
            set e2=null
        endfunction

        function s__CrocodileSpells___CrocodileW_Struct_Loop_CrocodileW takes nothing returns nothing
            local integer this
            local integer i= 0
            local unit u
            local integer slash
            local integer j
            local real projection
            local real distance
            local real depth
            local real pullSpeed
            loop
                exitwhen i > s__CrocodileSpells___CrocodileW_Struct_MUI
                set this=s__CrocodileSpells___CrocodileW_Struct_m[i]
                if s__CrocodileSpells___CrocodileW_Struct_r[this] == 0.51 then
            call MakeSound("war3mapImported\\Hero_Crocodile_W2")
                endif
                if s__CrocodileSpells___CrocodileW_Struct_r[this] > 0.51 then
//---------------- W + Q: check the current segment, including final tick ----
                set j=0
                loop
                    exitwhen j > s__CrocodileSpells___CrocodileQ_Struct_MUI
                    set slash=s__CrocodileSpells___CrocodileQ_Struct_m[j]
                    if s__CrocodileSpells___CrocodileQ_Struct_c[slash] == s__CrocodileSpells___CrocodileW_Struct_c[this] and s__CrocodileSpells___CrocodileQ_Struct_distance[slash] > 0.0 and not s__CrocodileSpells___CrocodileW_Struct_combo[this] then
