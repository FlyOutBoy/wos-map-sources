                        call DecorRemove(s__TakeshiSpells__TakeshiSpells_Q_c[this] , s__TakeshiSpells__TakeshiSpells_Q_x[this] , s__TakeshiSpells__TakeshiSpells_Q_y[this] , s__TakeshiSpells__TakeshiSpells_Q_aoe[this] , 25)
