                                call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_tx-ha_nitu.mdl" , GetUnitX(s__RaidenSpells__RaidenQ_KS_c[this]) , GetUnitY(s__RaidenSpells__RaidenQ_KS_c[this]) , s__RaidenSpells__RaidenQ_KS_a[this] * bj_RADTODEG , 2 , 1.325 , 1 , 255 , 255 , 255 , 155))
