        return s__CrocodileSpells___CrocodileT_Struct_CrocodileT_Begin(c)
    endfunction

    function CrocodileT2_Start takes unit c returns boolean
        return s__CrocodileSpells___CrocodileT2_Struct_CrocodileT2_Begin(c)
    endfunction

    function CrocodileF_AddStack takes unit c returns nothing
        local integer attack= LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(c), CrocodileSpells___CrocodileF_DataKey)
        if Crocodile_IsRegistered(c) and SpellBoolCaster(c) and attack != 0 and GetUnitAbilityLevel(c, CrocodileF_ID) > 0 then
            set s__CrocodileSpells___CrocodileF_Struct_stacks[attack]=IMinBJ(CrocodileF_MaxStacks, s__CrocodileSpells___CrocodileF_Struct_stacks[attack] + 1)
            call TasAbilityChargeBox_SetValue(c , CrocodileF_ID , I2S(s__CrocodileSpells___CrocodileF_Struct_stacks[attack]))
            call s__CrocodileSpells___CrocodileF_Struct_CrocodileF_SetEnhanced(attack,s__CrocodileSpells___CrocodileF_Struct_cooldown[attack] <= TimerGetElapsed(GearTimer03) and not s__CrocodileSpells___CrocodileF_Struct_ownsAttackBlock[attack])
        endif
    endfunction

    function Crocodile_Attack takes unit c,unit td,real dmg returns real
        return s__CrocodileSpells___CrocodileF_Struct_CrocodileF_Attack(c , td , dmg)
    endfunction

    function Crocodile_Damage takes unit c,unit td,real amount,integer kind,integer phase returns real
        return s__CrocodileSpells___CrocodileCore_Struct_CrocodileCore_Damage(c , td , amount , kind , phase)
    endfunction

    function Crocodile_Death takes unit c returns nothing
        call s__CrocodileSpells___CrocodileCore_Struct_CrocodileCore_Death(c)
    endfunction

    function CrocodileSpells___InitCrocodileSpells takes nothing returns nothing
        local trigger summon= CreateTrigger()
        call TriggerAddAction(GearTimer03Listeners, function s__CrocodileSpells___CrocodileCore_Struct_Loop_Crocodile)
        call TriggerRegisterAnyUnitEventBJ(summon, EVENT_PLAYER_UNIT_SUMMON)
        call TriggerAddAction(summon, function s__CrocodileSpells___CrocodileCore_Struct_Crocodile_Summon)
        set summon=null
    endfunction

