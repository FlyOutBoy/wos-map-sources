//library AAAAAAA ends
//library TasAbilityChargeBox:
   
//Adds a custom ChargeBox over Command Buttons to display a xx Text
//requires loading a fdf/toc containing "TasAbilityChargeBox"
//incorrect display when commandbutton Positions colide or in Group selection

//function TasAbilityChargeBox_SetValue takes unit u, integer spellCode, string value returns nothing
   //enforce a wanted Value for that spellCode for unit
//function TasAbilityChargeBox_GetValue takes unit u, integer spellCode returns string
//function TasAbilityChargeBox_Clear(unit u)
//function TasAbilityChargeBox_Init()

   
   function TasAbilityChargeBox_GetUnitSpellCodeKey takes integer unitId,integer spellCode returns integer
      local integer count= LoadInteger(TasAbilityChargeBox_Hash, unitId, 0)
      local integer loopA= 0
      loop
         set loopA=loopA + 1
         exitwhen loopA > count
         if LoadInteger(TasAbilityChargeBox_Hash, unitId, loopA) == spellCode then
            return loopA
         endif
      endloop
      set count=count + 1
      call SaveInteger(TasAbilityChargeBox_Hash, unitId, 0, count)
      call SaveInteger(TasAbilityChargeBox_Hash, unitId, count, spellCode)
      return count
   endfunction

   function TasAbilityChargeBox_SetValue takes unit u,integer spellCode,string value returns nothing
      local integer unitId= GetHandleId(u)
      call TasAbilityChargeBox_GetUnitSpellCodeKey(unitId , spellCode)
      call SaveStr(TasAbilityChargeBox_Hash, unitId, spellCode, value)
   endfunction

   function TasAbilityChargeBox_GetValue takes unit u,integer spellCode returns string
      return LoadStr(TasAbilityChargeBox_Hash, GetHandleId(u), spellCode)
   endfunction

   function TasAbilityChargeBox_Clear takes unit u returns nothing
      call FlushChildHashtable(TasAbilityChargeBox_Hash, GetHandleId(u))
   endfunction

   // Remove one counter without clearing other abilities/items on the unit.
   function TasAbilityChargeBox_ClearValue takes unit u,integer spellCode returns nothing
      local integer unitId= GetHandleId(u)
      local integer count= LoadInteger(TasAbilityChargeBox_Hash, unitId, 0)
      local integer i= 1
      loop
         exitwhen i > count
         if LoadInteger(TasAbilityChargeBox_Hash, unitId, i) == spellCode then
            call SaveInteger(TasAbilityChargeBox_Hash, unitId, i, LoadInteger(TasAbilityChargeBox_Hash, unitId, count))
            call RemoveSavedInteger(TasAbilityChargeBox_Hash, unitId, count)
            call SaveInteger(TasAbilityChargeBox_Hash, unitId, 0, count - 1)
            call RemoveSavedString(TasAbilityChargeBox_Hash, unitId, spellCode)
            return
         endif
         set i=i + 1
      endloop
   endfunction

   function TasAbilityChargeBox_Update takes nothing returns nothing
      local unit display= TasAbilityChargeBox_Unit[GetPlayerId(GetLocalPlayer())]
      local integer unitId= GetHandleId(display)
      local integer i= 0
      local integer pos
      local integer spellCode
    
      loop
         exitwhen i > 11
         call BlzFrameSetVisible(TasAbilityChargeBox_FrameBox[i], false)
         set i=i + 1
      endloop

      // One wants to display something specific?
      set i=LoadInteger(TasAbilityChargeBox_Hash, unitId, 0)
      loop
         exitwhen i <= 0
         set spellCode=LoadInteger(TasAbilityChargeBox_Hash, unitId, i)
         set pos=BlzGetAbilityPosX(spellCode) + BlzGetAbilityPosY(spellCode) * 4
         if pos >= 0 and pos <= 11 and GetUnitAbilityLevel(display, spellCode) > 0 then
            call BlzFrameSetVisible(TasAbilityChargeBox_FrameBox[pos], true)
            call BlzFrameSetText(TasAbilityChargeBox_FrameText[pos], LoadStr(TasAbilityChargeBox_Hash, unitId, spellCode))
         endif
         set i=i - 1
      endloop
      set display=null
   endfunction

   function TasAbilityChargeBox___Create takes nothing returns nothing
      local framehandle commandButton
      local integer i= 0
      local string font= "Fonts/FRIZQT__.TTF"
      if TasAbilityChargeBox_TocPath == null or TasAbilityChargeBox_TocPath == "" or not BlzLoadTOCFile(TasAbilityChargeBox_TocPath) then



         loop
            exitwhen i > 11
            set commandButton=BlzGetOriginFrame(ORIGIN_FRAME_COMMAND_BUTTON, i)
            set TasAbilityChargeBox_FrameBox[i]=BlzCreateSimpleFrame("SimpleInfoPanelIconDamage", commandButton, 21)
            set TasAbilityChargeBox_FrameIcon[i]=BlzGetFrameByName("InfoPanelIconBackdrop", 21)
            set TasAbilityChargeBox_FrameText[i]=BlzGetFrameByName("InfoPanelIconValue", 21)
            call BlzFrameSetText(BlzGetFrameByName("InfoPanelIconLevel", 21), "")
            call BlzFrameSetText(BlzGetFrameByName("InfoPanelIconLabel", 21), "")

            call BlzFrameClearAllPoints(TasAbilityChargeBox_FrameIcon[i])
            call BlzFrameSetPoint(TasAbilityChargeBox_FrameIcon[i], FRAMEPOINT_BOTTOMRIGHT, commandButton, FRAMEPOINT_BOTTOMRIGHT, 0.003, - 0.003)
            call BlzFrameSetSize(TasAbilityChargeBox_FrameIcon[i], 0.02, 0.02)
            call BlzFrameSetTexture(TasAbilityChargeBox_FrameIcon[i], "UI/Widgets/Console/Human/CommandButton/human-button-lvls-overlay.blp", 0, true)

            call BlzFrameClearAllPoints(TasAbilityChargeBox_FrameText[i])
            call BlzFrameSetPoint(TasAbilityChargeBox_FrameText[i], FRAMEPOINT_BOTTOMRIGHT, commandButton, FRAMEPOINT_BOTTOMRIGHT, 0.003, - 0.003)
            call BlzFrameSetSize(TasAbilityChargeBox_FrameText[i], 0.02, 0.02)
            call BlzFrameSetTextAlignment(TasAbilityChargeBox_FrameText[i], TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
            call BlzFrameSetFont(TasAbilityChargeBox_FrameText[i], font, 0.011, 0)

            call BlzFrameSetVisible(TasAbilityChargeBox_FrameBox[i], false)
            set i=i + 1
         endloop
      else
         loop
            exitwhen i > 11
            set TasAbilityChargeBox_FrameBox[i]=BlzCreateSimpleFrame("TasAbilityChargeBox", BlzGetOriginFrame(ORIGIN_FRAME_COMMAND_BUTTON, i), i)
            // reserve HandleId, used Async later
            set TasAbilityChargeBox_FrameText[i]=BlzGetFrameByName("TasAbilityChargeBoxText", i)
            call BlzFrameSetVisible(TasAbilityChargeBox_FrameBox[i], false)
            set i=i + 1
         endloop
         if GetHandleId(TasAbilityChargeBox_FrameBox[1]) == 0 then
            call BJDebugMsg(" Error Creating Frames")
         endif
      endif
   endfunction

   function TasAbilityChargeBox_Select takes nothing returns nothing
      set TasAbilityChargeBox_Unit[GetPlayerId(GetTriggerPlayer())]=GetTriggerUnit()
   endfunction

   function TasAbilityChargeBox_Init takes nothing returns nothing
      local trigger trig
      if TasAbilityChargeBox___Initialized then
         return
      endif
      set TasAbilityChargeBox___Initialized=true
      set TasAbilityChargeBox___UpdateTimer=CreateTimer()
      call TimerStart(TasAbilityChargeBox___UpdateTimer, TasAbilityChargeBox_UpdateIntervale, true, function TasAbilityChargeBox_Update)
      call TasAbilityChargeBox___Create()



      set trig=CreateTrigger()
      call TriggerAddAction(trig, function TasAbilityChargeBox_Select)
      call TriggerRegisterAnyUnitEventBJ(trig, EVENT_PLAYER_UNIT_SELECTED)
      set trig=null
   endfunction

//library TasAbilityChargeBox ends
//library TestHeroAdapter:
function TestHero_Register takes unit u returns nothing
    call sc___prototype5_evaluate(1,u)
endfunction

