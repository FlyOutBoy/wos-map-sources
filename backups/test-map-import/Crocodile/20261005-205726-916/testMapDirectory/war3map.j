                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_Satsu-Hit-red.mdl" , s__PatriotSpells___PatriotSpells_W_x[this] , s__PatriotSpells___PatriotSpells_W_y[this] , s__PatriotSpells___PatriotSpells_W_a[this] * bj_RADTODEG , 1.0 , 3.25 * s__PatriotSpells___PatriotSpells_W_scale[this] , 200.0))
