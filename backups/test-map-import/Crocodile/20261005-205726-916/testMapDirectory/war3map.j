    endfunction
    function TojiE_InitCharges takes unit c returns nothing
        call s__TojiSpells___TojiSpells_E_InitCharges(c)
    endfunction
    function TojiR_Start takes unit c,real x,real y returns nothing
        call s__TojiSpells___TojiSpells_R_Insectoids_TojiR_Start(c , x , y)
    endfunction
    function TojiT_Start takes unit c,real x,real y returns nothing
        call s__TojiSpells___TojiSpells_T_TojiT_Start(c , x , y)
    endfunction
