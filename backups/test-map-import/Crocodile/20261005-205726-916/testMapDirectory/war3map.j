                    // Îáùàÿ ãðóïïà æèâ¸ò, ïîêà íå âçîðâ¸òñÿ ïîñëåäíèé ñíàðÿä êàñòà.
                    set sharedGroupId=GetHandleId(s__MilimSpells___MilimRProjectileKS_g2[this])
