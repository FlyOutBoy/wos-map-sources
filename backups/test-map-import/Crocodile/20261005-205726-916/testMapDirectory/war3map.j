                                        call DestroyLightning(s___RimuruSpells__Rimuru3T_KS_ls[s__RimuruSpells__Rimuru3T_KS_ls[this]+s__RimuruSpells__Rimuru3T_KS_k[this] + ring])
                                        set s___RimuruSpells__Rimuru3T_KS_ls[s__RimuruSpells__Rimuru3T_KS_ls[this]+s__RimuruSpells__Rimuru3T_KS_k[this] + ring]=null
                                    endif
                                    if s___RimuruSpells__Rimuru3T_KS_ls[s__RimuruSpells__Rimuru3T_KS_ls[this]+s__RimuruSpells__Rimuru3T_KS_k[this] + ring * 2] != null then
                                        call DestroyLightning(s___RimuruSpells__Rimuru3T_KS_ls[s__RimuruSpells__Rimuru3T_KS_ls[this]+s__RimuruSpells__Rimuru3T_KS_k[this] + ring * 2])
                                        set s___RimuruSpells__Rimuru3T_KS_ls[s__RimuruSpells__Rimuru3T_KS_ls[this]+s__RimuruSpells__Rimuru3T_KS_k[this] + ring * 2]=null
                                    endif
                                    set s__RimuruSpells__Rimuru3T_KS_k[this]=s__RimuruSpells__Rimuru3T_KS_k[this] + 1
                                endloop
