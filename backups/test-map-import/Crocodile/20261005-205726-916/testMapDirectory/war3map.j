                set s___PatriotSpells___PatriotSpells_R_ee[s__PatriotSpells___PatriotSpells_R_ee[this]+s__PatriotSpells___PatriotSpells_R_k[this] + 4]=EffectSpawn("war3mapimported\\wos_Windwalk Black.mdx" , s__PatriotSpells___PatriotSpells_R_x1[this] , s__PatriotSpells___PatriotSpells_R_y1[this] , s__PatriotSpells___PatriotSpells_R_a[this] * bj_RADTODEG , 1.0 , 1.0 , 0.0)
