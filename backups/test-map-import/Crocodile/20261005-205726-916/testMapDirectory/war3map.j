//library TakeshiSpells:
    function TakeshiGAdd_Start takes unit c,real dmg returns nothing
local integer k2= GetPlayerId(GetOwningPlayer(c))
local real dmg2= LoadReal(hs, GetHandleId(c), StringHash("takeshi dmg")) + dmg
local real rmax= TakeshiG_TakenDamageToEnter
if GetHeroLevel(c) >= 35 then
if s__frameTakeshi_pas1[k2] == null then
                set s__frameTakeshi_pas1[k2]= BlzCreateFrameByType("BACKDROP", "SS", main_frame, "", 0)
                call BlzFrameSetAbsPoint(s__frameTakeshi_pas1[k2], FRAMEPOINT_CENTER, 0.055, 0.18)
                call BlzFrameSetSize(s__frameTakeshi_pas1[k2], 0.135, 0.035)
                call BlzFrameSetTexture(s__frameTakeshi_pas1[k2], "UI\\Feedback\\XPBar\\human-xpbar-border.blp", 0, false)
                call BlzFrameSetVisible(s__frameTakeshi_pas1[k2], false)
                if GetLocalPlayer() == GetOwningPlayer(c) then
                    call BlzFrameSetVisible(s__frameTakeshi_pas1[k2], true)
                endif
                set s__frameTakeshi_pas2[k2]= BlzCreateFrame("EscMenuControlBackdropTemplate", s__frameTakeshi_pas1[k2], 0, 0)
                call BlzFrameSetAbsPoint(s__frameTakeshi_pas2[k2], FRAMEPOINT_CENTER, 0.07, 0.185)
                call BlzFrameSetSize(s__frameTakeshi_pas2[k2], 0.1, 0.019)
                set s__frameTakeshi_pas3[k2]= BlzCreateFrameByType("STATUSBAR", "", s__frameTakeshi_pas1[k2], "", 0)
                call BlzFrameSetSize(s__frameTakeshi_pas3[k2], 0.1, 0.035)
                call BlzFrameSetScale(s__frameTakeshi_pas3[k2], 0.5)
                call BlzFrameSetModel(s__frameTakeshi_pas3[k2], "ui/feedback/XpBar/XpBarConsole.mdx", 0)
                call BlzFrameSetAbsPoint(s__frameTakeshi_pas3[k2], FRAMEPOINT_CENTER, 0.05, 0.175)
                call BlzFrameSetMinMaxValue(s__frameTakeshi_pas3[k2], 0, rmax + 2)
                call BlzFrameSetValue(s__frameTakeshi_pas3[k2], 0)
                set s__frameTakeshi_pas4[k2]= BlzCreateFrameByType("BACKDROP", "SS", s__frameTakeshi_pas1[k2], "", 0)
                call BlzFrameSetAbsPoint(s__frameTakeshi_pas4[k2], FRAMEPOINT_CENTER, 0.005, 0.18)
                call BlzFrameSetSize(s__frameTakeshi_pas4[k2], 0.03, 0.03)
                call BlzFrameSetTexture(s__frameTakeshi_pas4[k2], "ReplaceableTextures\\CommandButtons\\BTNHero_Takeshi_G2", 0, false)
                set s__frameTakeshi_pas5[k2]= BlzCreateFrameByType("TEXT", "MyPlayerName", s__frameTakeshi_pas1[k2], "", 0)
                call BlzFrameSetAbsPoint(s__frameTakeshi_pas5[k2], FRAMEPOINT_CENTER, 0.07, 0.185)
                call BlzFrameSetText(s__frameTakeshi_pas5[k2], "|c00FFFF00Cambio Damage:|r")
                call BlzFrameSetScale(s__frameTakeshi_pas5[k2], 0.9)
                set s__frameTakeshi_pas6[k2]= BlzCreateFrameByType("TEXT", "MyPlayerName", s__frameTakeshi_pas1[k2], "", 0)
                call BlzFrameSetAbsPoint(s__frameTakeshi_pas6[k2], FRAMEPOINT_CENTER, 0.07, 0.17)
                call BlzFrameSetText(s__frameTakeshi_pas6[k2], "|c00FFFF00" + I2S(R2I(dmg2)) + "/" + I2S(R2I(rmax)) + "|r")
                call BlzFrameSetScale(s__frameTakeshi_pas6[k2], 0.9)
            else
                
                if LoadInteger(hs, GetHandleId(c), StringHash("mode g")) == 0 then
                if dmg2 >= rmax then
                set dmg2=rmax
                if TakeshiDummy == null then
                set TakeshiDummy=CreateUnit(GetOwningPlayer(c), TakeshiDummy_ID, GetRectCenterX(gg_rct_Caster), GetRectCenterY(gg_rct_Caster), 1)
                endif
                else
                if dmg2 < 0 then
                set dmg2=0
                endif
                if TakeshiDummy != null then
                call RemoveUnit(TakeshiDummy)
                set TakeshiDummy=null
                endif
                endif
                call SaveReal(hs, GetHandleId(c), StringHash("takeshi dmg"), dmg2)
                call BlzFrameSetText(s__frameTakeshi_pas6[k2], "|c00FFFF00" + I2S(R2I(dmg2)) + "/" + I2S(R2I(rmax)) + "|r")
                call BlzFrameSetValue(s__frameTakeshi_pas3[k2], dmg2)
                endif
            endif
            endif
endfunction

