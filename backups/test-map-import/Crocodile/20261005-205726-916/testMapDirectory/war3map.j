            set s__RaidenSpells__RaidenQ_KS_c[this]=NewC
            set s__RaidenSpells__RaidenQ_KS_x[this]=NewX
            set s__RaidenSpells__RaidenQ_KS_y[this]=NewY
            set s__RaidenSpells__RaidenQ_KS_r[this]=0
            set s__RaidenSpells__RaidenQ_KS_r2[this]=10
            set s__RaidenSpells__RaidenQ_KS_r3[this]=1
            set s__RaidenSpells__RaidenQ_KS_k2[this]=0
            set s__RaidenSpells__RaidenQ_KS_check[this]=0
            call DebugUnit2(s__RaidenSpells__RaidenQ_KS_c[this])
            set s__RaidenSpells__RaidenQ_KS_move[this]=60
            set s__RaidenSpells__RaidenQ_KS_sr[this]=SR3(s__RaidenSpells__RaidenQ_KS_c[this] , s__RaidenSpells__RaidenQ_KS_x[this] , s__RaidenSpells__RaidenQ_KS_y[this])
            if s__RaidenSpells__RaidenQ_KS_sr[this] < RaidenQ_MinMove then
                set s__RaidenSpells__RaidenQ_KS_sr[this]=RaidenQ_MinMove
            endif
            set s__RaidenSpells__RaidenQ_KS_r_prepare[this]=RaidenQ_CastTime
            set s__RaidenSpells__RaidenQ_KS_rmax[this]=s__RaidenSpells__RaidenQ_KS_r_prepare[this] + ( ( s__RaidenSpells__RaidenQ_KS_sr[this] / s__RaidenSpells__RaidenQ_KS_move[this] ) * 0.03 )
            call SaveInteger(hs, GetHandleId(s__RaidenSpells__RaidenQ_KS_c[this]), StringHash("q abi"), 1)
            set s__RaidenSpells__RaidenQ_KS_g[this]=CreateGroup()
            set s__RaidenSpells__RaidenQ_KS_g2[this]=CreateGroup()
            set s__RaidenSpells__RaidenQ_KS_scale[this]=5.75
            set s__RaidenSpells__RaidenQ_KS_u[this]=null
            set s__RaidenSpells__RaidenQ_KS_check2[this]=0
            if LoadInteger(hs, GetHandleId(s__RaidenSpells__RaidenQ_KS_c[this]), StringHash("raiden t2")) > 0 then
                set s__RaidenSpells__RaidenQ_KS_k2[this]=2
            elseif LoadInteger(hs, GetHandleId(s__RaidenSpells__RaidenQ_KS_c[this]), StringHash("raiden t")) > 0 then
                set s__RaidenSpells__RaidenQ_KS_k2[this]=1
            elseif LoadInteger(hs, GetHandleId(s__RaidenSpells__RaidenQ_KS_c[this]), StringHash("raiden w")) > 0 then
                set s__RaidenSpells__RaidenQ_KS_check2[this]=1
            endif
