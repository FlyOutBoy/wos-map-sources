        call BuffUnit01(u , u , 'A01E' , "innerfire" , 1)
        //call BlzSetItemBooleanField(UnitItemInSlot(u,IsItemInInventory3(u,'I00L')),ITEM_BF_ACTIVELY_USED,true)
        call BlzStartUnitAbilityCooldown(u, 'A01D', 25)
