                set s__AlucardSpells__AlucardSpells_E_e[this]=EffectSpawn("war3mapImported\\wos_[By XeSHTeG]Alucard Dog.mdl" , GetUnitX(s__AlucardSpells__AlucardSpells_E_c[this]) + 150 * Cos(s__AlucardSpells__AlucardSpells_E_a[this]) , GetUnitY(s__AlucardSpells__AlucardSpells_E_c[this]) + 150 * Sin(s__AlucardSpells__AlucardSpells_E_a[this]) , s__AlucardSpells__AlucardSpells_E_a[this] * bj_RADTODEG , 2.5 , 2.375 , 0)
