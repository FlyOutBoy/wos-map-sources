                                exitwhen s__BarraganSpells__HeroSpells_Q_k[this] > 1
                                if s__BarraganSpells__HeroSpells_Q_r[this] < 0.09 then
                                    set s__BarraganSpells__HeroSpells_Q_move[this]=s__BarraganSpells__HeroSpells_Q_move[this] + 9 + ( s__BarraganSpells__HeroSpells_Q_scale[this] * 8 )
