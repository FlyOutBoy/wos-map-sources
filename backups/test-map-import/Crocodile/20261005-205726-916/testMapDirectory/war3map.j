            set s__StarrkSpells__StarrkSpells_R_g[this]=CreateGroup()
            set s__StarrkSpells__StarrkSpells_R_g2[this]=CreateGroup()
            set s__StarrkSpells__StarrkSpells_R_aoe[this]=StarrkR_DamageAoe
            set s__StarrkSpells__StarrkSpells_R_a[this]=GAngle(s__StarrkSpells__StarrkSpells_R_c[this] , s__StarrkSpells__StarrkSpells_R_td[this]) // Angle Between points
            set s__StarrkSpells__StarrkSpells_R_dmg[this]=GetHeroAgi(s__StarrkSpells__StarrkSpells_R_c[this], true) * ( StarrkR_DamageAgiBase + ( StarrkR_DamageAgiStep * ( GetUnitAbilityLevel(s__StarrkSpells__StarrkSpells_R_c[this], StarrkR_ID) - 1 ) ) )
            set s__StarrkSpells__StarrkSpells_R_rmax[this]=6
            call SetUnitFacing(s__StarrkSpells__StarrkSpells_R_c[this], s__StarrkSpells__StarrkSpells_R_a[this] * bj_RADTODEG)
            call SetUnitVertexColor(s__StarrkSpells__StarrkSpells_R_c[this], 255, 255, 255, 0)
            call StartSpellUnit(s__StarrkSpells__StarrkSpells_R_c[this])
            call MakeSound("war3mapimported\\Hero_Starrk_W0")
            call MakeSound("war3mapimported\\Hero_Starrk_W1")
            call SetUnitTimeScale(s__StarrkSpells__StarrkSpells_R_c[this], 1)
            set s__StarrkSpells__StarrkSpells_R_fly[this]=StarrkR_TargetHeight / 33
            set s__StarrkSpells__StarrkSpells_R_r4[this]=2.01
            set s__StarrkSpells__StarrkSpells_R_scale[this]=1
            set s__StarrkSpells__StarrkSpells_R_scale2[this]=0.25
            set s__StarrkSpells__StarrkSpells_R_move[this]=70
            call SaveInteger(hs, GetHandleId(GetOwningPlayer(s__StarrkSpells__StarrkSpells_R_c[this])), StringHash("w skill"), 1)
            if s__StarrkSpells__StarrkSpells_R_MUI_StarrkR3 == 0 then
                call TimerStart(s__StarrkSpells__StarrkSpells_R_t_StarrkR3, 0.03, true, function s__StarrkSpells__StarrkSpells_R_Loop_StarrkR3)
            endif
        endfunction

        function s__StarrkSpells__StarrkSpells_R_Loop_StarrkR2 takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__StarrkSpells__StarrkSpells_R_MUI_StarrkR2
                set this=s__StarrkSpells__StarrkSpells_R_m_StarrkR2[i]
                if SpellBoolCaster(s__StarrkSpells__StarrkSpells_R_c[this]) and s__StarrkSpells__StarrkSpells_R_r[this] <= s__StarrkSpells__StarrkSpells_R_rmax[this] then
                    set s__StarrkSpells__StarrkSpells_R_r[this]=RoundReal(s__StarrkSpells__StarrkSpells_R_r[this] + 0.03 , 3)
                    set s__StarrkSpells__StarrkSpells_R_r[this]=S2R(R2SW(s__StarrkSpells__StarrkSpells_R_r[this], 0, 3))
                    //call MoveEff2(e, r3, a)
                    //call MoveEff2(e2, r4, a)
                    //set x = GetEffX(e)
                    //set y = GetEffY(e)
                    call MoveUnit2(s__StarrkSpells__StarrkSpells_R_d[this] , s__StarrkSpells__StarrkSpells_R_r3[this] , s__StarrkSpells__StarrkSpells_R_a[this])
                    call MoveUnit2(s__StarrkSpells__StarrkSpells_R_d2[this] , s__StarrkSpells__StarrkSpells_R_r4[this] , s__StarrkSpells__StarrkSpells_R_a[this])
                    //call MoveEff2(e2, r4, a)
                    //set x = GetEffX(e)
                    //set y = GetEffY(e)
                else
                   // set x = GetEffX(e)
                    //set y = GetEffY(e)
                    set s__StarrkSpells__StarrkSpells_R_x[this]=GetUnitX(s__StarrkSpells__StarrkSpells_R_d[this])
                    set s__StarrkSpells__StarrkSpells_R_y[this]=GetUnitY(s__StarrkSpells__StarrkSpells_R_d[this])
                    set s__StarrkSpells__StarrkSpells_R_r5[this]=GetRandomReal(4, 6)
                    if s__StarrkSpells__StarrkSpells_R_k2[this] == 1 and s__StarrkSpells__StarrkSpells_R_check[this] == 0 then
                        call DestroyEffect(EffectSpawnColor("war3mapimported\\wos_by_wood_effect_qigongbo_lan.mdl" , s__StarrkSpells__StarrkSpells_R_x[this] , s__StarrkSpells__StarrkSpells_R_y[this] , 0 , GetRandomReal(1.5, 2.25) , s__StarrkSpells__StarrkSpells_R_r5[this] , GetUnitFlyHeight(s__StarrkSpells__StarrkSpells_R_d[this]) + 40 , 75 , 155 , 255 , 255))
                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_acg_dajiqiquan4.mdx" , s__StarrkSpells__StarrkSpells_R_x[this] , s__StarrkSpells__StarrkSpells_R_y[this] , 1 , GetRandomReal(1.25, 2) , 3.25 , 1))
                    endif
                    set s__StarrkSpells__StarrkSpells_R_x[this]=GetUnitX(s__StarrkSpells__StarrkSpells_R_d2[this])
                    set s__StarrkSpells__StarrkSpells_R_y[this]=GetUnitY(s__StarrkSpells__StarrkSpells_R_d2[this])
                    
                   // set x = GetEffX(e2)
                   // set y = GetEffY(e2)
                    if s__StarrkSpells__StarrkSpells_R_k2[this] == 2 and s__StarrkSpells__StarrkSpells_R_check[this] == 0 then
                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_acg_dajiqiquan4.mdx" , s__StarrkSpells__StarrkSpells_R_x[this] , s__StarrkSpells__StarrkSpells_R_y[this] , 1 , GetRandomReal(1.25, 2) , 3.25 , 1))
                        call DestroyEffect(EffectSpawnColor("war3mapimported\\wos_by_wood_effect_qigongbo_lan.mdl" , s__StarrkSpells__StarrkSpells_R_x[this] , s__StarrkSpells__StarrkSpells_R_y[this] , 0 , GetRandomReal(1.5, 2.25) , s__StarrkSpells__StarrkSpells_R_r5[this] , GetUnitFlyHeight(s__StarrkSpells__StarrkSpells_R_d2[this]) + 25 , 75 , 155 , 255 , 255))
                    endif
                    call RemoveUnit(s__StarrkSpells__StarrkSpells_R_d[this])
                    call RemoveUnit(s__StarrkSpells__StarrkSpells_R_d2[this])
                      
                    set s__StarrkSpells__StarrkSpells_R_d[this]=null
                    set s__StarrkSpells__StarrkSpells_R_d2[this]=null
                    set s__StarrkSpells__StarrkSpells_R_c[this]=null
                    set s__StarrkSpells__StarrkSpells_R_m_StarrkR2[i]=s__StarrkSpells__StarrkSpells_R_m_StarrkR2[s__StarrkSpells__StarrkSpells_R_MUI_StarrkR2]
                    set s__StarrkSpells__StarrkSpells_R_MUI_StarrkR2=s__StarrkSpells__StarrkSpells_R_MUI_StarrkR2 - 1
                    if s__StarrkSpells__StarrkSpells_R_MUI_StarrkR2 == - 1 then
                        call PauseTimer(s__StarrkSpells__StarrkSpells_R_t_StarrkR2)
                    endif
                    call s__StarrkSpells__StarrkSpells_R_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction

        function s__StarrkSpells__StarrkSpells_R_StarrkR2_Start takes unit NewC,real NewX,real NewY,integer NewKK,integer NewKK2 returns nothing
            local integer this= s__StarrkSpells__StarrkSpells_R__allocate()
            set s__StarrkSpells__StarrkSpells_R_MUI_StarrkR2=s__StarrkSpells__StarrkSpells_R_MUI_StarrkR2 + 1
            set s__StarrkSpells__StarrkSpells_R_m_StarrkR2[s__StarrkSpells__StarrkSpells_R_MUI_StarrkR2]=this
            set s__StarrkSpells__StarrkSpells_R_c[this]=NewC
            set s__StarrkSpells__StarrkSpells_R_r[this]=0
            set s__StarrkSpells__StarrkSpells_R_x[this]=NewX
            set s__StarrkSpells__StarrkSpells_R_y[this]=NewY
            set s__StarrkSpells__StarrkSpells_R_r2[this]=0
            set s__StarrkSpells__StarrkSpells_R_a[this]=GAngle2(s__StarrkSpells__StarrkSpells_R_c[this] , s__StarrkSpells__StarrkSpells_R_x[this] , s__StarrkSpells__StarrkSpells_R_y[this]) // Angle Between points
            set s__StarrkSpells__StarrkSpells_R_r4[this]=GetRandomReal(0, 450)
            set s__StarrkSpells__StarrkSpells_R_r5[this]=GetRandomReal(125, 225)
            set s__StarrkSpells__StarrkSpells_R_check[this]=NewKK
            set s__StarrkSpells__StarrkSpells_R_k2[this]=GetRandomInt(1, 2)
            set s__StarrkSpells__StarrkSpells_R_d[this]=UnitSpawn0(GetOwningPlayer(s__StarrkSpells__StarrkSpells_R_c[this]) , StarrkR_Dummy_ID , ( GetUnitX(s__StarrkSpells__StarrkSpells_R_c[this]) + s__StarrkSpells__StarrkSpells_R_r5[this] * Cos(s__StarrkSpells__StarrkSpells_R_a[this]) ) + s__StarrkSpells__StarrkSpells_R_r4[this] * Cos(s__StarrkSpells__StarrkSpells_R_a[this] + 90 * bj_DEGTORAD) , ( GetUnitY(s__StarrkSpells__StarrkSpells_R_c[this]) + s__StarrkSpells__StarrkSpells_R_r5[this] * Sin(s__StarrkSpells__StarrkSpells_R_a[this]) ) + s__StarrkSpells__StarrkSpells_R_r4[this] * Sin(s__StarrkSpells__StarrkSpells_R_a[this] + 90 * bj_DEGTORAD) , s__StarrkSpells__StarrkSpells_R_a[this] * bj_RADTODEG , 1 , 1.2 , GetRandomReal(110, 555))
           // call SetUnitVertexColor(d,25, 125, 255, 255)
            //set e = EffectSpawnColor("war3mapimported\\Gear_124saq2.mdx", (GetUnitX(c) + r5 * Cos(a)) + r4 * Cos(a + 90 * bj_DEGTORAD), (GetUnitY(c) + r5 * Sin(a)) + r4 * Sin(a + 90 * bj_DEGTORAD), a * bj_RADTODEG, 1, 1.45, GetRandomReal(110, 555), 25, 125, 255, 255)
            if NewKK == 0 then
               // call DestroyEffect(EffectSpawn("war3mapimported\\wos_xtyball2.mdl", GetUnitX(d) - (r5 - 125) * Cos(a), GetUnitY(d) - (r5 - 125) * Sin(a), 0, 1.5, 0.4, GetUnitFlyHeight(d)))
                if NewKK2 == 1 then
                    call DestroyEffect(EffectSpawnColor3("war3mapimported\\wos_blue-shoot.mdx" , GetUnitX(s__StarrkSpells__StarrkSpells_R_d[this]) - ( s__StarrkSpells__StarrkSpells_R_r5[this] ) * Cos(s__StarrkSpells__StarrkSpells_R_a[this]) , GetUnitY(s__StarrkSpells__StarrkSpells_R_d[this]) - ( s__StarrkSpells__StarrkSpells_R_r5[this] ) * Sin(s__StarrkSpells__StarrkSpells_R_a[this]) , s__StarrkSpells__StarrkSpells_R_a[this] * bj_RADTODEG , 3 , 1.35 , GetUnitFlyHeight(s__StarrkSpells__StarrkSpells_R_d[this]) - 79 , 0 , 0 , 75 , 255 , 125))
                endif
            endif
            set s__StarrkSpells__StarrkSpells_R_r4[this]=GetRandomReal(0, 450)
            set s__StarrkSpells__StarrkSpells_R_r5[this]=GetRandomReal(125, 225)
            set s__StarrkSpells__StarrkSpells_R_d2[this]=UnitSpawn0(GetOwningPlayer(s__StarrkSpells__StarrkSpells_R_c[this]) , StarrkR_Dummy_ID , ( GetUnitX(s__StarrkSpells__StarrkSpells_R_c[this]) + s__StarrkSpells__StarrkSpells_R_r5[this] * Cos(s__StarrkSpells__StarrkSpells_R_a[this]) ) + s__StarrkSpells__StarrkSpells_R_r4[this] * Cos(s__StarrkSpells__StarrkSpells_R_a[this] - 90 * bj_DEGTORAD) , ( GetUnitY(s__StarrkSpells__StarrkSpells_R_c[this]) + s__StarrkSpells__StarrkSpells_R_r5[this] * Sin(s__StarrkSpells__StarrkSpells_R_a[this]) ) + s__StarrkSpells__StarrkSpells_R_r4[this] * Sin(s__StarrkSpells__StarrkSpells_R_a[this] - 90 * bj_DEGTORAD) , s__StarrkSpells__StarrkSpells_R_a[this] * bj_RADTODEG , 1 , 1.2 , GetRandomReal(110, 555))
            //call SetUnitVertexColor(d2,25, 125, 255, 255)
            
           // set e2 = EffectSpawnColor("war3mapimported\\Gear_124saq2.mdx", (GetUnitX(c) + r5 * Cos(a)) + r4 * Cos(a - 90 * bj_DEGTORAD), (GetUnitY(c) + r5 * Sin(a)) + r4 * Sin(a - 90 * bj_DEGTORAD), a * bj_RADTODEG, 1, 1.45, GetRandomReal(110, 555), 25, 125, 255, 255)
            if NewKK == 0 then
             //   call DestroyEffect(EffectSpawn("war3mapimported\\wos_xtyball2.mdl", GetUnitX(d2) - (r5 - 125) * Cos(a), GetUnitY(d2) - (r5 - 125) * Sin(a), 0, 1.5, 0.4, GetUnitFlyHeight(d)))
                if NewKK2 == 1 then
                    call DestroyEffect(EffectSpawnColor3("war3mapimported\\wos_blue-shoot.mdx" , GetUnitX(s__StarrkSpells__StarrkSpells_R_d2[this]) - ( s__StarrkSpells__StarrkSpells_R_r5[this] ) * Cos(s__StarrkSpells__StarrkSpells_R_a[this]) , GetUnitY(s__StarrkSpells__StarrkSpells_R_d2[this]) - ( s__StarrkSpells__StarrkSpells_R_r5[this] ) * Sin(s__StarrkSpells__StarrkSpells_R_a[this]) , s__StarrkSpells__StarrkSpells_R_a[this] * bj_RADTODEG , 3 , 1.35 , GetUnitFlyHeight(s__StarrkSpells__StarrkSpells_R_d2[this]) - 79 , 0 , 0 , 75 , 255 , 125))
                endif
            endif
            //call MoveUnit(d,-250,a)
            //call MoveUnit(d2,-250,a)
            set s__StarrkSpells__StarrkSpells_R_r3[this]=GetRandomReal(200 * 1.23, 225 * 1.23)
            set s__StarrkSpells__StarrkSpells_R_r4[this]=GetRandomReal(200 * 1.23, 225 * 1.23)
            set s__StarrkSpells__StarrkSpells_R_rmax[this]=0.21
            if s__StarrkSpells__StarrkSpells_R_MUI_StarrkR2 == 0 then
                call TimerStart(s__StarrkSpells__StarrkSpells_R_t_StarrkR2, 0.03, true, function s__StarrkSpells__StarrkSpells_R_Loop_StarrkR2)
            endif
        endfunction

        function s__StarrkSpells__StarrkSpells_R_Loop_StarrkR takes nothing returns nothing
            local integer this
            local integer i= 0
            local real targetA= 0
            local real diff= 0
            local real ra1= GetRandomReal(0, 365)
            local real dk= GetRandomReal(0.4, 0.85)
            loop
                exitwhen i > s__StarrkSpells__StarrkSpells_R_MUI_StarrkR
                set this=s__StarrkSpells__StarrkSpells_R_m_StarrkR[i]
                if SpellBoolCaster(s__StarrkSpells__StarrkSpells_R_c[this]) and s__StarrkSpells__StarrkSpells_R_r[this] < s__StarrkSpells__StarrkSpells_R_rmax[this] and LoadInteger(hs, GetHandleId(s__StarrkSpells__StarrkSpells_R_c[this]), StringHash("stop r")) == 0 then
                    set s__StarrkSpells__StarrkSpells_R_r[this]=RoundReal(s__StarrkSpells__StarrkSpells_R_r[this] + 0.03 , 3)
                    set s__StarrkSpells__StarrkSpells_R_r[this]=S2R(R2SW(s__StarrkSpells__StarrkSpells_R_r[this], 0, 3))
                    if s__StarrkSpells__StarrkSpells_R_r[this] < 1.26 then
                     //   call DebugUnit(c)
                    else
                        call DebugUnit2(s__StarrkSpells__StarrkSpells_R_c[this])
                    endif
                    if s__StarrkSpells__StarrkSpells_R_r[this] == 0.39 then
                        call SetUnitTimeScale(s__StarrkSpells__StarrkSpells_R_c[this], 0)
                    endif
                    if s__StarrkSpells__StarrkSpells_R_r[this] == 0.03 then
                        call MakeSound("war3mapimported\\Hero_Starrk_R2_3")
                    endif
                    if s__StarrkSpells__StarrkSpells_R_r[this] == StarrkR2_StunAppearTime + 1.32 and GetHeroLevel(s__StarrkSpells__StarrkSpells_R_c[this]) >= 35 then
                        //call MakeSound("war3mapimported\\Hero_Starrk_R3")
                        set s__StarrkSpells__StarrkSpells_R_k3[this]=1
                    endif
                    if s__StarrkSpells__StarrkSpells_R_r[this] > 0. and s__StarrkSpells__StarrkSpells_R_r[this] < 0.15 then
                        if s__StarrkSpells__StarrkSpells_R_r2[this] > 0.03 then
                            set ra1=GetRandomReal(0, 465)
                            set dk=GetRandomReal(0.3, 0.45)
                            set s__StarrkSpells__StarrkSpells_R_r2[this]=0
                            call EffectSpawn2("war3mapimported\\wos_xtyball2.mdl" , ( GetUnitX(s__StarrkSpells__StarrkSpells_R_c[this]) + 155 * Cos(s__StarrkSpells__StarrkSpells_R_a[this]) ) + ra1 * Cos(s__StarrkSpells__StarrkSpells_R_a[this] + 90 * bj_DEGTORAD) , ( GetUnitY(s__StarrkSpells__StarrkSpells_R_c[this]) + 155 * Sin(s__StarrkSpells__StarrkSpells_R_a[this]) ) + ra1 * Sin(s__StarrkSpells__StarrkSpells_R_a[this] + 90 * bj_DEGTORAD) , 0 , 1.15 , dk , GetRandomReal(40, 405) , 0.3 - s__StarrkSpells__StarrkSpells_R_r[this])
                            call EffectSpawn2("war3mapimported\\wos_xtyball2.mdl" , ( GetUnitX(s__StarrkSpells__StarrkSpells_R_c[this]) + 155 * Cos(s__StarrkSpells__StarrkSpells_R_a[this]) ) + ra1 * Cos(s__StarrkSpells__StarrkSpells_R_a[this] - 90 * bj_DEGTORAD) , ( GetUnitY(s__StarrkSpells__StarrkSpells_R_c[this]) + 155 * Sin(s__StarrkSpells__StarrkSpells_R_a[this]) ) + ra1 * Sin(s__StarrkSpells__StarrkSpells_R_a[this] - 90 * bj_DEGTORAD) , 0 , 1.15 , dk , GetRandomReal(40, 405) , 0.3 - s__StarrkSpells__StarrkSpells_R_r[this])
                        else
                            set s__StarrkSpells__StarrkSpells_R_r2[this]=s__StarrkSpells__StarrkSpells_R_r2[this] + 0.02
                        endif
                    endif
                    if s__StarrkSpells__StarrkSpells_R_r[this] == 0.03 then
                    //call UnitRemoveAbility(c,'Avul')
                    set s__StarrkSpells__StarrkSpells_R_r2[this]=10
                        call SaveInteger(hs, GetHandleId(s__StarrkSpells__StarrkSpells_R_c[this]), StringHash("cast r"), 1)
                        call MouseOn(GetOwningPlayer(s__StarrkSpells__StarrkSpells_R_c[this]))
                        set MouseX[GetPlayerId(GetOwningPlayer(s__StarrkSpells__StarrkSpells_R_c[this]))]=s__StarrkSpells__StarrkSpells_R_x[this]
                        set MouseY[GetPlayerId(GetOwningPlayer(s__StarrkSpells__StarrkSpells_R_c[this]))]=s__StarrkSpells__StarrkSpells_R_y[this]
                    endif
                    if s__StarrkSpells__StarrkSpells_R_r[this] > 0 then
                        set targetA=GAngle2(s__StarrkSpells__StarrkSpells_R_c[this] , GetMouseX(GetOwningPlayer(s__StarrkSpells__StarrkSpells_R_c[this])) , GetMouseY(GetOwningPlayer(s__StarrkSpells__StarrkSpells_R_c[this])))
                        set diff=targetA - s__StarrkSpells__StarrkSpells_R_a[this]
                        if diff > bj_PI then
                            set diff=diff - 2 * bj_PI
                        elseif diff < - bj_PI then
                            set diff=diff + 2 * bj_PI
                        endif
// Clamp rotation speed to max per tick (0.087 rad = ~5 degrees)
                        if diff > 0.12 then
                            set diff=0.087
                        elseif diff < - 0.087 then
                            set diff=- 0.087
                        endif
                        set s__StarrkSpells__StarrkSpells_R_a[this]=s__StarrkSpells__StarrkSpells_R_a[this] + diff
                        call BlzSetUnitFacingEx(s__StarrkSpells__StarrkSpells_R_c[this], s__StarrkSpells__StarrkSpells_R_a[this] * bj_RADTODEG)
                        if s__StarrkSpells__StarrkSpells_R_r3[this] > 0.03 then
                            set s__StarrkSpells__StarrkSpells_R_r3[this]=0
                            call s__StarrkSpells__StarrkSpells_R_StarrkR2_Start(s__StarrkSpells__StarrkSpells_R_c[this] , GetUnitX(s__StarrkSpells__StarrkSpells_R_c[this]) + 100 * Cos(s__StarrkSpells__StarrkSpells_R_a[this]) , GetUnitY(s__StarrkSpells__StarrkSpells_R_c[this]) + 100 * Sin(s__StarrkSpells__StarrkSpells_R_a[this]) , s__StarrkSpells__StarrkSpells_R_check[this] , s__StarrkSpells__StarrkSpells_R_k3[this])
                            call s__StarrkSpells__StarrkSpells_R_StarrkR2_Start(s__StarrkSpells__StarrkSpells_R_c[this] , GetUnitX(s__StarrkSpells__StarrkSpells_R_c[this]) + 100 * Cos(s__StarrkSpells__StarrkSpells_R_a[this]) , GetUnitY(s__StarrkSpells__StarrkSpells_R_c[this]) + 100 * Sin(s__StarrkSpells__StarrkSpells_R_a[this]) , s__StarrkSpells__StarrkSpells_R_check[this] , s__StarrkSpells__StarrkSpells_R_k3[this])
                            if s__StarrkSpells__StarrkSpells_R_r[this] >= StarrkR2_StunAppearTime then
                              //  call StarrkR2_Start(c, GetUnitX(c) + 100 * Cos(a), GetUnitY(c) + 100 * Sin(a), check, k3)
                            endif
                            set s__StarrkSpells__StarrkSpells_R_check[this]=s__StarrkSpells__StarrkSpells_R_check[this] + 1
                            if s__StarrkSpells__StarrkSpells_R_check[this] == 2 then
                                set s__StarrkSpells__StarrkSpells_R_check[this]=0
                            endif
                        else
                            set s__StarrkSpells__StarrkSpells_R_r3[this]=s__StarrkSpells__StarrkSpells_R_r3[this] + 0.02
                        endif
                        if s__StarrkSpells__StarrkSpells_R_r2[this] > 0.3 then
                            set s__StarrkSpells__StarrkSpells_R_r2[this]=0
                            set s__StarrkSpells__StarrkSpells_R_k[this]=1
                            call VisionTimed(GetOwningPlayer(s__StarrkSpells__StarrkSpells_R_c[this]) , GetUnitX(s__StarrkSpells__StarrkSpells_R_c[this]) + ( 700 ) * Cos(s__StarrkSpells__StarrkSpells_R_a[this]) , GetUnitY(s__StarrkSpells__StarrkSpells_R_c[this]) + ( 700 * s__StarrkSpells__StarrkSpells_R_k[this] ) * Sin(s__StarrkSpells__StarrkSpells_R_a[this]) , s__StarrkSpells__StarrkSpells_R_aoe[this] * 1.6 , 2)
                            call VisionTimed(GetOwningPlayer(s__StarrkSpells__StarrkSpells_R_c[this]) , GetUnitX(s__StarrkSpells__StarrkSpells_R_c[this]) + ( 1400 ) * Cos(s__StarrkSpells__StarrkSpells_R_a[this]) , GetUnitY(s__StarrkSpells__StarrkSpells_R_c[this]) + ( 1400 ) * Sin(s__StarrkSpells__StarrkSpells_R_a[this]) , s__StarrkSpells__StarrkSpells_R_aoe[this] * 1.6 , 2)
                            call VisionTimed(GetOwningPlayer(s__StarrkSpells__StarrkSpells_R_c[this]) , GetUnitX(s__StarrkSpells__StarrkSpells_R_c[this]) + ( 2100 ) * Cos(s__StarrkSpells__StarrkSpells_R_a[this]) , GetUnitY(s__StarrkSpells__StarrkSpells_R_c[this]) + ( 2100 ) * Sin(s__StarrkSpells__StarrkSpells_R_a[this]) , s__StarrkSpells__StarrkSpells_R_aoe[this] * 1.6 , 2)
                            call VisionTimed(GetOwningPlayer(s__StarrkSpells__StarrkSpells_R_c[this]) , GetUnitX(s__StarrkSpells__StarrkSpells_R_c[this]) + ( 2600 ) * Cos(s__StarrkSpells__StarrkSpells_R_a[this]) , GetUnitY(s__StarrkSpells__StarrkSpells_R_c[this]) + ( 2600 ) * Sin(s__StarrkSpells__StarrkSpells_R_a[this]) , s__StarrkSpells__StarrkSpells_R_aoe[this] * 1.6 , 2)
                            call GroupClear(s__StarrkSpells__StarrkSpells_R_g2[this])
                            set s__StarrkSpells__StarrkSpells_R_check2[this]=s__StarrkSpells__StarrkSpells_R_check2[this] + 1
                           // call BJDebugMsg(I2S(check2))
                            loop
                                exitwhen s__StarrkSpells__StarrkSpells_R_k[this] == 7
                                call GroupClear(s__StarrkSpells__StarrkSpells_R_g[this])
                                call DecorRemove(s__StarrkSpells__StarrkSpells_R_c[this] , GetUnitX(s__StarrkSpells__StarrkSpells_R_c[this]) + ( 340 * s__StarrkSpells__StarrkSpells_R_k[this] ) * Cos(s__StarrkSpells__StarrkSpells_R_a[this]) , GetUnitY(s__StarrkSpells__StarrkSpells_R_c[this]) + ( 340 * s__StarrkSpells__StarrkSpells_R_k[this] ) * Sin(s__StarrkSpells__StarrkSpells_R_a[this]) , s__StarrkSpells__StarrkSpells_R_aoe[this] , 50)
                                call GroupEnumUnitsInRange(s__StarrkSpells__StarrkSpells_R_g[this], GetUnitX(s__StarrkSpells__StarrkSpells_R_c[this]) + ( 340 * s__StarrkSpells__StarrkSpells_R_k[this] ) * Cos(s__StarrkSpells__StarrkSpells_R_a[this]), GetUnitY(s__StarrkSpells__StarrkSpells_R_c[this]) + ( 340 * s__StarrkSpells__StarrkSpells_R_k[this] ) * Sin(s__StarrkSpells__StarrkSpells_R_a[this]), s__StarrkSpells__StarrkSpells_R_aoe[this], NoDecor_Cond)
                                loop
                                    set s__StarrkSpells__StarrkSpells_R_u[this]=FirstOfGroup(s__StarrkSpells__StarrkSpells_R_g[this])
                                    exitwhen s__StarrkSpells__StarrkSpells_R_u[this] == null
                                    if SpellBool(s__StarrkSpells__StarrkSpells_R_u[this]) and IsUnitEnemy(s__StarrkSpells__StarrkSpells_R_u[this], GetOwningPlayer(s__StarrkSpells__StarrkSpells_R_c[this])) and IsUnitInGroup(s__StarrkSpells__StarrkSpells_R_u[this], s__StarrkSpells__StarrkSpells_R_g2[this]) == false then
                                        call dmgmag(s__StarrkSpells__StarrkSpells_R_c[this] , s__StarrkSpells__StarrkSpells_R_u[this] , s__StarrkSpells__StarrkSpells_R_dmg[this])
                                        if s__StarrkSpells__StarrkSpells_R_r[this] >= StarrkR2_StunAppearTime and GetHeroLevel(s__StarrkSpells__StarrkSpells_R_c[this]) >= 35 then
                                            call StunUnit(s__StarrkSpells__StarrkSpells_R_c[this] , s__StarrkSpells__StarrkSpells_R_u[this] , StarrkR2_Stun)
                                        endif
                                        //call MUE(u, 60, 0.3, a)
                                        call SlowUnit(s__StarrkSpells__StarrkSpells_R_c[this] , s__StarrkSpells__StarrkSpells_R_u[this] , StarrkR2_Slow , StarrkR2_SlowDuration)
                                        call GroupAddUnit(s__StarrkSpells__StarrkSpells_R_g2[this], s__StarrkSpells__StarrkSpells_R_u[this])
                                    endif
                                    call GroupRemoveUnit(s__StarrkSpells__StarrkSpells_R_g[this], s__StarrkSpells__StarrkSpells_R_u[this])
                                endloop
                                set s__StarrkSpells__StarrkSpells_R_u[this]=null
                                set s__StarrkSpells__StarrkSpells_R_k[this]=s__StarrkSpells__StarrkSpells_R_k[this] + 1
                            endloop
                        else
                            set s__StarrkSpells__StarrkSpells_R_r2[this]=s__StarrkSpells__StarrkSpells_R_r2[this] + 0.03
                        endif
                    endif
                else
                    call StopSpellUnit2(s__StarrkSpells__StarrkSpells_R_c[this])
                    call MouseOff(GetOwningPlayer(s__StarrkSpells__StarrkSpells_R_c[this]))
                    call DestroyEffect(s__StarrkSpells__StarrkSpells_R_e[this])
                    call SaveInteger(hs, GetHandleId(s__StarrkSpells__StarrkSpells_R_c[this]), StringHash("stop r"), 0)
                    call SaveInteger(hs, GetHandleId(s__StarrkSpells__StarrkSpells_R_c[this]), StringHash("cast r"), 0)
                    call SaveInteger(hs, GetHandleId(s__StarrkSpells__StarrkSpells_R_c[this]), StringHash("povorot"), 0)
                    if s__StarrkSpells__StarrkSpells_R_r[this] < s__StarrkSpells__StarrkSpells_R_r7[this] then
                        call UnitRemoveAbility(s__StarrkSpells__StarrkSpells_R_c[this], 'Avul')
                    endif
                    call SetUnitTimeScale(s__StarrkSpells__StarrkSpells_R_c[this], 1)
                    call DestroyGroup(s__StarrkSpells__StarrkSpells_R_g[this])
                    call DestroyGroup(s__StarrkSpells__StarrkSpells_R_g2[this])
                    set s__StarrkSpells__StarrkSpells_R_g[this]=null
                    set s__StarrkSpells__StarrkSpells_R_g2[this]=null
                    set s__StarrkSpells__StarrkSpells_R_e[this]=null
                    set s__StarrkSpells__StarrkSpells_R_c[this]=null
                    set s__StarrkSpells__StarrkSpells_R_m_StarrkR[i]=s__StarrkSpells__StarrkSpells_R_m_StarrkR[s__StarrkSpells__StarrkSpells_R_MUI_StarrkR]
                    set s__StarrkSpells__StarrkSpells_R_MUI_StarrkR=s__StarrkSpells__StarrkSpells_R_MUI_StarrkR - 1
                    if s__StarrkSpells__StarrkSpells_R_MUI_StarrkR == - 1 then
                        call PauseTimer(s__StarrkSpells__StarrkSpells_R_t_StarrkR)
                    endif
                    call s__StarrkSpells__StarrkSpells_R_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction

        function s__StarrkSpells__StarrkSpells_R_StarrkR_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__StarrkSpells__StarrkSpells_R__allocate()
            local integer kkk= 0
            set s__StarrkSpells__StarrkSpells_R_MUI_StarrkR=s__StarrkSpells__StarrkSpells_R_MUI_StarrkR + 1
            set s__StarrkSpells__StarrkSpells_R_m_StarrkR[s__StarrkSpells__StarrkSpells_R_MUI_StarrkR]=this
            set s__StarrkSpells__StarrkSpells_R_c[this]=NewC
            set s__StarrkSpells__StarrkSpells_R_r[this]=0
            set s__StarrkSpells__StarrkSpells_R_x[this]=NewX
            set s__StarrkSpells__StarrkSpells_R_y[this]=NewY
            set s__StarrkSpells__StarrkSpells_R_check[this]=0
            set s__StarrkSpells__StarrkSpells_R_k2[this]=GetPlayerId(GetOwningPlayer(s__StarrkSpells__StarrkSpells_R_c[this]))
            set s__StarrkSpells__StarrkSpells_R_g[this]=CreateGroup()
            set s__StarrkSpells__StarrkSpells_R_k3[this]=0
            set s__StarrkSpells__StarrkSpells_R_check2[this]=0
            set s__StarrkSpells__StarrkSpells_R_r4[this]=10
            set s__StarrkSpells__StarrkSpells_R_g2[this]=CreateGroup()
            set kkk=( GetUnitAbilityLevel(s__StarrkSpells__StarrkSpells_R_c[this], StarrkR_ID) - 1 )
            if kkk > 2 then
            //    set kkk = 2
            endif
            set s__StarrkSpells__StarrkSpells_R_dmg[this]=GetHeroAgi(s__StarrkSpells__StarrkSpells_R_c[this], true) * ( StarrkR2_DamageAgiBase + ( StarrkR2_DamageAgiStep * ( GetUnitAbilityLevel(s__StarrkSpells__StarrkSpells_R_c[this], StarrkR_ID) - 1 ) ) )
            //call BJDebugMsg(R2S(dmg))
            set s__StarrkSpells__StarrkSpells_R_dmg[this]=s__StarrkSpells__StarrkSpells_R_dmg[this] / 3
            //call BJDebugMsg(R2S(dmg))
            set s__StarrkSpells__StarrkSpells_R_r2[this]=10
            set s__StarrkSpells__StarrkSpells_R_aoe[this]=StarrkR2_DamageAoe
            call StartSpellUnit2(s__StarrkSpells__StarrkSpells_R_c[this])
            call SaveInteger(hs, GetHandleId(Player(s__StarrkSpells__StarrkSpells_R_k2[this])), StringHash("r start"), 1)
            set s__StarrkSpells__StarrkSpells_R_a[this]=GAngle2(s__StarrkSpells__StarrkSpells_R_c[this] , s__StarrkSpells__StarrkSpells_R_x[this] , s__StarrkSpells__StarrkSpells_R_y[this]) // Angle Between points
            call MakeSound("war3mapimported\\Hero_Starrk_R1")
            call VisionTimed(GetOwningPlayer(s__StarrkSpells__StarrkSpells_R_c[this]) , GetUnitX(s__StarrkSpells__StarrkSpells_R_c[this]) , GetUnitY(s__StarrkSpells__StarrkSpells_R_c[this]) , 1800 , 4)
            set s__StarrkSpells__StarrkSpells_R_rmax[this]=3
            set s__StarrkSpells__StarrkSpells_R_r7[this]=StarrkR2_InvulPerLvlAdd * ( GetUnitAbilityLevel(s__StarrkSpells__StarrkSpells_R_c[this], StarrkR_ID) - 1 )
            set s__StarrkSpells__StarrkSpells_R_check2[this]=0
            set s__StarrkSpells__StarrkSpells_R_e[this]=AddSpecialEffectTarget("war3mapimported\\wos_aurapartblue.mdx", s__StarrkSpells__StarrkSpells_R_c[this], "origin")
            call BlzSetUnitFacingEx(s__StarrkSpells__StarrkSpells_R_c[this], s__StarrkSpells__StarrkSpells_R_a[this] * bj_RADTODEG)
            call SetUnitTimeScale(s__StarrkSpells__StarrkSpells_R_c[this], 1)
            call SetUnitAnimationByIndex(s__StarrkSpells__StarrkSpells_R_c[this], 2)
            if s__StarrkSpells__StarrkSpells_R_MUI_StarrkR == 0 then
                call TimerStart(s__StarrkSpells__StarrkSpells_R_t_StarrkR, 0.03, true, function s__StarrkSpells__StarrkSpells_R_Loop_StarrkR)
            endif
        endfunction



        function s__StarrkSpells__StarrkSpells_T_Loop_StarrkT2 takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__StarrkSpells__StarrkSpells_T_MUI_StarrkT2
                set this=s__StarrkSpells__StarrkSpells_T_m_StarrkT2[i]
                set s__StarrkSpells__StarrkSpells_T_b[this]=SpellBoolCaster(s__StarrkSpells__StarrkSpells_T_c[this]) and s__StarrkSpells__StarrkSpells_T_r[this] <= s__StarrkSpells__StarrkSpells_T_rmax[this] and SR2(s__StarrkSpells__StarrkSpells_T_d[this] , s__StarrkSpells__StarrkSpells_T_td[this]) > 110
                if s__StarrkSpells__StarrkSpells_T_check[this] == 1 then
                    // TT/TR wolf was already launched: it must finish even if T is cancelled.
                    set s__StarrkSpells__StarrkSpells_T_b[this]=s__StarrkSpells__StarrkSpells_T_r[this] <= s__StarrkSpells__StarrkSpells_T_rmax[this] and SR3(s__StarrkSpells__StarrkSpells_T_d[this] , s__StarrkSpells__StarrkSpells_T_x[this] , s__StarrkSpells__StarrkSpells_T_y[this]) > 110
                    if s__StarrkSpells__StarrkSpells_T_check2[this] == 1 then
                        set s__StarrkSpells__StarrkSpells_T_b[this]=s__StarrkSpells__StarrkSpells_T_r[this] <= s__StarrkSpells__StarrkSpells_T_rmax[this]
                    endif
                endif
                if s__StarrkSpells__StarrkSpells_T_b[this] then
                    set s__StarrkSpells__StarrkSpells_T_r[this]=RoundReal(s__StarrkSpells__StarrkSpells_T_r[this] + 0.03 , 3)
                    set s__StarrkSpells__StarrkSpells_T_r[this]=S2R(R2SW(s__StarrkSpells__StarrkSpells_T_r[this], 0, 3))
                    if s__StarrkSpells__StarrkSpells_T_check[this] == 0 then
                        set s__StarrkSpells__StarrkSpells_T_a[this]=GAngle(s__StarrkSpells__StarrkSpells_T_d[this] , s__StarrkSpells__StarrkSpells_T_td[this])
                    else
                        set s__StarrkSpells__StarrkSpells_T_a[this]=GAngle2(s__StarrkSpells__StarrkSpells_T_d[this] , s__StarrkSpells__StarrkSpells_T_x[this] , s__StarrkSpells__StarrkSpells_T_y[this])
                    endif
                    call MoveUnit2(s__StarrkSpells__StarrkSpells_T_d[this] , s__StarrkSpells__StarrkSpells_T_move[this] , s__StarrkSpells__StarrkSpells_T_a[this])
                    set s__StarrkSpells__StarrkSpells_T_r3[this]=s__StarrkSpells__StarrkSpells_T_r3[this] + s__StarrkSpells__StarrkSpells_T_move[this]
                    if s__StarrkSpells__StarrkSpells_T_check2[this] == 1 then
                        call SetFly(s__StarrkSpells__StarrkSpells_T_d[this] , Parabola(s__StarrkSpells__StarrkSpells_T_fly[this] , s__StarrkSpells__StarrkSpells_T_sr[this] , s__StarrkSpells__StarrkSpells_T_r3[this]))
                    endif
                    call BlzSetUnitFacingEx(s__StarrkSpells__StarrkSpells_T_d[this], s__StarrkSpells__StarrkSpells_T_a[this] * bj_RADTODEG)
                    if s__StarrkSpells__StarrkSpells_T_r2[this] > 0.03 and s__StarrkSpells__StarrkSpells_T_check2[this] == 0 then
                        set s__StarrkSpells__StarrkSpells_T_r2[this]=0
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_BY_Wood_Effect_Kula_2_YiYingCun0.mdl" , GetUnitX(s__StarrkSpells__StarrkSpells_T_d[this]) + 100 * Cos(s__StarrkSpells__StarrkSpells_T_a[this]) , GetUnitY(s__StarrkSpells__StarrkSpells_T_d[this]) + 100 * Sin(s__StarrkSpells__StarrkSpells_T_a[this]) , s__StarrkSpells__StarrkSpells_T_a[this] * bj_RADTODEG , 0.75 , 1.5 , GetUnitFlyHeight(s__StarrkSpells__StarrkSpells_T_d[this]) + 50))
                        call VisionTimed(GetOwningPlayer(s__StarrkSpells__StarrkSpells_T_c[this]) , GetUnitX(s__StarrkSpells__StarrkSpells_T_d[this]) , GetUnitY(s__StarrkSpells__StarrkSpells_T_d[this]) , 800 , 2)
                    else
                        set s__StarrkSpells__StarrkSpells_T_r2[this]=s__StarrkSpells__StarrkSpells_T_r2[this] + 0.03
                    endif
                else
                    if SpellBoolCaster(s__StarrkSpells__StarrkSpells_T_c[this]) or s__StarrkSpells__StarrkSpells_T_check[this] == 1 then
                    set s__StarrkSpells__StarrkSpells_T_x[this]=GetUnitX(s__StarrkSpells__StarrkSpells_T_d[this])
                    set s__StarrkSpells__StarrkSpells_T_y[this]=GetUnitY(s__StarrkSpells__StarrkSpells_T_d[this])
                    if LoadInteger(hs, GetHandleId(s__StarrkSpells__StarrkSpells_T_c[this]), StringHash("sond cd2")) == 0 then
                        call MakeSound("war3mapimported\\Hero_Starrk_TT3")
                        call SaveInteger(hs, GetHandleId(s__StarrkSpells__StarrkSpells_T_c[this]), StringHash("sond cd2"), 1)
                        call s__GearSystems2___KS_Flush_Start((GetHandleId(s__StarrkSpells__StarrkSpells_T_c[this]) ) , ( StringHash("sond cd2") ) , ( 0 ) , (( 1.5)*1.0)) // INLINED!!
                    endif
                    if s__StarrkSpells__StarrkSpells_T_check[this] == 0 then
                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_blue--zhendi31_3_x2.mdl" , s__StarrkSpells__StarrkSpells_T_x[this] , s__StarrkSpells__StarrkSpells_T_y[this] , GetRandomReal(0, 359) , 1 , 1 , 1))
                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_OPm (431232).mdl" , s__StarrkSpells__StarrkSpells_T_x[this] , s__StarrkSpells__StarrkSpells_T_y[this] , GetRandomReal(0, 359) , 1.15 , 2.35 , 15))
                        call DestroyEffect(EffectSpawnColor("war3mapimported\\wos_by_wood_effect_order_dange_yueyun_2withoutblue2.mdl" , s__StarrkSpells__StarrkSpells_T_x[this] , s__StarrkSpells__StarrkSpells_T_y[this] , GetRandomReal(0, 359) , 1.25 , 1.1 , 1 , 255 , 255 , 255 , 255))
                    else
                        if s__StarrkSpells__StarrkSpells_T_check2[this] == 1 then
                            call DestroyEffect(EffectSpawn("war3mapimported\\wos_OPm (431232).mdl" , s__StarrkSpells__StarrkSpells_T_x[this] , s__StarrkSpells__StarrkSpells_T_y[this] , GetRandomReal(0, 359) , 1.15 , 2.55 , 15))
                        endif
                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_blue--zhendi31_3_x2.mdl" , s__StarrkSpells__StarrkSpells_T_x[this] , s__StarrkSpells__StarrkSpells_T_y[this] , GetRandomReal(0, 359) , 1.5 , 1 , 1))
                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_acg_dajiqiquan4.mdx" , s__StarrkSpells__StarrkSpells_T_x[this] , s__StarrkSpells__StarrkSpells_T_y[this] , 1 , GetRandomReal(1.75, 2.25) , 2.65 , 1))
                        call DestroyEffect(EffectSpawnColor("war3mapimported\\wos_by_wood_effect_order_dange_yueyun_2withoutblue2.mdl" , s__StarrkSpells__StarrkSpells_T_x[this] , s__StarrkSpells__StarrkSpells_T_y[this] , GetRandomReal(0, 359) , 1.35 , 1.05 , 1 , 255 , 255 , 255 , 255))
                    endif
                    call GroupClear(s__StarrkSpells__StarrkSpells_T_g[this])
                    call DecorRemove(s__StarrkSpells__StarrkSpells_T_c[this] , s__StarrkSpells__StarrkSpells_T_x[this] , s__StarrkSpells__StarrkSpells_T_y[this] , s__StarrkSpells__StarrkSpells_T_aoe[this] , 100)
                    call VisionTimed(GetOwningPlayer(s__StarrkSpells__StarrkSpells_T_c[this]) , s__StarrkSpells__StarrkSpells_T_x[this] , s__StarrkSpells__StarrkSpells_T_y[this] , s__StarrkSpells__StarrkSpells_T_aoe[this] + 200 , 4.5)
                    call GroupEnumUnitsInRange(s__StarrkSpells__StarrkSpells_T_g[this], s__StarrkSpells__StarrkSpells_T_x[this], s__StarrkSpells__StarrkSpells_T_y[this], s__StarrkSpells__StarrkSpells_T_aoe[this], NoDecor_Cond)
                    loop
                        set s__StarrkSpells__StarrkSpells_T_u[this]=FirstOfGroup(s__StarrkSpells__StarrkSpells_T_g[this])
                        exitwhen s__StarrkSpells__StarrkSpells_T_u[this] == null
                        if IsUnitEnemy(s__StarrkSpells__StarrkSpells_T_u[this], GetOwningPlayer(s__StarrkSpells__StarrkSpells_T_c[this])) and SpellBool(s__StarrkSpells__StarrkSpells_T_u[this]) and IsUnitInGroup(s__StarrkSpells__StarrkSpells_T_u[this], s__StarrkSpells__StarrkSpells_T_g3[this]) == false then
                            call GroupAddUnit(s__StarrkSpells__StarrkSpells_T_g3[this], s__StarrkSpells__StarrkSpells_T_u[this])
                            call dmgmag(s__StarrkSpells__StarrkSpells_T_c[this] , s__StarrkSpells__StarrkSpells_T_u[this] , s__StarrkSpells__StarrkSpells_T_dmg[this])
                            call StunUnit(s__StarrkSpells__StarrkSpells_T_c[this] , s__StarrkSpells__StarrkSpells_T_u[this] , StarrkT_Stun)
                        endif
                        call GroupRemoveUnit(s__StarrkSpells__StarrkSpells_T_g[this], s__StarrkSpells__StarrkSpells_T_u[this])
                    endloop
                    endif
                    // T3 transfers launched wolves out of the base T group.
                    if s__StarrkSpells__StarrkSpells_T_g2[this] != null then
                        call GroupRemoveUnit(s__StarrkSpells__StarrkSpells_T_g2[this], s__StarrkSpells__StarrkSpells_T_d[this])
                    endif
                    call ColorDummy3(s__StarrkSpells__StarrkSpells_T_d[this] , 0 , 255 , 255 , 255 , 0.3)
                    call DestroyGroup(s__StarrkSpells__StarrkSpells_T_g[this])
                    set s__StarrkSpells__StarrkSpells_T_g[this]=null
                    set s__StarrkSpells__StarrkSpells_T_d[this]=null
                    set s__StarrkSpells__StarrkSpells_T_g2[this]=null
                    set s__StarrkSpells__StarrkSpells_T_g3[this]=null
                    set s__StarrkSpells__StarrkSpells_T_c[this]=null
