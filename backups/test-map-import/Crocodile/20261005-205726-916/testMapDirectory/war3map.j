                        endif
                        if s__FrierenSpells___FrierenSpells_Q_r2[this] > 0.03 then
                            set s__FrierenSpells___FrierenSpells_Q_r2[this]=0
                            call GroupClear(s__FrierenSpells___FrierenSpells_Q_g[this])
                            call GroupEnumUnitsInRange(s__FrierenSpells___FrierenSpells_Q_g[this], s__FrierenSpells___FrierenSpells_Q_x[this], s__FrierenSpells___FrierenSpells_Q_y[this], s__FrierenSpells___FrierenSpells_Q_aoe[this] * StarrkEQ_AoeMultiplier, NoDecor_Cond)
                            loop
