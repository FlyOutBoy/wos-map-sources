            set s__CrocodileSpells___CrocodileE_Struct_charge1[this]=0.0
            set s__CrocodileSpells___CrocodileE_Struct_charge2[this]=0.0
            set s__CrocodileSpells___CrocodileE_Struct_charge3[this]=0.0
            set s__CrocodileSpells___CrocodileE_Struct_shownCharges[this]=3
            set s__CrocodileSpells___CrocodileE_Struct_castPauseHeld[this]=false
            set s__CrocodileSpells___CrocodileE_Struct_active[this]=false
            set s__CrocodileSpells___CrocodileE_Struct_cancelDash[this]=false
            set s__CrocodileSpells___CrocodileE_Struct_g[this]=null
            set s__CrocodileSpells___CrocodileE_Struct_g2[this]=null
            set s__CrocodileSpells___CrocodileE_Struct_e[this]=null
            call SaveInteger(CrocodileSpells___CrocodileTable, GetHandleId(s__CrocodileSpells___CrocodileE_Struct_c[this]), CrocodileSpells___CrocodileE_DataKey, this)
            call TasAbilityChargeBox_SetValue(s__CrocodileSpells___CrocodileE_Struct_c[this] , CrocodileE_ID , "3")
        endfunction

        function s__CrocodileSpells___CrocodileE_Struct_CrocodileE_Begin takes unit NewC,real NewX,real NewY returns boolean
            local integer this= LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(NewC), CrocodileSpells___CrocodileE_DataKey)
            if LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(NewC), CrocodileSpells___CrocodileCore_DataKey) == 0 or IsUnitIllusion(NewC) or not SpellBoolCaster(NewC) or LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(NewC), CrocodileSpells___CrocodileT_DataKey) != 0 then
                return false
            endif
            if this == 0 or s__CrocodileSpells___CrocodileE_Struct_active[this] or s__CrocodileSpells___CrocodileE_Struct_useCooldown[this] > 0.0 or CrocodileE_Duration <= 0.0 then
                return false
            endif
            if s__CrocodileSpells___CrocodileE_Struct_charge1[this] == 0.0 then
                set s__CrocodileSpells___CrocodileE_Struct_charge1[this]=CrocodileE_Recharge
            elseif s__CrocodileSpells___CrocodileE_Struct_charge2[this] == 0.0 then
                set s__CrocodileSpells___CrocodileE_Struct_charge2[this]=CrocodileE_Recharge
            elseif s__CrocodileSpells___CrocodileE_Struct_charge3[this] == 0.0 then
                set s__CrocodileSpells___CrocodileE_Struct_charge3[this]=CrocodileE_Recharge
            else
                return false
            endif
            set s__CrocodileSpells___CrocodileE_Struct_useCooldown[this]=CrocodileE_UseCD
            call BlzStartUnitAbilityCooldown(s__CrocodileSpells___CrocodileE_Struct_c[this], CrocodileE_ID, s__CrocodileSpells___CrocodileE_Struct_useCooldown[this])
            set s__CrocodileSpells___CrocodileE_Struct_castPauseHeld[this]=true
            call StartSpellUnit2(s__CrocodileSpells___CrocodileE_Struct_c[this])
            set s__CrocodileSpells___CrocodileE_Struct_active[this]=true
            set s__CrocodileSpells___CrocodileE_Struct_cancelDash[this]=false
            set s__CrocodileSpells___CrocodileE_Struct_x[this]=GetUnitX(s__CrocodileSpells___CrocodileE_Struct_c[this])
            set s__CrocodileSpells___CrocodileE_Struct_y[this]=GetUnitY(s__CrocodileSpells___CrocodileE_Struct_c[this])
            set s__CrocodileSpells___CrocodileE_Struct_a[this]=Atan2(NewY - s__CrocodileSpells___CrocodileE_Struct_y[this], NewX - s__CrocodileSpells___CrocodileE_Struct_x[this])
            set s__CrocodileSpells___CrocodileE_Struct_r[this]=0.0
            set s__CrocodileSpells___CrocodileE_Struct_duration[this]=CrocodileE_Duration
            set s__CrocodileSpells___CrocodileE_Struct_moveDelay[this]=RMaxBJ(0.0, CrocodileE_MoveDelay)
            set s__CrocodileSpells___CrocodileE_Struct_rmax[this]=RMaxBJ(3.0, s__CrocodileSpells___CrocodileE_Struct_moveDelay[this] + s__CrocodileSpells___CrocodileE_Struct_duration[this] + CrocodileSpells___CrocodilePeriod)
            set s__CrocodileSpells___CrocodileE_Struct_distance[this]=0.0
            set s__CrocodileSpells___CrocodileE_Struct_maxDistance[this]=RMinBJ(CrocodileE_Distance, SR3(s__CrocodileSpells___CrocodileE_Struct_c[this] , NewX , NewY))
            set s__CrocodileSpells___CrocodileE_Struct_radius[this]=CrocodileE_Aoe
            set s__CrocodileSpells___CrocodileE_Struct_dmg[this]=GetHeroAgi(s__CrocodileSpells___CrocodileE_Struct_c[this], true) * ( CrocodileE_DamageAgiBase + CrocodileE_DamageAgiStep * ( GetUnitAbilityLevel(s__CrocodileSpells___CrocodileE_Struct_c[this], CrocodileE_ID) - 1 ) )
            set s__CrocodileSpells___CrocodileE_Struct_g[this]=CreateGroup()
            set s__CrocodileSpells___CrocodileE_Struct_g2[this]=CreateGroup()
//---------------- E effect --------------------------------------------------
            set s__CrocodileSpells___CrocodileE_Struct_e[this]=AddSpecialEffectTarget("war3mapImported\\wos_Death_Spell2.mdl", s__CrocodileSpells___CrocodileE_Struct_c[this], "hand right")

            call SetUnitAnimationByIndex(s__CrocodileSpells___CrocodileE_Struct_c[this], CrocodileE_Animation)
            call SetUnitTimeScale(s__CrocodileSpells___CrocodileE_Struct_c[this], CrocodileE_AnimationSpeed)
            set s__CrocodileSpells___CrocodileE_Struct_e2[this]=EffectSpawn("war3mapImported\\wos_tx-084.mdl" , GetUnitX(s__CrocodileSpells___CrocodileE_Struct_c[this]) + 150 * Cos(s__CrocodileSpells___CrocodileE_Struct_a[this]) , GetUnitY(s__CrocodileSpells___CrocodileE_Struct_c[this]) + 150 * Sin(s__CrocodileSpells___CrocodileE_Struct_a[this]) , s__CrocodileSpells___CrocodileE_Struct_a[this] * bj_RADTODEG , 1.25 , CrocodileE_SlashScale , 110)
            call MakeSound("war3mapImported\\Hero_Crocodile_E")
            if GetRandomInt(1, 2) == 1 then
            call MakeSound("war3mapImported\\Hero_Crocodile_E2")
            else
            call MakeSound("war3mapImported\\Hero_Crocodile_E3")
            endif
            return true
        endfunction



//================================ Crocodile R - Sables ========================================


        function s__CrocodileSpells___CrocodileR_Struct_CrocodileR_Release takes integer this,unit u returns nothing
            local integer target= LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(u), CrocodileSpells___CrocodileR_TargetKey)
            local integer other
            if target == 0 or s__CrocodileSpells___CrocodileR_Target_owner[target] != this then
                return
            endif
            // Saved handles also cover units removed from Warcraft's native groups.
            if s__CrocodileSpells___CrocodileR_Target_previous[target] == 0 then
                set s__CrocodileSpells___CrocodileR_Struct_captured[this]=s__CrocodileSpells___CrocodileR_Target_next[target]
            else
                set other=s__CrocodileSpells___CrocodileR_Target_previous[target]
                set s__CrocodileSpells___CrocodileR_Target_next[other]=s__CrocodileSpells___CrocodileR_Target_next[target]
            endif
            if s__CrocodileSpells___CrocodileR_Target_next[target] != 0 then
                set other=s__CrocodileSpells___CrocodileR_Target_next[target]
                set s__CrocodileSpells___CrocodileR_Target_previous[other]=s__CrocodileSpells___CrocodileR_Target_previous[target]
            endif
            call SetFly(u , s__CrocodileSpells___CrocodileR_Target_height[target])
            call BlzPauseUnitEx(u, false)
            call RemoveSavedInteger(CrocodileSpells___CrocodileTable, GetHandleId(u), CrocodileSpells___CrocodileR_TargetKey)
            set s__CrocodileSpells___CrocodileR_Target_u[target]=null
            call s__CrocodileSpells___CrocodileR_Target_deallocate(target)
        endfunction

        function s__CrocodileSpells___CrocodileR_Struct_CrocodileR_ReleaseAll takes integer this returns nothing
            local integer target
            loop
                exitwhen s__CrocodileSpells___CrocodileR_Struct_captured[this] == 0
                set target=s__CrocodileSpells___CrocodileR_Struct_captured[this]
                call s__CrocodileSpells___CrocodileR_Struct_CrocodileR_Release(this,s__CrocodileSpells___CrocodileR_Target_u[target])
            endloop
        endfunction

        function s__CrocodileSpells___CrocodileR_Struct_CrocodileR_Death takes unit dead returns nothing
            local integer i= 0
            local integer this
            local integer target= LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(dead), CrocodileSpells___CrocodileR_TargetKey)
            if target != 0 then
                set this=s__CrocodileSpells___CrocodileR_Target_owner[target]
                call s__CrocodileSpells___CrocodileR_Struct_CrocodileR_Release(this,dead)
            endif
            loop
                exitwhen i > s__CrocodileSpells___CrocodileR_Struct_MUI
                set this=s__CrocodileSpells___CrocodileR_Struct_m[i]
                if s__CrocodileSpells___CrocodileR_Struct_c[this] == dead then
                    set s__CrocodileSpells___CrocodileR_Struct_endNow[this]=true
                    call s__CrocodileSpells___CrocodileR_Struct_CrocodileR_ReleaseAll(this)
                endif
                set i=i + 1
            endloop
        endfunction

        function s__CrocodileSpells___CrocodileR_Struct_Loop_CrocodileR takes nothing returns nothing
            local integer i= 0
            local integer next
            local integer target
            local integer other
            local integer this
            local unit u
            local real step
            local real angle
            local real sandSpacing
            local real trailOffset
            loop
                exitwhen i > s__CrocodileSpells___CrocodileR_Struct_MUI
                set this=s__CrocodileSpells___CrocodileR_Struct_m[i]
                set s__CrocodileSpells___CrocodileR_Struct_r[this]=RoundReal(s__CrocodileSpells___CrocodileR_Struct_r[this] + CrocodileSpells___CrocodilePeriod , 3)
                set s__CrocodileSpells___CrocodileR_Struct_pulse[this]=s__CrocodileSpells___CrocodileR_Struct_pulse[this] + CrocodileSpells___CrocodilePeriod
                if s__CrocodileSpells___CrocodileR_Struct_castPauseHeld[this] and ( s__CrocodileSpells___CrocodileR_Struct_r[this] + 0.001 >= CrocodileR_CastTime or s__CrocodileSpells___CrocodileR_Struct_endNow[this] or not SpellBoolCaster(s__CrocodileSpells___CrocodileR_Struct_c[this]) ) then
                    set s__CrocodileSpells___CrocodileR_Struct_castPauseHeld[this]=false
                    call StopSpellUnit2(s__CrocodileSpells___CrocodileR_Struct_c[this])
                endif
                if not s__CrocodileSpells___CrocodileR_Struct_endNow[this] and SpellBoolCaster(s__CrocodileSpells___CrocodileR_Struct_c[this]) and LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(s__CrocodileSpells___CrocodileR_Struct_c[this]), CrocodileSpells___CrocodileCore_DataKey) != 0 then
                    // Aim selects the direction; the tornado keeps travelling for its lifetime.
                    set step=CrocodileR_Speed * CrocodileSpells___CrocodilePeriod
                    set s__CrocodileSpells___CrocodileR_Struct_x[this]=s__CrocodileSpells___CrocodileR_Struct_x[this] + step * Cos(s__CrocodileSpells___CrocodileR_Struct_a[this])
                    set s__CrocodileSpells___CrocodileR_Struct_y[this]=s__CrocodileSpells___CrocodileR_Struct_y[this] + step * Sin(s__CrocodileSpells___CrocodileR_Struct_a[this])
                    set s__CrocodileSpells___CrocodileR_Struct_sandDistance[this]=s__CrocodileSpells___CrocodileR_Struct_sandDistance[this] + step
                    set sandSpacing=RMaxBJ(CrocodileSand_MinDistance, CrocodileR_SandSpacing)
                    loop
                        exitwhen s__CrocodileSpells___CrocodileR_Struct_sandDistance[this] + 0.001 < sandSpacing
                        set trailOffset=s__CrocodileSpells___CrocodileR_Struct_sandDistance[this] - sandSpacing
                        // Fresh patches only: shared spacing check skips existing sand.
                        call s__CrocodileSpells___CrocodileSand_Struct_CrocodileSand_Start(s__CrocodileSpells___CrocodileR_Struct_c[this] , s__CrocodileSpells___CrocodileR_Struct_x[this] - trailOffset * Cos(s__CrocodileSpells___CrocodileR_Struct_a[this]) , s__CrocodileSpells___CrocodileR_Struct_y[this] - trailOffset * Sin(s__CrocodileSpells___CrocodileR_Struct_a[this]) , GetRandomReal(350, 425) , true)
                        set s__CrocodileSpells___CrocodileR_Struct_sandDistance[this]=s__CrocodileSpells___CrocodileR_Struct_sandDistance[this] - sandSpacing
                    endloop
                    set s__CrocodileSpells___CrocodileR_Struct_radius[this]=CrocodileR_StartAoe + ( CrocodileR_EndAoe - CrocodileR_StartAoe ) * RMinBJ(1.0, s__CrocodileSpells___CrocodileR_Struct_r[this] / RMaxBJ(s__CrocodileSpells___CrocodileR_Struct_rmax[this], CrocodileSpells___CrocodilePeriod))
                    call BlzSetSpecialEffectX(s__CrocodileSpells___CrocodileR_Struct_e[this], s__CrocodileSpells___CrocodileR_Struct_x[this])
                    call BlzSetSpecialEffectY(s__CrocodileSpells___CrocodileR_Struct_e[this], s__CrocodileSpells___CrocodileR_Struct_y[this])
                    call BlzSetSpecialEffectX(s__CrocodileSpells___CrocodileR_Struct_e2[this], s__CrocodileSpells___CrocodileR_Struct_x[this])
                    call BlzSetSpecialEffectY(s__CrocodileSpells___CrocodileR_Struct_e2[this], s__CrocodileSpells___CrocodileR_Struct_y[this])
                    call BlzSetSpecialEffectScale(s__CrocodileSpells___CrocodileR_Struct_e[this], CrocodileR_StartScale + ( CrocodileR_EndScale - CrocodileR_StartScale ) * RMinBJ(1.0, s__CrocodileSpells___CrocodileR_Struct_r[this] / RMaxBJ(s__CrocodileSpells___CrocodileR_Struct_rmax[this], CrocodileSpells___CrocodilePeriod)))
                    call GroupEnumUnitsInRange(s__CrocodileSpells___CrocodileR_Struct_g[this], s__CrocodileSpells___CrocodileR_Struct_x[this], s__CrocodileSpells___CrocodileR_Struct_y[this], s__CrocodileSpells___CrocodileR_Struct_radius[this], NoDecor_Cond)
                    loop
                        set u=FirstOfGroup(s__CrocodileSpells___CrocodileR_Struct_g[this])
                        exitwhen u == null
                        call GroupRemoveUnit(s__CrocodileSpells___CrocodileR_Struct_g[this], u)
                        if SpellBool(u) and IsUnitEnemy(u, GetOwningPlayer(s__CrocodileSpells___CrocodileR_Struct_c[this])) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) and not (LoadInteger(hs, GetHandleId((u)), StringHash("cc protection owners")) > 0) and not IsUnitPaused(u) and LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(u), CrocodileSpells___CrocodileR_TargetKey) == 0 then // INLINED!!
                            set target=s__CrocodileSpells___CrocodileR_Target__allocate()
                            set s__CrocodileSpells___CrocodileR_Target_u[target]=u
                            set s__CrocodileSpells___CrocodileR_Target_owner[target]=this
                            set s__CrocodileSpells___CrocodileR_Target_height[target]=GetUnitFlyHeight(u)
                            set s__CrocodileSpells___CrocodileR_Target_a[target]=Atan2(GetUnitY(u) - s__CrocodileSpells___CrocodileR_Struct_y[this], GetUnitX(u) - s__CrocodileSpells___CrocodileR_Struct_x[this])
                            set s__CrocodileSpells___CrocodileR_Target_lift[target]=0.0
                            set s__CrocodileSpells___CrocodileR_Target_previous[target]=0
                            set s__CrocodileSpells___CrocodileR_Target_next[target]=s__CrocodileSpells___CrocodileR_Struct_captured[this]
                            if s__CrocodileSpells___CrocodileR_Struct_captured[this] != 0 then
                                set other=s__CrocodileSpells___CrocodileR_Struct_captured[this]
                                set s__CrocodileSpells___CrocodileR_Target_previous[other]=target
                            endif
                            set s__CrocodileSpells___CrocodileR_Struct_captured[this]=target
                            call SaveInteger(CrocodileSpells___CrocodileTable, GetHandleId(u), CrocodileSpells___CrocodileR_TargetKey, target)
                            call BlzPauseUnitEx(u, true)
                        endif
                    endloop
                    // Iterate saved records independently of native group membership.
                    set target=s__CrocodileSpells___CrocodileR_Struct_captured[this]
                    loop
                        exitwhen target == 0 or s__CrocodileSpells___CrocodileR_Struct_endNow[this]
                        set next=s__CrocodileSpells___CrocodileR_Target_next[target]
                        set u=s__CrocodileSpells___CrocodileR_Target_u[target]
                        if GetUnitTypeId(u) == 0 or not SpellBool(u) or not IsUnitEnemy(u, GetOwningPlayer(s__CrocodileSpells___CrocodileR_Struct_c[this])) or (LoadInteger(hs, GetHandleId((u)), StringHash("cc protection owners")) > 0) or SR3(u , s__CrocodileSpells___CrocodileR_Struct_x[this] , s__CrocodileSpells___CrocodileR_Struct_y[this]) > s__CrocodileSpells___CrocodileR_Struct_radius[this] + step then // INLINED!!
                            call s__CrocodileSpells___CrocodileR_Struct_CrocodileR_Release(this,u)
                        else
                            set angle=s__CrocodileSpells___CrocodileR_Target_a[target] + CrocodileR_OrbitSpeed * bj_DEGTORAD * CrocodileSpells___CrocodilePeriod
                            set s__CrocodileSpells___CrocodileR_Target_a[target]=angle
                            set s__CrocodileSpells___CrocodileR_Target_lift[target]=RMinBJ(CrocodileR_Height, s__CrocodileSpells___CrocodileR_Target_lift[target] + CrocodileR_LiftSpeed * CrocodileSpells___CrocodilePeriod)
                            call SetFly(u , s__CrocodileSpells___CrocodileR_Target_height[target] + s__CrocodileSpells___CrocodileR_Target_lift[target] * ( 0.85 + 0.15 * Sin(angle) ))
                            call SetUnitX(u, s__CrocodileSpells___CrocodileR_Struct_x[this] + s__CrocodileSpells___CrocodileR_Struct_radius[this] * CrocodileR_OrbitRadius * Cos(angle))
                            call SetUnitY(u, s__CrocodileSpells___CrocodileR_Struct_y[this] + s__CrocodileSpells___CrocodileR_Struct_radius[this] * CrocodileR_OrbitRadius * Sin(angle))
                            if s__CrocodileSpells___CrocodileR_Struct_pulse[this] + 0.001 >= 1.0 then
                                call dmgphys(s__CrocodileSpells___CrocodileR_Struct_c[this] , u , s__CrocodileSpells___CrocodileR_Struct_dmg[this])
                            endif
                        endif
                        set target=next
                    endloop
                    if s__CrocodileSpells___CrocodileR_Struct_pulse[this] + 0.001 >= 1.0 then
                        set s__CrocodileSpells___CrocodileR_Struct_pulse[this]=s__CrocodileSpells___CrocodileR_Struct_pulse[this] - 1.0
                    endif
                endif
                if s__CrocodileSpells___CrocodileR_Struct_endNow[this] or s__CrocodileSpells___CrocodileR_Struct_r[this] + 0.001 >= s__CrocodileSpells___CrocodileR_Struct_rmax[this] or not SpellBoolCaster(s__CrocodileSpells___CrocodileR_Struct_c[this]) or LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(s__CrocodileSpells___CrocodileR_Struct_c[this]), CrocodileSpells___CrocodileCore_DataKey) == 0 then
                    if s__CrocodileSpells___CrocodileR_Struct_castPauseHeld[this] then
                        set s__CrocodileSpells___CrocodileR_Struct_castPauseHeld[this]=false
                        call StopSpellUnit2(s__CrocodileSpells___CrocodileR_Struct_c[this])
                    endif
                    call s__CrocodileSpells___CrocodileR_Struct_CrocodileR_ReleaseAll(this)
                    call DestroyEffect(s__CrocodileSpells___CrocodileR_Struct_e[this])
                    call DestroyEffect(s__CrocodileSpells___CrocodileR_Struct_e2[this])
                    call DestroyGroup(s__CrocodileSpells___CrocodileR_Struct_g[this])
                    set s__CrocodileSpells___CrocodileR_Struct_c[this]=null
                    set s__CrocodileSpells___CrocodileR_Struct_e[this]=null
                    set s__CrocodileSpells___CrocodileR_Struct_e2[this]=null
                    set s__CrocodileSpells___CrocodileR_Struct_g[this]=null
                    set s__CrocodileSpells___CrocodileR_Struct_m[i]=s__CrocodileSpells___CrocodileR_Struct_m[s__CrocodileSpells___CrocodileR_Struct_MUI]
                    set s__CrocodileSpells___CrocodileR_Struct_MUI=s__CrocodileSpells___CrocodileR_Struct_MUI - 1
                    call s__CrocodileSpells___CrocodileR_Struct_deallocate(this)
                    if s__CrocodileSpells___CrocodileR_Struct_MUI == - 1 then
                        call GearTimer03Release()
                    endif
                else
                    set i=i + 1
                endif
            endloop
            set u=null
        endfunction

        function s__CrocodileSpells___CrocodileR_Struct_CrocodileR_Begin takes unit NewC,real NewX,real NewY returns boolean
            local integer this
            if LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(NewC), CrocodileSpells___CrocodileCore_DataKey) == 0 or IsUnitIllusion(NewC) or not SpellBoolCaster(NewC) or LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(NewC), CrocodileSpells___CrocodileT_DataKey) != 0 or CrocodileR_Duration <= 0.0 then
                return false
            endif
            set this=s__CrocodileSpells___CrocodileR_Struct__allocate()
            set s__CrocodileSpells___CrocodileR_Struct_MUI=s__CrocodileSpells___CrocodileR_Struct_MUI + 1
            set s__CrocodileSpells___CrocodileR_Struct_m[s__CrocodileSpells___CrocodileR_Struct_MUI]=this
            if s__CrocodileSpells___CrocodileR_Struct_MUI == 0 then
                call GearTimer03Acquire()
            endif
            set s__CrocodileSpells___CrocodileR_Struct_c[this]=NewC
            set s__CrocodileSpells___CrocodileR_Struct_x[this]=GetUnitX(s__CrocodileSpells___CrocodileR_Struct_c[this])
            set s__CrocodileSpells___CrocodileR_Struct_y[this]=GetUnitY(s__CrocodileSpells___CrocodileR_Struct_c[this])
            set s__CrocodileSpells___CrocodileR_Struct_a[this]=Atan2(NewY - s__CrocodileSpells___CrocodileR_Struct_y[this], NewX - s__CrocodileSpells___CrocodileR_Struct_x[this])
            if SR3(s__CrocodileSpells___CrocodileR_Struct_c[this] , NewX , NewY) < 1.0 then
                set s__CrocodileSpells___CrocodileR_Struct_a[this]=GetUnitFacing(s__CrocodileSpells___CrocodileR_Struct_c[this]) * bj_DEGTORAD
            endif
            set s__CrocodileSpells___CrocodileR_Struct_r[this]=0.0
            set s__CrocodileSpells___CrocodileR_Struct_rmax[this]=CrocodileR_Duration
            set s__CrocodileSpells___CrocodileR_Struct_pulse[this]=0.0
            set s__CrocodileSpells___CrocodileR_Struct_sandDistance[this]=0.0
            set s__CrocodileSpells___CrocodileR_Struct_radius[this]=CrocodileR_StartAoe
            set s__CrocodileSpells___CrocodileR_Struct_dmg[this]=GetHeroAgi(s__CrocodileSpells___CrocodileR_Struct_c[this], true) * CrocodileR_DamageAgi
            set s__CrocodileSpells___CrocodileR_Struct_g[this]=CreateGroup()
            set s__CrocodileSpells___CrocodileR_Struct_captured[this]=0
            set s__CrocodileSpells___CrocodileR_Struct_castPauseHeld[this]=true
            call StartSpellUnit2(s__CrocodileSpells___CrocodileR_Struct_c[this])
            set s__CrocodileSpells___CrocodileR_Struct_endNow[this]=false
//---------------- R effect --------------------------------------------------
            set s__CrocodileSpells___CrocodileR_Struct_e[this]=EffectSpawn("war3mapImported\\wos_file00000867.mdl" , s__CrocodileSpells___CrocodileR_Struct_x[this] , s__CrocodileSpells___CrocodileR_Struct_y[this] , 0 , 1 , CrocodileR_StartScale , 0)
            set s__CrocodileSpells___CrocodileR_Struct_e2[this]=EffectSpawn("war3mapImported\\wos_file00000862.mdl" , s__CrocodileSpells___CrocodileR_Struct_x[this] , s__CrocodileSpells___CrocodileR_Struct_y[this] , 0 , 2 , CrocodileR_StartScale , 0)
            call SetUnitAnimationByIndex(s__CrocodileSpells___CrocodileR_Struct_c[this], CrocodileR_Animation)
            
            call MakeSound("war3mapImported\\Hero_Crocodile_R_2")
            call MakeSound("war3mapImported\\Hero_Crocodile_R2")
            call s__GearSystems2___KS_DelayedSound_NextSound_Start(("war3mapImported\\Hero_Crocodile_R6" ) , (( 0.8)*1.0)) // INLINED!!
            return true
        endfunction

//================================ Crocodile T - Ground Secco ========================================


        // Shared by timeout, T2, death and removal. Balanced enhanced pause.
        function s__CrocodileSpells___CrocodileT_Struct_CrocodileT_Finish takes unit NewC returns nothing
            local integer this= LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(NewC), CrocodileSpells___CrocodileT_DataKey)
            if this == 0 then
                return
            endif
            set s__CrocodileSpells___CrocodileT_Struct_endNow[this]=true
            call RemoveSavedInteger(CrocodileSpells___CrocodileTable, GetHandleId(s__CrocodileSpells___CrocodileT_Struct_c[this]), CrocodileSpells___CrocodileT_DataKey)
            call StopSpellUnit2(s__CrocodileSpells___CrocodileT_Struct_c[this])
            call GearCCProtect(s__CrocodileSpells___CrocodileT_Struct_c[this] , false)





            call UnitRemoveAbility(s__CrocodileSpells___CrocodileT_Struct_c[this], CrocodileT2_ID)
            call SetUnitAnimation(s__CrocodileSpells___CrocodileT_Struct_c[this], "stand")
        endfunction

        function s__CrocodileSpells___CrocodileT_Struct_Loop_CrocodileT takes nothing returns nothing
            local integer this
            local integer i= 0
            local integer j
            local integer points
            local real a
            local unit u
            loop
                exitwhen i > s__CrocodileSpells___CrocodileT_Struct_MUI
                set this=s__CrocodileSpells___CrocodileT_Struct_m[i]
                set s__CrocodileSpells___CrocodileT_Struct_r[this]=RoundReal(s__CrocodileSpells___CrocodileT_Struct_r[this] + CrocodileSpells___CrocodilePeriod , 3)
                set s__CrocodileSpells___CrocodileT_Struct_pulse[this]=s__CrocodileSpells___CrocodileT_Struct_pulse[this] + CrocodileSpells___CrocodilePeriod
                if not s__CrocodileSpells___CrocodileT_Struct_endNow[this] and SpellBoolCaster(s__CrocodileSpells___CrocodileT_Struct_c[this]) and LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(s__CrocodileSpells___CrocodileT_Struct_c[this]), CrocodileSpells___CrocodileCore_DataKey) != 0 then
                    set s__CrocodileSpells___CrocodileT_Struct_radius[this]=CrocodileT_MaxAoe * RMinBJ(1.0, s__CrocodileSpells___CrocodileT_Struct_r[this] / RMaxBJ(CrocodileSpells___CrocodilePeriod, CrocodileT_SpreadTime))
                    // Materialize each ring once; at most five rings for the default area.
                    loop
                        exitwhen s__CrocodileSpells___CrocodileT_Struct_nextRing[this] + CrocodileSand_Radius > s__CrocodileSpells___CrocodileT_Struct_radius[this] or s__CrocodileSpells___CrocodileT_Struct_nextRing[this] + CrocodileSand_Radius > CrocodileT_MaxAoe
                        set points=R2I(2 * bj_PI * s__CrocodileSpells___CrocodileT_Struct_nextRing[this] / CrocodileT_PatchSpacing) + 1
                        set j=0
                        loop
                            exitwhen j >= points
                            set a=2 * bj_PI * j / points
                            call s__CrocodileSpells___CrocodileSand_Struct_CrocodileSand_Start(s__CrocodileSpells___CrocodileT_Struct_c[this] , s__CrocodileSpells___CrocodileT_Struct_x[this] + s__CrocodileSpells___CrocodileT_Struct_nextRing[this] * Cos(a) , s__CrocodileSpells___CrocodileT_Struct_y[this] + s__CrocodileSpells___CrocodileT_Struct_nextRing[this] * Sin(a) , CrocodileSand_Radius , false)
                            set j=j + 1
                        endloop
                        set s__CrocodileSpells___CrocodileT_Struct_nextRing[this]=s__CrocodileSpells___CrocodileT_Struct_nextRing[this] + CrocodileT_PatchSpacing
                    endloop
                    call BlzSetSpecialEffectScale(s__CrocodileSpells___CrocodileT_Struct_e[this], s__CrocodileSpells___CrocodileT_Struct_radius[this] / 250.0)
                    if s__CrocodileSpells___CrocodileT_Struct_r[this] + 0.001 >= CrocodileT2_Unlock and GetUnitAbilityLevel(s__CrocodileSpells___CrocodileT_Struct_c[this], CrocodileT2_ID) == 0 then
                        call UnitAddAbility(s__CrocodileSpells___CrocodileT_Struct_c[this], CrocodileT2_ID)
                        call BlzEndUnitAbilityCooldown(s__CrocodileSpells___CrocodileT_Struct_c[this], CrocodileT2_ID)
                    endif
                    if s__CrocodileSpells___CrocodileT_Struct_pulse[this] + 0.001 >= 1.0 then
                        set s__CrocodileSpells___CrocodileT_Struct_pulse[this]=s__CrocodileSpells___CrocodileT_Struct_pulse[this] - 1.0
                        call GroupEnumUnitsInRange(s__CrocodileSpells___CrocodileT_Struct_g[this], s__CrocodileSpells___CrocodileT_Struct_x[this], s__CrocodileSpells___CrocodileT_Struct_y[this], s__CrocodileSpells___CrocodileT_Struct_radius[this], NoDecor_Cond)
                        loop
                            set u=FirstOfGroup(s__CrocodileSpells___CrocodileT_Struct_g[this])
                            exitwhen u == null
                            call GroupRemoveUnit(s__CrocodileSpells___CrocodileT_Struct_g[this], u)
                            if SpellBool(u) and IsUnitEnemy(u, GetOwningPlayer(s__CrocodileSpells___CrocodileT_Struct_c[this])) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) then
                                call SetMpCurrent(u , - CrocodileT_ManaDrain * GetUnitState(u, UNIT_STATE_MAX_MANA))
                            endif
                        endloop
                    endif
                endif
                if s__CrocodileSpells___CrocodileT_Struct_endNow[this] or s__CrocodileSpells___CrocodileT_Struct_r[this] + 0.001 >= s__CrocodileSpells___CrocodileT_Struct_rmax[this] or not SpellBoolCaster(s__CrocodileSpells___CrocodileT_Struct_c[this]) or LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(s__CrocodileSpells___CrocodileT_Struct_c[this]), CrocodileSpells___CrocodileCore_DataKey) == 0 then
                    if LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(s__CrocodileSpells___CrocodileT_Struct_c[this]), CrocodileSpells___CrocodileT_DataKey) == this then
                        call s__CrocodileSpells___CrocodileT_Struct_CrocodileT_Finish(s__CrocodileSpells___CrocodileT_Struct_c[this])
                    endif
                    call DestroyEffect(s__CrocodileSpells___CrocodileT_Struct_e[this])
                    call DestroyGroup(s__CrocodileSpells___CrocodileT_Struct_g[this])
                    set s__CrocodileSpells___CrocodileT_Struct_c[this]=null
                    set s__CrocodileSpells___CrocodileT_Struct_e[this]=null
                    set s__CrocodileSpells___CrocodileT_Struct_e2[this]=null
                    set s__CrocodileSpells___CrocodileT_Struct_g[this]=null
                    set s__CrocodileSpells___CrocodileT_Struct_m[i]=s__CrocodileSpells___CrocodileT_Struct_m[s__CrocodileSpells___CrocodileT_Struct_MUI]
                    set s__CrocodileSpells___CrocodileT_Struct_MUI=s__CrocodileSpells___CrocodileT_Struct_MUI - 1
                    call s__CrocodileSpells___CrocodileT_Struct_deallocate(this)
                    if s__CrocodileSpells___CrocodileT_Struct_MUI == - 1 then
                        call GearTimer03Release()
                    endif
                else
                    set i=i + 1
                endif
            endloop
            set u=null
        endfunction

        function s__CrocodileSpells___CrocodileT_Struct_CrocodileT_Begin takes unit NewC returns boolean
            local integer this
            local integer dash= LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(NewC), CrocodileSpells___CrocodileE_DataKey)
            if LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(NewC), CrocodileSpells___CrocodileCore_DataKey) == 0 or IsUnitIllusion(NewC) or not SpellBoolCaster(NewC) or LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(NewC), CrocodileSpells___CrocodileT_DataKey) != 0 then
                return false
            endif
            set this=s__CrocodileSpells___CrocodileT_Struct__allocate()
            set s__CrocodileSpells___CrocodileT_Struct_MUI=s__CrocodileSpells___CrocodileT_Struct_MUI + 1
            set s__CrocodileSpells___CrocodileT_Struct_m[s__CrocodileSpells___CrocodileT_Struct_MUI]=this
            if s__CrocodileSpells___CrocodileT_Struct_MUI == 0 then
                call GearTimer03Acquire()
            endif
            set s__CrocodileSpells___CrocodileT_Struct_c[this]=NewC
            set s__CrocodileSpells___CrocodileT_Struct_x[this]=GetUnitX(s__CrocodileSpells___CrocodileT_Struct_c[this])
            set s__CrocodileSpells___CrocodileT_Struct_y[this]=GetUnitY(s__CrocodileSpells___CrocodileT_Struct_c[this])
            set s__CrocodileSpells___CrocodileT_Struct_radius[this]=0.0
            set s__CrocodileSpells___CrocodileT_Struct_nextRing[this]=CrocodileT_PatchSpacing
            set s__CrocodileSpells___CrocodileT_Struct_r[this]=0.0
            set s__CrocodileSpells___CrocodileT_Struct_rmax[this]=CrocodileT_Duration
            set s__CrocodileSpells___CrocodileT_Struct_pulse[this]=0.0
            set s__CrocodileSpells___CrocodileT_Struct_endNow[this]=false
            set s__CrocodileSpells___CrocodileT_Struct_g[this]=CreateGroup()
//---------------- T effect --------------------------------------------------
            set s__CrocodileSpells___CrocodileT_Struct_e[this]=EffectSpawn("Abilities\\Spells\\Orc\\EarthQuake\\EarthQuakeTarget.mdl" , s__CrocodileSpells___CrocodileT_Struct_x[this] , s__CrocodileSpells___CrocodileT_Struct_y[this] , 0 , 0.5 , 0.1 , 0)
            set s__CrocodileSpells___CrocodileT_Struct_e2[this]=null
            call s__CrocodileSpells___CrocodileSand_Struct_CrocodileSand_Start(s__CrocodileSpells___CrocodileT_Struct_c[this] , s__CrocodileSpells___CrocodileT_Struct_x[this] , s__CrocodileSpells___CrocodileT_Struct_y[this] , CrocodileSand_Radius , false)
            call SaveInteger(CrocodileSpells___CrocodileTable, GetHandleId(s__CrocodileSpells___CrocodileT_Struct_c[this]), CrocodileSpells___CrocodileT_DataKey, this)
            if dash != 0 then
                set s__CrocodileSpells___CrocodileE_Struct_cancelDash[dash]=true
                if s__CrocodileSpells___CrocodileE_Struct_castPauseHeld[dash] then
                    set s__CrocodileSpells___CrocodileE_Struct_castPauseHeld[dash]=false
                    call StopSpellUnit2(s__CrocodileSpells___CrocodileT_Struct_c[this])
                endif
            endif
            call GearCCProtect(s__CrocodileSpells___CrocodileT_Struct_c[this] , true)
            call DebuffClear(s__CrocodileSpells___CrocodileT_Struct_c[this])
            call IssueImmediateOrder(s__CrocodileSpells___CrocodileT_Struct_c[this], "stop")
            call StartSpellUnit2(s__CrocodileSpells___CrocodileT_Struct_c[this])





            call SetUnitAnimationByIndex(s__CrocodileSpells___CrocodileT_Struct_c[this], CrocodileT_Animation)
            call MakeSound("war3mapImported\\Hero_Crocodile_T 1")
            return true
        endfunction



//================================ Crocodile T2 - Ground Death ========================================
        // Immediate detonation needs local groups, not a timer/allocated instance.
        function s__CrocodileSpells___CrocodileT2_Struct_CrocodileT2_Begin takes unit c returns boolean
            local integer channel= LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(c), CrocodileSpells___CrocodileT_DataKey)
            local integer sand
            local integer i= 0
            local unit u
            local effect e
            local group g
            local group g2
            if channel == 0 or s__CrocodileSpells___CrocodileT_Struct_endNow[channel] or s__CrocodileSpells___CrocodileT_Struct_r[channel] + 0.001 < CrocodileT2_Unlock or not SpellBoolCaster(c) then
                return false
            endif
            set g=CreateGroup()
            set g2=CreateGroup()
            loop
                exitwhen i > s__CrocodileSpells___CrocodileSand_Struct_MUI
                set sand=s__CrocodileSpells___CrocodileSand_Struct_m[i]
                if s__CrocodileSpells___CrocodileSand_Struct_c[sand] == c and not s__CrocodileSpells___CrocodileSand_Struct_endNow[sand] then
                    call GroupEnumUnitsInRange(g, s__CrocodileSpells___CrocodileSand_Struct_x[sand], s__CrocodileSpells___CrocodileSand_Struct_y[sand], s__CrocodileSpells___CrocodileSand_Struct_radius[sand], NoDecor_Cond)
                    loop
                        set u=FirstOfGroup(g)
                        exitwhen u == null
                        call GroupRemoveUnit(g, u)
                        if SpellBool(u) and IsUnitEnemy(u, GetOwningPlayer(c)) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) then
                            call GroupAddUnit(g2, u)
                        endif
                    endloop
//---------------- T2 sand explosions ---------------------------------------
                    set e=EffectSpawn("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl" , s__CrocodileSpells___CrocodileSand_Struct_x[sand] , s__CrocodileSpells___CrocodileSand_Struct_y[sand] , 0 , 1 , s__CrocodileSpells___CrocodileSand_Struct_radius[sand] / 150.0 , 0)
                    call s__GearSystems2___KS_RemoveEffect_MyRemoveEff_Start((e ) , (( 1.0)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
                    set s__CrocodileSpells___CrocodileSand_Struct_endNow[sand]=true
                endif
                set i=i + 1
            endloop
            call s__CrocodileSpells___CrocodileT_Struct_CrocodileT_Finish(c)
            loop
                set u=FirstOfGroup(g2)
                exitwhen u == null
                call GroupRemoveUnit(g2, u)
                call dmgphys(c , u , GetHeroAgi(c, true) * CrocodileT2_DamageAgi)
            endloop
            call DestroyGroup(g)
            call DestroyGroup(g2)
            set g=null
            set g2=null
            set e=null
            set u=null
            return true
        endfunction

//================================ Crocodile F projectile ========================================

        function s__CrocodileSpells___CrocodileF_Projectile_Loop_CrocodileF_Projectile takes nothing returns nothing
            local integer this
            local integer i= 0
            local unit u
            local real step
            local real px
            local real py
            local real projection
            loop
                exitwhen i > s__CrocodileSpells___CrocodileF_Projectile_MUI
                set this=s__CrocodileSpells___CrocodileF_Projectile_m[i]
                if SpellBoolCaster(s__CrocodileSpells___CrocodileF_Projectile_c[this]) and LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(s__CrocodileSpells___CrocodileF_Projectile_c[this]), CrocodileSpells___CrocodileCore_DataKey) != 0 then
                    set step=RMinBJ(CrocodileF_ProjectileSpeed * CrocodileSpells___CrocodilePeriod, CrocodileF_Range - s__CrocodileSpells___CrocodileF_Projectile_distance[this])
                    call GroupEnumUnitsInRange(s__CrocodileSpells___CrocodileF_Projectile_g[this], s__CrocodileSpells___CrocodileF_Projectile_x[this] + step * 0.5 * Cos(s__CrocodileSpells___CrocodileF_Projectile_a[this]), s__CrocodileSpells___CrocodileF_Projectile_y[this] + step * 0.5 * Sin(s__CrocodileSpells___CrocodileF_Projectile_a[this]), CrocodileF_ProjectileAoe + step * 0.5, NoDecor_Cond)
                    loop
                        set u=FirstOfGroup(s__CrocodileSpells___CrocodileF_Projectile_g[this])
                        exitwhen u == null
                        call GroupRemoveUnit(s__CrocodileSpells___CrocodileF_Projectile_g[this], u)
                        set projection=RMaxBJ(0.0, RMinBJ(step, ( GetUnitX(u) - s__CrocodileSpells___CrocodileF_Projectile_x[this] ) * Cos(s__CrocodileSpells___CrocodileF_Projectile_a[this]) + ( GetUnitY(u) - s__CrocodileSpells___CrocodileF_Projectile_y[this] ) * Sin(s__CrocodileSpells___CrocodileF_Projectile_a[this])))
                        set px=s__CrocodileSpells___CrocodileF_Projectile_x[this] + projection * Cos(s__CrocodileSpells___CrocodileF_Projectile_a[this])
                        set py=s__CrocodileSpells___CrocodileF_Projectile_y[this] + projection * Sin(s__CrocodileSpells___CrocodileF_Projectile_a[this])
                        if SpellBool(u) and IsUnitEnemy(u, GetOwningPlayer(s__CrocodileSpells___CrocodileF_Projectile_c[this])) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) and not IsUnitInGroup(u, s__CrocodileSpells___CrocodileF_Projectile_g2[this]) and SR3(u , px , py) <= CrocodileF_ProjectileAoe then
                            call GroupAddUnit(s__CrocodileSpells___CrocodileF_Projectile_g2[this], u)
                            call dmgphys(s__CrocodileSpells___CrocodileF_Projectile_c[this] , u , s__CrocodileSpells___CrocodileF_Projectile_dmg[this])
                        endif
                    endloop
                    set s__CrocodileSpells___CrocodileF_Projectile_distance[this]=s__CrocodileSpells___CrocodileF_Projectile_distance[this] + step
                    set s__CrocodileSpells___CrocodileF_Projectile_x[this]=s__CrocodileSpells___CrocodileF_Projectile_x[this] + step * Cos(s__CrocodileSpells___CrocodileF_Projectile_a[this])
                    set s__CrocodileSpells___CrocodileF_Projectile_y[this]=s__CrocodileSpells___CrocodileF_Projectile_y[this] + step * Sin(s__CrocodileSpells___CrocodileF_Projectile_a[this])
                    call BlzSetSpecialEffectX(s__CrocodileSpells___CrocodileF_Projectile_e[this], s__CrocodileSpells___CrocodileF_Projectile_x[this])
                    call BlzSetSpecialEffectY(s__CrocodileSpells___CrocodileF_Projectile_e[this], s__CrocodileSpells___CrocodileF_Projectile_y[this])
                endif
                if s__CrocodileSpells___CrocodileF_Projectile_distance[this] >= CrocodileF_Range or not SpellBoolCaster(s__CrocodileSpells___CrocodileF_Projectile_c[this]) or LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(s__CrocodileSpells___CrocodileF_Projectile_c[this]), CrocodileSpells___CrocodileCore_DataKey) == 0 then
                    call DestroyEffect(s__CrocodileSpells___CrocodileF_Projectile_e[this])
                    call DestroyGroup(s__CrocodileSpells___CrocodileF_Projectile_g[this])
                    call DestroyGroup(s__CrocodileSpells___CrocodileF_Projectile_g2[this])
                    set s__CrocodileSpells___CrocodileF_Projectile_c[this]=null
                    set s__CrocodileSpells___CrocodileF_Projectile_e[this]=null
                    set s__CrocodileSpells___CrocodileF_Projectile_g[this]=null
                    set s__CrocodileSpells___CrocodileF_Projectile_g2[this]=null
                    set s__CrocodileSpells___CrocodileF_Projectile_m[i]=s__CrocodileSpells___CrocodileF_Projectile_m[s__CrocodileSpells___CrocodileF_Projectile_MUI]
                    set s__CrocodileSpells___CrocodileF_Projectile_MUI=s__CrocodileSpells___CrocodileF_Projectile_MUI - 1
                    call s__CrocodileSpells___CrocodileF_Projectile_deallocate(this)
                    if s__CrocodileSpells___CrocodileF_Projectile_MUI == - 1 then
                        call GearTimer03Release()
                    endif
                else
                    set i=i + 1
                endif
            endloop
            set u=null
        endfunction

        function s__CrocodileSpells___CrocodileF_Projectile_CrocodileF_Projectile_Start takes unit NewC,unit target returns nothing
            local integer this= s__CrocodileSpells___CrocodileF_Projectile__allocate()
            set s__CrocodileSpells___CrocodileF_Projectile_MUI=s__CrocodileSpells___CrocodileF_Projectile_MUI + 1
            set s__CrocodileSpells___CrocodileF_Projectile_m[s__CrocodileSpells___CrocodileF_Projectile_MUI]=this
            if s__CrocodileSpells___CrocodileF_Projectile_MUI == 0 then
                call GearTimer03Acquire()
            endif
            set s__CrocodileSpells___CrocodileF_Projectile_c[this]=NewC
            set s__CrocodileSpells___CrocodileF_Projectile_x[this]=GetUnitX(s__CrocodileSpells___CrocodileF_Projectile_c[this])
            set s__CrocodileSpells___CrocodileF_Projectile_y[this]=GetUnitY(s__CrocodileSpells___CrocodileF_Projectile_c[this])
            set s__CrocodileSpells___CrocodileF_Projectile_a[this]=Atan2(GetUnitY(target) - s__CrocodileSpells___CrocodileF_Projectile_y[this], GetUnitX(target) - s__CrocodileSpells___CrocodileF_Projectile_x[this])
            if SR3(target , s__CrocodileSpells___CrocodileF_Projectile_x[this] , s__CrocodileSpells___CrocodileF_Projectile_y[this]) < 1.0 then
                set s__CrocodileSpells___CrocodileF_Projectile_a[this]=GetUnitFacing(s__CrocodileSpells___CrocodileF_Projectile_c[this]) * bj_DEGTORAD
            endif
            set s__CrocodileSpells___CrocodileF_Projectile_distance[this]=0.0
            set s__CrocodileSpells___CrocodileF_Projectile_dmg[this]=GetHeroAgi(s__CrocodileSpells___CrocodileF_Projectile_c[this], true) * CrocodileF_DamageAgi
            set s__CrocodileSpells___CrocodileF_Projectile_g[this]=CreateGroup()
            set s__CrocodileSpells___CrocodileF_Projectile_g2[this]=CreateGroup()
            set s__CrocodileSpells___CrocodileF_Projectile_e[this]=EffectSpawn("war3mapImported\\wos_File00001240.mdl" , s__CrocodileSpells___CrocodileF_Projectile_x[this] , s__CrocodileSpells___CrocodileF_Projectile_y[this] , s__CrocodileSpells___CrocodileF_Projectile_a[this] * bj_RADTODEG , 1 , CrocodileQ_EffectScale , CrocodileQ_EffectHeight)
        endfunction

//================================ Crocodile F - La Spada ========================================

        function s__CrocodileSpells___CrocodileF_Struct_CrocodileF_SetEnhanced takes integer this,boolean enabled returns nothing
            local ability a
            local real current
            if enabled == s__CrocodileSpells___CrocodileF_Struct_enhanced[this] then
                return
            endif
            set s__CrocodileSpells___CrocodileF_Struct_enhanced[this]=enabled
            if enabled then
                // Native item bonus follows WoS's ability-based stat modifiers.
                set s__CrocodileSpells___CrocodileF_Struct_ownsAS[this]=GetUnitAbilityLevel(s__CrocodileSpells___CrocodileF_Struct_c[this], 'AIsx') == 0
                if s__CrocodileSpells___CrocodileF_Struct_ownsAS[this] then
                    call UnitAddAbility(s__CrocodileSpells___CrocodileF_Struct_c[this], 'AIsx')
                endif
                set a=BlzGetUnitAbility(s__CrocodileSpells___CrocodileF_Struct_c[this], 'AIsx')
                set s__CrocodileSpells___CrocodileF_Struct_savedAS[this]=BlzGetAbilityRealLevelField(a, ABILITY_RLF_ATTACK_SPEED_INCREASE_ISX1, 0)
                if s__CrocodileSpells___CrocodileF_Struct_ownsAS[this] then
                    set current=CrocodileF_AttackSpeed
                else
                    set current=s__CrocodileSpells___CrocodileF_Struct_savedAS[this] + CrocodileF_AttackSpeed
                endif
                call BlzSetAbilityRealLevelField(a, ABILITY_RLF_ATTACK_SPEED_INCREASE_ISX1, 0, current)
                call CrocodileSpells___CrocodileBonus_Refresh(s__CrocodileSpells___CrocodileF_Struct_c[this] , 'AIsx')
                set s__CrocodileSpells___CrocodileF_Struct_attack1Enabled[this]=BlzGetUnitWeaponBooleanField(s__CrocodileSpells___CrocodileF_Struct_c[this], UNIT_WEAPON_BF_ATTACKS_ENABLED, 0)
                set s__CrocodileSpells___CrocodileF_Struct_attack2Enabled[this]=BlzGetUnitWeaponBooleanField(s__CrocodileSpells___CrocodileF_Struct_c[this], UNIT_WEAPON_BF_ATTACKS_ENABLED, 1)
                // Weapon 2 has range 800 in object data; never use the broken range setter.
                call BlzSetUnitWeaponBooleanField(s__CrocodileSpells___CrocodileF_Struct_c[this], UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, false)
                call BlzSetUnitWeaponBooleanField(s__CrocodileSpells___CrocodileF_Struct_c[this], UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, true)
            else
                set a=BlzGetUnitAbility(s__CrocodileSpells___CrocodileF_Struct_c[this], 'AIsx')
                set current=BlzGetAbilityRealLevelField(a, ABILITY_RLF_ATTACK_SPEED_INCREASE_ISX1, 0)
                if s__CrocodileSpells___CrocodileF_Struct_ownsAS[this] and RAbsBJ(current - CrocodileF_AttackSpeed) < 0.001 then
                    call UnitRemoveAbility(s__CrocodileSpells___CrocodileF_Struct_c[this], 'AIsx')
                else
                    if s__CrocodileSpells___CrocodileF_Struct_ownsAS[this] then
                        set current=current - CrocodileF_AttackSpeed + s__CrocodileSpells___CrocodileF_Struct_savedAS[this]
                    else
                        set current=current - CrocodileF_AttackSpeed
                    endif
                    call BlzSetAbilityRealLevelField(a, ABILITY_RLF_ATTACK_SPEED_INCREASE_ISX1, 0, current)
                    call CrocodileSpells___CrocodileBonus_Refresh(s__CrocodileSpells___CrocodileF_Struct_c[this] , 'AIsx')
                endif
                call BlzSetUnitWeaponBooleanField(s__CrocodileSpells___CrocodileF_Struct_c[this], UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, s__CrocodileSpells___CrocodileF_Struct_attack1Enabled[this])
                call BlzSetUnitWeaponBooleanField(s__CrocodileSpells___CrocodileF_Struct_c[this], UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, s__CrocodileSpells___CrocodileF_Struct_attack2Enabled[this])
            endif
            set a=null
        endfunction

        function s__CrocodileSpells___CrocodileF_Struct_CrocodileF_Attack takes unit NewC,unit target,real amount returns real
            local integer this= LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(NewC), CrocodileSpells___CrocodileF_DataKey)
            if this == 0 or LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(NewC), CrocodileSpells___CrocodileCore_DataKey) == 0 or IsUnitIllusion(NewC) or not SpellBoolCaster(NewC) or not IsUnitEnemy(target, GetOwningPlayer(NewC)) or not SpellBool(target) or amount <= 0.0 then
                return amount
            endif
            if s__CrocodileSpells___CrocodileF_Struct_stacks[this] <= 0 or GetUnitAbilityLevel(s__CrocodileSpells___CrocodileF_Struct_c[this], CrocodileF_ID) == 0 or s__CrocodileSpells___CrocodileF_Struct_cooldown[this] > TimerGetElapsed(GearTimer03) or GetUnitAbilityLevel(s__CrocodileSpells___CrocodileF_Struct_c[this], 'Abun') > 0 or CrocodileF_ProjectileSpeed <= 0.0 or CrocodileF_Range <= 0.0 then
                return amount
            endif
            // Elapsed clock fraction prevents a proc just before a tick shortening the CD.
            set s__CrocodileSpells___CrocodileF_Struct_cooldown[this]=CrocodileF_InternalCD + TimerGetElapsed(GearTimer03)
            call s__CrocodileSpells___CrocodileF_Struct_CrocodileF_SetEnhanced(this,false)
            call UnitAddAbility(s__CrocodileSpells___CrocodileF_Struct_c[this], 'Abun')
            set s__CrocodileSpells___CrocodileF_Struct_ownsAttackBlock[this]=true
            set s__CrocodileSpells___CrocodileF_Struct_pendingTarget[this]=target
            // Hold Abun until the shared loop actually emits the projectile.
            return 0.0
        endfunction

        function s__CrocodileSpells___CrocodileF_Struct_Loop_CrocodileF takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__CrocodileSpells___CrocodileF_Struct_MUI
                set this=s__CrocodileSpells___CrocodileF_Struct_m[i]
                set s__CrocodileSpells___CrocodileF_Struct_cooldown[this]=RMaxBJ(0.0, s__CrocodileSpells___CrocodileF_Struct_cooldown[this] - CrocodileSpells___CrocodilePeriod)
                if s__CrocodileSpells___CrocodileF_Struct_ownsAttackBlock[this] then
                    if SpellBoolCaster(s__CrocodileSpells___CrocodileF_Struct_c[this]) and not IsUnitIllusion(s__CrocodileSpells___CrocodileF_Struct_c[this]) and GetUnitAbilityLevel(s__CrocodileSpells___CrocodileF_Struct_c[this], CrocodileF_ID) > 0 and LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(s__CrocodileSpells___CrocodileF_Struct_c[this]), CrocodileSpells___CrocodileCore_DataKey) != 0 and GetUnitTypeId(s__CrocodileSpells___CrocodileF_Struct_pendingTarget[this]) != 0 and SpellBool(s__CrocodileSpells___CrocodileF_Struct_pendingTarget[this]) and IsUnitEnemy(s__CrocodileSpells___CrocodileF_Struct_pendingTarget[this], GetOwningPlayer(s__CrocodileSpells___CrocodileF_Struct_c[this])) then
                        call s__CrocodileSpells___CrocodileF_Projectile_CrocodileF_Projectile_Start(s__CrocodileSpells___CrocodileF_Struct_c[this] , s__CrocodileSpells___CrocodileF_Struct_pendingTarget[this])
                        set s__CrocodileSpells___CrocodileF_Struct_stacks[this]=IMaxBJ(0, s__CrocodileSpells___CrocodileF_Struct_stacks[this] - 1)
                        call TasAbilityChargeBox_SetValue(s__CrocodileSpells___CrocodileF_Struct_c[this] , CrocodileF_ID , I2S(s__CrocodileSpells___CrocodileF_Struct_stacks[this]))
                    endif
                    call UnitRemoveAbility(s__CrocodileSpells___CrocodileF_Struct_c[this], 'Abun')
                    set s__CrocodileSpells___CrocodileF_Struct_ownsAttackBlock[this]=false
                    set s__CrocodileSpells___CrocodileF_Struct_pendingTarget[this]=null
                endif
                if not SpellBoolCaster(s__CrocodileSpells___CrocodileF_Struct_c[this]) or IsUnitIllusion(s__CrocodileSpells___CrocodileF_Struct_c[this]) or GetUnitAbilityLevel(s__CrocodileSpells___CrocodileF_Struct_c[this], CrocodileF_ID) == 0 or LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(s__CrocodileSpells___CrocodileF_Struct_c[this]), CrocodileSpells___CrocodileCore_DataKey) == 0 then
                    if s__CrocodileSpells___CrocodileF_Struct_stacks[this] != 0 then
                        set s__CrocodileSpells___CrocodileF_Struct_stacks[this]=0
                        call TasAbilityChargeBox_SetValue(s__CrocodileSpells___CrocodileF_Struct_c[this] , CrocodileF_ID , "0")
                    endif
                    call s__CrocodileSpells___CrocodileF_Struct_CrocodileF_SetEnhanced(this,false)
                else
                    call s__CrocodileSpells___CrocodileF_Struct_CrocodileF_SetEnhanced(this,s__CrocodileSpells___CrocodileF_Struct_stacks[this] > 0 and s__CrocodileSpells___CrocodileF_Struct_cooldown[this] <= 0.0 and not s__CrocodileSpells___CrocodileF_Struct_ownsAttackBlock[this])
                endif
                if LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(s__CrocodileSpells___CrocodileF_Struct_c[this]), CrocodileSpells___CrocodileCore_DataKey) == 0 then
                    call RemoveSavedInteger(CrocodileSpells___CrocodileTable, GetHandleId(s__CrocodileSpells___CrocodileF_Struct_c[this]), CrocodileSpells___CrocodileF_DataKey)
                    call TasAbilityChargeBox_ClearValue(s__CrocodileSpells___CrocodileF_Struct_c[this] , CrocodileF_ID)
                    set s__CrocodileSpells___CrocodileF_Struct_c[this]=null
                    set s__CrocodileSpells___CrocodileF_Struct_m[i]=s__CrocodileSpells___CrocodileF_Struct_m[s__CrocodileSpells___CrocodileF_Struct_MUI]
                    set s__CrocodileSpells___CrocodileF_Struct_MUI=s__CrocodileSpells___CrocodileF_Struct_MUI - 1
                    call s__CrocodileSpells___CrocodileF_Struct_deallocate(this)
                    if s__CrocodileSpells___CrocodileF_Struct_MUI == - 1 then
                        call GearTimer03Release()
                    endif
                else
                    set i=i + 1
                endif
            endloop
        endfunction

        function s__CrocodileSpells___CrocodileF_Struct_CrocodileF_Register takes unit NewC returns nothing
            local integer this= s__CrocodileSpells___CrocodileF_Struct__allocate()
            set s__CrocodileSpells___CrocodileF_Struct_MUI=s__CrocodileSpells___CrocodileF_Struct_MUI + 1
            set s__CrocodileSpells___CrocodileF_Struct_m[s__CrocodileSpells___CrocodileF_Struct_MUI]=this
            if s__CrocodileSpells___CrocodileF_Struct_MUI == 0 then
                call GearTimer03Acquire()
            endif
            set s__CrocodileSpells___CrocodileF_Struct_c[this]=NewC
            set s__CrocodileSpells___CrocodileF_Struct_stacks[this]=0
            set s__CrocodileSpells___CrocodileF_Struct_enhanced[this]=false
            set s__CrocodileSpells___CrocodileF_Struct_ownsAS[this]=false
            set s__CrocodileSpells___CrocodileF_Struct_cooldown[this]=0.0
            set s__CrocodileSpells___CrocodileF_Struct_ownsAttackBlock[this]=false
            set s__CrocodileSpells___CrocodileF_Struct_pendingTarget[this]=null
            call SaveInteger(CrocodileSpells___CrocodileTable, GetHandleId(s__CrocodileSpells___CrocodileF_Struct_c[this]), CrocodileSpells___CrocodileF_DataKey, this)
            call TasAbilityChargeBox_SetValue(s__CrocodileSpells___CrocodileF_Struct_c[this] , CrocodileF_ID , "0")
        endfunction



//================================ Crocodile G - Suna Suna no Mi ========================================

        function s__CrocodileSpells___CrocodileG_Struct_CrocodileG_SandSpeed takes integer this,boolean enabled returns nothing
            local ability a
            local integer value
            if enabled == s__CrocodileSpells___CrocodileG_Struct_onSand[this] then
                return
            endif
            set s__CrocodileSpells___CrocodileG_Struct_onSand[this]=enabled
            if enabled then
                set s__CrocodileSpells___CrocodileG_Struct_ownsMS[this]=GetUnitAbilityLevel(s__CrocodileSpells___CrocodileG_Struct_c[this], 'AIms') == 0
                if s__CrocodileSpells___CrocodileG_Struct_ownsMS[this] then
                    call UnitAddAbility(s__CrocodileSpells___CrocodileG_Struct_c[this], 'AIms')
                endif
                set a=BlzGetUnitAbility(s__CrocodileSpells___CrocodileG_Struct_c[this], 'AIms')
                set s__CrocodileSpells___CrocodileG_Struct_savedMS[this]=BlzGetAbilityIntegerLevelField(a, ABILITY_ILF_MOVEMENT_SPEED_BONUS, 0)
                if s__CrocodileSpells___CrocodileG_Struct_ownsMS[this] then
                    set value=CrocodileG_MoveSpeed
                else
                    set value=s__CrocodileSpells___CrocodileG_Struct_savedMS[this] + CrocodileG_MoveSpeed
                endif
                call BlzSetAbilityIntegerLevelField(a, ABILITY_ILF_MOVEMENT_SPEED_BONUS, 0, value)
                call CrocodileSpells___CrocodileBonus_Refresh(s__CrocodileSpells___CrocodileG_Struct_c[this] , 'AIms')
            else
                set a=BlzGetUnitAbility(s__CrocodileSpells___CrocodileG_Struct_c[this], 'AIms')
                set value=BlzGetAbilityIntegerLevelField(a, ABILITY_ILF_MOVEMENT_SPEED_BONUS, 0)
                if s__CrocodileSpells___CrocodileG_Struct_ownsMS[this] and value == CrocodileG_MoveSpeed then
                    call UnitRemoveAbility(s__CrocodileSpells___CrocodileG_Struct_c[this], 'AIms')
                else
                    if s__CrocodileSpells___CrocodileG_Struct_ownsMS[this] then
                        set value=value - CrocodileG_MoveSpeed + s__CrocodileSpells___CrocodileG_Struct_savedMS[this]
                    else
                        set value=value - CrocodileG_MoveSpeed
                    endif
                    call BlzSetAbilityIntegerLevelField(a, ABILITY_ILF_MOVEMENT_SPEED_BONUS, 0, value)
                    call CrocodileSpells___CrocodileBonus_Refresh(s__CrocodileSpells___CrocodileG_Struct_c[this] , 'AIms')
                endif
            endif
            set a=null
        endfunction

        function s__CrocodileSpells___CrocodileG_Struct_Loop_CrocodileG takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__CrocodileSpells___CrocodileG_Struct_MUI
                set this=s__CrocodileSpells___CrocodileG_Struct_m[i]
                call s__CrocodileSpells___CrocodileG_Struct_CrocodileG_SandSpeed(this,LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(s__CrocodileSpells___CrocodileG_Struct_c[this]), CrocodileSpells___CrocodileCore_DataKey) != 0 and SpellBoolCaster(s__CrocodileSpells___CrocodileG_Struct_c[this]) and GetUnitAbilityLevel(s__CrocodileSpells___CrocodileG_Struct_c[this], CrocodileG_ID) > 0 and s__CrocodileSpells___CrocodileSand_Struct_CrocodileSand_IsOnGround(s__CrocodileSpells___CrocodileG_Struct_c[this] , s__CrocodileSpells___CrocodileG_Struct_c[this]))
                if LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(s__CrocodileSpells___CrocodileG_Struct_c[this]), CrocodileSpells___CrocodileCore_DataKey) == 0 then
                    call RemoveSavedInteger(CrocodileSpells___CrocodileTable, GetHandleId(s__CrocodileSpells___CrocodileG_Struct_c[this]), CrocodileSpells___CrocodileG_DataKey)
                    set s__CrocodileSpells___CrocodileG_Struct_c[this]=null
                    set s__CrocodileSpells___CrocodileG_Struct_m[i]=s__CrocodileSpells___CrocodileG_Struct_m[s__CrocodileSpells___CrocodileG_Struct_MUI]
                    set s__CrocodileSpells___CrocodileG_Struct_MUI=s__CrocodileSpells___CrocodileG_Struct_MUI - 1
                    call s__CrocodileSpells___CrocodileG_Struct_deallocate(this)
                    if s__CrocodileSpells___CrocodileG_Struct_MUI == - 1 then
                        call GearTimer03Release()
                    endif
                else
                    set i=i + 1
                endif
            endloop
        endfunction

        function s__CrocodileSpells___CrocodileG_Struct_CrocodileG_Register takes unit NewC returns nothing
            local integer this= s__CrocodileSpells___CrocodileG_Struct__allocate()
            set s__CrocodileSpells___CrocodileG_Struct_MUI=s__CrocodileSpells___CrocodileG_Struct_MUI + 1
            set s__CrocodileSpells___CrocodileG_Struct_m[s__CrocodileSpells___CrocodileG_Struct_MUI]=this
            if s__CrocodileSpells___CrocodileG_Struct_MUI == 0 then
                call GearTimer03Acquire()
            endif
            set s__CrocodileSpells___CrocodileG_Struct_c[this]=NewC
            set s__CrocodileSpells___CrocodileG_Struct_onSand[this]=false
            set s__CrocodileSpells___CrocodileG_Struct_ownsMS[this]=false
            set s__CrocodileSpells___CrocodileG_Struct_savedMS[this]=0
            call SaveInteger(CrocodileSpells___CrocodileTable, GetHandleId(s__CrocodileSpells___CrocodileG_Struct_c[this]), CrocodileSpells___CrocodileG_DataKey, this)
        endfunction



//================================ Crocodile Registration / shared events ========================================


        function s__CrocodileSpells___CrocodileCore_Struct_Loop_Crocodile takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__CrocodileSpells___CrocodileCore_Struct_MUI
                set this=s__CrocodileSpells___CrocodileCore_Struct_m[i]
                if GetUnitTypeId(s__CrocodileSpells___CrocodileCore_Struct_c[this]) != s__CrocodileSpells___CrocodileCore_Struct_savedType[this] or IsUnitIllusion(s__CrocodileSpells___CrocodileCore_Struct_c[this]) then
                    call sc__CrocodileSpells___CrocodileCore_Struct_CrocodileCore_Death(s__CrocodileSpells___CrocodileCore_Struct_c[this])
                    call RemoveSavedInteger(CrocodileSpells___CrocodileTable, GetHandleId(s__CrocodileSpells___CrocodileCore_Struct_c[this]), CrocodileSpells___CrocodileCore_DataKey)
                    set s__CrocodileSpells___CrocodileCore_Struct_c[this]=null
                    set s__CrocodileSpells___CrocodileCore_Struct_m[i]=s__CrocodileSpells___CrocodileCore_Struct_m[s__CrocodileSpells___CrocodileCore_Struct_MUI]
                    set s__CrocodileSpells___CrocodileCore_Struct_MUI=s__CrocodileSpells___CrocodileCore_Struct_MUI - 1
                    call s__CrocodileSpells___CrocodileCore_Struct_deallocate(this)
                    if s__CrocodileSpells___CrocodileCore_Struct_MUI == - 1 then
                        call GearTimer03Release()
                    endif
                else
                    set i=i + 1
                endif
            endloop
            call s__CrocodileSpells___CrocodileQ_Struct_Loop_CrocodileQ()
            call s__CrocodileSpells___CrocodileW_Struct_Loop_CrocodileW()
            call s__CrocodileSpells___CrocodileE_Struct_Loop_CrocodileE()
            call s__CrocodileSpells___CrocodileR_Struct_Loop_CrocodileR()
            call s__CrocodileSpells___CrocodileT_Struct_Loop_CrocodileT()
            call s__CrocodileSpells___CrocodileSand_Struct_Loop_CrocodileSand()
            call s__CrocodileSpells___CrocodileSand_Debuff_Loop_CrocodileSandDebuff()
            call s__CrocodileSpells___CrocodileF_Struct_Loop_CrocodileF()
            call s__CrocodileSpells___CrocodileF_Projectile_Loop_CrocodileF_Projectile()
            call s__CrocodileSpells___CrocodileG_Struct_Loop_CrocodileG()
        endfunction

        function s__CrocodileSpells___CrocodileCore_Struct_Register_Crocodile takes unit NewC returns nothing
            local integer this
            if NewC == null or IsUnitIllusion(NewC) or LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(NewC), CrocodileSpells___CrocodileCore_DataKey) != 0 then
                return
            endif
            set this=s__CrocodileSpells___CrocodileCore_Struct__allocate()
            set s__CrocodileSpells___CrocodileCore_Struct_MUI=s__CrocodileSpells___CrocodileCore_Struct_MUI + 1
            set s__CrocodileSpells___CrocodileCore_Struct_m[s__CrocodileSpells___CrocodileCore_Struct_MUI]=this
            if s__CrocodileSpells___CrocodileCore_Struct_MUI == 0 then
                call GearTimer03Acquire()
            endif
            set s__CrocodileSpells___CrocodileCore_Struct_c[this]=NewC
            set s__CrocodileSpells___CrocodileCore_Struct_savedType[this]=GetUnitTypeId(s__CrocodileSpells___CrocodileCore_Struct_c[this])
            call SaveInteger(CrocodileSpells___CrocodileTable, GetHandleId(s__CrocodileSpells___CrocodileCore_Struct_c[this]), CrocodileSpells___CrocodileCore_DataKey, this)
            call UnitRemoveAbility(s__CrocodileSpells___CrocodileCore_Struct_c[this], CrocodileT2_ID)
            call s__CrocodileSpells___CrocodileE_Struct_CrocodileE_Register(s__CrocodileSpells___CrocodileCore_Struct_c[this])
            call s__CrocodileSpells___CrocodileF_Struct_CrocodileF_Register(s__CrocodileSpells___CrocodileCore_Struct_c[this])
            call s__CrocodileSpells___CrocodileG_Struct_CrocodileG_Register(s__CrocodileSpells___CrocodileCore_Struct_c[this])
        endfunction

        function s__CrocodileSpells___CrocodileCore_Struct_CrocodileCore_Death takes unit c returns nothing
            local integer dash= LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(c), CrocodileSpells___CrocodileE_DataKey)
            local integer attack= LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(c), CrocodileSpells___CrocodileF_DataKey)
            local integer passive= LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(c), CrocodileSpells___CrocodileG_DataKey)
            call s__CrocodileSpells___CrocodileR_Struct_CrocodileR_Death(c)
            if LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(c), CrocodileSpells___CrocodileCore_DataKey) != 0 then
                call s__CrocodileSpells___CrocodileT_Struct_CrocodileT_Finish(c)
                if dash != 0 then
                    set s__CrocodileSpells___CrocodileE_Struct_cancelDash[dash]=true

                endif
                if attack != 0 then
                    set s__CrocodileSpells___CrocodileF_Struct_stacks[attack]=0
                    set s__CrocodileSpells___CrocodileF_Struct_cooldown[attack]=0.0
                    if s__CrocodileSpells___CrocodileF_Struct_ownsAttackBlock[attack] then
                        call UnitRemoveAbility(c, 'Abun')
                        set s__CrocodileSpells___CrocodileF_Struct_ownsAttackBlock[attack]=false
                        set s__CrocodileSpells___CrocodileF_Struct_pendingTarget[attack]=null
                    endif
                    call TasAbilityChargeBox_SetValue(c , CrocodileF_ID , "0")
                    call s__CrocodileSpells___CrocodileF_Struct_CrocodileF_SetEnhanced(attack,false)
                endif
                if passive != 0 then
                    call s__CrocodileSpells___CrocodileG_Struct_CrocodileG_SandSpeed(passive,false)
                endif
            endif
            set c=null
        endfunction

        function s__CrocodileSpells___CrocodileCore_Struct_Crocodile_Summon takes nothing returns nothing
            local unit source= GetSummoningUnit()
            local unit clone= GetSummonedUnit()
            local integer attack= LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(source), CrocodileSpells___CrocodileF_DataKey)
            local integer passive= LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(source), CrocodileSpells___CrocodileG_DataKey)
            local ability a
            if LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(source), CrocodileSpells___CrocodileCore_DataKey) != 0 and IsUnitIllusion(clone) then
                if attack != 0 and s__CrocodileSpells___CrocodileF_Struct_enhanced[attack] then
                    call BlzSetUnitWeaponBooleanField(clone, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, s__CrocodileSpells___CrocodileF_Struct_attack1Enabled[attack])
                    call BlzSetUnitWeaponBooleanField(clone, UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, s__CrocodileSpells___CrocodileF_Struct_attack2Enabled[attack])
                    if GetUnitAbilityLevel(clone, 'AIsx') > 0 then
                        if s__CrocodileSpells___CrocodileF_Struct_ownsAS[attack] then
                            call UnitRemoveAbility(clone, 'AIsx')
                        else
                            set a=BlzGetUnitAbility(clone, 'AIsx')
                            call BlzSetAbilityRealLevelField(a, ABILITY_RLF_ATTACK_SPEED_INCREASE_ISX1, 0, s__CrocodileSpells___CrocodileF_Struct_savedAS[attack])
                            call CrocodileSpells___CrocodileBonus_Refresh(clone , 'AIsx')
                        endif
                    endif
                endif
                if passive != 0 and s__CrocodileSpells___CrocodileG_Struct_onSand[passive] and GetUnitAbilityLevel(clone, 'AIms') > 0 then
                    if s__CrocodileSpells___CrocodileG_Struct_ownsMS[passive] then
                        call UnitRemoveAbility(clone, 'AIms')
                    else
                        set a=BlzGetUnitAbility(clone, 'AIms')
                        call BlzSetAbilityIntegerLevelField(a, ABILITY_ILF_MOVEMENT_SPEED_BONUS, 0, s__CrocodileSpells___CrocodileG_Struct_savedMS[passive])
                        call CrocodileSpells___CrocodileBonus_Refresh(clone , 'AIms')
                    endif
                endif
                call UnitRemoveAbility(clone, CrocodileT2_ID)
            endif
            set a=null
            set source=null
            set clone=null
        endfunction

        function s__CrocodileSpells___CrocodileCore_Struct_CrocodileCore_Damage takes unit c,unit td,real amount,integer kind,integer phase returns real
            local real maxMana
            local real missing
//---------------- T damage reduction ----------------------------------------
            if phase == 2 and LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(td), CrocodileSpells___CrocodileT_DataKey) != 0 then
                set amount=amount * ( 1.0 - CrocodileT_Reduction )
            endif
            if LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(c), CrocodileSpells___CrocodileCore_DataKey) == 0 or IsUnitIllusion(c) or not IsUnitEnemy(td, GetOwningPlayer(c)) then
                return amount
            endif
//---------------- G: pure multiplier; drain only after positive spell damage -
            if GetUnitAbilityLevel(c, CrocodileG_ID) > 0 then
                if phase == 1 then
                    set maxMana=GetUnitState(td, UNIT_STATE_MAX_MANA)
                    if maxMana > 0.0 then
                        set missing=100.0 * ( 1.0 - GetUnitState(td, UNIT_STATE_MANA) / maxMana )
                        set amount=amount * ( 1.0 + RMinBJ(CrocodileG_MaxBonus, RMaxBJ(0.0, missing) * CrocodileG_MissingScale) )
                    endif
                elseif phase == 3 and amount > 0.0 and ( kind == 1 or kind == 2 ) then
                    call SetMpCurrent(td , - CrocodileG_ManaDrain * GetUnitState(td, UNIT_STATE_MAX_MANA))
                endif
            endif
            return amount
        endfunction



    // Explicit TEST registration prevents MAIN rawcode collisions.
    function Crocodile_Register takes unit c returns nothing
        call s__CrocodileSpells___CrocodileCore_Struct_Register_Crocodile(c)
    endfunction

    function Crocodile_IsRegistered takes unit c returns boolean
        return LoadInteger(CrocodileSpells___CrocodileTable, GetHandleId(c), CrocodileSpells___CrocodileCore_DataKey) != 0 and not IsUnitIllusion(c)
    endfunction

