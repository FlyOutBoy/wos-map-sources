        if isInvul then
            return "|cffffcc00Duration:|r " + AAUniversalTooltips___FormatReal(val) + " sec (Invulnerable)|n"
        endif
        return "|cffffcc00Duration:|r " + AAUniversalTooltips___FormatReal(val) + " sec|n"
    endfunction

