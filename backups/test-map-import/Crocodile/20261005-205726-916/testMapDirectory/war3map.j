        function s__PatriotSpells___PatriotSpells_Q_PatriotQ_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__PatriotSpells___PatriotSpells_Q__allocate()
            local integer level= GetUnitAbilityLevel(NewC, PatriotQ_ID)
            if level < 1 then
                set level=1
            endif

            set s__PatriotSpells___PatriotSpells_Q_MUI_PatriotQ=s__PatriotSpells___PatriotSpells_Q_MUI_PatriotQ + 1
            set s__PatriotSpells___PatriotSpells_Q_m_PatriotQ[s__PatriotSpells___PatriotSpells_Q_MUI_PatriotQ]=this
            set s__PatriotSpells___PatriotSpells_Q_c[this]=NewC
            set s__PatriotSpells___PatriotSpells_Q_x[this]=NewX
            set s__PatriotSpells___PatriotSpells_Q_y[this]=NewY
            set s__PatriotSpells___PatriotSpells_Q_td[this]=null
            set s__PatriotSpells___PatriotSpells_Q_r[this]=0.0
            set s__PatriotSpells___PatriotSpells_Q_r5[this]=0.0
            set s__PatriotSpells___PatriotSpells_Q_k3[this]=0
            set s__PatriotSpells___PatriotSpells_Q_k2[this]=0
            set s__PatriotSpells___PatriotSpells_Q_r6[this]=PatriotQ_RangeBase + ( PatriotQ_RangeStep * ( level - 1 ) )
            set s__PatriotSpells___PatriotSpells_Q_r2[this]=1.0
            set s__PatriotSpells___PatriotSpells_Q_check3[this]=0
            set s__PatriotSpells___PatriotSpells_Q_r7[this]=0.0
            set s__PatriotSpells___PatriotSpells_Q_g[this]=CreateGroup()
            set s__PatriotSpells___PatriotSpells_Q_g2[this]=CreateGroup()
            set s__PatriotSpells___PatriotSpells_Q_check4[this]=0
            set s__PatriotSpells___PatriotSpells_Q_a[this]=GAngle2(s__PatriotSpells___PatriotSpells_Q_c[this] , s__PatriotSpells___PatriotSpells_Q_x[this] , s__PatriotSpells___PatriotSpells_Q_y[this])
            set s__PatriotSpells___PatriotSpells_Q_rmax[this]=2.10
            set s__PatriotSpells___PatriotSpells_Q_move[this]=100.0
            set s__PatriotSpells___PatriotSpells_Q_aoe[this]=PatriotQ_DamageAoe
            set s__PatriotSpells___PatriotSpells_Q_dmg[this]=GetHeroAgi(s__PatriotSpells___PatriotSpells_Q_c[this], true) * ( PatriotQ_DamageAgiBase + ( PatriotQ_DamageAgiStep * ( level - 1 ) ) )
            set s__PatriotSpells___PatriotSpells_Q_dmg[this]=s__PatriotSpells___PatriotSpells_Q_dmg[this] + PatriotQ_Damage2StaticBase + ( PatriotQ_Damage2StaticStep * ( level - 1 ) )

            call StartSpellUnit2(s__PatriotSpells___PatriotSpells_Q_c[this])
            call SetUnitFacing(s__PatriotSpells___PatriotSpells_Q_c[this], s__PatriotSpells___PatriotSpells_Q_a[this] * bj_RADTODEG)
            call Patriot_RestoreOrder(s__PatriotSpells___PatriotSpells_Q_c[this] , 9)

            if LoadInteger(hs, GetHandleId(s__PatriotSpells___PatriotSpells_Q_c[this]), StringHash("patriot e")) == 1 then
                set s__PatriotSpells___PatriotSpells_Q_check4[this]=1
                set s__PatriotSpells___PatriotSpells_Q_dmg[this]=s__PatriotSpells___PatriotSpells_Q_dmg[this] + GetHeroAgi(s__PatriotSpells___PatriotSpells_Q_c[this], true) * PatriotQ_RuinationAgiBonus
            endif

            call SetUnitTimeScale(s__PatriotSpells___PatriotSpells_Q_c[this], 2.31)
            if GetRandomInt(1, 2) == 1 then
                call MakeSound("war3mapimported\\Hero_Patriot_Q")
            else
                call MakeSound("war3mapimported\\Hero_Patriot_Q4")
            endif

            if s__PatriotSpells___PatriotSpells_Q_MUI_PatriotQ == 0 then
                call PatriotSpells___PatriotTimer03Acquire()
            endif
        endfunction



