    function AstaSpells___AstaTimer03Acquire takes nothing returns nothing
        set AstaSpells___AstaTimer03Users=AstaSpells___AstaTimer03Users + 1
        if AstaSpells___AstaTimer03Users == 1 then
            call TimerStart(AstaSpells___AstaTimer03, 0.03, true, AstaSpells___AstaTimer03Callback)
        endif
    endfunction

    function AstaSpells___AstaTimer03Release takes nothing returns nothing
        set AstaSpells___AstaTimer03Users=AstaSpells___AstaTimer03Users - 1
        if AstaSpells___AstaTimer03Users <= 0 then
            set AstaSpells___AstaTimer03Users=0
            call PauseTimer(AstaSpells___AstaTimer03)
        endif
    endfunction

    function AstaSpells___AstaTimer05Acquire takes nothing returns nothing
        set AstaSpells___AstaTimer05Users=AstaSpells___AstaTimer05Users + 1
        if AstaSpells___AstaTimer05Users == 1 then
            call TimerStart(AstaSpells___AstaTimer05, 0.05, true, AstaSpells___AstaTimer05Callback)
        endif
    endfunction

    function AstaSpells___AstaTimer05Release takes nothing returns nothing
        set AstaSpells___AstaTimer05Users=AstaSpells___AstaTimer05Users - 1
        if AstaSpells___AstaTimer05Users <= 0 then
            set AstaSpells___AstaTimer05Users=0
            call PauseTimer(AstaSpells___AstaTimer05)
        endif
    endfunction

