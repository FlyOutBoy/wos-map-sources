        function s__RimuruSpells__Rimuru2W2_KS_Loop_Rimuru2W2 takes nothing returns nothing
            local integer this
            local integer i= 0
            local real rr1= 0
            local real rr2= 0
            local real rr3= 0
            local real rr4= 0
            loop
                exitwhen i > s__RimuruSpells__Rimuru2W2_KS_MUI_RimuruW2
                set this=s__RimuruSpells__Rimuru2W2_KS_m_RimuruW2[i]
                if SpellBoolCaster(s__RimuruSpells__Rimuru2W2_KS_c[this]) and s__RimuruSpells__Rimuru2W2_KS_r[this] <= s__RimuruSpells__Rimuru2W2_KS_rmax[this] then
                    set s__RimuruSpells__Rimuru2W2_KS_r[this]=RoundReal(s__RimuruSpells__Rimuru2W2_KS_r[this] + 0.03 , 3)
                    if s__RimuruSpells__Rimuru2W2_KS_r[this] == 0.03 then
                        call RootUnit(s__RimuruSpells__Rimuru2W2_KS_c[this] , s__RimuruSpells__Rimuru2W2_KS_td[this] , RimiruW_Root)
                        set s__RimuruSpells__Rimuru2W2_KS_ls_progress[this]=0.0
                        set s__RimuruSpells__Rimuru2W2_KS_ls_retract[this]=0
                        set s__RimuruSpells__Rimuru2W2_KS_k[this]=0
                        loop
                            exitwhen s__RimuruSpells__Rimuru2W2_KS_k[this] == 10
                            set rr3=rr3 + 20 * bj_DEGTORAD
                            set rr2=GetRandomReal(350, 425)
        // Entry point вЂ” random offset on one side of target
                            set s___RimuruSpells__Rimuru2W2_KS_ls_x1[s__RimuruSpells__Rimuru2W2_KS_ls_x1[this]+s__RimuruSpells__Rimuru2W2_KS_k[this]]=GetUnitX(s__RimuruSpells__Rimuru2W2_KS_td[this]) + rr2 * Cos(rr3)
                            set s___RimuruSpells__Rimuru2W2_KS_ls_y1[s__RimuruSpells__Rimuru2W2_KS_ls_y1[this]+s__RimuruSpells__Rimuru2W2_KS_k[this]]=GetUnitY(s__RimuruSpells__Rimuru2W2_KS_td[this]) + rr2 * Sin(rr3)
        // Exit point вЂ” opposite side, different random radius so it looks skewed
                            set rr1=GetRandomReal(350, 425)
                            set rr4=GetRandomReal(- 0.3, 0.3)
                            set s___RimuruSpells__Rimuru2W2_KS_ls_x2[s__RimuruSpells__Rimuru2W2_KS_ls_x2[this]+s__RimuruSpells__Rimuru2W2_KS_k[this]]=GetUnitX(s__RimuruSpells__Rimuru2W2_KS_td[this]) - rr1 * Cos(rr3 + rr4)
                            set s___RimuruSpells__Rimuru2W2_KS_ls_y2[s__RimuruSpells__Rimuru2W2_KS_ls_y2[this]+s__RimuruSpells__Rimuru2W2_KS_k[this]]=GetUnitY(s__RimuruSpells__Rimuru2W2_KS_td[this]) - rr1 * Sin(rr3 + rr4)
                           // Randomly from ground or from air
                            if GetRandomInt(0, 1) == 0 then
                                set s___RimuruSpells__Rimuru2W2_KS_ls_h1[s__RimuruSpells__Rimuru2W2_KS_ls_h1[this]+s__RimuruSpells__Rimuru2W2_KS_k[this]]=GetRandomReal(0, 155) // crawling from earth
                            else
                                set s___RimuruSpells__Rimuru2W2_KS_ls_h1[s__RimuruSpells__Rimuru2W2_KS_ls_h1[this]+s__RimuruSpells__Rimuru2W2_KS_k[this]]=GetRandomReal(305, 375) // dropping from air
                            endif
