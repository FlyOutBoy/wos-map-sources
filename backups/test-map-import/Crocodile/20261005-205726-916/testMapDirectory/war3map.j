            loop
                exitwhen i > s__RaidenSpells__RaidenPas_KS_MUI_RaidenPas
                set this=s__RaidenSpells__RaidenPas_KS_m_RaidenPas[i]
                if SpellBoolCaster(s__RaidenSpells__RaidenPas_KS_c[this]) and s__RaidenSpells__RaidenPas_KS_r[this] <= s__RaidenSpells__RaidenPas_KS_rmax[this] then
                    set s__RaidenSpells__RaidenPas_KS_r[this]=s__RaidenSpells__RaidenPas_KS_r[this] + 0.03
                    set s__RaidenSpells__RaidenPas_KS_r[this]=S2R(R2SW(s__RaidenSpells__RaidenPas_KS_r[this], 0, 3))
                    set s__RaidenSpells__RaidenPas_KS_a[this]=GetUnitFacing(s__RaidenSpells__RaidenPas_KS_c[this])
                    set s__RaidenSpells__RaidenPas_KS_x[this]=GetUnitX(s__RaidenSpells__RaidenPas_KS_c[this]) + 15 * Cos(s__RaidenSpells__RaidenPas_KS_a[this] * bj_DEGTORAD)
                    set s__RaidenSpells__RaidenPas_KS_y[this]=GetUnitY(s__RaidenSpells__RaidenPas_KS_c[this]) + 15 * Sin(s__RaidenSpells__RaidenPas_KS_a[this] * bj_DEGTORAD)
                    call BlzSetSpecialEffectPosition(s__RaidenSpells__RaidenPas_KS_e[this], s__RaidenSpells__RaidenPas_KS_x[this], s__RaidenSpells__RaidenPas_KS_y[this], s__RaidenSpells__RaidenPas_KS_fly[this])
                    call BlzSetSpecialEffectYaw(s__RaidenSpells__RaidenPas_KS_e[this], s__RaidenSpells__RaidenPas_KS_a[this] * bj_DEGTORAD)
                    if LoadInteger(hs, GetHandleId(s__RaidenSpells__RaidenPas_KS_c[this]), StringHash("raiden t2")) == 1 then
                        set s__RaidenSpells__RaidenPas_KS_fly[this]=25
                        set s__RaidenSpells__RaidenPas_KS_scale[this]=2.65
                    else
                        set s__RaidenSpells__RaidenPas_KS_fly[this]=15
                        set s__RaidenSpells__RaidenPas_KS_scale[this]=1.45
                    endif
                    call BlzSetSpecialEffectScale(s__RaidenSpells__RaidenPas_KS_e[this], s__RaidenSpells__RaidenPas_KS_scale[this])
                    if s__RaidenSpells__RaidenPas_KS_r2[this] > 0.90 then
                        call SetMpCurrent(s__RaidenSpells__RaidenPas_KS_c[this] , ( ( RaidenW_ManaRestore / 100.0 ) * GetUnitState(s__RaidenSpells__RaidenPas_KS_c[this], UNIT_STATE_MAX_MANA) ) / s__RaidenSpells__RaidenPas_KS_rmax[this])
                        set s__RaidenSpells__RaidenPas_KS_r2[this]=0
                    else
                        set s__RaidenSpells__RaidenPas_KS_r2[this]=s__RaidenSpells__RaidenPas_KS_r2[this] + 0.03
                    endif
                else
                    call DestroyEffect(s__RaidenSpells__RaidenPas_KS_e[this])
                    set s__RaidenSpells__RaidenPas_KS_c[this]=null
                    set s__RaidenSpells__RaidenPas_KS_e[this]=null
                    set s__RaidenSpells__RaidenPas_KS_m_RaidenPas[i]=s__RaidenSpells__RaidenPas_KS_m_RaidenPas[s__RaidenSpells__RaidenPas_KS_MUI_RaidenPas]
                    set s__RaidenSpells__RaidenPas_KS_MUI_RaidenPas=s__RaidenSpells__RaidenPas_KS_MUI_RaidenPas - 1
                    set i=i - 1
                    if s__RaidenSpells__RaidenPas_KS_MUI_RaidenPas == - 1 then
                        call PauseTimer(s__RaidenSpells__RaidenPas_KS_t_RaidenPas)
                    endif
                    call s__RaidenSpells__RaidenPas_KS_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction

