                                        set s__RimuruSpells__Rimuru3T_KS_k4[this]=0
                                if GetUnitAbilityLevel(s__RimuruSpells__Rimuru3T_KS_c[this], RimuruG3_IntBonus_ID) > 0 then
                                set s__RimuruSpells__Rimuru3T_KS_k4[this]=GetRandomInt(1, 3)
                                endif
                                        if s__RimuruSpells__Rimuru3T_KS_k4[this] > 0 then
                                     call ErzaPassive(s__RimuruSpells__Rimuru3T_KS_c[this] , s__RimuruSpells__Rimuru3T_KS_u[this] , s__RimuruSpells__Rimuru3T_KS_k4[this])
                                        endif
                                        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", s__RimuruSpells__Rimuru3T_KS_u[this], "chest"))
                                    endif
                                    call GroupRemoveUnit(s__RimuruSpells__Rimuru3T_KS_g2[this], s__RimuruSpells__Rimuru3T_KS_u[this])
