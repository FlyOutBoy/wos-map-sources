        function s__OkarunSpells__OkarunT_KS_OkarunT_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__OkarunSpells__OkarunT_KS__allocate()
            set s__OkarunSpells__OkarunT_KS_MUI_OkarunT=s__OkarunSpells__OkarunT_KS_MUI_OkarunT + 1
            set s__OkarunSpells__OkarunT_KS_m_OkarunT[s__OkarunSpells__OkarunT_KS_MUI_OkarunT]=this
            set s__OkarunSpells__OkarunT_KS_c[this]=NewC
            set s__OkarunSpells__OkarunT_KS_x[this]=NewX
            set s__OkarunSpells__OkarunT_KS_y[this]=NewY
            set s__OkarunSpells__OkarunT_KS_r[this]=0
            call StartSpellUnit(s__OkarunSpells__OkarunT_KS_c[this])
            set s__OkarunSpells__OkarunT_KS_a[this]=GAngle2(s__OkarunSpells__OkarunT_KS_c[this] , s__OkarunSpells__OkarunT_KS_x[this] , s__OkarunSpells__OkarunT_KS_y[this]) // Angle Between points
            set s__OkarunSpells__OkarunT_KS_aoe[this]=OkarunT_DamageAoe
            set s__OkarunSpells__OkarunT_KS_dmg[this]=GetHeroInt(s__OkarunSpells__OkarunT_KS_c[this], true) * OkarunT_DamageIntBase
            set s__OkarunSpells__OkarunT_KS_rmax[this]=3
            set s__OkarunSpells__OkarunT_KS_g[this]=CreateGroup()
            call SetUnitAnimationByIndex(s__OkarunSpells__OkarunT_KS_c[this], 6)
            call SetUnitTimeScale(s__OkarunSpells__OkarunT_KS_c[this], 1)
            set s__OkarunSpells__OkarunT_KS_r5[this]=0
            call DecorRemove(s__OkarunSpells__OkarunT_KS_c[this] , GetUnitX(s__OkarunSpells__OkarunT_KS_c[this]) , GetUnitY(s__OkarunSpells__OkarunT_KS_c[this]) , s__OkarunSpells__OkarunT_KS_aoe[this] , 100)
            call GroupEnumUnitsInRange(s__OkarunSpells__OkarunT_KS_g[this], GetUnitX(s__OkarunSpells__OkarunT_KS_c[this]), GetUnitY(s__OkarunSpells__OkarunT_KS_c[this]), s__OkarunSpells__OkarunT_KS_aoe[this], NoDecor_Cond)
            loop
                set s__OkarunSpells__OkarunT_KS_u[this]=FirstOfGroup(s__OkarunSpells__OkarunT_KS_g[this])
                exitwhen s__OkarunSpells__OkarunT_KS_u[this] == null
                if SpellBool(s__OkarunSpells__OkarunT_KS_u[this]) and IsUnitEnemy(s__OkarunSpells__OkarunT_KS_u[this], GetOwningPlayer(s__OkarunSpells__OkarunT_KS_c[this])) then
                    call SlowUnit(s__OkarunSpells__OkarunT_KS_c[this] , s__OkarunSpells__OkarunT_KS_u[this] , OkarunT_Slow , OkarunT_SlowDuration)
                endif
                call GroupRemoveUnit(s__OkarunSpells__OkarunT_KS_g[this], s__OkarunSpells__OkarunT_KS_u[this])
            endloop
            set s__OkarunSpells__OkarunT_KS_u[this]=null
            set s__OkarunSpells__OkarunT_KS_e[this]=AddSpecialEffectTarget("war3mapImported\\wos_aurafbred.mdx", s__OkarunSpells__OkarunT_KS_c[this], "origin")
            call MakeSound("war3mapimported\\Hero_Okarun_T")
            call MakeSound("war3mapimported\\Hero_Okarun_T4")
            call MakeSound("war3mapimported\\Hero_Okarun_T7")
            call DestroyEffect(EffectSpawn("war3mapimported\\wos_opm (513)red.mdx" , GetUnitX(s__OkarunSpells__OkarunT_KS_c[this]) , GetUnitY(s__OkarunSpells__OkarunT_KS_c[this]) , s__OkarunSpells__OkarunT_KS_a[this] * bj_RADTODEG , 1.25 , 1. , 1))
            if s__OkarunSpells__OkarunT_KS_MUI_OkarunT == 0 then
