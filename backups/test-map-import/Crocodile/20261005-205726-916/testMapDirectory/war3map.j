                            set s__ErzaQSpells__ErzaQ_KS_x[this]=GetUnitX(s__ErzaQSpells__ErzaQ_KS_c[this]) + 150 * Cos(s__ErzaQSpells__ErzaQ_KS_a[this])
                            set s__ErzaQSpells__ErzaQ_KS_y[this]=GetUnitY(s__ErzaQSpells__ErzaQ_KS_c[this]) + 150 * Sin(s__ErzaQSpells__ErzaQ_KS_a[this])
                            call DestroyEffect(EffectSpawnColor("war3mapimported\\wos_acg_bbb.mdx" , GetUnitX(s__ErzaQSpells__ErzaQ_KS_c[this]) , GetUnitY(s__ErzaQSpells__ErzaQ_KS_c[this]) , GetRandomReal(0, 359) , 1.85 , 2.25 , 150 , 255 , 255 , 255 , 165))
                    call DecorRemove(s__ErzaQSpells__ErzaQ_KS_c[this] , s__ErzaQSpells__ErzaQ_KS_x[this] , s__ErzaQSpells__ErzaQ_KS_y[this] , s__ErzaQSpells__ErzaQ_KS_aoe[this] , 20)
                            call GroupEnumUnitsInRange(s__ErzaQSpells__ErzaQ_KS_g[this], s__ErzaQSpells__ErzaQ_KS_x[this], s__ErzaQSpells__ErzaQ_KS_y[this], s__ErzaQSpells__ErzaQ_KS_aoe[this], NoDecor_Cond)
                            loop
