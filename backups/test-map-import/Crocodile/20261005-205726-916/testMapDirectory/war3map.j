                        endif
                    endif
                else
                     if GetLocalPlayer() == Player(s__OkarunSpells__OkarunF_KS_k2[this]) then
                    call BlzFrameSetVisible(s___OkarunSpells__OkarunF_KS_frame_pas1[s__OkarunSpells__OkarunF_KS_frame_pas1[this]+s__OkarunSpells__OkarunF_KS_k2[this]], false)
                endif
                    call DestroyEffect(s__OkarunSpells__OkarunF_KS_e[this])
                    set s__OkarunSpells__OkarunF_KS_c[this]=null
                    set s__OkarunSpells__OkarunF_KS_td[this]=null
                    set s__OkarunSpells__OkarunF_KS_e[this]=null
                    set s__OkarunSpells__OkarunF_KS_m_OkarunF[i]=s__OkarunSpells__OkarunF_KS_m_OkarunF[s__OkarunSpells__OkarunF_KS_MUI_OkarunF]
