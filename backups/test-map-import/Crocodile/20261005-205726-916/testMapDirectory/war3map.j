            call SaveInteger(hs, GetHandleId(s__InoriSpells__InoriF_KS_c[this]), StringHash("mode f"), 1)
            if true then //LoadInteger(hs, GetHandleId(c), StringHash("Inori E Active")) == 1 or LoadInteger(hs, GetHandleId(c), StringHash("mode t")) == 1 then
                call BlinkEff(s__InoriSpells__InoriF_KS_c[this])
