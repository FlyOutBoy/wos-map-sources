    function BrandishSpells___BrandishTimer03Acquire takes nothing returns nothing
        set BrandishSpells___BrandishTimer03Users=BrandishSpells___BrandishTimer03Users + 1
        if BrandishSpells___BrandishTimer03Users == 1 then
            call TimerStart(BrandishSpells___BrandishTimer03, 0.03, true, BrandishSpells___BrandishTimer03Callback)
        endif
    endfunction

    function BrandishSpells___BrandishTimer03Release takes nothing returns nothing
        set BrandishSpells___BrandishTimer03Users=BrandishSpells___BrandishTimer03Users - 1
        if BrandishSpells___BrandishTimer03Users <= 0 then
            set BrandishSpells___BrandishTimer03Users=0
            call PauseTimer(BrandishSpells___BrandishTimer03)
        endif
    endfunction

