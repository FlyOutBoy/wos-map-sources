                            call DecorRemove(s__FrierenSpells___FrierenSpells_Q_c[this] , s__FrierenSpells___FrierenSpells_Q_x[this] + s__FrierenSpells___FrierenSpells_Q_r2[this] * Cos(s__FrierenSpells___FrierenSpells_Q_a[this]) , s__FrierenSpells___FrierenSpells_Q_y[this] + s__FrierenSpells___FrierenSpells_Q_r2[this] * Sin(s__FrierenSpells___FrierenSpells_Q_a[this]) , s__FrierenSpells___FrierenSpells_Q_aoe[this] * StarrkEQ_AoeMultiplier , 50)
                            call VisionTimed(GetOwningPlayer(s__FrierenSpells___FrierenSpells_Q_c[this]) , s__FrierenSpells___FrierenSpells_Q_x[this] + s__FrierenSpells___FrierenSpells_Q_r2[this] * Cos(s__FrierenSpells___FrierenSpells_Q_a[this]) , s__FrierenSpells___FrierenSpells_Q_y[this] + s__FrierenSpells___FrierenSpells_Q_r2[this] * Sin(s__FrierenSpells___FrierenSpells_Q_a[this]) , s__FrierenSpells___FrierenSpells_Q_aoe[this] * StarrkEQ_AoeMultiplier + 400 , 2)
                        else
