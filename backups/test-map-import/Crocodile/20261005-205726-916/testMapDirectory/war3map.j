                        else
                            call SetPlayerAbilityAvailable(GetOwningPlayer(s__TojiSpells___TojiSpells_R_Insectoids_c[this]), TojiR_InvisAbility2_ID, true)
                        endif
                    endif

                    set n=0
                    loop
                        exitwhen n >= 48
                        set mosquito=LoadEffectHandle(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], n)
                        if mosquito != null then
                            call ColorEffDummy3Alpha((mosquito ) , (( 0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.3)*1.0)) // INLINED!!
                        endif
                        set n=n + 1
                    endloop
                    call FlushChildHashtable(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this])
                    call DestroyGroup(s__TojiSpells___TojiSpells_R_Insectoids_scanGroup[this])
                    call DestroyGroup(s__TojiSpells___TojiSpells_R_Insectoids_damageGroup[this])
                    call DestroyGroup(s__TojiSpells___TojiSpells_R_Insectoids_affectedGroup[this])
                    call DestroyGroup(s__TojiSpells___TojiSpells_R_Insectoids_keepGroup[this])
                    set s__TojiSpells___TojiSpells_R_Insectoids_scanGroup[this]=null
                    set s__TojiSpells___TojiSpells_R_Insectoids_damageGroup[this]=null
                    set s__TojiSpells___TojiSpells_R_Insectoids_affectedGroup[this]=null
                    set s__TojiSpells___TojiSpells_R_Insectoids_keepGroup[this]=null
                    set s__TojiSpells___TojiSpells_R_Insectoids_c[this]=null
                    set target=null
                    set mosquito=null
                    call s__TojiSpells___TojiSpells_R_Insectoids_deallocate(this)
                    set s__TojiSpells___TojiSpells_R_Insectoids_m_TojiRI[i]=s__TojiSpells___TojiSpells_R_Insectoids_m_TojiRI[s__TojiSpells___TojiSpells_R_Insectoids_MUI_TojiRI]
                    set s__TojiSpells___TojiSpells_R_Insectoids_MUI_TojiRI=s__TojiSpells___TojiSpells_R_Insectoids_MUI_TojiRI - 1
                    if s__TojiSpells___TojiSpells_R_Insectoids_MUI_TojiRI == - 1 then
                        call TojiSpells___TojiTimer03Release()
                    endif
                else
                    set i=i + 1
                endif
            endloop
            set target=null
            set mosquito=null
            set swapGroup=null
        endfunction

        function s__TojiSpells___TojiSpells_R_Insectoids_TojiR_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__TojiSpells___TojiSpells_R_Insectoids__allocate()
            local integer n= 0
            local integer level
            local real angle
            local real radius
            local real targetX
            local real targetY
            local real targetZ
            local effect mosquito
            local integer red
            local integer green
            local integer blue
            set s__TojiSpells___TojiSpells_R_Insectoids_MUI_TojiRI=s__TojiSpells___TojiSpells_R_Insectoids_MUI_TojiRI + 1
            set s__TojiSpells___TojiSpells_R_Insectoids_m_TojiRI[s__TojiSpells___TojiSpells_R_Insectoids_MUI_TojiRI]=this
            set s__TojiSpells___TojiSpells_R_Insectoids_c[this]=NewC
            set s__TojiSpells___TojiSpells_R_Insectoids_startX[this]=GetUnitX(NewC)
            set s__TojiSpells___TojiSpells_R_Insectoids_startY[this]=GetUnitY(NewC)
            set s__TojiSpells___TojiSpells_R_Insectoids_centerX[this]=NewX
            set s__TojiSpells___TojiSpells_R_Insectoids_centerY[this]=NewY
            set level=GetUnitAbilityLevel(NewC, TojiR_ID)
            if level < 1 then
                set level=1
            endif
            set s__TojiSpells___TojiSpells_R_Insectoids_elapsed[this]=0.0
            set s__TojiSpells___TojiSpells_R_Insectoids_scanClock[this]=0.0
            set s__TojiSpells___TojiSpells_R_Insectoids_damageClock[this]=0.0
            set s__TojiSpells___TojiSpells_R_Insectoids_casterInside[this]=false
            set s__TojiSpells___TojiSpells_R_Insectoids_invisAdded[this]=false
