        if BazzBSpells__BazzBTimer05Users <= 0 then
            set BazzBSpells__BazzBTimer05Users=0
            call PauseTimer(BazzBSpells__BazzBTimer05)
        endif
    endfunction

    function BazzBPass_Start takes unit c,integer id returns nothing
        local real r= 0.0
        if GetHeroLevel(c) >= 35 then
            set r=BazzBG_CdReduce3
        elseif GetHeroLevel(c) >= 25 then
            set r=BazzBG_CdReduce2
        elseif GetHeroLevel(c) >= 12 then
            set r=BazzBG_CdReduce1
        endif

        if r != 0.0 then
            if id != BazzBQ_ID then
                call ReduceCooldown(c , BazzBQ_ID , r)
            endif
            if id != BazzBW_ID then
                call ReduceCooldown(c , BazzBW_ID , r)
            endif
            if id != BazzBE_ID then
                call ReduceCooldown(c , BazzBE_ID , r)
            endif
            if id != BazzBR_ID then
                call ReduceCooldown(c , BazzBR_ID , r)
            endif
            if id != BazzBT_ID then
                call ReduceCooldown(c , BazzBT_ID , r)
            endif
        endif
    endfunction



        function s__BazzBSpells__BazzBSpells_Q_Loop_BazzBQ takes nothing returns nothing
            local integer i= 0
            local integer this
            local unit u
            local boolean remove

            loop
                exitwhen i > s__BazzBSpells__BazzBSpells_Q_MUI_BazzBQ
                set this=s__BazzBSpells__BazzBSpells_Q_m_BazzBQ[i]
                set remove=false

                if s__BazzBSpells__BazzBSpells_Q_c[this] == null or GetUnitTypeId(s__BazzBSpells__BazzBSpells_Q_c[this]) == 0 or GetWidgetLife(s__BazzBSpells__BazzBSpells_Q_c[this]) <= 0.405 then
                    set remove=true
