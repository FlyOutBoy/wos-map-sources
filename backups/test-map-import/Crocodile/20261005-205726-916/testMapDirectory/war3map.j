            call VisionTimed(GetOwningPlayer(s__MilimSpells___MilimW2KS_c[this]) , GetUnitX(s__MilimSpells___MilimW2KS_c[this]) , GetUnitY(s__MilimSpells___MilimW2KS_c[this]) , 2000 , s__MilimSpells___MilimW2KS_rmax[this])
            if s__MilimSpells___MilimW2KS_MUI_MilimW2 == 0 then
                call TimerStart(s__MilimSpells___MilimW2KS_t_MilimW2, 0.05, true, function s__MilimSpells___MilimW2KS_Loop_MilimW2)
            endif
        endfunction



        function s__MilimSpells___MilimEKS_Loop_MilimE takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__MilimSpells___MilimEKS_MUI_MilimE
                set this=s__MilimSpells___MilimEKS_m_MilimE[i]
                if SpellBoolCaster(s__MilimSpells___MilimEKS_c[this]) and s__MilimSpells___MilimEKS_r[this] <= s__MilimSpells___MilimEKS_rmax[this] then
                    set s__MilimSpells___MilimEKS_r[this]=s__MilimSpells___MilimEKS_r[this] + 0.03
                    if s__MilimSpells___MilimEKS_r[this] < 0.45 then
                        call DebugUnit2(s__MilimSpells___MilimEKS_c[this])
                    endif
                    if s__MilimSpells___MilimEKS_r3[this] > 0.12 then
                    set s__MilimSpells___MilimEKS_r3[this]=0
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_13684996917731847118.mdl" , GetUnitX(s__MilimSpells___MilimEKS_c[this]) + 50 * Cos(s__MilimSpells___MilimEKS_a[this]) , GetUnitY(s__MilimSpells___MilimEKS_c[this]) + 50 * Cos(s__MilimSpells___MilimEKS_a[this]) , GetRandomReal(0, 359) , GetRandomReal(1.5, 2) , 1.55 , GetUnitFlyHeight(s__MilimSpells___MilimEKS_c[this]) + GetRandomReal(50, 155)))
                    else
                    set s__MilimSpells___MilimEKS_r3[this]=s__MilimSpells___MilimEKS_r3[this] + 0.03
                    endif
                    if s__MilimSpells___MilimEKS_r[this] == 0.45 then
                        call MakeSound("war3mapimported\\Hero_Milim_E2")
                        //call StopSpellUnit2(c)
                        set s__MilimSpells___MilimEKS_r5[this]=300
                        set s__MilimSpells___MilimEKS_r4[this]=s__MilimSpells___MilimEKS_r4[this] + s__MilimSpells___MilimEKS_r5[this]
                        set s__MilimSpells___MilimEKS_r9[this]=s__MilimSpells___MilimEKS_r4[this] - s__MilimSpells___MilimEKS_r5[this]
                        set s__MilimSpells___MilimEKS_check[this]=0
                        set s__MilimSpells___MilimEKS_move[this]=s__MilimSpells___MilimEKS_r9[this] / 20
                        set s__MilimSpells___MilimEKS_r7[this]=0.1 * 0.75 // scale
                        set s__MilimSpells___MilimEKS_r8[this]=50 // move
                        set s__MilimSpells___MilimEKS_scale[this]=0.45
                        set s__MilimSpells___MilimEKS_fly[this]=550
                        set s__MilimSpells___MilimEKS_fly2[this]=7
                        set s__MilimSpells___MilimEKS_fly3[this]=31 * 0.75
            set s__MilimSpells___MilimEKS_e[this]=EffectSpawn3("war3mapImported\\wos_file00005542.mdl" , GetUnitX(s__MilimSpells___MilimEKS_c[this]) + ( 450 ) * Cos(s__MilimSpells___MilimEKS_a[this]) , GetUnitY(s__MilimSpells___MilimEKS_c[this]) + ( 450 ) * Sin(s__MilimSpells___MilimEKS_a[this]) , s__MilimSpells___MilimEKS_a[this] * bj_RADTODEG , 1 , s__MilimSpells___MilimEKS_scale[this] , s__MilimSpells___MilimEKS_fly[this] , - 60)
            call BlzPlaySpecialEffect(s__MilimSpells___MilimEKS_e[this], ANIM_TYPE_STAND)
            set s__MilimSpells___MilimEKS_r9[this]=- 50
                    endif
                    if s__MilimSpells___MilimEKS_check[this] == 20 then
                    set s__MilimSpells___MilimEKS_check[this]=21
                    call ColorEffDummy3Alpha((s__MilimSpells___MilimEKS_e[this] ) , (( 0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.35)*1.0)) // INLINED!!
                    endif
                    if s__MilimSpells___MilimEKS_r[this] > 0.45 and s__MilimSpells___MilimEKS_check[this] < 20 then
                        if s__MilimSpells___MilimEKS_r5[this] < s__MilimSpells___MilimEKS_r4[this] then
                            set s__MilimSpells___MilimEKS_r5[this]=s__MilimSpells___MilimEKS_r5[this] + s__MilimSpells___MilimEKS_move[this]
                        else
                            set s__MilimSpells___MilimEKS_r[this]=9999
                        endif
                        set s__MilimSpells___MilimEKS_check[this]=s__MilimSpells___MilimEKS_check[this] + 1
                        set s__MilimSpells___MilimEKS_r9[this]=s__MilimSpells___MilimEKS_r9[this] - 3 * 0.75
                        call BlzSetSpecialEffectPitch(s__MilimSpells___MilimEKS_e[this], s__MilimSpells___MilimEKS_r9[this] * bj_DEGTORAD)
                        set s__MilimSpells___MilimEKS_scale[this]=s__MilimSpells___MilimEKS_scale[this] + s__MilimSpells___MilimEKS_r7[this]
                        call BlzSetSpecialEffectScale(s__MilimSpells___MilimEKS_e[this], s__MilimSpells___MilimEKS_scale[this])
                        call MoveEff2(s__MilimSpells___MilimEKS_e[this] , s__MilimSpells___MilimEKS_r8[this] + ( s__MilimSpells___MilimEKS_check[this] * ( 3 * 0.75 ) ) , s__MilimSpells___MilimEKS_a[this])
                        if s__MilimSpells___MilimEKS_check[this] < 9 then
                        set s__MilimSpells___MilimEKS_fly[this]=s__MilimSpells___MilimEKS_fly[this] - ( s__MilimSpells___MilimEKS_fly2[this] + s__MilimSpells___MilimEKS_check[this] * 5 )
                        else
                        if s__MilimSpells___MilimEKS_check[this] >= 15 then
                        set s__MilimSpells___MilimEKS_fly[this]=s__MilimSpells___MilimEKS_fly[this] + ( s__MilimSpells___MilimEKS_fly3[this] + ( s__MilimSpells___MilimEKS_check[this] * 3.5 ) )
                        else
                        set s__MilimSpells___MilimEKS_fly[this]=s__MilimSpells___MilimEKS_fly[this] + s__MilimSpells___MilimEKS_fly3[this]
                        endif
                        endif
                        if s__MilimSpells___MilimEKS_fly[this] <= 0 then
                       set s__MilimSpells___MilimEKS_fly[this]=0.01
                        endif
                        call BlzSetSpecialEffectHeight(s__MilimSpells___MilimEKS_e[this], s__MilimSpells___MilimEKS_fly[this])
                        set s__MilimSpells___MilimEKS_x[this]=s__MilimSpells___MilimEKS_x1[this] + s__MilimSpells___MilimEKS_r5[this] * Cos(s__MilimSpells___MilimEKS_a[this])
                        set s__MilimSpells___MilimEKS_y[this]=s__MilimSpells___MilimEKS_y1[this] + s__MilimSpells___MilimEKS_r5[this] * Sin(s__MilimSpells___MilimEKS_a[this])
                        if s__MilimSpells___MilimEKS_r2[this] > 0.06 then
                        set s__MilimSpells___MilimEKS_r2[this]=0
                        call VisionTimed(GetOwningPlayer(s__MilimSpells___MilimEKS_c[this]) , s__MilimSpells___MilimEKS_x[this] , s__MilimSpells___MilimEKS_y[this] , s__MilimSpells___MilimEKS_aoe[this] * 2.00 , 1.00)
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_13684996917731847118.mdl" , s__MilimSpells___MilimEKS_x[this] , s__MilimSpells___MilimEKS_y[this] , GetRandomReal(0, 359) , GetRandomReal(1.5, 2) , 5.25 , GetRandomReal(240, 365)))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_NewDirtEXNofireNoDust.mdl" , s__MilimSpells___MilimEKS_x[this] , s__MilimSpells___MilimEKS_y[this] , GetRandomReal(0, 359) , 1 , 1.5 , 0))
                        call DecorRemove(s__MilimSpells___MilimEKS_c[this] , s__MilimSpells___MilimEKS_x[this] , s__MilimSpells___MilimEKS_y[this] , s__MilimSpells___MilimEKS_aoe[this] , 40)
                        call GroupClear(s__MilimSpells___MilimEKS_g[this])
                        call GroupEnumUnitsInRange(s__MilimSpells___MilimEKS_g[this], s__MilimSpells___MilimEKS_x[this], s__MilimSpells___MilimEKS_y[this], s__MilimSpells___MilimEKS_aoe[this], NoDecor_Cond)
                        loop
                            set s__MilimSpells___MilimEKS_u[this]=FirstOfGroup(s__MilimSpells___MilimEKS_g[this])
                            exitwhen s__MilimSpells___MilimEKS_u[this] == null or s__MilimSpells___MilimEKS_r[this] == 999
                            if SpellBool(s__MilimSpells___MilimEKS_u[this]) and IsUnitEnemy(s__MilimSpells___MilimEKS_u[this], GetOwningPlayer(s__MilimSpells___MilimEKS_c[this])) and IsUnitInGroup(s__MilimSpells___MilimEKS_u[this], s__MilimSpells___MilimEKS_g2[this]) == false then
                            call GroupAddUnit(s__MilimSpells___MilimEKS_g2[this], s__MilimSpells___MilimEKS_u[this])
                            call dmgmag(s__MilimSpells___MilimEKS_c[this] , s__MilimSpells___MilimEKS_u[this] , s__MilimSpells___MilimEKS_dmg[this])
                            endif
                            call GroupRemoveUnit(s__MilimSpells___MilimEKS_g[this], s__MilimSpells___MilimEKS_u[this])
                        endloop
                        set s__MilimSpells___MilimEKS_u[this]=null
                        else
                        set s__MilimSpells___MilimEKS_r2[this]=s__MilimSpells___MilimEKS_r2[this] + 0.03
                        endif
                    endif
                else
                      call StopSpellUnit2(s__MilimSpells___MilimEKS_c[this])
                    call BlinkEff(s__MilimSpells___MilimEKS_c[this])
                    call SetFly(s__MilimSpells___MilimEKS_c[this] , 0)
                    
                     //   call BlzSetSpecialEffectPitch(e,-120*bj_DEGTORAD)
                    //call BlzPlaySpecialEffect(e,ANIM_TYPE_DEATH)
                    if s__MilimSpells___MilimEKS_check[this] < 20 then
                    call ColorEffDummy3Alpha((s__MilimSpells___MilimEKS_e[this] ) , (( 0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.35)*1.0)) // INLINED!!
                    endif
                    call SetUnitTimeScale(s__MilimSpells___MilimEKS_c[this], 1)
                    call DestroyGroup(s__MilimSpells___MilimEKS_g[this])
                    call DestroyGroup(s__MilimSpells___MilimEKS_g2[this])
                    set s__MilimSpells___MilimEKS_g[this]=null
                    set s__MilimSpells___MilimEKS_g2[this]=null
                    set s__MilimSpells___MilimEKS_c[this]=null
                    set s__MilimSpells___MilimEKS_e[this]=null
                    set s__MilimSpells___MilimEKS_u[this]=null
                    set s__MilimSpells___MilimEKS_m_MilimE[i]=s__MilimSpells___MilimEKS_m_MilimE[s__MilimSpells___MilimEKS_MUI_MilimE]
                    set s__MilimSpells___MilimEKS_MUI_MilimE=s__MilimSpells___MilimEKS_MUI_MilimE - 1
                    if s__MilimSpells___MilimEKS_MUI_MilimE == - 1 then
                        call PauseTimer(s__MilimSpells___MilimEKS_t_MilimE)
                    endif
                    call s__MilimSpells___MilimEKS_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction
        function s__MilimSpells___MilimEKS_MilimE_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__MilimSpells___MilimEKS__allocate()
            local real mm= 0
            set s__MilimSpells___MilimEKS_MUI_MilimE=s__MilimSpells___MilimEKS_MUI_MilimE + 1
            set s__MilimSpells___MilimEKS_m_MilimE[s__MilimSpells___MilimEKS_MUI_MilimE]=this
            set s__MilimSpells___MilimEKS_c[this]=NewC
            set s__MilimSpells___MilimEKS_x[this]=NewX
            set s__MilimSpells___MilimEKS_y[this]=NewY
            set s__MilimSpells___MilimEKS_x1[this]=GetUnitX(s__MilimSpells___MilimEKS_c[this])
            set s__MilimSpells___MilimEKS_y1[this]=GetUnitY(s__MilimSpells___MilimEKS_c[this])
            set s__MilimSpells___MilimEKS_r[this]=0
            set s__MilimSpells___MilimEKS_r2[this]=0
            set s__MilimSpells___MilimEKS_move[this]=80
            set s__MilimSpells___MilimEKS_r5[this]=0
            set s__MilimSpells___MilimEKS_a[this]=GAngle2(s__MilimSpells___MilimEKS_c[this] , s__MilimSpells___MilimEKS_x[this] , s__MilimSpells___MilimEKS_y[this]) // Angle Between points
            set s__MilimSpells___MilimEKS_r4[this]=MilimE_RangeBase + ( MilimE_RangeStep * ( GetUnitAbilityLevel(s__MilimSpells___MilimEKS_c[this], MilimE_ID) - 1 ) )
            
            call StartSpellUnit2(s__MilimSpells___MilimEKS_c[this])
            call BlinkEff(s__MilimSpells___MilimEKS_c[this])
            set mm=SR3(s__MilimSpells___MilimEKS_c[this] , s__MilimSpells___MilimEKS_x[this] , s__MilimSpells___MilimEKS_y[this])
            if mm < 700 then
                call PosUnit(s__MilimSpells___MilimEKS_c[this] , s__MilimSpells___MilimEKS_x1[this] - ( 700 - mm ) * Cos(s__MilimSpells___MilimEKS_a[this]) , s__MilimSpells___MilimEKS_y1[this] - ( 700 - mm ) * Sin(s__MilimSpells___MilimEKS_a[this]))
            endif
            set s__MilimSpells___MilimEKS_x1[this]=GetUnitX(s__MilimSpells___MilimEKS_c[this])
            set s__MilimSpells___MilimEKS_y1[this]=GetUnitY(s__MilimSpells___MilimEKS_c[this])
            call SetFly(s__MilimSpells___MilimEKS_c[this] , 700)
            set s__MilimSpells___MilimEKS_scale[this]=0.5
            set s__MilimSpells___MilimEKS_r5[this]=600
            set s__MilimSpells___MilimEKS_g[this]=CreateGroup()
            set s__MilimSpells___MilimEKS_g2[this]=CreateGroup()
            set s__MilimSpells___MilimEKS_u[this]=null
            set s__MilimSpells___MilimEKS_aoe[this]=MilimE_DamageAoe
            set s__MilimSpells___MilimEKS_dmg[this]=GetHeroAgi(s__MilimSpells___MilimEKS_c[this], true) * ( MilimE_DamageAgiBase + ( MilimE_DamageAgiStep * ( GetUnitAbilityLevel(s__MilimSpells___MilimEKS_c[this], MilimE_ID) - 1 ) ) )
            if LoadInteger(hs, GetHandleId(s__MilimSpells___MilimEKS_c[this]), StringHash("mode t")) == 1 then
                set s__MilimSpells___MilimEKS_dmg[this]=s__MilimSpells___MilimEKS_dmg[this] + MilimT_DmgAdd * GetHeroAgi(s__MilimSpells___MilimEKS_c[this], true)
            endif
            
            set s__MilimSpells___MilimEKS_rmax[this]=1.11
            call SetUnitAnimationByIndex(s__MilimSpells___MilimEKS_c[this], 7)
            call SetUnitTimeScale(s__MilimSpells___MilimEKS_c[this], 0.95)
            call MakeSound("war3mapimported\\Hero_Milim_E")
            if s__MilimSpells___MilimEKS_MUI_MilimE == 0 then
                call TimerStart(s__MilimSpells___MilimEKS_t_MilimE, 0.03, true, function s__MilimSpells___MilimEKS_Loop_MilimE)
            endif
        endfunction
   
    // Ýòîò áëîê ìîæíî îáúåäèíèòü ñ ñóùåñòâóþùèì globals áèáëèîòåêè MilimSpells.


// Ïîëíîñòüþ îòâå÷àåò çà ïîë¸ò îäíîãî ñíàðÿäà, çàäåðæêó è âçðûâ.


    function s__MilimSpells___MilimRProjectileKS_Loop_MilimRProjectile takes nothing returns nothing
        local integer this
        local integer i= 0
        local real progress
        local real ellipseProgress
        local real ellipseOffset
        local real oldX
        local real oldY
        local real moveDistance
        local real moveAngle
        local real x
        local real y
        local integer sharedGroupId
        local integer remainingProjectiles

        loop
            exitwhen i > s__MilimSpells___MilimRProjectileKS_MUI_MilimRProjectile
            set this=s__MilimSpells___MilimRProjectileKS_m_MilimRProjectile[i]

            if s__MilimSpells___MilimRProjectileKS_check[this] == 0 then
                set s__MilimSpells___MilimRProjectileKS_r[this]=s__MilimSpells___MilimRProjectileKS_r[this] + 0.03
                if s__MilimSpells___MilimRProjectileKS_r[this] > s__MilimSpells___MilimRProjectileKS_rmax[this] then
                    set s__MilimSpells___MilimRProjectileKS_r[this]=s__MilimSpells___MilimRProjectileKS_rmax[this]
                endif

                set progress=s__MilimSpells___MilimRProjectileKS_r[this] / s__MilimSpells___MilimRProjectileKS_rmax[this]

                // Ïîëîâèíà ýëëèïñà: ñòàðò è ôèíèø ñîâïàäàþò ñ çàäàííûìè òî÷êàìè,
                // à arcSide âûáèðàåò çàêðóãëåíèå íà +90 èëè -90 ãðàäóñîâ.
                set ellipseProgress=0.50 - 0.50 * Cos(bj_PI * progress)
                set ellipseOffset=Sin(bj_PI * progress) * s__MilimSpells___MilimRProjectileKS_arcSize[this] * s__MilimSpells___MilimRProjectileKS_arcSide[this]
                set oldX=s__MilimSpells___MilimRProjectileKS_currentX[this]
                set oldY=s__MilimSpells___MilimRProjectileKS_currentY[this]
                set s__MilimSpells___MilimRProjectileKS_currentX[this]=s__MilimSpells___MilimRProjectileKS_startX[this] + ( s__MilimSpells___MilimRProjectileKS_targetX[this] - s__MilimSpells___MilimRProjectileKS_startX[this] ) * ellipseProgress + ellipseOffset * Cos(s__MilimSpells___MilimRProjectileKS_a[this] + 90.00 * bj_DEGTORAD)
                set s__MilimSpells___MilimRProjectileKS_currentY[this]=s__MilimSpells___MilimRProjectileKS_startY[this] + ( s__MilimSpells___MilimRProjectileKS_targetY[this] - s__MilimSpells___MilimRProjectileKS_startY[this] ) * ellipseProgress + ellipseOffset * Sin(s__MilimSpells___MilimRProjectileKS_a[this] + 90.00 * bj_DEGTORAD)

                call BlzSetSpecialEffectPosition(s__MilimSpells___MilimRProjectileKS_e[this], s__MilimSpells___MilimRProjectileKS_currentX[this], s__MilimSpells___MilimRProjectileKS_currentY[this], s__MilimSpells___MilimRProjectileKS_fly[this])
                call BlzSetSpecialEffectYaw(s__MilimSpells___MilimRProjectileKS_e[this], Atan2(s__MilimSpells___MilimRProjectileKS_currentY[this] - oldY, s__MilimSpells___MilimRProjectileKS_currentX[this] - oldX))
                call BlzSetSpecialEffectPosition(s__MilimSpells___MilimRProjectileKS_e2[this], s__MilimSpells___MilimRProjectileKS_currentX[this], s__MilimSpells___MilimRProjectileKS_currentY[this], s__MilimSpells___MilimRProjectileKS_fly[this])
                call BlzSetSpecialEffectYaw(s__MilimSpells___MilimRProjectileKS_e2[this], Atan2(s__MilimSpells___MilimRProjectileKS_currentY[this] - oldY, s__MilimSpells___MilimRProjectileKS_currentX[this] - oldX))
                set moveDistance=SquareRoot(( s__MilimSpells___MilimRProjectileKS_currentX[this] - oldX ) * ( s__MilimSpells___MilimRProjectileKS_currentX[this] - oldX ) + ( s__MilimSpells___MilimRProjectileKS_currentY[this] - oldY ) * ( s__MilimSpells___MilimRProjectileKS_currentY[this] - oldY ))
                set moveAngle=Atan2(s__MilimSpells___MilimRProjectileKS_currentY[this] - oldY, s__MilimSpells___MilimRProjectileKS_currentX[this] - oldX)

                if s__MilimSpells___MilimRProjectileKS_r2[this] >= MilimR_CarryScanPeriod then
                    set s__MilimSpells___MilimRProjectileKS_r2[this]=0.00
                    call GroupEnumUnitsInRange(s__MilimSpells___MilimRProjectileKS_g[this], s__MilimSpells___MilimRProjectileKS_currentX[this], s__MilimSpells___MilimRProjectileKS_currentY[this], MilimR_CarryAoe, NoDecor_Cond)
                    loop
                        set s__MilimSpells___MilimRProjectileKS_u[this]=FirstOfGroup(s__MilimSpells___MilimRProjectileKS_g[this])
                        exitwhen s__MilimSpells___MilimRProjectileKS_u[this] == null
                        if SpellBool(s__MilimSpells___MilimRProjectileKS_u[this]) and IsUnitEnemy(s__MilimSpells___MilimRProjectileKS_u[this], GetOwningPlayer(s__MilimSpells___MilimRProjectileKS_c[this])) and not IsUnitInGroup(s__MilimSpells___MilimRProjectileKS_u[this], s__MilimSpells___MilimRProjectileKS_g4[this]) then
                            call GroupAddUnit(s__MilimSpells___MilimRProjectileKS_g3[this], s__MilimSpells___MilimRProjectileKS_u[this])
                            call GroupAddUnit(s__MilimSpells___MilimRProjectileKS_g4[this], s__MilimSpells___MilimRProjectileKS_u[this])
                        endif
                        call GroupRemoveUnit(s__MilimSpells___MilimRProjectileKS_g[this], s__MilimSpells___MilimRProjectileKS_u[this])
                    endloop
                else
                    set s__MilimSpells___MilimRProjectileKS_r2[this]=s__MilimSpells___MilimRProjectileKS_r2[this] + 0.03
                endif

                call GroupClear(s__MilimSpells___MilimRProjectileKS_g[this])
                loop
                    set s__MilimSpells___MilimRProjectileKS_u[this]=FirstOfGroup(s__MilimSpells___MilimRProjectileKS_g3[this])
                    exitwhen s__MilimSpells___MilimRProjectileKS_u[this] == null
                    call GroupRemoveUnit(s__MilimSpells___MilimRProjectileKS_g3[this], s__MilimSpells___MilimRProjectileKS_u[this])
                    if SpellBool(s__MilimSpells___MilimRProjectileKS_u[this]) then
                        call MoveUnit(s__MilimSpells___MilimRProjectileKS_u[this] , moveDistance , moveAngle)
                        call GroupAddUnit(s__MilimSpells___MilimRProjectileKS_g[this], s__MilimSpells___MilimRProjectileKS_u[this])
                    else
                        call GroupRemoveUnit(s__MilimSpells___MilimRProjectileKS_g4[this], s__MilimSpells___MilimRProjectileKS_u[this])
                    endif
                endloop
                loop
                    set s__MilimSpells___MilimRProjectileKS_u[this]=FirstOfGroup(s__MilimSpells___MilimRProjectileKS_g[this])
                    exitwhen s__MilimSpells___MilimRProjectileKS_u[this] == null
                    call GroupRemoveUnit(s__MilimSpells___MilimRProjectileKS_g[this], s__MilimSpells___MilimRProjectileKS_u[this])
                    call GroupAddUnit(s__MilimSpells___MilimRProjectileKS_g3[this], s__MilimSpells___MilimRProjectileKS_u[this])
                endloop

                if s__MilimSpells___MilimRProjectileKS_visionTick[this] >= MilimR_VisionPeriod then
                    set s__MilimSpells___MilimRProjectileKS_visionTick[this]=0.00
                    call VisionTimed(GetOwningPlayer(s__MilimSpells___MilimRProjectileKS_c[this]) , s__MilimSpells___MilimRProjectileKS_currentX[this] , s__MilimSpells___MilimRProjectileKS_currentY[this] , MilimR_DamageAoe * 2.00 , MilimR_VisionPeriod * 2.00)
                else
