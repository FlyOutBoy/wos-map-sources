                call BlzFrameSetMinMaxValue(s__GearSystems2___KS_BuffTimer_frame0_pas3[s__GearSystems2___KS_BuffTimer_k2[this]], 0, s__GearSystems2___KS_BuffTimer_rmax[this])
                call BlzFrameSetValue(s__GearSystems2___KS_BuffTimer_frame0_pas2[s__GearSystems2___KS_BuffTimer_k2[this]], 100)
                call BlzFrameSetValue(s__GearSystems2___KS_BuffTimer_frame0_pas3[s__GearSystems2___KS_BuffTimer_k2[this]], 0)
                call BlzFrameSetText(s__GearSystems2___KS_BuffTimer_frame0_pas4[s__GearSystems2___KS_BuffTimer_k2[this]], "" + R2SW(s__GearSystems2___KS_BuffTimer_rmax[this], 0, 1) + "|r")
                call BlzFrameSetAbsPoint(s__GearSystems2___KS_BuffTimer_frame0_pas1[s__GearSystems2___KS_BuffTimer_k2[this]], FRAMEPOINT_CENTER, tmp_x, tmp_y)
                call BlzFrameSetTexture(s__GearSystems2___KS_BuffTimer_frame0_pas2[s__GearSystems2___KS_BuffTimer_k2[this]], "ReplaceableTextures\\CommandButtons\\" + s__GearSystems2___KS_BuffTimer_s[this] + ".blp", 0, false)
                call BlzFrameSetTexture(s__GearSystems2___KS_BuffTimer_frame0_pas3[s__GearSystems2___KS_BuffTimer_k2[this]], "ReplaceableTextures\\CommandButtonsDisabled\\DIS" + s__GearSystems2___KS_BuffTimer_s[this] + ".blp", 0, false)
                
                    call BlzFrameSetEnable(s__GearSystems2___KS_BuffTimer_frame0_pas1[s__GearSystems2___KS_BuffTimer_k2[this]], false)
                    call BlzFrameSetEnable(s__GearSystems2___KS_BuffTimer_frame0_pas2[s__GearSystems2___KS_BuffTimer_k2[this]], false)
                    call BlzFrameSetEnable(s__GearSystems2___KS_BuffTimer_frame0_pas3[s__GearSystems2___KS_BuffTimer_k2[this]], false)
                    call BlzFrameSetEnable(s__GearSystems2___KS_BuffTimer_frame0_pas4[s__GearSystems2___KS_BuffTimer_k2[this]], false)
                set s__GearSystems2___KS_BuffTimer_r[this]=0
            if s__GearSystems2___KS_BuffTimer_MUI_28 == 0 then
                call GearTimer10Acquire()
            endif
        endfunction



        function s__GearSystems2___KS_BuffEffect_Loop_MyBuffEff takes nothing returns nothing
            local integer this
