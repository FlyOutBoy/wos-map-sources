                    endif

                elseif s__TojiSpells___TojiSpells_W_state[this] == 3 then
                    if s__TojiSpells___TojiSpells_W_td[this] == null or GetUnitTypeId(s__TojiSpells___TojiSpells_W_td[this]) == 0 or GetWidgetLife(s__TojiSpells___TojiSpells_W_td[this]) <= 0.405 or GetUnitAbilityLevel(s__TojiSpells___TojiSpells_W_td[this], TojiW_Debuff_ID) == 0 then
                        set remove=true
                    else
                        set s__TojiSpells___TojiSpells_W_r[this]=RoundReal(s__TojiSpells___TojiSpells_W_r[this] + 0.03 , 3)
                        set s__TojiSpells___TojiSpells_W_pullElapsed[this]=RoundReal(s__TojiSpells___TojiSpells_W_pullElapsed[this] + 0.03 , 3)
                        set step=s__TojiSpells___TojiSpells_W_pullMove[this]
                        if step > s__TojiSpells___TojiSpells_W_pullRemaining[this] then
                            set step=s__TojiSpells___TojiSpells_W_pullRemaining[this]
                        endif
                        if step > 0.0 and GetUnitAbilityLevel(s__TojiSpells___TojiSpells_W_td[this], 'Avul') == 0 then
                            call MoveUnit(s__TojiSpells___TojiSpells_W_td[this] , step , s__TojiSpells___TojiSpells_W_pullAngle[this])
                            set s__TojiSpells___TojiSpells_W_pullRemaining[this]=s__TojiSpells___TojiSpells_W_pullRemaining[this] - step
                        endif
                        
                        // Срабатывает один раз в момент завершения притягивания:
                        if s__TojiSpells___TojiSpells_W_pullElapsed[this] >= TojiW2_PullDuration or s__TojiSpells___TojiSpells_W_pullRemaining[this] <= 0.5 then
                            call DecorRemove(s__TojiSpells___TojiSpells_W_c[this] , GetUnitX(s__TojiSpells___TojiSpells_W_td[this]) , GetUnitY(s__TojiSpells___TojiSpells_W_td[this]) , 350 , TojiW2_DecorDamage)
                            set s__TojiSpells___TojiSpells_W_state[this]=1
                        endif

                        set dx=GetUnitX(s__TojiSpells___TojiSpells_W_td[this]) - GetUnitX(s__TojiSpells___TojiSpells_W_c[this])
                        set dy=GetUnitY(s__TojiSpells___TojiSpells_W_td[this]) - GetUnitY(s__TojiSpells___TojiSpells_W_c[this])
                        set distance=SquareRoot(dx * dx + dy * dy)
                        if distance > TojiW_ChainMaxRange then
                            set angle=Atan2(dy, dx)
                            call PosUnit(s__TojiSpells___TojiSpells_W_td[this] , GetUnitX(s__TojiSpells___TojiSpells_W_c[this]) + TojiW_ChainMaxRange * Cos(angle) , GetUnitY(s__TojiSpells___TojiSpells_W_c[this]) + TojiW_ChainMaxRange * Sin(angle))
                        endif
                        call MoveLightningEx(s__TojiSpells___TojiSpells_W_chain[this], true, GetUnitX(s__TojiSpells___TojiSpells_W_c[this]), GetUnitY(s__TojiSpells___TojiSpells_W_c[this]), 110.0, GetUnitX(s__TojiSpells___TojiSpells_W_td[this]), GetUnitY(s__TojiSpells___TojiSpells_W_td[this]), 110.0)
                        if s__TojiSpells___TojiSpells_W_r[this] >= TojiW_ChainDuration then
                            set remove=true
                        endif
                    endif
                endif

                if remove then
                    if s__TojiSpells___TojiSpells_W_c[this] != null then
                        call SetPlayerAbilityAvailable(GetOwningPlayer(s__TojiSpells___TojiSpells_W_c[this]), TojiW2_ID, false)
                        call SetPlayerAbilityAvailable(GetOwningPlayer(s__TojiSpells___TojiSpells_W_c[this]), TojiW_ID, true)
                    endif
                    if s__TojiSpells___TojiSpells_W_e[this] != null then
                        call DestroyEffect(s__TojiSpells___TojiSpells_W_e[this])
                    endif
                    if s__TojiSpells___TojiSpells_W_e2[this] != null then
                        call DestroyEffect(s__TojiSpells___TojiSpells_W_e2[this])
                    endif
                    if s__TojiSpells___TojiSpells_W_chain[this] != null then
                        call DestroyLightning(s__TojiSpells___TojiSpells_W_chain[this])
                    endif
                    if s__TojiSpells___TojiSpells_W_g[this] != null then
                        call DestroyGroup(s__TojiSpells___TojiSpells_W_g[this])
                    endif
                    set s__TojiSpells___TojiSpells_W_e[this]=null
                    set s__TojiSpells___TojiSpells_W_e2[this]=null
                    set s__TojiSpells___TojiSpells_W_chain[this]=null
                    set s__TojiSpells___TojiSpells_W_g[this]=null
                    set s__TojiSpells___TojiSpells_W_td[this]=null
                    set s__TojiSpells___TojiSpells_W_c[this]=null
                    call s__TojiSpells___TojiSpells_W_deallocate(this)
                    set s__TojiSpells___TojiSpells_W_m_TojiW[i]=s__TojiSpells___TojiSpells_W_m_TojiW[s__TojiSpells___TojiSpells_W_MUI_TojiW]
                    set s__TojiSpells___TojiSpells_W_MUI_TojiW=s__TojiSpells___TojiSpells_W_MUI_TojiW - 1
                    if s__TojiSpells___TojiSpells_W_MUI_TojiW == - 1 then
                        call TojiSpells___TojiTimer03Release()
                    endif
                else
                    set i=i + 1
                endif
            endloop
            set picked=null
        endfunction

        function s__TojiSpells___TojiSpells_W_TojiW_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__TojiSpells___TojiSpells_W__allocate()
            set s__TojiSpells___TojiSpells_W_MUI_TojiW=s__TojiSpells___TojiSpells_W_MUI_TojiW + 1
            set s__TojiSpells___TojiSpells_W_m_TojiW[s__TojiSpells___TojiSpells_W_MUI_TojiW]=this
            set s__TojiSpells___TojiSpells_W_c[this]=NewC
            set s__TojiSpells___TojiSpells_W_td[this]=null
            set s__TojiSpells___TojiSpells_W_g[this]=CreateGroup()
            set s__TojiSpells___TojiSpells_W_state[this]=0
            set s__TojiSpells___TojiSpells_W_level[this]=GetUnitAbilityLevel(NewC, TojiW_ID)
            if s__TojiSpells___TojiSpells_W_level[this] < 1 then
                set s__TojiSpells___TojiSpells_W_level[this]=1
            endif
            set s__TojiSpells___TojiSpells_W_a[this]=GAngle2(NewC , NewX , NewY)
            set s__TojiSpells___TojiSpells_W_x[this]=GetUnitX(NewC) + 75.0 * Cos(s__TojiSpells___TojiSpells_W_a[this])
            set s__TojiSpells___TojiSpells_W_y[this]=GetUnitY(NewC) + 75.0 * Sin(s__TojiSpells___TojiSpells_W_a[this])
            set s__TojiSpells___TojiSpells_W_r[this]=0.0
            set s__TojiSpells___TojiSpells_W_r6[this]=0.0
            set s__TojiSpells___TojiSpells_W_r7[this]=TojiW_RangeBase + TojiW_RangeStep * ( s__TojiSpells___TojiSpells_W_level[this] - 1 )
            set s__TojiSpells___TojiSpells_W_move[this]=TojiW_MoveBase + TojiW_MoveStep * ( s__TojiSpells___TojiSpells_W_level[this] - 1 )
            set s__TojiSpells___TojiSpells_W_dmg[this]=GetHeroAgi(NewC, true) * ( TojiW_DamageAgiBase + TojiW_DamageAgiStep * ( s__TojiSpells___TojiSpells_W_level[this] - 1 ) )
            set s__TojiSpells___TojiSpells_W_dmg[this]=s__TojiSpells___TojiSpells_W_dmg[this] + TojiW_Damage2StaticBase + TojiW_Damage2StaticStep * ( s__TojiSpells___TojiSpells_W_level[this] - 1 )
            set s__TojiSpells___TojiSpells_W_dmg[this]=s__TojiSpells___TojiSpells_W_dmg[this] + TojiSpells___TojiE_ConsumeLeapBonus(NewC)
            call MakeSound("war3mapimported\\Hero_Toji_W 1")
            set s__TojiSpells___TojiSpells_W_tdMoveSpeed[this]=0.0
            set s__TojiSpells___TojiSpells_W_tdSlowSpeed[this]=0.0
            set s__TojiSpells___TojiSpells_W_e2[this]=null
            set s__TojiSpells___TojiSpells_W_pullAngle[this]=0.0
            set s__TojiSpells___TojiSpells_W_pullMove[this]=0.0
            set s__TojiSpells___TojiSpells_W_pullRemaining[this]=0.0
            set s__TojiSpells___TojiSpells_W_pullElapsed[this]=0.0
            set s__TojiSpells___TojiSpells_W_e[this]=AddSpecialEffect("war3mapImported\\wos_hook1.mdl", s__TojiSpells___TojiSpells_W_x[this], s__TojiSpells___TojiSpells_W_y[this])
            call BlzSetSpecialEffectScale(s__TojiSpells___TojiSpells_W_e[this], 2.10)
            call BlzSetSpecialEffectYaw(s__TojiSpells___TojiSpells_W_e[this], s__TojiSpells___TojiSpells_W_a[this])
            call BlzSetSpecialEffectZ(s__TojiSpells___TojiSpells_W_e[this], 110.0)
            set s__TojiSpells___TojiSpells_W_chain[this]=AddLightningEx("TJ01", true, GetUnitX(NewC), GetUnitY(NewC), 110.0, s__TojiSpells___TojiSpells_W_x[this], s__TojiSpells___TojiSpells_W_y[this], 110.0)
            call SetUnitFacing(NewC, s__TojiSpells___TojiSpells_W_a[this] * bj_RADTODEG)
            call SetUnitAnimationByIndex(NewC, 13)
            call MakeSound("war3mapImported\\Hero_Toji_W")
            call VisionTimed(GetOwningPlayer(NewC) , NewX , NewY , 750 , 6)
            if s__TojiSpells___TojiSpells_W_MUI_TojiW == 0 then
                call TojiSpells___TojiTimer03Acquire()
            endif
        endfunction

        function s__TojiSpells___TojiSpells_W_TojiW2_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer i= 0
            local integer this
            local real casterX
            local real casterY
            local real targetX
            local real targetY
            local real baseAngle
            local real difference
            local real distance
            local real inward
            local real sideAngle
            local real pullDistance
            local integer pid
            local real tojiDx
            local real tojiDy
            loop
                exitwhen i > s__TojiSpells___TojiSpells_W_MUI_TojiW
                set this=s__TojiSpells___TojiSpells_W_m_TojiW[i]
                if s__TojiSpells___TojiSpells_W_c[this] == NewC and s__TojiSpells___TojiSpells_W_state[this] == 1 then
                    set casterX=GetUnitX(NewC)
                    set casterY=GetUnitY(NewC)
                    set targetX=GetUnitX(s__TojiSpells___TojiSpells_W_td[this])
                    set targetY=GetUnitY(s__TojiSpells___TojiSpells_W_td[this])
                    set baseAngle=Atan2(targetY - casterY, targetX - casterX)
                    set difference=( NewX - targetX ) * Cos(baseAngle + bj_PI * 0.5) + ( NewY - targetY ) * Sin(baseAngle + bj_PI * 0.5)
                    set distance=SquareRoot(( targetX - casterX ) * ( targetX - casterX ) + ( targetY - casterY ) * ( targetY - casterY ))
                    if difference <= TojiW2_SideClickDeadzone and difference >= - TojiW2_SideClickDeadzone then
                        set inward=TojiW2_CenterPullRange
                        if inward > distance - 125.0 then
                            set inward=distance - 125.0
                        endif
                        if inward < 0.0 then
                            set inward=0.0
                        endif
                        set s__TojiSpells___TojiSpells_W_pullX[this]=targetX + inward * Cos(baseAngle + bj_PI)
                        set s__TojiSpells___TojiSpells_W_pullY[this]=targetY + inward * Sin(baseAngle + bj_PI)
                    else
                        set inward=TojiW2_SideInwardRange
                        if inward > distance - 125.0 then
                            set inward=distance - 125.0
                        endif
                        if inward < 0.0 then
                            set inward=0.0
                        endif
                        if difference > 0.0 then
                            set sideAngle=baseAngle + bj_PI * 0.5
                        else
                            set sideAngle=baseAngle - bj_PI * 0.5
                        endif
                        set s__TojiSpells___TojiSpells_W_pullX[this]=targetX + TojiW2_SidePullRange * Cos(sideAngle) + inward * Cos(baseAngle + bj_PI)
                        set s__TojiSpells___TojiSpells_W_pullY[this]=targetY + TojiW2_SidePullRange * Sin(sideAngle) + inward * Sin(baseAngle + bj_PI)
                    endif
                    set pullDistance=SquareRoot(( s__TojiSpells___TojiSpells_W_pullX[this] - targetX ) * ( s__TojiSpells___TojiSpells_W_pullX[this] - targetX ) + ( s__TojiSpells___TojiSpells_W_pullY[this] - targetY ) * ( s__TojiSpells___TojiSpells_W_pullY[this] - targetY ))
                    set s__TojiSpells___TojiSpells_W_pullAngle[this]=Atan2(s__TojiSpells___TojiSpells_W_pullY[this] - targetY, s__TojiSpells___TojiSpells_W_pullX[this] - targetX)
                    set s__TojiSpells___TojiSpells_W_pullRemaining[this]=pullDistance
                    set s__TojiSpells___TojiSpells_W_pullElapsed[this]=0.0
                    if TojiW2_PullDuration > 0.03 then
                        set s__TojiSpells___TojiSpells_W_pullMove[this]=pullDistance / ( TojiW2_PullDuration / 0.03 )
                    else
                        set s__TojiSpells___TojiSpells_W_pullMove[this]=pullDistance
                    endif
                    if s__TojiSpells___TojiSpells_W_pullMove[this] < 0.0 then
                        set s__TojiSpells___TojiSpells_W_pullMove[this]=0.0
                    endif
                    set s__TojiSpells___TojiSpells_W_state[this]=3
                    call MakeSound("war3mapImported\\Hero_Toji_W2 1")

                    // Возобновление движения на бегу
                    set pid=GetPlayerId(GetOwningPlayer(NewC))
                    set tojiDx=TojiSpells___Toji_LastOrderX[pid] - casterX
                    set tojiDy=TojiSpells___Toji_LastOrderY[pid] - casterY
                    if TojiSpells___Toji_IsMoving[pid] and ( tojiDx * tojiDx + tojiDy * tojiDy > 100.0 * 100.0 ) then
                        call IssuePointOrder(NewC, "move", TojiSpells___Toji_LastOrderX[pid], TojiSpells___Toji_LastOrderY[pid])
                    endif

                    set i=s__TojiSpells___TojiSpells_W_MUI_TojiW + 1
                else
                    set i=i + 1
                endif
            endloop
        endfunction



        function s__TojiSpells___TojiSpells_E_Loop_TojiE takes nothing returns nothing
            local integer i= 0
            local integer this
            local unit target
            local real step
            local boolean remove
            loop
                exitwhen i > s__TojiSpells___TojiSpells_E_MUI_TojiE
                set this=s__TojiSpells___TojiSpells_E_m_TojiE[i]
                set remove=false

                if s__TojiSpells___TojiSpells_E_c[this] == null or GetUnitTypeId(s__TojiSpells___TojiSpells_E_c[this]) == 0 or GetWidgetLife(s__TojiSpells___TojiSpells_E_c[this]) <= 0.405 then
                    set remove=true
                elseif s__TojiSpells___TojiSpells_E_traveled[this] < s__TojiSpells___TojiSpells_E_distance[this] then
                    set step=s__TojiSpells___TojiSpells_E_move[this]
                    if s__TojiSpells___TojiSpells_E_r2[this] > 0.0 then
                        set s__TojiSpells___TojiSpells_E_r2[this]=0.0
                        call DecorRemove(s__TojiSpells___TojiSpells_E_c[this] , GetUnitX(s__TojiSpells___TojiSpells_E_c[this]) , GetUnitY(s__TojiSpells___TojiSpells_E_c[this]) , TojiE_HitAoe , TojiE_DecorDamage)
                    else
                        set s__TojiSpells___TojiSpells_E_r2[this]=s__TojiSpells___TojiSpells_E_r2[this] + 0.03
                    endif
                    call MoveUnit(s__TojiSpells___TojiSpells_E_c[this] , step , s__TojiSpells___TojiSpells_E_a[this])
                    call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_blackblink.mdx" , GetUnitX(s__TojiSpells___TojiSpells_E_c[this]) , GetUnitY(s__TojiSpells___TojiSpells_E_c[this]) , s__TojiSpells___TojiSpells_E_a[this] * bj_RADTODEG + 90 , 3 , 1.35 , GetUnitFlyHeight(s__TojiSpells___TojiSpells_E_c[this]) , 0 , 0 , 0 , 255))
                    set s__TojiSpells___TojiSpells_E_traveled[this]=s__TojiSpells___TojiSpells_E_traveled[this] + step
                    call BlzSetSpecialEffectPosition(s__TojiSpells___TojiSpells_E_e[this], GetUnitX(s__TojiSpells___TojiSpells_E_c[this]), GetUnitY(s__TojiSpells___TojiSpells_E_c[this]), 50.0)

                    if s__TojiSpells___TojiSpells_E_level25[this] then
                        call GroupClear(s__TojiSpells___TojiSpells_E_scanGroup[this])
                        call GroupEnumUnitsInRange(s__TojiSpells___TojiSpells_E_scanGroup[this], GetUnitX(s__TojiSpells___TojiSpells_E_c[this]), GetUnitY(s__TojiSpells___TojiSpells_E_c[this]), TojiE_HitAoe, Condition(function NoDecor_Filter))
                        loop
                            set target=FirstOfGroup(s__TojiSpells___TojiSpells_E_scanGroup[this])
                            exitwhen target == null
                            call GroupRemoveUnit(s__TojiSpells___TojiSpells_E_scanGroup[this], target)
                            if IsUnitEnemy(target, GetOwningPlayer(s__TojiSpells___TojiSpells_E_c[this])) and SpellBool(target) and not IsUnitInGroup(target, s__TojiSpells___TojiSpells_E_hitGroup[this]) then
                                call GroupAddUnit(s__TojiSpells___TojiSpells_E_hitGroup[this], target)
                                call dmgphys(s__TojiSpells___TojiSpells_E_c[this] , target , TojiSpells___TojiAbilityDamage(s__TojiSpells___TojiSpells_E_c[this] , target , s__TojiSpells___TojiSpells_E_attackDamage[this]))
                                call MUE(target , TojiE_Level25ThrowRange , TojiE_Level25ThrowDuration , s__TojiSpells___TojiSpells_E_a[this])
                                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", target, "chest"))
                            endif
                        endloop
                    endif
                    if s__TojiSpells___TojiSpells_E_traveled[this] >= s__TojiSpells___TojiSpells_E_distance[this] then
                        set remove=true
                    endif
                else
                    set remove=true
                endif

                if remove then
                    if s__TojiSpells___TojiSpells_E_c[this] != null then
                        call SetUnitTimeScale(s__TojiSpells___TojiSpells_E_c[this], 1.0)
                    endif
                    if s__TojiSpells___TojiSpells_E_e[this] != null then
                        call DestroyEffect(s__TojiSpells___TojiSpells_E_e[this])
                    endif
                    call DestroyGroup(s__TojiSpells___TojiSpells_E_scanGroup[this])
                    call DestroyGroup(s__TojiSpells___TojiSpells_E_hitGroup[this])
                    set s__TojiSpells___TojiSpells_E_e[this]=null
                    set s__TojiSpells___TojiSpells_E_scanGroup[this]=null
                    set s__TojiSpells___TojiSpells_E_hitGroup[this]=null
                    set s__TojiSpells___TojiSpells_E_c[this]=null
                    set target=null
                    call s__TojiSpells___TojiSpells_E_deallocate(this)
                    set s__TojiSpells___TojiSpells_E_m_TojiE[i]=s__TojiSpells___TojiSpells_E_m_TojiE[s__TojiSpells___TojiSpells_E_MUI_TojiE]
                    set s__TojiSpells___TojiSpells_E_MUI_TojiE=s__TojiSpells___TojiSpells_E_MUI_TojiE - 1
                    if s__TojiSpells___TojiSpells_E_MUI_TojiE == - 1 then
                        call TojiSpells___TojiTimer03Release()
                    endif
                else
                    set i=i + 1
                endif
            endloop
            set target=null
        endfunction

        function s__TojiSpells___TojiSpells_E_InitCharges takes unit whichUnit returns nothing
            local integer abilityLevel= GetUnitAbilityLevel(whichUnit, TojiE_ID)
            local real recharge
            if abilityLevel < 1 then
                set abilityLevel=1
            elseif abilityLevel > 5 then
                set abilityLevel=5
            endif
            set recharge=TojiE_RechargeBase - TojiE_RechargeStep * ( abilityLevel - 1 )
            call s__KS_SpellStacks_MyAddSpellStacks_Start((whichUnit ) , ( TojiE_ID ) , ( 0 ) , ( TojiE_MaxCharges ) , (( recharge)*1.0)) // INLINED!!
        endfunction

        function s__TojiSpells___TojiSpells_E_TojiE_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer abilityLevel= GetUnitAbilityLevel(NewC, TojiE_ID)
            local integer diceCount
            local integer diceSides
            local integer dice= 0
            local real startX= GetUnitX(NewC)
            local real startY= GetUnitY(NewC)
            local real dx= NewX - startX
            local real dy= NewY - startY
            local real targetDistance= SquareRoot(dx * dx + dy * dy)
            local real maxDistance
            local integer this
            
            if abilityLevel < 1 then
                set abilityLevel=1
            endif
            set maxDistance=TojiE_RangeBase + TojiE_RangeStep * ( abilityLevel - 1 )
            set targetDistance=maxDistance
            call s__TojiSpells___TojiSpells_E_InitCharges(NewC)
            if (LoadInteger(hs, GetHandleId(((NewC))), StringHash("stack_count"))) <= 0 and BlzGetUnitAbilityCooldownRemaining(NewC, TojiE_ID) <= 0.00 then // INLINED!!
                call s__KS_SpellStacks_AddStacks((NewC ) , ( 1)) // INLINED!!
            endif
            if not SpellStacksTryUse(NewC) then
                return
            endif

            if targetDistance <= 1.0 then
                if GetHeroLevel(NewC) >= 25 then
                    call TojiSpells___TojiE_AddLeapBuff(NewC)
                endif
                return
            endif

            set this=s__TojiSpells___TojiSpells_E__allocate()
            set s__TojiSpells___TojiSpells_E_MUI_TojiE=s__TojiSpells___TojiSpells_E_MUI_TojiE + 1
            set s__TojiSpells___TojiSpells_E_m_TojiE[s__TojiSpells___TojiSpells_E_MUI_TojiE]=this
            set s__TojiSpells___TojiSpells_E_c[this]=NewC
            set s__TojiSpells___TojiSpells_E_scanGroup[this]=CreateGroup()
            set s__TojiSpells___TojiSpells_E_hitGroup[this]=CreateGroup()
            set s__TojiSpells___TojiSpells_E_a[this]=Atan2(dy, dx)
            set s__TojiSpells___TojiSpells_E_traveled[this]=0.0
            call ColorDummy32(s__TojiSpells___TojiSpells_E_c[this] , 0 , 255 , 255 , 255 , 0.15)
            call ColorDummy4(s__TojiSpells___TojiSpells_E_c[this] , 0.3 , 255 , 255 , 255 , 0.15)
            set s__TojiSpells___TojiSpells_E_distance[this]=targetDistance
            if TojiE_DashDuration > 0.03 then
                set s__TojiSpells___TojiSpells_E_move[this]=targetDistance / ( TojiE_DashDuration / 0.03 )
            else
                set s__TojiSpells___TojiSpells_E_move[this]=targetDistance
            endif
            if s__TojiSpells___TojiSpells_E_move[this] < 1.0 then
                set s__TojiSpells___TojiSpells_E_move[this]=1.0
            endif
            set s__TojiSpells___TojiSpells_E_level25[this]=GetHeroLevel(NewC) >= 25
            set s__TojiSpells___TojiSpells_E_attackDamage[this]=0.0
            if s__TojiSpells___TojiSpells_E_level25[this] then
                set diceCount=BlzGetUnitDiceNumber(NewC, 0)
                set diceSides=BlzGetUnitDiceSides(NewC, 0)
                set s__TojiSpells___TojiSpells_E_attackDamage[this]=I2R(BlzGetUnitBaseDamage(NewC, 0))
                loop
                    exitwhen dice >= diceCount
                    set s__TojiSpells___TojiSpells_E_attackDamage[this]=s__TojiSpells___TojiSpells_E_attackDamage[this] + GetRandomInt(1, diceSides)
                    set dice=dice + 1
                endloop
                set s__TojiSpells___TojiSpells_E_attackDamage[this]=s__TojiSpells___TojiSpells_E_attackDamage[this] * ( TojiE_Level25DamageAtk / 100.00 ) + GetHeroAgi(NewC, true) * TojiE_Level25DamageAgi
                call TojiSpells___TojiE_AddLeapBuff(NewC)
            endif
            
            call BlzSetUnitFacingEx(s__TojiSpells___TojiSpells_E_c[this], s__TojiSpells___TojiSpells_E_a[this] * bj_RADTODEG)
            call SetUnitAnimationByIndex(NewC, 4)
