                    set s__BazzBSpells__BazzBSpells_Q_r[this]=RoundReal(s__BazzBSpells__BazzBSpells_Q_r[this] + 0.03 , 3)
                    if s__BazzBSpells__BazzBSpells_Q_check[this] == 0 then
                        call DebugUnit2(s__BazzBSpells__BazzBSpells_Q_c[this])
                        if s__BazzBSpells__BazzBSpells_Q_r[this] == 0.30 then
                            call DestroyEffect(EffectSpawn("war3mapimported\\wos_bdef (124)2.mdl" , GetUnitX(s__BazzBSpells__BazzBSpells_Q_c[this]) + 100.0 * Cos(s__BazzBSpells__BazzBSpells_Q_a[this]) , GetUnitY(s__BazzBSpells__BazzBSpells_Q_c[this]) + 100.0 * Sin(s__BazzBSpells__BazzBSpells_Q_a[this]) , s__BazzBSpells__BazzBSpells_Q_a[this] * bj_RADTODEG , 1.0 , 2.0 , 100.0))
                        endif
                        if s__BazzBSpells__BazzBSpells_Q_r[this] >= BazzBQ_CastTime then
                            call StopSpellUnit2(s__BazzBSpells__BazzBSpells_Q_c[this])
                            set s__BazzBSpells__BazzBSpells_Q_check[this]=1
                            set s__BazzBSpells__BazzBSpells_Q_move[this]=300.0
                            set s__BazzBSpells__BazzBSpells_Q_r5[this]=0.0
                            call MakeSound("war3mapimported\\Hero_BazzB_Q2")
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_file00000491.mdl" , GetUnitX(s__BazzBSpells__BazzBSpells_Q_c[this]) + 115.0 * Cos(s__BazzBSpells__BazzBSpells_Q_a[this]) , GetUnitY(s__BazzBSpells__BazzBSpells_Q_c[this]) + 115.0 * Sin(s__BazzBSpells__BazzBSpells_Q_a[this]) , s__BazzBSpells__BazzBSpells_Q_a[this] * bj_RADTODEG , 0.5 , 1.65 * 0.835 , 0.0))
                            call EffectSpawn2("war3mapImported\\wos_TXfiretuxi2.mdl" , GetUnitX(s__BazzBSpells__BazzBSpells_Q_c[this]) + 80.0 * Cos(s__BazzBSpells__BazzBSpells_Q_a[this]) , GetUnitY(s__BazzBSpells__BazzBSpells_Q_c[this]) + 80.0 * Sin(s__BazzBSpells__BazzBSpells_Q_a[this]) , s__BazzBSpells__BazzBSpells_Q_a[this] * bj_RADTODEG , 2.0 , 2.2 * 0.835 , 111.0 , 0.28)
                            set s__BazzBSpells__BazzBSpells_Q_rmax[this]=0.15
                            set s__BazzBSpells__BazzBSpells_Q_r[this]=0.0
                            set s__BazzBSpells__BazzBSpells_Q_r2[this]=0.0
                            set s__BazzBSpells__BazzBSpells_Q_x1[this]=GetUnitX(s__BazzBSpells__BazzBSpells_Q_c[this]) + 150.0 * Cos(s__BazzBSpells__BazzBSpells_Q_a[this])
                            set s__BazzBSpells__BazzBSpells_Q_y1[this]=GetUnitY(s__BazzBSpells__BazzBSpells_Q_c[this]) + 150.0 * Sin(s__BazzBSpells__BazzBSpells_Q_a[this])
                        endif
