                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_afb (2080).mdl" , x , y , s__MilimSpells___MilimRProjectileKS_a[this] * bj_RADTODEG , 0.85 , 1.9 , 1))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_YC_CrossFlash.mdl" , x + 25 * Cos(s__MilimSpells___MilimRProjectileKS_a[this]) , y + 25 * Sin(s__MilimSpells___MilimRProjectileKS_a[this]) , 0 , 0.5 , 2.94 , GetRandomReal(200, 450)))
