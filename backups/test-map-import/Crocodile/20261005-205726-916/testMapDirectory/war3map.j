                    set s__ErzaQSpells__ErzaQ_KS_a[this]=GAngle2(s__ErzaQSpells__ErzaQ_KS_c[this] , s__ErzaQSpells__ErzaQ_KS_x[this] , s__ErzaQSpells__ErzaQ_KS_y[this])
                    call BlzSetUnitFacingEx(s__ErzaQSpells__ErzaQ_KS_c[this], s__ErzaQSpells__ErzaQ_KS_a[this] * bj_RADTODEG)
                            call MoveUnit(s__ErzaQSpells__ErzaQ_KS_c[this] , s__ErzaQSpells__ErzaQ_KS_move[this] , s__ErzaQSpells__ErzaQ_KS_a[this])
