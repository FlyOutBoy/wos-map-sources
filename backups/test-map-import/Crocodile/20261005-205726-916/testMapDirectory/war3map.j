    function AAUniversalTooltips_T_DecorFlight takes real baseDmg,real flightDmg,real expDmg returns string
        return I2S(R2I(baseDmg)) + " (Flight " + I2S(R2I(flightDmg)) + " / Explosion " + I2S(R2I(expDmg)) + ")"
