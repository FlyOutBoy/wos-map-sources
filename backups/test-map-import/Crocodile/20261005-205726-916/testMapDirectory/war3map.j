    call BuffUnit1(c , c , 9)
    call MakeSound("war3mapimported\\Hero_Rimuru2_Q")
    call s__GearSystems2___KS_DelayedSound_NextSound_Start(("war3mapimported\\Hero_Rimuru2_Q2" ) , (( 1.5)*1.0)) // INLINED!!
    call s__GearSystems2___KS_FlushBuff_Start((GetHandleId(c) ) , ( StringHash("dodge q") ) , ( 0 ) , ( c ) , ( RimuruQ2_Buff_ID)) // INLINED!!
    call DisplayTimedTextToPlayer(GetOwningPlayer(c), 0, 0, 1, "|c00FF0303Dodges left: |r" + I2S(RimuruQ2_NumberofDodges))
