            set s__AlucardSpells__AlucardSpells_W_td[this]=NewTd
            set s__AlucardSpells__AlucardSpells_W_x[this]=GetUnitX(s__AlucardSpells__AlucardSpells_W_td[this])
            set s__AlucardSpells__AlucardSpells_W_y[this]=GetUnitY(s__AlucardSpells__AlucardSpells_W_td[this])
            set s__AlucardSpells__AlucardSpells_W_r[this]=0
            set s__AlucardSpells__AlucardSpells_W_dmg[this]=GetHeroAgi(s__AlucardSpells__AlucardSpells_W_c[this], true) * ( AlucardW_DamageAgiBase + ( AlucardW_DamageAgiStep * ( GetUnitAbilityLevel(s__AlucardSpells__AlucardSpells_W_c[this], AlucardW_ID) - 1 ) ) )
            set s__AlucardSpells__AlucardSpells_W_dmg[this]=s__AlucardSpells__AlucardSpells_W_dmg[this] + AlucardW_Damage2StaticBase + ( AlucardW_Damage2StaticStep * ( GetUnitAbilityLevel(s__AlucardSpells__AlucardSpells_W_c[this], AlucardW_ID) - 1 ) )
