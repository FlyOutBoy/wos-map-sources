                call TimerStart(s__ErzaTSpells___Erza5TT_KS_t_ErzaTT, 0.05, true, function s__ErzaTSpells___Erza5TT_KS_Loop_ErzaTT)
            endif
        endfunction

    //----------------------------Erza-----------------------------------------------
      
    function Erza5Q_Start takes unit c,unit td returns nothing
        call s__ErzaTSpells___Erza5Q_KS_ErzaQ_Start(c , td)
    endfunction
    function Erza5W_Start takes unit c returns nothing
        call s__ErzaTSpells___Erza5W_KS_ErzaW_Start(c)
    endfunction
    function Erza5E_Start takes unit c,real x,real y returns nothing
        call s__ErzaTSpells___Erza5E_KS_ErzaE_Start(c , x , y)
    endfunction
    function Erza5R_Start takes unit c,real x,real y returns nothing
        call s__ErzaTSpells___Erza5R_KS_ErzaR_Start(c , x , y)
    endfunction
    function Erza5T_Start takes unit c,unit td returns nothing
        call s__ErzaTSpells___Erza5T_KS_ErzaT_Start(c , td)
    endfunction
    function Erza5Pas_Start takes unit c,integer i returns nothing
        local integer k1= 0
        local integer k2= 0
        local integer k3= 0
        local real x= GetUnitX(c)
        local real y= GetUnitY(c)
        local unit u= null
        local group g= CreateGroup()
        local integer counter1= LoadInteger(hs, GetHandleId(c), StringHash("erza 5 tt"))
        local integer counter2= LoadInteger(hs, GetHandleId(c), StringHash("erza 5 tt2"))
        local boolean start1= false
        local boolean start2= false
        local real x1= LoadReal(hs, GetHandleId(GetOwningPlayer(c)), StringHash("fire x"))
        local real y1= LoadReal(hs, GetHandleId(GetOwningPlayer(c)), StringHash("fire y"))
        local real x2= LoadReal(hs, GetHandleId(GetOwningPlayer(c)), StringHash("water x"))
        local real y2= LoadReal(hs, GetHandleId(GetOwningPlayer(c)), StringHash("water y"))
        local real x3= LoadReal(hs, GetHandleId(GetOwningPlayer(c)), StringHash("lightning x"))
        local real y3= LoadReal(hs, GetHandleId(GetOwningPlayer(c)), StringHash("lightning y"))
        if LoadInteger(hs, GetHandleId(c), StringHash("t armor active")) == 1 then
            call GroupEnumUnitsInRange(g, x, y, 1800, NoDecor_Cond)
            loop
                set u=FirstOfGroup(g)
                exitwhen u == null
                if IsUnitAlly(u, GetOwningPlayer(c)) then
                    if GetUnitTypeId(u) == Gray_ID1 or GetUnitTypeId(u) == Gray_ID2 then
                        set k1=k1 + 1
                    endif
                    if GetUnitTypeId(u) == Natsu_ID then
                        set k2=k2 + 1
                    endif
                    if GetUnitTypeId(u) == Laxus_ID then
                        set k3=k3 + 1
                    endif
                endif
                call GroupRemoveUnit(g, u)
            endloop
            if k1 > 0 and k2 > 0 then // Natsu + Gray, same attach as R form
                if counter1 == 0 and counter2 == 0 then
                    if IntegerCd(c , "elem gain cd" , 60) then
                        call SaveInteger(hs, GetHandleId(c), StringHash("erza 5 tt"), 7)
                        call SaveInteger(hs, GetHandleId(c), StringHash("erza 5 tt2"), 7)
                        call s__ErzaTSpells___Erza5TT_KS_ErzaTT_Start(c , 0 , 0)
                    else
                        call DisplayTimedTextToPlayer(GetOwningPlayer(c), 0, 0, 1, "Elemental gain on cooldown")
                    endif
                endif
            elseif k2 > 0 and k3 > 0 then // Natsu + Laxus, same attach as R form
                // Store the pair as regular fire + lightning so every T-form
                // ability creates exactly the same ErzaPassive effects.
                if counter1 == 0 and counter2 == 0 then
                    if IntegerCd(c , "elem gain cd" , 60) then
                        call SaveInteger(hs, GetHandleId(c), StringHash("erza 5 tt"), 1)
                        call SaveInteger(hs, GetHandleId(c), StringHash("erza 5 tt2"), 3)
                        call s__ErzaTSpells___Erza5TT_KS_ErzaTT_Start(c , 4 , 4)
                    else
                        call DisplayTimedTextToPlayer(GetOwningPlayer(c), 0, 0, 1, "Elemental gain on cooldown")
                    endif
                endif
            else
                if x1 != 0 and SR3(c , x1 , y1) <= Erza1R_DamageAoe and counter1 != 1 and counter2 != 1 then
                    if counter1 == 0 then
                        set counter1=1
                        set start1=true
                    elseif counter2 == 0 then
                        set counter2=1
                        set start2=true
                    endif
                endif
                if x2 != 0 and SR3(c , x2 , y2) <= Erza2W_Aoe and counter1 != 2 and counter2 != 2 then
                    if counter1 == 0 then
                        set counter1=2
                        set start1=true
                    elseif counter2 == 0 then
                        set counter2=2
                        set start2=true
                    endif
                endif
                if x3 != 0 and SR3(c , x3 , y3) <= Erza3W_Aoe and counter1 != 3 and counter2 != 3 then
                    if counter1 == 0 then
                        set counter1=3
                        set start1=true
                    elseif counter2 == 0 then
                        set counter2=3
                        set start2=true
                    endif
                endif
                if start1 then
                    call SaveInteger(hs, GetHandleId(c), StringHash("erza 5 tt"), counter1)
                    call s__ErzaTSpells___Erza5TT_KS_ErzaTT_Start(c , counter1 , 1)
                endif
                if start2 then
                    call SaveInteger(hs, GetHandleId(c), StringHash("erza 5 tt2"), counter2)
                    call s__ErzaTSpells___Erza5TT_KS_ErzaTT_Start(c , counter2 , 2)
                endif
            endif
        endif
        call DestroyGroup(g)
        set g=null
        set u=null
    endfunction
    function Erza5F_Start takes unit c,real x,real y returns nothing
        call s__ErzaTSpells___Erza5F_KS_ErzaF_Start(c , x , y)
    endfunction

//library ErzaTSpells ends
//library FrierenSpells:
    function FrierenSpells___FrierenCloneCheck takes unit c returns boolean
        return IsUnitIllusion(c) == false and GetUnitTypeId(c) != FrierenTR_unitid
    endfunction
    function FrierenSpells___UpdateGIcon takes integer stacks returns nothing
        if stacks >= 10 then
            call BlzSetAbilityIcon(FrierenG_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Frieren_G3.blp")
        elseif stacks >= 5 then
            call BlzSetAbilityIcon(FrierenG_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Frieren_G2.blp")
        else
            call BlzSetAbilityIcon(FrierenG_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Frieren_G.blp")
        endif
    endfunction
    function FrierenF_Stacks takes unit c returns nothing
        local unit f
        local integer stacks
        if GetHeroLevel(c) <= 6 then
            return
        endif
    // Фрирен кастует сама — поиск юнитов не нужен.
        if GetUnitTypeId(c) == Frieren_ID then
            set stacks=S2I((LoadStr(TasAbilityChargeBox_Hash, GetHandleId((c )), ( FrierenF_ID)))) // INLINED!!
            if stacks < 10 then
                set stacks=stacks + 1
                call TasAbilityChargeBox_SetValue(c , FrierenF_ID , I2S(stacks))
                call FrierenSpells___UpdateGIcon(stacks)
                if stacks == 5 or stacks == 10 then
                    call BlzEndUnitAbilityCooldown(c, FrierenG_ID)
                endif
            endif
            return
        endif
        call GroupEnumUnitsInRange(FrierenSpells___FrierenF_Group, GetUnitX(c), GetUnitY(c), 1500.00, null)
        loop
            set f=FirstOfGroup(FrierenSpells___FrierenF_Group)
            exitwhen f == null
            call GroupRemoveUnit(FrierenSpells___FrierenF_Group, f)
            if GetUnitTypeId(f) == Frieren_ID and IsUnitAlly(f, GetOwningPlayer(c)) and GetWidgetLife(f) > 0.405 then
                set stacks=S2I((LoadStr(TasAbilityChargeBox_Hash, GetHandleId((f )), ( FrierenF_ID)))) // INLINED!!
                if stacks < 10 then
                    set stacks=stacks + 1
                    call TasAbilityChargeBox_SetValue(f , FrierenF_ID , I2S(stacks))
                    call FrierenSpells___UpdateGIcon(stacks)
                    if stacks == 5 or stacks == 10 then
                        call BlzEndUnitAbilityCooldown(f, FrierenG_ID)
                    endif
                endif
                set f=null
                return
            endif
        endloop
        set f=null
    endfunction
    function FrierenSpells___FrierenTimer03Acquire takes nothing returns nothing
        set FrierenSpells___FrierenTimer03Users=FrierenSpells___FrierenTimer03Users + 1
        if FrierenSpells___FrierenTimer03Users == 1 then
            call TimerStart(FrierenSpells___FrierenTimer03, 0.03, true, FrierenSpells___FrierenTimer03Callback)
        endif
    endfunction
    function FrierenSpells___FrierenTimer03Release takes nothing returns nothing
        set FrierenSpells___FrierenTimer03Users=FrierenSpells___FrierenTimer03Users - 1
        if FrierenSpells___FrierenTimer03Users <= 0 then
            set FrierenSpells___FrierenTimer03Users=0
            call PauseTimer(FrierenSpells___FrierenTimer03)
        endif
    endfunction
        function s__FrierenSpells___FrierenSpells_Q_Loop_FrierenQ takes nothing returns nothing
