    function BazzBSpells__BazzBTimer03Acquire takes nothing returns nothing
        set BazzBSpells__BazzBTimer03Users=BazzBSpells__BazzBTimer03Users + 1
        if BazzBSpells__BazzBTimer03Users == 1 then
            call TimerStart(BazzBSpells__BazzBTimer03, 0.03, true, BazzBSpells__BazzBTimer03Callback)
        endif
    endfunction

    function BazzBSpells__BazzBTimer03Release takes nothing returns nothing
        set BazzBSpells__BazzBTimer03Users=BazzBSpells__BazzBTimer03Users - 1
        if BazzBSpells__BazzBTimer03Users <= 0 then
            set BazzBSpells__BazzBTimer03Users=0
            call PauseTimer(BazzBSpells__BazzBTimer03)
        endif
    endfunction

    function BazzBSpells__BazzBTimer05Acquire takes nothing returns nothing
        set BazzBSpells__BazzBTimer05Users=BazzBSpells__BazzBTimer05Users + 1
        if BazzBSpells__BazzBTimer05Users == 1 then
            call TimerStart(BazzBSpells__BazzBTimer05, 0.05, true, BazzBSpells__BazzBTimer05Callback)
