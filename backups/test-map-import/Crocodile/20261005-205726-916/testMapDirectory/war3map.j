            if LoadInteger(hs, GetHandleId(GetOwningPlayer(s__AlucardSpells__AlucardSpells_E_c[this])), StringHash("morph r")) == 1 then
                set s__AlucardSpells__AlucardSpells_E_rmax[this]=1.5
                set s__AlucardSpells__AlucardSpells_E_move[this]=5
                call StartSpellUnit2(s__AlucardSpells__AlucardSpells_E_c[this])
                set s__AlucardSpells__AlucardSpells_E_k2[this]=0
                set s__AlucardSpells__AlucardSpells_E_scale[this]=1
