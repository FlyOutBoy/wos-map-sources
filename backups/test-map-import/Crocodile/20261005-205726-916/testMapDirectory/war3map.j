    function PatriotQ_Start takes unit c,real x,real y returns nothing
        call s__PatriotSpells___PatriotSpells_Q_PatriotQ_Start(c , x , y)
    endfunction

    function PatriotW_Start takes unit c,real x,real y returns nothing
        call s__PatriotSpells___PatriotSpells_W_PatriotW_Start(c , x , y)
    endfunction

    function PatriotE_Start takes unit c returns nothing
        local integer e= LoadInteger(hs, GetHandleId(c), StringHash("patriot e"))
        local integer rand= GetRandomInt(1, 3)
        local real x= GetUnitX(c)
        local real y= GetUnitY(c)
        local real cd1= BlzGetUnitAbilityCooldownRemaining(c, PatriotT_ID)
        local real cd2= BlzGetUnitAbilityCooldownRemaining(c, PatriotT2_ID)
        local real a= GetUnitFacing(c) * bj_DEGTORAD
        local integer oldrand= LoadInteger(hs, GetHandleId(c), StringHash("old random"))

        loop
            set rand=GetRandomInt(1, 3)
            exitwhen rand != oldrand
        endloop
        if rand == 1 then
            call MakeSound("war3mapImported\\Hero_Patriot_E")
        elseif rand == 2 then
            call MakeSound("war3mapImported\\Hero_Patriot_E2")
        elseif rand == 3 then
            call MakeSound("war3mapImported\\Hero_Patriot_E3")
        endif
        call SaveInteger(hs, GetHandleId(c), StringHash("old random"), rand)

        if e == 0 then
            call SetPlayerAbilityAvailable(GetOwningPlayer(c), PatriotF_ID, false)
            call SetPlayerAbilityAvailable(GetOwningPlayer(c), PatriotT_ID, false)
            call SetPlayerAbilityAvailable(GetOwningPlayer(c), PatriotF2_ID, true)
            call SetPlayerAbilityAvailable(GetOwningPlayer(c), PatriotT2_ID, true)
            call UnitAddAbility(c, PatriotF2_ID)
            if GetUnitAbilityLevel(c, PatriotT_ID) > 0 then
                call UnitAddAbility(c, PatriotT2_ID)
                call BlzStartUnitAbilityCooldown(c, PatriotT2_ID, cd1)
            endif
            call AddUnitAnimationProperties(c, "alternate", true)
            call Patriot_RestoreOrder(c , 8)
            call SaveInteger(hs, GetHandleId(c), StringHash("patriot e"), 1)
            call AddSpellLevel(c , 'A01C' , 10 , true)
            call BlzSetAbilityIcon(PatriotE_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Patriot_E2.blp")
            call AAUniversalTooltips_SetUnitForm(c , 1)
        else
            call AddSpellLevel(c , 'A01C' , 10 , false)
            call BlzSetAbilityIcon(PatriotE_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Patriot_E.blp")
            call BlzStartUnitAbilityCooldown(c, PatriotT_ID, cd2)
            call SetPlayerAbilityAvailable(GetOwningPlayer(c), PatriotF_ID, true)
            call SetPlayerAbilityAvailable(GetOwningPlayer(c), PatriotT_ID, true)
            call SetPlayerAbilityAvailable(GetOwningPlayer(c), PatriotF2_ID, false)
            call SetPlayerAbilityAvailable(GetOwningPlayer(c), PatriotT2_ID, false)
            call AddUnitAnimationProperties(c, "alternate", false)
            call Patriot_RestoreOrder(c , 3)
            call SaveInteger(hs, GetHandleId(c), StringHash("patriot e"), 0)
            call AAUniversalTooltips_SetUnitForm(c , 0)
        endif

        if GetHeroLevel(c) >= 35 then
            call ReduceCooldown(c , PatriotR_ID , PatriotE_CDReductR)
        endif
        call ReduceCooldown(c , PatriotQ_ID , PatriotE_CDReductBase + ( PatriotE_CDReductStep * ( GetUnitAbilityLevel(c, PatriotE_ID) - 1 ) ))
        call DestroyEffect(EffectSpawn("war3mapimported\\wos_1hongse_2red.mdl" , x , y , a * bj_RADTODEG , 1.0 , 4.37 , 15.0))
        call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_wfile00009065.mdl" , x , y , a * bj_RADTODEG , 0.5 , 1.1 , 1.0 , 255 , 255 , 255 , 255))
    endfunction

    function PatriotEE_Start takes unit c,unit td returns nothing
        call s__PatriotSpells___PatriotSpells_E_PatriotE_Start(c , td)
    endfunction

    function PatriotR_Start takes unit c,real x,real y returns nothing
        call s__PatriotSpells___PatriotSpells_R_PatriotR_Start(c , x , y)
    endfunction

    function PatriotT_Start takes unit c,real x,real y returns nothing
        call s__PatriotSpells___PatriotSpells_T_PatriotT_Start(c , x , y)
    endfunction

    function PatriotT2_Start takes unit c,real x,real y returns nothing
        call s__PatriotSpells___PatriotSpells_T2_PatriotT2_Start(c , x , y)
    endfunction

    function PatriotF_Start takes unit c returns nothing
        call s__PatriotSpells___PatriotSpells_F_PatriotF_Start(c)
    endfunction

    function PatriotF2_Start takes unit c returns nothing
        call s__PatriotSpells___PatriotSpells_F_PatriotF_Start(c)
    endfunction

//library PatriotSpells ends
//library RaidenSpells:

    function RaidenAtk_Start takes unit c,unit td returns nothing
        local real x= GetUnitX(td)
        local real y= GetUnitY(td)
        local real a= GetRandomReal(0, 359)
        local integer atk_trigger= RaidenG_CountAtkToTrigger
        local boolean b= LoadInteger(hs, GetHandleId(c), StringHash("q abi")) > 0
        local integer lvl= 1
        local real dmg= GetHeroAgi(c, true) * RaidenG_AgiDMG
        local integer atk= LoadInteger(hs, GetHandleId(c), StringHash("atk count")) + 1

        if GetHeroLevel(c) >= 35 then
            set lvl=4
        elseif GetHeroLevel(c) >= 25 then
            set lvl=3
        elseif GetHeroLevel(c) >= 12 then
            set lvl=2
        endif

        if LoadInteger(hs, GetHandleId(c), StringHash("raiden w atk")) == 1 then
            set atk_trigger=2
        endif

        if atk >= atk_trigger then
            if Raiden_F_Dummy == null then
                set Raiden_F_Dummy=CreateUnit(GetOwningPlayer(c), Raiden_FDummy_ID, GetRectCenterX(gg_rct_Caster), GetRectCenterY(gg_rct_Caster), 1)
            endif
            if not b then
                call DestroyEffect(EffectSpawn("war3mapImported\\wos_mei-trlightning2.mdl" , x , y , GetRandomReal(0, 359) , 1 , 1 , 0))
                call ColorEffDummy3Alpha((EffectSpawn("war3mapimported\\wos_WTW-whitethunder-Zi.mdx" , x , y , GetRandomReal(0, 359) , 1 , 1.1 , 0) ) , (( 0.3 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.3)*1.0)) // INLINED!!
                call s__GearSystems2___KS_MoveEffectToUnit_MoveEffectToUnit_Start((EffectSpawn("war3mapImported\\wos_mei-rsfx-6.mdl" , x , y , a , 1.25 , 1.45 , 100) ) , (( 0.36 )*1.0) , (( 100 )*1.0) , ( td) , 0 , 1 , null) // INLINED!!
                call s__GearSystems2___KS_DelayedDamage_NextDmg_Start((c ) , ( td ) , (( dmg )*1.0) , ( 0 ) , (( 0.1)*1.0)) // INLINED!!
            endif
            set atk=0
        endif

        call BuffUnit01(c , c , 'A0GE' , "bloodlust" , lvl)
        call SaveInteger(hs, GetHandleId(c), StringHash("atk count"), atk)
    endfunction



        function s__RaidenSpells__RaidenQ_KS_Loop_RaidenQ takes nothing returns nothing
            local integer this
            local integer i= 0

            loop
                exitwhen i > s__RaidenSpells__RaidenQ_KS_MUI_RaidenQ
                set this=s__RaidenSpells__RaidenQ_KS_m_RaidenQ[i]
                if SpellBoolCaster(s__RaidenSpells__RaidenQ_KS_c[this]) and s__RaidenSpells__RaidenQ_KS_r[this] <= s__RaidenSpells__RaidenQ_KS_rmax[this] then
                    set s__RaidenSpells__RaidenQ_KS_r[this]=s__RaidenSpells__RaidenQ_KS_r[this] + 0.03
                    if s__RaidenSpells__RaidenQ_KS_k2[this] == 0 then
                        if s__RaidenSpells__RaidenQ_KS_check[this] == 0 then
                            if s__RaidenSpells__RaidenQ_KS_r[this] == s__RaidenSpells__RaidenQ_KS_r_prepare[this] - 0.03 then
                                call SetUnitTimeScale(s__RaidenSpells__RaidenQ_KS_c[this], 1)
                                call SetUnitAnimationByIndex(s__RaidenSpells__RaidenQ_KS_c[this], 40)
                                call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_tx-ha_nitu.mdl" , GetUnitX(s__RaidenSpells__RaidenQ_KS_c[this]) , GetUnitY(s__RaidenSpells__RaidenQ_KS_c[this]) , s__RaidenSpells__RaidenQ_KS_a[this] * bj_RADTODEG , 2 , 1.25 , 1 , 255 , 255 , 255 , 225))
                            endif
                            if s__RaidenSpells__RaidenQ_KS_r[this] < s__RaidenSpells__RaidenQ_KS_r_prepare[this] then
                                call DebugUnit2(s__RaidenSpells__RaidenQ_KS_c[this])
                            endif
                            if s__RaidenSpells__RaidenQ_KS_r[this] >= s__RaidenSpells__RaidenQ_KS_r_prepare[this] then
                                set s__RaidenSpells__RaidenQ_KS_x[this]=GetUnitX(s__RaidenSpells__RaidenQ_KS_c[this]) + 50 * Cos(s__RaidenSpells__RaidenQ_KS_a[this])
                                set s__RaidenSpells__RaidenQ_KS_y[this]=GetUnitY(s__RaidenSpells__RaidenQ_KS_c[this]) + 50 * Sin(s__RaidenSpells__RaidenQ_KS_a[this])
                                if s__RaidenSpells__RaidenQ_KS_r2[this] > 0.03 then
                                    set s__RaidenSpells__RaidenQ_KS_r2[this]=0
                                    call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_tx-ha_nitu.mdl" , GetUnitX(s__RaidenSpells__RaidenQ_KS_c[this]) , GetUnitY(s__RaidenSpells__RaidenQ_KS_c[this]) , s__RaidenSpells__RaidenQ_KS_a[this] * bj_RADTODEG , 2 , 1.25 , 1 , 255 , 255 , 255 , 225))
                                else
                                    set s__RaidenSpells__RaidenQ_KS_r2[this]=s__RaidenSpells__RaidenQ_KS_r2[this] + 0.03
                                endif
                                call MoveUnit(s__RaidenSpells__RaidenQ_KS_c[this] , s__RaidenSpells__RaidenQ_KS_move[this] , s__RaidenSpells__RaidenQ_KS_a[this])
                                call GroupClear(s__RaidenSpells__RaidenQ_KS_g[this])
                                call GroupEnumUnitsInRange(s__RaidenSpells__RaidenQ_KS_g[this], s__RaidenSpells__RaidenQ_KS_x[this], s__RaidenSpells__RaidenQ_KS_y[this], s__RaidenSpells__RaidenQ_KS_aoe[this], NoDecor_Cond)
                                loop
                                    set s__RaidenSpells__RaidenQ_KS_u[this]=FirstOfGroup(s__RaidenSpells__RaidenQ_KS_g[this])
                                    exitwhen s__RaidenSpells__RaidenQ_KS_u[this] == null or s__RaidenSpells__RaidenQ_KS_check[this] > 0
                                    if SpellBool(s__RaidenSpells__RaidenQ_KS_u[this]) and IsUnitEnemy(s__RaidenSpells__RaidenQ_KS_u[this], GetOwningPlayer(s__RaidenSpells__RaidenQ_KS_c[this])) then
                                        set s__RaidenSpells__RaidenQ_KS_check[this]=1
                                        set s__RaidenSpells__RaidenQ_KS_r[this]=0
                                        set s__RaidenSpells__RaidenQ_KS_rmax[this]=0.75
                                        call MUE(s__RaidenSpells__RaidenQ_KS_u[this] , 100 , 0.3 , s__RaidenSpells__RaidenQ_KS_a[this])
                                        call MakeSound("war3mapimported\\Hero_Raiden_Q_1")
                                    endif
                                    call GroupRemoveUnit(s__RaidenSpells__RaidenQ_KS_g[this], s__RaidenSpells__RaidenQ_KS_u[this])
                                endloop
                                set s__RaidenSpells__RaidenQ_KS_u[this]=null
                            endif
                        elseif s__RaidenSpells__RaidenQ_KS_check[this] == 1 then
                            set s__RaidenSpells__RaidenQ_KS_x[this]=GetUnitX(s__RaidenSpells__RaidenQ_KS_c[this]) + 85 * Cos(s__RaidenSpells__RaidenQ_KS_a[this])
                            set s__RaidenSpells__RaidenQ_KS_y[this]=GetUnitY(s__RaidenSpells__RaidenQ_KS_c[this]) + 85 * Sin(s__RaidenSpells__RaidenQ_KS_a[this])
