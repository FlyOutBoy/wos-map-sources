                            set s__PatriotSpells___PatriotSpells_T_check2[this]=0
                            set s__PatriotSpells___PatriotSpells_T_r4[this]=0.0
                        else
                            set s__PatriotSpells___PatriotSpells_T_r4[this]=s__PatriotSpells___PatriotSpells_T_r4[this] + 0.03
                        endif

                        if s__PatriotSpells___PatriotSpells_T_r3[this] > 0.0 then
                            call GroupClear(s__PatriotSpells___PatriotSpells_T_g[this])
                            set s__PatriotSpells___PatriotSpells_T_k[this]=0
