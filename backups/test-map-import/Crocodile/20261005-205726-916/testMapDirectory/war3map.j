        function s__BazzBSpells__BazzBSpells_Q_BazzBQ_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__BazzBSpells__BazzBSpells_Q__allocate()
            local integer level= GetUnitAbilityLevel(NewC, BazzBQ_ID)
            set s__BazzBSpells__BazzBSpells_Q_MUI_BazzBQ=s__BazzBSpells__BazzBSpells_Q_MUI_BazzBQ + 1
            set s__BazzBSpells__BazzBSpells_Q_m_BazzBQ[s__BazzBSpells__BazzBSpells_Q_MUI_BazzBQ]=this
            set s__BazzBSpells__BazzBSpells_Q_c[this]=NewC
            set s__BazzBSpells__BazzBSpells_Q_x[this]=NewX
            set s__BazzBSpells__BazzBSpells_Q_y[this]=NewY
            set s__BazzBSpells__BazzBSpells_Q_r[this]=0.0
            set s__BazzBSpells__BazzBSpells_Q_r2[this]=0.0
            set s__BazzBSpells__BazzBSpells_Q_r3[this]=0.0
            set s__BazzBSpells__BazzBSpells_Q_r5[this]=0.0
            set s__BazzBSpells__BazzBSpells_Q_move[this]=0.0
            set s__BazzBSpells__BazzBSpells_Q_check[this]=0
            if level < 1 then
                set level=1
            endif
            call StartSpellUnit2(s__BazzBSpells__BazzBSpells_Q_c[this])
            set s__BazzBSpells__BazzBSpells_Q_g[this]=CreateGroup()
            set s__BazzBSpells__BazzBSpells_Q_g2[this]=CreateGroup()
            set s__BazzBSpells__BazzBSpells_Q_a[this]=GAngle2(s__BazzBSpells__BazzBSpells_Q_c[this] , s__BazzBSpells__BazzBSpells_Q_x[this] , s__BazzBSpells__BazzBSpells_Q_y[this])
            set s__BazzBSpells__BazzBSpells_Q_aoe[this]=BazzBQ_DamageAoe
            set s__BazzBSpells__BazzBSpells_Q_dmg[this]=GetHeroAgi(s__BazzBSpells__BazzBSpells_Q_c[this], true) * ( BazzBQ_DamageAgiBase + ( BazzBQ_DamageAgiStep * ( level - 1 ) ) )
            set s__BazzBSpells__BazzBSpells_Q_dmg[this]=s__BazzBSpells__BazzBSpells_Q_dmg[this] + BazzBQ_Damage2StaticBase + ( BazzBQ_Damage2StaticStep * ( level - 1 ) )
            set s__BazzBSpells__BazzBSpells_Q_rmax[this]=0.66
            call SetUnitAnimationByIndex(s__BazzBSpells__BazzBSpells_Q_c[this], 10)
            call SetUnitTimeScale(s__BazzBSpells__BazzBSpells_Q_c[this], 0.65)
            if GetRandomInt(1, 2) == 1 then
                call MakeSound("war3mapimported\\Hero_BazzB_Q01")
            else
                call MakeSound("war3mapimported\\Hero_BazzB_Q02")
            endif
            if s__BazzBSpells__BazzBSpells_Q_MUI_BazzBQ == 0 then
                call BazzBSpells__BazzBTimer03Acquire()
            endif
        endfunction



