                                    if SpellBool(s__RaidenSpells__RaidenQ_KS_u[this]) and IsUnitEnemy(s__RaidenSpells__RaidenQ_KS_u[this], GetOwningPlayer(s__RaidenSpells__RaidenQ_KS_c[this])) then
                                        call dmgphys(s__RaidenSpells__RaidenQ_KS_c[this] , s__RaidenSpells__RaidenQ_KS_u[this] , s__RaidenSpells__RaidenQ_KS_dmg[this])
                                        call RaidenAtk_Start(s__RaidenSpells__RaidenQ_KS_c[this] , s__RaidenSpells__RaidenQ_KS_u[this])
                                        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", s__RaidenSpells__RaidenQ_KS_u[this], "chest"))
                                        if s__RaidenSpells__RaidenQ_KS_r[this] == 0.72 then
                                            call MUE(s__RaidenSpells__RaidenQ_KS_u[this] , RaidenQ_PushRange , RaidenQ_PushDuration , s__RaidenSpells__RaidenQ_KS_a[this])
                                        else
