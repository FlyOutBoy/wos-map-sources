                                exitwhen u == null
                                if IsUnitEnemy(u, GetOwningPlayer(s__PatriotSpells___PatriotSpells_T_c[this])) and SpellBool(u) then
                                    set distance=SR3(u , s__PatriotSpells___PatriotSpells_T_x[this] , s__PatriotSpells___PatriotSpells_T_y[this])
                                    if distance > s__PatriotSpells___PatriotSpells_T_aoe[this] - 350.0 and distance < s__PatriotSpells___PatriotSpells_T_aoe[this] then
                                        if s__PatriotSpells___PatriotSpells_T_check2[this] == 0 then
