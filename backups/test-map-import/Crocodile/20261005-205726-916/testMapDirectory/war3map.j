                    if s__RimuruSpells__Rimuru3T_KS_check[this] >= 2 then
                        set s__RimuruSpells__Rimuru3T_KS_r2[this]=s__RimuruSpells__Rimuru3T_KS_r2[this] + 0.03
                    endif
                // в”Ђв”Ђ Cleanup в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
                else
                    if s__RimuruSpells__Rimuru3T_KS_r[this] < 3.51 then
                       // call StopSpellUnit(c)
                    endif
                    // Destroy ee[0..ring-1]: falling slime orbs
                    // Destroy ee[ring..ring*2-1]: child ground orbs  в†ђ FIX (was missing)
                    // (No ee slots beyond ring*2 вЂ” scatter orbs were removed; see check 1в†’2)
                    set s__RimuruSpells__Rimuru3T_KS_k[this]=0
                    loop
                        exitwhen s__RimuruSpells__Rimuru3T_KS_k[this] == ring * 2 // FIX: was ring, now ring*2
                        if s___RimuruSpells__Rimuru3T_KS_ee[s__RimuruSpells__Rimuru3T_KS_ee[this]+s__RimuruSpells__Rimuru3T_KS_k[this]] != null then
                            call ColorEffDummy3Alpha((s___RimuruSpells__Rimuru3T_KS_ee[s__RimuruSpells__Rimuru3T_KS_ee[this]+s__RimuruSpells__Rimuru3T_KS_k[this]] ) , (( 0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.15)*1.0)) // INLINED!!
                            set s___RimuruSpells__Rimuru3T_KS_ee[s__RimuruSpells__Rimuru3T_KS_ee[this]+s__RimuruSpells__Rimuru3T_KS_k[this]]=null
                        endif
                        set s__RimuruSpells__Rimuru3T_KS_k[this]=s__RimuruSpells__Rimuru3T_KS_k[this] + 1
                    endloop
                    // Destroy ALL lightning slots (3 banks Г— ring)
                    set s__RimuruSpells__Rimuru3T_KS_k[this]=0
                    loop
                        exitwhen s__RimuruSpells__Rimuru3T_KS_k[this] == ring * 3
                        if s___RimuruSpells__Rimuru3T_KS_ls[s__RimuruSpells__Rimuru3T_KS_ls[this]+s__RimuruSpells__Rimuru3T_KS_k[this]] != null then
                            call DestroyLightning(s___RimuruSpells__Rimuru3T_KS_ls[s__RimuruSpells__Rimuru3T_KS_ls[this]+s__RimuruSpells__Rimuru3T_KS_k[this]])
                            set s___RimuruSpells__Rimuru3T_KS_ls[s__RimuruSpells__Rimuru3T_KS_ls[this]+s__RimuruSpells__Rimuru3T_KS_k[this]]=null
                        endif
                        set s__RimuruSpells__Rimuru3T_KS_k[this]=s__RimuruSpells__Rimuru3T_KS_k[this] + 1
                    endloop
                    call DestroyGroup(s__RimuruSpells__Rimuru3T_KS_g[this])
                    call DestroyGroup(s__RimuruSpells__Rimuru3T_KS_g2[this]) // was missing in original
                    call SetUnitTimeScale(s__RimuruSpells__Rimuru3T_KS_c[this], 1)
                    set s__RimuruSpells__Rimuru3T_KS_c[this]=null
                    set s__RimuruSpells__Rimuru3T_KS_e2[this]=null
                    set s__RimuruSpells__Rimuru3T_KS_u[this]=null
                    set s__RimuruSpells__Rimuru3T_KS_g[this]=null
                    set s__RimuruSpells__Rimuru3T_KS_g2[this]=null
                    set s__RimuruSpells__Rimuru3T_KS_m_Rimuru3T[i]=s__RimuruSpells__Rimuru3T_KS_m_Rimuru3T[s__RimuruSpells__Rimuru3T_KS_MUI_Rimuru3T]
                    set s__RimuruSpells__Rimuru3T_KS_MUI_Rimuru3T=s__RimuruSpells__Rimuru3T_KS_MUI_Rimuru3T - 1
                    if s__RimuruSpells__Rimuru3T_KS_MUI_Rimuru3T == - 1 then
                        call RimuruSpells__RimuruTimer03Release()
                    endif
                    call s__RimuruSpells__Rimuru3T_KS_deallocate(this)
                set i=i - 1
                endif
                set i=i + 1
