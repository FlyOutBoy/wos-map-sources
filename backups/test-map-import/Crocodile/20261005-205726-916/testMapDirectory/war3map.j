            set s__MilimSpells___MilimQKS_check[this]=0
            set s__MilimSpells___MilimQKS_move[this]=120
            set s__MilimSpells___MilimQKS_check2[this]=0
            call StartSpellUnit2(s__MilimSpells___MilimQKS_c[this])
            set s__MilimSpells___MilimQKS_g[this]=CreateGroup()
            set s__MilimSpells___MilimQKS_g2[this]=CreateGroup()
            set s__MilimSpells___MilimQKS_u[this]=null
            set s__MilimSpells___MilimQKS_a[this]=GAngle2(s__MilimSpells___MilimQKS_c[this] , s__MilimSpells___MilimQKS_x[this] , s__MilimSpells___MilimQKS_y[this]) // Angle Between points
            set s__MilimSpells___MilimQKS_aoe[this]=MilimQ_DamageAoe
            set s__MilimSpells___MilimQKS_dmg[this]=GetHeroAgi(s__MilimSpells___MilimQKS_c[this], true) * ( MilimQ_DamageAgiBase + ( MilimQ_DamageAgiStep * ( GetUnitAbilityLevel(s__MilimSpells___MilimQKS_c[this], MilimQ_ID) - 1 ) ) )
            set s__MilimSpells___MilimQKS_dmg[this]=s__MilimSpells___MilimQKS_dmg[this] + MilimQ_Damage2StaticBase + ( MilimQ_Damage2StaticStep * ( GetUnitAbilityLevel(s__MilimSpells___MilimQKS_c[this], MilimQ_ID) - 1 ) )
            if LoadInteger(hs, GetHandleId(s__MilimSpells___MilimQKS_c[this]), StringHash("mode t")) == 1 then
                set s__MilimSpells___MilimQKS_dmg[this]=s__MilimSpells___MilimQKS_dmg[this] + MilimT_DmgAdd * GetHeroAgi(s__MilimSpells___MilimQKS_c[this], true)
            endif
            set s__MilimSpells___MilimQKS_rmax[this]=2.1
            set s__MilimSpells___MilimQKS_e[this]=AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdx", s__MilimSpells___MilimQKS_c[this], "hand right")
            set s__MilimSpells___MilimQKS_e2[this]=AddSpecialEffectTarget("war3mapImported\\wos_file00001662.mdl", s__MilimSpells___MilimQKS_c[this], "hand right")
            set s__MilimSpells___MilimQKS_e3[this]=AddSpecialEffectTarget("war3mapimported\\wos_SlidingDustWithRocks.mdx", s__MilimSpells___MilimQKS_c[this], "origin")
                call SetUnitAnimationByIndex(s__MilimSpells___MilimQKS_c[this], 7)
                call SetUnitTimeScale(s__MilimSpells___MilimQKS_c[this], 1.5)
                call MakeSound("war3mapimported\\Hero_Milim_Q 1")
            if s__MilimSpells___MilimQKS_MUI_MilimQ == 0 then
                call TimerStart(s__MilimSpells___MilimQKS_t_MilimQ, 0.03, true, function s__MilimSpells___MilimQKS_Loop_MilimQ)
            endif
        endfunction
   



    // h — ìàêñèìàëüíàÿ âûñîòà, d — äëèòåëüíîñòü, x — ïðîøåäøåå âðåìÿ.
    function s__MilimSpells___MilimWKS_Parabola takes real h,real d,real x returns real
        return ( 4.00 * h / d ) * ( d - x ) * ( x / d )
    endfunction

