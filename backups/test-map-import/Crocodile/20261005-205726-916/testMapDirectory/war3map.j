                                    call ColorEffDummy3Alpha((EffectSpawn3_2("war3mapImported\\wos_VergilSlashesYellow.mdl" , s__RaidenSpells__RaidenQ_KS_x[this] , s__RaidenSpells__RaidenQ_KS_y[this] , s__RaidenSpells__RaidenQ_KS_a[this] * bj_RADTODEG , 1 , s__RaidenSpells__RaidenQ_KS_scale[this] , 195 , - 325) ) , (( 1 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.06)*1.0)) // INLINED!!
