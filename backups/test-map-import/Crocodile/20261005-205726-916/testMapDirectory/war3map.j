            call StartSpellUnit2(s__AlucardSpells__AlucardSpells_W_c[this])
          //  call StartSpellUnit2(td)
            set s__AlucardSpells__AlucardSpells_W_r5[this]=( AlucardW_SelfHealAgiBase + ( AlucardW_SelfHealAgiStep * ( GetUnitAbilityLevel(s__AlucardSpells__AlucardSpells_W_c[this], AlucardW_ID) - 1 ) ) ) * GetHeroAgi(s__AlucardSpells__AlucardSpells_W_c[this], true)
            if LoadInteger(hs, GetHandleId(s__AlucardSpells__AlucardSpells_W_c[this]), StringHash("alucard g3")) == 1 then
            set s__AlucardSpells__AlucardSpells_W_r5[this]=s__AlucardSpells__AlucardSpells_W_r5[this] * 1.25
            endif
