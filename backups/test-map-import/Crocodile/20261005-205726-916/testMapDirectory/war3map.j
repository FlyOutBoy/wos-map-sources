                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_YC_CrossFlashred.mdl" , s__PatriotSpells___PatriotSpells_W_x[this] + 25.0 * Cos(s__PatriotSpells___PatriotSpells_W_a[this]) , s__PatriotSpells___PatriotSpells_W_y[this] + 25.0 * Sin(s__PatriotSpells___PatriotSpells_W_a[this]) , 1.0 , 1.15 , 2.475 * s__PatriotSpells___PatriotSpells_W_scale[this] , 125.0))

