    endif
    endif
    if Kenjaku_ID == id and GetUnitAbilityLevel(c, KenjakuG_ID) == 0 then
    call UnitAddAbility(c, KenjakuG_ID)
    call UnitMakeAbilityPermanent(c, true, KenjakuG_ID)
