                    endif
                    if GetUnitAbilityLevel(s__OkarunSpells__OkarunF_KS_c[this], OkarunT_Buff_ID) == 0 and ( GetUnitCurrentOrder(s__OkarunSpells__OkarunF_KS_c[this]) == OrderId("stop") or GetUnitCurrentOrder(s__OkarunSpells__OkarunF_KS_c[this]) == 0 or IsUnitPaused(s__OkarunSpells__OkarunF_KS_c[this]) == true or GetUnitAbilityLevel(s__OkarunSpells__OkarunF_KS_c[this], 'BPSE') == 1 ) and LoadInteger(hs, GetHandleId(s__OkarunSpells__OkarunF_KS_c[this]), StringHash("spell p")) == 0 then
                        set s__OkarunSpells__OkarunF_KS_r3[this]=s__OkarunSpells__OkarunF_KS_r3[this] - ( s__OkarunSpells__OkarunF_KS_r5[this] * ( OkarunF_DecreaseSpeedPercentPerSec / 100 ) )
                        if s__OkarunSpells__OkarunF_KS_r3[this] < GetUnitMoveSpeed(s__OkarunSpells__OkarunF_KS_c[this]) then
