                set dealt=ItemsSpells__ElemHit(s__ItemsElementsFx_c[this] , s__ItemsElementsFx_u[this] , s__ItemsElementsFx_src[this] , s__ItemsElementsFx_dmg[this] , false , 2)
                // Both hits heal from actual damage dealt, without a separate cap.
                set m=s__ItemsElementsFx_Burn(s__ItemsElementsFx_src[this] , s__ItemsElementsFx_c[this] , s__ItemsElementsFx_u[this] , LeviathanGrasp_Squeeze * (I2R(GetHeroStr((s__ItemsElementsFx_c[this]), true))) , 1 , 0.5 , false) // INLINED!!
                set s__ItemsElementsFx_phase[m]=2
                set d=SquareRoot(( GetUnitX(s__ItemsElementsFx_c[this]) - GetUnitX(s__ItemsElementsFx_u[this]) ) * ( GetUnitX(s__ItemsElementsFx_c[this]) - GetUnitX(s__ItemsElementsFx_u[this]) ) + ( GetUnitY(s__ItemsElementsFx_c[this]) - GetUnitY(s__ItemsElementsFx_u[this]) ) * ( GetUnitY(s__ItemsElementsFx_c[this]) - GetUnitY(s__ItemsElementsFx_u[this]) ))
