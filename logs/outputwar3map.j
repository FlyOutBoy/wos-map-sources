            elseif s__ItemsElementsFx_kind[this] == s__ItemsElementsFx_ASHEN or s__ItemsElementsFx_kind[this] == s__ItemsElementsFx_WAVE then
                // .step = travelled distance, .next = total distance; .vx / .vy = unit direction.
                set d=1100.0
                if s__ItemsElementsFx_kind[this] == s__ItemsElementsFx_ASHEN then
                    set d=d * 1.4 * 1.15
                endif
                set s__ItemsElementsFx_step[this]=s__ItemsElementsFx_step[this] + IntegerTertiaryOp(s__ItemsElementsFx_phase[this] == 0, 1, - 1) * d * s__ItemsElementsFx_DT
                set s__ItemsElementsFx_step[this]=RMaxBJ(0.0, RMinBJ(s__ItemsElementsFx_next[this], s__ItemsElementsFx_step[this]))
                if s__ItemsElementsFx_kind[this] == s__ItemsElementsFx_WAVE then
                    set px=s__ItemsElementsFx_x[this] + s__ItemsElementsFx_vx[this] * s__ItemsElementsFx_step[this]
                    set py=s__ItemsElementsFx_y[this] + s__ItemsElementsFx_vy[this] * s__ItemsElementsFx_step[this]
                    call BlzSetSpecialEffectX(s__ItemsElementsFx_e[this], px)
                    call BlzSetSpecialEffectY(s__ItemsElementsFx_e[this], py)
                    set d=1.0 + 0.5 * RMinBJ(1.0, 2.0 * s__ItemsElementsFx_step[this] / s__ItemsElementsFx_next[this])
                    call BlzSetSpecialEffectScale(s__ItemsElementsFx_e[this], MirrorTide_ProjectileScale * d)
                    call s__ItemsElementsFx_Sweep(this,px , py , MirrorTide_WaveAoe * d , s__ItemsElementsFx_g[this] , null , s__ItemsElementsFx_dmg[this] , false , 2 , MirrorTide_Push , 0)
                    if showVision then
