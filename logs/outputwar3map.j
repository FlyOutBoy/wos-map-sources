        endfunction

        function s__AinzSpells__AinzW_KS_AinzW2_Start takes unit NewC,unit NewTeleportUnit,unit NewTd returns nothing
            local integer this= s__AinzSpells__AinzW_KS__allocate()
            local group wolves= LoadGroupHandle(hs, GetHandleId(NewC), AinzSpells__SH_KNIGHT_GROUP)
            local unit teleportUnit= NewTeleportUnit
            local real near= 0.00
            local real cur
            set s__AinzSpells__AinzW_KS_c[this]=NewC
            set s__AinzSpells__AinzW_KS_td[this]=NewTd
            if teleportUnit == null or GetWidgetLife(teleportUnit) <= 0.405 then
                set teleportUnit=s__AinzSpells__AinzW_KS_c[this]
            endif
            call AinzSpells__AinzSwapPatch(s__AinzSpells__AinzW_KS_c[this] , AinzW_ID , 0)
            call AinzSpells__AinzSwapPatch(s__AinzSpells__AinzW_KS_c[this] , AinzW2_ID , 0)
            set s__AinzSpells__AinzW_KS_r[this]=0
            set s__AinzSpells__AinzW_KS_r2[this]=0
            set s__AinzSpells__AinzW_KS_b[this]=false
            set s__AinzSpells__AinzW_KS_d[this]=null
            set s__AinzSpells__AinzW_KS_g[this]=CreateGroup()
            set s__AinzSpells__AinzW_KS_g2[this]=CreateGroup()
            set s__AinzSpells__AinzW_KS_g3[this]=CreateGroup()
            if wolves != null then
                call GroupEnumUnitsOfPlayer(s__AinzSpells__AinzW_KS_g[this], GetOwningPlayer(s__AinzSpells__AinzW_KS_c[this]), null)
                loop
                    set s__AinzSpells__AinzW_KS_u[this]=FirstOfGroup(s__AinzSpells__AinzW_KS_g[this])
                    exitwhen s__AinzSpells__AinzW_KS_u[this] == null
                    if IsUnitInGroup(s__AinzSpells__AinzW_KS_u[this], wolves) and GetUnitTypeId(s__AinzSpells__AinzW_KS_u[this]) == AinzW_Unit_ID and GetUnitState(s__AinzSpells__AinzW_KS_u[this], UNIT_STATE_LIFE) > 0.405 then
                        set cur=SR2(s__AinzSpells__AinzW_KS_c[this] , s__AinzSpells__AinzW_KS_u[this])
                        if s__AinzSpells__AinzW_KS_d[this] == null or cur < near then
                            set s__AinzSpells__AinzW_KS_d[this]=s__AinzSpells__AinzW_KS_u[this]
                            set near=cur
                        endif
                    endif
                    call GroupRemoveUnit(s__AinzSpells__AinzW_KS_g[this], s__AinzSpells__AinzW_KS_u[this])
                endloop
            endif
            if s__AinzSpells__AinzW_KS_d[this] == null then
                call DestroyGroup(s__AinzSpells__AinzW_KS_g[this])
                call DestroyGroup(s__AinzSpells__AinzW_KS_g2[this])
                call DestroyGroup(s__AinzSpells__AinzW_KS_g3[this])
                set wolves=null
                set teleportUnit=null
                call s__AinzSpells__AinzW_KS_deallocate(this)
                return
            endif
            set s__AinzSpells__AinzW_KS_level[this]=GetUnitAbilityLevel(s__AinzSpells__AinzW_KS_c[this], AinzW_ID)
            set s__AinzSpells__AinzW_KS_dmg[this]=GetHeroInt(s__AinzSpells__AinzW_KS_c[this], true) * ( AinzW2_DamageIntBase + ( AinzW2_DamageIntStep * GetUnitAbilityLevel(s__AinzSpells__AinzW_KS_c[this], AinzW_ID) ) )
            set s__AinzSpells__AinzW_KS_dmg[this]=s__AinzSpells__AinzW_KS_dmg[this] + AinzW2_Damage2StaticBase + ( AinzW2_Damage2StaticStep * ( GetUnitAbilityLevel(s__AinzSpells__AinzW_KS_c[this], AinzW_ID) - 1 ) )
            set s__AinzSpells__AinzW_KS_a[this]=GAngle(teleportUnit , s__AinzSpells__AinzW_KS_td[this])
            set s__AinzSpells__AinzW_KS_distance[this]=0.00
            call PauseUnit(s__AinzSpells__AinzW_KS_d[this], true)
            call UnitAddAbility(s__AinzSpells__AinzW_KS_d[this], 'Avul')

            call MakeSound("war3mapimported\\Hero_Ainz_W2")
            call MakeSound("war3mapimported\\Hero_Ainz_W6")
            call PosUnit(s__AinzSpells__AinzW_KS_d[this] , GetUnitX(teleportUnit) + 180.00 * Cos(s__AinzSpells__AinzW_KS_a[this]) , GetUnitY(teleportUnit) + 180.00 * Sin(s__AinzSpells__AinzW_KS_a[this]))
            call EffectSpawn2("war3mapImported\\wos_raidenei-4.mdl" , GetUnitX(s__AinzSpells__AinzW_KS_d[this]) , GetUnitY(s__AinzSpells__AinzW_KS_d[this]) , s__AinzSpells__AinzW_KS_a[this] * bj_RADTODEG , 2 , 1.5 , 0 , 0.3)
            call BlzSetUnitFacingEx(s__AinzSpells__AinzW_KS_d[this], s__AinzSpells__AinzW_KS_a[this] * bj_RADTODEG)
            call DestroyEffect(EffectSpawn("war3mapimported\\wos_1baozha_90.mdl" , GetUnitX(s__AinzSpells__AinzW_KS_d[this]) , GetUnitY(s__AinzSpells__AinzW_KS_d[this]) , s__AinzSpells__AinzW_KS_a[this] * bj_RADTODEG , 1 , 1.25 , 0))
            call DestroyEffect(EffectSpawn("war3mapimported\\wos_cf2.mdl" , GetUnitX(s__AinzSpells__AinzW_KS_d[this]) , GetUnitY(s__AinzSpells__AinzW_KS_d[this]) , s__AinzSpells__AinzW_KS_a[this] * bj_RADTODEG , 1 , 1.25 , 0))
            call UnitAddAbility(s__AinzSpells__AinzW_KS_c[this], AinzW3_ID)
            call SetUnitAbilityLevel(s__AinzSpells__AinzW_KS_c[this], AinzW3_ID, GetUnitAbilityLevel(s__AinzSpells__AinzW_KS_c[this], AinzW_ID))
            call SetUnitTimeScale(s__AinzSpells__AinzW_KS_d[this], 0.2)
            call SetUnitAnimationByIndex(s__AinzSpells__AinzW_KS_d[this], 1)
            if LoadInteger(hs, GetHandleId(s__AinzSpells__AinzW_KS_c[this]), AinzSpells__SH_MODE_T) == 0 then
                call SetPlayerAbilityAvailable(GetOwningPlayer(s__AinzSpells__AinzW_KS_c[this]), AinzW2_ID, false)
                call SetPlayerAbilityAvailable(GetOwningPlayer(s__AinzSpells__AinzW_KS_c[this]), AinzW3_ID, true)
                call BlzStartUnitAbilityCooldown(s__AinzSpells__AinzW_KS_c[this], AinzW3_ID, 1.5)
            endif
            call SaveInteger(hs, GetHandleId(s__AinzSpells__AinzW_KS_c[this]), AinzSpells__SH_AINZW_W3_READY, 1)
            call SaveInteger(hs, GetHandleId(s__AinzSpells__AinzW_KS_c[this]), AinzSpells__SH_AINZW_TIMER_PAUSE, 1)
            set s__AinzSpells__AinzW_KS_MUI_AinzW2=s__AinzSpells__AinzW_KS_MUI_AinzW2 + 1
            set s__AinzSpells__AinzW_KS_m_AinzW2[s__AinzSpells__AinzW_KS_MUI_AinzW2]=this
            if s__AinzSpells__AinzW_KS_MUI_AinzW2 == 0 then
                call AinzSpells__AinzTimer03Acquire()
            endif
            set wolves=null
            set teleportUnit=null
            call Ainz_RestoreOrder(NewC , - 1)
        endfunction

        function s__AinzSpells__AinzW_KS_Loop_AinzW3 takes nothing returns nothing
            local integer this
            local integer i= 0
            local integer k
            local integer alive
            local group wolves
            local real wallMove
