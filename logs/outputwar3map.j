                        endif
                        if s__AlucardSpells__AlucardSpells_R_r[this] >= 0 then
                            if s__AlucardSpells__AlucardSpells_R_r2[this] > 0.15 then
                                set s__AlucardSpells__AlucardSpells_R_r2[this]=0
                                call DecorRemove(s__AlucardSpells__AlucardSpells_R_c[this] , s__AlucardSpells__AlucardSpells_R_x[this] , s__AlucardSpells__AlucardSpells_R_y[this] , s__AlucardSpells__AlucardSpells_R_aoe[this] , 10)
