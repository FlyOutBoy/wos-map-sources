        // Enemies next to Okarun are knocked to the side they stand on (as when hit while running in F).
        function s__OkarunSpells___OkarunTBuff_KS_tackle takes integer this returns nothing
            local unit u
            local real facing= GetUnitFacing(s__OkarunSpells___OkarunTBuff_KS_c[this]) * bj_DEGTORAD
            local real a
            local real dmg= GetHeroInt(s__OkarunSpells___OkarunTBuff_KS_c[this], true) * OkarunT_PushDamageInt
            if IsUnitPaused(s__OkarunSpells___OkarunTBuff_KS_c[this]) then
                return
            endif
            call GroupEnumUnitsInRange(s__OkarunSpells___OkarunTBuff_KS_pushGroup, GetUnitX(s__OkarunSpells___OkarunTBuff_KS_c[this]), GetUnitY(s__OkarunSpells___OkarunTBuff_KS_c[this]), OkarunT_PushAoe, NoDecor_Cond)
            loop
                set u=FirstOfGroup(s__OkarunSpells___OkarunTBuff_KS_pushGroup)
                exitwhen u == null
                call GroupRemoveUnit(s__OkarunSpells___OkarunTBuff_KS_pushGroup, u)
                if SpellBool(u) and IsUnitEnemy(u, GetOwningPlayer(s__OkarunSpells___OkarunTBuff_KS_c[this])) and IntegerCdKey(u , OkarunSpells___SH_OKARUN_T_TACKLE + GetHandleId(s__OkarunSpells___OkarunTBuff_KS_c[this]) , OkarunT_PushInterval) then
                    set a=GAngle(s__OkarunSpells___OkarunTBuff_KS_c[this] , u)
                    if Sin(a - facing) >= 0 then
                        set a=facing + bj_PI / 2
                    else
                        set a=facing - bj_PI / 2
                    endif
                    call MUE(u , OkarunT_PushRange , OkarunT_PushDuration , a)
                    set GearDamageNextSource=(OkarunT_ID) // INLINED!!
                    call dmgmag(s__OkarunSpells___OkarunTBuff_KS_c[this] , u , dmg)
                    // Hit effects of Kenjaku W.
                    call DestroyEffect(EffectSpawn("war3mapImported\\wos_az_hitheavy.mdl" , GetUnitX(u) , GetUnitY(u) , a * bj_RADTODEG , 1 , 2.25 , 125))
