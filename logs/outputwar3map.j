                    if GetUnitAbilityLevel(s__OkarunSpells___OkarunF_KS_c[this], OkarunT_Buff_ID) > 0 then
                        set s__OkarunSpells___OkarunF_KS_r5[this]=OkarunT_Speed(s__OkarunSpells___OkarunF_KS_c[this])
                        set s__OkarunSpells___OkarunF_KS_r3[this]=s__OkarunSpells___OkarunF_KS_r5[this]
                    else
                        // Clamp immediately when T expires, including while stopped or paused.
                        set s__OkarunSpells___OkarunF_KS_r3[this]=RMinBJ(s__OkarunSpells___OkarunF_KS_r3[this], s__OkarunSpells___OkarunF_KS_r5[this])
                    endif
                    if IsUnitPaused(s__OkarunSpells___OkarunF_KS_c[this]) == false and GetUnitAbilityLevel(s__OkarunSpells___OkarunF_KS_c[this], 'Avul') == 0 and CheckCoordsInRect(gg_rct_Base , GetUnitX(s__OkarunSpells___OkarunF_KS_c[this]) , GetUnitY(s__OkarunSpells___OkarunF_KS_c[this])) == false then
                        set order=GetUnitCurrentOrder(s__OkarunSpells___OkarunF_KS_c[this])
                        set moving=order == OrderId("move") or order == OrderId("smart") or order == OrderId("attack") or order == OrderId(OkarunQ_Order) or order == OrderId(OkarunW_Order) or order == OrderId(OkarunE_Order) or order == OrderId(OkarunR_Order) or order == OrderId(OkarunT_Order)
