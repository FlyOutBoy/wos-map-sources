            call SetUnitFacing(s__StarrkSpells___StarrkSpells_W_c[this], s__StarrkSpells___StarrkSpells_W_a[this] * bj_RADTODEG)
            if LoadInteger(hs, GetHandleId(GetOwningPlayer(s__StarrkSpells___StarrkSpells_W_c[this])), StarrkSpells___SH_MORPH_E) == 0 then
                call StartSpellUnit2(s__StarrkSpells___StarrkSpells_W_c[this])
                call MakeSound("war3mapimported\\Hero_Starrk_W2 1")
                call SetUnitTimeScale(s__StarrkSpells___StarrkSpells_W_c[this], 0.5)
                call SetUnitAnimationByIndex(s__StarrkSpells___StarrkSpells_W_c[this], 4)
