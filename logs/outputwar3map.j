            call BlzSetUnitFacingEx(s__DarkShikiSpells__DarkShikiG_KS_c[this], s__DarkShikiSpells__DarkShikiG_KS_a[this] * bj_RADTODEG)
                call MakeSound("war3mapimported\\Hero_DarkShiki_T")
            call MakeSound("war3mapimported\\Hero_DarkShiki_G1")
            call VisionTimed(GetOwningPlayer(s__DarkShikiSpells__DarkShikiG_KS_c[this]) , s__DarkShikiSpells__DarkShikiG_KS_x[this] , s__DarkShikiSpells__DarkShikiG_KS_y[this] , 1200 , 2)
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_HakkeStart.mdx" , s__DarkShikiSpells__DarkShikiG_KS_x[this] , s__DarkShikiSpells__DarkShikiG_KS_y[this] , 0 , 0.6 , 1.25 , 5))
            set s__DarkShikiSpells__DarkShikiG_KS_rmax[this]=0.27
            if s__DarkShikiSpells__DarkShikiG_KS_MUI_DarkShikiG == 0 then
                call DarkShikiSpells__DarkShikiTick_On(5)
            endif
        endfunction
     

