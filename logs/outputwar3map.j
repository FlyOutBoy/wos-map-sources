    function AlterSaberW_Start takes unit c returns nothing
        if c == null or GetUnitTypeId(c) != AlterSaber_ID or IsUnitIllusion(c) then
            return
        endif
        if LoadInteger(hs, GetHandleId(c), AlterSaberSpells__SH_SABER_G_ACTIVE) == 0 then
            call SaveInteger(hs, GetHandleId(c), AlterSaberSpells__SH_SABER_G_ACTIVE, 1)
            call s__AlterSaberSpells__AlterSaberW_KS_AlterSaberW_Start(c)
        endif
