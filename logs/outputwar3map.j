                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_ZarakiWCrack2.mdx" , s__PatriotSpells___PatriotSpells_T2_x[this] , s__PatriotSpells___PatriotSpells_T2_y[this] , GetRandomReal(0, 359) , 1.0 , 3.0 , 0.0))
                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_BY_Wood_Eff_Ord_DanGe_Wav_Kuosan_1_3_0_5s.mdx" , s__PatriotSpells___PatriotSpells_T2_x[this] , s__PatriotSpells___PatriotSpells_T2_y[this] , 1.0 , 1.0 , 1.0 , 100.0))

                        set k=0
                        loop
                            exitwhen k > 4
                            call EffectSpawn2("war3mapimported\\wos_LD2209 (157).mdx" , s__PatriotSpells___PatriotSpells_T2_x[this] , s__PatriotSpells___PatriotSpells_T2_y[this] , GetRandomReal(0, 359) , 1.6 - k * 0.2 , 1.0 + k * 0.5 , 0.0 , 1.25)
                            call DestroyEffect(EffectSpawn("war3mapimported\\wos_T_dustgaraa2.mdx" , s__PatriotSpells___PatriotSpells_T2_x[this] , s__PatriotSpells___PatriotSpells_T2_y[this] , GetRandomReal(0, 359) , 1.85 - k * 0.1 , 1.9 + k * 0.42 , 0.0))
