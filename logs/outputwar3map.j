        set BambiettaSpells__BambiettaTimer03Callback=function BambiettaSpells__BambiettaTimer03Loop
        set BambiettaSpells__BambiettaTimer05Callback=function BambiettaSpells__BambiettaTimer05Loop
    endfunction

    function BambiettaQ_Start takes unit c,real x,real y returns nothing
        if LoadInteger(hs, GetHandleId(GetOwningPlayer(c)), BambiettaSpells__SH_MORPH_T) > 0 then
            call s__BambiettaSpells__BambiettaSpells_Q_BambiettaTQ_Start(c , x , y)
        else
            call s__BambiettaSpells__BambiettaSpells_Q_BambiettaQ_Start(c , x , y)
        endif
    endfunction

    function BambiettaW_Start takes unit c returns nothing
        if LoadInteger(hs, GetHandleId(GetOwningPlayer(c)), BambiettaSpells__SH_MORPH_T) > 0 then
