                            exitwhen s__TakeshiSpells___TakeshiSpells_Q_u[this] == null
                            if SpellBool(s__TakeshiSpells___TakeshiSpells_Q_u[this]) and IsUnitEnemy(s__TakeshiSpells___TakeshiSpells_Q_u[this], GetOwningPlayer(s__TakeshiSpells___TakeshiSpells_Q_c[this])) and IsUnitInGroup(s__TakeshiSpells___TakeshiSpells_Q_u[this], s__TakeshiSpells___TakeshiSpells_Q_g2[this]) == false then
