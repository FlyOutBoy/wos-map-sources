                            call DecorRemove(s__BrandishSpells__BrandishSpells_T_c[this] , s__BrandishSpells__BrandishSpells_T_x[this] , s__BrandishSpells__BrandishSpells_T_y[this] , s__BrandishSpells__BrandishSpells_T_r8[this] - 500.0 , BrandishT_DecorDamage)
                            call GroupClear(s__BrandishSpells__BrandishSpells_T_g[this])
                            call GroupEnumUnitsInRange(s__BrandishSpells__BrandishSpells_T_g[this], s__BrandishSpells__BrandishSpells_T_x[this], s__BrandishSpells__BrandishSpells_T_y[this], s__BrandishSpells__BrandishSpells_T_r8[this] - 500.0, NoDecor_Cond)
                            loop
