                                call dmgphys(s__PatriotSpells___PatriotSpells_T2_c[this] , u , s__PatriotSpells___PatriotSpells_T2_dmg[this])
                                if GetHeroLevel(s__PatriotSpells___PatriotSpells_T2_c[this]) >= 35 then
                                    call PatriotPas(s__PatriotSpells___PatriotSpells_T2_c[this] , u)
