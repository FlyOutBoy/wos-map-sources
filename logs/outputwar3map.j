                        set s__ItemsElementsFx_charges[this]=s__ItemsElementsFx_charges[this] + 1
                        call s__ItemsElementsFx_Pulse(this,ConstellationCoil_Width * a , (I2R(GetHeroInt((s__ItemsElementsFx_c[this]), true))) , true , 3 , ConstellationCoil_Slow) // INLINED!!
