            set s__GearSystems2___KS_BuffTimer_check2[this]=IgnoreBuff
            set s__GearSystems2___KS_BuffTimer_rmax[this]=NewRmax
            set s__GearSystems2___KS_BuffTimer_b[this]=NewPauseCount
            if NewPlayerId == - 1 then
            set s__GearSystems2___KS_BuffTimer_k2[this]=GetPlayerId(GetOwningPlayer(s__GearSystems2___KS_BuffTimer_c[this]))
            else
            set s__GearSystems2___KS_BuffTimer_k2[this]=NewPlayerId
            endif
            set s__GearSystems2___KS_BuffTimer_k[this]=s__GearSystems2___KS_BuffTimer_k2[this]
            // 24 позиции на слот исключают пересечение игроков 10+ с соседним UI-слотом.
            set s__GearSystems2___KS_BuffTimer_k2[this]=s__GearSystems2___KS_BuffTimer_k2[this] + ( s__GearSystems2___KS_BuffTimer_k3[this] * 24 ) + 1
            set tmp_x=0.26875 + ( 0.0265 * s__GearSystems2___KS_BuffTimer_k3[this] ) //* 0.0225
                set tmp_y=0.17
                if s__GearSystems2___KS_BuffTimer_frame0_pas1[s__GearSystems2___KS_BuffTimer_k2[this]] == null then
                set s__GearSystems2___KS_BuffTimer_frame0_pas1[s__GearSystems2___KS_BuffTimer_k2[this]]=BlzCreateFrameByType("SIMPLEFRAME", "2Face", (null), "", 0) // INLINED!!
                call BlzFrameClearAllPoints(s__GearSystems2___KS_BuffTimer_frame0_pas1[s__GearSystems2___KS_BuffTimer_k2[this]])
                    call BlzFrameSetVisible(s__GearSystems2___KS_BuffTimer_frame0_pas1[s__GearSystems2___KS_BuffTimer_k2[this]], false)
                if GetLocalPlayer() == Player(s__GearSystems2___KS_BuffTimer_k[this]) then
