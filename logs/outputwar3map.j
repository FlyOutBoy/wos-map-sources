    local trigger hpset= CreateTrigger()
    local integer i= 0
    loop
        exitwhen i == 9
        call TriggerRegisterPlayerChatEvent(hpset, Player(i), "-hp", false)
        set i=i + 1
    endloop
    call TriggerAddAction(hpset, function hpsetActions)
    set hpset=null
endfunction



