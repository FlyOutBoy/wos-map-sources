    function KyorakuSpells___KyorakuTick05_On takes integer k returns nothing
        if not KyorakuSpells___KyorakuTick05_Active[k] then
            set KyorakuSpells___KyorakuTick05_Active[k]=true
            set KyorakuSpells___KyorakuTick05_Users=KyorakuSpells___KyorakuTick05_Users + 1
            if KyorakuSpells___KyorakuTick05_Users == 1 then
                call TimerStart(KyorakuSpells___KyorakuTick05_Timer, 0.05, true, KyorakuSpells___KyorakuTick05_Callback)
            endif
        endif
    endfunction

    function KyorakuSpells___KyorakuTick05_Off takes integer k returns nothing
        if KyorakuSpells___KyorakuTick05_Active[k] then
            set KyorakuSpells___KyorakuTick05_Active[k]=false
            set KyorakuSpells___KyorakuTick05_Users=KyorakuSpells___KyorakuTick05_Users - 1
            if KyorakuSpells___KyorakuTick05_Users <= 0 then
                set KyorakuSpells___KyorakuTick05_Users=0
                call PauseTimer(KyorakuSpells___KyorakuTick05_Timer)
            endif
        endif
    endfunction


    function KyorakuSpells___KyorakuTick_On takes integer k returns nothing
        if not KyorakuSpells___KyorakuTick_Active[k] then
            set KyorakuSpells___KyorakuTick_Active[k]=true
            set KyorakuSpells___KyorakuTick_Users=KyorakuSpells___KyorakuTick_Users + 1
            if KyorakuSpells___KyorakuTick_Users == 1 then
                call TimerStart(KyorakuSpells___KyorakuTick_Timer, 0.03, true, KyorakuSpells___KyorakuTick_Callback)
            endif
        endif
    endfunction

    function KyorakuSpells___KyorakuTick_Off takes integer k returns nothing
        if KyorakuSpells___KyorakuTick_Active[k] then
            set KyorakuSpells___KyorakuTick_Active[k]=false
            set KyorakuSpells___KyorakuTick_Users=KyorakuSpells___KyorakuTick_Users - 1
            if KyorakuSpells___KyorakuTick_Users <= 0 then
                set KyorakuSpells___KyorakuTick_Users=0
                call PauseTimer(KyorakuSpells___KyorakuTick_Timer)
            endif
        endif
    endfunction

// Stable public meter key; the current act supplies its caption and artwork.
function KyorakuSpells___KyorakuBankaiProgress takes unit c,integer stage,real remaining,real total returns nothing
    local integer pid= GetPlayerId(GetOwningPlayer(c))
    local integer art= KyorakuT0_ID
    local string title= "Bankai"
    if LoadInteger(hs, GetHandleId(c), KyorakuSpells___SH_LAST_DAN) > 0 then
        set stage=4
    endif
    if stage == 1 then
        set title="1-st stage"
        set art=KyorakuT1_ID
    elseif stage == 2 then
        set title="2-nd stage"
        set art=KyorakuT2_ID
    elseif stage == 3 then
        set title="3-rd stage"
        set art=KyorakuT3_ID
    elseif stage == 4 then
        set title="4-th stage"
        set art=KyorakuT4_ID
    endif
    call WUI_HeroProgressPublic(c , KyorakuT_ID , title , remaining , total)
    if KyorakuSpells___KyorakuBankaiStage[pid] != stage + 1 then
        set KyorakuSpells___KyorakuBankaiStage[pid]=stage + 1
        call WUI_HeroProgressIcon(c , KyorakuT_ID , BlzGetAbilityIcon(art))
    endif
endfunction

// Text height is presentation-only; every act can grow or shrink the same panel.
function KyorakuSpells___KyorakuBankaiHelp takes unit c,integer pid,integer abilityId returns nothing
    local ability a= BlzGetUnitAbility(c, abilityId)
    call BlzFrameSetSize(s__frame_KyorBankai7[pid], 0.164, 0.00)
    call BlzFrameSetText(s__frame_KyorBankai7[pid], BlzGetAbilityStringLevelField(a, ABILITY_SLF_TOOLTIP_NORMAL, 0) + "|n" + BlzGetAbilityStringLevelField(a, ABILITY_SLF_TOOLTIP_NORMAL_EXTENDED, 0))
    call WUI_ColumnHeight(s__frame_KyorBankai12[pid] , RMaxBJ(0.035, BlzFrameGetHeight(s__frame_KyorBankai7[pid]) + 0.016))
    set a=null
endfunction

function KyorakuFrameClick takes nothing returns nothing
    local framehandle clicked= BlzGetTriggerFrame()
    local integer i= 0
    local integer i2= 0
    local player p= GetTriggerPlayer()
    local integer pid= GetPlayerId(p)
    local real x= 0.025
    local real y= - 0.05
    local integer k= 0
    loop
    exitwhen k == 10
    if clicked == s__frame_KyorBankai8[k] then
        if GetLocalPlayer() == p then
        call WUI_ColumnShow(s__frame_KyorBankai12[k] , false)
        call BlzFrameSetVisible(s__frame_KyorBankai8[k], false)
        call BlzFrameSetVisible(s__frame_KyorBankai10[k], false)
        call BlzFrameSetVisible(s__frame_KyorBankai9[k], true)
        call BlzFrameSetVisible(s__frame_KyorBankai11[k], true)
        endif
        call SaveInteger(hs, GetHandleId(Player(pid)), KyorakuSpells___SH_DESC_T_OFF, 1)
    elseif clicked == s__frame_KyorBankai9[k] then
        if GetLocalPlayer() == p then
        call WUI_ColumnShow(s__frame_KyorBankai12[k] , true)
        call BlzFrameSetVisible(s__frame_KyorBankai8[k], true)
        call BlzFrameSetVisible(s__frame_KyorBankai10[k], true)
        call BlzFrameSetVisible(s__frame_KyorBankai9[k], false)
        call BlzFrameSetVisible(s__frame_KyorBankai11[k], false)
        endif
        call SaveInteger(hs, GetHandleId(Player(pid)), KyorakuSpells___SH_DESC_T_OFF, 0)
    endif
    set k=k + 1
    endloop
    set clicked=null
    set p=null
    call WUI_ReleaseClickFocus()
endfunction

    function BuffUnitKyoraku takes unit c,unit u,integer level returns nothing
            local integer i= GetPlayerId(GetOwningPlayer(c))
            if KyorDummy[i] == null or GetWidgetLife(KyorDummy[i]) < 1 then
                set KyorDummy[i]=CreateUnit(Player(i), 'h0C9', GetRectCenterX(gg_rct_Caster), GetRectCenterY(gg_rct_Caster), 0)
                call UnitAddAbility(KyorDummy[i], 'A09C')
            endif
            if level > 0 then
                if GetUnitAbilityLevel(KyorDummy[i], 'A09C') == 0 then
                    call UnitAddAbility(KyorDummy[i], 'A09C')
                endif
                call SetUnitAbilityLevel(KyorDummy[i], 'A09C', level)
                call SetUnitFacing(KyorDummy[i], GAngle(KyorDummy[i] , u) * bj_RADTODEG)
                call IssueTargetOrder(KyorDummy[i], "curse", u)
            endif
    endfunction

        function s__KyorakuSpells___KyorakuQ_KS_Loop_KyorakuQ takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__KyorakuSpells___KyorakuQ_KS_MUI_KyorakuQ
                set this=s__KyorakuSpells___KyorakuQ_KS_m_KyorakuQ[i]
                if SpellBoolCaster(s__KyorakuSpells___KyorakuQ_KS_c[this]) and s__KyorakuSpells___KyorakuQ_KS_r[this] <= s__KyorakuSpells___KyorakuQ_KS_rmax[this] then
                    set s__KyorakuSpells___KyorakuQ_KS_r[this]=s__KyorakuSpells___KyorakuQ_KS_r[this] + 0.03
                    set s__KyorakuSpells___KyorakuQ_KS_r[this]=RoundReal(s__KyorakuSpells___KyorakuQ_KS_r[this] , 3)
                    if false then //GetHeroLevel(c)>= 35 then 
                    call DebugUnit(s__KyorakuSpells___KyorakuQ_KS_c[this])
                    else
                    call DebugUnit2(s__KyorakuSpells___KyorakuQ_KS_c[this])
                    endif
                    if s__KyorakuSpells___KyorakuQ_KS_r[this] <= 0.45 then
                        call MoveUnit(s__KyorakuSpells___KyorakuQ_KS_c[this] , s__KyorakuSpells___KyorakuQ_KS_move[this] , s__KyorakuSpells___KyorakuQ_KS_a[this])
                        call SetFly(s__KyorakuSpells___KyorakuQ_KS_c[this] , GetUnitFlyHeight(s__KyorakuSpells___KyorakuQ_KS_c[this]) + s__KyorakuSpells___KyorakuQ_KS_fly[this])
                    endif
                    if s__KyorakuSpells___KyorakuQ_KS_r[this] == 0.45 then
                        call MakeSound("war3mapimported\\Hero_Kyoraku_Q2")
                        set s__KyorakuSpells___KyorakuQ_KS_fly[this]=GetUnitFlyHeight(s__KyorakuSpells___KyorakuQ_KS_c[this]) / 5
                    endif
                    if s__KyorakuSpells___KyorakuQ_KS_r[this] >= 0.45 and s__KyorakuSpells___KyorakuQ_KS_r[this] <= 0.6 then
                        call SetFly(s__KyorakuSpells___KyorakuQ_KS_c[this] , GetUnitFlyHeight(s__KyorakuSpells___KyorakuQ_KS_c[this]) - s__KyorakuSpells___KyorakuQ_KS_fly[this])
                    endif
                    if s__KyorakuSpells___KyorakuQ_KS_r[this] == 0.6 then
                        call SetFly(s__KyorakuSpells___KyorakuQ_KS_c[this] , 0)
                        call DestroyEffect(s__KyorakuSpells___KyorakuQ_KS_e[this])
                        call DestroyEffect(s__KyorakuSpells___KyorakuQ_KS_e2[this])
                        set s__KyorakuSpells___KyorakuQ_KS_x[this]=GetUnitX(s__KyorakuSpells___KyorakuQ_KS_c[this])
                        set s__KyorakuSpells___KyorakuQ_KS_y[this]=GetUnitY(s__KyorakuSpells___KyorakuQ_KS_c[this])
                        call DecorRemove(s__KyorakuSpells___KyorakuQ_KS_c[this] , s__KyorakuSpells___KyorakuQ_KS_x[this] , s__KyorakuSpells___KyorakuQ_KS_y[this] , s__KyorakuSpells___KyorakuQ_KS_aoe[this] , 40)
                        call VisionTimed(GetOwningPlayer(s__KyorakuSpells___KyorakuQ_KS_c[this]) , s__KyorakuSpells___KyorakuQ_KS_x[this] , s__KyorakuSpells___KyorakuQ_KS_y[this] , s__KyorakuSpells___KyorakuQ_KS_aoe[this] , s__KyorakuSpells___KyorakuQ_KS_rmax[this])
                        call GroupClear(s__KyorakuSpells___KyorakuQ_KS_g[this])
                        call GroupEnumUnitsInRange(s__KyorakuSpells___KyorakuQ_KS_g[this], s__KyorakuSpells___KyorakuQ_KS_x[this], s__KyorakuSpells___KyorakuQ_KS_y[this], s__KyorakuSpells___KyorakuQ_KS_aoe[this], NoDecor_Cond)
                        loop
                            set s__KyorakuSpells___KyorakuQ_KS_u[this]=FirstOfGroup(s__KyorakuSpells___KyorakuQ_KS_g[this])
                            exitwhen s__KyorakuSpells___KyorakuQ_KS_u[this] == null
                            if IsUnitEnemy(s__KyorakuSpells___KyorakuQ_KS_u[this], GetOwningPlayer(s__KyorakuSpells___KyorakuQ_KS_c[this])) and SpellBool(s__KyorakuSpells___KyorakuQ_KS_u[this]) then
                                set GearDamageNextSource=('A050') // INLINED!!
                                call dmgphys(s__KyorakuSpells___KyorakuQ_KS_c[this] , s__KyorakuSpells___KyorakuQ_KS_u[this] , s__KyorakuSpells___KyorakuQ_KS_dmg[this])
                                call DestroyEffect(EffectSpawn("war3mapimported\\wos_whiteakihared.mdx" , GetUnitX(s__KyorakuSpells___KyorakuQ_KS_u[this]) , GetUnitY(s__KyorakuSpells___KyorakuQ_KS_u[this]) , GetRandomReal(0, 359) , 0.85 , 1 , GetUnitFlyHeight(s__KyorakuSpells___KyorakuQ_KS_u[this]) + 50))
                                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", s__KyorakuSpells___KyorakuQ_KS_u[this], "chest"))
                            endif
                            call GroupRemoveUnit(s__KyorakuSpells___KyorakuQ_KS_g[this], s__KyorakuSpells___KyorakuQ_KS_u[this])
                        endloop
                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_BY_Wood_Effect_Order_DanGe_LiangYiShi_ZhiSiZhiMoYanZhanJi_purple.mdx" , s__KyorakuSpells___KyorakuQ_KS_x[this] , s__KyorakuSpells___KyorakuQ_KS_y[this] , s__KyorakuSpells___KyorakuQ_KS_a[this] * bj_RADTODEG , 1.15 , 3.5 , 175))
                        call DestroyEffect(EffectSpawnColor("war3mapimported\\wos_BY_Wood_Eff_Ord_YeYe_Wid_KuoSan_2.mdx" , s__KyorakuSpells___KyorakuQ_KS_x[this] , s__KyorakuSpells___KyorakuQ_KS_y[this] , GetRandomReal(0, 359) , 1.45 , 4 , 175 , 255 , 255 , 255 , 125))
                        call DestroyEffect(EffectSpawnColor("war3mapimported\\wos_BY_Wood_Eff_Ord_YeYe_Wid_KuoSan_2.mdx" , s__KyorakuSpells___KyorakuQ_KS_x[this] , s__KyorakuSpells___KyorakuQ_KS_y[this] , GetRandomReal(0, 359) , 1.35 , 5 , 195 , 255 , 255 , 255 , 125))
                        call DestroyEffect(EffectSpawnColor("war3mapimported\\wos_BY_Wood_Eff_Ord_YeYe_Wid_KuoSan_2.mdx" , s__KyorakuSpells___KyorakuQ_KS_x[this] , s__KyorakuSpells___KyorakuQ_KS_y[this] , GetRandomReal(0, 359) , 1.25 , 6 , 215 , 255 , 255 , 255 , 125))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_HakkeStart.mdx" , s__KyorakuSpells___KyorakuQ_KS_x[this] , s__KyorakuSpells___KyorakuQ_KS_y[this] , GetRandomReal(0, 359) , 1.5 , 1.65 , 3))
                        call DestroyEffect(EffectSpawnColor("war3mapimported\\wos_acg_bbb.mdx" , s__KyorakuSpells___KyorakuQ_KS_x[this] , s__KyorakuSpells___KyorakuQ_KS_y[this] , GetRandomReal(0, 359) , 1.75 , 2.35 , 195 , 255 , 255 , 255 , 195))
                    endif
                else
                if false then //GetHeroLevel(c)>= 35 then 
                    call StopSpellUnit(s__KyorakuSpells___KyorakuQ_KS_c[this])
                    else
                    call StopSpellUnit2(s__KyorakuSpells___KyorakuQ_KS_c[this])
                    endif
                    
                    call DestroyGroup(s__KyorakuSpells___KyorakuQ_KS_g[this])
                    call DestroyEffect(s__KyorakuSpells___KyorakuQ_KS_e[this])
                    call DestroyEffect(s__KyorakuSpells___KyorakuQ_KS_e2[this])
                    set s__KyorakuSpells___KyorakuQ_KS_c[this]=null
                    set s__KyorakuSpells___KyorakuQ_KS_e[this]=null
                    set s__KyorakuSpells___KyorakuQ_KS_e2[this]=null
