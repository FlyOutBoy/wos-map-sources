                endif
                return false
            elseif s__ItemsElementsFx_kind[this] == s__ItemsElementsFx_STRIKES then
                if not ItemsSpells__ElemAlive(s__ItemsElementsFx_u[this]) then
                    return true
                endif
                set s__ItemsElementsFx_next[this]=s__ItemsElementsFx_next[this] - s__ItemsElementsFx_DT
                if s__ItemsElementsFx_next[this] <= 0.0 then
                    set s__ItemsElementsFx_next[this]=0.3
                    set s__ItemsElementsFx_charges[this]=s__ItemsElementsFx_charges[this] + 1
                    call ItemsSpells__ElemFx("war3mapimported\\wos_WTW-whitethunder-Zi.mdx" , GetUnitX(s__ItemsElementsFx_u[this]) , GetUnitY(s__ItemsElementsFx_u[this]) , 1.0)
                    if SpellBool(s__ItemsElementsFx_u[this]) then
