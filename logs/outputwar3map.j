                        endif
                        call BlzSetSpecialEffectHeight(s__PatriotSpells___PatriotSpells_T2_e[this], BlzGetLocalSpecialEffectZ(s__PatriotSpells___PatriotSpells_T2_e[this]) - s__PatriotSpells___PatriotSpells_T2_r5[this])
                        call BlzSetSpecialEffectHeight(s__PatriotSpells___PatriotSpells_T2_e2[this], BlzGetLocalSpecialEffectZ(s__PatriotSpells___PatriotSpells_T2_e2[this]) - s__PatriotSpells___PatriotSpells_T2_r5[this])
