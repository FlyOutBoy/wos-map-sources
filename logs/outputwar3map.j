        function s__CrocodileSpells__CrocodileQ_Struct_Loop_CrocodileQ takes nothing returns nothing
            local integer this
            local integer i= 0
            local integer sectionCount
            local unit u
            local real step
            local real projection
            local real px
            local real py
            local real amount
            local real section
            local real damageDistance
            local real explosionAt
            local integer trail
            local boolean removeNow
            loop
                exitwhen i > s__CrocodileSpells__CrocodileQ_Struct_MUI
                set this=s__CrocodileSpells__CrocodileQ_Struct_m[i]
                set removeNow=s__CrocodileSpells__CrocodileQ_Struct_finished[this] and not s__CrocodileSpells__CrocodileQ_Struct_qPauseHeld[this]
                set s__CrocodileSpells__CrocodileQ_Struct_r[this]=RoundReal(s__CrocodileSpells__CrocodileQ_Struct_r[this] + CrocodileSpells__CrocodilePeriod , 3)
                if s__CrocodileSpells__CrocodileQ_Struct_qPauseHeld[this] and ( s__CrocodileSpells__CrocodileQ_Struct_r[this] + 0.001 >= CrocodileQ_PauseTime or not SpellBoolCaster(s__CrocodileSpells__CrocodileQ_Struct_c[this]) or GetUnitTypeId(s__CrocodileSpells__CrocodileQ_Struct_c[this]) == 0 ) then
                    set s__CrocodileSpells__CrocodileQ_Struct_qPauseHeld[this]=false
                    call StopSpellUnit2(s__CrocodileSpells__CrocodileQ_Struct_c[this])
            call MakeSound("war3mapImported\\Hero_Crocodile_Q2")
                endif
                if not s__CrocodileSpells__CrocodileQ_Struct_finished[this] and s__CrocodileSpells__CrocodileQ_Struct_r[this] < s__CrocodileSpells__CrocodileQ_Struct_rmax[this] and SpellBoolCaster(s__CrocodileSpells__CrocodileQ_Struct_c[this]) and LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileQ_Struct_c[this]), CrocodileSpells__CrocodileCore_DataKey) != 0 then
//---------------- Q cast / moving effect ------------------------------------
                    if s__CrocodileSpells__CrocodileQ_Struct_r[this] + 0.001 >= CrocodileQ_CastTime and s__CrocodileSpells__CrocodileQ_Struct_e[this] == null then
                        set s__CrocodileSpells__CrocodileQ_Struct_e[this]=EffectSpawn("war3mapImported\\wos_File00001240.mdl" , s__CrocodileSpells__CrocodileQ_Struct_startX[this] , s__CrocodileSpells__CrocodileQ_Struct_startY[this] , s__CrocodileSpells__CrocodileQ_Struct_a[this] * bj_RADTODEG , 1 , CrocodileQ_EffectScale * CrocodileQ_SlashScaleMultiplier , CrocodileQ_EffectHeight)
                    endif
                    if s__CrocodileSpells__CrocodileQ_Struct_r[this] + 0.001 >= CrocodileQ_CastTime then
                        set step=RMinBJ(s__CrocodileSpells__CrocodileQ_Struct_move[this], s__CrocodileSpells__CrocodileQ_Struct_maxDistance[this] - s__CrocodileSpells__CrocodileQ_Struct_distance[this])
                        set s__CrocodileSpells__CrocodileQ_Struct_previousDistance[this]=s__CrocodileSpells__CrocodileQ_Struct_distance[this]
                        set s__CrocodileSpells__CrocodileQ_Struct_distance[this]=s__CrocodileSpells__CrocodileQ_Struct_distance[this] + step
                        set s__CrocodileSpells__CrocodileQ_Struct_x[this]=s__CrocodileSpells__CrocodileQ_Struct_startX[this] + s__CrocodileSpells__CrocodileQ_Struct_distance[this] * Cos(s__CrocodileSpells__CrocodileQ_Struct_a[this])
                        set s__CrocodileSpells__CrocodileQ_Struct_y[this]=s__CrocodileSpells__CrocodileQ_Struct_startY[this] + s__CrocodileSpells__CrocodileQ_Struct_distance[this] * Sin(s__CrocodileSpells__CrocodileQ_Struct_a[this])
                        // Keep the configured model-length offset proportional to slash scale.
                        if s__CrocodileSpells__CrocodileQ_Struct_effectDistance[this] < s__CrocodileSpells__CrocodileQ_Struct_effectStop[this] then
                            call MoveEff(s__CrocodileSpells__CrocodileQ_Struct_e[this] , RMinBJ(s__CrocodileSpells__CrocodileQ_Struct_distance[this], s__CrocodileSpells__CrocodileQ_Struct_effectStop[this]) - s__CrocodileSpells__CrocodileQ_Struct_effectDistance[this] , s__CrocodileSpells__CrocodileQ_Struct_a[this])
                            set s__CrocodileSpells__CrocodileQ_Struct_effectDistance[this]=RMinBJ(s__CrocodileSpells__CrocodileQ_Struct_distance[this], s__CrocodileSpells__CrocodileQ_Struct_effectStop[this])
                        endif
                        loop
                            exitwhen s__CrocodileSpells__CrocodileQ_Struct_nextTrail[this] > s__CrocodileSpells__CrocodileQ_Struct_distance[this]
                            set trail=s__CrocodileSpells__CrocodileQ_Trail__allocate()
                            set s__CrocodileSpells__CrocodileQ_Trail_e[trail]=EffectSpawn("war3mapImported\\wos_File00001240.mdl" , s__CrocodileSpells__CrocodileQ_Struct_startX[this] + ( s__CrocodileSpells__CrocodileQ_Struct_nextTrail[this] - CrocodileQ_TrailSpacing ) * Cos(s__CrocodileSpells__CrocodileQ_Struct_a[this]) , s__CrocodileSpells__CrocodileQ_Struct_startY[this] + ( s__CrocodileSpells__CrocodileQ_Struct_nextTrail[this] - CrocodileQ_TrailSpacing ) * Sin(s__CrocodileSpells__CrocodileQ_Struct_a[this]) , s__CrocodileSpells__CrocodileQ_Struct_a[this] * bj_RADTODEG , 1 , CrocodileQ_EffectScale * CrocodileQ_SlashScaleMultiplier , CrocodileQ_EffectHeight)
                            set s__CrocodileSpells__CrocodileQ_Trail_age[trail]=0.0
                            set s__CrocodileSpells__CrocodileQ_Trail_next[trail]=s__CrocodileSpells__CrocodileQ_Struct_trails[this]
                            set s__CrocodileSpells__CrocodileQ_Struct_trails[this]=trail
                            set s__CrocodileSpells__CrocodileQ_Struct_nextTrail[this]=s__CrocodileSpells__CrocodileQ_Struct_nextTrail[this] + RMaxBJ(1.0, CrocodileQ_TrailSpacing)
                        endloop
//---------------- Q first pass: scan every moved segment immediately --------
                        loop
                            exitwhen s__CrocodileSpells__CrocodileQ_Struct_scanDistance[this] >= s__CrocodileSpells__CrocodileQ_Struct_distance[this]
                            set section=RMinBJ(s__CrocodileSpells__CrocodileQ_Struct_scanStep[this], s__CrocodileSpells__CrocodileQ_Struct_distance[this] - s__CrocodileSpells__CrocodileQ_Struct_scanDistance[this])
                            set px=s__CrocodileSpells__CrocodileQ_Struct_startX[this] + ( s__CrocodileSpells__CrocodileQ_Struct_scanDistance[this] + section / 2 ) * Cos(s__CrocodileSpells__CrocodileQ_Struct_a[this])
                            set py=s__CrocodileSpells__CrocodileQ_Struct_startY[this] + ( s__CrocodileSpells__CrocodileQ_Struct_scanDistance[this] + section / 2 ) * Sin(s__CrocodileSpells__CrocodileQ_Struct_a[this])
                            call VisionTimed(GetOwningPlayer(s__CrocodileSpells__CrocodileQ_Struct_c[this]) , px , py , s__CrocodileSpells__CrocodileQ_Struct_radius[this] * 1.5 , 3.0)
                            call DecorRemoveLine(s__CrocodileSpells__CrocodileQ_Struct_c[this] , s__CrocodileSpells__CrocodileQ_Struct_startX[this] + s__CrocodileSpells__CrocodileQ_Struct_scanDistance[this] * Cos(s__CrocodileSpells__CrocodileQ_Struct_a[this]) , s__CrocodileSpells__CrocodileQ_Struct_startY[this] + s__CrocodileSpells__CrocodileQ_Struct_scanDistance[this] * Sin(s__CrocodileSpells__CrocodileQ_Struct_a[this]) , s__CrocodileSpells__CrocodileQ_Struct_a[this] , section , s__CrocodileSpells__CrocodileQ_Struct_radius[this] , 15.0 , CrocodileSpells__CrocodileDecorHits , s__CrocodileSpells__CrocodileQ_Struct_decorKey[this])
                            call CrocodileSpells__CrocodileW_CheckQ(s__CrocodileSpells__CrocodileQ_Struct_c[this] , s__CrocodileSpells__CrocodileQ_Struct_startX[this] , s__CrocodileSpells__CrocodileQ_Struct_startY[this] , s__CrocodileSpells__CrocodileQ_Struct_a[this] , s__CrocodileSpells__CrocodileQ_Struct_scanDistance[this] , s__CrocodileSpells__CrocodileQ_Struct_scanDistance[this] + section , s__CrocodileSpells__CrocodileQ_Struct_radius[this])
                            call GroupEnumUnitsInRange(s__CrocodileSpells__CrocodileQ_Struct_g[this], px, py, s__CrocodileSpells__CrocodileQ_Struct_radius[this] + section / 2, NoDecor_Cond)
                            loop
                                set u=FirstOfGroup(s__CrocodileSpells__CrocodileQ_Struct_g[this])
                                exitwhen u == null
                                call GroupRemoveUnit(s__CrocodileSpells__CrocodileQ_Struct_g[this], u)
                                set projection=RMaxBJ(s__CrocodileSpells__CrocodileQ_Struct_scanDistance[this], RMinBJ(s__CrocodileSpells__CrocodileQ_Struct_scanDistance[this] + section, ( GetUnitX(u) - s__CrocodileSpells__CrocodileQ_Struct_startX[this] ) * Cos(s__CrocodileSpells__CrocodileQ_Struct_a[this]) + ( GetUnitY(u) - s__CrocodileSpells__CrocodileQ_Struct_startY[this] ) * Sin(s__CrocodileSpells__CrocodileQ_Struct_a[this])))
                                set px=s__CrocodileSpells__CrocodileQ_Struct_startX[this] + projection * Cos(s__CrocodileSpells__CrocodileQ_Struct_a[this])
                                set py=s__CrocodileSpells__CrocodileQ_Struct_startY[this] + projection * Sin(s__CrocodileSpells__CrocodileQ_Struct_a[this])
                                if SpellBool(u) and IsUnitEnemy(u, GetOwningPlayer(s__CrocodileSpells__CrocodileQ_Struct_c[this])) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) and not IsUnitInGroup(u, s__CrocodileSpells__CrocodileQ_Struct_g2[this]) and SR3(u , px , py) <= s__CrocodileSpells__CrocodileQ_Struct_radius[this] then
                                    call GroupAddUnit(s__CrocodileSpells__CrocodileQ_Struct_g2[this], u)
                                    call CrocodileQ_ApplySandMark(s__CrocodileSpells__CrocodileQ_Struct_c[(this)] , (u)) // INLINED!!
                                    call SlowUnit(s__CrocodileSpells__CrocodileQ_Struct_c[this] , u , CrocodileQ_Slow , 2)
                                    if CrocodileQ_PullDuration > 0.0 and SR3(u , px , py) > 1.0 then
                                        set projection=RMaxBJ(0.0, RMinBJ(s__CrocodileSpells__CrocodileQ_Struct_maxDistance[this], ( GetUnitX(u) - s__CrocodileSpells__CrocodileQ_Struct_startX[this] ) * Cos(s__CrocodileSpells__CrocodileQ_Struct_a[this]) + ( GetUnitY(u) - s__CrocodileSpells__CrocodileQ_Struct_startY[this] ) * Sin(s__CrocodileSpells__CrocodileQ_Struct_a[this])))
                                        set px=s__CrocodileSpells__CrocodileQ_Struct_startX[this] + projection * Cos(s__CrocodileSpells__CrocodileQ_Struct_a[this])
                                        set py=s__CrocodileSpells__CrocodileQ_Struct_startY[this] + projection * Sin(s__CrocodileSpells__CrocodileQ_Struct_a[this])
                                        call CrocodileSpells__CrocodileQ_Pull(u , px , py)
                                    endif
                                endif
                            endloop
                            set s__CrocodileSpells__CrocodileQ_Struct_scanDistance[this]=s__CrocodileSpells__CrocodileQ_Struct_scanDistance[this] + section
                        endloop
                        if s__CrocodileSpells__CrocodileQ_Struct_distance[this] + 0.001 >= s__CrocodileSpells__CrocodileQ_Struct_maxDistance[this] then
//---------------- Q endpoint fade / original explosion layout --------------
                            set amount=250.0
                            set sectionCount=0
                            loop
                                exitwhen amount > s__CrocodileSpells__CrocodileQ_Struct_distance[this] or sectionCount >= 6
                                set explosionAt=amount
                                // The last explosion's art reaches ~150 past its point: pull it back.
                                if amount + RMaxBJ(1.0, CrocodileQ_ExplosionSpacing) > s__CrocodileSpells__CrocodileQ_Struct_distance[this] or sectionCount >= 5 then
                                    set explosionAt=RMaxBJ(250.0, amount - CrocodileQ_LastExplosionBack)
                                endif
                                call DestroyEffect(EffectSpawn("war3mapImported\\wos_sandSlashUp.mdl" , s__CrocodileSpells__CrocodileQ_Struct_startX[this] + explosionAt * Cos(s__CrocodileSpells__CrocodileQ_Struct_a[this]) , s__CrocodileSpells__CrocodileQ_Struct_startY[this] + explosionAt * Sin(s__CrocodileSpells__CrocodileQ_Struct_a[this]) , s__CrocodileSpells__CrocodileQ_Struct_a[this] * bj_RADTODEG , 1 , CrocodileQ_ExplosionScale , 0))
                                set amount=amount + RMaxBJ(1.0, CrocodileQ_ExplosionSpacing)
                                set sectionCount=sectionCount + 1
                            endloop
                            call s__CrocodileSpells__CrocodileQ_Struct_CrocodileQ_ClearVisuals(this)
                            
            call MakeSound("war3mapImported\\Hero_Crocodile_Q3")
//---------------- Q damage: independent of VFX count; same AoE scan step -----
                            set damageDistance=s__CrocodileSpells__CrocodileQ_Struct_distance[this] + CrocodileQ_DamageEndPadding
                            call s__CrocodileSpells__CrocodileQ_ExplosionDecor_CrocodileQExplosionDecor_Start(s__CrocodileSpells__CrocodileQ_Struct_c[this] , s__CrocodileSpells__CrocodileQ_Struct_startX[this] , s__CrocodileSpells__CrocodileQ_Struct_startY[this] , s__CrocodileSpells__CrocodileQ_Struct_a[this] , damageDistance , s__CrocodileSpells__CrocodileQ_Struct_radius[this] , s__CrocodileSpells__CrocodileQ_Struct_scanStep[this])
                            set amount=0.0
                            loop
                                exitwhen amount >= damageDistance
                                set section=RMinBJ(s__CrocodileSpells__CrocodileQ_Struct_scanStep[this], damageDistance - amount)
                                call GroupEnumUnitsInRange(s__CrocodileSpells__CrocodileQ_Struct_g[this], s__CrocodileSpells__CrocodileQ_Struct_startX[this] + ( amount + section / 2 ) * Cos(s__CrocodileSpells__CrocodileQ_Struct_a[this]), s__CrocodileSpells__CrocodileQ_Struct_startY[this] + ( amount + section / 2 ) * Sin(s__CrocodileSpells__CrocodileQ_Struct_a[this]), s__CrocodileSpells__CrocodileQ_Struct_radius[this] + section / 2, NoDecor_Cond)
                                loop
                                    set u=FirstOfGroup(s__CrocodileSpells__CrocodileQ_Struct_g[this])
                                    exitwhen u == null
                                    call GroupRemoveUnit(s__CrocodileSpells__CrocodileQ_Struct_g[this], u)
                                    set projection=RMaxBJ(amount, RMinBJ(amount + section, ( GetUnitX(u) - s__CrocodileSpells__CrocodileQ_Struct_startX[this] ) * Cos(s__CrocodileSpells__CrocodileQ_Struct_a[this]) + ( GetUnitY(u) - s__CrocodileSpells__CrocodileQ_Struct_startY[this] ) * Sin(s__CrocodileSpells__CrocodileQ_Struct_a[this])))
                                    set px=s__CrocodileSpells__CrocodileQ_Struct_startX[this] + projection * Cos(s__CrocodileSpells__CrocodileQ_Struct_a[this])
                                    set py=s__CrocodileSpells__CrocodileQ_Struct_startY[this] + projection * Sin(s__CrocodileSpells__CrocodileQ_Struct_a[this])
                                    if SpellBool(u) and IsUnitEnemy(u, GetOwningPlayer(s__CrocodileSpells__CrocodileQ_Struct_c[this])) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) and not IsUnitInGroup(u, s__CrocodileSpells__CrocodileQ_Struct_g3[this]) and SR3(u , px , py) <= s__CrocodileSpells__CrocodileQ_Struct_radius[this] then
                                        call GroupAddUnit(s__CrocodileSpells__CrocodileQ_Struct_g3[this], u)
                                        if not IsUnitInGroup(u, s__CrocodileSpells__CrocodileQ_Struct_g2[this]) then
                                            call GroupAddUnit(s__CrocodileSpells__CrocodileQ_Struct_g2[this], u)
                                            call CrocodileQ_ApplySandMark(s__CrocodileSpells__CrocodileQ_Struct_c[(this)] , (u)) // INLINED!!
                                            call SlowUnit(s__CrocodileSpells__CrocodileQ_Struct_c[this] , u , CrocodileQ_Slow , 2)
                                        endif
                                        set GearDamageNextSource=('A0I7') // INLINED!!
                                        call dmgphys(s__CrocodileSpells__CrocodileQ_Struct_c[this] , u , s__CrocodileSpells__CrocodileQ_Struct_dmg[this])
                                    endif
                                endloop
                                set amount=amount + section
                            endloop
                            set sectionCount=0
                            loop
                                exitwhen sectionCount >= CrocodileQ_GroundSandCount
                                set amount=s__CrocodileSpells__CrocodileQ_Struct_distance[this] * ( sectionCount + 0.5 ) / IMaxBJ(1, CrocodileQ_GroundSandCount)
                                call s__CrocodileSpells__CrocodileSand_Struct_CrocodileSand_Start(s__CrocodileSpells__CrocodileQ_Struct_c[this] , s__CrocodileSpells__CrocodileQ_Struct_startX[this] + amount * Cos(s__CrocodileSpells__CrocodileQ_Struct_a[this]) , s__CrocodileSpells__CrocodileQ_Struct_startY[this] + amount * Sin(s__CrocodileSpells__CrocodileQ_Struct_a[this]) , CrocodileQ_GroundSandAoe , true)
                                set sectionCount=sectionCount + 1
                            endloop
                            set s__CrocodileSpells__CrocodileQ_Struct_finished[this]=true // Keep endpoint for W combo this tick.
                        endif
                    endif
                endif
                set trail=s__CrocodileSpells__CrocodileQ_Struct_trails[this]
                loop
                    exitwhen trail == 0
                    set s__CrocodileSpells__CrocodileQ_Trail_age[trail]=s__CrocodileSpells__CrocodileQ_Trail_age[trail] + CrocodileSpells__CrocodilePeriod
                    call BlzSetSpecialEffectAlpha(s__CrocodileSpells__CrocodileQ_Trail_e[trail], R2I(255.0 * ( 1.0 - RMinBJ(1.0, RMaxBJ(0.0, ( s__CrocodileSpells__CrocodileQ_Trail_age[trail] - 0.45 ) / 0.15)) )))
                    set trail=s__CrocodileSpells__CrocodileQ_Trail_next[trail]
                endloop
                if removeNow or s__CrocodileSpells__CrocodileQ_Struct_r[this] >= s__CrocodileSpells__CrocodileQ_Struct_rmax[this] or not SpellBoolCaster(s__CrocodileSpells__CrocodileQ_Struct_c[this]) or LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileQ_Struct_c[this]), CrocodileSpells__CrocodileCore_DataKey) == 0 then
//---------------- Q cleanup: normal finish OR debug deadline ----------------
                    if s__CrocodileSpells__CrocodileQ_Struct_qPauseHeld[this] then
                        set s__CrocodileSpells__CrocodileQ_Struct_qPauseHeld[this]=false
                        call StopSpellUnit2(s__CrocodileSpells__CrocodileQ_Struct_c[this])
                    endif
                    call s__CrocodileSpells__CrocodileQ_Struct_CrocodileQ_ClearVisuals(this)
                    call FlushChildHashtable(CrocodileSpells__CrocodileDecorHits, s__CrocodileSpells__CrocodileQ_Struct_decorKey[this])
                    call DestroyGroup(s__CrocodileSpells__CrocodileQ_Struct_g[this])
                    call DestroyGroup(s__CrocodileSpells__CrocodileQ_Struct_g2[this])
                    call DestroyGroup(s__CrocodileSpells__CrocodileQ_Struct_g3[this])
                    set s__CrocodileSpells__CrocodileQ_Struct_c[this]=null
                    set s__CrocodileSpells__CrocodileQ_Struct_e[this]=null
                    set s__CrocodileSpells__CrocodileQ_Struct_g[this]=null
                    set s__CrocodileSpells__CrocodileQ_Struct_g2[this]=null
                    set s__CrocodileSpells__CrocodileQ_Struct_g3[this]=null
                    set s__CrocodileSpells__CrocodileQ_Struct_m[i]=s__CrocodileSpells__CrocodileQ_Struct_m[s__CrocodileSpells__CrocodileQ_Struct_MUI]
                    set s__CrocodileSpells__CrocodileQ_Struct_MUI=s__CrocodileSpells__CrocodileQ_Struct_MUI - 1
                    call s__CrocodileSpells__CrocodileQ_Struct_deallocate(this)
                    if s__CrocodileSpells__CrocodileQ_Struct_MUI == - 1 then
                        call GearTimer03Release()
                    endif
                else
                    set i=i + 1
                endif
            endloop
            set u=null
        endfunction

        function s__CrocodileSpells__CrocodileQ_Struct_CrocodileQ_Begin takes unit NewC,real NewX,real NewY returns boolean
            local integer this
            if LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(NewC), CrocodileSpells__CrocodileCore_DataKey) == 0 or IsUnitIllusion(NewC) or not SpellBoolCaster(NewC) or LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(NewC), CrocodileSpells__CrocodileT_PhaseKey) != 0 then
                return false
            endif
            if CrocodileQ_Move <= 0.0 or CrocodileQ_Distance <= 0.0 or CrocodileQ_Aoe <= 0.0 then
                return false
            endif
            set this=s__CrocodileSpells__CrocodileQ_Struct__allocate()
            set s__CrocodileSpells__CrocodileQ_Struct_MUI=s__CrocodileSpells__CrocodileQ_Struct_MUI + 1
            set s__CrocodileSpells__CrocodileQ_Struct_m[s__CrocodileSpells__CrocodileQ_Struct_MUI]=this
            if s__CrocodileSpells__CrocodileQ_Struct_MUI == 0 then
                call GearTimer03Acquire()
            endif
            set s__CrocodileSpells__CrocodileQ_Struct_c[this]=NewC
            set s__CrocodileSpells__CrocodileQ_Struct_x[this]=GetUnitX(s__CrocodileSpells__CrocodileQ_Struct_c[this])
            set s__CrocodileSpells__CrocodileQ_Struct_y[this]=GetUnitY(s__CrocodileSpells__CrocodileQ_Struct_c[this])
            set s__CrocodileSpells__CrocodileQ_Struct_startX[this]=s__CrocodileSpells__CrocodileQ_Struct_x[this]
            set s__CrocodileSpells__CrocodileQ_Struct_startY[this]=s__CrocodileSpells__CrocodileQ_Struct_y[this]
            set s__CrocodileSpells__CrocodileQ_Struct_a[this]=Atan2(NewY - s__CrocodileSpells__CrocodileQ_Struct_y[this], NewX - s__CrocodileSpells__CrocodileQ_Struct_x[this])
            set s__CrocodileSpells__CrocodileQ_Struct_move[this]=CrocodileQ_Move
            set s__CrocodileSpells__CrocodileQ_Struct_distance[this]=0.0
            set s__CrocodileSpells__CrocodileQ_Struct_previousDistance[this]=0.0
            set s__CrocodileSpells__CrocodileQ_Struct_maxDistance[this]=CrocodileQ_Distance
            set s__CrocodileSpells__CrocodileQ_Struct_effectDistance[this]=0.0
            set s__CrocodileSpells__CrocodileQ_Struct_effectStop[this]=RMaxBJ(0.0, s__CrocodileSpells__CrocodileQ_Struct_maxDistance[this] - CrocodileQ_EffectStopDistance * CrocodileQ_SlashScaleMultiplier)
            set s__CrocodileSpells__CrocodileQ_Struct_scanDistance[this]=0.0
            set s__CrocodileSpells__CrocodileQ_Struct_decorKey[this]=CrocodileSpells__CrocodileDecor_NewKey()
            set s__CrocodileSpells__CrocodileQ_Struct_radius[this]=CrocodileQ_Aoe
            set s__CrocodileSpells__CrocodileQ_Struct_scanStep[this]=RMaxBJ(1.0, s__CrocodileSpells__CrocodileQ_Struct_radius[this] - CrocodileQ_ScanOverlap)
            set s__CrocodileSpells__CrocodileQ_Struct_dmg[this]=GetHeroAgi(s__CrocodileSpells__CrocodileQ_Struct_c[this], true) * ( CrocodileQ_DamageAgiBase + CrocodileQ_DamageAgiStep * ( GetUnitAbilityLevel(s__CrocodileSpells__CrocodileQ_Struct_c[this], CrocodileQ_ID) - 1 ) ) + CrocodileQ_DamageStatic
            set s__CrocodileSpells__CrocodileQ_Struct_r[this]=0.0
            // At least 3 sec; large distance/slow movement gets a longer deadline.
            set s__CrocodileSpells__CrocodileQ_Struct_rmax[this]=RMaxBJ(CrocodileQ_DebugTime, CrocodileQ_CastTime + s__CrocodileSpells__CrocodileQ_Struct_maxDistance[this] / s__CrocodileSpells__CrocodileQ_Struct_move[this] * CrocodileSpells__CrocodilePeriod + 1.0)
            set s__CrocodileSpells__CrocodileQ_Struct_nextTrail[this]=RMaxBJ(1.0, CrocodileQ_TrailSpacing)
            set s__CrocodileSpells__CrocodileQ_Struct_qPauseHeld[this]=true
            call StartSpellUnit2(s__CrocodileSpells__CrocodileQ_Struct_c[this])
            set s__CrocodileSpells__CrocodileQ_Struct_finished[this]=false
            set s__CrocodileSpells__CrocodileQ_Struct_g[this]=CreateGroup() // Reused for every scan; no CreateGroup in loops.
            set s__CrocodileSpells__CrocodileQ_Struct_g2[this]=CreateGroup() // First-pass slow/pull, once per target.
            set s__CrocodileSpells__CrocodileQ_Struct_g3[this]=CreateGroup() // Final damage, once per target.
            set s__CrocodileSpells__CrocodileQ_Struct_e[this]=null
            set s__CrocodileSpells__CrocodileQ_Struct_trails[this]=0
            call SetUnitAnimationByIndex(s__CrocodileSpells__CrocodileQ_Struct_c[this], CrocodileQ_Animation)
            if GetRandomInt(1, 2) == 1 then
            call MakeSound("war3mapImported\\Hero_Crocodile_Q_2")
            else
            call MakeSound("war3mapImported\\Hero_Crocodile_Q")
            endif
            return true
        endfunction



//================================ Crocodile W - Desert Girasole ========================================


        // Shared only by W cast and Q crossing a pit. One combo per pit.
        function s__CrocodileSpells__CrocodileW_Struct_CrocodileW_Combo takes integer this returns nothing
            local unit u
            local effect e2
            if s__CrocodileSpells__CrocodileW_Struct_combo[this] then
                return
            endif
            set s__CrocodileSpells__CrocodileW_Struct_combo[this]=true
            set s__CrocodileSpells__CrocodileW_Struct_comboPullTime[this]=0.24
            set e2=EffectSpawn("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl" , s__CrocodileSpells__CrocodileW_Struct_x[this] , s__CrocodileSpells__CrocodileW_Struct_y[this] , 0 , 1 , s__CrocodileSpells__CrocodileW_Struct_radius[this] / 150.0 , 0)
            call s__GearSystems2___KS_RemoveEffect_MyRemoveEff_Start((e2 ) , (( 1.0)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
            call GroupEnumUnitsInRange(s__CrocodileSpells__CrocodileW_Struct_g[this], s__CrocodileSpells__CrocodileW_Struct_x[this], s__CrocodileSpells__CrocodileW_Struct_y[this], s__CrocodileSpells__CrocodileW_Struct_radius[this], NoDecor_Cond)
            loop
                set u=FirstOfGroup(s__CrocodileSpells__CrocodileW_Struct_g[this])
                exitwhen u == null
                call GroupRemoveUnit(s__CrocodileSpells__CrocodileW_Struct_g[this], u)
                if SpellBool(u) and IsUnitEnemy(u, GetOwningPlayer(s__CrocodileSpells__CrocodileW_Struct_c[this])) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) then
                    set GearDamageNextSource=('A0I8') // INLINED!!
                    call CrocodileSpells__Crocodile_SpellDamage(s__CrocodileSpells__CrocodileW_Struct_c[this] , u , GetHeroAgi(s__CrocodileSpells__CrocodileW_Struct_c[this], true) * CrocodileW_ComboDamageAgi , s__CrocodileSpells__CrocodileW_Struct_manaKey[this])
                    call CrocodileSpells__Crocodile_ApplySharedMark(s__CrocodileSpells__CrocodileW_Struct_c[this] , u)
                    call GroupAddUnit(s__CrocodileSpells__CrocodileW_Struct_pullGroup[this], u)
                    if GetHeroLevel(s__CrocodileSpells__CrocodileW_Struct_c[this]) >= CrocodileW_ComboFullLevel then
                        call StunUnit(s__CrocodileSpells__CrocodileW_Struct_c[this] , u , CrocodileW_ComboStun)
                    else
                        call StunUnit(s__CrocodileSpells__CrocodileW_Struct_c[this] , u , CrocodileW_ComboStunEarly)
                    endif
                endif
            endloop
            set u=null
            set e2=null
        endfunction

        function s__CrocodileSpells__CrocodileW_Struct_CrocodileW_RecordQ takes unit source,real sx,real sy,real angle,real fromDistance,real toDistance,real qRadius returns nothing
            local integer i= 0
            local integer this
            local real projection
            loop
                exitwhen i > s__CrocodileSpells__CrocodileW_Struct_MUI
                set this=s__CrocodileSpells__CrocodileW_Struct_m[i]
                if s__CrocodileSpells__CrocodileW_Struct_c[this] == source and not s__CrocodileSpells__CrocodileW_Struct_combo[this] and s__CrocodileSpells__CrocodileW_Struct_r[this] < s__CrocodileSpells__CrocodileW_Struct_rmax[this] then
                    set projection=RMaxBJ(fromDistance, RMinBJ(toDistance, ( s__CrocodileSpells__CrocodileW_Struct_x[this] - sx ) * Cos(angle) + ( s__CrocodileSpells__CrocodileW_Struct_y[this] - sy ) * Sin(angle)))
                    if SR0(s__CrocodileSpells__CrocodileW_Struct_x[this] , s__CrocodileSpells__CrocodileW_Struct_y[this] , sx + projection * Cos(angle) , sy + projection * Sin(angle)) <= s__CrocodileSpells__CrocodileW_Struct_radius[this] + qRadius then
                        set s__CrocodileSpells__CrocodileW_Struct_comboPending[this]=true
                    endif
                endif
                set i=i + 1
            endloop
        endfunction

        function s__CrocodileSpells__CrocodileW_Struct_Loop_CrocodileW takes nothing returns nothing
            local integer this
            local integer i= 0
            local unit u
            local integer slash
            local integer j
            local real projection
            local real distance
            local real depth
            local real pullSpeed
            loop
                exitwhen i > s__CrocodileSpells__CrocodileW_Struct_MUI
                set this=s__CrocodileSpells__CrocodileW_Struct_m[i]
                if s__CrocodileSpells__CrocodileW_Struct_r[this] == 0.51 then
            call MakeSound("war3mapImported\\Hero_Crocodile_W2")
                endif
                if not s__CrocodileSpells__CrocodileW_Struct_combo[this] and SpellBoolCaster(s__CrocodileSpells__CrocodileW_Struct_c[this]) and LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileW_Struct_c[this]), CrocodileSpells__CrocodileCore_DataKey) != 0 then
//---------------- W + Q: check the current segment, including final tick ----
                set j=0
                loop
                    exitwhen j > s__CrocodileSpells__CrocodileQ_Struct_MUI
                    set slash=s__CrocodileSpells__CrocodileQ_Struct_m[j]
                    if s__CrocodileSpells__CrocodileQ_Struct_c[slash] == s__CrocodileSpells__CrocodileW_Struct_c[this] and s__CrocodileSpells__CrocodileQ_Struct_distance[slash] > 0.0 and not s__CrocodileSpells__CrocodileW_Struct_combo[this] then
                        set projection=RMaxBJ(s__CrocodileSpells__CrocodileQ_Struct_previousDistance[slash], RMinBJ(s__CrocodileSpells__CrocodileQ_Struct_distance[slash], ( s__CrocodileSpells__CrocodileW_Struct_x[this] - s__CrocodileSpells__CrocodileQ_Struct_startX[slash] ) * Cos(s__CrocodileSpells__CrocodileQ_Struct_a[slash]) + ( s__CrocodileSpells__CrocodileW_Struct_y[this] - s__CrocodileSpells__CrocodileQ_Struct_startY[slash] ) * Sin(s__CrocodileSpells__CrocodileQ_Struct_a[slash])))
                        if SR0(s__CrocodileSpells__CrocodileW_Struct_x[this] , s__CrocodileSpells__CrocodileW_Struct_y[this] , s__CrocodileSpells__CrocodileQ_Struct_startX[slash] + projection * Cos(s__CrocodileSpells__CrocodileQ_Struct_a[slash]) , s__CrocodileSpells__CrocodileQ_Struct_startY[slash] + projection * Sin(s__CrocodileSpells__CrocodileQ_Struct_a[slash])) <= s__CrocodileSpells__CrocodileW_Struct_radius[this] + s__CrocodileSpells__CrocodileQ_Struct_radius[slash] then
                            set s__CrocodileSpells__CrocodileW_Struct_comboPending[this]=true
                        endif
                    endif
                    set j=j + 1
                endloop
                endif
                set s__CrocodileSpells__CrocodileW_Struct_r[this]=RoundReal(s__CrocodileSpells__CrocodileW_Struct_r[this] + CrocodileSpells__CrocodilePeriod , 3)
                if s__CrocodileSpells__CrocodileW_Struct_castPauseHeld[this] and ( s__CrocodileSpells__CrocodileW_Struct_r[this] + 0.001 >= s__CrocodileSpells__CrocodileW_Struct_castTime[this] or not SpellBoolCaster(s__CrocodileSpells__CrocodileW_Struct_c[this]) ) then
                    set s__CrocodileSpells__CrocodileW_Struct_castPauseHeld[this]=false
                    call StopSpellUnit2(s__CrocodileSpells__CrocodileW_Struct_c[this])
                endif
                set s__CrocodileSpells__CrocodileW_Struct_scanTime[this]=s__CrocodileSpells__CrocodileW_Struct_scanTime[this] + CrocodileSpells__CrocodilePeriod
                if SpellBoolCaster(s__CrocodileSpells__CrocodileW_Struct_c[this]) and LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileW_Struct_c[this]), CrocodileSpells__CrocodileCore_DataKey) != 0 and s__CrocodileSpells__CrocodileW_Struct_r[this] > 0.51 then
                    if s__CrocodileSpells__CrocodileW_Struct_comboPending[this] then
                        call s__CrocodileSpells__CrocodileW_Struct_CrocodileW_Combo(this)
                        set s__CrocodileSpells__CrocodileW_Struct_comboPending[this]=false
                    endif
                    set s__CrocodileSpells__CrocodileW_Struct_decorPulse[this]=s__CrocodileSpells__CrocodileW_Struct_decorPulse[this] + CrocodileSpells__CrocodilePeriod
                    if s__CrocodileSpells__CrocodileW_Struct_decorPulse[this] + 0.001 >= CrocodileW_DecorPeriod then
                        set s__CrocodileSpells__CrocodileW_Struct_decorPulse[this]=s__CrocodileSpells__CrocodileW_Struct_decorPulse[this] - RMaxBJ(CrocodileSpells__CrocodilePeriod, CrocodileW_DecorPeriod)
                        call DecorRemove(s__CrocodileSpells__CrocodileW_Struct_c[this] , s__CrocodileSpells__CrocodileW_Struct_x[this] , s__CrocodileSpells__CrocodileW_Struct_y[this] , s__CrocodileSpells__CrocodileW_Struct_radius[this] , CrocodileW_DecorDamage)
                    endif
                    if s__CrocodileSpells__CrocodileW_Struct_scanTime[this] + 0.001 >= 0.15 or s__CrocodileSpells__CrocodileW_Struct_r[this] + 0.001 >= s__CrocodileSpells__CrocodileW_Struct_rmax[this] then
                        set s__CrocodileSpells__CrocodileW_Struct_scanTime[this]=0.0
                        call GroupEnumUnitsInRange(s__CrocodileSpells__CrocodileW_Struct_pullGroup[this], s__CrocodileSpells__CrocodileW_Struct_x[this], s__CrocodileSpells__CrocodileW_Struct_y[this], s__CrocodileSpells__CrocodileW_Struct_radius[this], NoDecor_Cond)
                    endif
                    set j=BlzGroupGetSize(s__CrocodileSpells__CrocodileW_Struct_pullGroup[this]) - 1
                    loop
                        exitwhen j < 0
                        set u=BlzGroupUnitAt(s__CrocodileSpells__CrocodileW_Struct_pullGroup[this], j)
                        if SpellBool(u) and IsUnitEnemy(u, GetOwningPlayer(s__CrocodileSpells__CrocodileW_Struct_c[this])) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) then
                            set distance=SR3(u , s__CrocodileSpells__CrocodileW_Struct_x[this] , s__CrocodileSpells__CrocodileW_Struct_y[this])
                            if distance > 0.0 and distance <= s__CrocodileSpells__CrocodileW_Struct_radius[this] then
                                // Linear depth and a stronger rim keep the outer pull useful.
                                set depth=RMaxBJ(0.0, 1.0 - distance / RMaxBJ(1.0, s__CrocodileSpells__CrocodileW_Struct_radius[this]))
                                set pullSpeed=CrocodileW_PullSpeed * ( CrocodileW_EdgePullMultiplier + ( 1.0 - CrocodileW_EdgePullMultiplier ) * depth )
                                if s__CrocodileSpells__CrocodileW_Struct_comboPullTime[this] > 0.0 and GetHeroLevel(s__CrocodileSpells__CrocodileW_Struct_c[this]) >= CrocodileW_ComboFullLevel then
                                    set pullSpeed=RMaxBJ(pullSpeed, distance / RMaxBJ(CrocodileSpells__CrocodilePeriod, s__CrocodileSpells__CrocodileW_Struct_comboPullTime[this]))
                                elseif s__CrocodileSpells__CrocodileW_Struct_comboPullTime[this] > 0.0 then
                                    set pullSpeed=RMaxBJ(pullSpeed, RMinBJ(CrocodileW_ComboPullSpeedEarly, distance / RMaxBJ(CrocodileSpells__CrocodilePeriod, s__CrocodileSpells__CrocodileW_Struct_comboPullTime[this])))
                                endif
                                call MoveUnit(u , RMinBJ(pullSpeed * CrocodileSpells__CrocodilePeriod, distance) , Atan2(s__CrocodileSpells__CrocodileW_Struct_y[this] - GetUnitY(u), s__CrocodileSpells__CrocodileW_Struct_x[this] - GetUnitX(u)))
                            endif
                        endif
                        set j=j - 1
                    endloop
                    set s__CrocodileSpells__CrocodileW_Struct_comboPullTime[this]=RMaxBJ(0.0, RoundReal(s__CrocodileSpells__CrocodileW_Struct_comboPullTime[this] - CrocodileSpells__CrocodilePeriod , 3))
                    loop
                        exitwhen s__CrocodileSpells__CrocodileW_Struct_hits[this] >= CrocodileW_Hits or s__CrocodileSpells__CrocodileW_Struct_r[this] + 0.001 < ( s__CrocodileSpells__CrocodileW_Struct_hits[this] + 1 ) * s__CrocodileSpells__CrocodileW_Struct_damageRmax[this] / IMaxBJ(1, CrocodileW_Hits)
                        call GroupEnumUnitsInRange(s__CrocodileSpells__CrocodileW_Struct_g[this], s__CrocodileSpells__CrocodileW_Struct_x[this], s__CrocodileSpells__CrocodileW_Struct_y[this], s__CrocodileSpells__CrocodileW_Struct_radius[this], NoDecor_Cond)
                        loop
                            set u=FirstOfGroup(s__CrocodileSpells__CrocodileW_Struct_g[this])
                            exitwhen u == null
                            call GroupRemoveUnit(s__CrocodileSpells__CrocodileW_Struct_g[this], u)
                            if SpellBool(u) and IsUnitEnemy(u, GetOwningPlayer(s__CrocodileSpells__CrocodileW_Struct_c[this])) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) then
                                set GearDamageNextSource=('A0I8') // INLINED!!
                                call CrocodileSpells__Crocodile_SpellDamage(s__CrocodileSpells__CrocodileW_Struct_c[this] , u , s__CrocodileSpells__CrocodileW_Struct_dmg[this] , s__CrocodileSpells__CrocodileW_Struct_manaKey[this])
                                call CrocodileSpells__Crocodile_ApplySharedMark(s__CrocodileSpells__CrocodileW_Struct_c[this] , u)
                                call SlowUnit(s__CrocodileSpells__CrocodileW_Struct_c[this] , u , CrocodileW_Slow , 2)
                            endif
                        endloop
                        set s__CrocodileSpells__CrocodileW_Struct_hits[this]=s__CrocodileSpells__CrocodileW_Struct_hits[this] + 1
                    endloop
                    if s__CrocodileSpells__CrocodileW_Struct_r[this] + 0.001 >= s__CrocodileSpells__CrocodileW_Struct_rmax[this] then
                        call s__CrocodileSpells__CrocodileSand_Struct_CrocodileSand_Start(s__CrocodileSpells__CrocodileW_Struct_c[this] , s__CrocodileSpells__CrocodileW_Struct_x[this] + 250 * Cos(120 * bj_DEGTORAD) , s__CrocodileSpells__CrocodileW_Struct_y[this] + 250 * Sin(120 * bj_DEGTORAD) , s__CrocodileSpells__CrocodileW_Struct_radius[this] * 0.75 , false)
                        call s__CrocodileSpells__CrocodileSand_Struct_CrocodileSand_Start(s__CrocodileSpells__CrocodileW_Struct_c[this] , s__CrocodileSpells__CrocodileW_Struct_x[this] + 250 * Cos(240 * bj_DEGTORAD) , s__CrocodileSpells__CrocodileW_Struct_y[this] + 250 * Sin(240 * bj_DEGTORAD) , s__CrocodileSpells__CrocodileW_Struct_radius[this] * 0.75 , false)
                        call s__CrocodileSpells__CrocodileSand_Struct_CrocodileSand_Start(s__CrocodileSpells__CrocodileW_Struct_c[this] , s__CrocodileSpells__CrocodileW_Struct_x[this] + 250 * Cos(360 * bj_DEGTORAD) , s__CrocodileSpells__CrocodileW_Struct_y[this] + 250 * Sin(360 * bj_DEGTORAD) , s__CrocodileSpells__CrocodileW_Struct_radius[this] * 0.75 , false)
                    endif
                endif
                if s__CrocodileSpells__CrocodileW_Struct_r[this] + 0.001 >= s__CrocodileSpells__CrocodileW_Struct_rmax[this] or not SpellBoolCaster(s__CrocodileSpells__CrocodileW_Struct_c[this]) or LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileW_Struct_c[this]), CrocodileSpells__CrocodileCore_DataKey) == 0 then
                    if s__CrocodileSpells__CrocodileW_Struct_castPauseHeld[this] then
                        set s__CrocodileSpells__CrocodileW_Struct_castPauseHeld[this]=false
                        call StopSpellUnit2(s__CrocodileSpells__CrocodileW_Struct_c[this])
                    endif
                    call ScaleEffDummy(s__CrocodileSpells__CrocodileW_Struct_e[this] , 0.45 , s__CrocodileSpells__CrocodileW_Struct_radius[this] / 900 , 0.01)
                    call s__GearSystems2___KS_RemoveEffect_MyRemoveEff_Start((s__CrocodileSpells__CrocodileW_Struct_e[this] ) , (( 0.51)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
                    call DestroyEffect(s__CrocodileSpells__CrocodileW_Struct_e2[this])
                    call DestroyGroup(s__CrocodileSpells__CrocodileW_Struct_g[this])
                    call DestroyGroup(s__CrocodileSpells__CrocodileW_Struct_pullGroup[this])
                    call FlushChildHashtable(CrocodileSpells__CrocodileDecorHits, s__CrocodileSpells__CrocodileW_Struct_manaKey[this])
                    set s__CrocodileSpells__CrocodileW_Struct_c[this]=null
                    set s__CrocodileSpells__CrocodileW_Struct_e[this]=null
                    set s__CrocodileSpells__CrocodileW_Struct_e2[this]=null
                    set s__CrocodileSpells__CrocodileW_Struct_g[this]=null
                    set s__CrocodileSpells__CrocodileW_Struct_pullGroup[this]=null
                    set s__CrocodileSpells__CrocodileW_Struct_m[i]=s__CrocodileSpells__CrocodileW_Struct_m[s__CrocodileSpells__CrocodileW_Struct_MUI]
                    set s__CrocodileSpells__CrocodileW_Struct_MUI=s__CrocodileSpells__CrocodileW_Struct_MUI - 1
                    call s__CrocodileSpells__CrocodileW_Struct_deallocate(this)
                    if s__CrocodileSpells__CrocodileW_Struct_MUI == - 1 then
                        call GearTimer03Release()
                    endif
                else
                    set i=i + 1
                endif
            endloop
            set u=null
        endfunction

        function s__CrocodileSpells__CrocodileW_Struct_CrocodileW_Begin takes unit NewC,real NewX,real NewY returns boolean
            local integer this
            local integer j= 0
            local integer slash
            local real projection
            if LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(NewC), CrocodileSpells__CrocodileCore_DataKey) == 0 or IsUnitIllusion(NewC) or not SpellBoolCaster(NewC) or LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(NewC), CrocodileSpells__CrocodileT_PhaseKey) != 0 then
                return false
            endif
            set this=s__CrocodileSpells__CrocodileW_Struct__allocate()
            set s__CrocodileSpells__CrocodileW_Struct_MUI=s__CrocodileSpells__CrocodileW_Struct_MUI + 1
            set s__CrocodileSpells__CrocodileW_Struct_m[s__CrocodileSpells__CrocodileW_Struct_MUI]=this
            if s__CrocodileSpells__CrocodileW_Struct_MUI == 0 then
                call GearTimer03Acquire()
            endif
            set s__CrocodileSpells__CrocodileW_Struct_c[this]=NewC
            set s__CrocodileSpells__CrocodileW_Struct_x[this]=NewX
            set s__CrocodileSpells__CrocodileW_Struct_y[this]=NewY
            set s__CrocodileSpells__CrocodileW_Struct_radius[this]=CrocodileW_Aoe
            set s__CrocodileSpells__CrocodileW_Struct_r[this]=0.0
            set s__CrocodileSpells__CrocodileW_Struct_rmax[this]=RMaxBJ(0.03, CrocodileW_Duration) + 0.51
            set s__CrocodileSpells__CrocodileW_Struct_decorPulse[this]=0.0
            call VisionTimed(GetOwningPlayer(s__CrocodileSpells__CrocodileW_Struct_c[this]) , s__CrocodileSpells__CrocodileW_Struct_x[this] , s__CrocodileSpells__CrocodileW_Struct_y[this] , s__CrocodileSpells__CrocodileW_Struct_radius[this] * 1.5 , 3.0)
            set s__CrocodileSpells__CrocodileW_Struct_damageRmax[this]=s__CrocodileSpells__CrocodileW_Struct_rmax[this] // Freeze the six original damage times; rmax may extend for R.
            set s__CrocodileSpells__CrocodileW_Struct_hits[this]=0
            set s__CrocodileSpells__CrocodileW_Struct_castTime[this]=CrocodileW_CastTime
            if GetHeroLevel(s__CrocodileSpells__CrocodileW_Struct_c[this]) >= 35 then
                set s__CrocodileSpells__CrocodileW_Struct_castTime[this]=s__CrocodileSpells__CrocodileW_Struct_castTime[this] * 0.5
            endif
            set s__CrocodileSpells__CrocodileW_Struct_castPauseHeld[this]=true
            call StartSpellUnit2(s__CrocodileSpells__CrocodileW_Struct_c[this])
            set s__CrocodileSpells__CrocodileW_Struct_scanTime[this]=0.0
            set s__CrocodileSpells__CrocodileW_Struct_combo[this]=false
            set s__CrocodileSpells__CrocodileW_Struct_comboPending[this]=false
            set s__CrocodileSpells__CrocodileW_Struct_manaKey[this]=CrocodileSpells__CrocodileDecor_NewKey()
            // Q may have crossed this area before W's windup finishes.
            loop
                exitwhen j > s__CrocodileSpells__CrocodileQ_Struct_MUI
                set slash=s__CrocodileSpells__CrocodileQ_Struct_m[j]
                if s__CrocodileSpells__CrocodileQ_Struct_c[slash] == s__CrocodileSpells__CrocodileW_Struct_c[this] and s__CrocodileSpells__CrocodileQ_Struct_distance[slash] > 0.0 then
                    set projection=RMaxBJ(0.0, RMinBJ(s__CrocodileSpells__CrocodileQ_Struct_distance[slash], ( s__CrocodileSpells__CrocodileW_Struct_x[this] - s__CrocodileSpells__CrocodileQ_Struct_startX[slash] ) * Cos(s__CrocodileSpells__CrocodileQ_Struct_a[slash]) + ( s__CrocodileSpells__CrocodileW_Struct_y[this] - s__CrocodileSpells__CrocodileQ_Struct_startY[slash] ) * Sin(s__CrocodileSpells__CrocodileQ_Struct_a[slash])))
                    if SR0(s__CrocodileSpells__CrocodileW_Struct_x[this] , s__CrocodileSpells__CrocodileW_Struct_y[this] , s__CrocodileSpells__CrocodileQ_Struct_startX[slash] + projection * Cos(s__CrocodileSpells__CrocodileQ_Struct_a[slash]) , s__CrocodileSpells__CrocodileQ_Struct_startY[slash] + projection * Sin(s__CrocodileSpells__CrocodileQ_Struct_a[slash])) <= s__CrocodileSpells__CrocodileW_Struct_radius[this] + s__CrocodileSpells__CrocodileQ_Struct_radius[slash] then
                        set s__CrocodileSpells__CrocodileW_Struct_comboPending[this]=true
                    endif
                endif
                set j=j + 1
            endloop
            set s__CrocodileSpells__CrocodileW_Struct_comboPullTime[this]=0.0
            set s__CrocodileSpells__CrocodileW_Struct_dmg[this]=GetHeroAgi(s__CrocodileSpells__CrocodileW_Struct_c[this], true) * CrocodileW_DamageAgi
            set s__CrocodileSpells__CrocodileW_Struct_g[this]=CreateGroup()
            set s__CrocodileSpells__CrocodileW_Struct_pullGroup[this]=CreateGroup()
            set s__CrocodileSpells__CrocodileW_Struct_e[this]=EffectSpawnScale("war3mapImported\\wos_file00000862.mdl" , s__CrocodileSpells__CrocodileW_Struct_x[this] , s__CrocodileSpells__CrocodileW_Struct_y[this] , 0 , 1 , 0.01 , 0 , 0.51 , 0.01 , s__CrocodileSpells__CrocodileW_Struct_radius[this] / 1200)
            set s__CrocodileSpells__CrocodileW_Struct_e2[this]=EffectSpawnScale("war3mapImported\\wos_az_f076big.mdl" , s__CrocodileSpells__CrocodileW_Struct_x[this] , s__CrocodileSpells__CrocodileW_Struct_y[this] , 0 , 1 , 0.01 , 0 , 0.3 , 0.01 , 1)
            call SetUnitAnimationByIndex(s__CrocodileSpells__CrocodileW_Struct_c[this], CrocodileW_Animation)
            call MakeSound("war3mapImported\\Hero_Crocodile_W")
            return true
        endfunction



    function CrocodileSpells__CrocodileW_ReceiveQ takes nothing returns boolean
        call s__CrocodileSpells__CrocodileW_Struct_CrocodileW_RecordQ(CrocodileSpells__CrocodileW_QSource , CrocodileSpells__CrocodileW_QStartX , CrocodileSpells__CrocodileW_QStartY , CrocodileSpells__CrocodileW_QAngle , CrocodileSpells__CrocodileW_QFrom , CrocodileSpells__CrocodileW_QTo , CrocodileSpells__CrocodileW_QRadius)
