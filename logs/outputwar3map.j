                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_YC_CrossFlashred.mdl" , s__PatriotSpells___PatriotSpells_T2_x[this] + 25.0 * Cos(s__PatriotSpells___PatriotSpells_T2_a[this]) , s__PatriotSpells___PatriotSpells_T2_y[this] + 25.0 * Sin(s__PatriotSpells___PatriotSpells_T2_a[this]) , 1.0 , 1.25 , 2.5 , 255.0))
                        call DestroyEffect(EffectSpawnColor("war3mapimported\\wos_afbcoyrighthdcec.mdl" , s__PatriotSpells___PatriotSpells_T2_x[this] , s__PatriotSpells___PatriotSpells_T2_y[this] , GetRandomReal(0, 359) , 0.65 , 5.0 , 175.0 , 45 , 0 , 0 , 255))
                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_ZarakiWCrack1.mdl" , s__PatriotSpells___PatriotSpells_T2_x[this] , s__PatriotSpells___PatriotSpells_T2_y[this] , GetRandomReal(0, 359) , 1.25 , 2.0 , 0.0))
                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_3yue_5.mdl" , s__PatriotSpells___PatriotSpells_T2_x[this] , s__PatriotSpells___PatriotSpells_T2_y[this] , GetRandomReal(0, 359) , 1.5 , 1.0 , 0.0))
                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_3yue_5.mdl" , s__PatriotSpells___PatriotSpells_T2_x[this] , s__PatriotSpells___PatriotSpells_T2_y[this] , GetRandomReal(0, 359) , 1.75 , 1.3 , 0.0))

                        call GroupClear(s__PatriotSpells___PatriotSpells_T2_g[this])
                        call GroupEnumUnitsInRange(s__PatriotSpells___PatriotSpells_T2_g[this], s__PatriotSpells___PatriotSpells_T2_x[this], s__PatriotSpells___PatriotSpells_T2_y[this], s__PatriotSpells___PatriotSpells_T2_aoe[this], NoDecor_Cond)
                        loop
                            set u=FirstOfGroup(s__PatriotSpells___PatriotSpells_T2_g[this])
                            exitwhen u == null
