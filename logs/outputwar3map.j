        function s__BarraganSpells__BarraganTick_Loop_Loop takes nothing returns nothing
            if BarraganSpells__BarraganTick_Active[0] then
                call s__BarraganSpells__HeroSpells_Q_Loop_BarraganQ()
            endif
            if BarraganSpells__BarraganTick_Active[1] then
                call s__BarraganSpells__HeroSpells_W_Loop_BarraganW()
            endif
            if BarraganSpells__BarraganTick_Active[2] then
                call s__BarraganSpells__HeroSpells_W_Loop_BarraganW2()
            endif
            if BarraganSpells__BarraganTick_Active[3] then
                call s__BarraganSpells__HeroSpells_E_Loop_BarraganE2()
