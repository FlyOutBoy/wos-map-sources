                    if s__PatriotSpells___PatriotSpells_T2_r[this] > 1.95 and s__PatriotSpells___PatriotSpells_T2_r[this] <= 2.40 then
                        if s__PatriotSpells___PatriotSpells_T2_r2[this] > 0.03 then
