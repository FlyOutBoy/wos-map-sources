                        set s__FrierenSpells__FrierenSpells_T2_travelled[this]=s__FrierenSpells__FrierenSpells_T2_travelled[this] + rr
                        set s__FrierenSpells__FrierenSpells_T2_x[this]=s__FrierenSpells__FrierenSpells_T2_x[this] + rr * Cos(s__FrierenSpells__FrierenSpells_T2_a[this])
                        set s__FrierenSpells__FrierenSpells_T2_y[this]=s__FrierenSpells__FrierenSpells_T2_y[this] + rr * Sin(s__FrierenSpells__FrierenSpells_T2_a[this])
                        endif
                    endif
