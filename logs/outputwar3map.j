    // Invulnerability: this spell contains a StartSpellUnit/Avul phase.
        function s__DarkShikiSpells__DarkShikiG_KS_Loop_DarkShikiG takes nothing returns nothing
            local integer this
            local integer i= 0
            local real rand1= 0
            local real rand2= 0
            local real rand3= 0
            loop
                exitwhen i > s__DarkShikiSpells__DarkShikiG_KS_MUI_DarkShikiG
                set this=s__DarkShikiSpells__DarkShikiG_KS_m_DarkShikiG[i]
                if SpellBoolCaster(s__DarkShikiSpells__DarkShikiG_KS_c[this]) and s__DarkShikiSpells__DarkShikiG_KS_r[this] <= s__DarkShikiSpells__DarkShikiG_KS_rmax[this] then
                    set s__DarkShikiSpells__DarkShikiG_KS_r[this]=s__DarkShikiSpells__DarkShikiG_KS_r[this] + 0.03
                    set s__DarkShikiSpells__DarkShikiG_KS_r[this]=RoundReal(s__DarkShikiSpells__DarkShikiG_KS_r[this] , 3)
                        call SaveInteger(hs, GetHandleId(s__DarkShikiSpells__DarkShikiG_KS_c[this]), DarkShikiSpells__SH_SHIKI_SPELL_PAUSE, 1)
                        call DebugUnit(s__DarkShikiSpells__DarkShikiG_KS_c[this])
                    if s__DarkShikiSpells__DarkShikiG_KS_r[this] == s__DarkShikiSpells__DarkShikiG_KS_rmax[this] then
                    set s__DarkShikiSpells__DarkShikiG_KS_x[this]=GetUnitX(s__DarkShikiSpells__DarkShikiG_KS_c[this])
                    set s__DarkShikiSpells__DarkShikiG_KS_y[this]=GetUnitY(s__DarkShikiSpells__DarkShikiG_KS_c[this])
                    
                    call StopSpellUnit(s__DarkShikiSpells__DarkShikiG_KS_c[this])
                    call DecorRemove(s__DarkShikiSpells__DarkShikiG_KS_c[this] , s__DarkShikiSpells__DarkShikiG_KS_x[this] , s__DarkShikiSpells__DarkShikiG_KS_y[this] , s__DarkShikiSpells__DarkShikiG_KS_aoe[this] , 50)
                            call MakeSound("war3mapimported\\Hero_DarkShiki_R3")
                    call DestroyEffect(EffectSpawn("war3mapimported\\wos_Nanaya2Skill06Dred.mdl" , s__DarkShikiSpells__DarkShikiG_KS_x[this] , s__DarkShikiSpells__DarkShikiG_KS_y[this] , 0 , 1 , 2.45 , 75))
                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_Satsu-RSFX-10.mdl" , s__DarkShikiSpells__DarkShikiG_KS_x[this] , s__DarkShikiSpells__DarkShikiG_KS_y[this] , 0 , 1 , 3.15 , 75))
                    call DestroyEffect(EffectSpawn("war3mapimported\\wos_AZ_TS_TZRed.mdl" , s__DarkShikiSpells__DarkShikiG_KS_x[this] , s__DarkShikiSpells__DarkShikiG_KS_y[this] , s__DarkShikiSpells__DarkShikiG_KS_a[this] * bj_RADTODEG + 90 , 1.5 , 2.25 , 4))
                    call DestroyEffect(EffectSpawn3("war3mapimported\\wos_az_jingzi_jiansheng01_e1_l2.mdl" , s__DarkShikiSpells__DarkShikiG_KS_x[this] , s__DarkShikiSpells__DarkShikiG_KS_y[this] , s__DarkShikiSpells__DarkShikiG_KS_a[this] * bj_RADTODEG + 45 , 0.65 , 2 , 45 , - 25))
                    call DestroyEffect(EffectSpawn3("war3mapimported\\wos_az_jingzi_jiansheng01_e1_l2.mdl" , s__DarkShikiSpells__DarkShikiG_KS_x[this] , s__DarkShikiSpells__DarkShikiG_KS_y[this] , s__DarkShikiSpells__DarkShikiG_KS_a[this] * bj_RADTODEG - 45 , 0.65 , 2 , 45 , - 25))
                    call GroupClear(s__DarkShikiSpells__DarkShikiG_KS_g[this])
                            call GroupEnumUnitsInRange(s__DarkShikiSpells__DarkShikiG_KS_g[this], s__DarkShikiSpells__DarkShikiG_KS_x[this], s__DarkShikiSpells__DarkShikiG_KS_y[this], s__DarkShikiSpells__DarkShikiG_KS_aoe[this], NoDecor_Cond)
                            loop
                                set s__DarkShikiSpells__DarkShikiG_KS_u[this]=FirstOfGroup(s__DarkShikiSpells__DarkShikiG_KS_g[this])
                                exitwhen s__DarkShikiSpells__DarkShikiG_KS_u[this] == null
                                if SpellBool(s__DarkShikiSpells__DarkShikiG_KS_u[this]) and IsUnitEnemy(s__DarkShikiSpells__DarkShikiG_KS_u[this], GetOwningPlayer(s__DarkShikiSpells__DarkShikiG_KS_c[this])) then
                                    set GearDamageNextSource=('A0CO') // INLINED!!
                                    call dmgphys(s__DarkShikiSpells__DarkShikiG_KS_c[this] , s__DarkShikiSpells__DarkShikiG_KS_u[this] , s__DarkShikiSpells__DarkShikiG_KS_dmg[this])
                                    if IsUnitIllusion(s__DarkShikiSpells__DarkShikiG_KS_u[this]) == false and s__DarkShikiSpells__DarkShikiG_KS_check2[this] == 0 then
                                        call s__DarkShikiSpells__DarkShikiPassive_KS_DarkShikiPassiveApply(s__DarkShikiSpells__DarkShikiG_KS_c[this] , s__DarkShikiSpells__DarkShikiG_KS_u[this])
                                        set s__DarkShikiSpells__DarkShikiG_KS_check2[this]=1
                                    endif
                                    call DestroyEffect(EffectSpawn("war3mapimported\\wos_A_[doft]hero_skeletonking_n2s_e_star.mdx" , s__DarkShikiSpells__DarkShikiG_KS_x[this] , s__DarkShikiSpells__DarkShikiG_KS_y[this] , s__DarkShikiSpells__DarkShikiG_KS_a[this] * bj_RADTODEG , 0.35 , 3 , 145))
                                endif
                                call GroupRemoveUnit(s__DarkShikiSpells__DarkShikiG_KS_g[this], s__DarkShikiSpells__DarkShikiG_KS_u[this])
                            endloop
                            set s__DarkShikiSpells__DarkShikiG_KS_u[this]=null
                    endif
                else
                    call SetFly(s__DarkShikiSpells__DarkShikiG_KS_c[this] , 0)
                    if s__DarkShikiSpells__DarkShikiG_KS_check[this] == 0 then
                        call SaveInteger(hs, GetHandleId(s__DarkShikiSpells__DarkShikiG_KS_c[this]), DarkShikiSpells__SH_SHIKI_SPELL_PAUSE, 0)
                    endif
                    call StopSpellUnit(s__DarkShikiSpells__DarkShikiG_KS_c[this])
                    call SetUnitTimeScale(s__DarkShikiSpells__DarkShikiG_KS_c[this], 1)
                    call DestroyGroup(s__DarkShikiSpells__DarkShikiG_KS_g[this])
                    set s__DarkShikiSpells__DarkShikiG_KS_g[this]=null
