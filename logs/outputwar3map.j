                set s__StarrkSpells___StarrkSpells_W_dmg[this]=s__StarrkSpells___StarrkSpells_W_dmg[this] / s__StarrkSpells___StarrkSpells_W_k3[this]
                call StartSpellUnit2(s__StarrkSpells___StarrkSpells_W_c[this])
                call MakeSound("war3mapimported\\Hero_Starrk_EW")
                call MakeSound("war3mapimported\\Hero_Starrk_EW2")
                call SetUnitAnimationByIndex(s__StarrkSpells___StarrkSpells_W_c[this], 0)
                call SetUnitTimeScale(s__StarrkSpells___StarrkSpells_W_c[this], 0.4)
                set s__StarrkSpells___StarrkSpells_W_move[this]=105
            else
                set s__StarrkSpells___StarrkSpells_W_r4[this]=999
                set s__StarrkSpells___StarrkSpells_W_check[this]=2
                set s__StarrkSpells___StarrkSpells_W_rmax[this]=1.8
                call SaveInteger(hs, GetHandleId(s__StarrkSpells___StarrkSpells_W_c[this]), StarrkSpells___SH_STARRK_T_ACTION, 1)
                set s__StarrkSpells___StarrkSpells_W_dmg[this]=s__StarrkSpells___StarrkSpells_W_dmg[this] + StarrkEW_DamageMorphIntImprove * GetHeroAgi(s__StarrkSpells___StarrkSpells_W_c[this], true)
                set s__StarrkSpells___StarrkSpells_W_dmg[this]=s__StarrkSpells___StarrkSpells_W_dmg[this] + StarrkTW_DamageImprove * GetHeroAgi(s__StarrkSpells___StarrkSpells_W_c[this], true)
                set s__StarrkSpells___StarrkSpells_W_aoe[this]=StarrkEW_DamageAoe
