    function RaidenW_Strike_Start takes unit c,unit td,integer typeatk returns nothing
        local real x= GetUnitX(td)
        local real y= GetUnitY(td)
        local real a= GetRandomReal(0, 359)
        local real dmg= GetHeroAgi(c, true) * ( RaidenW_DamageAgiBase + ( RaidenW_DamageAgiStep * ( GetUnitAbilityLevel(c, RaidenW_ID) - 1 ) ) )

        if IntegerCdKey(c , SH_ICD_RAIDEN_W_CD , 0.15) then
            set dmg=dmg + RaidenW_Damage2StaticBase + ( RaidenW_Damage2StaticStep * ( GetUnitAbilityLevel(c, RaidenW_ID) - 1 ) )
            call s__GearSystems2___KS_MoveEffectToUnit_MoveEffectToUnit_Start((EffectSpawn("war3mapImported\\wos_ld2209 (199).mdl" , x , y , a , 0.85 , 2.5 , 90) ) , (( 0.36 )*1.0) , (( 90 )*1.0) , ( td) , 0 , 1 , null) // INLINED!!
            if typeatk == 0 then
                call s__GearSystems2___KS_MoveEffectToUnit_MoveEffectToUnit_Start((EffectSpawn("war3mapImported\\wos_mei-rsfx-6.mdl" , x , y , a , 1.25 , 1.45 , 100) ) , (( 0.36 )*1.0) , (( 100 )*1.0) , ( td) , 0 , 1 , null) // INLINED!!
                call s__GearSystems2___KS_MoveEffectToUnit_MoveEffectToUnit_Start((EffectSpawn("war3mapImported\\wos_mh_tx-ba-symh-hit11Purple.mdl" , x , y , a , 2 , 1.0 , 1) ) , (( 0.36 )*1.0) , (( 1 )*1.0) , ( td) , 0 , 1 , null) // INLINED!!
            endif
            set GearDamageNextSource=('A001') // INLINED!!
            call s__GearSystems2___KS_DelayedDamage_NextDmg_Start((c ) , ( td ) , (( dmg )*1.0) , ( 0 ) , (( 0.1)*1.0)) // INLINED!!
