                        call s__GearSystems2___KS_RemoveEffect_MyRemoveEff_Start((beamEffect ) , (( beamEffectLife)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
                        set beamEffect=EffectSpawn("war3mapImported\\wos_krk (1849)6.mdl" , s__MilimSpells___MilimT2KS_x1[this] + 450 * Cos(s__MilimSpells___MilimT2KS_a[this] - 90 * bj_DEGTORAD) , s__MilimSpells___MilimT2KS_y1[this] + 450 * Sin(s__MilimSpells___MilimT2KS_a[this] - 90 * bj_DEGTORAD) , s__MilimSpells___MilimT2KS_a[this] * bj_RADTODEG - 15 , 1.75 , s__MilimSpells___MilimT2KS_beamRingScale[this] , 125.00)
