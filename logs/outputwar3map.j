        function s__GearSystems2___KS_BuffTimer_MyBuffTime_Start takes unit NewC,integer NewId,real NewRmax,string NewS,boolean NewPauseCount,integer NewPlayerId,integer IgnoreBuff,integer NewSh,integer count returns nothing
            local integer this= 0
            local real tmp_x= 0
            local real tmp_y= 0
            local integer slotKey= NewPlayerId
            local integer i= 0
            local boolean reused= false
            if NewPlayerId == - 1 then
                set slotKey=GetPlayerId(GetOwningPlayer(NewC))
            endif
            set slotKey=slotKey + ( count * 24 ) + 1
            // A repeat on an occupied slot (W -> W2 windows, recasts) restarts that
            // timer: one instance per frame, so an older one cannot hide the new bar.
            loop
                exitwhen i > s__GearSystems2___KS_BuffTimer_MUI_28 or reused
                if s__GearSystems2___KS_BuffTimer_k2[(s__GearSystems2___KS_BuffTimer_m_28[i])] == slotKey then
                    set this=s__GearSystems2___KS_BuffTimer_m_28[i]
                    set reused=true
                endif
                set i=i + 1
            endloop
            if not reused then
                set this=s__GearSystems2___KS_BuffTimer__allocate()
                set s__GearSystems2___KS_BuffTimer_MUI_28=s__GearSystems2___KS_BuffTimer_MUI_28 + 1
                set s__GearSystems2___KS_BuffTimer_m_28[s__GearSystems2___KS_BuffTimer_MUI_28]=this
            endif
            set s__GearSystems2___KS_BuffTimer_c[this]=NewC
