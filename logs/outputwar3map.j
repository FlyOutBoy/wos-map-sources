            set s__BrandishSpells__BrandishSpells_F_td[this]=NewTd
            set s__BrandishSpells__BrandishSpells_F_r[this]=0.0
            if GetRandomInt(1, 2) == 1 then
                call MakeSound("war3mapimported\\Hero_Brandish_G01")
            else
                call MakeSound("war3mapimported\\Hero_Brandish_G02")
            endif
            call MakeSound("war3mapimported\\Hero_Brandish_G1")
            set s__BrandishSpells__BrandishSpells_F_scale[this]=s__BrandishSpells_Utility_GetTotalScale(s__BrandishSpells__BrandishSpells_F_td[this])
            call SaveReal(BrandishSpells__hs, GetHandleId(s__BrandishSpells__BrandishSpells_F_td[this]), BrandishSpells__SH_FMULT, 1.0)
            if IsUnitEnemy(s__BrandishSpells__BrandishSpells_F_td[this], GetOwningPlayer(s__BrandishSpells__BrandishSpells_F_c[this])) then
                call SaveReal(BrandishSpells__hs, GetHandleId(s__BrandishSpells__BrandishSpells_F_td[this]), BrandishSpells__SH_FMULT, BrandishF_DamageOutputDecreaseScale / 100.0)
                set s__BrandishSpells__BrandishSpells_F_check[this]=0
                set s__BrandishSpells__BrandishSpells_F_check2[this]=BrandishF_Debuff_ID
                call DestroyEffect(EffectSpawn("war3mapImported\\wos_brandi_red_decrease.mdl" , GetUnitX(s__BrandishSpells__BrandishSpells_F_td[this]) , GetUnitY(s__BrandishSpells__BrandishSpells_F_td[this]) , 0.0 , 1.25 , 2.20 , 0.0))
                call SaveInteger(BrandishSpells__hs, GetHandleId(s__BrandishSpells__BrandishSpells_F_td[this]), BrandishSpells__SH_BRANDISH_G_ENEMY, 1)
                call s__BrandishSpells_Utility_BuffUnitBran2(s__BrandishSpells__BrandishSpells_F_c[this] , s__BrandishSpells__BrandishSpells_F_td[this] , 1 , true)
            else
                set s__BrandishSpells__BrandishSpells_F_check[this]=1
                set s__BrandishSpells__BrandishSpells_F_check2[this]=BrandishF_Buff_ID
                call DestroyEffect(EffectSpawn("war3mapImported\\wos_brandi_green_increase.mdl" , GetUnitX(s__BrandishSpells__BrandishSpells_F_td[this]) , GetUnitY(s__BrandishSpells__BrandishSpells_F_td[this]) , 0.0 , 1.25 , 2.00 , 0.0))
                call SaveInteger(BrandishSpells__hs, GetHandleId(s__BrandishSpells__BrandishSpells_F_td[this]), BrandishSpells__SH_BRANDISH_G_ALLY, 1)
                call SaveReal(BrandishSpells__hs, GetHandleId(s__BrandishSpells__BrandishSpells_F_td[this]), BrandishSpells__SH_FMULT, BrandishF_DamageOutputIncreaseScale / 100.0)
                call s__BrandishSpells_Utility_BuffUnitBran2(s__BrandishSpells__BrandishSpells_F_c[this] , s__BrandishSpells__BrandishSpells_F_td[this] , 1 , false)
            endif
            set s__BrandishSpells__BrandishSpells_F_scale2[this]=s__BrandishSpells_Utility_GetTotalScale(s__BrandishSpells__BrandishSpells_F_td[this])
            call ScaleDummy(s__BrandishSpells__BrandishSpells_F_td[this] , 0.50 , s__BrandishSpells__BrandishSpells_F_scale[this] , s__BrandishSpells__BrandishSpells_F_scale2[this])
            set s__BrandishSpells__BrandishSpells_F_rmax[this]=BrandishF_Time
            call Brandish_RestoreOrder(s__BrandishSpells__BrandishSpells_F_c[this] , 5)
            if s__BrandishSpells__BrandishSpells_F_MUI_BrandishF == 0 then
                call BrandishSpells__BrandishTimer05Acquire()
            endif
        endfunction

