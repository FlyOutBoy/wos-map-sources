                    set s__LaxusSpells___LaxusF_KS_r[this]=I2R(R2I(( s__LaxusSpells___LaxusF_KS_r[this] + 0.03 ) * 1000.0 + 0.5)) / 1000.0
                    set s__LaxusSpells___LaxusF_KS_a[this]=GAngle(s__LaxusSpells___LaxusF_KS_c[this] , s__LaxusSpells___LaxusF_KS_td[this])
                    call SetUnitFacing(s__LaxusSpells___LaxusF_KS_c[this], s__LaxusSpells___LaxusF_KS_a[this] * bj_RADTODEG)

                    // ФАЗА 0: Полет / рывок к цели
                    if s__LaxusSpells___LaxusF_KS_check[this] == 0 then
                        if s__LaxusSpells___LaxusF_KS_r[this] > LaxusF_CastTime then
                            if SR2(s__LaxusSpells___LaxusF_KS_c[this] , s__LaxusSpells___LaxusF_KS_td[this]) > 160.0 then
                                set s__LaxusSpells___LaxusF_KS_x[this]=GetUnitX(s__LaxusSpells___LaxusF_KS_c[this])
                                set s__LaxusSpells___LaxusF_KS_y[this]=GetUnitY(s__LaxusSpells___LaxusF_KS_c[this])

                                set s__LaxusSpells___LaxusF_KS_zigzagPhase[this]=s__LaxusSpells___LaxusF_KS_zigzagPhase[this] + 0.50
                                call MoveUnit(s__LaxusSpells___LaxusF_KS_c[this] , s__LaxusSpells___LaxusF_KS_move[this] , s__LaxusSpells___LaxusF_KS_a[this] + 60.0 * Sin(s__LaxusSpells___LaxusF_KS_zigzagPhase[this]) * bj_DEGTORAD)
                                call MoveEff(s__LaxusSpells___LaxusF_KS_e[this] , s__LaxusSpells___LaxusF_KS_move[this] , s__LaxusSpells___LaxusF_KS_a[this] + 60.0 * Sin(s__LaxusSpells___LaxusF_KS_zigzagPhase[this]) * bj_DEGTORAD)

                                set s__LaxusSpells___LaxusF_KS_r2[this]=s__LaxusSpells___LaxusF_KS_r2[this] + 0.03
                                if s__LaxusSpells___LaxusF_KS_check2[this] == 0 then
                                    call DestroyEffect(EffectSpawn("war3mapImported\\wos_YellowMissile.mdl" , s__LaxusSpells___LaxusF_KS_x[this] , s__LaxusSpells___LaxusF_KS_y[this] , GetRandomReal(0.0, 359.0) , 1.0 , 1.0 , 100.0))
                                    call DestroyEffect(EffectSpawn("war3mapImported\\wos_YellowSpark.mdl" , s__LaxusSpells___LaxusF_KS_x[this] , s__LaxusSpells___LaxusF_KS_y[this] , GetRandomReal(0.0, 359.0) , 1.0 , 1.45 , 100.0))
                                else
                                    call DestroyEffect(EffectSpawn("war3mapImported\\wos_RedMissile.mdl" , s__LaxusSpells___LaxusF_KS_x[this] , s__LaxusSpells___LaxusF_KS_y[this] , GetRandomReal(0.0, 359.0) , 1.0 , 1.0 , 100.0))
                                    call DestroyEffect(EffectSpawn("war3mapImported\\wos_RedSpark.mdl" , s__LaxusSpells___LaxusF_KS_x[this] , s__LaxusSpells___LaxusF_KS_y[this] , GetRandomReal(0.0, 359.0) , 1.0 , 1.45 , 100.0))
                                endif
                                if s__LaxusSpells___LaxusF_KS_r2[this] >= 0.12 then
                                    set s__LaxusSpells___LaxusF_KS_r2[this]=0.0
                                    call DecorRemove(s__LaxusSpells___LaxusF_KS_c[this] , s__LaxusSpells___LaxusF_KS_x[this] , s__LaxusSpells___LaxusF_KS_y[this] , 350.0 , LaxusF_DecorDamage)
                                endif
                            else
                                call SetUnitPosition(s__LaxusSpells___LaxusF_KS_c[this], GetUnitX(s__LaxusSpells___LaxusF_KS_td[this]) - 175.0 * Cos(s__LaxusSpells___LaxusF_KS_a[this]), GetUnitY(s__LaxusSpells___LaxusF_KS_td[this]) - 175.0 * Sin(s__LaxusSpells___LaxusF_KS_a[this]))
                                
                                // ИСПРАВЛЕНИЕ: цель td всегда получает только паузу (StartSpellUnit2), без неуязвимости!
                                call StartSpellUnit2(s__LaxusSpells___LaxusF_KS_td[this])

                                if s__LaxusSpells___LaxusF_KS_e[this] != null then
                                    call DestroyEffect(s__LaxusSpells___LaxusF_KS_e[this])
                                    set s__LaxusSpells___LaxusF_KS_e[this]=null
                                endif
                                if s__LaxusSpells___LaxusF_KS_check2[this] == 0 then
                                    call MakeSound("war3mapimported\\Hero_Laxus_F2")
                                endif
                                call SetUnitAnimationByIndex(s__LaxusSpells___LaxusF_KS_c[this], 6)
                                call SetUnitTimeScale(s__LaxusSpells___LaxusF_KS_c[this], 1.25)
                                call SetUnitVertexColor(s__LaxusSpells___LaxusF_KS_c[this], 255, 255, 255, 255)
                                
                                // ИСПРАВЛЕНИЕ: сброс таймера и задание чистого лимита для фазы удара
                                set s__LaxusSpells___LaxusF_KS_r[this]=0.0
                                set s__LaxusSpells___LaxusF_KS_r2[this]=0.0
                                set s__LaxusSpells___LaxusF_KS_rmax[this]=LaxusF_HitDelay + 0.50
                                set s__LaxusSpells___LaxusF_KS_check[this]=1
                            endif
                        endif

                    // ФАЗА 1: Удар по цели
                    elseif s__LaxusSpells___LaxusF_KS_check[this] == 1 then
                        call DebugUnit2(s__LaxusSpells___LaxusF_KS_td[this])
                        if LaxusF_IsInvul then
                            call DebugUnit(s__LaxusSpells___LaxusF_KS_c[this])
                        else
                            call DebugUnit2(s__LaxusSpells___LaxusF_KS_c[this])
                        endif

                        if s__LaxusSpells___LaxusF_KS_r[this] >= 0.60 and s__LaxusSpells___LaxusF_KS_e2[this] != null then
                            call DestroyEffect(s__LaxusSpells___LaxusF_KS_e2[this])
                            set s__LaxusSpells___LaxusF_KS_e2[this]=null
                            if s__LaxusSpells___LaxusF_KS_e3[this] != null then
                                call DestroyEffect(s__LaxusSpells___LaxusF_KS_e3[this])
                                set s__LaxusSpells___LaxusF_KS_e3[this]=null
                            endif
                        endif

                        // ИСПРАВЛЕНИЕ: проверка через >= исключает пропуск кадра
                        if s__LaxusSpells___LaxusF_KS_r[this] >= LaxusF_HitDelay then
                            set GearDamageNextSource=('A0EY') // INLINED!!
                            call dmgphys(s__LaxusSpells___LaxusF_KS_c[this] , s__LaxusSpells___LaxusF_KS_td[this] , s__LaxusSpells___LaxusF_KS_dmg[this])
                            if LaxusF_Debuff > 0 then
                                set GearDamageNextSource=('A0EY') // INLINED!!
                                call ErzaPassive(s__LaxusSpells___LaxusF_KS_c[this] , s__LaxusSpells___LaxusF_KS_td[this] , LaxusF_Debuff)
                            endif
                            call StunUnit(s__LaxusSpells___LaxusF_KS_c[this] , s__LaxusSpells___LaxusF_KS_td[this] , LaxusF_Stun)
                            call MUE(s__LaxusSpells___LaxusF_KS_td[this] , LaxusF_PushRange , LaxusF_PushDuration , s__LaxusSpells___LaxusF_KS_a[this])
                            call MakeSound("war3mapimported\\Hero_Laxus_F3")
                            set s__LaxusSpells___LaxusF_KS_x[this]=GetUnitX(s__LaxusSpells___LaxusF_KS_td[this])
                            set s__LaxusSpells___LaxusF_KS_y[this]=GetUnitY(s__LaxusSpells___LaxusF_KS_td[this])
                            call DecorRemove(s__LaxusSpells___LaxusF_KS_c[this] , s__LaxusSpells___LaxusF_KS_x[this] , s__LaxusSpells___LaxusF_KS_y[this] , 350.0 , LaxusF_DecorDamage)
                            
                            set s__LaxusSpells___LaxusF_KS_x[this]=GetUnitX(s__LaxusSpells___LaxusF_KS_td[this]) + 130.0 * Cos(s__LaxusSpells___LaxusF_KS_a[this])
                            set s__LaxusSpells___LaxusF_KS_y[this]=GetUnitY(s__LaxusSpells___LaxusF_KS_td[this]) + 130.0 * Sin(s__LaxusSpells___LaxusF_KS_a[this])
                            if s__LaxusSpells___LaxusF_KS_check2[this] == 0 then
                                call DestroyEffect(EffectSpawn("war3mapImported\\wos_YellowBoom.mdx" , s__LaxusSpells___LaxusF_KS_x[this] , s__LaxusSpells___LaxusF_KS_y[this] , 1.0 , 1.25 , 4.0 , 110.0))
                                call DestroyEffect(EffectSpawn("war3mapImported\\wos_SlamYellow.mdl" , s__LaxusSpells___LaxusF_KS_x[this] , s__LaxusSpells___LaxusF_KS_y[this] , 1.0 , 1.0 , 4.0 , 1.0))
                                call DestroyEffect(EffectSpawn("war3mapImported\\wos_YellowMissile.mdl" , s__LaxusSpells___LaxusF_KS_x[this] , s__LaxusSpells___LaxusF_KS_y[this] , 1.0 , 1.0 , 4.0 , 100.0))
                                call DestroyEffect(EffectSpawn("war3mapImported\\wos_OPm (513)yellow.mdl" , s__LaxusSpells___LaxusF_KS_x[this] , s__LaxusSpells___LaxusF_KS_y[this] , GetRandomReal(0.0, 359.0) , 2.0 , 0.80 , 1.0))
                                // removed: modelgh (1).mdl is not imported
                                set k=0
                                loop
                                    exitwhen k == 6
                                    set rr1=GetRandomReal(150.0, 200.0)
                                    set rr2=GetRandomReal(0.0, 360.0) * bj_DEGTORAD
                                    set x1=s__LaxusSpells___LaxusF_KS_x[this] + rr1 * Cos(rr2)
                                    set y1=s__LaxusSpells___LaxusF_KS_y[this] + rr1 * Sin(rr2)
                                    call EffectSpawn2("war3mapImported\\wos_krk (1849)2.mdx" , x1 , y1 , 60.0 * k , 1.0 , 1.45 , 75.0 , 0.50)
                                    set k=k + 1
                                endloop
                                call DestroyEffect(EffectSpawn("war3mapImported\\wos_[DoFT]EF501Item.mdl" , s__LaxusSpells___LaxusF_KS_x[this] , s__LaxusSpells___LaxusF_KS_y[this] , GetRandomReal(0.0, 359.0) , 0.65 , 3.0 , 1.0))
                            else
                                call DestroyEffect(EffectSpawn("war3mapImported\\wos_RedBoom.mdx" , s__LaxusSpells___LaxusF_KS_x[this] , s__LaxusSpells___LaxusF_KS_y[this] , 1.0 , 1.25 , 4.0 , 110.0))
                                call DestroyEffect(EffectSpawn("war3mapImported\\wos_SlamRed.mdl" , s__LaxusSpells___LaxusF_KS_x[this] , s__LaxusSpells___LaxusF_KS_y[this] , 1.0 , 1.0 , 4.0 , 1.0))
                                call DestroyEffect(EffectSpawn("war3mapImported\\wos_RedMissile.mdl" , s__LaxusSpells___LaxusF_KS_x[this] , s__LaxusSpells___LaxusF_KS_y[this] , 1.0 , 1.0 , 4.0 , 100.0))
                                call DestroyEffect(EffectSpawn("war3mapImported\\wos_OPm (513)red.mdl" , s__LaxusSpells___LaxusF_KS_x[this] , s__LaxusSpells___LaxusF_KS_y[this] , GetRandomReal(0.0, 359.0) , 2.0 , 0.80 , 1.0))
                                call DestroyEffect(EffectSpawn("war3mapImported\\wos_modelgh (1)red.mdl" , s__LaxusSpells___LaxusF_KS_x[this] , s__LaxusSpells___LaxusF_KS_y[this] , 0.0 , 3.0 , 1.25 , 100.0))
                                set k=0
                                loop
                                    exitwhen k == 6
                                    set rr1=GetRandomReal(150.0, 200.0)
                                    set rr2=GetRandomReal(0.0, 360.0) * bj_DEGTORAD
                                    set x1=s__LaxusSpells___LaxusF_KS_x[this] + rr1 * Cos(rr2)
                                    set y1=s__LaxusSpells___LaxusF_KS_y[this] + rr1 * Sin(rr2)
                                    call EffectSpawn2("war3mapImported\\wos_krk (1849)4.mdx" , x1 , y1 , 60.0 * k , 1.0 , 1.45 , 75.0 , 0.50)
                                    set k=k + 1
                                endloop
                                call DestroyEffect(EffectSpawn("war3mapImported\\wos_OPm (434)3small.mdl" , s__LaxusSpells___LaxusF_KS_x[this] , s__LaxusSpells___LaxusF_KS_y[this] , GetRandomReal(0.0, 359.0) , 1.0 , 3.0 , 145.0))
                                call DestroyEffect(EffectSpawn("war3mapImported\\wos_ZarakiWCrack2.mdx" , s__LaxusSpells___LaxusF_KS_x[this] , s__LaxusSpells___LaxusF_KS_y[this] , GetRandomReal(0.0, 359.0) , 1.0 , 3.0 , 0.0))
                            endif

                            // Удар завершен, отправляем на удаление инстанса
                            set s__LaxusSpells___LaxusF_KS_r[this]=99999.0
                        endif
                    endif
                else
                    // ИСПРАВЛЕНИЕ: цель td всегда освобождается через StopSpellUnit2
                    if s__LaxusSpells___LaxusF_KS_check[this] == 1 and s__LaxusSpells___LaxusF_KS_td[this] != null then
                        call StopSpellUnit2(s__LaxusSpells___LaxusF_KS_td[this])
                    endif
                    if s__LaxusSpells___LaxusF_KS_e[this] != null then
                        call DestroyEffect(s__LaxusSpells___LaxusF_KS_e[this])
                    endif
                    if s__LaxusSpells___LaxusF_KS_e2[this] != null then
                        call DestroyEffect(s__LaxusSpells___LaxusF_KS_e2[this])
                    endif
                    if s__LaxusSpells___LaxusF_KS_e3[this] != null then
                        call DestroyEffect(s__LaxusSpells___LaxusF_KS_e3[this])
                    endif
                    if LaxusF_IsInvul then
                        call StopSpellUnit(s__LaxusSpells___LaxusF_KS_c[this])
                    else
                        call StopSpellUnit2(s__LaxusSpells___LaxusF_KS_c[this])
                    endif
                    call SetUnitTimeScale(s__LaxusSpells___LaxusF_KS_c[this], 1.0)
                    call SetUnitVertexColor(s__LaxusSpells___LaxusF_KS_c[this], 255, 255, 255, 255)
                    set s__LaxusSpells___LaxusF_KS_c[this]=null
                    set s__LaxusSpells___LaxusF_KS_td[this]=null
                    set s__LaxusSpells___LaxusF_KS_e[this]=null
                    set s__LaxusSpells___LaxusF_KS_e2[this]=null
                    set s__LaxusSpells___LaxusF_KS_e3[this]=null
                    set s__LaxusSpells___LaxusF_KS_m_LaxusF[i]=s__LaxusSpells___LaxusF_KS_m_LaxusF[s__LaxusSpells___LaxusF_KS_MUI_LaxusF]
                    set s__LaxusSpells___LaxusF_KS_MUI_LaxusF=s__LaxusSpells___LaxusF_KS_MUI_LaxusF - 1
                    if s__LaxusSpells___LaxusF_KS_MUI_LaxusF == - 1 then
                        call LaxusSpells___LaxusTimer03Release()
                    endif
                    call s__LaxusSpells___LaxusF_KS_deallocate(this)
                    set i=i - 1
                endif
                set i=i + 1
            endloop
        endfunction

        function s__LaxusSpells___LaxusF_KS_LaxusF_Start takes unit NewC,unit NewTd returns nothing
            local integer this= s__LaxusSpells___LaxusF_KS__allocate()
            set s__LaxusSpells___LaxusF_KS_MUI_LaxusF=s__LaxusSpells___LaxusF_KS_MUI_LaxusF + 1
            set s__LaxusSpells___LaxusF_KS_m_LaxusF[s__LaxusSpells___LaxusF_KS_MUI_LaxusF]=this
            set s__LaxusSpells___LaxusF_KS_c[this]=NewC
            set s__LaxusSpells___LaxusF_KS_td[this]=NewTd
            set s__LaxusSpells___LaxusF_KS_r[this]=0.0
            set s__LaxusSpells___LaxusF_KS_r2[this]=0.0
            set s__LaxusSpells___LaxusF_KS_zigzagPhase[this]=0.0
            set s__LaxusSpells___LaxusF_KS_check[this]=0
            set s__LaxusSpells___LaxusF_KS_move[this]=100.0
            set s__LaxusSpells___LaxusF_KS_rmax[this]=LaxusF_MaxDuration
            if LaxusF_IsInvul then
                call StartSpellUnit(s__LaxusSpells___LaxusF_KS_c[this])
            else
                call StartSpellUnit2(s__LaxusSpells___LaxusF_KS_c[this])
            endif
            call SetUnitAnimationByIndex(s__LaxusSpells___LaxusF_KS_c[this], 6)
            call SetUnitTimeScale(s__LaxusSpells___LaxusF_KS_c[this], 1.10)
            set s__LaxusSpells___LaxusF_KS_dmg[this]=GetHeroStr(s__LaxusSpells___LaxusF_KS_c[this], true) * LaxusF_DamageStrBase
            set s__LaxusSpells___LaxusF_KS_check2[this]=0
            if LoadInteger(hs, GetHandleId(s__LaxusSpells___LaxusF_KS_c[this]), LaxusSpells___SH_MODE_G) == 1 then
                set s__LaxusSpells___LaxusF_KS_dmg[this]=s__LaxusSpells___LaxusF_KS_dmg[this] + GetHeroStr(s__LaxusSpells___LaxusF_KS_c[this], true) * LaxusGF_DamageStrBonus
                if LoadInteger(hs, GetHandleId(s__LaxusSpells___LaxusF_KS_c[this]), LaxusSpells___SH_LVL5) == 1 then
                    set s__LaxusSpells___LaxusF_KS_dmg[this]=s__LaxusSpells___LaxusF_KS_dmg[this] + GetHeroStr(s__LaxusSpells___LaxusF_KS_c[this], true) * LaxusGF_DamageStrBonus2
                    set s__LaxusSpells___LaxusF_KS_check2[this]=1
                endif
            endif
            if LoadInteger(hs, GetHandleId(s__LaxusSpells___LaxusF_KS_c[this]), LaxusSpells___SH_LVL5) == 1 then
                call MakeSound("war3mapimported\\Hero_Laxus_GW3")
            else
                call MakeSound("war3mapimported\\Hero_Laxus_F1")
            endif
            call SetUnitVertexColor(s__LaxusSpells___LaxusF_KS_c[this], 255, 255, 255, 0)
            if s__LaxusSpells___LaxusF_KS_check2[this] == 1 then
                set s__LaxusSpells___LaxusF_KS_e[this]=EffectSpawn("war3mapImported\\wos_BJT_VFX_ERE_LightningFieldBall_Ore_red.mdl" , GetUnitX(s__LaxusSpells___LaxusF_KS_c[this]) , GetUnitY(s__LaxusSpells___LaxusF_KS_c[this]) , 1.0 , 1.0 , 1.0 , 100.0)
                set s__LaxusSpells___LaxusF_KS_e2[this]=AddSpecialEffectTarget("war3mapImported\\wos_File00229.mdl", s__LaxusSpells___LaxusF_KS_c[this], "hand left")
                set s__LaxusSpells___LaxusF_KS_e3[this]=AddSpecialEffectTarget("war3mapImported\\wos_BJT_VFX_ERE_LightningFieldBall_Ore_red.mdl", s__LaxusSpells___LaxusF_KS_c[this], "hand left")
            else
                set s__LaxusSpells___LaxusF_KS_e[this]=EffectSpawn("war3mapImported\\wos_BJT_VFX_ERE_LightningFieldBall_Ore.mdl" , GetUnitX(s__LaxusSpells___LaxusF_KS_c[this]) , GetUnitY(s__LaxusSpells___LaxusF_KS_c[this]) , 1.0 , 1.0 , 1.0 , 100.0)
                set s__LaxusSpells___LaxusF_KS_e2[this]=AddSpecialEffectTarget("war3mapImported\\wos_File00229.mdl", s__LaxusSpells___LaxusF_KS_c[this], "hand left")
                set s__LaxusSpells___LaxusF_KS_e3[this]=AddSpecialEffectTarget("war3mapImported\\wos_BJT_VFX_ERE_LightningFieldBall_Ore.mdl", s__LaxusSpells___LaxusF_KS_c[this], "hand left")
            endif
            if s__LaxusSpells___LaxusF_KS_MUI_LaxusF == 0 then
                call LaxusSpells___LaxusTimer03Acquire()
            endif
        endfunction


        function s__LaxusSpells___LaxusG_KS_Loop_LaxusG takes nothing returns nothing
            local integer this
            local integer i= 0
            local real remaining
            local real hp
            loop
                exitwhen i > s__LaxusSpells___LaxusG_KS_MUI_LaxusG
                set this=s__LaxusSpells___LaxusG_KS_m_LaxusG[i]
                if SpellBoolCaster(s__LaxusSpells___LaxusG_KS_c[this]) and s__LaxusSpells___LaxusG_KS_r[this] <= s__LaxusSpells___LaxusG_KS_rmax[this] and not CheckCoordsInRect(gg_rct_Base , GetUnitX(s__LaxusSpells___LaxusG_KS_c[this]) , GetUnitY(s__LaxusSpells___LaxusG_KS_c[this])) then
                    if not IsUnitPaused(s__LaxusSpells___LaxusG_KS_c[this]) then
                        set s__LaxusSpells___LaxusG_KS_r[this]=I2R(R2I(( s__LaxusSpells___LaxusG_KS_r[this] + 0.03 ) * 1000.0 + 0.5)) / 1000.0
                    endif
                    set remaining=s__LaxusSpells___LaxusG_KS_rmax[this] - s__LaxusSpells___LaxusG_KS_r[this]
                    if remaining < 0.0 then
                        set remaining=0.0
                    endif
                    call WOSUI___WUI_TestHeroProgress((s__LaxusSpells___LaxusG_KS_c[this] ) , ( LaxusG_ID ) , ( "Dragon Force" ) , (( remaining )*1.0) , (( s__LaxusSpells___LaxusG_KS_rmax[this] )*1.0) , ( true) , "") // INLINED!!
                else
                        call WOSUI___WUI_TestHeroProgress((s__LaxusSpells___LaxusG_KS_c[this] ) , ( LaxusG_ID ) , ( "Dragon Force" ) , (( 0.00 )*1.0) , (( 0.00 )*1.0) , ( true) , "") // INLINED!!

                    call SaveInteger(hs, GetHandleId(s__LaxusSpells___LaxusG_KS_c[this]), LaxusSpells___SH_LVL4, 0)
                    call IssueImmediateOrder(s__LaxusSpells___LaxusG_KS_c[this], "stop")
                    if GetLocalPlayer() == Player(s__LaxusSpells___LaxusG_KS_k2[this]) then
                        call BlzSetAbilityIcon(LaxusQ2_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Laxus_Q2.blp")
                        call BlzSetAbilityIcon(LaxusW_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Laxus_W.blp")
                        call BlzSetAbilityIcon(LaxusW2_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Laxus_W2.blp")
                        call BlzSetAbilityIcon(LaxusE_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Laxus_E.blp")
                        call BlzSetAbilityIcon(LaxusR_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Laxus_R.blp")
                        call BlzSetAbilityIcon(LaxusF_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Laxus_F.blp")
                    endif
                    call SaveInteger(hs, GetHandleId(s__LaxusSpells___LaxusG_KS_c[this]), LaxusSpells___SH_MODE_G, 0)
                    if s__LaxusSpells___LaxusG_KS_e[this] != null then
                        call DestroyEffect(s__LaxusSpells___LaxusG_KS_e[this])
                    endif
                    set hp=GetUnitState(s__LaxusSpells___LaxusG_KS_c[this], UNIT_STATE_LIFE) / GetUnitState(s__LaxusSpells___LaxusG_KS_c[this], UNIT_STATE_MAX_LIFE)
                    call BlzSetUnitMaxHP(s__LaxusSpells___LaxusG_KS_c[this], BlzGetUnitMaxHP(s__LaxusSpells___LaxusG_KS_c[this]) - s__LaxusSpells___LaxusG_KS_scale[this])
                    call SetUnitState(s__LaxusSpells___LaxusG_KS_c[this], UNIT_STATE_LIFE, GetUnitState(s__LaxusSpells___LaxusG_KS_c[this], UNIT_STATE_MAX_LIFE) * hp)
                    call UnitRemoveAbility(s__LaxusSpells___LaxusG_KS_c[this], 'A0F0')
                    call AddSpellLevel(s__LaxusSpells___LaxusG_KS_c[this] , 'A01C' , s__LaxusSpells___LaxusG_KS_msLv[this] , false)
                    call UnitRemoveAbility(s__LaxusSpells___LaxusG_KS_c[this], s__LaxusSpells___LaxusG_KS_asAbi[this])

                    call SetPlayerAbilityAvailable(GetOwningPlayer(s__LaxusSpells___LaxusG_KS_c[this]), LaxusQ_ID, true)
                    call SetPlayerAbilityAvailable(GetOwningPlayer(s__LaxusSpells___LaxusG_KS_c[this]), LaxusQ2_ID, false)
                    call BlzStartUnitAbilityCooldown(s__LaxusSpells___LaxusG_KS_c[this], LaxusQ_ID, BlzGetUnitAbilityCooldownRemaining(s__LaxusSpells___LaxusG_KS_c[this], LaxusQ2_ID))
                    if s__LaxusSpells___LaxusG_KS_d[this] != null then
                        call RemoveUnit(s__LaxusSpells___LaxusG_KS_d[this])
                    endif

                    // Точка 3: Возврат тултипов в форму 0 при окончании морфа
                    call AAUniversalTooltips_SetUnitForm(s__LaxusSpells___LaxusG_KS_c[this] , 0)

                    set s__LaxusSpells___LaxusG_KS_c[this]=null
                    set s__LaxusSpells___LaxusG_KS_d[this]=null
                    set s__LaxusSpells___LaxusG_KS_e[this]=null
                    set s__LaxusSpells___LaxusG_KS_m_LaxusG[i]=s__LaxusSpells___LaxusG_KS_m_LaxusG[s__LaxusSpells___LaxusG_KS_MUI_LaxusG]
                    set s__LaxusSpells___LaxusG_KS_MUI_LaxusG=s__LaxusSpells___LaxusG_KS_MUI_LaxusG - 1
                    if s__LaxusSpells___LaxusG_KS_MUI_LaxusG == - 1 then
                        call LaxusSpells___LaxusTimer03Release()
                    endif
                    call s__LaxusSpells___LaxusG_KS_deallocate(this)
                    set i=i - 1
                endif
                set i=i + 1
            endloop
        endfunction

        function s__LaxusSpells___LaxusG_KS_LaxusG_Start takes unit NewC returns nothing
            local integer this= s__LaxusSpells___LaxusG_KS__allocate()
            local integer rr= LaxusG_HpBonus35
            local real hp
            set s__LaxusSpells___LaxusG_KS_MUI_LaxusG=s__LaxusSpells___LaxusG_KS_MUI_LaxusG + 1
            set s__LaxusSpells___LaxusG_KS_m_LaxusG[s__LaxusSpells___LaxusG_KS_MUI_LaxusG]=this
            set s__LaxusSpells___LaxusG_KS_c[this]=NewC
            set s__LaxusSpells___LaxusG_KS_r[this]=0.0
            set s__LaxusSpells___LaxusG_KS_k2[this]=GetPlayerId(GetOwningPlayer(s__LaxusSpells___LaxusG_KS_c[this]))
            set s__LaxusSpells___LaxusG_KS_rmax[this]=LaxusG_Duration
            set s__LaxusSpells___LaxusG_KS_d[this]=CreateUnit(GetOwningPlayer(s__LaxusSpells___LaxusG_KS_c[this]), 'h02D', GetRectCenterX(gg_rct_Caster), GetRectCenterY(gg_rct_Caster), 1.0)
            
            // Запуск без остановки через Order Tracking
            call Laxus_RestoreOrder(s__LaxusSpells___LaxusG_KS_c[this] , 7)

            call UnitAddAbility(s__LaxusSpells___LaxusG_KS_c[this], 'A0F0')
            call UnitAddAbility(s__LaxusSpells___LaxusG_KS_c[this], LaxusQ2_ID)
            call SetUnitAbilityLevel(s__LaxusSpells___LaxusG_KS_c[this], LaxusQ2_ID, GetUnitAbilityLevel(s__LaxusSpells___LaxusG_KS_c[this], LaxusQ_ID))
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__LaxusSpells___LaxusG_KS_c[this]), LaxusQ_ID, false)
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__LaxusSpells___LaxusG_KS_c[this]), LaxusQ2_ID, true)
            call BlzStartUnitAbilityCooldown(s__LaxusSpells___LaxusG_KS_c[this], LaxusQ2_ID, BlzGetUnitAbilityCooldownRemaining(s__LaxusSpells___LaxusG_KS_c[this], LaxusQ_ID))
              
            set hp=GetUnitState(s__LaxusSpells___LaxusG_KS_c[this], UNIT_STATE_LIFE) / GetUnitState(s__LaxusSpells___LaxusG_KS_c[this], UNIT_STATE_MAX_LIFE)
            call SaveInteger(hs, GetHandleId(s__LaxusSpells___LaxusG_KS_c[this]), LaxusSpells___SH_MODE_G, 1)
            call SaveInteger(hs, GetHandleId(s__LaxusSpells___LaxusG_KS_c[this]), LaxusSpells___SH_LVL4, 1)
            if GetLocalPlayer() == Player(s__LaxusSpells___LaxusG_KS_k2[this]) then
                call BlzSetAbilityIcon(LaxusQ2_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Laxus_Q2.blp")
            endif

            if LoadInteger(hs, GetHandleId(s__LaxusSpells___LaxusG_KS_c[this]), LaxusSpells___SH_LVL5) == 0 then
                set s__LaxusSpells___LaxusG_KS_scale[this]=0
                if GetRandomInt(1, 4) == 2 then
                    call MakeSound("war3mapimported\\Hero_Laxus_G4")
                else
                    call MakeSound("war3mapimported\\Hero_Laxus_G5")
                endif
                call DestroyEffect(EffectSpawn("war3mapImported\\wos_YellowMissile.mdl" , GetUnitX(s__LaxusSpells___LaxusG_KS_c[this]) , GetUnitY(s__LaxusSpells___LaxusG_KS_c[this]) , 1.0 , 1.0 , 4.0 , 100.0))
                set s__LaxusSpells___LaxusG_KS_e[this]=AddSpecialEffectTarget("war3mapImported\\wos_Shio_Super_Saiyan_JN_SS-2_laxus1.mdl", s__LaxusSpells___LaxusG_KS_c[this], "origin")

                // Точка 1: Вход в Форму 1 (Mode G)
                call AAUniversalTooltips_SetUnitForm(s__LaxusSpells___LaxusG_KS_c[this] , 1)
            else
                call DestroyEffect(EffectSpawn("war3mapImported\\wos_RedMissile.mdl" , GetUnitX(s__LaxusSpells___LaxusG_KS_c[this]) , GetUnitY(s__LaxusSpells___LaxusG_KS_c[this]) , 1.0 , 1.0 , 4.0 , 100.0))
                if GetRandomInt(1, 4) == 2 then
                    call MakeSound("war3mapimported\\Hero_Laxus_G4")
                else
                    call MakeSound("war3mapimported\\Hero_Laxus_G2")
                endif
                set s__LaxusSpells___LaxusG_KS_scale[this]=rr
                call BlzSetUnitMaxHP(s__LaxusSpells___LaxusG_KS_c[this], BlzGetUnitMaxHP(s__LaxusSpells___LaxusG_KS_c[this]) + rr)
                call SetUnitState(s__LaxusSpells___LaxusG_KS_c[this], UNIT_STATE_LIFE, GetUnitState(s__LaxusSpells___LaxusG_KS_c[this], UNIT_STATE_MAX_LIFE) * hp)
                set s__LaxusSpells___LaxusG_KS_e[this]=AddSpecialEffectTarget("war3mapImported\\wos_Shio_Super_Saiyan_JN_SS-2_laxus2.mdl", s__LaxusSpells___LaxusG_KS_c[this], "origin")
                if GetLocalPlayer() == Player(s__LaxusSpells___LaxusG_KS_k2[this]) then
                    call BlzSetAbilityIcon(LaxusQ2_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Laxus_GQ.blp")
                    call BlzSetAbilityIcon(LaxusW_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Laxus_GW.blp")
                    call BlzSetAbilityIcon(LaxusW2_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Laxus_GW2.blp")
                    call BlzSetAbilityIcon(LaxusE_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Laxus_GE.blp")
                    call BlzSetAbilityIcon(LaxusR_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Laxus_GR.blp")
                    call BlzSetAbilityIcon(LaxusF_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Laxus_GF.blp")
                endif

                // Точка 2: Вход в Форму 2 (Red Lightning Mode Lv. 35)
                call AAUniversalTooltips_SetUnitForm(s__LaxusSpells___LaxusG_KS_c[this] , 2)
            endif

            if LoadInteger(hs, GetHandleId(s__LaxusSpells___LaxusG_KS_c[this]), LaxusSpells___SH_LVL5) == 0 then
                set s__LaxusSpells___LaxusG_KS_msLv[this]=LaxusG_MsLevels
                set s__LaxusSpells___LaxusG_KS_asAbi[this]=LaxusG_AttackSpeed_ID
            else
                set s__LaxusSpells___LaxusG_KS_msLv[this]=LaxusG_MsLevels35
                set s__LaxusSpells___LaxusG_KS_asAbi[this]=LaxusG_AttackSpeed35_ID
            endif
            call AddSpellLevel(s__LaxusSpells___LaxusG_KS_c[this] , 'A01C' , s__LaxusSpells___LaxusG_KS_msLv[this] , true)
            call UnitAddAbility(s__LaxusSpells___LaxusG_KS_c[this], s__LaxusSpells___LaxusG_KS_asAbi[this])
            call UnitMakeAbilityPermanent(s__LaxusSpells___LaxusG_KS_c[this], true, s__LaxusSpells___LaxusG_KS_asAbi[this])

            if s__LaxusSpells___LaxusG_KS_MUI_LaxusG == 0 then
                call LaxusSpells___LaxusTimer03Acquire()
            endif
        endfunction

    // Dragon Force (G): every attack applies the Lightning debuff.
    function LaxusG_OnAttack takes unit c,unit td returns nothing
        if LoadInteger(hs, GetHandleId(c), LaxusSpells___SH_MODE_G) == 1 and IsUnitEnemy(td, GetOwningPlayer(c)) then
            set GearDamageNextSource=(LaxusG_ID) // INLINED!!
            call ErzaPassive(c , td , 3)
        endif
    endfunction

    function LaxusSpells___LaxusTimer03Loop takes nothing returns nothing
        call s__LaxusSpells___LaxusW2_Revert_Loop()
        call s__LaxusSpells___LaxusQ_KS_Loop_LaxusQ()
        call s__LaxusSpells___LaxusQ_KS_Loop_LaxusQ2()
        call s__LaxusSpells___LaxusW_KS_Loop_LaxusW()
        call s__LaxusSpells___LaxusW_KS_Loop_LaxusW2()
        call s__LaxusSpells___LaxusE_KS_Loop_LaxusE()
        call s__LaxusSpells___LaxusR_KS_Loop_LaxusR()
        call s__LaxusSpells___LaxusT_KS_Loop_LaxusT()
        call s__LaxusSpells___LaxusF_KS_Loop_LaxusF()
        call s__LaxusSpells___LaxusG_KS_Loop_LaxusG()
    endfunction

    function LaxusSpells___InitLaxusSpells takes nothing returns nothing
        set LaxusSpells___LaxusTimer03=CreateTimer()
        set LaxusSpells___LaxusTimer03Callback=function LaxusSpells___LaxusTimer03Loop
    endfunction

    //===========================================================================
    // ТОЧКИ ВХОДА СПОСОБНОСТЕЙ
    //===========================================================================
    function LaxusFCheck_Start takes unit damaged returns nothing
        local integer i= 0
        local unit responder
        local player damagedOwner= GetOwningPlayer(damaged)
        local real damagedX= GetUnitX(damaged)
        local real damagedY= GetUnitY(damaged)
        local real dx
        local real dy
        local real rangeSquared= LaxusF_AoeSearch * LaxusF_AoeSearch

        loop
            exitwhen i >= bj_MAX_PLAYER_SLOTS
            set responder=Hero[i]

            if responder != null and GetUnitTypeId(responder) == Laxus_ID and GetWidgetLife(responder) > 1.0 and not IsUnitIllusion(responder) and GetHeroLevel(responder) >= 25 and IsUnitAlly(responder, damagedOwner) then
                set dx=GetUnitX(responder) - damagedX
                set dy=GetUnitY(responder) - damagedY

                if dx * dx + dy * dy <= rangeSquared and IntegerCdKey(responder , SH_ICD_PAS_F , 5.0) then
                    call s__GearSystems2___KS_RemoveUnit_MyRemoveUnit_Start((CreateUnit(GetOwningPlayer(responder), 'h02D', GetRectCenterX(gg_rct_Caster), GetRectCenterY(gg_rct_Caster), 1.0) ) , (( 30.0)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
                endif
            endif

            set i=i + 1
        endloop

        set responder=null
        set damagedOwner=null
    endfunction

    function LaxusQ_Start takes unit c,real x,real y returns nothing
        if LoadInteger(hs, GetHandleId(c), LaxusSpells___SH_LVL4) == 0 then
            call s__LaxusSpells___LaxusQ_KS_LaxusQ_Start(c , x , y)
        else
            call s__LaxusSpells___LaxusQ_KS_LaxusQ2_Start(c , x , y)
        endif
    endfunction

    function LaxusQ2_Start takes unit c,real x,real y returns nothing
        call s__LaxusSpells___LaxusQ_KS_LaxusQ2_Start(c , x , y)
    endfunction

    function LaxusW_Start takes unit c,unit td returns nothing
        call s__LaxusSpells___LaxusW_KS_LaxusW_Start(c , td)
    endfunction

    function LaxusW2_Start takes unit c,unit td returns nothing
        call s__LaxusSpells___LaxusW_KS_LaxusW2_Start(c , td)
    endfunction

    function LaxusE_Start takes unit c returns nothing
        call s__LaxusSpells___LaxusE_KS_LaxusE_Start(c)
    endfunction

    function LaxusR_Start takes unit c,unit td returns nothing
        local real x= GetUnitX(td)
        local real y= GetUnitY(td)
        local integer i2= 0
        local integer id= LaxusR_ID
        if IsUnitAlly(td, GetOwningPlayer(c)) and GetHeroLevel(td) >= 25 and GetUnitTypeId(td) == Natsu_ID and LoadInteger(hs, GetHandleId(td), LaxusSpells___SH_MODE_G) == 0 and IntegerCdKey(c , SH_ICD_NATSU_MODE_RAIEN , 60.0) then
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_YellowBoom.mdx" , x , y , 1.0 , 1.25 , 4.0 , 110.0))
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_by_wood_effect_yubanmeiqin_lightning_zhenzhengdeluolei_yellow.mdl" , x , y , 1.0 , 1.0 , 2.0 , 1.0))
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_YellowMissile.mdl" , x , y , 1.0 , 1.0 , 6.0 , 100.0))
            call NatsuG2_Start(td)
            call UnitAddAbility(td, 'A0F8')
            call s__GearSystems2___KS_RemoveAbility_RemoveAbility_Start((td ) , (( 20.0 )*1.0) , ( 'A0F8' ) , ( 1)) // INLINED!!
            call MakeSound("war3mapimported\\Hero_Laxus_Pick1")
            call MakeSound("war3mapimported\\Hero_Laxus_W2 2")
        elseif IsUnitEnemy(td, GetOwningPlayer(c)) then
            call s__LaxusSpells___LaxusR_KS_LaxusR_Start(c , td)
        else
            call IssueImmediateOrder(c, "stop")
            set i2=BlzGetAbilityIntegerLevelField(BlzGetUnitAbility(c, id), ABILITY_ILF_MANA_COST, GetUnitAbilityLevel(c, id) - 1)
            call s__GearSystems2___KS_AddMana_Start((c ) , (( I2R(i2) )*1.0) , (( 0.03)*1.0)) // INLINED!!
        endif
    endfunction

    function LaxusT_Start takes unit c returns nothing
        call s__LaxusSpells___LaxusT_KS_LaxusT_Start(c)
    endfunction

    function LaxusF_Start takes unit c,unit td returns nothing
        call s__LaxusSpells___LaxusF_KS_LaxusF_Start(c , td)
    endfunction

    function LaxusG_Start takes unit c returns nothing
        call s__LaxusSpells___LaxusG_KS_LaxusG_Start(c)
    endfunction

//library LaxusSpells ends
//library ErzaBase:
   
    //----------------------------Erza-----------------------------------------------
     
    function ErzaBaseAbiBlock takes unit c,boolean b returns nothing
        local integer i= GetPlayerId(GetOwningPlayer(c))
        call SetPlayerAbilityAvailable(Player(i), ErzaQ_ID, b)
        call SetPlayerAbilityAvailable(Player(i), ErzaW_ID, b)
        call SetPlayerAbilityAvailable(Player(i), ErzaE_ID, b)
        call SetPlayerAbilityAvailable(Player(i), ErzaR_ID, b)
        call SetPlayerAbilityAvailable(Player(i), ErzaT_ID, b)
        if b == false then
            call DestroyEffect(EffectSpawn("war3mapimported\\wos_0706Red.mdl" , GetUnitX(c) , GetUnitY(c) , 0 , 1 , 3.5 , 110))
            call DestroyEffect(EffectSpawn("war3mapimported\\wos_mard effect 2.mdl" , GetUnitX(c) , GetUnitY(c) , 0 , 1 , 1.35 , 0))
        else
            if CheckCoordsInRect(gg_rct_Base , GetUnitX(c) , GetUnitY(c)) == false then
                if GetRandomInt(1, 2) == 1 then
                    call MakeSound("war3mapImported\\Hero_Erza_F_Cancel")
                else
                    call MakeSound("war3mapImported\\Hero_Erza_F_Cancel2")
                endif
            endif
        endif
    endfunction
    function ErzaAbiArmorAdd takes unit c,integer id1,integer id2,integer id3,integer id4,integer id5,integer id6,boolean b,integer level returns nothing
        local integer i= GetPlayerId(GetOwningPlayer(c))
        local real cd
        local real cd2
        local real cd3
        if b == true then
            call SetPlayerAbilityAvailable(Player(i), id1, b)
            call SetPlayerAbilityAvailable(Player(i), id2, b)
            call SetPlayerAbilityAvailable(Player(i), id3, b)
            call SetPlayerAbilityAvailable(Player(i), id4, b)
            call SetPlayerAbilityAvailable(Player(i), id5, b)
            if id6 != 0 then
                call SetPlayerAbilityAvailable(Player(i), id6, b)
            endif
            if GetUnitAbilityLevel(c, id1) == 0 then
                call UnitAddAbility(c, id1)
                call UnitAddAbility(c, id2)
                call UnitAddAbility(c, id3)
                call UnitAddAbility(c, id4)
                call UnitAddAbility(c, id5)
                if id6 != 0 then
                    call UnitAddAbility(c, id6)
                    call UnitMakeAbilityPermanent(c, b, id6)
                endif
                call UnitMakeAbilityPermanent(c, b, id1)
                call UnitMakeAbilityPermanent(c, b, id2)
                call UnitMakeAbilityPermanent(c, b, id3)
                call UnitMakeAbilityPermanent(c, b, id4)
                call UnitMakeAbilityPermanent(c, b, id5)
                call SetUnitAbilityLevel(c, id1, level)
                call SetUnitAbilityLevel(c, id2, level)
                call SetUnitAbilityLevel(c, id3, level)
                call SetUnitAbilityLevel(c, id4, level)
                call SetUnitAbilityLevel(c, id5, level)
            else
                call SetUnitAbilityLevel(c, id1, level)
                call SetUnitAbilityLevel(c, id2, level)
                call SetUnitAbilityLevel(c, id3, level)
                call SetUnitAbilityLevel(c, id4, level)
                call SetUnitAbilityLevel(c, id5, level)
            endif
     //-------------------------------------------------------
            if id1 == Erza1Q_ID or id1 == Erza2Q_ID or id1 == Erza3Q_ID then
                set cd=BlzGetUnitAbilityCooldownRemaining(c, Erza1Q_ID)
                set cd2=BlzGetUnitAbilityCooldownRemaining(c, Erza2Q_ID)
                set cd3=BlzGetUnitAbilityCooldownRemaining(c, Erza3Q_ID)
                if cd > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza2Q_ID, cd)
                    call BlzStartUnitAbilityCooldown(c, Erza3Q_ID, cd)
                elseif cd2 > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza1Q_ID, cd2)
                    call BlzStartUnitAbilityCooldown(c, Erza3Q_ID, cd2)
                elseif cd3 > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza1Q_ID, cd3)
                    call BlzStartUnitAbilityCooldown(c, Erza2Q_ID, cd3)
                endif
            endif
            if id4 == Erza2R_ID or id4 == Erza3R_ID then
                set cd2=BlzGetUnitAbilityCooldownRemaining(c, Erza2R_ID)
                set cd3=BlzGetUnitAbilityCooldownRemaining(c, Erza3R_ID)
                if cd2 > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza3R_ID, cd2)
                elseif cd3 > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza2R_ID, cd3)
                endif
            endif
            if id5 == Erza1T_ID or id5 == Erza2T_ID or id5 == Erza3T_ID then
                set cd=BlzGetUnitAbilityCooldownRemaining(c, Erza1T_ID)
                set cd2=BlzGetUnitAbilityCooldownRemaining(c, Erza2T_ID)
                set cd3=BlzGetUnitAbilityCooldownRemaining(c, Erza3T_ID)
                if cd > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza2T_ID, cd)
                    call BlzStartUnitAbilityCooldown(c, Erza3T_ID, cd)
                elseif cd2 > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza1T_ID, cd2)
                    call BlzStartUnitAbilityCooldown(c, Erza3T_ID, cd2)
                elseif cd3 > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza1T_ID, cd3)
                    call BlzStartUnitAbilityCooldown(c, Erza2T_ID, cd3)
                endif
            endif
    //--------------R and T LoadInteger(hs,GetHandleId(c),StringHash("erza g2 type"))--------------------------------
            if id1 == Erza4Q_ID or id1 == Erza5Q_ID then
                set cd=BlzGetUnitAbilityCooldownRemaining(c, Erza4Q_ID)
                set cd2=BlzGetUnitAbilityCooldownRemaining(c, Erza5Q_ID)
                if cd > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza5Q_ID, cd)
                elseif cd2 > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza4Q_ID, cd2)
                endif
            endif
            if id2 == Erza4W_ID or id2 == Erza5W_ID then
                set cd=BlzGetUnitAbilityCooldownRemaining(c, Erza4W_ID)
                set cd2=BlzGetUnitAbilityCooldownRemaining(c, Erza5W_ID)
                if cd > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza5W_ID, cd)
                elseif cd2 > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza4W_ID, cd2)
                endif
            endif
            if id3 == Erza4E_ID or id3 == Erza5E_ID then
                set cd=BlzGetUnitAbilityCooldownRemaining(c, Erza4E_ID)
                set cd2=BlzGetUnitAbilityCooldownRemaining(c, Erza5E_ID)
                if cd > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza5E_ID, cd)
                elseif cd2 > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza4E_ID, cd2)
                endif
            endif
            if id4 == Erza4R_ID or id4 == Erza5R_ID then
                set cd=BlzGetUnitAbilityCooldownRemaining(c, Erza4R_ID)
                set cd2=BlzGetUnitAbilityCooldownRemaining(c, Erza5R_ID)
                if cd > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza5R_ID, cd)
                elseif cd2 > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza4R_ID, cd2)
                endif
            endif
            if id5 == Erza4T_ID or id5 == Erza5T_ID then
                set cd=BlzGetUnitAbilityCooldownRemaining(c, Erza4T_ID)
                set cd2=BlzGetUnitAbilityCooldownRemaining(c, Erza5T_ID)
                if cd > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza5T_ID, cd)
                elseif cd2 > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza4T_ID, cd2)
                endif
            endif
    //-----------------------------------------------------------
        else
            call SetPlayerAbilityAvailable(Player(i), id1, b)
            call SetPlayerAbilityAvailable(Player(i), id2, b)
            call SetPlayerAbilityAvailable(Player(i), id3, b)
            call SetPlayerAbilityAvailable(Player(i), id4, b)
            call SetPlayerAbilityAvailable(Player(i), id5, b)
            if id6 != 0 then
                call SetPlayerAbilityAvailable(Player(i), id6, b)
            endif
        endif
    endfunction
    function ErzaF_Start takes unit c returns nothing
        local integer id= GetHandleId(c)
        local integer i= GetPlayerId(GetOwningPlayer(c))
        local integer sh1= ErzaBase__SH_Q_ARMOR_ACTIVE
        local integer sh2= ErzaBase__SH_W_ARMOR_ACTIVE
        local integer sh3= ErzaBase__SH_E_ARMOR_ACTIVE
        local integer sh4= ErzaBase__SH_R_ARMOR_ACTIVE
        local integer sh5= ErzaBase__SH_T_ARMOR_ACTIVE
        local integer sh6= ErzaBase__SH_G_ARMOR_ACTIVE
        local integer k
        local real hp= GetUnitState(c, UNIT_STATE_LIFE) / GetUnitState(c, UNIT_STATE_MAX_LIFE)
        local real cd
        local integer check= 0
        call IssueImmediateOrder(c, "stop")
        if GetUnitAbilityLevel(c, ErzaG2_ID) > 0 then
            call SetPlayerAbilityAvailable(GetOwningPlayer(c), ErzaG2_ID, true)
            call SetPlayerAbilityAvailable(GetOwningPlayer(c), ErzaG_ID, false)
        else
            call SetPlayerAbilityAvailable(GetOwningPlayer(c), ErzaG_ID, true)
        endif
        if LoadInteger(hs, id, sh1) == 1 then
            set check=1
            call BlzSetUnitMaxHP(c, BlzGetUnitMaxHP(c) - ErzaQ_ArmorStatHpBase - ( ErzaQ_ArmorStatHpStep * ( GetUnitAbilityLevel(c, ErzaQ_ID) - 1 ) ))
            call SetUnitState(c, UNIT_STATE_LIFE, GetUnitState(c, UNIT_STATE_MAX_LIFE) * hp)
            call UnitRemoveAbility(c, ErzaQ_ArmorStat_ID)
            call ErzaAbiArmorAdd(c , Erza1Q_ID , Erza1W_ID , Erza1E_ID , Erza1R_ID , Erza1T_ID , 0 , false , GetUnitAbilityLevel(c, ErzaQ_ID))
            call ErzaBaseAbiBlock(c , true)
            call SaveInteger(hs, id, sh1, 0)
        elseif LoadInteger(hs, id, sh2) == 1 then
            call ErzaBaseAbiBlock(c , true)
            set check=1
            call UnitRemoveAbility(c, ErzaW_Regen0_ID)
            call UnitRemoveAbility(c, ErzaW_Regen1_ID)
            call UnitRemoveAbility(c, ErzaW_Regen2_ID)
            call UnitRemoveAbility(c, ErzaW_Regen3_ID)
            call UnitRemoveAbility(c, ErzaW_Regen4_ID)
            //call BlzSetUnitRealField(c, UNIT_RF_HIT_POINTS_REGENERATION_RATE, BlzGetUnitRealField(c, UNIT_RF_HIT_POINTS_REGENERATION_RATE) - (ErzaW_ArmorStatHpRegenBase + (ErzaW_ArmorStatHpRegenStep * (GetUnitAbilityLevel(c, ErzaW_ID) - 1))))
            call ErzaAbiArmorAdd(c , Erza2Q_ID , Erza2W_ID , Erza2E_ID , Erza2R_ID , Erza2T_ID , 0 , false , GetUnitAbilityLevel(c, ErzaW_ID))
            call SaveInteger(hs, id, sh2, 0)
        elseif LoadInteger(hs, id, sh3) == 1 then
            call ErzaBaseAbiBlock(c , true)
            set check=1
            call AddSpellLevel(c , 'A01C' , ErzaE_ArmorMS_LvLBase_ID + ( ErzaE_ArmorMS_LvLStep_ID * ( GetUnitAbilityLevel(c, ErzaW_ID) - 1 ) ) , false)
            call BlzSetUnitRealField(c, UNIT_RF_MANA_REGENERATION, BlzGetUnitRealField(c, UNIT_RF_MANA_REGENERATION) - ( ErzaE_ArmorStatMpRegenBase + ( ErzaE_ArmorStatMpRegenStep * ( GetUnitAbilityLevel(c, ErzaE_ID) - 1 ) ) ))
            call SaveInteger(hs, id, sh3, 0)
            call ErzaAbiArmorAdd(c , Erza3Q_ID , Erza3W_ID , Erza3E_ID , Erza3R_ID , Erza3T_ID , 0 , false , GetUnitAbilityLevel(c, ErzaE_ID))
        elseif LoadInteger(hs, id, sh4) == 1 then
            call BlzSetUnitMaxHP(c, BlzGetUnitMaxHP(c) - ( ErzaR_ArmorStatHpBase + ( ErzaR_ArmorStatHpStep * ( GetUnitAbilityLevel(c, ErzaR_ID) - 1 ) ) ))
            call SetUnitState(c, UNIT_STATE_LIFE, GetUnitState(c, UNIT_STATE_MAX_LIFE) * hp)
            call AddSpellLevel(c , 'A01C' , ErzaR_ArmorMS_LvLBase_ID + ( ErzaR_ArmorMS_LvLStep_ID * ( GetUnitAbilityLevel(c, ErzaR_ID) - 1 ) ) , false)
            call UnitRemoveAbility(c, ErzaR_ArmorStatAS_ID)
            call UnitRemoveAbility(c, ErzaR_ArmorStatEvade_ID)
            call ErzaBaseAbiBlock(c , true)
            set check=1
            call SaveInteger(hs, id, sh4, 0)
            set k=LoadInteger(hs, GetHandleId(c), ErzaBase__SH_E_STACKS)
            set cd=BlzGetUnitAbilityCooldown(c, Erza4E_ID, GetUnitAbilityLevel(c, Erza4E_ID) - 1)
            if k > 0 then
                call s__GearSystems2___KS_Flush_Start((GetHandleId(c) ) , ( ErzaBase__SH_E_STACKS ) , ( 0 ) , (( 1)*1.0)) // INLINED!!
                call BlzStartUnitAbilityCooldown(c, Erza4E_ID, cd)
            endif
            call SaveInteger(hs, GetHandleId(c), ErzaBase__SH_E_STACKS, 0)
            call ErzaAbiArmorAdd(c , Erza4Q_ID , Erza4W_ID , Erza4E_ID , Erza4R_ID , Erza4T_ID , Erza4F_ID , false , GetUnitAbilityLevel(c, ErzaR_ID))
        elseif LoadInteger(hs, id, sh5) == 1 then
            set check=1
            call BlzSetUnitMaxHP(c, BlzGetUnitMaxHP(c) - ErzaT_ArmorStatHpBase)
            call SetUnitState(c, UNIT_STATE_LIFE, GetUnitState(c, UNIT_STATE_MAX_LIFE) * hp)
            call ErzaBaseAbiBlock(c , true)
            call SaveInteger(hs, id, sh5, 0)
            call ErzaAbiArmorAdd(c , Erza5Q_ID , Erza5W_ID , Erza5E_ID , Erza5R_ID , Erza5T_ID , Erza5F_ID , false , GetUnitAbilityLevel(c, ErzaT_ID))
        elseif LoadInteger(hs, id, sh6) == 1 then
            set check=1
            call BlzSetUnitMaxHP(c, BlzGetUnitMaxHP(c) - ErzaT_ArmorStatHpBase)
            call SetUnitState(c, UNIT_STATE_LIFE, GetUnitState(c, UNIT_STATE_MAX_LIFE) * hp)
            call SaveInteger(hs, GetHandleId(c), ErzaBase__SH_ERZA_G2_ACTIVE, 0)
            call ErzaBaseAbiBlock(c , true)
            call SaveInteger(hs, id, sh6, 0)
            call ErzaAbiArmorAdd(c , Erza6Q_ID , Erza6W_ID , Erza6E_ID , Erza6R_ID , Erza6T_ID , 0 , false , GetUnitAbilityLevel(c, ErzaG2_ID))
            call ErzaAbiArmorAdd(c , Erza7Q_ID , Erza7W_ID , Erza7E_ID , Erza7R_ID , Erza7T_ID , 0 , false , GetUnitAbilityLevel(c, ErzaG2_ID))
        endif
        // The synergy dummy belongs only to the R armor. Clear it on every
        // form exit as a safeguard against stale armor flags and repicks.
        if s__ErzaR_NatsuGrayDummy[i] != null then
            call RemoveUnit(s__ErzaR_NatsuGrayDummy[i])
            set s__ErzaR_NatsuGrayDummy[i]= null
        endif
        if check > 0 then
            call BlzSetUnitSkin(c, ErzaUnitSkin_ID)
            call FixAura(c)
            call DestroyEffect(AddSpecialEffectTarget("war3mapimported\\wos_[dz_spell]002_blue5.mdl", c, "origin"))
        endif
    endfunction
    function ErzaQ_Start takes unit c returns nothing
        local integer id= GetHandleId(c)
        local integer i= GetPlayerId(GetOwningPlayer(c))
        local integer sh= ErzaBase__SH_Q_ARMOR_ACTIVE
        local real hp= GetUnitState(c, UNIT_STATE_LIFE) / GetUnitState(c, UNIT_STATE_MAX_LIFE)
        call BlzSetUnitSkin(c, ErzaQ_UnitSkin_ID)
        call FixAura(c)
        call SaveInteger(hs, id, sh, 1)
        call ErzaBaseAbiBlock(c , false)
        call s__ErzaQSpells__ErzaE_KS_ErzaE_Start((c)) // INLINED!!
        if GetUnitAbilityLevel(c, ErzaG2_ID) > 0 then
            call SetPlayerAbilityAvailable(GetOwningPlayer(c), ErzaG2_ID, false)
            call SetPlayerAbilityAvailable(GetOwningPlayer(c), ErzaG_ID, true)
        endif
        call BlzSetUnitMaxHP(c, BlzGetUnitMaxHP(c) + ErzaQ_ArmorStatHpBase + ( ErzaQ_ArmorStatHpStep * ( GetUnitAbilityLevel(c, ErzaQ_ID) - 1 ) ))
        call SetUnitState(c, UNIT_STATE_LIFE, GetUnitState(c, UNIT_STATE_MAX_LIFE) * hp)
        call UnitAddAbility(c, ErzaQ_ArmorStat_ID)
        call SetUnitAbilityLevel(c, ErzaQ_ArmorStat_ID, GetUnitAbilityLevel(c, ErzaQ_ID))
        if LoadInteger(hs, i, ErzaBase__SH_SOUND_CD2) == 0 then
            call SaveInteger(hs, i, ErzaBase__SH_SOUND_CD2, 1)
            call s__GearSystems2___KS_Flush_Start((i ) , ( ErzaBase__SH_SOUND_CD2 ) , ( 0 ) , (( 10)*1.0)) // INLINED!!
            if GetRandomInt(1, 2) == 1 then
                call MakeSound("war3mapImported\\Hero_Erza1_Start")
            else
                call MakeSound("war3mapImported\\Hero_Erza1_Start2")
            endif
        endif
        call ErzaAbiArmorAdd(c , Erza1Q_ID , Erza1W_ID , Erza1E_ID , Erza1R_ID , Erza1T_ID , 0 , true , GetUnitAbilityLevel(c, ErzaQ_ID))
    endfunction
    function ErzaW_Start takes unit c returns nothing
        local integer id= GetHandleId(c)
        local integer i= GetPlayerId(GetOwningPlayer(c))
        local integer sh= ErzaBase__SH_W_ARMOR_ACTIVE
        //call BlzSetUnitRealField(c, UNIT_RF_HIT_POINTS_REGENERATION_RATE, BlzGetUnitRealField(c, UNIT_RF_HIT_POINTS_REGENERATION_RATE) + ErzaW_ArmorStatHpRegenBase + (ErzaW_ArmorStatHpRegenStep * (GetUnitAbilityLevel(c, ErzaW_ID) - 1)))
        if GetUnitAbilityLevel(c, ErzaW_ID) == 1 then
            call UnitAddAbility(c, ErzaW_Regen0_ID)
        elseif GetUnitAbilityLevel(c, ErzaW_ID) == 2 then
            call UnitAddAbility(c, ErzaW_Regen1_ID)
        elseif GetUnitAbilityLevel(c, ErzaW_ID) == 3 then
            call UnitAddAbility(c, ErzaW_Regen2_ID)
        elseif GetUnitAbilityLevel(c, ErzaW_ID) == 4 then
            call UnitAddAbility(c, ErzaW_Regen3_ID)
        elseif GetUnitAbilityLevel(c, ErzaW_ID) == 5 then
            call UnitAddAbility(c, ErzaW_Regen4_ID)
        endif
        if GetUnitAbilityLevel(c, ErzaG2_ID) > 0 then
            call SetPlayerAbilityAvailable(GetOwningPlayer(c), ErzaG2_ID, false)
            call SetPlayerAbilityAvailable(GetOwningPlayer(c), ErzaG_ID, true)
        endif
        call BlzSetUnitSkin(c, ErzaW_UnitSkin_ID)
        call FixAura(c)
        call SaveInteger(hs, id, sh, 1)
        call ErzaBaseAbiBlock(c , false)
        if LoadInteger(hs, i, ErzaBase__SH_SOUND_CD3) == 0 then
            call SaveInteger(hs, i, ErzaBase__SH_SOUND_CD3, 1)
            call s__GearSystems2___KS_Flush_Start((i ) , ( ErzaBase__SH_SOUND_CD3 ) , ( 0 ) , (( 10)*1.0)) // INLINED!!
            call MakeSound("war3mapImported\\Hero_Erza2_Start")
        endif
        call ErzaAbiArmorAdd(c , Erza2Q_ID , Erza2W_ID , Erza2E_ID , Erza2R_ID , Erza2T_ID , 0 , true , GetUnitAbilityLevel(c, ErzaW_ID))
    endfunction
    function ErzaE_Start takes unit c returns nothing
        local integer id= GetHandleId(c)
        local integer i= GetPlayerId(GetOwningPlayer(c))
        local integer sh= ErzaBase__SH_E_ARMOR_ACTIVE
        call BlzSetUnitSkin(c, ErzaE_UnitSkin_ID)
        call FixAura(c)
        call SaveInteger(hs, id, sh, 1)
        call AddSpellLevel(c , 'A01C' , ErzaE_ArmorMS_LvLBase_ID + ( ErzaE_ArmorMS_LvLStep_ID * ( GetUnitAbilityLevel(c, ErzaW_ID) - 1 ) ) , true)
        call BlzSetUnitRealField(c, UNIT_RF_MANA_REGENERATION, BlzGetUnitRealField(c, UNIT_RF_MANA_REGENERATION) + ( ErzaE_ArmorStatMpRegenBase + ( ErzaE_ArmorStatMpRegenStep * ( GetUnitAbilityLevel(c, ErzaE_ID) - 1 ) ) ))
        call ErzaBaseAbiBlock(c , false)
        if LoadInteger(hs, i, ErzaBase__SH_SOUND_CD4) == 0 then
            call SaveInteger(hs, i, ErzaBase__SH_SOUND_CD4, 1)
            call s__GearSystems2___KS_Flush_Start((i ) , ( ErzaBase__SH_SOUND_CD4 ) , ( 0 ) , (( 10)*1.0)) // INLINED!!
            call MakeSound("war3mapImported\\Hero_Erza3_Start")
        endif
        if GetUnitAbilityLevel(c, ErzaG2_ID) > 0 then
            call SetPlayerAbilityAvailable(GetOwningPlayer(c), ErzaG2_ID, false)
            call SetPlayerAbilityAvailable(GetOwningPlayer(c), ErzaG_ID, true)
        endif
        call ErzaAbiArmorAdd(c , Erza3Q_ID , Erza3W_ID , Erza3E_ID , Erza3R_ID , Erza3T_ID , 0 , true , GetUnitAbilityLevel(c, ErzaE_ID))
    endfunction
    function ErzaR_Start takes unit c returns nothing
        local integer id= GetHandleId(c)
        local integer i= GetPlayerId(GetOwningPlayer(c))
        local integer sh= ErzaBase__SH_R_ARMOR_ACTIVE
        local integer stacks= 3 - LoadInteger(hs, GetHandleId(c), ErzaBase__SH_E_STACKS)
        local real hp= GetUnitState(c, UNIT_STATE_LIFE) / GetUnitState(c, UNIT_STATE_MAX_LIFE)
        local real x= GetUnitX(c)
        local real y= GetUnitY(c)
        local group g= CreateGroup()
        local unit u= null
        local integer k2= 0
        local integer k3= 0
        call GroupEnumUnitsInRange(g, x, y, 1800, NoDecor_Cond)
        loop
            set u=FirstOfGroup(g)
            exitwhen u == null
            if IsUnitAlly(u, GetOwningPlayer(c)) and GetWidgetLife(u) > 0.405 and not IsUnitType(u, UNIT_TYPE_DEAD) and not IsUnitHidden(u) then
                if GetUnitTypeId(u) == Gray_ID1 or GetUnitTypeId(u) == Gray_ID2 then
                    set k2=k2 + 1
                endif
                if GetUnitTypeId(u) == Natsu_ID then
                    set k3=k3 + 1
                endif
            endif
            call GroupRemoveUnit(g, u)
        endloop
        if k2 > 0 and k3 > 0 then
            if s__ErzaR_NatsuGrayDummy[i] == null then
                set s__ErzaR_NatsuGrayDummy[i]= CreateUnit(GetOwningPlayer(c), ErzaR_DummyElementalId, x, y, 0)
            endif
        else
            if s__ErzaR_NatsuGrayDummy[i] != null then
                call RemoveUnit(s__ErzaR_NatsuGrayDummy[i])
                set s__ErzaR_NatsuGrayDummy[i]= null
            endif
        endif
        if GetUnitAbilityLevel(c, ErzaG2_ID) > 0 then
            call SetPlayerAbilityAvailable(GetOwningPlayer(c), ErzaG2_ID, false)
        else
            call SetPlayerAbilityAvailable(GetOwningPlayer(c), ErzaG_ID, false)
        endif
        call BlzSetUnitMaxHP(c, BlzGetUnitMaxHP(c) + ( ErzaR_ArmorStatHpBase + ( ErzaR_ArmorStatHpStep * ( GetUnitAbilityLevel(c, ErzaR_ID) - 1 ) ) ))
        call SetUnitState(c, UNIT_STATE_LIFE, GetUnitState(c, UNIT_STATE_MAX_LIFE) * hp)
        call AddSpellLevel(c , 'A01C' , ErzaR_ArmorMS_LvLBase_ID + ( ErzaR_ArmorMS_LvLStep_ID * ( GetUnitAbilityLevel(c, ErzaR_ID) - 1 ) ) , true)
        call UnitAddAbility(c, ErzaR_ArmorStatAS_ID)
        call SetUnitAbilityLevel(c, ErzaR_ArmorStatAS_ID, GetUnitAbilityLevel(c, ErzaR_ID))
        call UnitAddAbility(c, ErzaR_ArmorStatEvade_ID)
        call SetPlayerAbilityAvailable(GetOwningPlayer(c), ErzaR_ArmorStatEvade_ID, false)
        call BlzSetUnitSkin(c, ErzaR_UnitSkin_ID)
        call FixAura(c)
        call SaveInteger(hs, id, sh, 1)
        call BlzSetAbilityIcon(Erza4E_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Erza4_E.blp")
        call ErzaBaseAbiBlock(c , false)
        if LoadInteger(hs, i, ErzaBase__SH_SOUND_CD5) == 0 then
            call SaveInteger(hs, i, ErzaBase__SH_SOUND_CD5, 1)
            call s__GearSystems2___KS_Flush_Start((i ) , ( ErzaBase__SH_SOUND_CD5 ) , ( 0 ) , (( 10)*1.0)) // INLINED!!
            if GetRandomInt(1, 2) == 1 then
                call MakeSound("war3mapImported\\Hero_Erza4_Start")
            else
                call MakeSound("war3mapImported\\Hero_Erza4_Start2")
            endif
        endif
        if GetHeroLevel(c) >= 25 then
        call Erza4F_Start(c)
        endif
        call ErzaAbiArmorAdd(c , Erza4Q_ID , Erza4W_ID , Erza4E_ID , Erza4R_ID , Erza4T_ID , Erza4F_ID , true , GetUnitAbilityLevel(c, ErzaR_ID))
        call DestroyGroup(g)
        set g=null
        set u=null
    endfunction
