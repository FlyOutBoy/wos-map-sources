// Возвращает героя, с которым сейчас должны работать магазин и тестовые клавиши.
// В обычном режиме всегда возвращает Hero[pid].
// Чужие обычные герои и не-герои игнорируются.
function GetSelectedHeroForPlayer takes player p returns unit
    local integer pid= GetPlayerId(p)
    local unit selected= HeroChosen[pid]

    if TestMode and selected != null and IsUnitType(selected, UNIT_TYPE_HERO) then
        if selected == Hero[pid] or selected == TestUnit or selected == TestAllyUnit then
            return selected
        endif
    endif

    return Hero[pid]
endfunction

// Synced: called on every client with the same player. Inside the local
// check there is only the native frame call; everything else runs on every
// client and touches only that player's frames internally.
function HideBottomUI takes player p,boolean b returns nothing
    if GetLocalPlayer() == p then
        call BlzHideOriginFrames(b)
    endif
    call WUI_SetOriginHidden(p , b)
    if not b then
        call WUI_RestoreCompactNative(p)
    endif
endfunction
function HideUIExceptTopMenu takes player p,boolean b returns nothing
    if GetLocalPlayer() == p then
        call BlzHideOriginFrames(b)
    endif
    call WUI_SetOriginHidden(p , b)
    if not b then
        call WUI_RestoreCompactNative(p)
    endif
    // The top bar with the menu buttons stays visible.
    call WUI_ShowNativeMenu(p)
endfunction
function GetStr takes unit c returns integer
local integer i
local integer id= GetPlayerId(GetOwningPlayer(c))
if c != Hero[id] then
set i=GetHeroStr(Hero[id], true)
else
set i=GetHeroStr(c, true)
endif
return i
endfunction 
function GetAgi takes unit c returns integer
local integer i
local integer id= GetPlayerId(GetOwningPlayer(c))
if c != Hero[id] then
set i=GetHeroAgi(Hero[id], true)
else
set i=GetHeroAgi(c, true)
endif
return i
endfunction 
function GetInt takes unit c returns integer
local integer i
local integer id= GetPlayerId(GetOwningPlayer(c))
if c != Hero[id] then
set i=GetHeroInt(Hero[id], true)
else
set i=GetHeroInt(c, true)
endif
return i
endfunction 
function ConvertBTNtoDISBTN takes string path returns string
        local integer len= StringLength(path)
        local integer i= len - 1
        local string name= ""
    // Р СњР В°РЎвЂ¦Р С•Р Т‘Р С‘Р С Р С—Р С•РЎРѓР В»Р ВµР Т‘Р Р…Р С‘Р в„– РЎРѓР В»РЎРЊРЎв‚¬ '\'
        loop
            exitwhen i < 0 or SubString(path, i, i + 1) == "\\"
            set i=i - 1
        endloop
        if i >= 0 then
            set name=SubString(path, i + 1, len) // Р С‘Р СРЎРЏ РЎвЂћР В°Р в„–Р В»Р В° (Р Р…Р В°Р С—РЎР‚Р С‘Р СР ВµРЎР‚ "BTNAttack" Р С‘Р В»Р С‘ "DISBTNAttack")
        else
            set name=path
        endif
    // Р вЂўРЎРѓР В»Р С‘ Р С‘Р СРЎРЏ РЎС“Р В¶Р Вµ Р Р…Р В°РЎвЂЎР С‘Р Р…Р В°Р ВµРЎвЂљРЎРѓРЎРЏ РЎРѓ "DIS", Р Р…Р Вµ Р Т‘Р С•Р В±Р В°Р Р†Р В»РЎРЏР ВµР С Р Р†РЎвЂљР С•РЎР‚Р С•Р в„– РЎР‚Р В°Р В·
        if StringLength(name) >= 3 and SubString(name, 0, 3) == "DIS" then
            return "ReplaceableTextures\\CommandButtonsDisabled\\" + name
        endif
        return "ReplaceableTextures\\CommandButtonsDisabled\\DIS" + name
    endfunction
function IsGamePlayerSlot takes integer pid returns boolean
    return pid >= 0 and pid < 10
endfunction
function IsObserverSlot takes integer pid returns boolean
    return pid >= 10 and pid <= 14
endfunction
function IsActivePlayerSlot takes integer pid returns boolean
    return IsGamePlayerSlot(pid) and GetPlayerSlotState(Player(pid)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(pid)) == MAP_CONTROL_USER
endfunction
function IsActiveObserverSlot takes integer pid returns boolean
    return IsObserverSlot(pid) and GetPlayerSlotState(Player(pid)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(pid)) == MAP_CONTROL_USER
endfunction
function GetStatusColorBySlot takes integer slot returns string
    if slot == 0 then
        return "|c00FF0303"
    elseif slot == 1 then
        return "|c000042FF"
    elseif slot == 2 then
        return "|c001CE6B9"
    elseif slot == 3 then
        return "|c0054007F"
    elseif slot == 4 then
        return "|c00FFFC01"
    elseif slot == 5 then
        return "|c00FF8401"
    elseif slot == 6 then
        return "|c0020C000"
    elseif slot == 7 then
        return "|c00E55BB0"
    elseif slot == 8 then
        return "|c00959697"
    elseif slot == 9 then
        return "|c007EBFF1"
    endif
    return "|c00FFFFFF"
endfunction

function GetPlayerVisualColorString takes player p returns string
    local integer pid= GetPlayerId(p)

    if CaptainMode and CapPickPhase >= 4 then
        return GetStatusColorBySlot(PlayerVisualSlot[pid])
    endif

    return GetStatusColorBySlot(pid)
endfunction
function GetItemById takes unit u,integer itemId returns item
    local integer slot= 0
    local item it

    loop
        exitwhen slot > 5

        set it=UnitItemInSlot(u, slot)

        if GetItemTypeId(it) == itemId then
            return it
        endif

        set slot=slot + 1
    endloop

    return null
endfunction
function IsPlaying takes player p returns boolean
return GetPlayerSlotState(p) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(p) == MAP_CONTROL_USER
endfunction
function IsAllyExist takes player p returns boolean
local boolean b= false
local integer id= GetPlayerId(p)
local integer k= 0
set k=0
loop
 exitwhen k >= 10
if IsPlayerAlly(Player(k), p) and Player(k) != p and IsPlaying(Player(k)) then
set b=true
endif
set k=k + 1
endloop
return b
endfunction
function IsPlaying2 takes player p returns boolean
return GetPlayerSlotState(p) == PLAYER_SLOT_STATE_PLAYING
endfunction
function IsPlaying3 takes player p returns boolean
return Hero[GetPlayerId(p)] != null
endfunction
    function NoDecor_Filter takes nothing returns boolean
        return GetWidgetLife(GetFilterUnit()) > 0.405 and IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false and IsUnitType(GetFilterUnit(), UNIT_TYPE_DEAD) == false and GetUnitAbilityLevel(GetFilterUnit(), 'Avul') == 0
    endfunction
    
function IsItemInInventory takes unit u,integer it returns integer
        local integer i= 0
        local item ti
        local integer count= 0
        loop
            exitwhen i > 5
            set ti=UnitItemInSlot(u, i)
            if GetItemTypeId(ti) == it then
               set count=count + 1
            endif
            set i=i + 1
        endloop
        set ti=null
        return count
    endfunction 

function RegisterShopHero takes integer heroId,integer page,integer slot returns nothing
    if heroId == 0 then
        return
    endif

    set HeroShopRegistry[HeroShopCount]=heroId
    set HeroPickPage[HeroShopCount]=page
    set HeroPickSlot[HeroShopCount]=slot
    set HeroShopCount=HeroShopCount + 1
endfunction

function InitHeroShopRegistry takes nothing returns nothing
    if HeroShopRegistryReady then
        return
    endif

    set HeroShopRegistryReady=true
    set HeroShopCount=0

    // Keep this order stable: it is used by BuildItem and SellItem indexes.
    // Arguments: heroId, pick page, pick slot.
    call RegisterShopHero(Natsu_ID , 3 , 0) // shop 0
    call RegisterShopHero(Raiden_ID , 1 , 0) // shop 1
    call RegisterShopHero(Neuvillette_ID , 1 , 1) // shop 2
    call RegisterShopHero(Akainu_ID , 4 , 0) // shop 3
    call RegisterShopHero(Kyoraku_ID , 2 , 0) // shop 4
    call RegisterShopHero(Erza_ID , 3 , 1) // shop 5
    call RegisterShopHero(Gojo_ID , 5 , 0) // shop 6
    call RegisterShopHero(Tomioka_ID , 6 , 0) // shop 7
    call RegisterShopHero(AlterSaber_ID , 6 , 1) // shop 8
    call RegisterShopHero(Kenjaku_ID , 5 , 1) // shop 9
    call RegisterShopHero(Inori_ID , 6 , 2) // shop 10
    call RegisterShopHero(Okarun_ID , 6 , 3) // shop 11
    call RegisterShopHero(Tsuna_ID , 6 , 4) // shop 12
    call RegisterShopHero(BazzB_ID , 2 , 1) // shop 13
    call RegisterShopHero(Takeshi_ID , 6 , 5) // shop 14
    call RegisterShopHero(DarkShiki_ID , 6 , 6) // shop 15
    call RegisterShopHero(Rimuru_ID , 6 , 7) // shop 16
    call RegisterShopHero(Harribel_ID , 2 , 2) // shop 17
    call RegisterShopHero(Barragan_ID , 2 , 3) // shop 18
    call RegisterShopHero(Starrk_ID , 2 , 4) // shop 19
    call RegisterShopHero(Alucard_ID , 6 , 8) // shop 20
    call RegisterShopHero(Mahoraga_ID , 5 , 2) // shop 21
    call RegisterShopHero(Toji_ID , 5 , 3) // shop 21
    call RegisterShopHero(Kirito_ID , 6 , 9) // shop 22
    call RegisterShopHero(Bambietta_ID , 2 , 5) // shop 23
    call RegisterShopHero(Asta_ID , 6 , 10) // shop 24
    call RegisterShopHero(Patriot_ID , 1 , 2) // shop 25
    call RegisterShopHero(Brandish_ID , 3 , 2) // shop 26    
    call RegisterShopHero(Laxus_ID , 3 , 3) // shop 27    
    call RegisterShopHero(Ainz_ID , 6 , 11) // shop 28      
    call RegisterShopHero(Frieren_ID , 6 , 12) // shop 29
    // HERO TRANSFER: Milim / InitHeroShopRegistry
    call RegisterShopHero(Milim_ID , 6 , 13) // shop 30
    // HERO TRANSFER: Crocodile / InitHeroShopRegistry
    call RegisterShopHero(Crocodile_ID , 4 , 1) // shop 31
    // HERO TRANSFER: Frostnova / InitHeroShopRegistry
    call RegisterShopHero(Frostnova_ID , 1 , 3) // shop 32
endfunction

function SetHeroId takes integer page,integer slot,integer heroId returns nothing
    if page == 1 then
        set Hero_ID0[slot]=heroId
    elseif page == 2 then
        set Hero_ID1[slot]=heroId
    elseif page == 3 then
        set Hero_ID2[slot]=heroId
    elseif page == 4 then
        set Hero_ID3[slot]=heroId
    elseif page == 5 then
        set Hero_ID4[slot]=heroId
    elseif page == 6 then
        set Hero_ID5[slot]=heroId
    endif
endfunction
function GetRegisteredShopHero takes integer shopId returns integer
    call InitHeroShopRegistry()

    if shopId < 0 or shopId >= HeroShopCount then
        return 0
    endif

    return HeroShopRegistry[shopId]
endfunction

function FindRegisteredHeroShopId takes integer heroId returns integer
    local integer shopId= 0

    call InitHeroShopRegistry()

    loop
        exitwhen shopId >= HeroShopCount
        if HeroShopRegistry[shopId] == heroId then
            return shopId
        endif
        set shopId=shopId + 1
    endloop

    return - 1
endfunction

// Compatibility wrapper for old index -> hero calls.
function GetShopId2 takes integer shopId returns integer
    return GetRegisteredShopHero(shopId)
endfunction

// Compatibility wrapper for old hero -> index calls.
// Unlike the old implementation, an unknown hero returns -1 instead of Natsu's index.
function GetShopId takes integer heroId returns integer
    return FindRegisteredHeroShopId(heroId)
endfunction

function RestoreHeroToPick takes integer heroId returns nothing
    local integer shopId= FindRegisteredHeroShopId(heroId)

    if shopId == - 1 then
        return
    endif

    call SetHeroId(HeroPickPage[shopId] , HeroPickSlot[shopId] , heroId)
endfunction

// Compatibility wrapper for the old repick call.
function GetMainId takes integer heroId returns nothing
    call RestoreHeroToPick(heroId)
endfunction




// Register synchronously; only visibility is allowed to differ between clients.
// Hero portrait minimap icons are disabled: heroes keep the stock minimap
// markers (the native display is no longer hidden). Kept as a no-op so the
// existing callers (pick, illusions, Kirito clones, auras) stay valid.
function WOS_RegisterHeroMinimap takes unit u,unit source returns nothing
    local integer index
    local string texture
    if true then
        return
    endif
    if u == null or source == null or GetUnitTypeId(u) == 0 then
        return
    endif
    set index=LoadInteger(WOS_MiniUnits, GetHandleId(u), 0)
    set texture=BlzGetAbilityIcon(GetUnitTypeId(source))
    if texture == null or texture == "" then
        return
    endif
    if index == 0 then
        set WOS_MiniCount=WOS_MiniCount + 1
        set index=WOS_MiniCount
        set WOS_MiniUnit[index]=u
        call SaveInteger(WOS_MiniUnits, GetHandleId(u), 0, index)
    endif
    set WOS_MiniSource[index]=source
    if WOS_MiniTexture[index] != texture then
        if WOS_MiniIcon[index] != null then
            call DestroyMinimapIcon(WOS_MiniIcon[index])
        endif
        set WOS_MiniTexture[index]=texture
        set WOS_MiniIcon[index]=CreateMinimapIconOnUnit(u, 255, 255, 255, texture, FOG_OF_WAR_VISIBLE)
        call SetMinimapIconOrphanDestroy(WOS_MiniIcon[index], false)
        call SetMinimapIconVisible(WOS_MiniIcon[index], false)
    endif
    call BlzSetUnitBooleanField(u, UNIT_BF_HERO_HIDE_HERO_MINIMAP_DISPLAY, true)
    call BlzSetUnitBooleanField(u, UNIT_BF_HIDE_MINIMAP_DISPLAY, true)
endfunction

function WOS_UpdateHeroMinimap takes nothing returns nothing
    local integer index= 1
    local unit u
    local player viewer= GetLocalPlayer()
    local boolean visible
    if WOS_MiniCount == 0 then
        set viewer=null
        return
    endif
    loop
        exitwhen index > WOS_MiniCount
        set u=WOS_MiniUnit[index]
        if GetUnitTypeId(u) == 0 then
            call DestroyMinimapIcon(WOS_MiniIcon[index])
            call RemoveSavedInteger(WOS_MiniUnits, GetHandleId(u), 0)
            set WOS_MiniUnit[index]=WOS_MiniUnit[WOS_MiniCount]
            set WOS_MiniSource[index]=WOS_MiniSource[WOS_MiniCount]
            set WOS_MiniIcon[index]=WOS_MiniIcon[WOS_MiniCount]
            set WOS_MiniTexture[index]=WOS_MiniTexture[WOS_MiniCount]
            if index < WOS_MiniCount then
                call SaveInteger(WOS_MiniUnits, GetHandleId(WOS_MiniUnit[index]), 0, index)
            endif
            set WOS_MiniUnit[WOS_MiniCount]=null
            set WOS_MiniSource[WOS_MiniCount]=null
            set WOS_MiniIcon[WOS_MiniCount]=null
            set WOS_MiniTexture[WOS_MiniCount]=null
            set WOS_MiniCount=WOS_MiniCount - 1
        else
            // Morphs use the source hero's current portrait for every clone too.
            call WOS_RegisterHeroMinimap(u , WOS_MiniSource[index])
            set visible=GetWidgetLife(u) > 0.405 and not IsUnitHidden(u) and IsUnitVisible(u, viewer) and not IsUnitInvisible(u, viewer)
            call SetMinimapIconVisible(WOS_MiniIcon[index], visible)
            set index=index + 1
        endif
    endloop
    set u=null
    set viewer=null
endfunction

// ===== Desync probe =====
// After every hero pick each client records, for 3 seconds, the next free
// handle id and a synced random number (plus game time) and writes them to
// CustomMapData\save\WOS2_desync_probe.txt. Two players' files diverge at the
// first step that allocated handles or used randomness differently.

function WOS_ProbeMark takes string label returns nothing
    local location l= null
    local integer id= 0
    local integer i= 0
    local real sum= 0.00
    if not WOS_DESYNC_PROBE_ENABLED then
        return
    endif
    set l=Location(0.00, 0.00)
    set id=GetHandleId(l)
    call RemoveLocation(l)
    set l=null
    loop
        exitwhen i >= 10
        if Hero[i] != null then
            set sum=sum + GetUnitX(Hero[i]) + GetUnitY(Hero[i]) + GetWidgetLife(Hero[i])
        endif
        set i=i + 1
    endloop
    if WOS_ProbeCount < 1500 then
        call GroupClear(WOS_ProbeGroup)
        call GroupEnumUnitsInRect(WOS_ProbeGroup, bj_mapInitialPlayableArea, null)
        set WOS_ProbeLine[WOS_ProbeCount]=R2SW(WOS_ProbeClock, 1, 2) + " " + label + " h=" + I2S(id) + " r=" + I2S(GetRandomInt(0, 999999)) + " s=" + I2S(R2I(sum)) + " u=" + I2S(CountUnitsInGroup(WOS_ProbeGroup))
        set WOS_ProbeCount=WOS_ProbeCount + 1
    endif
endfunction

function WOS_ProbeDump takes nothing returns nothing
    local integer i= 0
    if not WOS_DESYNC_PROBE_ENABLED then
        return
    endif
    call PreloadGenClear()
    call PreloadGenStart()
    loop
        exitwhen i >= WOS_ProbeCount
        call Preload("\")\n" + WOS_ProbeLine[i] + "\n//")
        set i=i + 1
    endloop
    call PreloadGenEnd("save\\WOS2_desync_probe.txt")
    call PreloadGenClear()
endfunction

// The file is rewritten every second, so it exists even if the game is cut
// off by a desync a moment later.
function WOS_ProbeTick takes nothing returns nothing
    if not WOS_DESYNC_PROBE_ENABLED then
        return
    endif
    set WOS_ProbeClock=WOS_ProbeClock + 0.10
    if WOS_ProbeTicks > 0 then
        set WOS_ProbeTicks=WOS_ProbeTicks - 1
        call WOS_ProbeMark(WOS_ProbeLabel + " +" + I2S(150 - WOS_ProbeTicks))
        // Every 0.1 s during the first 3 s after a pick, then every second.
        if WOS_ProbeTicks >= 120 or ModuloInteger(WOS_ProbeTicks, 10) == 0 then
            call WOS_ProbeDump()
        endif
        if WOS_ProbeTicks == 0 then
            call PauseTimer(WOS_ProbeTimer)
        endif
    endif
endfunction

function WOS_ProbeStart takes string label returns nothing
    if not WOS_DESYNC_PROBE_ENABLED then
        return
    endif
    if WOS_ProbeTimer == null then
        set WOS_ProbeTimer=CreateTimer()
    endif
    // 15 s window per pick: two players' files from the same game diverge at
    // the first line where h (next handle), r (synced random) or u (unit
    // count) differ. Regen re-learns spells at the base every second: the same
    // label only adds a mark and never restarts the window.
    if WOS_ProbeTicks > 0 and label == WOS_ProbeLabel then
        call WOS_ProbeMark(label + " again")
        return
    endif
    call TimerStart(WOS_ProbeTimer, 0.10, true, function WOS_ProbeTick)
    set WOS_ProbeLabel=label
    set WOS_ProbeTicks=150
    call WOS_ProbeMark(label + " start")
    call WOS_ProbeDump()
endfunction

    function InoriE_AuraResistance takes unit u,boolean magic returns real
        local integer rank= 0
        if u == null then
            return 0.0
        endif
        if GetUnitAbilityLevel(u, InoriE_AuraRank6_ID) > 0 then
            return 10.0
        elseif GetUnitAbilityLevel(u, InoriE_Aura_ID) > 0 then
            set rank=5
        elseif GetUnitAbilityLevel(u, InoriE_AuraRank4_ID) > 0 then
            set rank=4
        elseif GetUnitAbilityLevel(u, InoriE_AuraRank3_ID) > 0 then
            set rank=3
        elseif GetUnitAbilityLevel(u, InoriE_AuraRank2_ID) > 0 then
            set rank=2
        elseif GetUnitAbilityLevel(u, InoriE_AuraRank1_ID) > 0 then
            set rank=1
        endif
        if magic and rank > 0 then
            return InoriE_DmgMagResistFromPas
        endif
        return I2R(rank)
    endfunction

    function InoriE_ApplyAuraResistance takes unit u,real amount,integer damageType returns real
        if damageType < 0 or damageType > 2 then
            return amount
        endif
        set amount=amount * ( 1.0 - InoriE_AuraResistance(u , damageType == 1) / 100.0 )
        return amount
    endfunction

    // Flat percentage-point shred after Ainz; it cannot turn resistance negative.
    function InoriT2_ApplyResistDown takes unit u,real amount,real baseAmount returns real
        if amount < baseAmount and GetUnitAbilityLevel(u, InoriT2_AuraBuff_ID) > 0 then
            return RMinBJ(baseAmount, amount + baseAmount * InoriT2_AuraResistDown / 100.0)
        endif
        return amount
    endfunction

    function InoriE_UpdateAura takes unit c returns nothing
        local integer rank= IMinBJ(5, GetUnitAbilityLevel(c, InoriE_ID))
        local integer hid= GetHandleId(c)
        local boolean disabled= LoadInteger(hs, hid, GearSystems__SH_INORI_AURA_MODE_T) == 1 or rank == 0
        if rank > 0 then
            if not disabled and rank == 5 and GetHeroLevel(c) >= 25 and LoadInteger(hs, hid, GearSystems__SH_INORI_AURA_CURRENT_T) != InoriT2_ID then
                set rank=6
            endif
            if GetUnitAbilityLevel(c, InoriEAlt2_ID) != rank then
                call SetUnitAbilityLevel(c, InoriEAlt2_ID, rank)
            endif
        endif
        if not HaveSavedBoolean(hs, hid, GearSystems__SH_INORI_AURA_DISABLED) or LoadBoolean(hs, hid, GearSystems__SH_INORI_AURA_DISABLED) != disabled then
            call SetPlayerAbilityAvailable(GetOwningPlayer(c), InoriEAlt2_ID, not disabled)
            if disabled or HaveSavedBoolean(hs, hid, GearSystems__SH_INORI_AURA_DISABLED) then
                call BlzUnitDisableAbility(c, InoriEAlt2_ID, disabled, disabled)
            endif
            call SaveBoolean(hs, hid, GearSystems__SH_INORI_AURA_DISABLED, disabled)
        endif
    endfunction

