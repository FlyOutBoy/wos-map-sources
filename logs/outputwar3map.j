        function s__TojiSpells___TojiSpells_G_TojiG_Start takes unit NewC,unit NewTd returns nothing
            local integer this
            local integer level
            if NewC == null or NewTd == null or GetWidgetLife(NewTd) <= 0.405 then
                return
            endif
            set this=s__TojiSpells___TojiSpells_G__allocate()
            set s__TojiSpells___TojiSpells_G_MUI_TojiG=s__TojiSpells___TojiSpells_G_MUI_TojiG + 1
