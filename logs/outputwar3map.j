            call SetPlayerAbilityAvailable(Player(s__StarrkSpells___StarrkSpells_T_check2[this]), StarrkT_ID, false)
            call UnitAddAbility(s__StarrkSpells___StarrkSpells_T_c[this], StarrkT2_ID)
            call StartSpellUnit(s__StarrkSpells___StarrkSpells_T_c[this])
            set s__StarrkSpells___StarrkSpells_T_a[this]=GetUnitFacing(s__StarrkSpells___StarrkSpells_T_c[this]) * bj_DEGTORAD // Angle Between points
            call BlzSetUnitFacingEx(s__StarrkSpells___StarrkSpells_T_c[this], s__StarrkSpells___StarrkSpells_T_a[this] * bj_RADTODEG)
            call MakeSound("war3mapimported\\Hero_Starrk_T")
            call MakeSound("war3mapimported\\Hero_Starrk_T2")
            call MakeSound("war3mapimported\\Hero_Starrk_T3")
            set s__StarrkSpells___StarrkSpells_T_dmg[this]=GetHeroAgi(s__StarrkSpells___StarrkSpells_T_c[this], true) * StarrkT_DamageAgiBase
            set s__StarrkSpells___StarrkSpells_T_dmg[this]=s__StarrkSpells___StarrkSpells_T_dmg[this] / 12
            set s__StarrkSpells___StarrkSpells_T_rmax[this]=StarrkT_Duration
            call VisionTimed(GetOwningPlayer(s__StarrkSpells___StarrkSpells_T_c[this]) , s__StarrkSpells___StarrkSpells_T_x[this] , s__StarrkSpells___StarrkSpells_T_y[this] , 1800 , 5)
            if s__StarrkSpells___StarrkSpells_T_MUI_StarrkT == 0 then
                call StarrkSpells___StarrkTick05_On(1)
            endif
        endfunction

        function s__StarrkSpells___StarrkSpells_T_Loop_StarrkT3 takes nothing returns nothing
            local integer this
            local integer i= 0
            local real kek1= 0
            local real kek2= 0
            loop
                exitwhen i > s__StarrkSpells___StarrkSpells_T_MUI_StarrkT3
                set this=s__StarrkSpells___StarrkSpells_T_m_StarrkT3[i]
                // Keep the shared hit group alive for TT/TR wolves already in flight.
                if s__StarrkSpells___StarrkSpells_T_r[this] <= s__StarrkSpells___StarrkSpells_T_rmax[this] and ( s__StarrkSpells___StarrkSpells_T_b[this] or ( SpellBoolCaster(s__StarrkSpells___StarrkSpells_T_c[this]) and FirstOfGroup(s__StarrkSpells___StarrkSpells_T_g2[this]) != null ) ) then
                    set s__StarrkSpells___StarrkSpells_T_r[this]=s__StarrkSpells___StarrkSpells_T_r[this] + 0.05
                    set s__StarrkSpells___StarrkSpells_T_r[this]=RoundReal(s__StarrkSpells___StarrkSpells_T_r[this] , 3)
                    if s__StarrkSpells___StarrkSpells_T_check[this] == 0 then
                        if s__StarrkSpells___StarrkSpells_T_r[this] == 0.05 then
                            call GroupClear(s__StarrkSpells___StarrkSpells_T_g[this])
                            call GroupEnumUnitsOfPlayer(s__StarrkSpells___StarrkSpells_T_g[this], GetOwningPlayer(s__StarrkSpells___StarrkSpells_T_c[this]), null)
                            loop
                                set s__StarrkSpells___StarrkSpells_T_u[this]=FirstOfGroup(s__StarrkSpells___StarrkSpells_T_g[this])
                                exitwhen s__StarrkSpells___StarrkSpells_T_u[this] == null
                                // One T3 order may spend at most ten wolves.
                                if IsUnitInGroup(s__StarrkSpells___StarrkSpells_T_u[this], s__StarrkSpells___StarrkSpells_T_g2[this]) and IsUnitPaused(s__StarrkSpells___StarrkSpells_T_u[this]) == false and s__StarrkSpells___StarrkSpells_T_k[this] < 10 then
                                    call SetUnitFacing(s__StarrkSpells___StarrkSpells_T_u[this], GAngle2(s__StarrkSpells___StarrkSpells_T_u[this] , s__StarrkSpells___StarrkSpells_T_x[this] , s__StarrkSpells___StarrkSpells_T_y[this]) * bj_RADTODEG)
                                    // Do not freeze wolves while TT is being aimed/prepared.
                                    // StarrkT2_Start pauses each wolf only when its attack begins.
                                    call GroupAddUnit(s__StarrkSpells___StarrkSpells_T_g3[this], s__StarrkSpells___StarrkSpells_T_u[this])
                                    call s__GearSystems2___KS_RemoveEffect_MyRemoveEff_Start((AddSpecialEffectTarget("war3mapImported\\wos_Windwalk Blue Soul.mdl", s__StarrkSpells___StarrkSpells_T_u[this], "chest") ) , (( 2.0)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
                                    set s__StarrkSpells___StarrkSpells_T_k[this]=s__StarrkSpells___StarrkSpells_T_k[this] + 1
                                endif
                                call GroupRemoveUnit(s__StarrkSpells___StarrkSpells_T_g[this], s__StarrkSpells___StarrkSpells_T_u[this])
                            endloop
                            set s__StarrkSpells___StarrkSpells_T_u[this]=null
                        endif
                        if s__StarrkSpells___StarrkSpells_T_r[this] == 0.6 then
                            set s__StarrkSpells___StarrkSpells_T_k2[this]=0
                            loop
                                exitwhen s__StarrkSpells___StarrkSpells_T_k2[this] >= s__StarrkSpells___StarrkSpells_T_k[this]
                                set s__StarrkSpells___StarrkSpells_T_td[this]=FirstOfGroup(s__StarrkSpells___StarrkSpells_T_g3[this])
                                if s__StarrkSpells___StarrkSpells_T_td[this] != null then
                                    // Deterministic TT formation: every participating wolf
                                    // gets one evenly spaced point on the configured perimeter.
                                    set kek1=StarrkTT_DamageAoe
                                    set kek2=s__StarrkSpells___StarrkSpells_T_a[this] + ( 360.0 / I2R(s__StarrkSpells___StarrkSpells_T_k[this]) ) * I2R(s__StarrkSpells___StarrkSpells_T_k2[this]) * bj_DEGTORAD
                                    call GroupRemoveUnit(s__StarrkSpells___StarrkSpells_T_g2[this], s__StarrkSpells___StarrkSpells_T_td[this])
                                    call s__StarrkSpells___StarrkSpells_T_StarrkT2_Start(s__StarrkSpells___StarrkSpells_T_c[this] , s__StarrkSpells___StarrkSpells_T_td[this] , null , null , s__StarrkSpells___StarrkSpells_T_x[this] + kek1 * Cos(kek2) , s__StarrkSpells___StarrkSpells_T_y[this] + kek1 * Sin(kek2) , s__StarrkSpells___StarrkSpells_T_g[this] , s__StarrkSpells___StarrkSpells_T_k[this] , 0)
                                    call GroupRemoveUnit(s__StarrkSpells___StarrkSpells_T_g3[this], s__StarrkSpells___StarrkSpells_T_td[this])
                                endif
                                set s__StarrkSpells___StarrkSpells_T_k2[this]=s__StarrkSpells___StarrkSpells_T_k2[this] + 1
                            endloop
                            set s__StarrkSpells___StarrkSpells_T_u[this]=null
                            // Keep g alive while all ten wolves are still travelling.
                            // It is the shared hit group that allows each target only one hit.
                            set s__StarrkSpells___StarrkSpells_T_rmax[this]=s__StarrkSpells___StarrkSpells_T_r[this] + 1.2 + StarrkT3_HitGroupDuration
                            set s__StarrkSpells___StarrkSpells_T_b[this]=true
                            // Resume the normal T loop immediately: remaining wolves can
                            // move and perform their usual automatic attacks.
                            
                    call UnitAddAbility(s__StarrkSpells___StarrkSpells_T_c[this], StarrkF_ID)
                            call SaveInteger(hs, GetHandleId(GetOwningPlayer(s__StarrkSpells___StarrkSpells_T_c[this])), StarrkSpells___SH_WOLF_ULT, 0)
                            call SaveGroupHandle(hs, GetHandleId(s__StarrkSpells___StarrkSpells_T_c[this]), StarrkSpells___SH_WOLF_GROUP, s__StarrkSpells___StarrkSpells_T_g2[this])
                        endif
                    elseif s__StarrkSpells___StarrkSpells_T_check[this] == 1 then
                        if s__StarrkSpells___StarrkSpells_T_r[this] == 0.65 then
                            call MakeSound("war3mapimported\\Hero_Starrk_TR")
                        endif
                        if s__StarrkSpells___StarrkSpells_T_r[this] == 0.05 then
                            call GroupClear(s__StarrkSpells___StarrkSpells_T_g[this])
                            call GroupEnumUnitsOfPlayer(s__StarrkSpells___StarrkSpells_T_g[this], GetOwningPlayer(s__StarrkSpells___StarrkSpells_T_c[this]), null)
                            loop
                                set s__StarrkSpells___StarrkSpells_T_u[this]=FirstOfGroup(s__StarrkSpells___StarrkSpells_T_g[this])
                                exitwhen s__StarrkSpells___StarrkSpells_T_u[this] == null
                                // One T3 order may spend at most ten wolves.
                                if IsUnitInGroup(s__StarrkSpells___StarrkSpells_T_u[this], s__StarrkSpells___StarrkSpells_T_g2[this]) and IsUnitPaused(s__StarrkSpells___StarrkSpells_T_u[this]) == false and s__StarrkSpells___StarrkSpells_T_k[this] < 10 then
                                    // Do not freeze wolves while TR is being aimed/prepared.
                                    // StarrkT2_Start pauses each wolf only when its attack begins.
                                    call GroupAddUnit(s__StarrkSpells___StarrkSpells_T_g3[this], s__StarrkSpells___StarrkSpells_T_u[this])
                                    call s__GearSystems2___KS_RemoveEffect_MyRemoveEff_Start((AddSpecialEffectTarget("war3mapImported\\wos_Windwalk Blue Soul.mdl", s__StarrkSpells___StarrkSpells_T_u[this], "chest") ) , (( 2.0)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
                                    set s__StarrkSpells___StarrkSpells_T_k[this]=s__StarrkSpells___StarrkSpells_T_k[this] + 1
                                endif
                                call GroupRemoveUnit(s__StarrkSpells___StarrkSpells_T_g[this], s__StarrkSpells___StarrkSpells_T_u[this])
                            endloop
                            set s__StarrkSpells___StarrkSpells_T_u[this]=null
                            set s__StarrkSpells___StarrkSpells_T_k2[this]=0
                            call GroupClear(s__StarrkSpells___StarrkSpells_T_g[this])
                            call GroupEnumUnitsOfPlayer(s__StarrkSpells___StarrkSpells_T_g[this], GetOwningPlayer(s__StarrkSpells___StarrkSpells_T_c[this]), null)
                            loop
                                set s__StarrkSpells___StarrkSpells_T_u[this]=FirstOfGroup(s__StarrkSpells___StarrkSpells_T_g[this])
                                exitwhen s__StarrkSpells___StarrkSpells_T_u[this] == null
                                if IsUnitInGroup(s__StarrkSpells___StarrkSpells_T_u[this], s__StarrkSpells___StarrkSpells_T_g3[this]) then
                                    call DestroyEffect(AddSpecialEffectTarget("war3mapimported\\wos_by_wood_k_baozha_2_blue.mdx", s__StarrkSpells___StarrkSpells_T_u[this], "chest"))
                                    set kek2=GetRandomReal(- 25, 5)
                                    call SetUnitPosition(s__StarrkSpells___StarrkSpells_T_u[this], s__StarrkSpells___StarrkSpells_T_x[this] + ( s__StarrkSpells___StarrkSpells_T_aoe[this] + kek2 ) * Cos(360 / s__StarrkSpells___StarrkSpells_T_k[this] * s__StarrkSpells___StarrkSpells_T_k2[this] * bj_DEGTORAD), s__StarrkSpells___StarrkSpells_T_y[this] + ( s__StarrkSpells___StarrkSpells_T_aoe[this] + kek2 ) * Sin(360 / s__StarrkSpells___StarrkSpells_T_k[this] * s__StarrkSpells___StarrkSpells_T_k2[this] * bj_DEGTORAD))
                                    call SetUnitFacing(s__StarrkSpells___StarrkSpells_T_u[this], 360 / s__StarrkSpells___StarrkSpells_T_k[this] * s__StarrkSpells___StarrkSpells_T_k2[this])
                                    set s__StarrkSpells___StarrkSpells_T_k2[this]=s__StarrkSpells___StarrkSpells_T_k2[this] + 1
                                endif
                                call GroupRemoveUnit(s__StarrkSpells___StarrkSpells_T_g[this], s__StarrkSpells___StarrkSpells_T_u[this])
                            endloop
                            set s__StarrkSpells___StarrkSpells_T_u[this]=null
                        endif
                        if s__StarrkSpells___StarrkSpells_T_r[this] == 1.2 then
                            call UnitRemoveAbility(s__StarrkSpells___StarrkSpells_T_c[this], 'Avul')
                            call PauseUnit(s__StarrkSpells___StarrkSpells_T_c[this], false)
                            set s__StarrkSpells___StarrkSpells_T_k2[this]=0
                            loop
                                exitwhen s__StarrkSpells___StarrkSpells_T_k2[this] >= s__StarrkSpells___StarrkSpells_T_k[this]
                                set s__StarrkSpells___StarrkSpells_T_td[this]=FirstOfGroup(s__StarrkSpells___StarrkSpells_T_g3[this])
                                if s__StarrkSpells___StarrkSpells_T_td[this] != null then
                                    set kek1=GetRandomReal(650, 1000)
                                    set kek2=GetUnitFacing(s__StarrkSpells___StarrkSpells_T_td[this]) * bj_DEGTORAD //GetRandomReal(0, 359) * bj_DEGTORAD
                                    call GroupRemoveUnit(s__StarrkSpells___StarrkSpells_T_g2[this], s__StarrkSpells___StarrkSpells_T_td[this])
                                    call s__StarrkSpells___StarrkSpells_T_StarrkT2_Start(s__StarrkSpells___StarrkSpells_T_c[this] , s__StarrkSpells___StarrkSpells_T_td[this] , null , null , s__StarrkSpells___StarrkSpells_T_x[this] + kek1 * Cos(GetUnitFacing(s__StarrkSpells___StarrkSpells_T_td[this]) * bj_DEGTORAD) , s__StarrkSpells___StarrkSpells_T_y[this] + kek1 * Sin(GetUnitFacing(s__StarrkSpells___StarrkSpells_T_td[this]) * bj_DEGTORAD) , s__StarrkSpells___StarrkSpells_T_g[this] , s__StarrkSpells___StarrkSpells_T_k[this] , 1)
                                    call GroupRemoveUnit(s__StarrkSpells___StarrkSpells_T_g3[this], s__StarrkSpells___StarrkSpells_T_td[this])
                                endif
                                set s__StarrkSpells___StarrkSpells_T_k2[this]=s__StarrkSpells___StarrkSpells_T_k2[this] + 1
                            endloop
                            set s__StarrkSpells___StarrkSpells_T_u[this]=null
                            call SaveGroupHandle(hs, GetHandleId(s__StarrkSpells___StarrkSpells_T_c[this]), StarrkSpells___SH_WOLF_GROUP, s__StarrkSpells___StarrkSpells_T_g2[this])
                            call UnitAddAbility(s__StarrkSpells___StarrkSpells_T_c[this], StarrkF_ID)
                    
                            // Keep g alive while all ten wolves are still travelling.
                            // It is the shared hit group that allows each target only one hit.
                            set s__StarrkSpells___StarrkSpells_T_rmax[this]=s__StarrkSpells___StarrkSpells_T_r[this] + 1.2 + StarrkT3_HitGroupDuration
                            set s__StarrkSpells___StarrkSpells_T_b[this]=true
                            // Resume the normal T loop immediately: remaining wolves can
                            // move and perform their usual automatic attacks.
                            call SaveInteger(hs, GetHandleId(GetOwningPlayer(s__StarrkSpells___StarrkSpells_T_c[this])), StarrkSpells___SH_WOLF_ULT, 0)
                        endif
                    endif
                else
                    call DestroyGroup(s__StarrkSpells___StarrkSpells_T_g3[this])
                    call StopSpellUnit(s__StarrkSpells___StarrkSpells_T_c[this])
                    set s__StarrkSpells___StarrkSpells_T_g3[this]=null
                    call SaveInteger(hs, GetHandleId(GetOwningPlayer(s__StarrkSpells___StarrkSpells_T_c[this])), StarrkSpells___SH_WOLF_ULT, 0)
                    // T is still running: make both T3 orders available again.
                    if LoadInteger(hs, GetHandleId(s__StarrkSpells___StarrkSpells_T_c[this]), StarrkSpells___SH_STARK_T) == 1 then
                    //    call SetPlayerAbilityAvailable(Player(check2), StarrkR3_ID, true)
                   //     call SetPlayerAbilityAvailable(Player(check2), StarrkT2_ID, true)
                    endif
                    call DestroyGroup(s__StarrkSpells___StarrkSpells_T_g[this])
                    set s__StarrkSpells___StarrkSpells_T_g[this]=null
                    set s__StarrkSpells___StarrkSpells_T_td[this]=null
                    set s__StarrkSpells___StarrkSpells_T_c[this]=null
                    set s__StarrkSpells___StarrkSpells_T_m_StarrkT3[i]=s__StarrkSpells___StarrkSpells_T_m_StarrkT3[s__StarrkSpells___StarrkSpells_T_MUI_StarrkT3]
                    set s__StarrkSpells___StarrkSpells_T_MUI_StarrkT3=s__StarrkSpells___StarrkSpells_T_MUI_StarrkT3 - 1
                    set i=i - 1 // revisit: the moved instance must not skip this tick
                    if s__StarrkSpells___StarrkSpells_T_MUI_StarrkT3 == - 1 then
                        call StarrkSpells___StarrkTick05_Off(2)
                    endif
                    call s__StarrkSpells___StarrkSpells_T_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction

        function s__StarrkSpells___StarrkSpells_T_StarrkT3_Start takes unit NewC,real NewX,real NewY,integer NewK returns nothing
            local integer this= s__StarrkSpells___StarrkSpells_T__allocate()
            set s__StarrkSpells___StarrkSpells_T_MUI_StarrkT3=s__StarrkSpells___StarrkSpells_T_MUI_StarrkT3 + 1
            set s__StarrkSpells___StarrkSpells_T_m_StarrkT3[s__StarrkSpells___StarrkSpells_T_MUI_StarrkT3]=this
            set s__StarrkSpells___StarrkSpells_T_c[this]=NewC
            set s__StarrkSpells___StarrkSpells_T_x[this]=NewX
            set s__StarrkSpells___StarrkSpells_T_y[this]=NewY
            set s__StarrkSpells___StarrkSpells_T_k[this]=0
            set s__StarrkSpells___StarrkSpells_T_check[this]=NewK
            set s__StarrkSpells___StarrkSpells_T_aoe[this]=300
            set s__StarrkSpells___StarrkSpells_T_r[this]=0
            set s__StarrkSpells___StarrkSpells_T_b[this]=false
            set s__StarrkSpells___StarrkSpells_T_g2[this]=LoadGroupHandle(hs, GetHandleId(s__StarrkSpells___StarrkSpells_T_c[this]), StarrkSpells___SH_WOLF_GROUP)
            set s__StarrkSpells___StarrkSpells_T_g3[this]=CreateGroup()
            set s__StarrkSpells___StarrkSpells_T_g[this]=CreateGroup()
                    call UnitRemoveAbility(s__StarrkSpells___StarrkSpells_T_c[this], StarrkF_ID)
            set s__StarrkSpells___StarrkSpells_T_a[this]=GAngle2(s__StarrkSpells___StarrkSpells_T_c[this] , s__StarrkSpells___StarrkSpells_T_x[this] , s__StarrkSpells___StarrkSpells_T_y[this]) // Angle Between points
            set s__StarrkSpells___StarrkSpells_T_check2[this]=GetPlayerId(GetOwningPlayer(s__StarrkSpells___StarrkSpells_T_c[this]))
            // T remains active. Disable both T3 buttons only while this order runs.
            call SetPlayerAbilityAvailable(Player(s__StarrkSpells___StarrkSpells_T_check2[this]), StarrkR3_ID, false)
            call SetPlayerAbilityAvailable(Player(s__StarrkSpells___StarrkSpells_T_check2[this]), StarrkT2_ID, false)
            if s__StarrkSpells___StarrkSpells_T_check[this] == 0 then
                call MakeSound("war3mapimported\\Hero_Starrk_TT2")
            else
               call StartSpellUnit(s__StarrkSpells___StarrkSpells_T_c[this])
            endif
            call MakeSound("war3mapimported\\Hero_Starrk_TT1")
            call SaveInteger(hs, GetHandleId(GetOwningPlayer(s__StarrkSpells___StarrkSpells_T_c[this])), StarrkSpells___SH_WOLF_ULT, 1)
            set s__StarrkSpells___StarrkSpells_T_rmax[this]=8
            if s__StarrkSpells___StarrkSpells_T_check[this] == 0 then
                call VisionTimed(GetOwningPlayer(s__StarrkSpells___StarrkSpells_T_c[this]) , s__StarrkSpells___StarrkSpells_T_x[this] , s__StarrkSpells___StarrkSpells_T_y[this] , StarrkTT_DamageAoe + StarrkT_DamageAoe , 3)
            else
                call VisionTimed(GetOwningPlayer(s__StarrkSpells___StarrkSpells_T_c[this]) , s__StarrkSpells___StarrkSpells_T_x[this] , s__StarrkSpells___StarrkSpells_T_y[this] , 1600 , 3)
            endif
            if s__StarrkSpells___StarrkSpells_T_MUI_StarrkT3 == 0 then
                call StarrkSpells___StarrkTick05_On(2)
            endif
        endfunction


    //----------------------------Starrk-----------------------------------------------
      

    // UI clock follows the actual six independently expiring stat abilities.
        // The 0.03 listener is registered with the first tracked Starrk.

        function s__StarrkSpells___Starrk_StackMeter_loopUI takes nothing returns nothing
            local integer pid= 0
            local unit u
            local real remaining
            local string stacks
            set s__StarrkSpells___Starrk_StackMeter_uiTick=s__StarrkSpells___Starrk_StackMeter_uiTick + 0.03
            if s__StarrkSpells___Starrk_StackMeter_uiTick < 0.12 then
                return
            endif
            set s__StarrkSpells___Starrk_StackMeter_uiTick=0.0
            loop
                exitwhen pid >= 12
                set u=s__StarrkSpells___Starrk_StackMeter_tracked[pid]
                if u != null then
                    set stacks=TasAbilityChargeBox_GetValue(u , StarrkG_ID)
                    if GetUnitTypeId(u) == 0 or Hero[pid] != u or stacks == "" then
                        call WOSUI___WUI_TestHeroProgress((u ) , ( StarrkG_ID ) , ( "Agility stacks" ) , (( 0.00 )*1.0) , (( 0.00 )*1.0) , ( true) , "") // INLINED!!
                        set s__StarrkSpells___Starrk_StackMeter_tracked[pid]=null
                        set s__StarrkSpells___Starrk_StackMeter_count=s__StarrkSpells___Starrk_StackMeter_count - 1
                        if s__StarrkSpells___Starrk_StackMeter_count == 0 then
                            call GearTimer03Release()
                        endif
                    else
                        set remaining=GearAbilityTimeRemaining(u , Starrk_Pas1ID)
                        set remaining=RMaxBJ(remaining, GearAbilityTimeRemaining(u , Starrk_Pas2ID))
                        set remaining=RMaxBJ(remaining, GearAbilityTimeRemaining(u , Starrk_Pas3ID))
                        set remaining=RMaxBJ(remaining, GearAbilityTimeRemaining(u , Starrk_Pas4ID))
                        set remaining=RMaxBJ(remaining, GearAbilityTimeRemaining(u , Starrk_Pas5ID))
                        set remaining=RMaxBJ(remaining, GearAbilityTimeRemaining(u , Starrk_Pas6ID))
                        set remaining=RMaxBJ(remaining, GearAbilityTimeRemaining(u , Starrk_Pas7ID))
                        call WOSUI___WUI_TestHeroProgress((u ) , ( StarrkG_ID ) , ( "Agility: " + stacks + " stacks" ) , (( remaining )*1.0) , (( StarkG_TimeStatAdd )*1.0) , ( true) , "") // INLINED!!
                    endif
                endif
                set pid=pid + 1
            endloop
            set u=null
        endfunction

        function s__StarrkSpells___Starrk_StackMeter_listener03 takes nothing returns boolean
            call s__StarrkSpells___Starrk_StackMeter_loopUI()
            return false
        endfunction

        function s__StarrkSpells___Starrk_StackMeter_track takes unit u returns nothing
            local integer pid= GetPlayerId(GetOwningPlayer(u))
            if pid >= 12 or Hero[pid] != u then
                return
            endif
            if not s__StarrkSpells___Starrk_StackMeter_listenerOn then
                set s__StarrkSpells___Starrk_StackMeter_listenerOn=true
                call TriggerAddCondition(GearTimer03Listeners, Condition(function s__StarrkSpells___Starrk_StackMeter_listener03))
            endif
            if s__StarrkSpells___Starrk_StackMeter_tracked[pid] == null then
                set s__StarrkSpells___Starrk_StackMeter_count=s__StarrkSpells___Starrk_StackMeter_count + 1
                if s__StarrkSpells___Starrk_StackMeter_count == 1 then
                    call GearTimer03Acquire()
                endif
            endif
            set s__StarrkSpells___Starrk_StackMeter_tracked[pid]=u
            call WOSUI___WUI_TestHeroProgress((u ) , ( StarrkG_ID ) , ( "Agility stacks" ) , (( StarkG_TimeStatAdd )*1.0) , (( StarkG_TimeStatAdd )*1.0) , ( true) , "") // INLINED!!
        endfunction


    function StarrkPas takes unit c returns nothing
        local group g= CreateGroup()
        local unit u= null
        local real x= GetUnitX(c)
        local real y= GetUnitY(c)
        local real aoe= 0
        local real scale= StarkG_Restore12
        local integer lvl= GetHeroLevel(c)
        local real hp= GetUnitState(c, UNIT_STATE_MAX_LIFE) * 0.01
        local real mp= GetUnitState(c, UNIT_STATE_MAX_MANA) * 0.01
        local boolean b= false
        local integer check= 0
        if lvl >= 12 then
            if lvl >= 35 then
                set aoe=StarkG_Aoe35
                set scale=StarkG_Restore35
            elseif lvl >= 25 then
                set aoe=StarkG_Aoe25
                set scale=StarkG_Restore25
            else
                set aoe=StarkG_Aoe12
            endif
            call GroupEnumUnitsInRange(g, x, y, aoe, null)
            loop
                set u=FirstOfGroup(g)
                exitwhen u == null
                if IsUnitAlly(u, GetOwningPlayer(c)) and GetOwningPlayer(u) != Player(PLAYER_NEUTRAL_PASSIVE) and u != c then
                    set check=check + 1
                endif
                call GroupRemoveUnit(g, u)
            endloop
            if check == 0 then
                set b=true
            endif
            if b == true then
                if GetUnitAbilityLevel(c, Starrk_Pas1ID) == 0 then
                    call UnitAddAbility(c, Starrk_Pas1ID)
                    call SaveBoolean(hs, GetHandleId((c )), GearKey(GEAR_KEY_WATCH_ABILITY_TIME , "watch ability time " , ( Starrk_Pas1ID)), true) // INLINED!!
                    call s__GearSystems2___KS_RemoveAbility_RemoveAbility_Start((c ) , (( StarkG_TimeStatAdd )*1.0) , ( Starrk_Pas1ID ) , ( 1)) // INLINED!!
                elseif GetUnitAbilityLevel(c, Starrk_Pas2ID) == 0 then
                    call UnitAddAbility(c, Starrk_Pas2ID)
                    call SaveBoolean(hs, GetHandleId((c )), GearKey(GEAR_KEY_WATCH_ABILITY_TIME , "watch ability time " , ( Starrk_Pas2ID)), true) // INLINED!!
                    call s__GearSystems2___KS_RemoveAbility_RemoveAbility_Start((c ) , (( StarkG_TimeStatAdd )*1.0) , ( Starrk_Pas2ID ) , ( 1)) // INLINED!!
                elseif GetUnitAbilityLevel(c, Starrk_Pas3ID) == 0 then
                    call UnitAddAbility(c, Starrk_Pas3ID)
                    call SaveBoolean(hs, GetHandleId((c )), GearKey(GEAR_KEY_WATCH_ABILITY_TIME , "watch ability time " , ( Starrk_Pas3ID)), true) // INLINED!!
                    call s__GearSystems2___KS_RemoveAbility_RemoveAbility_Start((c ) , (( StarkG_TimeStatAdd )*1.0) , ( Starrk_Pas3ID ) , ( 1)) // INLINED!!
                elseif GetUnitAbilityLevel(c, Starrk_Pas4ID) == 0 and lvl >= 25 then
                    call UnitAddAbility(c, Starrk_Pas4ID)
                    call SaveBoolean(hs, GetHandleId((c )), GearKey(GEAR_KEY_WATCH_ABILITY_TIME , "watch ability time " , ( Starrk_Pas4ID)), true) // INLINED!!
                    call s__GearSystems2___KS_RemoveAbility_RemoveAbility_Start((c ) , (( StarkG_TimeStatAdd )*1.0) , ( Starrk_Pas4ID ) , ( 1)) // INLINED!!
                elseif GetUnitAbilityLevel(c, Starrk_Pas5ID) == 0 and lvl >= 25 then
                    call UnitAddAbility(c, Starrk_Pas5ID)
                    call SaveBoolean(hs, GetHandleId((c )), GearKey(GEAR_KEY_WATCH_ABILITY_TIME , "watch ability time " , ( Starrk_Pas5ID)), true) // INLINED!!
                    call s__GearSystems2___KS_RemoveAbility_RemoveAbility_Start((c ) , (( StarkG_TimeStatAdd )*1.0) , ( Starrk_Pas5ID ) , ( 1)) // INLINED!!
                elseif GetUnitAbilityLevel(c, Starrk_Pas6ID) == 0 and lvl >= 35 then
                    call UnitAddAbility(c, Starrk_Pas6ID)
                    call SaveBoolean(hs, GetHandleId((c )), GearKey(GEAR_KEY_WATCH_ABILITY_TIME , "watch ability time " , ( Starrk_Pas6ID)), true) // INLINED!!
                    call s__GearSystems2___KS_RemoveAbility_RemoveAbility_Start((c ) , (( StarkG_TimeStatAdd )*1.0) , ( Starrk_Pas6ID ) , ( 1)) // INLINED!!
                elseif GetUnitAbilityLevel(c, Starrk_Pas7ID) == 0 and lvl >= 35 then
                    call UnitAddAbility(c, Starrk_Pas7ID)
                    call SaveBoolean(hs, GetHandleId((c )), GearKey(GEAR_KEY_WATCH_ABILITY_TIME , "watch ability time " , ( Starrk_Pas7ID)), true) // INLINED!!
                    call s__GearSystems2___KS_RemoveAbility_RemoveAbility_Start((c ) , (( StarkG_TimeStatAdd )*1.0) , ( Starrk_Pas7ID ) , ( 1)) // INLINED!!
                endif
                call s__StarrkSpells___Starrk_StackMeter_track(c)
                call SetHpCurrent2Quiet(c , c , hp * scale)
                call SetMpCurrentQuiet(c , mp * scale)
                call DestroyEffect(AddSpecialEffectTarget("war3mapimported\\wos_longskill_point_39.mdx", c, "origin"))
            endif
        endif
        call DestroyGroup(g)
        set u=null
        set g=null
    endfunction
