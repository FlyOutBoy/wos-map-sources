            call DestroyEffect(EffectSpawn("war3mapimported\\wos_opdef (425).mdx" , s__PatriotSpells___PatriotSpells_T2_x1[this] , s__PatriotSpells___PatriotSpells_T2_y1[this] , GetRandomReal(0, 359) , 0.60 , 0.50 , 0.0))
            call DestroyEffect(EffectSpawnColor("war3mapimported\\wos_3yue_5.mdl" , s__PatriotSpells___PatriotSpells_T2_x1[this] , s__PatriotSpells___PatriotSpells_T2_y1[this] , GetRandomReal(0, 359) , 1.0 , 0.60 , 0.0 , 255 , 255 , 255 , 125))
            call DestroyEffect(EffectSpawnColor("war3mapimported\\wos_3yue_5.mdl" , s__PatriotSpells___PatriotSpells_T2_x1[this] , s__PatriotSpells___PatriotSpells_T2_y1[this] , GetRandomReal(0, 359) , 1.0 , 0.80 , 0.0 , 255 , 255 , 255 , 125))
            set s__PatriotSpells___PatriotSpells_T2_e2[this]=AddSpecialEffectTarget("war3mapimported\\wos_ChuShou_BY_Wood_Effect_Glow_GuiPaiQiGong_XuLiRed.mdx", s__PatriotSpells___PatriotSpells_T2_c[this], "hand right")
            call VisionTimed(GetOwningPlayer(s__PatriotSpells___PatriotSpells_T2_c[this]) , s__PatriotSpells___PatriotSpells_T2_x[this] , s__PatriotSpells___PatriotSpells_T2_y[this] , s__PatriotSpells___PatriotSpells_T2_aoe[this] * 2.0 , 2.0)
            set s__PatriotSpells___PatriotSpells_T2_e3[this]=EffectSpawn("war3mapImported\\wos_[tx] (381).mdl" , s__PatriotSpells___PatriotSpells_T2_x1[this] , s__PatriotSpells___PatriotSpells_T2_y1[this] , 1.0 , 1.0 , 0.01 , 3.0)
            call ScaleEffDummy(s__PatriotSpells___PatriotSpells_T2_e3[this] , s__PatriotSpells___PatriotSpells_T2_r5[this] , 0.01 , s__PatriotSpells___PatriotSpells_T2_scale[this])
            call BlzSetSpecialEffectAlpha(s__PatriotSpells___PatriotSpells_T2_e3[this], 0)
            if GetLocalPlayer() == GetOwningPlayer(s__PatriotSpells___PatriotSpells_T2_c[this]) then
                call BlzSetSpecialEffectAlpha(s__PatriotSpells___PatriotSpells_T2_e3[this], 255)
            endif
            
            if s__PatriotSpells___PatriotSpells_T2_MUI_PatriotT2 == 0 then
                call PatriotSpells___PatriotTimer03Acquire()
            endif
        endfunction



        function s__PatriotSpells___PatriotSpells_F_Loop_PatriotF takes nothing returns nothing
            local integer i= 0
            local integer this
            local unit u
            local boolean remove

            loop
                exitwhen i > s__PatriotSpells___PatriotSpells_F_MUI_PatriotF
                set this=s__PatriotSpells___PatriotSpells_F_m_PatriotF[i]
                call WOSUI___WUI_TestHeroProgress((s__PatriotSpells___PatriotSpells_F_c[this] ) , ( PatriotF_ID ) , ( "March on" ) , (( s__PatriotSpells___PatriotSpells_F_rmax[this] - s__PatriotSpells___PatriotSpells_F_r[this] )*1.0) , (( s__PatriotSpells___PatriotSpells_F_rmax[this] )*1.0) , ( true) , "") // INLINED!!
                set remove=false

                if s__PatriotSpells___PatriotSpells_F_c[this] == null or GetUnitTypeId(s__PatriotSpells___PatriotSpells_F_c[this]) == 0 or s__PatriotSpells___PatriotSpells_F_r[this] >= s__PatriotSpells___PatriotSpells_F_rmax[this] or not SpellBool(s__PatriotSpells___PatriotSpells_F_c[this]) or LoadInteger(hs, GetHandleId(s__PatriotSpells___PatriotSpells_F_c[this]), PatriotSpells___SH_STOP_R) != 0 then
                    set remove=true
                else
                    set s__PatriotSpells___PatriotSpells_F_r[this]=I2R(R2I(( s__PatriotSpells___PatriotSpells_F_r[this] + 0.03 ) * 1000.0 + 0.5)) / 1000.0
                    call DebugUnit2(s__PatriotSpells___PatriotSpells_F_c[this])

                    if s__PatriotSpells___PatriotSpells_F_r[this] == 0.60 then
                        call SetUnitTimeScale(s__PatriotSpells___PatriotSpells_F_c[this], 0.0)
                    endif

                    set s__PatriotSpells___PatriotSpells_F_x[this]=GetMouseX(GetOwningPlayer(s__PatriotSpells___PatriotSpells_F_c[this]))
                    set s__PatriotSpells___PatriotSpells_F_y[this]=GetMouseY(GetOwningPlayer(s__PatriotSpells___PatriotSpells_F_c[this]))
                    set s__PatriotSpells___PatriotSpells_F_a[this]=GAngle4(s__PatriotSpells___PatriotSpells_F_x1[this] , s__PatriotSpells___PatriotSpells_F_y1[this] , s__PatriotSpells___PatriotSpells_F_x[this] , s__PatriotSpells___PatriotSpells_F_y[this])
                    if SR0(s__PatriotSpells___PatriotSpells_F_x1[this] , s__PatriotSpells___PatriotSpells_F_y1[this] , s__PatriotSpells___PatriotSpells_F_x[this] , s__PatriotSpells___PatriotSpells_F_y[this]) > s__PatriotSpells___PatriotSpells_F_scale2[this] then
                        set s__PatriotSpells___PatriotSpells_F_x[this]=s__PatriotSpells___PatriotSpells_F_x1[this] + s__PatriotSpells___PatriotSpells_F_scale2[this] * Cos(s__PatriotSpells___PatriotSpells_F_a[this])
                        set s__PatriotSpells___PatriotSpells_F_y[this]=s__PatriotSpells___PatriotSpells_F_y1[this] + s__PatriotSpells___PatriotSpells_F_scale2[this] * Sin(s__PatriotSpells___PatriotSpells_F_a[this])
                    endif

                    if SR3(s__PatriotSpells___PatriotSpells_F_c[this] , s__PatriotSpells___PatriotSpells_F_x[this] , s__PatriotSpells___PatriotSpells_F_y[this]) > s__PatriotSpells___PatriotSpells_F_move[this] then
                        call MoveUnit(s__PatriotSpells___PatriotSpells_F_c[this] , s__PatriotSpells___PatriotSpells_F_move[this] , GAngle2(s__PatriotSpells___PatriotSpells_F_c[this] , s__PatriotSpells___PatriotSpells_F_x[this] , s__PatriotSpells___PatriotSpells_F_y[this]))
                        call SetUnitFacing(s__PatriotSpells___PatriotSpells_F_c[this], GAngle2(s__PatriotSpells___PatriotSpells_F_c[this] , s__PatriotSpells___PatriotSpells_F_x[this] , s__PatriotSpells___PatriotSpells_F_y[this]) * bj_RADTODEG)
                    else
                        call PosUnit(s__PatriotSpells___PatriotSpells_F_c[this] , s__PatriotSpells___PatriotSpells_F_x[this] , s__PatriotSpells___PatriotSpells_F_y[this])
                    endif

                    set s__PatriotSpells___PatriotSpells_F_x[this]=GetUnitX(s__PatriotSpells___PatriotSpells_F_c[this])
                    set s__PatriotSpells___PatriotSpells_F_y[this]=GetUnitY(s__PatriotSpells___PatriotSpells_F_c[this])

                    if s__PatriotSpells___PatriotSpells_F_r3[this] > 0.21 then
                        set s__PatriotSpells___PatriotSpells_F_r3[this]=0.0
                        call DecorRemove(s__PatriotSpells___PatriotSpells_F_c[this] , s__PatriotSpells___PatriotSpells_F_x[this] , s__PatriotSpells___PatriotSpells_F_y[this] , s__PatriotSpells___PatriotSpells_F_aoe[this] , PatriotF_DecorDamage)
                        call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_BY_Wood_Effect_Kula_2_YiYingCun2.mdl" , s__PatriotSpells___PatriotSpells_F_x[this] + 250.0 * Cos(s__PatriotSpells___PatriotSpells_F_a[this]) , s__PatriotSpells___PatriotSpells_F_y[this] + 250.0 * Sin(s__PatriotSpells___PatriotSpells_F_a[this]) , s__PatriotSpells___PatriotSpells_F_a[this] * bj_RADTODEG , 0.95 , 3.25 , 50.0 , 255 , 255 , 255 , 190))
                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_krk (1971).mdl" , s__PatriotSpells___PatriotSpells_F_x[this] , s__PatriotSpells___PatriotSpells_F_y[this] , GetRandomReal(0, 359) , 0.90 , 1.0 , 1.0))
                    else
                        set s__PatriotSpells___PatriotSpells_F_r3[this]=s__PatriotSpells___PatriotSpells_F_r3[this] + 0.03
                    endif

                    if GetHeroLevel(s__PatriotSpells___PatriotSpells_F_c[this]) >= 25 then
                        call DebuffClear(s__PatriotSpells___PatriotSpells_F_c[this])
                    endif

                    if s__PatriotSpells___PatriotSpells_F_r2[this] > 0.12 then
                        set s__PatriotSpells___PatriotSpells_F_r2[this]=0.0
                        call GroupEnumUnitsInRange(s__PatriotSpells___PatriotSpells_F_g[this], s__PatriotSpells___PatriotSpells_F_x[this], s__PatriotSpells___PatriotSpells_F_y[this], s__PatriotSpells___PatriotSpells_F_aoe[this], NoDecor_Cond)
                        loop
                            set u=FirstOfGroup(s__PatriotSpells___PatriotSpells_F_g[this])
                            exitwhen u == null
                            if IsUnitEnemy(u, GetOwningPlayer(s__PatriotSpells___PatriotSpells_F_c[this])) and SpellBool(u) and SR2(s__PatriotSpells___PatriotSpells_F_c[this] , u) < 250.0 then
                                call MUE(u , 250.0 , 0.30 , s__PatriotSpells___PatriotSpells_F_a[this])
                            endif
                            if GetHeroLevel(s__PatriotSpells___PatriotSpells_F_c[this]) >= 35 then
                                if IsUnitAlly(u, GetOwningPlayer(s__PatriotSpells___PatriotSpells_F_c[this])) and SpellBool(u) and GetUnitAbilityLevel(u, PatriotF_Buff1_ID) == 0 and GetUnitAbilityLevel(u, PatriotF_Buff2_ID) == 0 then
                                    if s__PatriotSpells___PatriotSpells_F_c[this] == u then
                                        call BuffUnit1(s__PatriotSpells___PatriotSpells_F_c[this] , u , 13)
                                    else
                                        call BuffUnit1(s__PatriotSpells___PatriotSpells_F_c[this] , u , 14)
                                    endif
                                endif
                            else
                                call BuffUnit1(s__PatriotSpells___PatriotSpells_F_c[this] , s__PatriotSpells___PatriotSpells_F_c[this] , 13)
                            endif
                            call GroupRemoveUnit(s__PatriotSpells___PatriotSpells_F_g[this], u)
                        endloop
                    else
                        set s__PatriotSpells___PatriotSpells_F_r2[this]=s__PatriotSpells___PatriotSpells_F_r2[this] + 0.03
                    endif
                endif

                if remove then
                    if s__PatriotSpells___PatriotSpells_F_c[this] != null and GetUnitTypeId(s__PatriotSpells___PatriotSpells_F_c[this]) != 0 then
                        call StopSpellUnit2(s__PatriotSpells___PatriotSpells_F_c[this])
                        call SaveInteger(hs, GetHandleId(s__PatriotSpells___PatriotSpells_F_c[this]), PatriotSpells___SH_STOP_R, 0)
                        call SaveInteger(hs, GetHandleId(s__PatriotSpells___PatriotSpells_F_c[this]), PatriotSpells___SH_CAST_R, 0)
                        call SetUnitTimeScale(s__PatriotSpells___PatriotSpells_F_c[this], 1.0)
                        call MouseOff(GetOwningPlayer(s__PatriotSpells___PatriotSpells_F_c[this]))
                    endif
                    if s__PatriotSpells___PatriotSpells_F_g[this] != null then
                        call DestroyGroup(s__PatriotSpells___PatriotSpells_F_g[this])
                    endif
                    set s__PatriotSpells___PatriotSpells_F_g[this]=null
                    set s__PatriotSpells___PatriotSpells_F_c[this]=null
                    set u=null
                    set s__PatriotSpells___PatriotSpells_F_m_PatriotF[i]=s__PatriotSpells___PatriotSpells_F_m_PatriotF[s__PatriotSpells___PatriotSpells_F_MUI_PatriotF]
                    set s__PatriotSpells___PatriotSpells_F_MUI_PatriotF=s__PatriotSpells___PatriotSpells_F_MUI_PatriotF - 1
                    call s__PatriotSpells___PatriotSpells_F_deallocate(this)
                    set i=i - 1
                    if s__PatriotSpells___PatriotSpells_F_MUI_PatriotF == - 1 then
                        call PatriotSpells___PatriotTimer03Release()
                    endif
                endif
                set i=i + 1
            endloop
            set u=null
        endfunction

        function s__PatriotSpells___PatriotSpells_F_PatriotF_Start takes unit NewC returns nothing
            local integer this= s__PatriotSpells___PatriotSpells_F__allocate()
            set s__PatriotSpells___PatriotSpells_F_MUI_PatriotF=s__PatriotSpells___PatriotSpells_F_MUI_PatriotF + 1
            set s__PatriotSpells___PatriotSpells_F_m_PatriotF[s__PatriotSpells___PatriotSpells_F_MUI_PatriotF]=this
            set s__PatriotSpells___PatriotSpells_F_c[this]=NewC
            set s__PatriotSpells___PatriotSpells_F_r[this]=0.0
            set s__PatriotSpells___PatriotSpells_F_a[this]=GetUnitFacing(s__PatriotSpells___PatriotSpells_F_c[this]) * bj_DEGTORAD
            set s__PatriotSpells___PatriotSpells_F_x[this]=GetUnitX(s__PatriotSpells___PatriotSpells_F_c[this]) + 10.0 * Cos(s__PatriotSpells___PatriotSpells_F_a[this])
            set s__PatriotSpells___PatriotSpells_F_y[this]=GetUnitY(s__PatriotSpells___PatriotSpells_F_c[this]) + 10.0 * Sin(s__PatriotSpells___PatriotSpells_F_a[this])
            set s__PatriotSpells___PatriotSpells_F_r2[this]=10.0
            set s__PatriotSpells___PatriotSpells_F_r3[this]=10.0
            set s__PatriotSpells___PatriotSpells_F_move[this]=6.0
            set s__PatriotSpells___PatriotSpells_F_rmax[this]=PatriotF_Duration
            set s__PatriotSpells___PatriotSpells_F_g[this]=CreateGroup()
            set s__PatriotSpells___PatriotSpells_F_aoe[this]=PatriotF_AoE

            call StartSpellUnit2(s__PatriotSpells___PatriotSpells_F_c[this])
            set s__PatriotSpells___PatriotSpells_F_x1[this]=GetUnitX(s__PatriotSpells___PatriotSpells_F_c[this])
            set s__PatriotSpells___PatriotSpells_F_y1[this]=GetUnitY(s__PatriotSpells___PatriotSpells_F_c[this])
            call SaveInteger(hs, GetHandleId(s__PatriotSpells___PatriotSpells_F_c[this]), PatriotSpells___SH_CAST_R, 1)
            call MouseOn(GetOwningPlayer(s__PatriotSpells___PatriotSpells_F_c[this]))
            set MouseX[GetPlayerId(GetOwningPlayer(s__PatriotSpells___PatriotSpells_F_c[this]))]=s__PatriotSpells___PatriotSpells_F_x[this]
            set MouseY[GetPlayerId(GetOwningPlayer(s__PatriotSpells___PatriotSpells_F_c[this]))]=s__PatriotSpells___PatriotSpells_F_y[this]
            set s__PatriotSpells___PatriotSpells_F_scale2[this]=PatriotT2_Range

            call MakeSound("war3mapImported\\Hero_Patriot_F")
            call SetUnitAnimationByIndex(s__PatriotSpells___PatriotSpells_F_c[this], 2)
            call SetUnitTimeScale(s__PatriotSpells___PatriotSpells_F_c[this], 2.0)

            if s__PatriotSpells___PatriotSpells_F_MUI_PatriotF == 0 then
                call PatriotSpells___PatriotTimer03Acquire()
            endif
        endfunction

    function PatriotSpells___PatriotTimer03Loop takes nothing returns nothing
        call s__PatriotSpells___PatriotSpells_Q_Loop_PatriotQ()
        call s__PatriotSpells___PatriotSpells_W_Loop_PatriotW()
        call s__PatriotSpells___PatriotSpells_E_Loop_PatriotE()
        call s__PatriotSpells___PatriotSpells_R_Loop_PatriotR()
        call s__PatriotSpells___PatriotSpells_T_Loop_PatriotT()
        call s__PatriotSpells___PatriotSpells_T2_Loop_PatriotT2()
        call s__PatriotSpells___PatriotSpells_F_Loop_PatriotF()
    endfunction

    // ===========================================================================
    // Initializer
    // ===========================================================================
    function PatriotSpells___InitPatriotSpells takes nothing returns nothing
        set PatriotSpells___PatriotTimer03=CreateTimer()
        set PatriotSpells___PatriotTimer03Callback=function PatriotSpells___PatriotTimer03Loop
    endfunction

    // ===========================================================================
    // Public Trigger Interfaces
    // ===========================================================================
    function PatriotQ_Start takes unit c,real x,real y returns nothing
        call s__PatriotSpells___PatriotSpells_Q_PatriotQ_Start(c , x , y)
    endfunction

    function PatriotW_Start takes unit c,real x,real y returns nothing
        call s__PatriotSpells___PatriotSpells_W_PatriotW_Start(c , x , y)
    endfunction

    function PatriotE_Start takes unit c returns nothing
        local integer e= LoadInteger(hs, GetHandleId(c), PatriotSpells___SH_PATRIOT_E)
        local integer rand= GetRandomInt(1, 3)
        local real x= GetUnitX(c)
        local real y= GetUnitY(c)
        local real a= GetUnitFacing(c) * bj_DEGTORAD
        local integer oldrand= LoadInteger(hs, GetHandleId(c), PatriotSpells___SH_OLD_RANDOM)

        loop
            set rand=GetRandomInt(1, 3)
            exitwhen rand != oldrand
        endloop
        if rand == 1 then
            call MakeSound("war3mapImported\\Hero_Patriot_E")
        elseif rand == 2 then
            call MakeSound("war3mapImported\\Hero_Patriot_E2")
        elseif rand == 3 then
            call MakeSound("war3mapImported\\Hero_Patriot_E3")
        endif
        call SaveInteger(hs, GetHandleId(c), PatriotSpells___SH_OLD_RANDOM, rand)

        call PatriotSpells___Patriot_SetStance(c , e == 0)
        if e == 0 then
            call Patriot_RestoreOrder(c , 8)
        else
            call Patriot_RestoreOrder(c , 3)
        endif

        if GetHeroLevel(c) >= 35 then
            call ReduceCooldown(c , PatriotR_ID , PatriotE_CDReductR)
        endif
        call ReduceCooldown(c , PatriotQ_ID , PatriotE_CDReductBase + ( PatriotE_CDReductStep * ( GetUnitAbilityLevel(c, PatriotE_ID) - 1 ) ))
        call DestroyEffect(EffectSpawn("war3mapimported\\wos_1hongse_2red.mdl" , x , y , a * bj_RADTODEG , 1.0 , 4.37 , 15.0))
        call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_wfile00009065.mdl" , x , y , a * bj_RADTODEG , 0.5 , 1.1 , 1.0 , 255 , 255 , 255 , 255))
    endfunction

    // Revive stance (Perseverance) is running.
    function Patriot_InRevive takes unit c returns boolean
        return LoadInteger(hs, GetHandleId(c), PatriotSpells___SH_PATRIOT_EE) == 1
    endfunction

    function PatriotEE_Start takes unit c,unit td returns nothing
        call s__PatriotSpells___PatriotSpells_E_PatriotE_Start(c , td)
    endfunction

    function PatriotR_Start takes unit c,real x,real y returns nothing
        call s__PatriotSpells___PatriotSpells_R_PatriotR_Start(c , x , y)
    endfunction

    function PatriotT_Start takes unit c,real x,real y returns nothing
        call s__PatriotSpells___PatriotSpells_T_PatriotT_Start(c , x , y)
    endfunction

    function PatriotT2_Start takes unit c,real x,real y returns nothing
        call s__PatriotSpells___PatriotSpells_T2_PatriotT2_Start(c , x , y)
    endfunction

    function PatriotF_Start takes unit c returns nothing
        call s__PatriotSpells___PatriotSpells_F_PatriotF_Start(c)
    endfunction

    function PatriotF2_Start takes unit c returns nothing
        call s__PatriotSpells___PatriotSpells_F_PatriotF_Start(c)
    endfunction

