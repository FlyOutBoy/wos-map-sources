            set s__AAADest__ErzaDebuffs_id[this]=ErzaWater_ID
        elseif NewId == 3 then
            if LoadInteger(hs, GetHandleId(s__AAADest__ErzaDebuffs_c[this]), AAADest__SH_MODE_G) > 0 and LoadInteger(hs, GetHandleId(s__AAADest__ErzaDebuffs_c[this]), AAADest__SH_LVL5) > 0 then
                set s__AAADest__ErzaDebuffs_e[this]=AddSpecialEffectTarget("war3mapImported\\wos_Opdef (1005)2red.mdl", s__AAADest__ErzaDebuffs_td[this], "origin")
                set s__AAADest__ErzaDebuffs_check2[this]=1
            else
                set s__AAADest__ErzaDebuffs_e[this]=AddSpecialEffectTarget("war3mapImported\\wos_Opdef (1005)2.mdl", s__AAADest__ErzaDebuffs_td[this], "origin")
            endif
            set s__AAADest__ErzaDebuffs_id[this]=ErzaLightning_ID
            // Koko Gonryo Rikyu: the Lightning debuff deals main-stat damage every second.
            if HasCachedItem(s__AAADest__ErzaDebuffs_c[this] , KokoGonryo_ID) > 0 then
                set s__AAADest__ErzaDebuffs_dmg[this]=GetMainStatValue(s__AAADest__ErzaDebuffs_c[this] , true) * KokoGonryo_Damage
            endif
        elseif NewId == 4 then
            set s__AAADest__ErzaDebuffs_id[this]=ErzaWape_ID
            set s__AAADest__ErzaDebuffs_e[this]=AddSpecialEffectTarget("war3mapImported\\wos_steam.mdl", s__AAADest__ErzaDebuffs_td[this], "origin")
            call UnitAddAbility(s__AAADest__ErzaDebuffs_td[this], ErzaWape_DecreaseArmor_ID)
            call UnitMakeAbilityPermanent(s__AAADest__ErzaDebuffs_td[this], true, ErzaWape_DecreaseArmor_ID)
            if IsUnitEnemy(s__AAADest__ErzaDebuffs_td[this], GetOwningPlayer(s__AAADest__ErzaDebuffs_c[this])) then
                set GearDamageNextSource=(s__AAADest__ErzaDebuffs_damageSource[this]) // INLINED!!
                call s__GearSystems2___KS_DelayedDamage_NextDmg_Start((s__AAADest__ErzaDebuffs_c[this] ) , ( s__AAADest__ErzaDebuffs_td[this] ) , (( ErzaWape_Damage * GetMainStatValue(s__AAADest__ErzaDebuffs_c[this] , true) )*1.0) , ( 0 ) , (( 0.3)*1.0)) // INLINED!!
            endif
        elseif NewId == 5 then
            set s__AAADest__ErzaDebuffs_id[this]=ErzaOverload_ID
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_WTW-whitethunder-Zi.mdl" , s__AAADest__ErzaDebuffs_x[this] , s__AAADest__ErzaDebuffs_y[this] , GetRandomReal(0, 359) , 1.5 , 2 , 0))
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_SasukeYh-41.mdl" , s__AAADest__ErzaDebuffs_x[this] , s__AAADest__ErzaDebuffs_y[this] , GetRandomReal(0, 359) , 1.5 , 3 , 75))
            // removed: wos_fire explosion-41.mdl is not imported
            if IsUnitEnemy(s__AAADest__ErzaDebuffs_td[this], GetOwningPlayer(s__AAADest__ErzaDebuffs_c[this])) then
                set GearDamageNextSource=(s__AAADest__ErzaDebuffs_damageSource[this]) // INLINED!!
                if HasCachedItem(s__AAADest__ErzaDebuffs_c[this] , Tobiume_ID) > 0 then
                    call s__GearSystems2___KS_DelayedDamage_NextDmg_Start((s__AAADest__ErzaDebuffs_c[this] ) , ( s__AAADest__ErzaDebuffs_td[this] ) , (( ErzaOverload_Damage * Tobiume_DamageMult * GetMainStatValue(s__AAADest__ErzaDebuffs_c[this] , true) )*1.0) , ( 0 ) , (( 0.3)*1.0)) // INLINED!!
                    call StunUnit(s__AAADest__ErzaDebuffs_c[this] , s__AAADest__ErzaDebuffs_td[this] , ErzaOverload_Stun + Tobiume_Stun)
                else
                    call s__GearSystems2___KS_DelayedDamage_NextDmg_Start((s__AAADest__ErzaDebuffs_c[this] ) , ( s__AAADest__ErzaDebuffs_td[this] ) , (( ErzaOverload_Damage * GetMainStatValue(s__AAADest__ErzaDebuffs_c[this] , true) )*1.0) , ( 0 ) , (( 0.3)*1.0)) // INLINED!!
                    call StunUnit(s__AAADest__ErzaDebuffs_c[this] , s__AAADest__ErzaDebuffs_td[this] , ErzaOverload_Stun)
                endif
            endif
        elseif NewId == 6 then
            set s__AAADest__ErzaDebuffs_id[this]=ErzaElectrized_ID
            set s__AAADest__ErzaDebuffs_dmg[this]=GetMainStatValue(s__AAADest__ErzaDebuffs_c[this] , true) * ErzaElectrized_Damage
            if HasCachedItem(s__AAADest__ErzaDebuffs_c[this] , Suzumebachi_ID) > 0 then
                set s__AAADest__ErzaDebuffs_dmg[this]=s__AAADest__ErzaDebuffs_dmg[this] * Suzumebachi_DamageMult
            endif
            set s__AAADest__ErzaDebuffs_e2[this]=AddSpecialEffectTarget("war3mapImported\\wos_Opdef (1005)2.mdl", s__AAADest__ErzaDebuffs_td[this], "origin")
            set s__AAADest__ErzaDebuffs_e[this]=AddSpecialEffectTarget("war3mapImported\\wos_laz (167).mdl", s__AAADest__ErzaDebuffs_td[this], "origin")
            if GetUnitAbilityLevel(s__AAADest__ErzaDebuffs_c[this], ErzaW_ID) == 1 then
                call SlowUnitErza(s__AAADest__ErzaDebuffs_c[this] , s__AAADest__ErzaDebuffs_td[this] , ErzaWater_Slow1)
            elseif GetUnitAbilityLevel(s__AAADest__ErzaDebuffs_c[this], ErzaW_ID) == 2 then
                call SlowUnitErza(s__AAADest__ErzaDebuffs_c[this] , s__AAADest__ErzaDebuffs_td[this] , ErzaWater_Slow2)
            elseif GetUnitAbilityLevel(s__AAADest__ErzaDebuffs_c[this], ErzaW_ID) == 3 then
                call SlowUnitErza(s__AAADest__ErzaDebuffs_c[this] , s__AAADest__ErzaDebuffs_td[this] , ErzaWater_Slow3)
            elseif GetUnitAbilityLevel(s__AAADest__ErzaDebuffs_c[this], ErzaW_ID) == 4 then
                call SlowUnitErza(s__AAADest__ErzaDebuffs_c[this] , s__AAADest__ErzaDebuffs_td[this] , ErzaWater_Slow4)
            elseif GetUnitAbilityLevel(s__AAADest__ErzaDebuffs_c[this], ErzaW_ID) == 5 then
                call SlowUnitErza(s__AAADest__ErzaDebuffs_c[this] , s__AAADest__ErzaDebuffs_td[this] , ErzaWater_Slow5)
            endif
        elseif NewId == 9 then
            set s__AAADest__ErzaDebuffs_id[this]='B00F'
            set s__AAADest__ErzaDebuffs_dmg[this]=GetUnitState(s__AAADest__ErzaDebuffs_c[this], UNIT_STATE_MAX_MANA) * ( Kurikara_MaxManaDmg / 100 )
            set s__AAADest__ErzaDebuffs_e[this]=AddSpecialEffectTarget("war3mapImported\\wos_tx_huoyan.mdl", s__AAADest__ErzaDebuffs_td[this], "origin")

        elseif NewId == 10 then
            set s__AAADest__ErzaDebuffs_dmg[this]=GetAttack(s__AAADest__ErzaDebuffs_c[this]) * Murasame_AttackDamage
            set s__AAADest__ErzaDebuffs_e[this]=AddSpecialEffectTarget("war3mapImported\\wos_blood impact.mdl", s__AAADest__ErzaDebuffs_td[this], "origin")
            set s__AAADest__ErzaDebuffs_id[this]='B03C'
            call SaveInteger(hs, GetHandleId(s__AAADest__ErzaDebuffs_td[this]), AAADest__SH_MURASAME_ACTIVE, 1)
        elseif NewId == 11 then
            set s__AAADest__ErzaDebuffs_dmg[this]=GetHeroAgi(s__AAADest__ErzaDebuffs_c[this], true) * AshisogiJizo_DamageAgi
            set s__AAADest__ErzaDebuffs_e[this]=AddSpecialEffectTarget("Abilities\\Weapons\\PoisonSting\\PoisonStingTarget.mdl", s__AAADest__ErzaDebuffs_td[this], "chest")
            set s__AAADest__ErzaDebuffs_id[this]=AshisogiJizo_Buff_ID
            call SaveInteger(hs, GetHandleId(s__AAADest__ErzaDebuffs_td[this]), AAADest__SH_ASHISOGI_ACTIVE, 1)
        endif
    set s__AAADest__ErzaDebuffs_r2[this]=0.06
    if s__AAADest__ErzaDebuffs_MUI_ErzaPas == 0 then
        call TimerStart(s__AAADest__ErzaDebuffs_t_ErzaPas, 0.1, true, function s__AAADest__ErzaDebuffs_Loop_Elemental)
    endif
endfunction
function ErzaPassive takes unit c,unit u,integer level returns nothing
local integer i= GetPlayerId(GetOwningPlayer(u))
local integer id
local integer cancel= 0
local integer damageSource= DamageSourceBase(GearDamageNextSource)
local boolean fromItem= ( damageSource >= 'I000' and damageSource <= 'Izzz' ) or ItemProcDamageDepth > 0
local unit d= DummyPlayer2[i]
local integer skip= 0
local real fireDur= 4.0
set GearDamageNextSource=0
if level == 9 then
    set damageSource='I00W'
elseif level == 10 then
    set damageSource='I03Y'
elseif level == 11 then
    set damageSource=AshisogiJizo_ID
else
    set damageSource=- 100 - level
endif
// Laxus: любой Electro (молния и её реакции) сразу снимается и прокает пассивку (мана + -КД).
if GetUnitTypeId(u) == Laxus_ID and ( level == 3 or level == 5 or level == 6 or level == 7 or level == 8 ) then
    if IsUnitIllusion(u) == false then
        call UnitRemoveAbility(u, ErzaLightning_ID)
        call UnitRemoveAbility(u, ErzaOverload_ID)
        call UnitRemoveAbility(u, ErzaElectrized_ID)
        call SetMpCurrent(u , Laxus_LightningManaRestore)
        call ReduceCooldown(u , LaxusG_ID , Laxus_LightningGReduceCD)
        call ReduceCooldown(u , LaxusQ_ID , Laxus_LightningQReduceCD)
        call ReduceCooldown(u , LaxusQ2_ID , Laxus_LightningQReduceCD)
    endif
    set d=null
    return
endif
if IsUnitVisible(u, Player(i)) == true and LoadInteger(hs, GetHandleId(u), AAADest__SH_NAOFUMI_SHIELD) == 0 then
    if level >= 9 and level <= 11 then
        set d=DummyPlayer6[i]
    endif
    if d == null or GetWidgetLife(d) < 1 then
        if level >= 9 and level <= 11 then
            set DummyPlayer6[i]=CreateUnit(Player(i), 'h0C9', GetRectCenterX(gg_rct_Caster), GetRectCenterY(gg_rct_Caster), 0)
        else
            set DummyPlayer2[i]=CreateUnit(Player(i), 'h0C9', GetRectCenterX(gg_rct_Caster), GetRectCenterY(gg_rct_Caster), 0)
        endif
        if level == 9 then
            set d=DummyPlayer6[i]
            call UnitAddAbility(d, 'A0DZ')
        elseif level == 10 then
            set d=DummyPlayer6[i]
            call UnitAddAbility(d, 'A0I3')
        elseif level == 11 then
            set d=DummyPlayer6[i]
            call UnitAddAbility(d, AshisogiJizo_Curse_ID)
        else
            set d=DummyPlayer2[i]
            call UnitAddAbility(d, ErzaElemntalAbi_ID)
        endif
    endif
    // The DoT dummy is shared by Kurikara / Murasame / Ashisogi and all of them use
    // the "curse" order: keep only the curse of the current item on it.
    if level >= 9 and level <= 11 then
        if level == 9 then
            set id='A0DZ'
        elseif level == 10 then
            set id='A0I3'
        else
            set id=AshisogiJizo_Curse_ID
        endif
        if GetUnitAbilityLevel(d, id) == 0 then
            call UnitRemoveAbility(d, 'A0DZ')
            call UnitRemoveAbility(d, 'A0I3')
            call UnitRemoveAbility(d, AshisogiJizo_Curse_ID)
            call UnitAddAbility(d, id)
        endif
    endif
    if GetUnitTypeId(u) == Rimuru_ID and level == 1 then
        set level=0
    endif
    if level > 0 and ( level < 9 or level > 11 ) then
        set level=DebuffImmune_Start(u , level)
    endif
    if level > 0 and not s__AAADest__ErzaDebuffs_AllowApplication(u , level , fromItem) then
        set d=null
        return
    endif
    if level > 0 then
        if GetUnitAbilityLevel(d, ErzaElemntalAbi_ID) == 0 and ( level < 9 or level > 11 ) then
            call UnitAddAbility(d, ErzaElemntalAbi_ID)
        endif
        call SetUnitFacing(d, GAngle(d , u) * bj_RADTODEG)
        // Kyoka Suigetsu: a lone Fire or Water becomes Steam at once. Sogyo no Kotowari keeps its Water
        // (Water -> Lightning -> Electrized), so a holder of both only converts Fire.
        if ( level == 1 or level == 2 ) and HasCachedItem(c , KyokaSuigetsu_ID) > 0 and IsUnitEnemy(u, GetOwningPlayer(c)) and GetUnitAbilityLevel(u, ErzaFire_ID) == 0 and GetUnitAbilityLevel(u, ErzaWater_ID) == 0 and GetUnitAbilityLevel(u, ErzaLightning_ID) == 0 and GetUnitAbilityLevel(u, ErzaWape_ID) == 0 and not ( level == 2 and IsItemInInventory(c , 'I01P') > 0 ) and IntegerCdKey(u , SH_ICD_KYOKA_STEAM , KyokaSuigetsu_SteamCD) then
            set level=4
        endif
        if level == 1 then
            set id=ErzaFire_ID
            if GetUnitAbilityLevel(u, ErzaWater_ID) > 0 then
                set level=4
                set skip=1
                call UnitRemoveAbility(u, ErzaFire_ID)
                call UnitRemoveAbility(u, ErzaWater_ID)
            endif
            if GetUnitAbilityLevel(u, ErzaLightning_ID) > 0 then
                set level=5
                set skip=1
                call UnitRemoveAbility(u, ErzaFire_ID)
                call UnitRemoveAbility(u, ErzaLightning_ID)
            endif
        elseif level == 2 then
            set id=ErzaWater_ID
            if GetUnitAbilityLevel(u, ErzaFire_ID) > 0 then
                set level=4
                call UnitRemoveAbility(u, ErzaFire_ID)
                call UnitRemoveAbility(u, ErzaWater_ID)
                set skip=1
            endif
            if GetUnitAbilityLevel(u, ErzaLightning_ID) > 0 then
                set level=6
                set skip=1
                call UnitRemoveAbility(u, ErzaWater_ID)
                call UnitRemoveAbility(u, ErzaLightning_ID)
            endif
        elseif level == 3 then
            set id=ErzaLightning_ID
            if GetUnitAbilityLevel(u, ErzaFire_ID) > 0 then
                set level=5
                set skip=1
                call UnitRemoveAbility(u, ErzaFire_ID)
                call UnitRemoveAbility(u, ErzaLightning_ID)
            endif
            if GetUnitAbilityLevel(u, ErzaWater_ID) > 0 then
                set level=6
                set skip=1
                call UnitRemoveAbility(u, ErzaWater_ID)
                call UnitRemoveAbility(u, ErzaLightning_ID)
            endif
        elseif level == 4 then
            set id=ErzaWape_ID
        elseif level == 5 then
            set id=ErzaOverload_ID
        elseif level == 6 then
            set id=ErzaElectrized_ID
        elseif level == 7 or level == 8 then
            set id=ErzaElectrized_ID
        elseif level == 9 then
            set id='B00F'
        elseif level == 10 then
            set id='B03C'
        elseif level == 11 then
            set id=AshisogiJizo_Buff_ID
        endif
        call SetUnitAbilityLevel(d, ErzaElemntalAbi_ID, level)
        if ( level < 9 or level > 11 ) and ( GetUnitAbilityLevel(u, ErzaWape_ID) > 0 or GetUnitAbilityLevel(u, ErzaOverload_ID) > 0 or GetUnitAbilityLevel(u, ErzaElectrized_ID) > 0 ) then
            set cancel=1
        endif
        // Zanka no Tachi: Fire always burns 7 sec; the first one already deals 70 per sec.
        if level == 1 and skip == 0 and GetUnitAbilityLevel(u, ErzaFire_ID) == 0 and HasCachedItem(c , ZankaNoTachi_ID) > 0 then
            set fireDur=4.0 + ZankaNoTachi_Extend
        endif
        // Zanka no Tachi: Fire on a burning enemy strengthens the burn.
        if level == 1 and skip == 0 and GetUnitAbilityLevel(u, ErzaFire_ID) > 0 and HasCachedItem(c , ZankaNoTachi_ID) > 0 then
            call s__AAADest__ErzaDebuffs_FireStack(u , ZankaNoTachi_Stack)
            // ...the burn restarts at its full 7 sec (it never adds up).
            set fireDur=4.0 + ZankaNoTachi_Extend
            // one burn per target: no extra effect per re-application
        endif
        // Attribution belongs to the resolved reaction, including Water + Raiden E.
        if level >= 1 and level <= 8 then
            set damageSource=- 100 - level
        endif
        // Kyoka Suigetsu: Fire or Water meeting Steam refreshes it and adds a burst.
        if ( level == 1 or level == 2 ) and skip == 0 and GetUnitAbilityLevel(u, ErzaWape_ID) > 0 and HasCachedItem(c , KyokaSuigetsu_ID) > 0 and IsUnitEnemy(u, GetOwningPlayer(c)) and IntegerCdKey(u , SH_ICD_KYOKA , KyokaSuigetsu_CD) and s__AAADest__ErzaDebuffs_AllowApplication(u , 4 , fromItem) then
            call SetUnitAbilityLevel(d, ErzaElemntalAbi_ID, 4)
            call IssueTargetOrder(d, "curse", u)
            call SetUnitAbilityLevel(d, ErzaElemntalAbi_ID, level)
            set GearDamageNextSource=(KyokaSuigetsu_ID) // INLINED!!
            call s__GearSystems2___KS_DelayedDamage_NextDmg_Start((c ) , ( u ) , (( KyokaSuigetsu_Bonus * GetMainStatValue(c , true) )*1.0) , ( 0 ) , (( 0.15)*1.0)) // INLINED!!
            call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\wos_steam.mdl", u, "origin"))
        endif
        if level == 7 or level == 8 then
            set cancel=0
        endif
        if level == 10 then
            // Murasame/Ashisogi instances live while their tick counter runs.
            if LoadInteger(hs, GetHandleId(u), AAADest__SH_MURASAME_ACTIVE) == 0 and cancel == 0 then
                call s__AAADest__ErzaDebuffs_ErzaPas_Start(c , u , level , damageSource)
            endif
        elseif level == 11 then
            if LoadInteger(hs, GetHandleId(u), AAADest__SH_ASHISOGI_ACTIVE) == 0 and cancel == 0 then
                call s__AAADest__ErzaDebuffs_ErzaPas_Start(c , u , level , damageSource)
            endif
        elseif ( GetUnitAbilityLevel(u, id) == 0 or skip == 1 ) and cancel == 0 and level != 7 and level != 8 then
            call s__AAADest__ErzaDebuffs_ErzaPas_Start(c , u , level , damageSource)
        endif
        if cancel == 0 then
            // Fire lasts 5 sec (Zanka no Tachi extends it); set on the caster dummy before the curse.
            if level == 1 then
                call BlzSetAbilityRealLevelField(BlzGetUnitAbility(d, ErzaElemntalAbi_ID), ABILITY_RLF_DURATION_HERO, 0, fireDur)
                call BlzSetAbilityRealLevelField(BlzGetUnitAbility(d, ErzaElemntalAbi_ID), ABILITY_RLF_DURATION_NORMAL, 0, fireDur)
                call SaveReal(hs, GetHandleId(u), SH_FIRE_END, TimerGetElapsed(HealRegenClock) + fireDur)
            endif
            if level == 2 or level == 6 then
                call SaveInteger(hs, GetHandleId(u), SH_WATER_PENDING, 1)
                call s__GearSystems2___KS_Flush_Start((GetHandleId(u) ) , ( SH_WATER_PENDING ) , ( 0 ) , (( 0.3)*1.0)) // INLINED!!
            endif


            call IssueTargetOrder(d, "curse", u)
            if level == 2 and IsItemInInventory(c , 'I01P') > 0 and IntegerCdKey(u , SH_ICD_CD_SOG , SogyoNoKotowari_CD) then
                   // call BlzStartUnitAbilityCooldown(c,'A09O',SogyoNoKotowari_CD)
                if GetUnitAbilityLevel(c, 'A07Z') == 0 then
                    call UnitAddAbility(c, 'A07Z')
                    call s__GearSystems2___KS_RemoveAbility_RemoveAbility_Start((c ) , (( 10 )*1.0) , ( 'A07Z' ) , ( 1)) // INLINED!!
                endif
                set GearDamageNextSource=('I01P') // INLINED!!
                call ErzaPassive(c , u , 3)
            endif
        endif
    endif
endif
set d=null
endfunction
// Murasame bleed: the first hit bleeds for Murasame_Duration ticks; every further hit
// adds its tick damage to the next tick and shortens the bleed by one tick.
function Murasame_Start takes unit c,unit td returns nothing
local integer h= GetHandleId(td)
if LoadInteger(hs, h, AAADest__SH_MURASAME_ACTIVE) == 1 and LoadReal(hs, h, AAADest__SH_MURASAME_LEFT) > 0 then
    call SaveReal(hs, h, AAADest__SH_MURASAME_BONUS, LoadReal(hs, h, AAADest__SH_MURASAME_BONUS) + GetAttack(c) * Murasame_AttackDamage)
    call SaveReal(hs, h, AAADest__SH_MURASAME_LEFT, RMaxBJ(1, LoadReal(hs, h, AAADest__SH_MURASAME_LEFT) - 1))
    call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\wos_blood impact.mdl", td, "origin"))
    return
endif
call SaveReal(hs, h, AAADest__SH_MURASAME_LEFT, Murasame_Duration)
call SaveReal(hs, h, AAADest__SH_MURASAME_BONUS, 0)
call ErzaPassive(c , td , 10)
endfunction
// Ashisogi Jizo: dispellable poison debuff like Kurikara (native curse buff, 5 sec);
// a new hit refreshes it, never stacks.
function AshisogiJizo_Poison takes unit c,unit td returns nothing
call ErzaPassive(c , td , 11)
endfunction
function ErzaBuffNakagami_Start takes unit c,unit u returns nothing
local integer i= GetPlayerId(GetOwningPlayer(u))
if DummyPlayer2[i] == null or GetWidgetLife(DummyPlayer2[i]) < 1 then
    set DummyPlayer2[i]=CreateUnit(Player(i), 'h0C9', GetRectCenterX(gg_rct_Caster), GetRectCenterY(gg_rct_Caster), 0)
    call UnitAddAbility(DummyPlayer2[i], ErzaNakagamiBuff)
endif
if GetUnitAbilityLevel(DummyPlayer2[i], ErzaNakagamiBuff) == 0 then
    call UnitAddAbility(DummyPlayer2[i], ErzaNakagamiBuff)
endif
call SetUnitFacing(DummyPlayer2[i], GAngle(DummyPlayer2[i] , u) * bj_RADTODEG)


call IssueTargetOrder(DummyPlayer2[i], "innerfire", u)
endfunction
function ErzaBar takes unit c returns nothing
call s__AAADest__ErzaDebuffs_ErzaBar_Start(c)
endfunction
function ErzaStackRemoved takes unit erza,integer h_id,integer sh,integer value,real time returns nothing
call s__AAADest__ErzaDebuffs_MyFlushStacks_Start(erza , h_id , sh , value , time)
endfunction
function GroupPush takes unit c,real x,real y,real aoe,real push_distance,real push_duration,real a,boolean all returns nothing
local group g= CreateGroup()
local unit u
local boolean b= true
call GroupEnumUnitsInRange(g, x, y, aoe, AAADestNoDecorCond)
loop
    set u=FirstOfGroup(g)
    exitwhen u == null
    if all == false then
        set b=IsUnitEnemy(u, GetOwningPlayer(c))
    endif
    if SpellBool(u) and b then
        if a == - 2 then
            call MUE(u , push_distance , push_duration , GAngle2(u , x , y))
        elseif a == - 1 then
            call MUE(u , push_distance , push_duration , GAngle3(x , y , u))
        else
            call MUE(u , push_distance , push_duration , a)
        endif
    endif
    call GroupRemoveUnit(g, u)
endloop
call DestroyGroup(g)
set u=null
set g=null
endfunction
function GroupPushEff takes unit c,real x,real y,real aoe,real push_distance,real push_duration,real a,boolean all,integer k returns nothing
local group g= CreateGroup()
local unit u
local integer damageSource= GearDamageNextSource
local boolean b= true
set GearDamageNextSource=0
call GroupEnumUnitsInRange(g, x, y, aoe, AAADestNoDecorCond)
loop
    set u=FirstOfGroup(g)
    exitwhen u == null
    if all == false then
        set b=IsUnitEnemy(u, GetOwningPlayer(c))
    endif
    if SpellBool(u) and b then
        set GearDamageNextSource=(damageSource) // INLINED!!
        call ErzaPassive(c , u , k)
        if a == - 2 then
            call MUE(u , push_distance , push_duration , GAngle2(u , x , y))
        elseif a == - 1 then
            call MUE(u , push_distance , push_duration , GAngle3(x , y , u))
        else
            call MUE(u , push_distance , push_duration , a)
        endif
    endif
    call GroupRemoveUnit(g, u)
endloop
call DestroyGroup(g)
set u=null
set g=null
endfunction
function GroupDmgEff takes unit c,real x,real y,real aoe,real dmg,integer k returns nothing
local group g= CreateGroup()
local unit u
local integer damageSource= GearDamageNextSource
set GearDamageNextSource=0
call GroupEnumUnitsInRange(g, x, y, aoe, AAADestNoDecorCond)
loop
    set u=FirstOfGroup(g)
    exitwhen u == null
    if SpellBool(u) and IsUnitEnemy(u, GetOwningPlayer(c)) then
        set GearDamageNextSource=(damageSource) // INLINED!!
        call s__GearSystems2___KS_DelayedDamage_NextDmg_Start((c ) , ( u ) , (( dmg )*1.0) , ( 0 ) , (( 0.12)*1.0)) // INLINED!!
        set GearDamageNextSource=(damageSource) // INLINED!!
        call ErzaPassive(c , u , k)
    endif
    call GroupRemoveUnit(g, u)
endloop
call DestroyGroup(g)
set u=null
set g=null
endfunction
function KurikaraFlame takes unit c,unit td returns nothing
call ErzaPassive(c , td , 9)
endfunction
function IsBuilding takes integer id returns boolean
return id == 'B005' or id == 'B00B' or id == 'B00C' or id == 'B00D' or id == 'B00E' or id == 'B00Q' or id == 'B00R' or id == 'B00J' or id == 'B00K' or id == 'B00L' or id == 'B00N' or id == 'B00M' or id == 'B01B'
endfunction
function IsBuildingFrieren takes integer id returns boolean
return id == 'B005' or id == 'B00B' or id == 'B00A' or id == 'B014' or id == 'B00Y' or id == 'B00T' or id == 'B00C' or id == 'B00D' or id == 'B00E' or id == 'B00Q' or id == 'B00R' or id == 'B00J' or id == 'B00K' or id == 'B00L' or id == 'B00N' or id == 'B00M' or id == 'B01B'
endfunction
    // One shared clock replaces thousands of short IntegerCd scheduler entries.
    // A Warcraft match will not approach this timer's expiration time.
function DecorAlive_Filter takes nothing returns boolean
return GetDestructableLife(GetFilterDestructable()) > 0.0 and GetDestructableTypeId(GetFilterDestructable()) != 'YTfb'
endfunction

function AAADest__DecorClockNow takes nothing returns real
if not AAADest__DecorCooldownClockStarted then
    set AAADest__DecorCooldownClockStarted=true
    call TimerStart(AAADest__DecorCooldownClock, 1000000.0, false, null)
endif
return TimerGetElapsed(AAADest__DecorCooldownClock)
endfunction

    // At most one expensive decor enumeration per 0.10 sec for each player.
    // Calls made by another unit/dummy of the same player share this limit.
   

function AAADest__DecorCooldownReady takes integer sourceId,destructable d,real cooldown returns boolean
local integer destructableId= GetHandleId(d)
local real now= AAADest__DecorClockNow()

if now >= LoadReal(AAADest__DecorCooldownTable, sourceId, destructableId) then
    if not HaveSavedBoolean(AAADest__DecorCooldownTable, sourceId, 0) and AAADest__DecorCooldownSourceCount < 8000 then
        call SaveBoolean(AAADest__DecorCooldownTable, sourceId, 0, true)
        set AAADest__DecorCooldownSources[AAADest__DecorCooldownSourceCount]=sourceId
        set AAADest__DecorCooldownSourceCount=AAADest__DecorCooldownSourceCount + 1
    endif
    call SaveReal(AAADest__DecorCooldownTable, sourceId, destructableId, now + cooldown)
    return true
endif

return false
endfunction
function decordestroy takes nothing returns nothing
local destructable d= GetEnumDestructable()
local unit source= decorunit
local integer sourceTypeId= GetUnitTypeId(source)
local integer sourceHandleId= GetHandleId(source)
local real damage= decordmg
local real centerX= decor_x
local real centerY= decor_y
local real radius= decor_aoe
local real x= GetDestructableX(d)
local real y= GetDestructableY(d)
local integer id= GetDestructableTypeId(d)
local integer k= 0
local integer k2= 0
local real hp= GetDestructableLife(d)
local real f= 270 * bj_DEGTORAD
local real hpcheck= hp - damage
local real scale= 0.0
local real time= 0.42
local boolean b= true
local real r5= 0.0
local integer frozenCount= 0
local integer hungryCount= 0
local integer itemSlot= - 1
local integer charges= 0
local item trackedItem= null
if sourceTypeId == 'h005' then
    if SR0(centerX , centerY , x , y) > radius and hp > 0.0 then
        set b=true
        // Round-end zone hits every decor of the arena each 0.5 s: two slashes per decor
        // were hundreds of effects per pulse. One slash, on the breaking hit or ~1 in 4 pulses.
        if hp - damage <= 0.0 or GetRandomInt(1, 4) == 1 then
            set r5=GetRandomReal(- 0.35, - 0.15)
            call DestroyEffect(EffectSpawn3("war3mapImported\\wos_az_jingzi_jiansheng01_e1_l2.mdl" , x , y , GetRandomReal(0, 359) , 1 , 1.2 , 300 , r5))
        endif
    else
        set b=false
    endif
endif
if b then
    if sourceTypeId == Mahoraga_ID and IsBuilding(id) and LoadInteger(hs, sourceHandleId, AAADest__SH_HEIGHT_TD) == 1 and hp > 0 then
        call SaveInteger(hs, sourceHandleId, AAADest__SH_DECOR_ADD, 1)
    endif
            
    if IsBuildingFrieren(id) and LoadInteger(hs, sourceHandleId, AAADest__SH_FRIEREN_T_PUSH) == 1 and hp > 0 then
        call StunUnit(source , source , FrierenT_Stun)
        call SaveInteger(hs, GetHandleId(source), AAADest__SH_FRIEREN_T_PUSH_HIT, 1)
    endif
    if id == 'B015' or id == 'B017' then
        set time=1
    endif
    if id == 'B013' then
        set time=0.8
    endif
    if hp > 0.0 and AAADest__DecorCooldownReady(sourceHandleId , d , time) then
        call SetDestructableLife(d, hp - damage)
        if hpcheck <= 0.0 then
            set frozenCount=IsItemInInventory(source , 'I01K')
            set hungryCount=IsItemInInventory(source , 'I00Q')

                    // Preserve the original priority: Frozen Heart wins when
                    // both items are present.
            if frozenCount > 0 then
                if BlzGetUnitAbilityCooldownRemaining(source, 'A07N') == 0.0 then
                    set itemSlot=IsItemInInventory3(source , 'I01K')
                    set trackedItem=UnitItemInSlot(source, itemSlot)
                    set charges=GetItemCharges(trackedItem) + 1
                    call SetItemCharges(trackedItem, charges)
                    if charges >= FrozenHeart_stack then
                        call SetItemCharges(trackedItem, 0)
                        call BlzStartUnitAbilityCooldown(source, 'A07N', FrozenHeart_cd)
                    endif
                    call SetHpCurrent2(source , source , FrozenHeart_hp)
                    call SetMpCurrent(source , FrozenHeart_mp)
                endif
            elseif hungryCount > 0 then
                if BlzGetUnitAbilityCooldownRemaining(source, 'A02E') == 0.0 then
                    set itemSlot=IsItemInInventory3(source , 'I00Q')
                    set trackedItem=UnitItemInSlot(source, itemSlot)
                    set charges=GetItemCharges(trackedItem) + 1
                    call SetItemCharges(trackedItem, charges)
                    if charges >= HungrySin_stack then
                        call SetItemCharges(trackedItem, 0)
                        call BlzStartUnitAbilityCooldown(source, 'A02E', HungrySin_cd)
                    endif
                    call SetHpCurrent2(source , source , HungrySin_hp)
                    call SetMpCurrent(source , HungrySin_mp)
                endif
            endif
        endif
        // Same behaviour as before, written explicitly: B01A breaks on any hit, B019 when depleted.
        if id == 'B01A' or ( id == 'B019' and hpcheck <= 0 ) then // inori crystall
            call SetDestructableAnimationSpeed(d, 3.15)
            call KillDestructable(d)
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_FantasyBattle (1644).mdx" , x , y , 1 , 1 , 2 , 30))
        endif
        if id == 'B00O' and hpcheck <= 0 then // explosive barrel
            call DestroyEffect(EffectSpawn("war3mapimported\\wos_GZ_jntxn (11)_R1-200.mdl" , x , y , 1 , 1 , 0.65 , 1))
            call ScaleDummy(UnitSpawn(Player(PLAYER_NEUTRAL_PASSIVE) , Fire_ID , x , y , 1 , 1 , 1.75 , 45 , 9) , 7.5 , 1.75 , 0.5)
            set GearDamageNextSource=(- 11) // INLINED!!
            call GroupDmgEff(source , x , y , 350 , 100.00 + IMaxBJ(0, GetEnvironmentRoundNumber() - 1) * 25.00 , 1)
        endif
        if id == 'B00P' and hpcheck <= 0 then // simple barrel
            call DestroyEffect(EffectSpawn("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" , x , y , 1 , 1 , 1 , 1))
            call DestroyEffect(EffectSpawn("war3mapimported\\wos_dustbrown.mdl" , x , y , 1 , 1 , 1 , 1))
        endif
        // Both leaf types burst only when destroyed (B007 used to spawn it on every hit).
        if ( id == 'B007' or id == 'B009' ) and hpcheck <= 0 then // leaves
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_Razor_leaf-A392F3.mdl" , x , y , 1 , 1 , 2 , 95))
        endif
        if id == 'B005' or id == 'B00B' or id == 'B00C' or id == 'B00D' or id == 'B00E' then // red dom normal konoha and high and thin red konoha
            set scale=1
            if id == 'B00D' or id == 'B00E' then
                set scale=1.5
            endif
            if hpcheck > 0 then // simple barrel
                call DestroyEffect(EffectSpawn("war3mapImported\\wos_1baozha_90.mdl" , x , y , GetRandomReal(0, 359) , 1 , scale , 2))
                call DestroyEffect(EffectSpawn("war3mapImported\\wos_1baozha_90.mdl" , x , y , GetRandomReal(0, 359) , 1 , scale , 145))
                if id == 'B00B' then
                    call DestroyEffect(EffectSpawn("war3mapImported\\wos_1baozha_90.mdl" , x , y , GetRandomReal(0, 359) , 1 , scale , 295))
                endif
            else
                call DestroyEffect(EffectSpawn("war3mapImported\\wos_fbt-dilie22.mdl" , x , y , GetRandomReal(0, 359) , 1 , scale + 0.5 , 1))
            endif
        endif
        if decordustcheck(d) and hpcheck <= 0 then // dust brown
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_dustbrown.mdl" , x , y , GetRandomReal(0, 359) , 1 , 1 , 1))
        endif
        if id == 'B013' then // gold bags
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_item_goldcredit.mdl" , x , y , GetRandomReal(0, 359) , 1 , 1 , 1))
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_item_goldcredit.mdl" , x , y , GetRandomReal(0, 359) , 1 , 1 , 1))
        endif
        if id == 'B01B' or id == 'B00N' then // gold bags
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_item_goldcredit.mdl" , x + 180 * Cos(120 * bj_DEGTORAD) , y + 180 * Sin(120 * bj_DEGTORAD) , 120 + GetRandomReal(0, 359) , 1 , 6 , 25))
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_item_goldcredit.mdl" , x + 180 * Cos(240 * bj_DEGTORAD) , y + 180 * Sin(240 * bj_DEGTORAD) , 240 + GetRandomReal(0, 359) , 1 , 6 , 25))
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_item_goldcredit.mdl" , x + 180 * Cos(360 * bj_DEGTORAD) , y + 180 * Sin(360 * bj_DEGTORAD) , 360 + GetRandomReal(0, 359) , 1 , 6 , 25))
        endif
        if id == 'B00A' then // poneglif
            if hpcheck <= 0 then
                call SetDestructableAnimationSpeed(d, 1.25)
                call DestroyEffect(EffectSpawn("war3mapImported\\wos_darkdustgroundeffect.mdl" , x , y , GetRandomReal(0, 359) , 1 , 1 , 151))
            else
                call DestroyEffect(EffectSpawn("war3mapImported\\wos_hit-juhuang1.mdl" , x , y , GetRandomReal(0, 359) , 1 , 2.5 , 61))
                call DestroyEffect(EffectSpawn("war3mapImported\\wos_T_dustgaraa2.mdl" , x , y , GetRandomReal(0, 359) , 0.7 , 1.35 , 1))
            endif
        endif
        if id == 'B00Q' or id == 'B00R' then // sand buildings
            if hpcheck <= 0 then
                call SetDestructableAnimationSpeed(d, 0.75)
                call DestroyEffect(EffectSpawn("war3mapImported\\wos_fbt-dilie22.mdl" , x , y , GetRandomReal(0, 359) , 1 , 1.5 , 1))
            endif
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_dizhen-qiquan.mdl" , x , y , GetRandomReal(0, 359) , 1 , 1 , 125))
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_dizhen-qiquan.mdl" , x , y , GetRandomReal(0, 359) , 1 , 1 , 415))
            if id == 'B00Q' then
                call DestroyEffect(EffectSpawn("war3mapImported\\wos_dizhen-qiquan.mdl" , x , y , GetRandomReal(0, 359) , 1 , 1 , 595))
            endif
        endif
        if id == 'B003' or id == 'B004' or id == 'B00Y' or id == 'B00S' then // metal hit
            if hpcheck <= 0 then
                if id == 'B00Y' or id == 'B00S' then
                    call DestroyEffect(EffectSpawn("war3mapImported\\wos_hit-juhuang1.mdl" , x , y , GetRandomReal(0, 359) , 1 , 1.25 , 45))
                endif
                if id == 'B00S' then
                    call DestroyEffect(EffectSpawn("war3mapImported\\wos_OPm (431232).mdl" , x , y , 1 , 1 , 0.7 , 1))
                    call DestroyEffect(EffectSpawn("war3mapImported\\wos_SasukeYh-41.mdl" , x , y , 1 , 1 , 1.5 , 55))
                    set GearDamageNextSource=(- 16) // INLINED!!
                    call GroupDmgEff(source , x , y , 400 , 100.00 + IMaxBJ(0, GetEnvironmentRoundNumber() - 1) * 25.00 , 3)
                endif
                call DestroyEffect(EffectSpawn("war3mapImported\\wos_solaire_lightning_impact.mdl" , x , y , GetRandomReal(0, 359) , 0.4 , 2.15 , 51))
            endif
        endif
        if id == 'B014' or id == 'B015' or id == 'B017' then // busic
            if hpcheck > 0 then
                call DestroyEffect(EffectSpawn("war3mapImported\\wos_hit-juhuang1.mdl" , x , y , GetRandomReal(0, 359) , 1 , 1.75 , 45))
                call DestroyEffect(EffectSpawn("war3mapImported\\wos_solaire_lightning_impact.mdl" , x , y , GetRandomReal(0, 359) , 0.4 , 2.15 , 51))
            else
                call ScaleDummy(UnitSpawn(Player(PLAYER_NEUTRAL_PASSIVE) , Fire_ID , x , y , 1 , 1 , 1.75 , 45 , 9) , 7.5 , 1.75 , 0.5)
                if id == 'B014' then
                    set GearDamageNextSource=(- 15) // INLINED!!
                    call GroupDmgEff(source , x , y , 500 , 200.00 + IMaxBJ(0, GetEnvironmentRoundNumber() - 1) * 25.00 , 5)
                    call DestroyEffect(EffectSpawn("war3mapImported\\wos_OPm (431232).mdl" , x , y , 1 , 1 , 0.7 , 1))
                    call DestroyEffect(EffectSpawn("war3mapImported\\wos_SasukeYh-41.mdl" , x , y , 1 , 1 , 1.5 , 55))
                else
                    set GearDamageNextSource=(- 13) // INLINED!!
                    call GroupDmgEff(source , x , y , 500 , 1000 , 1)
                endif
                call DestroyEffect(EffectSpawn("war3mapImported\\wos_by_wood_effect_yuzhiboyou_unusual_fenshendabaopo_2.mdl" , x , y , GetRandomReal(0, 359) , 1 , 2 , 1))
            endif
        endif
        if id == 'B00T' then // gidrant
            if hpcheck <= 0 then
                set GearDamageNextSource=(- 17) // INLINED!!
                call GroupDmgEff(source , x , y , 350 , IMaxBJ(0, GetEnvironmentRoundNumber() - 1) * 25.00 , 0)
                call GroupPushEff(source , x , y , 350 , 350 , 0.42 , - 1 , true , 2)
                call DestroyEffect(EffectSpawn("war3mapImported\\wos_obr08 (171).mdl" , x , y , GetRandomReal(0, 359) , 0.75 , 1.25 , 1))
                call DestroyEffect(EffectSpawn("war3mapImported\\wos_LD2209 (129).mdl" , x , y , GetRandomReal(0, 359) , 0.4 , 0.8 , 1))
            endif
        endif
        if id == 'B00J' or id == 'B00K' or id == 'B00L' or id == 'B00N' or id == 'B00M' or id == 'B01B' then // red dom normal konoha and high and thin red konoha
            set k2=3
            set f=800
            if id == 'B00K' then
                set k2=4
                set f=1100
            endif
            if id == 'B00M' then
                set k2=5
                set f=1600
            endif
            set k=0
            loop
                exitwhen k == k2
                set scale=GetRandomReal(150, f)
                call DestroyEffect(EffectSpawn("war3mapImported\\wos_hit wave white.mdl" , x , y , GetRandomReal(0, 359) , 0.65 , 2 , scale))
                call DestroyEffect(EffectSpawn("war3mapImported\\wos_Effect Pieces.mdl" , x , y , GetRandomReal(0, 359) , 1 , 3.25 , scale - 110))
                call DestroyEffect(EffectSpawn("war3mapImported\\wos_Effect Pieces.mdl" , x , y , GetRandomReal(0, 359) , 1 , 3.25 , scale - 110))
                set k=k + 1
            endloop
            call SetDestructableAnimationSpeed(d, 1.15)
            if hpcheck <= 0 then // dust big
                call DestroyEffect(EffectSpawn("war3mapImported\\wos_shachen1.mdl" , x , y , GetRandomReal(0, 359) , 1 , 1 , 1))
            endif
        endif
            //call MyReviveDest(d,90)
    endif
endif
set trackedItem=null
set source=null
set d=null
endfunction
function decordestroyInori takes nothing returns nothing
local destructable d= GetEnumDestructable()
local integer id= GetDestructableTypeId(d)
if id == 'B01A' or id == 'B019' then // inori crystall
    call RemoveDestructable(d)
endif
set d=null
endfunction
// Round reset: damaged decor is queued in one read-only pass and restored in
// small batches over ~1.5 s, so the birth animations no longer land in one frame.

function AAADest__DecorQueueDamaged takes nothing returns nothing
local destructable d= GetEnumDestructable()
if AAADest__DecorRestoreCount < AAADest__DECOR_RESTORE_MAX and GetDestructableLife(d) < GetDestructableMaxLife(d) then
    set AAADest__DecorRestoreQueue[AAADest__DecorRestoreCount]=d
    set AAADest__DecorRestoreCount=AAADest__DecorRestoreCount + 1
endif
set d=null
endfunction

function AAADest__DecorRestoreStep takes nothing returns nothing
local integer last= IMinBJ(AAADest__DecorRestoreCount, AAADest__DecorRestoreNext + AAADest__DecorRestorePerTick)
local destructable d
local real life
local real maxLife
loop
    exitwhen AAADest__DecorRestoreNext >= last
    set d=AAADest__DecorRestoreQueue[AAADest__DecorRestoreNext]
    set AAADest__DecorRestoreQueue[AAADest__DecorRestoreNext]=null
    // Removed meanwhile (Inori crystals...) or already whole: skip.
    if d != null and GetDestructableTypeId(d) != 0 then
        set life=GetDestructableLife(d)
        set maxLife=GetDestructableMaxLife(d)
        if life < maxLife then
            call DestructableRestoreLife(d, maxLife, life <= 0.405)
        endif
    endif
    set AAADest__DecorRestoreNext=AAADest__DecorRestoreNext + 1
endloop
set d=null
if AAADest__DecorRestoreNext >= AAADest__DecorRestoreCount then
    set AAADest__DecorRestoreCount=0
    set AAADest__DecorRestoreNext=0
else
    call TimerStart(AAADest__DecorRestoreTimer, AAADest__DECOR_RESTORE_PERIOD, false, function AAADest__DecorRestoreStep)
endif
endfunction

function DecorRestore takes nothing returns nothing
local integer i= 0
// A restore still in progress is dropped: the new pass queues whatever is still damaged.
call PauseTimer(AAADest__DecorRestoreTimer)
loop
    exitwhen AAADest__DecorRestoreNext >= AAADest__DecorRestoreCount
    set AAADest__DecorRestoreQueue[AAADest__DecorRestoreNext]=null
    set AAADest__DecorRestoreNext=AAADest__DecorRestoreNext + 1
endloop
set AAADest__DecorRestoreCount=0
set AAADest__DecorRestoreNext=0
call EnumDestructablesInRect(bj_mapInitialPlayableArea, null, function AAADest__DecorQueueDamaged)
set AAADest__DecorRestorePerTick=IMaxBJ(1, ( AAADest__DecorRestoreCount + AAADest__DECOR_RESTORE_TICKS - 1 ) / AAADest__DECOR_RESTORE_TICKS)
if AAADest__DecorRestoreCount > 0 then
    call AAADest__DecorRestoreStep()
endif
loop
    exitwhen i >= AAADest__DecorCooldownSourceCount
    call FlushChildHashtable(AAADest__DecorCooldownTable, AAADest__DecorCooldownSources[i])
    set i=i + 1
endloop
set AAADest__DecorCooldownSourceCount=0
// Per-source call cache: drop it each round (dummies leave one row each).
call FlushParentHashtable(AAADest__DecorCallTable)
set AAADest__DecorCallTable=InitHashtable()
endfunction

function AAADest__DecorAcquireRect takes real minX,real minY,real maxX,real maxY returns rect
set AAADest__DecorEnumDepth=AAADest__DecorEnumDepth + 1
if AAADest__DecorEnumRects[AAADest__DecorEnumDepth] == null then
    set AAADest__DecorEnumRects[AAADest__DecorEnumDepth]=Rect(minX, minY, maxX, maxY)
else
    call SetRect(AAADest__DecorEnumRects[AAADest__DecorEnumDepth], minX, minY, maxX, maxY)
endif
return AAADest__DecorEnumRects[AAADest__DecorEnumDepth]
endfunction

function AAADest__DecorReleaseRect takes nothing returns nothing
set AAADest__DecorEnumDepth=AAADest__DecorEnumDepth - 1
endfunction
function PlayersMsg takes string s,real r returns nothing
local integer i= 0
loop
    exitwhen i == bj_MAX_PLAYER_SLOTS
    call DisplayTimedTextToPlayer(Player(i), 0, 0, r, s)
    set i=i + 1
endloop
endfunction
function DecorRemove takes unit c,real x,real y,real aoe,real dmg returns nothing
local rect enumRect
local integer h
local real now
local real dx
local real dy
    // Проверяем только корректность вызова. Общего кулдауна игрока здесь нет.
if c == null or aoe <= 0.0 then
    return
endif
set h=GetHandleId(c)
set now=AAADest__DecorClockNow()
set dx=x - LoadReal(AAADest__DecorCallTable, h, 1)
set dy=y - LoadReal(AAADest__DecorCallTable, h, 2)
if now - LoadReal(AAADest__DecorCallTable, h, 0) < 0.09 and aoe <= LoadReal(AAADest__DecorCallTable, h, 3) and dmg <= LoadReal(AAADest__DecorCallTable, h, 4) and dx * dx + dy * dy <= aoe * aoe * 0.09 then
    return
endif
call SaveReal(AAADest__DecorCallTable, h, 0, now)
call SaveReal(AAADest__DecorCallTable, h, 1, x)
call SaveReal(AAADest__DecorCallTable, h, 2, y)
call SaveReal(AAADest__DecorCallTable, h, 3, aoe)
call SaveReal(AAADest__DecorCallTable, h, 4, dmg)
set decordmg=dmg
set decorunit=c
set decor_x=x
set decor_y=y
set decor_aoe=aoe
set enumRect=AAADest__DecorAcquireRect(x - aoe , y - aoe , x + aoe , y + aoe)
call EnumDestructablesInRect(enumRect, DecorAliveCond, function decordestroy)
set AAADest__DecorEnumDepth=AAADest__DecorEnumDepth - 1 // INLINED!!
set enumRect=null
endfunction

function AAADest__DecorLineHit takes nothing returns nothing
    local destructable d= GetEnumDestructable()
    local integer id= GetHandleId(d)
    local real life= GetDestructableLife(d)
    local hashtable hits= AAADest__DecorLineHits
    local integer key= AAADest__DecorLineKey
    local real x= GetDestructableX(d) - AAADest__DecorLineX
    local real y= GetDestructableY(d) - AAADest__DecorLineY
    local real projection= RMaxBJ(0.0, RMinBJ(AAADest__DecorLineLength, x * AAADest__DecorLineCos + y * AAADest__DecorLineSin))
    set x=x - projection * AAADest__DecorLineCos
    set y=y - projection * AAADest__DecorLineSin
    if x * x + y * y <= AAADest__DecorLineRadius * AAADest__DecorLineRadius and not LoadBoolean(AAADest__DecorLineHits, AAADest__DecorLineKey, GetHandleId(d)) then
        // Reuse the normal decor damage, drops, effects and respawn logic.
        call decordestroy()
        // A rejected hit (including the per-object cooldown) must stay eligible.
        if GetDestructableLife(d) < life then
            call SaveBoolean(hits, key, id, true)
        endif
    endif
    set hits=null
    set d=null
endfunction

function DecorRemoveLine takes unit c,real x,real y,real angle,real length,real aoe,real dmg,hashtable hits,integer key returns nothing
    local rect enumRect
    local real centerX= x + length * 0.5 * Cos(angle)
    local real centerY= y + length * 0.5 * Sin(angle)
    local real bound= aoe + length * 0.5
    if c == null or aoe <= 0.0 or length < 0.0 or hits == null then
        return
    endif
    set AAADest__DecorLineX=x
    set AAADest__DecorLineY=y
    set AAADest__DecorLineCos=Cos(angle)
    set AAADest__DecorLineSin=Sin(angle)
    set AAADest__DecorLineLength=length
    set AAADest__DecorLineRadius=aoe
    set AAADest__DecorLineHits=hits
    set AAADest__DecorLineKey=key
    set decordmg=dmg
    set decorunit=c
    set decor_x=centerX
    set decor_y=centerY
    set decor_aoe=bound
    set enumRect=AAADest__DecorAcquireRect(centerX - bound , centerY - bound , centerX + bound , centerY + bound)
    call EnumDestructablesInRect(enumRect, DecorAliveCond, function AAADest__DecorLineHit)
    set AAADest__DecorEnumDepth=AAADest__DecorEnumDepth - 1 // INLINED!!
    set enumRect=null
    set AAADest__DecorLineHits=null
endfunction

function DecorRemoveInori takes unit c,real x,real y,real aoe returns nothing
local rect enumRect

if aoe > 0.0 then
    set enumRect=AAADest__DecorAcquireRect(x - aoe , y - aoe , x + aoe , y + aoe)
    call EnumDestructablesInRect(enumRect, null, function decordestroyInori)
    set AAADest__DecorEnumDepth=AAADest__DecorEnumDepth - 1 // INLINED!!
    set enumRect=null
endif
endfunction

function DecorRemove2 takes unit c,real x,real y,real aoe,real dmg returns nothing
set decor_x=x
set decor_y=y
set decor_aoe=aoe
set decordmg=dmg
set decorunit=c
call EnumDestructablesInRect(gg_rct_Arena, DecorAliveCond, function decordestroy)
endfunction

//library AAADest ends
//library AinzSpells:

    function AinzSpells__AinzTick_On takes integer k returns nothing
        if not AinzSpells__AinzTick_Active[k] then
            set AinzSpells__AinzTick_Active[k]=true
            set AinzSpells__AinzTick_Users=AinzSpells__AinzTick_Users + 1
            if AinzSpells__AinzTick_Users == 1 then
                call TimerStart(AinzSpells__AinzTick_Timer, 0.03, true, AinzSpells__AinzTick_Callback)
            endif
        endif
    endfunction

    function AinzSpells__AinzTick_Off takes integer k returns nothing
        if AinzSpells__AinzTick_Active[k] then
            set AinzSpells__AinzTick_Active[k]=false
            set AinzSpells__AinzTick_Users=AinzSpells__AinzTick_Users - 1
            if AinzSpells__AinzTick_Users <= 0 then
                set AinzSpells__AinzTick_Users=0
                call PauseTimer(AinzSpells__AinzTick_Timer)
            endif
        endif
    endfunction


    //===========================================================================
    // Система перехвата приказов (Order Tracking) для каста на ходу
    //===========================================================================
    function AinzSpells__OnHeroPointOrder takes nothing returns boolean
        local unit u= GetOrderedUnit()
        local integer ord= GetIssuedOrderId()
        if GetUnitTypeId(u) == Ainz_ID then
            if ord == 851971 or ord == 851986 or ord == 851990 then
                call SaveInteger(hs, GetHandleId(u), AinzSpells__SH_ORD_MODE, 1)
                call SaveInteger(hs, GetHandleId(u), AinzSpells__SH_ORD_ID, ord)
                call SaveReal(hs, GetHandleId(u), AinzSpells__SH_ORD_X, GetOrderPointX())
                call SaveReal(hs, GetHandleId(u), AinzSpells__SH_ORD_Y, GetOrderPointY())
            endif
        endif
        set u=null
        return false
    endfunction

    function AinzSpells__OnHeroTargetOrder takes nothing returns boolean
        local unit u= GetOrderedUnit()
        local integer ord= GetIssuedOrderId()
        if GetUnitTypeId(u) == Ainz_ID then
            if ord == 851971 or ord == 851983 then
                call SaveInteger(hs, GetHandleId(u), AinzSpells__SH_ORD_MODE, 2)
                call SaveInteger(hs, GetHandleId(u), AinzSpells__SH_ORD_ID, ord)
                call SaveUnitHandle(hs, GetHandleId(u), AinzSpells__SH_ORD_TARGET, GetOrderTargetUnit())
            endif
        endif
        set u=null
        return false
    endfunction

    function AinzSpells__OnHeroImmediateOrder takes nothing returns boolean
        local unit u= GetOrderedUnit()
        local integer ord= GetIssuedOrderId()
        if GetUnitTypeId(u) == Ainz_ID then
            if ord == 851972 or ord == 851993 then
                call SaveInteger(hs, GetHandleId(u), AinzSpells__SH_ORD_MODE, 0)
            endif
        endif
        set u=null
        return false
    endfunction

    function Ainz_RestoreOrder takes unit c,integer animIndex returns nothing
        local integer mode= LoadInteger(hs, GetHandleId(c), AinzSpells__SH_ORD_MODE)
        local real ox
        local real oy
        local real dx
        local real dy
        local integer oid
        local unit tu

        if mode == 1 then
            set ox=LoadReal(hs, GetHandleId(c), AinzSpells__SH_ORD_X)
            set oy=LoadReal(hs, GetHandleId(c), AinzSpells__SH_ORD_Y)
            set dx=ox - GetUnitX(c)
            set dy=oy - GetUnitY(c)
            if ( dx * dx + dy * dy ) > 5625.0 then
                set oid=LoadInteger(hs, GetHandleId(c), AinzSpells__SH_ORD_ID)
                call IssuePointOrderById(c, oid, ox, oy)
                return
            endif
        elseif mode == 2 then
            set tu=LoadUnitHandle(hs, GetHandleId(c), AinzSpells__SH_ORD_TARGET)
            if tu != null and GetWidgetLife(tu) > 0.405 then
                set oid=LoadInteger(hs, GetHandleId(c), AinzSpells__SH_ORD_ID)
                call IssueTargetOrderById(c, oid, tu)
                set tu=null
                return
            endif
            set tu=null
        endif

        if animIndex >= 0 then
            call SetUnitAnimationByIndex(c, animIndex)
        endif
    endfunction

        function s__AinzSpells__AinzOrderInit_onInit takes nothing returns nothing
            local trigger tPoint= CreateTrigger()
            local trigger tTarget= CreateTrigger()
            local trigger tImmediate= CreateTrigger()
            local integer i= 0
            loop
                exitwhen i >= 16
                call TriggerRegisterPlayerUnitEvent(tPoint, Player(i), EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER, null)
                call TriggerRegisterPlayerUnitEvent(tTarget, Player(i), EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER, null)
                call TriggerRegisterPlayerUnitEvent(tImmediate, Player(i), EVENT_PLAYER_UNIT_ISSUED_ORDER, null)
                set i=i + 1
            endloop
            call TriggerAddCondition(tPoint, Condition(function AinzSpells__OnHeroPointOrder))
            call TriggerAddCondition(tTarget, Condition(function AinzSpells__OnHeroTargetOrder))
            call TriggerAddCondition(tImmediate, Condition(function AinzSpells__OnHeroImmediateOrder))
            set tPoint=null
            set tTarget=null
            set tImmediate=null
        endfunction

    function AddAinzItemGoldCost takes unit c,item whichItem returns nothing
        local integer pid
        local integer itemHid
        local real itemCost

        if c == null or whichItem == null or GetUnitTypeId(c) != Ainz_ID then
            return
        endif
        if not UnitHasItem(c, whichItem) then
            return
        endif

        set pid=GetPlayerId(GetOwningPlayer(c))
        set itemHid=GetHandleId(whichItem)

        if LoadBoolean(AinzGoldCostCache, itemHid, 0) then
            return
        endif

        set itemCost=I2R(GetItemValue(GetItemTypeId(whichItem)))
        set goldcost[pid]=goldcost[pid] + itemCost
        call SaveBoolean(AinzGoldCostCache, itemHid, 0, true)
        call SaveReal(AinzGoldCostCache, itemHid, 1, itemCost)
        call SaveInteger(AinzGoldCostCache, itemHid, 2, pid)
    endfunction

    function RemoveAinzItemGoldCost takes unit c,item whichItem returns nothing
        local integer pid
        local integer itemHid

        if c == null or whichItem == null or GetUnitTypeId(c) != Ainz_ID then
            return
        endif

        set pid=GetPlayerId(GetOwningPlayer(c))
        set itemHid=GetHandleId(whichItem)

        if not LoadBoolean(AinzGoldCostCache, itemHid, 0) or LoadInteger(AinzGoldCostCache, itemHid, 2) != pid then
            return
        endif

        set goldcost[pid]=goldcost[pid] - LoadReal(AinzGoldCostCache, itemHid, 1)
        call FlushChildHashtable(AinzGoldCostCache, itemHid)

        if goldcost[pid] < 0.00 then
            set goldcost[pid]=0.00
        endif
    endfunction

    function AinzSpells__AinzTimer03Acquire takes nothing returns nothing
        set AinzSpells__AinzTimer03Users=AinzSpells__AinzTimer03Users + 1
        if AinzSpells__AinzTimer03Users == 1 then
            call TimerStart(AinzSpells__AinzTimer03, 0.03, true, AinzSpells__AinzTimer03Callback)
        endif
    endfunction

    function AinzSpells__AinzTimer03Release takes nothing returns nothing
        set AinzSpells__AinzTimer03Users=AinzSpells__AinzTimer03Users - 1
        if AinzSpells__AinzTimer03Users <= 0 then
            set AinzSpells__AinzTimer03Users=0
            call PauseTimer(AinzSpells__AinzTimer03)
        endif
    endfunction

    function AinzSpells__AinzSwapPatch takes unit c,integer oldId,integer state returns nothing
        call SaveInteger(hs, GetHandleId(GetOwningPlayer(c)), GearKey(GEAR_KEY_I2S , "" , oldId), state)
    endfunction

    function AinzSpells__AinzFinishSwap takes unit c,integer oldId returns nothing
        if LoadInteger(hs, GetHandleId(c), AinzSpells__SH_MODE_T) == 1 then
            call SaveInteger(hs, GetHandleId(c), GearKey(GEAR_KEY_AINZ_PENDING_SWAP , "Ainz pending swap " , oldId), 1)
        else
            call AinzSpells__AinzSwapPatch(c , oldId , 1)
        endif
    endfunction

    function AinzSpells__AinzFlushPendingSwaps takes unit c returns nothing
        if LoadInteger(hs, GetHandleId(c), SH_Ainz_AINZ_PENDING_SWAP_AINZQ_ID) == 1 then
            call SaveInteger(hs, GetHandleId(c), SH_Ainz_AINZ_PENDING_SWAP_AINZQ_ID, 0)
            call AinzSpells__AinzSwapPatch(c , AinzQ_ID , 1)
        endif
        if LoadInteger(hs, GetHandleId(c), SH_Ainz_AINZ_PENDING_SWAP_AINZW_ID) == 1 then
            call SaveInteger(hs, GetHandleId(c), SH_Ainz_AINZ_PENDING_SWAP_AINZW_ID, 0)
            call AinzSpells__AinzSwapPatch(c , AinzW_ID , 1)
        endif
        if LoadInteger(hs, GetHandleId(c), SH_Ainz_AINZ_PENDING_SWAP_AINZW2_ID) == 1 then
            call SaveInteger(hs, GetHandleId(c), SH_Ainz_AINZ_PENDING_SWAP_AINZW2_ID, 0)
            call AinzSpells__AinzSwapPatch(c , AinzW2_ID , 1)
        endif
        if LoadInteger(hs, GetHandleId(c), SH_Ainz_AINZ_PENDING_SWAP_AINZE_ID) == 1 then
            call SaveInteger(hs, GetHandleId(c), SH_Ainz_AINZ_PENDING_SWAP_AINZE_ID, 0)
            call AinzSpells__AinzSwapPatch(c , AinzE_ID , 1)
        endif
    endfunction



        function s__AinzSpells__AinzQ_KS_IsMinePositionFree takes real NewX,real NewY returns boolean
            local integer i= 0
            local integer mine
            local real dx
            local real dy
            loop
                exitwhen i > s__AinzSpells__AinzQ_KS_MUI_AinzQ
                set mine=s__AinzSpells__AinzQ_KS_m_AinzQ[i]
                if s__AinzSpells__AinzQ_KS_active[mine] and not s__AinzSpells__AinzQ_KS_exploded[mine] and s__AinzSpells__AinzQ_KS_e[mine] != null then
                    set dx=NewX - s__AinzSpells__AinzQ_KS_x[mine]
                    set dy=NewY - s__AinzSpells__AinzQ_KS_y[mine]
                    if dx * dx + dy * dy <= AinzQ_MineMinDistance * AinzQ_MineMinDistance then
                        return false
                    endif
                endif
                set i=i + 1
            endloop
            return true
        endfunction

        function s__AinzSpells__AinzQ_KS_CanPlaceRing takes real CenterX,real CenterY returns boolean
            local integer i= 0
            local integer j
            local real angle
            local real angle2
            local real px
            local real py
            local real px2
            local real py2
            local real dx
            local real dy
            loop
                exitwhen i >= AinzQ2_MineCount
                set angle=( 360.00 / I2R(AinzQ2_MineCount) ) * I2R(i) * bj_DEGTORAD
                set px=CenterX + AinzQ2_MineOffset * Cos(angle)
                set py=CenterY + AinzQ2_MineOffset * Sin(angle)

                if not s__AinzSpells__AinzQ_KS_IsMinePositionFree(px , py) then
                    return false
                endif

                set j=0
                loop
                    exitwhen j >= i
                    set angle2=( 360.00 / I2R(AinzQ2_MineCount) ) * I2R(j) * bj_DEGTORAD
                    set px2=CenterX + AinzQ2_MineOffset * Cos(angle2)
                    set py2=CenterY + AinzQ2_MineOffset * Sin(angle2)
                    set dx=px - px2
                    set dy=py - py2
                    if dx * dx + dy * dy <= AinzQ_MineMinDistance * AinzQ_MineMinDistance then
                        return false
                    endif
                    set j=j + 1
                endloop
                set i=i + 1
            endloop
            return true
        endfunction

        function s__AinzSpells__AinzQ_KS_IsMineRingFree takes real CenterX,real CenterY returns boolean
            return s__AinzSpells__AinzQ_KS_CanPlaceRing(CenterX , CenterY)
        endfunction

        function s__AinzSpells__AinzQ_KS_RefundCast takes unit NewC returns nothing
            local integer level= GetUnitAbilityLevel(NewC, AinzQ_ID)
            local integer manaCost
            if level < 1 then
                set level=1
            endif
            set manaCost=BlzGetAbilityManaCost(AinzQ_ID, level - 1)
            call IssueImmediateOrder(NewC, "stop")
            call BlzEndUnitAbilityCooldown(NewC, AinzQ_ID)
            call SetUnitState(NewC, UNIT_STATE_MANA, GetUnitState(NewC, UNIT_STATE_MANA) + I2R(manaCost))
            if IntegerCdKey(NewC , SH_ICD_CD_WARNING , 5) then
                call DisplayTimedTextToPlayer(GetOwningPlayer(NewC), 0.00, 0.00, 1.00, "|cffffcc00Mine placement cancelled: another active mine is too close.|r")
            endif
        endfunction

        function s__AinzSpells__AinzQ_KS_HasEnemyNearby takes integer this returns boolean
            local unit u
            local boolean found= false
            local real triggerAoe= AinzQ_MineTriggerAoe

            if s__AinzSpells__AinzQ_KS_mineKind[this] == s__AinzSpells__AinzQ_KS_MINE_KIND_Q2 then
                set triggerAoe=AinzQ_MineTriggerAoe
            endif

            call GroupClear(s__AinzSpells__AinzQ_KS_g[this])
            call GroupEnumUnitsInRange(s__AinzSpells__AinzQ_KS_g[this], s__AinzSpells__AinzQ_KS_x[this], s__AinzSpells__AinzQ_KS_y[this], triggerAoe, NoDecor_Cond)
            loop
                set u=FirstOfGroup(s__AinzSpells__AinzQ_KS_g[this])
                exitwhen u == null
                if SpellBool(u) and IsUnitEnemy(u, s__AinzSpells__AinzQ_KS_owner[this]) then
                    set found=true
                endif
                call GroupRemoveUnit(s__AinzSpells__AinzQ_KS_g[this], u)
            endloop
            set u=null
            return found
        endfunction

        function s__AinzSpells__AinzQ_KS_Explode takes integer this returns nothing
            local unit u
            local integer i= 0
            local integer mine
            local real dx
            local real dy

            if not s__AinzSpells__AinzQ_KS_active[this] or s__AinzSpells__AinzQ_KS_exploded[this] then
                return
            endif

            set s__AinzSpells__AinzQ_KS_exploded[this]=true
            set s__AinzSpells__AinzQ_KS_active[this]=false
            call BlzSetSpecialEffectTimeScale(s__AinzSpells__AinzQ_KS_e[this], 1)
            call DestroyEffect(s__AinzSpells__AinzQ_KS_e[this])
            set s__AinzSpells__AinzQ_KS_e[this]=null
            call DestroyEffect(s__AinzSpells__AinzQ_KS_e2[this])
            set s__AinzSpells__AinzQ_KS_e2[this]=null

            if s__AinzSpells__AinzQ_KS_mineKind[this] == s__AinzSpells__AinzQ_KS_MINE_KIND_Q2 then
                if IntegerCdKey(s__AinzSpells__AinzQ_KS_c[this] , SH_ICD_CD_SOUND , 15) then
                    call MakeSound("war3mapimported\\Hero_Ainz_Q4")
                endif
                call MakeSound("war3mapimported\\Hero_Ainz_Q3")
            else
                call MakeSound("war3mapimported\\Hero_Ainz_Q1")
                if IntegerCdKey(s__AinzSpells__AinzQ_KS_c[this] , SH_ICD_CD_SOUND , 10) then
                    call MakeSound("war3mapimported\\Hero_Ainz_Q2")
                endif
            endif

            call VisionTimed(s__AinzSpells__AinzQ_KS_owner[this] , s__AinzSpells__AinzQ_KS_x[this] , s__AinzSpells__AinzQ_KS_y[this] , AinzQ_DamageAoe * 1.35 , 1.50)
            call DecorRemove(s__AinzSpells__AinzQ_KS_c[this] , s__AinzSpells__AinzQ_KS_x[this] , s__AinzSpells__AinzQ_KS_y[this] , AinzQ_DamageAoe , AinzQ_DecorDamage)
            call EffectSpawn2("war3mapImported\\wos_opdef (1054).mdl" , s__AinzSpells__AinzQ_KS_x[this] , s__AinzSpells__AinzQ_KS_y[this] , 0 , 2 , 1.1 , 115 , 0.7)
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_fire explosion.mdx" , s__AinzSpells__AinzQ_KS_x[this] , s__AinzSpells__AinzQ_KS_y[this] , GetRandomReal(0, 359) , 1.35 , 1.85 , 15))
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_bwaxec2.mdl" , s__AinzSpells__AinzQ_KS_x[this] , s__AinzSpells__AinzQ_KS_y[this] , GetRandomReal(0, 359) , 0.5 , 1 , 0))

            call GroupClear(s__AinzSpells__AinzQ_KS_g[this])
            call GroupEnumUnitsInRange(s__AinzSpells__AinzQ_KS_g[this], s__AinzSpells__AinzQ_KS_x[this], s__AinzSpells__AinzQ_KS_y[this], AinzQ_DamageAoe, NoDecor_Cond)
            loop
                set u=FirstOfGroup(s__AinzSpells__AinzQ_KS_g[this])
                exitwhen u == null
                if SpellBool(u) and IsUnitEnemy(u, s__AinzSpells__AinzQ_KS_owner[this]) then
                    if s__AinzSpells__AinzQ_KS_mineKind[this] == s__AinzSpells__AinzQ_KS_MINE_KIND_Q2 then
                        set GearDamageNextSource=(AinzQ2_ID) // INLINED!!
                    else
                        set GearDamageNextSource=(AinzQ_ID) // INLINED!!
                    endif
                    call dmgmag(s__AinzSpells__AinzQ_KS_c[this] , u , s__AinzSpells__AinzQ_KS_dmg[this])
                endif
                call GroupRemoveUnit(s__AinzSpells__AinzQ_KS_g[this], u)
            endloop
            set u=null

            loop
                exitwhen i > s__AinzSpells__AinzQ_KS_MUI_AinzQ
                set mine=s__AinzSpells__AinzQ_KS_m_AinzQ[i]
                if mine != this and s__AinzSpells__AinzQ_KS_active[mine] and s__AinzSpells__AinzQ_KS_armed[mine] and not s__AinzSpells__AinzQ_KS_exploded[mine] and s__AinzSpells__AinzQ_KS_e[mine] != null then
                    set dx=s__AinzSpells__AinzQ_KS_x[this] - s__AinzSpells__AinzQ_KS_x[mine]
                    set dy=s__AinzSpells__AinzQ_KS_y[this] - s__AinzSpells__AinzQ_KS_y[mine]
                    if dx * dx + dy * dy <= AinzQ_MineChainAoe * AinzQ_MineChainAoe then
                        set s__AinzSpells__AinzQ_KS_chainTriggered[mine]=true
                        set s__AinzSpells__AinzQ_KS_chainTriggerTick[mine]=s__AinzSpells__AinzQ_KS_currentLoopTick
                    endif
                endif
                set i=i + 1
            endloop
        endfunction

        function s__AinzSpells__AinzQ_KS_CreateMine takes unit NewC,real NewX,real NewY,integer NewMineKind returns nothing
            local integer this= s__AinzSpells__AinzQ_KS__allocate()
            local integer kk= 0
            local integer level= GetUnitAbilityLevel(NewC, AinzQ_ID)
            if level < 1 then
                set level=1
            endif

            set s__AinzSpells__AinzQ_KS_c[this]=NewC
            set s__AinzSpells__AinzQ_KS_owner[this]=GetOwningPlayer(NewC)
            set s__AinzSpells__AinzQ_KS_x[this]=NewX
            set s__AinzSpells__AinzQ_KS_y[this]=NewY
            set s__AinzSpells__AinzQ_KS_r[this]=0.00
            set s__AinzSpells__AinzQ_KS_scan[this]=0.00
            set s__AinzSpells__AinzQ_KS_mineKind[this]=NewMineKind
            set s__AinzSpells__AinzQ_KS_active[this]=true
            set s__AinzSpells__AinzQ_KS_exploded[this]=false
            set s__AinzSpells__AinzQ_KS_armed[this]=false
            set s__AinzSpells__AinzQ_KS_chainTriggered[this]=false
            set s__AinzSpells__AinzQ_KS_chainTriggerTick[this]=0
            set s__AinzSpells__AinzQ_KS_check2[this]=0
            set s__AinzSpells__AinzQ_KS_g[this]=CreateGroup()

            set s__AinzSpells__AinzQ_KS_dmg[this]=GetHeroInt(s__AinzSpells__AinzQ_KS_c[this], true) * ( AinzQ_DamageIntBase + AinzQ_DamageIntStep * ( level - 1 ) )
            set s__AinzSpells__AinzQ_KS_dmg[this]=s__AinzSpells__AinzQ_KS_dmg[this] + AinzQ_Damage2StaticBase + AinzQ_Damage2StaticStep * ( level - 1 )
            set s__AinzSpells__AinzQ_KS_scale[this]=AinzQ_DamageAoe / 375.0

            set s__AinzSpells__AinzQ_KS_e[this]=AddSpecialEffect("war3mapImported\\wos_mineorange.mdl", s__AinzSpells__AinzQ_KS_x[this], s__AinzSpells__AinzQ_KS_y[this])
            call BlzSetSpecialEffectScale(s__AinzSpells__AinzQ_KS_e[this], 0.85)
            call BlzSetSpecialEffectHeight(s__AinzSpells__AinzQ_KS_e[this], 100)
            call BlzSetSpecialEffectTimeScale(s__AinzSpells__AinzQ_KS_e[this], 0.5)
            call BlzSetSpecialEffectYaw(s__AinzSpells__AinzQ_KS_e[this], GetRandomReal(0.00, 360.00) * bj_DEGTORAD)
            call BlzSetSpecialEffectAlpha(s__AinzSpells__AinzQ_KS_e[this], 0)
            set s__AinzSpells__AinzQ_KS_e2[this]=EffectSpawnScale("war3mapImported\\wos_lightning circlered.mdl" , s__AinzSpells__AinzQ_KS_x[this] , s__AinzSpells__AinzQ_KS_y[this] , 1 , 1 , 0.01 , 1 , 1 , 0.01 , 1.425 * s__AinzSpells__AinzQ_KS_scale[this])
            call VisionTimed(s__AinzSpells__AinzQ_KS_owner[this] , s__AinzSpells__AinzQ_KS_x[this] , s__AinzSpells__AinzQ_KS_y[this] , AinzQ_MineTriggerAoe , 1.00)
            call BlzSetSpecialEffectAlpha(s__AinzSpells__AinzQ_KS_e2[this], 0)

            set kk=0
            loop
                exitwhen kk == 10
                if IsPlayerAlly(GetOwningPlayer(s__AinzSpells__AinzQ_KS_c[this]), Player(kk)) then
                    if GetLocalPlayer() == Player(kk) then
                        call BlzSetSpecialEffectAlpha(s__AinzSpells__AinzQ_KS_e[this], 255)
                        call BlzSetSpecialEffectAlpha(s__AinzSpells__AinzQ_KS_e2[this], 255)
                    endif
                endif
                set kk=kk + 1
            endloop

            set s__AinzSpells__AinzQ_KS_MUI_AinzQ=s__AinzSpells__AinzQ_KS_MUI_AinzQ + 1
            set s__AinzSpells__AinzQ_KS_m_AinzQ[s__AinzSpells__AinzQ_KS_MUI_AinzQ]=this
            if s__AinzSpells__AinzQ_KS_MUI_AinzQ == 0 then
                call AinzSpells__AinzTimer03Acquire()
            endif
        endfunction

        function s__AinzSpells__AinzQ_KS_Loop_AinzQ takes nothing returns nothing
            local integer i= 0
            local integer this

            set s__AinzSpells__AinzQ_KS_currentLoopTick=s__AinzSpells__AinzQ_KS_currentLoopTick + 1

            loop
                exitwhen i > s__AinzSpells__AinzQ_KS_MUI_AinzQ
                set this=s__AinzSpells__AinzQ_KS_m_AinzQ[i]

                if s__AinzSpells__AinzQ_KS_active[this] then
                    if s__AinzSpells__AinzQ_KS_chainTriggered[this] then
                        if s__AinzSpells__AinzQ_KS_chainTriggerTick[this] < s__AinzSpells__AinzQ_KS_currentLoopTick then
                            set s__AinzSpells__AinzQ_KS_chainTriggered[this]=false
                            call s__AinzSpells__AinzQ_KS_Explode(this)
                        endif
                    else
                        set s__AinzSpells__AinzQ_KS_r[this]=s__AinzSpells__AinzQ_KS_r[this] + 0.03
                        if not s__AinzSpells__AinzQ_KS_armed[this] and s__AinzSpells__AinzQ_KS_r[this] >= s__AinzSpells__AinzQ_KS_ARM_DELAY then
                            set s__AinzSpells__AinzQ_KS_armed[this]=true
                            set s__AinzSpells__AinzQ_KS_scan[this]=0.00
                        endif

                        if s__AinzSpells__AinzQ_KS_r[this] >= AinzQ_MineDuration or ( s__AinzSpells__AinzQ_KS_mineKind[this] == s__AinzSpells__AinzQ_KS_MINE_KIND_Q2 and s__AinzSpells__AinzQ_KS_r[this] >= AinzQ2_MineDuration ) then
                            set s__AinzSpells__AinzQ_KS_active[this]=false
                        elseif s__AinzSpells__AinzQ_KS_armed[this] then
                            set s__AinzSpells__AinzQ_KS_scan[this]=s__AinzSpells__AinzQ_KS_scan[this] + 0.03
                            if s__AinzSpells__AinzQ_KS_scan[this] >= 0.09 then
                                set s__AinzSpells__AinzQ_KS_scan[this]=0.00
                                if s__AinzSpells__AinzQ_KS_HasEnemyNearby(this) then
                                    call s__AinzSpells__AinzQ_KS_Explode(this)
                                endif
                            endif
                        endif
                    endif
                endif

                if not s__AinzSpells__AinzQ_KS_active[this] then
                    call DestroyEffect(s__AinzSpells__AinzQ_KS_e[this])
                    call DestroyEffect(s__AinzSpells__AinzQ_KS_e2[this])
                    set s__AinzSpells__AinzQ_KS_e2[this]=null
                    call DestroyGroup(s__AinzSpells__AinzQ_KS_g[this])
                    set s__AinzSpells__AinzQ_KS_e[this]=null
                    set s__AinzSpells__AinzQ_KS_g[this]=null
                    set s__AinzSpells__AinzQ_KS_c[this]=null
                    set s__AinzSpells__AinzQ_KS_owner[this]=null

                    set s__AinzSpells__AinzQ_KS_m_AinzQ[i]=s__AinzSpells__AinzQ_KS_m_AinzQ[s__AinzSpells__AinzQ_KS_MUI_AinzQ]
                    set s__AinzSpells__AinzQ_KS_MUI_AinzQ=s__AinzSpells__AinzQ_KS_MUI_AinzQ - 1

                    if s__AinzSpells__AinzQ_KS_MUI_AinzQ == - 1 then
                        call AinzSpells__AinzTimer03Release()
                    endif

                    call s__AinzSpells__AinzQ_KS_deallocate(this)
                    set i=i - 1
                endif

                set i=i + 1
            endloop
        endfunction

        function s__AinzSpells__AinzQ_KS_AinzQ_Start takes unit NewC,real NewX,real NewY returns nothing
            if not s__AinzSpells__AinzQ_KS_IsMinePositionFree(NewX , NewY) then
                call s__AinzSpells__AinzQ_KS_RefundCast(NewC)
                return
            endif

            call AinzSpells__AinzSwapPatch(NewC , AinzQ_ID , 0)
            call SetUnitFacing(NewC, GAngle2(NewC , NewX , NewY) * bj_RADTODEG)
            call MakeSound("war3mapimported\\Hero_Ainz_Q")
            call s__AinzSpells__AinzQ_KS_CreateMine(NewC , NewX , NewY , s__AinzSpells__AinzQ_KS_MINE_KIND_Q)
            call Ainz_RestoreOrder(NewC , - 1)
        endfunction

        function s__AinzSpells__AinzQ_KS_AinzQ2_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer i= 0
            local real angle
            local real px
            local real py

            if not s__AinzSpells__AinzQ_KS_CanPlaceRing(NewX , NewY) then
                call s__AinzSpells__AinzQ_KS_RefundCast(NewC)
                return
            endif

            call AinzSpells__AinzSwapPatch(NewC , AinzQ_ID , 0)
            call SetUnitFacing(NewC, GAngle2(NewC , NewX , NewY) * bj_RADTODEG)
            call MakeSound("war3mapimported\\Hero_Ainz_Q3")
            loop
                exitwhen i >= AinzQ2_MineCount
                set angle=( 360.00 / I2R(AinzQ2_MineCount) ) * I2R(i) * bj_DEGTORAD
                set px=NewX + AinzQ2_MineOffset * Cos(angle)
                set py=NewY + AinzQ2_MineOffset * Sin(angle)
                call s__AinzSpells__AinzQ_KS_CreateMine(NewC , px , py , s__AinzSpells__AinzQ_KS_MINE_KIND_Q2)
                set i=i + 1
            endloop
            call AinzSpells__AinzFinishSwap(NewC , AinzQ_ID)
            call Ainz_RestoreOrder(NewC , - 1)
        endfunction


        function s__AinzSpells__AinzW_KS_OnknightAcquire takes nothing returns nothing
            local unit knight= GetTriggerUnit()
            local unit target= GetEventTargetUnit()
            local unit caster= LoadUnitHandle(hs, GetHandleId(knight), AinzSpells__SH_AINZW_CASTER)
            if caster != null and target != null and SpellBool(target) and IsUnitEnemy(target, GetOwningPlayer(caster)) then
                call SaveUnitHandle(hs, GetHandleId(knight), AinzSpells__SH_AINZW_TARGET, target)
            endif
            set knight=null
            set target=null
            set caster=null
        endfunction

        // Called by DmgSys for a knight's attack hit (no per-knight damage trigger).
        function s__AinzSpells__AinzW_KS_OnKnightHit takes unit knight,unit target returns nothing
            local unit caster= LoadUnitHandle(hs, GetHandleId(knight), AinzSpells__SH_AINZW_CASTER)
            if caster != null and target != null and SpellBool(target) and IsUnitEnemy(target, GetOwningPlayer(caster)) then
                call SaveUnitHandle(hs, GetHandleId(knight), AinzSpells__SH_AINZW_TARGET, target)
            endif
            set caster=null
        endfunction

        function s__AinzSpells__AinzW_KS_InitknightEvents takes nothing returns nothing
            call TriggerAddAction(s__AinzSpells__AinzW_KS_knightAcquireTrig, function s__AinzSpells__AinzW_KS_OnknightAcquire)
        endfunction

        function s__AinzSpells__AinzW_KS_Loop_AinzW2 takes nothing returns nothing
            local integer this
