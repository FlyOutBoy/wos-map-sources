    function OnClickInori takes nothing returns nothing
        local framehandle clicked= BlzGetTriggerFrame()
        local integer k= 0
        local player p= GetTriggerPlayer()
        local integer k2= GetPlayerId(p)
        if clicked == s__inori_frame_pas5[k2] then
            call SaveInteger(hs, GetHandleId(Hero[k2]), InoriSpells___SH_CURRENT_T, InoriT_ID)
            if GetLocalPlayer() == p then
                call BlzFrameSetTexture(s__inori_frame_pas9[k2], "UI\\WOS\\pick-confirm.tga", 0, true)
            endif
            call BlzFrameSetEnable(s__inori_frame_pas10[k2], true)
            // Checkpoint 25: a click on the weapon confirms it right away.
            set clicked=s__inori_frame_pas10[k2]
        endif
        if clicked == s__inori_frame_pas7[k2] then
            call SaveInteger(hs, GetHandleId(Hero[k2]), InoriSpells___SH_CURRENT_T, InoriT2_ID)
            if GetLocalPlayer() == p then
                call BlzFrameSetTexture(s__inori_frame_pas9[k2], "UI\\WOS\\pick-confirm.tga", 0, true)
            endif
            call BlzFrameSetEnable(s__inori_frame_pas10[k2], true)
            // Checkpoint 25: a click on the weapon confirms it right away.
            set clicked=s__inori_frame_pas10[k2]
        endif
        if clicked == s__inori_frame_pas10[k2] then
            set k=LoadInteger(hs, GetHandleId(Hero[k2]), InoriSpells___SH_CURRENT_T)
            if k == InoriT_ID then
                call SetPlayerAbilityAvailable(Player(k2), k, true)
                call SetPlayerAbilityAvailable(Player(k2), InoriT2_ID, false)
            else
                call SetPlayerAbilityAvailable(Player(k2), k, true)
                call SetPlayerAbilityAvailable(Player(k2), InoriT_ID, false)
            endif
            call InoriE_UpdateAura(Hero[k2])
            if GetLocalPlayer() == p then
                call BlzFrameSetVisible(s__inori_frame_pas1[k2], false)
            endif
        endif
        if clicked == s__inori_frame_pas12[k2] then
            if GetLocalPlayer() == p then
                call BlzFrameSetVisible(s__inori_frame_pas1[k2], false)
            endif
        endif
        set p=null
        set clicked=null
        call WUI_ReleaseClickFocus()
    endfunction
