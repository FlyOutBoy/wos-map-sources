        set s__GearSystems2___KS_DamageOverTime_r2[this]=0.05
    endif
    // round to nearest instead of truncating
    set totalTicks=R2I(NewDuration / s__GearSystems2___KS_DamageOverTime_r2[this] + 0.5)
    if totalTicks < 1 then
        set totalTicks=1
    endif
    set s__GearSystems2___KS_DamageOverTime_rmax[this]=totalTicks // store as tick count
    set s__GearSystems2___KS_DamageOverTime_dmg[this]=NewDmg / totalTicks
    if s__GearSystems2___KS_DamageOverTime_MUI_5 == 0 then
        call GearTimer05Acquire()
    endif
endfunction



        function s__GearSystems2___KS_SpellTimer_LoopSpellTimer takes nothing returns nothing
