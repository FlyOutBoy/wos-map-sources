        function s__AstaSpells__AstaSpells_Q_AstaQ3_Start takes unit NewC,real NewX,real NewY,integer NewK returns nothing
            local integer this= s__AstaSpells__AstaSpells_Q__allocate()
            local integer level= GetUnitAbilityLevel(NewC, AstaQ2_ID)
            if level < 1 then
                set level=1
            endif
            set s__AstaSpells__AstaSpells_Q_MUI_AstaQ3=s__AstaSpells__AstaSpells_Q_MUI_AstaQ3 + 1
            set s__AstaSpells__AstaSpells_Q_m_AstaQ3[s__AstaSpells__AstaSpells_Q_MUI_AstaQ3]=this
            set s__AstaSpells__AstaSpells_Q_c[this]=NewC
            set s__AstaSpells__AstaSpells_Q_x[this]=NewX
            set s__AstaSpells__AstaSpells_Q_y[this]=NewY
            set s__AstaSpells__AstaSpells_Q_r[this]=0.0
            set s__AstaSpells__AstaSpells_Q_r5[this]=0.0
            set s__AstaSpells__AstaSpells_Q_r6[this]=AstaQ2_RangeBase + AstaQ2_RangeStep * ( level - 1 )
            set s__AstaSpells__AstaSpells_Q_r2[this]=1.0
            set s__AstaSpells__AstaSpells_Q_g[this]=CreateGroup()
            set s__AstaSpells__AstaSpells_Q_g2[this]=CreateGroup()
            call StartSpellUnit2(s__AstaSpells__AstaSpells_Q_c[this])
            set s__AstaSpells__AstaSpells_Q_u[this]=null
            set s__AstaSpells__AstaSpells_Q_a[this]=GAngle2(s__AstaSpells__AstaSpells_Q_c[this] , s__AstaSpells__AstaSpells_Q_x[this] , s__AstaSpells__AstaSpells_Q_y[this])
            set s__AstaSpells__AstaSpells_Q_rmax[this]=AstaQ2_Duration
            set s__AstaSpells__AstaSpells_Q_move[this]=80.0
            set s__AstaSpells__AstaSpells_Q_aoe[this]=AstaQ2_DamageAoe
            set s__AstaSpells__AstaSpells_Q_dmg[this]=GetHeroAgi(s__AstaSpells__AstaSpells_Q_c[this], true) * ( AstaQ2_DamageAgiBase + AstaQ2_DamageAgiStep * ( level - 1 ) ) + AstaQ2_Damage2StaticBase + AstaQ2_Damage2StaticStep * ( level - 1 )
            call SetUnitFacing(s__AstaSpells__AstaSpells_Q_c[this], s__AstaSpells__AstaSpells_Q_a[this] * bj_RADTODEG)
            call SetUnitAnimationByIndex(s__AstaSpells__AstaSpells_Q_c[this], 3)
            call SetUnitTimeScale(s__AstaSpells__AstaSpells_Q_c[this], 0.7)
            set s__AstaSpells__AstaSpells_Q_x1[this]=GetUnitX(s__AstaSpells__AstaSpells_Q_c[this]) - 200 * Cos(s__AstaSpells__AstaSpells_Q_a[this])
            set s__AstaSpells__AstaSpells_Q_y1[this]=GetUnitY(s__AstaSpells__AstaSpells_Q_c[this]) - 200 * Sin(s__AstaSpells__AstaSpells_Q_a[this])
            set s__AstaSpells__AstaSpells_Q_check2[this]=0
            if NewK == 1 then
                set s__AstaSpells__AstaSpells_Q_check2[this]=1
                set s__AstaSpells__AstaSpells_Q_e[this]=EffectSpawn4("war3mapImported\\wos_blackslash.mdx" , s__AstaSpells__AstaSpells_Q_x1[this] - 50 * Cos(s__AstaSpells__AstaSpells_Q_a[this] - 90 * bj_DEGTORAD) , s__AstaSpells__AstaSpells_Q_y1[this] - 50 * Sin(s__AstaSpells__AstaSpells_Q_a[this] - 90 * bj_DEGTORAD) , s__AstaSpells__AstaSpells_Q_a[this] * bj_RADTODEG , 0.65 , 0.5 , 175 , - 35)
                set s__AstaSpells__AstaSpells_Q_a[this]=s__AstaSpells__AstaSpells_Q_a[this] - 4 * bj_DEGTORAD
            else
                set s__AstaSpells__AstaSpells_Q_a[this]=s__AstaSpells__AstaSpells_Q_a[this] + 4 * bj_DEGTORAD
                set s__AstaSpells__AstaSpells_Q_e[this]=EffectSpawn4("war3mapImported\\wos_blackslash.mdx" , s__AstaSpells__AstaSpells_Q_x1[this] - 50 * Cos(s__AstaSpells__AstaSpells_Q_a[this] + 90 * bj_DEGTORAD) , s__AstaSpells__AstaSpells_Q_y1[this] - 50 * Sin(s__AstaSpells__AstaSpells_Q_a[this] + 90 * bj_DEGTORAD) , s__AstaSpells__AstaSpells_Q_a[this] * bj_RADTODEG , 0.65 , 0.5 , 175 , - 325)
            endif
            set s__AstaSpells__AstaSpells_Q_e3[this]=EffectSpawn("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl" , (BlzGetLocalSpecialEffectX((s__AstaSpells__AstaSpells_Q_e[this]))) , (BlzGetLocalSpecialEffectY((s__AstaSpells__AstaSpells_Q_e[this]))) , s__AstaSpells__AstaSpells_Q_a[this] * bj_RADTODEG , 0.65 , 3 , 135) // INLINED!!
            set s__AstaSpells__AstaSpells_Q_scale[this]=1.0
            set s__AstaSpells__AstaSpells_Q_k3[this]=0
            if GetUnitAbilityLevel(s__AstaSpells__AstaSpells_Q_c[this], AstaSword2_ID) > 0 then
                set s__AstaSpells__AstaSpells_Q_k3[this]=1
                set s__AstaSpells__AstaSpells_Q_scale[this]=( 1.0 + ( AstaTQ_AoeBonus / 100.0 ) )
                set s__AstaSpells__AstaSpells_Q_aoe[this]=s__AstaSpells__AstaSpells_Q_aoe[this] * ( 1.0 + ( AstaTQ_AoeBonus / 100.0 ) )
                set s__AstaSpells__AstaSpells_Q_dmg[this]=s__AstaSpells__AstaSpells_Q_dmg[this] + AstaTQ_DmgBonus * GetHeroAgi(s__AstaSpells__AstaSpells_Q_c[this], true)
                call BlzSetSpecialEffectHeight(s__AstaSpells__AstaSpells_Q_e[this], BlzGetLocalSpecialEffectZ(s__AstaSpells__AstaSpells_Q_e[this]) * ( 1.0 + ( AstaTQ_AoeBonus / 100.0 ) ))
            endif
            set s__AstaSpells__AstaSpells_Q_dmg[this]=s__AstaSpells__AstaSpells_Q_dmg[this] / 2.0
            call ScaleEffDummy(s__AstaSpells__AstaSpells_Q_e[this] , 0.3 , 0.5 , s__AstaSpells__AstaSpells_Q_scale[this] * 2.4)
            if s__AstaSpells__AstaSpells_Q_MUI_AstaQ3 == 0 then
                call AstaSpells__AstaTimer03Acquire()
            endif
        endfunction

        function s__AstaSpells__AstaSpells_Q_Loop_AstaQ2 takes nothing returns nothing
            local integer this
