    function SwapAbility takes unit c,real r,integer id_new,integer id_old returns nothing
        call s__GearSystems2___KS_SpellTimer_SpellTimer_Timer_Start(c , r , id_new , id_old , 0)
    endfunction    
    function SwapAbilityBuff takes unit c,integer id_new,integer id_old,integer buff_id returns nothing
        call s__GearSystems2___KS_SpellTimer_SpellTimer_Timer_Start(c , 0 , id_new , id_old , buff_id)
    endfunction
    function UnitSpawn takes player p,integer id,real x,real y,real facing,real timescale,real scale,real height,real timeexpire returns unit
        local unit u= CreateUnit(p, id, x, y, facing)
        call SetUnitTimeScale(u, timescale)
        call SetFly(u , height)
        call SetScale(u , scale)
        call s__GearSystems2___KS_RemoveUnit_MyRemoveUnit_Start((u ) , (( timeexpire)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
        return u
    endfunction
    function UnitSpawn0 takes player p,integer id,real x,real y,real facing,real timescale,real scale,real height returns unit
        local unit u= CreateUnit(p, id, x, y, facing)
        call SetUnitTimeScale(u, timescale)
        call SetFly(u , height)
        call SetScale(u , scale)
        return u
    endfunction
    function UnitSpawnColor takes player p,integer id,real x,real y,real facing,real timescale,real scale,real height,real timeexpire,integer red,integer green,integer blue,integer alpha returns unit
        local unit u= CreateUnit(p, id, x, y, facing)
        call SetUnitTimeScale(u, timescale)
        call SetFly(u , height)
        call SetScale(u , scale)
        call s__GearSystems2___KS_RemoveUnit_MyRemoveUnit_Start((u ) , (( timeexpire)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
        call SetUnitVertexColor(u, red, green, blue, alpha)
        return u
    endfunction
    function UnitSpawn2 takes player p,integer id,real x,real y,real facing,real timescale,real scale,real height,real timedelay,real timeexpire,integer red,integer green,integer blue,integer alpha returns unit
        local unit u= CreateUnit(p, id, x, y, facing)
        call SetUnitTimeScale(u, timescale)
        call SetFly(u , height)
        call SetScale(u , scale)
        call SetUnitVertexColor(u, red, green, blue, alpha)
        call ColorDummy3(u , timedelay , red , green , blue , timeexpire)
        return u
    endfunction
    function ReduceCooldown takes unit u,integer abilId,real amount returns nothing
        local real cd= BlzGetUnitAbilityCooldownRemaining(u, abilId)
        local real cd2= cd - amount
        if cd2 < 0.00 then
            set cd2=0.01
        endif
        if cd > 0 then
        call BlzStartUnitAbilityCooldown(u, abilId, cd2)
        endif
    endfunction
    // Same as IntegerCd with a key hashed once at map load (SH_ICD_* globals).
    function IntegerCdKey takes unit c,integer key,real cd returns boolean
    local integer hid= GetHandleId(c)
    if LoadInteger(hs, hid, key) == 0 then
    call SaveInteger(hs, hid, key, 1)
    call s__GearSystems2___KS_Flush_Start((hid ) , ( key ) , ( 0 ) , (( cd)*1.0)) // INLINED!!
    return true
    endif
    return false
    endfunction
    function IntegerCd takes unit c,string s,real cd returns boolean
    local integer hid= GetHandleId(c)
    local integer key= StringHash(s)
    if LoadInteger(hs, hid, key) == 0 then
    call SaveInteger(hs, hid, key, 1)
    call s__GearSystems2___KS_Flush_Start((hid ) , ( key ) , ( 0 ) , (( cd)*1.0)) // INLINED!!
    return true
    endif
    return false
    endfunction

function GearSystems2___GearTimer03Loop takes nothing returns nothing
    call s__GearSystems2___KS_Flush_Loop()
    call s__GearSystems2___KS_FlushBuff_Loop()
    call s__GearSystems2___KS_AddMana_Loop()
    call s__GearSystems2___KS_FlushReal_Loop()
    call s__GearSystems2___KS_RemoveUnit_Loop_MyRemoveUnit()
    call s__GearSystems2___KS_RemoveEffect_Loop_MyRemoveEff()
    call s__GearSystems2___KS_MoveUnit_Loop_MUE()
    call s__GearSystems2___KS_UnitHeight_LoopHeightSet()
    call s__GearSystems2___KS_UnitColor_Loop_ColorDummy()
    call s__GearSystems2___KS_EffectColor_Loop_ColorEffDummy()
    call s__GearSystems2___KS_MoveEffectToUnit_Loop_MoveEffectToUnit()
    call s__GearSystems2___KS_MoveUnitToUnit_Loop_MoveUnitToUnit()
    call s__GearSystems2___KS_DelayedDamage_Loop_NextDmg()
    call s__GearSystems2___KS_UnitScale_Loop_ScaleDummy()
    call s__GearSystems2___KS_MoveEffect_Loop_EMUE()
    call s__GearSystems2___KS_EffectScale_Loop_ScaleEffDummy()
    call s__GearSystems2___KS_LightningColor_Loop_ColorLightning()
    call s__GearSystems2___KS_Fear_Loop_Fear()
    call s__GearSystems2___KS_EffectHeight_ELoopHeightSet()
    call s__GearSystems2___KS_RemoveDestructable_Loop_MyRemoveDest()
    call s__GearSystems2___KS_FlushInteger_Loop_MyFlushIntegerC()
    // Listeners are conditions: evaluated in this thread, no new action thread per tick.
    call TriggerEvaluate(GearTimer03Listeners)
endfunction

function GearSystems2___GearTimer05Loop takes nothing returns nothing
    call s__GearSystems2___KS_DamageOverTime_Loop_DmgPTime()
    call s__GearSystems2___KS_SpellTimer_LoopSpellTimer()
    call s__GearSystems2___KS_RemoveFog_Loop_MyRemoveFogModifier()
    call s__GearSystems2___KS_BlockRegen_Loop_BlockHpRegen()
    call s__GearSystems2___KS_HealOverTime_Loop_HpS()
    call s__GearSystems2___KS_TextTagDelay_Loop_TT_DELAY()
    call s__GearSystems2___KS_Cooldown_Loop_NextCD()
    call s__GearSystems2___KS_ItemStacks_Loop_AddStacks()
    call s__KS_SpellStacks_Loop_AddSpellStacks()
endfunction

function GearSystems2___GearTimer10Loop takes nothing returns nothing
    call s__GearSystems2___KS_RemoveAbility_Loop_RemoveAbility()
    call s__GearSystems2___KS_RemoveAbility2_Loop_RemoveAbility()
    call s__GearSystems2___KS_DelayedSound_Loop_NextSound()
    call s__GearSystems2___KS_AbilityLevel_Loop_SetAbilityLevel()
    call s__GearSystems2___KS_BuffTimer_Loop_MyBuffTime()
    call s__GearSystems2___KS_BuffEffect_Loop_MyBuffEff()
endfunction

function GearSystems2___InitGearSystems2 takes nothing returns nothing
    set GearTimer03Callback=function GearSystems2___GearTimer03Loop
    set GearTimer05Callback=function GearSystems2___GearTimer05Loop
    set GearTimer10Callback=function GearSystems2___GearTimer10Loop
    // Game clock of the scripted regen windows (started here, never from a local block).
    call TimerStart(HealRegenClock, 100000000.0, false, null)
    set GearTimer03Users=0
    set GearTimer05Users=0
    set GearTimer10Users=0
    set GearTimer03=CreateTimer()
    set GearTimer05=CreateTimer()
    set GearTimer10=CreateTimer()
endfunction


