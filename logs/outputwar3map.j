                                    set y=(BlzGetLocalSpecialEffectY((s___PatriotSpells___PatriotSpells_R_ee[s__PatriotSpells___PatriotSpells_R_ee[this]+s__PatriotSpells___PatriotSpells_R_k[this]]))) // INLINED!!
                                    call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_BY_Wood_Effect_Kula_2_YiYingCun2.mdl" , x + 250.0 * Cos(s__PatriotSpells___PatriotSpells_R_a[this]) , y + 250.0 * Sin(s__PatriotSpells___PatriotSpells_R_a[this]) , s__PatriotSpells___PatriotSpells_R_a[this] * bj_RADTODEG , 0.90 , 2.25 , 50.0 , 255 , 255 , 255 , 190))
                                    set s__PatriotSpells___PatriotSpells_R_k[this]=s__PatriotSpells___PatriotSpells_R_k[this] + 1
                                endloop
