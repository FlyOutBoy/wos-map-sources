        // Returns true when the instance is finished.
        function s__ItemsElementsFx_update takes integer this returns boolean
            local real dx
            local real dy
            local real d
            local real a
            local real take
            local integer m
            local unit v
            local unit a1
            local unit b1
            local real best
            local real px
            local real py
            local unit array hits
            local boolean showVision
            set s__ItemsElementsFx_left[this]=s__ItemsElementsFx_left[this] - s__ItemsElementsFx_DT
            // One refresh per 0.15 seconds; 0.30 sec reveal overlaps until the next.
            set showVision=ModuloInteger(R2I(s__ItemsElementsFx_left[this] * 1000.0 + 0.5), 150) < 30
            if s__ItemsElementsFx_c[this] == null or GetUnitTypeId(s__ItemsElementsFx_c[this]) == 0 then
                return true
            endif
            if s__ItemsElementsFx_buffId[this] != 0 then
                set s__ItemsElementsFx_buffWait[this]=s__ItemsElementsFx_buffWait[this] - s__ItemsElementsFx_DT
                if GetUnitAbilityLevel(s__ItemsElementsFx_u[this], s__ItemsElementsFx_buffId[this]) == 0 and s__ItemsElementsFx_buffWait[this] <= 0.0 then
                    return true
                endif
                if s__ItemsElementsFx_kind[this] == s__ItemsElementsFx_CINDER then
                    set s__ItemsElementsFx_next[this]=s__ItemsElementsFx_next[this] - s__ItemsElementsFx_DT
                endif
                if s__ItemsElementsFx_kind[this] == s__ItemsElementsFx_CINDER and s__ItemsElementsFx_next[this] <= 0.0 and GetUnitAbilityLevel(s__ItemsElementsFx_u[this], s__ItemsElementsFx_buffId[this]) > 0 then
                    set s__ItemsElementsFx_next[this]=0.25
                    // Cancel native attribute/item regen by an additive offset; restore exactly on cleanup.
                    set d=RMaxBJ(0.0, GetHpRegenBase(s__ItemsElementsFx_u[this]))
                    if d > 0.0 then
                        set take=BlzGetUnitRealField(s__ItemsElementsFx_u[this], UNIT_RF_HIT_POINTS_REGENERATION_RATE)
                        call BlzSetUnitRealField(s__ItemsElementsFx_u[this], UNIT_RF_HIT_POINTS_REGENERATION_RATE, take - d)
                        set s__ItemsElementsFx_hpOffset[this]=s__ItemsElementsFx_hpOffset[this] + take - BlzGetUnitRealField(s__ItemsElementsFx_u[this], UNIT_RF_HIT_POINTS_REGENERATION_RATE)
                    endif
                    set d=RMaxBJ(0.0, GetMpRegenNative(s__ItemsElementsFx_u[this]))
                    if d > 0.0 then
                        set take=BlzGetUnitRealField(s__ItemsElementsFx_u[this], UNIT_RF_MANA_REGENERATION)
                        call BlzSetUnitRealField(s__ItemsElementsFx_u[this], UNIT_RF_MANA_REGENERATION, take - d)
                        set s__ItemsElementsFx_mpOffset[this]=s__ItemsElementsFx_mpOffset[this] + take - BlzGetUnitRealField(s__ItemsElementsFx_u[this], UNIT_RF_MANA_REGENERATION)
                    endif
                endif
            endif
            if s__ItemsElementsFx_kind[this] == s__ItemsElementsFx_DISARM then
                return not ItemsSpells__ElemAlive(s__ItemsElementsFx_u[this]) or s__ItemsElementsFx_left[this] <= 0.0
            elseif s__ItemsElementsFx_kind[this] == s__ItemsElementsFx_PROJ then
                if not ItemsSpells__ElemAlive(s__ItemsElementsFx_u[this]) then
                    return true
                endif
                set dx=GetUnitX(s__ItemsElementsFx_u[this]) - s__ItemsElementsFx_x[this]
                set dy=GetUnitY(s__ItemsElementsFx_u[this]) - s__ItemsElementsFx_y[this]
                if dx * dx + dy * dy <= ( s__ItemsElementsFx_vx[this] + 40.0 ) * ( s__ItemsElementsFx_vx[this] + 40.0 ) then
                    call s__ItemsElementsFx_Arrive(this)
                    return true
                endif
                set a=Atan2(dy, dx)
                set s__ItemsElementsFx_x[this]=s__ItemsElementsFx_x[this] + s__ItemsElementsFx_vx[this] * Cos(a)
                set s__ItemsElementsFx_y[this]=s__ItemsElementsFx_y[this] + s__ItemsElementsFx_vx[this] * Sin(a)
                call BlzSetSpecialEffectX(s__ItemsElementsFx_e[this], s__ItemsElementsFx_x[this])
                call BlzSetSpecialEffectY(s__ItemsElementsFx_e[this], s__ItemsElementsFx_y[this])
                call BlzSetSpecialEffectYaw(s__ItemsElementsFx_e[this], a)
                if showVision then
                    call VisionTimed(GetOwningPlayer(s__ItemsElementsFx_c[this]) , s__ItemsElementsFx_x[this] , s__ItemsElementsFx_y[this] , 750.0 , 0.3)
                endif
                call DecorRemove(s__ItemsElementsFx_c[this] , s__ItemsElementsFx_x[this] , s__ItemsElementsFx_y[this] , 150.0 , ItemActive_DecorDamage)
                return s__ItemsElementsFx_left[this] <= 0.0
            elseif s__ItemsElementsFx_kind[this] == s__ItemsElementsFx_SEALCAST then
                if s__ItemsElementsFx_phase[this] == 0 then
                    if not ItemsSpells__ElemValid(s__ItemsElementsFx_c[this] , s__ItemsElementsFx_u[this]) then
                        return true
                    endif
                    call BlzSetSpecialEffectX(s__ItemsElementsFx_e[this], GetUnitX(s__ItemsElementsFx_u[this]))
                    call BlzSetSpecialEffectY(s__ItemsElementsFx_e[this], GetUnitY(s__ItemsElementsFx_u[this]))
                    if showVision then
                        call VisionTimed(GetOwningPlayer(s__ItemsElementsFx_c[this]) , GetUnitX(s__ItemsElementsFx_u[this]) , GetUnitY(s__ItemsElementsFx_u[this]) , 750.0 , 0.3)
                    endif
                    set s__ItemsElementsFx_next[this]=s__ItemsElementsFx_next[this] - s__ItemsElementsFx_DT
                    set d=RMaxBJ(0.0, s__ItemsElementsFx_next[this] / 0.30)
                    call BlzSetSpecialEffectZ(s__ItemsElementsFx_e[this], s__ItemsElementsFx_dmg2[this] + 1500.0 * d * d)
                    set s__ItemsElementsFx_step[this]=s__ItemsElementsFx_step[this] + 0.03
                    call BlzSetSpecialEffectTimeScale(s__ItemsElementsFx_e[this], s__ItemsElementsFx_step[this])
                    if s__ItemsElementsFx_next[this] <= 0.000001 then
                        set s__ItemsElementsFx_phase[this]=1
                        call s__ItemsElementsFx_Arrive(this)
                        call BlzSetSpecialEffectTimeScale(s__ItemsElementsFx_e[this], 2.0)
                        call DestroyEffect(s__ItemsElementsFx_e[this])
                        set s__ItemsElementsFx_e[this]=null
                        return true
                    endif
                endif
                return s__ItemsElementsFx_left[this] <= 0.0
            elseif s__ItemsElementsFx_kind[this] == s__ItemsElementsFx_MOVE then
                if not ItemsSpells__ElemAlive(s__ItemsElementsFx_u[this]) or s__ItemsElementsFx_charges[this] <= 0 or not ItemsSpells__ElemStep(s__ItemsElementsFx_u[this] , s__ItemsElementsFx_vx[this] , s__ItemsElementsFx_vy[this]) then
                    return true
                endif
                set s__ItemsElementsFx_charges[this]=s__ItemsElementsFx_charges[this] - 1
                return s__ItemsElementsFx_charges[this] <= 0
            elseif s__ItemsElementsFx_kind[this] == s__ItemsElementsFx_DOT then
                if not ItemsSpells__ElemAlive(s__ItemsElementsFx_u[this]) then
                    return true
                endif
                set s__ItemsElementsFx_next[this]=s__ItemsElementsFx_next[this] - s__ItemsElementsFx_DT
                if s__ItemsElementsFx_next[this] <= 0.0 then
                    set s__ItemsElementsFx_next[this]=s__ItemsElementsFx_next[this] + s__ItemsElementsFx_step[this]
                    set s__ItemsElementsFx_charges[this]=s__ItemsElementsFx_charges[this] - 1
                    if SpellBool(s__ItemsElementsFx_u[this]) then
                        set d=ItemsSpells__ElemHit(s__ItemsElementsFx_c[this] , s__ItemsElementsFx_u[this] , s__ItemsElementsFx_src[this] , s__ItemsElementsFx_dmg[this] , s__ItemsElementsFx_phase[this] == 1 , 0)
                        if s__ItemsElementsFx_phase[this] == 2 then
                            set d=d * LeviathanGrasp_Heal / 100.0
                            if d > 0.0 then
                                call SetHpCurrent2(s__ItemsElementsFx_c[this] , s__ItemsElementsFx_c[this] , d)
                            endif
                        endif
                    endif
                    return s__ItemsElementsFx_charges[this] <= 0
                endif
                return s__ItemsElementsFx_left[this] <= 0.0
            elseif s__ItemsElementsFx_kind[this] == s__ItemsElementsFx_ANCHOR then
                set s__ItemsElementsFx_step[this]=s__ItemsElementsFx_step[this] + s__ItemsElementsFx_DT
                if s__ItemsElementsFx_charges[this] < 3 then
                    set d=RMaxBJ(0.0, RMinBJ(1.0, ( s__ItemsElementsFx_step[this] - ( s__ItemsElementsFx_next[this] - 0.6 ) ) / 0.6))
                    set a=d * d * ( 3.0 - 2.0 * d )
                    if s__ItemsElementsFx_charges[this] == 0 then
                        set best=s__ItemsElementsFx_dmg2[this] + 250.0 + 1800.0 * ( 1.0 - d * d )
                        set take=- bj_PI + 0.5 * bj_PI * a
                    else
                        set best=s__ItemsElementsFx_dmg2[this] + 250.0 + 2600.0 * d * ( 1.0 - d )
                        set take=0.5 * bj_PI * ( 2.0 * a - 1.0 )
                        if s__ItemsElementsFx_charges[this] == 2 then
                            set take=0.5 * bj_PI * ( 1.0 - 2.0 * a )
                        endif
                    endif
                    call BlzSetSpecialEffectPitch(s__ItemsElementsFx_e[this], take)
                    set take=0.0
                    if s__ItemsElementsFx_charges[this] == 1 then
                        set take=- 80.0 * a
                    elseif s__ItemsElementsFx_charges[this] == 2 then
                        set take=- 80.0 + 160.0 * a
                    endif
                    set s__ItemsElementsFx_x[this]=s__ItemsElementsFx_tx[this] + s__ItemsElementsFx_vx[this] * take
                    set s__ItemsElementsFx_y[this]=s__ItemsElementsFx_ty[this] + s__ItemsElementsFx_vy[this] * take
                    set px=s__ItemsElementsFx_x[this]
                    set py=s__ItemsElementsFx_y[this]
                    call BlzSetSpecialEffectPosition(s__ItemsElementsFx_e[this], px, py, best)
                    if showVision then
                        call VisionTimed(GetOwningPlayer(s__ItemsElementsFx_c[this]) , px , py , RMaxBJ(750.0, LeviathanAnchor_Aoe * 1.5) , 0.3)
                    endif
                    if s__ItemsElementsFx_charges[this] > 0 then
                        call s__ItemsElementsFx_Drag(this,LeviathanAnchor_Aoe , LeviathanAnchor_PullSpeed , 0.0)
                    endif
                    if s__ItemsElementsFx_step[this] + 0.000001 >= s__ItemsElementsFx_next[this] then
                        set s__ItemsElementsFx_charges[this]=s__ItemsElementsFx_charges[this] + 1
                        set s__ItemsElementsFx_next[this]=s__ItemsElementsFx_next[this] + 0.6
                        call ItemsSpells__ElemFx("war3mapImported\\wos_obr08 (214).mdx" , px , py , 1.5)
                        call ItemsSpells__ElemFx("war3mapImported\\wos_yc_bluemorphcircle3.mdl" , px , py , 1.4)
                        call s__ItemsElementsFx_Pulse(this,LeviathanAnchor_Aoe , s__ItemsElementsFx_dmg[this] , false , 2 , 40)
                        call ItemsSpells__ElemFx("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl" , px , py , 1.5)
                        if s__ItemsElementsFx_charges[this] == 3 then
                            call ColorEffDummy3Alpha((s__ItemsElementsFx_e[this] ) , (( 0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.5)*1.0)) // INLINED!!
                            set s__ItemsElementsFx_e[this]=null
                            return true
                        endif
                    endif
                endif
                return s__ItemsElementsFx_left[this] <= 0.0
            elseif s__ItemsElementsFx_kind[this] == s__ItemsElementsFx_STORM or s__ItemsElementsFx_kind[this] == s__ItemsElementsFx_SPIRAL then
                if showVision then
                    if s__ItemsElementsFx_kind[this] == s__ItemsElementsFx_STORM then
                        call VisionTimed(GetOwningPlayer(s__ItemsElementsFx_c[this]) , s__ItemsElementsFx_x[this] , s__ItemsElementsFx_y[this] , RMaxBJ(750.0, ThunderBastion_Aoe * 1.5) , 0.3)
                    else
                        call VisionTimed(GetOwningPlayer(s__ItemsElementsFx_c[this]) , s__ItemsElementsFx_x[this] , s__ItemsElementsFx_y[this] , RMaxBJ(750.0, ConstellationCoil_Aoe * 1.5) , 0.3)
                    endif
                endif
                if s__ItemsElementsFx_kind[this] == s__ItemsElementsFx_SPIRAL then
                    call s__ItemsElementsFx_Drag(this,ConstellationCoil_Aoe , ConstellationCoil_PullSpeed , ConstellationCoil_Spin)
                endif
                set s__ItemsElementsFx_next[this]=s__ItemsElementsFx_next[this] - s__ItemsElementsFx_DT
                if s__ItemsElementsFx_next[this] <= 0.0 and s__ItemsElementsFx_charges[this] < 4 then
                    if s__ItemsElementsFx_kind[this] == s__ItemsElementsFx_STORM then
                        set s__ItemsElementsFx_next[this]=s__ItemsElementsFx_next[this] + s__ItemsElementsFx_step[this]
                    else
                        set s__ItemsElementsFx_next[this]=s__ItemsElementsFx_step[this]
                    endif
                    set s__ItemsElementsFx_charges[this]=s__ItemsElementsFx_charges[this] + 1
                    set a=GetRandomReal(0, 2 * bj_PI)
                    call ItemsSpells__ElemFx("war3mapimported\\wos_longskill_point_10.mdl" , s__ItemsElementsFx_x[this] + 160 * Cos(a) , s__ItemsElementsFx_y[this] + 160 * Sin(a) , 1.0)
                    call ItemsSpells__ElemFx("war3mapimported\\wos_longskill_point_10.mdl" , s__ItemsElementsFx_x[this] - 160 * Cos(a) , s__ItemsElementsFx_y[this] - 160 * Sin(a) , 1.0)
                    if s__ItemsElementsFx_kind[this] == s__ItemsElementsFx_STORM then
                        call s__ItemsElementsFx_Pulse(this,ThunderBastion_Aoe , s__ItemsElementsFx_dmg[this] , true , IntegerTertiaryOp(s__ItemsElementsFx_charges[this] == 1, 3, 0) , 0)
                    else
                        call s__ItemsElementsFx_Pulse(this,ConstellationCoil_Aoe , s__ItemsElementsFx_dmg[this] , true , IntegerTertiaryOp(s__ItemsElementsFx_charges[this] == 1, 3, 0) , 0)
                    endif
                endif
                if s__ItemsElementsFx_left[this] > 0.0 then
                    return false
                endif
                if s__ItemsElementsFx_kind[this] == s__ItemsElementsFx_STORM then
                    set s__ItemsElementsFx_charges[this]=0
                    loop
                        set v=FirstOfGroup(s__ItemsElementsFx_g[this])
                        exitwhen v == null
                        call GroupRemoveUnit(s__ItemsElementsFx_g[this], v)
                        set s__ItemsElementsFx_charges[this]=s__ItemsElementsFx_charges[this] + 1
                    endloop
                    if s__ItemsElementsFx_charges[this] > 0 then
                        set m=s__ItemsElementsFx_Find(s__ItemsElementsFx_BASTION , s__ItemsElementsFx_c[this] , null)
                        if m == 0 then
                            set m=s__ItemsElementsFx_Mark(s__ItemsElementsFx_BASTION , ThunderBastion_ID , s__ItemsElementsFx_c[this] , s__ItemsElementsFx_c[this] , 5.0 , "")
                            set s__ItemsElementsFx_e[m]=AddSpecialEffectTarget("Abilities\\Spells\\Orc\\LightningShield\\LightningShieldTarget.mdl", s__ItemsElementsFx_c[this], "origin")
                        endif
                        set s__ItemsElementsFx_left[m]=5.0
                        call BuffUnit01(s__ItemsElementsFx_c[this] , s__ItemsElementsFx_c[this] , ItemsSpells__ElemMarkObject(s__ItemsElementsFx_BASTION , true) , "innerfire" , 11)
                        set s__ItemsElementsFx_charges[m]=IMinBJ(3, s__ItemsElementsFx_charges[m] + s__ItemsElementsFx_charges[this])
                        set s__ItemsElementsFx_dmg2[m]=ThunderBastion_Counter * (I2R(GetHeroStr((s__ItemsElementsFx_c[this]), true))) // INLINED!!
                    endif
                else
                    // Chain the nearest pair of the living enemy heroes the spiral caught.
                    set best=99999999.0
                    set a1=null
                    set b1=null
                    set d=0
                    loop
                        set v=FirstOfGroup(s__ItemsElementsFx_g[this])
                        exitwhen v == null or d >= 10
                        call GroupRemoveUnit(s__ItemsElementsFx_g[this], v)
                        if ItemsSpells__ElemAlive(v) then
                            set hits[R2I(d)]=v
                            set d=d + 1
                        endif
                    endloop
                    set dx=0
                    loop
                        exitwhen dx >= d
                        set dy=dx + 1
                        loop
                            exitwhen dy >= d
                            set px=GetUnitX(hits[R2I(dx)]) - GetUnitX(hits[R2I(dy)])
                            set py=GetUnitY(hits[R2I(dx)]) - GetUnitY(hits[R2I(dy)])
                            if px * px + py * py < best then
                                set best=px * px + py * py
                                set a1=hits[R2I(dx)]
                                set b1=hits[R2I(dy)]
                            endif
                            set dy=dy + 1
                        endloop
                        set hits[R2I(dx)]=null
                        set dx=dx + 1
                    endloop
                    if a1 != null and b1 != null then
                        set m=s__ItemsElementsFx_Add(s__ItemsElementsFx_COIL , ConstellationCoil_ID , s__ItemsElementsFx_c[this] , a1 , 3.0)
                        set s__ItemsElementsFx_u2[m]=b1
                        set s__ItemsElementsFx_dmg2[m]=ConstellationCoil_Bonus * (I2R(GetHeroInt((s__ItemsElementsFx_c[this]), true))) // INLINED!!
                        set s__ItemsElementsFx_ln[m]=AddLightningEx("CLSB", true, GetUnitX(a1), GetUnitY(a1), 60, GetUnitX(b1), GetUnitY(b1), 60)
                    endif
                endif
