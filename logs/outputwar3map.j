                            set s__InoriSpells___InoriR_KS_e8[this]=EffectSpawn("war3mapImported\\wos_Void04.mdl" , s__InoriSpells___InoriR_KS_x[this] + 155 * Cos(0) , s__InoriSpells___InoriR_KS_y[this] + 155 * Sin(0) , 1 , 1 , 7.25 * s__InoriSpells___InoriR_KS_scale[this] , 1)
