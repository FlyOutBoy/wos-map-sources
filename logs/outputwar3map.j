            set ErzaESpells__ErzaETick10_Active[k]=false
            set ErzaESpells__ErzaETick10_Users=ErzaESpells__ErzaETick10_Users - 1
            if ErzaESpells__ErzaETick10_Users <= 0 then
                set ErzaESpells__ErzaETick10_Users=0
                call PauseTimer(ErzaESpells__ErzaETick10_Timer)
            endif
        endif
