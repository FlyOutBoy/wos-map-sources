                            call s__GearSystems2___KS_RemoveEffect_MyRemoveEff_Start((s__AkainuSpells__AkainuSpells_T_e3[this] ) , (( 0.45)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
                            set s__AkainuSpells__AkainuSpells_T_e3[this]=null

                            set s__AkainuSpells__AkainuSpells_T_e3[this]=EffectSpawn3("war3mapImported\\wos_OP (114).mdl" , ( GetUnitX(s__AkainuSpells__AkainuSpells_T_c[this]) + 300.00 * Cos(s__AkainuSpells__AkainuSpells_T_a[this]) ) + 85.00 * Cos(s__AkainuSpells__AkainuSpells_T_a[this] - 60.00 * bj_DEGTORAD) , ( GetUnitY(s__AkainuSpells__AkainuSpells_T_c[this]) + 300.00 * Sin(s__AkainuSpells__AkainuSpells_T_a[this]) ) + 85.00 * Sin(s__AkainuSpells__AkainuSpells_T_a[this] - 60.00 * bj_DEGTORAD) , s__AkainuSpells__AkainuSpells_T_a[this] * bj_RADTODEG + 180.00 , 1 , 0.25 , 800.00 , - 205.00)
                            call EMUE(s__AkainuSpells__AkainuSpells_T_e3[this] , 900.00 , 0.12 , s__AkainuSpells__AkainuSpells_T_a[this])
                            call EHeightSet(s__AkainuSpells__AkainuSpells_T_e3[this] , 0.12 , 1800.00)
                            call s__GearSystems2___KS_RemoveEffect_MyRemoveEff_Start((s__AkainuSpells__AkainuSpells_T_e3[this] ) , (( 0.45)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
                            set s__AkainuSpells__AkainuSpells_T_e3[this]=null
                        else
                            set s__AkainuSpells__AkainuSpells_T_r3[this]=s__AkainuSpells__AkainuSpells_T_r3[this] + 0.03
                        endif
                    endif

                    if s__AkainuSpells__AkainuSpells_T_r[this] < AkainuT_CastTime then
                        call DebugUnit(s__AkainuSpells__AkainuSpells_T_c[this])
                    endif

                    if s__AkainuSpells__AkainuSpells_T_r[this] == AkainuT_CastTime then
                        call VisionTimed(GetOwningPlayer(s__AkainuSpells__AkainuSpells_T_c[this]) , s__AkainuSpells__AkainuSpells_T_x[this] , s__AkainuSpells__AkainuSpells_T_y[this] , s__AkainuSpells__AkainuSpells_T_aoe[this] + 600.00 , 4.50)
                        call StopSpellUnit(s__AkainuSpells__AkainuSpells_T_c[this])
                        if s__AkainuSpells__AkainuSpells_T_e[this] != null then
                            call AkainuSpells__Akainu_ClearHandEffect(s__AkainuSpells__AkainuSpells_T_e[this])
                            set s__AkainuSpells__AkainuSpells_T_e[this]=null
                        endif
                        if s__AkainuSpells__AkainuSpells_T_e2[this] != null then
                            call AkainuSpells__Akainu_ClearHandEffect(s__AkainuSpells__AkainuSpells_T_e2[this])
                            set s__AkainuSpells__AkainuSpells_T_e2[this]=null
                        endif
                    endif

                    if s__AkainuSpells__AkainuSpells_T_r[this] == 4.20 then
                        call MakeSound("war3mapimported\\Hero_Akainu_T3")
                    endif

                    if s__AkainuSpells__AkainuSpells_T_r[this] > AkainuT_CastTime then
                        set s__AkainuSpells__AkainuSpells_T_r2[this]=s__AkainuSpells__AkainuSpells_T_r2[this] + 0.03
                        if s__AkainuSpells__AkainuSpells_T_r2[this] + 0.0001 >= AkainuT_FistPeriod then
                            set s__AkainuSpells__AkainuSpells_T_r2[this]=s__AkainuSpells__AkainuSpells_T_r2[this] - AkainuT_FistPeriod
                            set rr1=GetRandomReal(155.00, s__AkainuSpells__AkainuSpells_T_aoe[this] / 2.00)
                            set rr2=GetRandomReal(0.00, 359.00) * bj_DEGTORAD
                            set s__AkainuSpells__AkainuSpells_T_x1[this]=s__AkainuSpells__AkainuSpells_T_x[this] + rr1 * Cos(rr2)
                            set s__AkainuSpells__AkainuSpells_T_y1[this]=s__AkainuSpells__AkainuSpells_T_y[this] + rr1 * Sin(rr2)
                            if s__AkainuSpells__AkainuSpells_T_aimed[this] < AkainuT_AimedFists then
                                call GroupEnumUnitsInRange(s__AkainuSpells__AkainuSpells_T_targets[this], s__AkainuSpells__AkainuSpells_T_x[this], s__AkainuSpells__AkainuSpells_T_y[this], s__AkainuSpells__AkainuSpells_T_aoe[this], NoDecor_Cond)
                                loop
                                    set target=FirstOfGroup(s__AkainuSpells__AkainuSpells_T_targets[this])
                                    exitwhen target == null
                                    call GroupRemoveUnit(s__AkainuSpells__AkainuSpells_T_targets[this], target)
                                    if IsUnitEnemy(target, GetOwningPlayer(s__AkainuSpells__AkainuSpells_T_c[this])) and SpellBool(target) then
                                        set s__AkainuSpells__AkainuSpells_T_x1[this]=GetUnitX(target)
                                        set s__AkainuSpells__AkainuSpells_T_y1[this]=GetUnitY(target)
                                        set s__AkainuSpells__AkainuSpells_T_aimed[this]=s__AkainuSpells__AkainuSpells_T_aimed[this] + 1
                                        exitwhen true
                                    endif
                                endloop
                                call GroupClear(s__AkainuSpells__AkainuSpells_T_targets[this])
                            endif
                            call s__AkainuSpells__AkainuSpells_T2_AkainuT2_Start(s__AkainuSpells__AkainuSpells_T_c[this] , s__AkainuSpells__AkainuSpells_T_x1[this] , s__AkainuSpells__AkainuSpells_T_y1[this])
                            set s__AkainuSpells__AkainuSpells_T_check[this]=s__AkainuSpells__AkainuSpells_T_check[this] + 1
                        endif
                    endif
                endif

                if remove then
                    if s__AkainuSpells__AkainuSpells_T_e[this] != null then
                        call AkainuSpells__Akainu_ClearHandEffect(s__AkainuSpells__AkainuSpells_T_e[this])
                    endif
                    if s__AkainuSpells__AkainuSpells_T_e2[this] != null then
                        call AkainuSpells__Akainu_ClearHandEffect(s__AkainuSpells__AkainuSpells_T_e2[this])
                    endif
                    if s__AkainuSpells__AkainuSpells_T_c[this] != null and GetUnitTypeId(s__AkainuSpells__AkainuSpells_T_c[this]) != 0 then
                        call StopSpellUnit(s__AkainuSpells__AkainuSpells_T_c[this])
                        call SetUnitTimeScale(s__AkainuSpells__AkainuSpells_T_c[this], 1.00)
                    endif
                    call DestroyGroup(s__AkainuSpells__AkainuSpells_T_targets[this])
                    set s__AkainuSpells__AkainuSpells_T_targets[this]=null
                    set s__AkainuSpells__AkainuSpells_T_c[this]=null
                    set s__AkainuSpells__AkainuSpells_T_e[this]=null
                    set s__AkainuSpells__AkainuSpells_T_e2[this]=null
                    set s__AkainuSpells__AkainuSpells_T_e3[this]=null
                    set s__AkainuSpells__AkainuSpells_T_m_AkainuT[i]=s__AkainuSpells__AkainuSpells_T_m_AkainuT[s__AkainuSpells__AkainuSpells_T_MUI_AkainuT]
                    set s__AkainuSpells__AkainuSpells_T_MUI_AkainuT=s__AkainuSpells__AkainuSpells_T_MUI_AkainuT - 1
                    call s__AkainuSpells__AkainuSpells_T_deallocate(this)
                    if s__AkainuSpells__AkainuSpells_T_MUI_AkainuT == - 1 then
                        call AkainuSpells__AkainuTimer03Release()
                    endif
                else
                    set i=i + 1
                endif
            endloop
            set target=null
        endfunction

        function s__AkainuSpells__AkainuSpells_T_AkainuT_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__AkainuSpells__AkainuSpells_T__allocate()

            set s__AkainuSpells__AkainuSpells_T_MUI_AkainuT=s__AkainuSpells__AkainuSpells_T_MUI_AkainuT + 1
            set s__AkainuSpells__AkainuSpells_T_m_AkainuT[s__AkainuSpells__AkainuSpells_T_MUI_AkainuT]=this
            set s__AkainuSpells__AkainuSpells_T_c[this]=NewC
            set s__AkainuSpells__AkainuSpells_T_x[this]=NewX
            set s__AkainuSpells__AkainuSpells_T_y[this]=NewY
            set s__AkainuSpells__AkainuSpells_T_r[this]=0.00
            set s__AkainuSpells__AkainuSpells_T_r2[this]=0.00
            set s__AkainuSpells__AkainuSpells_T_r3[this]=0.00
            set s__AkainuSpells__AkainuSpells_T_check[this]=0
            set s__AkainuSpells__AkainuSpells_T_aimed[this]=0
            set s__AkainuSpells__AkainuSpells_T_targets[this]=CreateGroup()
            call StartSpellUnit(s__AkainuSpells__AkainuSpells_T_c[this])
            set s__AkainuSpells__AkainuSpells_T_a[this]=GAngle2(s__AkainuSpells__AkainuSpells_T_c[this] , s__AkainuSpells__AkainuSpells_T_x[this] , s__AkainuSpells__AkainuSpells_T_y[this])
            set s__AkainuSpells__AkainuSpells_T_aoe[this]=AkainuT_DamageAoe
            set s__AkainuSpells__AkainuSpells_T_rmax[this]=AkainuT_MaxDuration

            call SetUnitAnimationByIndex(s__AkainuSpells__AkainuSpells_T_c[this], 6)
            call SetUnitTimeScale(s__AkainuSpells__AkainuSpells_T_c[this], 3.30)
            call MakeSound("war3mapimported\\Hero_Akainu_T")
            set s__AkainuSpells__AkainuSpells_T_e[this]=AddSpecialEffectTarget("war3mapImported\\wos_magmahandBig-91F172.mdl", s__AkainuSpells__AkainuSpells_T_c[this], "hand right")
            set s__AkainuSpells__AkainuSpells_T_e2[this]=AddSpecialEffectTarget("war3mapImported\\wos_magmahandBig-91F172.mdl", s__AkainuSpells__AkainuSpells_T_c[this], "hand left")

            if s__AkainuSpells__AkainuSpells_T_MUI_AkainuT == 0 then
                call AkainuSpells__AkainuTimer03Acquire()
            endif
        endfunction

    //===========================================================================
    // Инициализация и публичный интерфейс
    //===========================================================================
    function Akainu_Death takes unit dying returns nothing
        if GetUnitTypeId(dying) == Akainu_ID then
            call s__AkainuSpells__AkainuSpells_Q_OnDeath(dying)
            call s__AkainuSpells__AkainuSpells_R_OnDeath(dying)
        endif
    endfunction

    function AkainuSpells__AkainuTimer03Loop takes nothing returns nothing
        call s__AkainuSpells__AkainuSpells_Q_Loop_AkainuQ()
        call s__AkainuSpells__AkainuSpells_W_Loop_AkainuW()
        call s__AkainuSpells__AkainuSpells_W2_Loop_AkainuW2()
        call s__AkainuSpells__AkainuSpells_E_Loop_AkainuE()
        call s__AkainuSpells__AkainuSpells_R_Loop_AkainuR()
        call s__AkainuSpells__AkainuSpells_T_Loop_AkainuT()
        call s__AkainuSpells__AkainuSpells_T2_Loop_AkainuT2()
    endfunction

    function AkainuSpells__InitAkainuSpells takes nothing returns nothing
        set AkainuSpells__AkainuTimer03=CreateTimer()
        set AkainuSpells__AkainuTimer03Callback=function AkainuSpells__AkainuTimer03Loop
    endfunction

    function AkainuQ_Start takes unit c,unit td returns nothing
        call s__AkainuSpells__AkainuSpells_Q_AkainuQ_Start(c , td)
    endfunction

    function AkainuW_Start takes unit c,real x,real y returns nothing
        call s__AkainuSpells__AkainuSpells_W_AkainuW_Start(c , x , y)
    endfunction

    function AkainuE_Start takes unit c,unit td returns nothing
        call s__AkainuSpells__AkainuSpells_E_AkainuE_Start(c , td)
    endfunction

    function AkainuR_Start takes unit c,real x,real y returns nothing
        call s__AkainuSpells__AkainuSpells_R_AkainuR_Start(c , x , y)
    endfunction

    function AkainuT_Start takes unit c,real x,real y returns nothing
        call s__AkainuSpells__AkainuSpells_T_AkainuT_Start(c , x , y)
    endfunction

//library AkainuSpells ends
//library AltairSpells:

    // ==================== COMMON: helpers ====================
    function AltairSpells__AltairGroundZ takes real x,real y returns real
        call MoveLocation(AltairSpells__AltairLoc, x, y)
        return GetLocationZ(AltairSpells__AltairLoc)
    endfunction

    // Rings/circles without a death animation fade instead of lingering after DestroyEffect.
    function AltairSpells__AltairFade takes effect whichEffect returns nothing
        call ColorEffDummy3Alpha((whichEffect ) , (( 0.25 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.35)*1.0)) // INLINED!!
    endfunction

    // A dead hero may keep life above 0.405.
    function AltairSpells__AltairAlive takes unit whichUnit returns boolean
        return GetUnitTypeId(whichUnit) != 0 and not IsUnitType(whichUnit, UNIT_TYPE_DEAD) and GetWidgetLife(whichUnit) > 0.405
    endfunction

    function AltairSpells__AltairIsEnemy takes unit hero,unit target returns boolean
        return SpellBool(target) and IsUnitEnemy(target, GetOwningPlayer(hero))
    endfunction

    // Sword Princess spells hit as attacks: on-hit items trigger (Endless Swords) and attack items scale them.
    function AltairSpells__AltairSwordDamage takes unit hero,real intCoefficient,real atkCoefficient returns real
        return GetHeroInt(hero, true) * intCoefficient + GetAttack(hero) * atkCoefficient
    endfunction

    function AltairSpells__AltairDecor takes integer id,string model,real scale,integer weight,real factor returns nothing
        set AltairSpells__AltairDecorId[AltairSpells__AltairDecorCount]=id
        set AltairSpells__AltairDecorModel[AltairSpells__AltairDecorCount]=model
        set AltairSpells__AltairDecorScale[AltairSpells__AltairDecorCount]=scale
        set AltairSpells__AltairDecorWeight[AltairSpells__AltairDecorCount]=weight
        set AltairSpells__AltairDecorFactor[AltairSpells__AltairDecorCount]=factor
        set AltairSpells__AltairDecorCount=AltairSpells__AltairDecorCount + 1
    endfunction

    function AltairSpells__AltairDecorIndex takes integer id returns integer
        local integer index= 0
        loop
            exitwhen index >= AltairSpells__AltairDecorCount
            if AltairSpells__AltairDecorId[index] == id then
                return index
            endif
            set index=index + 1
        endloop
        return - 1
    endfunction

    function AltairSpells__AltairKindModel takes integer kind returns string
        if kind == AltairR_KindMetro then
            return AltairR_TrainMetroModel
        elseif kind == AltairR_KindThomas then
            return AltairR_TrainThomasModel
        endif
        return AltairSpells__AltairDecorModel[kind]
    endfunction

    function AltairSpells__AltairKindScale takes integer kind returns real
        if kind == AltairR_KindMetro then
            return 1.0
        elseif kind == AltairR_KindThomas then
            return 3.15
        endif
        return AltairSpells__AltairDecorScale[kind]
    endfunction

    // 4 = train.
    function AltairSpells__AltairKindWeight takes integer kind returns integer
        if kind < 0 then
            return 4
        endif
        return AltairSpells__AltairDecorWeight[kind]
    endfunction

    // Intelligence factor of an impact: barrel 2, small houses 3, houses and buildings 4, train 8.
    function AltairSpells__AltairKindFactor takes integer kind returns real
        if kind < 0 then
            return 8.0
        endif
        return AltairSpells__AltairDecorFactor[kind]
    endfunction

    function AltairSpells__AltairKindDecorId takes integer kind returns integer
        if kind < 0 then
            return AltairR_TrainDecorID
        endif
        return AltairSpells__AltairDecorId[kind]
    endfunction

    // A blue Holopsicon rift standing upright and facing the given direction.
    function AltairSpells__AltairPortal takes real x,real y,real height,real facing,real scale,integer red,integer green,integer blue returns effect
        local effect portal= AddSpecialEffect(Altair_PortalModel, x, y)
        call BlzSetSpecialEffectScale(portal, scale)
        call BlzSetSpecialEffectColor(portal, red, green, blue)
        call BlzSetSpecialEffectOrientation(portal, facing, - bj_PI / 2.0, 0.0)
        call BlzSetSpecialEffectPosition(portal, x, y, AltairSpells__AltairGroundZ(x , y) + height)
        call BlzPlaySpecialEffect(portal, ANIM_TYPE_BIRTH)
        return portal
    endfunction

    // ==================== COMMON: flying sword (Sword Storm, Meta Change burst) ====================

        function s__AltairSpells__AltairBlade_KS_Loop takes nothing returns nothing
            local integer index= 0
            local integer this
            local real step
            local real nextX
            local real nextY
            local integer users
            local unit target
            loop
                exitwhen index >= s__AltairSpells__AltairBlade_KS_count
                set this=s__AltairSpells__AltairBlade_KS_active[index]
                set step=s__AltairSpells__AltairBlade_KS_speed[this] * 0.03
                set nextX=BlzGetLocalSpecialEffectX(s__AltairSpells__AltairBlade_KS_art[this]) + step * Cos(s__AltairSpells__AltairBlade_KS_angle[this])
                set nextY=BlzGetLocalSpecialEffectY(s__AltairSpells__AltairBlade_KS_art[this]) + step * Sin(s__AltairSpells__AltairBlade_KS_angle[this])
                set s__AltairSpells__AltairBlade_KS_travelled[this]=s__AltairSpells__AltairBlade_KS_travelled[this] + step
                if s__AltairSpells__AltairBlade_KS_travelled[this] >= s__AltairSpells__AltairBlade_KS_range[this] or not (CheckCoordsInRect(gg_rct_Arena , ((nextX )*1.0) , (( nextY)*1.0))) then // INLINED!!
                    call ColorEffDummy3Alpha((s__AltairSpells__AltairBlade_KS_art[this] ) , (( 0.0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.15)*1.0)) // INLINED!!
                    if s__AltairSpells__AltairBlade_KS_hits[this] != null then
                        set users=LoadInteger(AltairSpells__AltairTable, GetHandleId(s__AltairSpells__AltairBlade_KS_hits[this]), 0) - 1
                        if users <= 0 then
                            call RemoveSavedInteger(AltairSpells__AltairTable, GetHandleId(s__AltairSpells__AltairBlade_KS_hits[this]), 0)
                            call DestroyGroup(s__AltairSpells__AltairBlade_KS_hits[this])
                        else
                            call SaveInteger(AltairSpells__AltairTable, GetHandleId(s__AltairSpells__AltairBlade_KS_hits[this]), 0, users)
                        endif
                    endif
                    set s__AltairSpells__AltairBlade_KS_art[this]=null
                    set s__AltairSpells__AltairBlade_KS_hits[this]=null
                    set s__AltairSpells__AltairBlade_KS_hero[this]=null
                    set s__AltairSpells__AltairBlade_KS_count=s__AltairSpells__AltairBlade_KS_count - 1
                    set s__AltairSpells__AltairBlade_KS_active[index]=s__AltairSpells__AltairBlade_KS_active[s__AltairSpells__AltairBlade_KS_count]
                    call s__AltairSpells__AltairBlade_KS_deallocate(this)
                    call GearTimer03Release()
                else
                    call BlzSetSpecialEffectX(s__AltairSpells__AltairBlade_KS_art[this], nextX)
                    call BlzSetSpecialEffectY(s__AltairSpells__AltairBlade_KS_art[this], nextY)
                    if s__AltairSpells__AltairBlade_KS_damage[this] > 0.0 then
                        call GroupEnumUnitsInRange(AltairSpells__AltairGroup, nextX, nextY, s__AltairSpells__AltairBlade_KS_width[this], NoDecor_Cond)
                        loop
                            set target=FirstOfGroup(AltairSpells__AltairGroup)
                            exitwhen target == null
                            call GroupRemoveUnit(AltairSpells__AltairGroup, target)
                            if AltairSpells__AltairIsEnemy(s__AltairSpells__AltairBlade_KS_hero[this] , target) and not IsUnitInGroup(target, s__AltairSpells__AltairBlade_KS_hits[this]) then
                                call GroupAddUnit(s__AltairSpells__AltairBlade_KS_hits[this], target)
                                set GearDamageNextSource=(AltairSW_ID) // INLINED!!
                                call dmgatk(s__AltairSpells__AltairBlade_KS_hero[this] , target , s__AltairSpells__AltairBlade_KS_damage[this])
                                call DestroyEffect(AddSpecialEffectTarget(Altair_StampedeModel, target, "chest"))
                                call DestroyEffect(EffectSpawn(Altair_HitModel , GetUnitX(target) , GetUnitY(target) , 0.0 , 1.0 , 1.5 , 76.0))
                            endif
                        endloop
                        call DecorRemove(s__AltairSpells__AltairBlade_KS_hero[this] , nextX , nextY , s__AltairSpells__AltairBlade_KS_width[this] , AltairSW_Decor)
                    endif
                    set index=index + 1
                endif
            endloop
            set target=null
        endfunction

        function s__AltairSpells__AltairBlade_KS_Launch takes unit caster,real x,real y,real height,real facing,real bladeSpeed,real bladeRange,real bladeWidth,real bladeDamage,group shared returns nothing
            local integer this= s__AltairSpells__AltairBlade_KS__allocate()
            set s__AltairSpells__AltairBlade_KS_hero[this]=caster
            set s__AltairSpells__AltairBlade_KS_angle[this]=facing
            set s__AltairSpells__AltairBlade_KS_speed[this]=bladeSpeed
            set s__AltairSpells__AltairBlade_KS_range[this]=bladeRange
            set s__AltairSpells__AltairBlade_KS_width[this]=bladeWidth
            set s__AltairSpells__AltairBlade_KS_damage[this]=bladeDamage
            set s__AltairSpells__AltairBlade_KS_travelled[this]=0.0
            set s__AltairSpells__AltairBlade_KS_hits[this]=shared
            if s__AltairSpells__AltairBlade_KS_hits[this] != null then
                call SaveInteger(AltairSpells__AltairTable, GetHandleId(s__AltairSpells__AltairBlade_KS_hits[this]), 0, LoadInteger(AltairSpells__AltairTable, GetHandleId(s__AltairSpells__AltairBlade_KS_hits[this]), 0) + 1)
            endif
            set s__AltairSpells__AltairBlade_KS_art[this]=EffectSpawn(Altair_SwordModel , x , y , facing * bj_RADTODEG , 1.0 , 0.45 , height)
            set s__AltairSpells__AltairBlade_KS_active[s__AltairSpells__AltairBlade_KS_count]=this
            set s__AltairSpells__AltairBlade_KS_count=s__AltairSpells__AltairBlade_KS_count + 1
            call GearTimer03Acquire()
        endfunction

    // ==================== COMMON: form, sword stacks and pending refunds ====================

        // Every cast plays its next line at once; each slot cycles its own variants.
        function s__AltairSpells__AltairState_Voice takes integer this,integer slot,string key,integer first,integer variants returns nothing
            call MakeSound(AltairSoundPath + key + I2S(first + ModuloInteger(s___AltairSpells__AltairState_voiceCycle[s__AltairSpells__AltairState_voiceCycle[this]+slot], variants)))
            set s___AltairSpells__AltairState_voiceCycle[s__AltairSpells__AltairState_voiceCycle[this]+slot]=s___AltairSpells__AltairState_voiceCycle[s__AltairSpells__AltairState_voiceCycle[this]+slot] + 1
        endfunction

        function s__AltairSpells__AltairState_MaxStacks takes integer this returns integer
            return GetHeroLevel(s__AltairSpells__AltairState_hero[this]) + AltairSF_StackBonus
        endfunction

        function s__AltairSpells__AltairState_AddStacks takes integer this,integer amount returns nothing
            set s__AltairSpells__AltairState_stacks[this]=IMinBJ((GetHeroLevel(s__AltairSpells__AltairState_hero[(this)]) + AltairSF_StackBonus), IMaxBJ(0, s__AltairSpells__AltairState_stacks[this] + amount)) // INLINED!!
        endfunction

        function s__AltairSpells__AltairState_SwordCost takes integer this,integer slot returns integer
            if slot == 0 then
                return AltairSQ_Cost
            elseif slot == 1 then
                return AltairSW_Cost
            elseif slot == 2 then
                return s__AltairSpells__AltairState_seCost[this]
            elseif slot == 3 then
                return AltairSR_Cost
            elseif slot == 4 then
                return AltairST_Cost
            endif
            return 0
        endfunction

        function s__AltairSpells__AltairState_TrySpend takes integer this,integer cost returns boolean
            if s__AltairSpells__AltairState_stacks[this] < cost then
                return false
            endif
            set s__AltairSpells__AltairState_stacks[this]=s__AltairSpells__AltairState_stacks[this] - cost
            return true
        endfunction

        // The native cooldown may be applied after SPELL_EFFECT; clear it on the next tick.
        function s__AltairSpells__AltairState_Refuse takes integer this,integer abilityId,string reason returns nothing
            set s__AltairSpells__AltairState_refundAbility[this]=abilityId
            call DisplayTimedTextToPlayer(GetOwningPlayer(s__AltairSpells__AltairState_hero[this]), 0.0, 0.0, 2.0, "|cffff6060" + reason + "|r")
        endfunction

        // Toggled Endless Swords: four swords guard the hero.
        function s__AltairSpells__AltairState_SetToggle takes integer this,boolean enabled returns nothing
            local integer slot= 0
            set s__AltairSpells__AltairState_swordToggle[this]=enabled
            loop
                exitwhen slot >= AltairSF_GuardBlades
                if enabled and s___AltairSpells__AltairState_guard[s__AltairSpells__AltairState_guard[this]+slot] == null then
                    set s___AltairSpells__AltairState_guard[s__AltairSpells__AltairState_guard[this]+slot]=AddSpecialEffect(Altair_SwordModel, GetUnitX(s__AltairSpells__AltairState_hero[this]), GetUnitY(s__AltairSpells__AltairState_hero[this]))
                    call BlzSetSpecialEffectScale(s___AltairSpells__AltairState_guard[s__AltairSpells__AltairState_guard[this]+slot], 0.3)
                elseif not enabled and s___AltairSpells__AltairState_guard[s__AltairSpells__AltairState_guard[this]+slot] != null then
                    call ColorEffDummy3Alpha((s___AltairSpells__AltairState_guard[s__AltairSpells__AltairState_guard[this]+slot] ) , (( 0.0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.2)*1.0)) // INLINED!!
                    set s___AltairSpells__AltairState_guard[s__AltairSpells__AltairState_guard[this]+slot]=null
                endif
                set slot=slot + 1
            endloop
        endfunction

        function s__AltairSpells__AltairState_ApplyForm takes integer this,integer newForm returns nothing
            local integer slot= 0
            local player owner= GetOwningPlayer(s__AltairSpells__AltairState_hero[this])
            set s__AltairSpells__AltairState_form[this]=newForm
            loop
                exitwhen slot > 6
                call SetPlayerAbilityAvailable(owner, AltairSpells__AltairHoloAbility[slot], s__AltairSpells__AltairState_form[this] == Altair_FormHolopsicon)
                call SetPlayerAbilityAvailable(owner, AltairSpells__AltairSwordAbility[slot], s__AltairSpells__AltairState_form[this] == Altair_FormSword)
                set slot=slot + 1
            endloop
            if s__AltairSpells__AltairState_form[this] == Altair_FormHolopsicon then
                call s__AltairSpells__AltairState_SetToggle(this,false)
            endif
            set s__AltairSpells__AltairState_shownStacks[this]=- 1
            set owner=null
        endfunction

        function s__AltairSpells__AltairState_SwitchForm takes integer this,integer newForm returns nothing
            local integer slot= 0
            local real angle
            call s__AltairSpells__AltairState_ApplyForm(this,newForm)
            if newForm == Altair_FormSword then
                call s__AltairSpells__AltairState_Voice(this,11 , "G" , 1 , 1)
            else
                call s__AltairSpells__AltairState_Voice(this,12 , "GG" , 1 , 1)
            endif
            call BlzStartUnitAbilityCooldown(s__AltairSpells__AltairState_hero[this], AltairG_ID, Altair_SwitchLock)
            call BlzStartUnitAbilityCooldown(s__AltairSpells__AltairState_hero[this], AltairSG_ID, Altair_SwitchLock)
            call DestroyEffect(EffectSpawn(Altair_SwitchModel , GetUnitX(s__AltairSpells__AltairState_hero[this]) , GetUnitY(s__AltairSpells__AltairState_hero[this]) , GetUnitFacing(s__AltairSpells__AltairState_hero[this]) , 1.0 , 1.2 , 0.0))
            call DestroyEffect(EffectSpawn(Altair_ImageModel , GetUnitX(s__AltairSpells__AltairState_hero[this]) , GetUnitY(s__AltairSpells__AltairState_hero[this]) , GetUnitFacing(s__AltairSpells__AltairState_hero[this]) , 1.0 , 1.4 , 0.0))
            call ColorEffDummy3Alpha(((EffectSpawnScale(Altair_RingModel , GetUnitX(s__AltairSpells__AltairState_hero[this]) , GetUnitY(s__AltairSpells__AltairState_hero[this]) , 0.0 , 1.0 , 0.5 , 10.0 , 0.3 , 0.5 , 2.5)) ) , (( 0.25 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.35)*1.0)) // INLINED!!
            if newForm == Altair_FormSword then
                // Endless swords burst out radially.
                loop
                    exitwhen slot >= AltairG_BurstBlades
                    set angle=slot * 2.0 * bj_PI / AltairG_BurstBlades
                    call s__AltairSpells__AltairBlade_KS_Launch(s__AltairSpells__AltairState_hero[this] , GetUnitX(s__AltairSpells__AltairState_hero[this]) , GetUnitY(s__AltairSpells__AltairState_hero[this]) , 90.0 , angle , 1200.0 , 260.0 , 0.0 , 0.0 , null)
                    set slot=slot + 1
                endloop
            else
                call ColorEffDummy3Alpha(((EffectSpawn(Altair_CircleModel , GetUnitX(s__AltairSpells__AltairState_hero[this]) , GetUnitY(s__AltairSpells__AltairState_hero[this]) , 0.0 , 1.0 , 1.2 , 5.0)) ) , (( 0.25 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.35)*1.0)) // INLINED!!
            endif
            call SetUnitAnimation(s__AltairSpells__AltairState_hero[this], "spell")
        endfunction

        // Sword levels follow the learned Holopsicon slot; buttons grey out without stacks.
        function s__AltairSpells__AltairState_Refresh takes integer this returns nothing
            local integer slot= 0
            local integer level
            local boolean disable
            loop
                exitwhen slot > 4
                set level=GetUnitAbilityLevel(s__AltairSpells__AltairState_hero[this], AltairSpells__AltairHoloAbility[slot])
                if level != s___AltairSpells__AltairState_holoLevel[s__AltairSpells__AltairState_holoLevel[this]+slot] then
                    set s___AltairSpells__AltairState_holoLevel[s__AltairSpells__AltairState_holoLevel[this]+slot]=level
                    if level > 0 and slot < 4 then
                        call SetUnitAbilityLevel(s__AltairSpells__AltairState_hero[this], AltairSpells__AltairSwordAbility[slot], level)
                    endif
                endif
                set disable=level == 0 or s__AltairSpells__AltairState_stacks[this] < s__AltairSpells__AltairState_SwordCost(this,slot)
                if disable != s___AltairSpells__AltairState_swordDisabled[s__AltairSpells__AltairState_swordDisabled[this]+slot] then
                    set s___AltairSpells__AltairState_swordDisabled[s__AltairSpells__AltairState_swordDisabled[this]+slot]=disable
                    call BlzUnitDisableAbility(s__AltairSpells__AltairState_hero[this], AltairSpells__AltairSwordAbility[slot], disable, false)
                endif
                set slot=slot + 1
            endloop
            if s__AltairSpells__AltairState_stacks[this] != s__AltairSpells__AltairState_shownStacks[this] then
                set s__AltairSpells__AltairState_shownStacks[this]=s__AltairSpells__AltairState_stacks[this]
                call TasAbilityChargeBox_SetValue(s__AltairSpells__AltairState_hero[this] , AltairSF_ID , I2S(s__AltairSpells__AltairState_stacks[this]))
            endif
        endfunction

        function s__AltairSpells__AltairState_UpdateVisuals takes integer this returns nothing
            local integer slot= 0
            local real angle
            local real z= BlzGetUnitZ(s__AltairSpells__AltairState_hero[this])
            if s__AltairSpells__AltairState_fEffect[this] != null then
                call BlzSetSpecialEffectPosition(s__AltairSpells__AltairState_fEffect[this], GetUnitX(s__AltairSpells__AltairState_hero[this]), GetUnitY(s__AltairSpells__AltairState_hero[this]), z)
            endif
            if s__AltairSpells__AltairState_swordToggle[this] then
                set s__AltairSpells__AltairState_guardAngle[this]=s__AltairSpells__AltairState_guardAngle[this] + 0.06
                loop
                    exitwhen slot >= AltairSF_GuardBlades
                    set angle=s__AltairSpells__AltairState_guardAngle[this] + slot * 2.0 * bj_PI / AltairSF_GuardBlades
                    call BlzSetSpecialEffectPosition(s___AltairSpells__AltairState_guard[s__AltairSpells__AltairState_guard[this]+slot], GetUnitX(s__AltairSpells__AltairState_hero[this]) + AltairSF_GuardRadius * Cos(angle), GetUnitY(s__AltairSpells__AltairState_hero[this]) + AltairSF_GuardRadius * Sin(angle), z + 90.0)
                    call BlzSetSpecialEffectYaw(s___AltairSpells__AltairState_guard[s__AltairSpells__AltairState_guard[this]+slot], angle)
                    set slot=slot + 1
                endloop
            endif
        endfunction

        function s__AltairSpells__AltairState_Activate takes integer this returns nothing
            set s__AltairSpells__AltairState_active[s__AltairSpells__AltairState_count]=this
            set s__AltairSpells__AltairState_count=s__AltairSpells__AltairState_count + 1
            call GearTimer03Acquire()
        endfunction

        function s__AltairSpells__AltairState_Loop takes nothing returns nothing
            local integer index= 0
            local integer this
            loop
                exitwhen index >= s__AltairSpells__AltairState_count
                set this=s__AltairSpells__AltairState_active[index]
                if GetUnitTypeId(s__AltairSpells__AltairState_hero[this]) == 0 then
                    call s__AltairSpells__AltairState_SetToggle(this,false)
                    call DestroyEffect(s__AltairSpells__AltairState_fEffect[this])
                    set s__AltairSpells__AltairState_fEffect[this]=null
                    call RemoveSavedInteger(AltairSpells__AltairTable, GetHandleId(s__AltairSpells__AltairState_hero[this]), 0)
                    set s__AltairSpells__AltairState_hero[this]=null
                    set s__AltairSpells__AltairState_reflectTarget[this]=null
                    set s__AltairSpells__AltairState_count=s__AltairSpells__AltairState_count - 1
                    set s__AltairSpells__AltairState_active[index]=s__AltairSpells__AltairState_active[s__AltairSpells__AltairState_count]
                    call s__AltairSpells__AltairState_deallocate(this)
                    call GearTimer03Release()
                else
                    if AltairSpells__AltairAlive(s__AltairSpells__AltairState_hero[this]) then
                        set s__AltairSpells__AltairState_stackTimer[this]=s__AltairSpells__AltairState_stackTimer[this] + 0.03
                        if s__AltairSpells__AltairState_stackTimer[this] >= AltairSF_StackPeriod then
                            set s__AltairSpells__AltairState_stackTimer[this]=s__AltairSpells__AltairState_stackTimer[this] - AltairSF_StackPeriod
                            call s__AltairSpells__AltairState_AddStacks(this,1)
                        endif
                    endif
                    if s__AltairSpells__AltairState_seWindow[this] > 0.0 then
                        set s__AltairSpells__AltairState_seWindow[this]=s__AltairSpells__AltairState_seWindow[this] - 0.03
                        if s__AltairSpells__AltairState_seWindow[this] <= 0.0 then
                            set s__AltairSpells__AltairState_seCost[this]=AltairSE_Cost
                        endif
                    endif
                    if s__AltairSpells__AltairState_fRemaining[this] > 0.0 then
                        set s__AltairSpells__AltairState_fRemaining[this]=s__AltairSpells__AltairState_fRemaining[this] - 0.03
                    endif
                    if ( s__AltairSpells__AltairState_fRemaining[this] <= 0.0 or not AltairSpells__AltairAlive(s__AltairSpells__AltairState_hero[this]) ) and s__AltairSpells__AltairState_fEffect[this] != null then
                        set s__AltairSpells__AltairState_fRemaining[this]=0.0
                        call ColorEffDummy3Alpha((s__AltairSpells__AltairState_fEffect[this] ) , (( 0.0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.25)*1.0)) // INLINED!!
                        set s__AltairSpells__AltairState_fEffect[this]=null
                    endif
                    // Reflection is deferred out of the damage event that blocked it.
                    if s__AltairSpells__AltairState_reflectTarget[this] != null then
                        if AltairSpells__AltairIsEnemy(s__AltairSpells__AltairState_hero[this] , s__AltairSpells__AltairState_reflectTarget[this]) then
                            call DestroyEffect(AddSpecialEffectTarget(AltairW_EraseModel, s__AltairSpells__AltairState_reflectTarget[this], "chest"))
                            call DestroyEffect(EffectSpawn(AltairF_ReflectModel , GetUnitX(s__AltairSpells__AltairState_hero[this]) , GetUnitY(s__AltairSpells__AltairState_hero[this]) , Atan2(GetUnitY(s__AltairSpells__AltairState_reflectTarget[this]) - GetUnitY(s__AltairSpells__AltairState_hero[this]), GetUnitX(s__AltairSpells__AltairState_reflectTarget[this]) - GetUnitX(s__AltairSpells__AltairState_hero[this])) * bj_RADTODEG , 1.0 , 1.0 , 80.0))
                            set GearDamageNextSource=(AltairF_ID) // INLINED!!
                            call dmgmag(s__AltairSpells__AltairState_hero[this] , s__AltairSpells__AltairState_reflectTarget[this] , s__AltairSpells__AltairState_reflectAmount[this] * AltairF_Reflect)
                            call s__AltairSpells__AltairState_Voice(this,10 , "F" , 3 , 1)
                        endif
                        set s__AltairSpells__AltairState_reflectTarget[this]=null
                        set s__AltairSpells__AltairState_reflectAmount[this]=0.0
                    endif
                    if s__AltairSpells__AltairState_refundAbility[this] != 0 then
                        call BlzEndUnitAbilityCooldown(s__AltairSpells__AltairState_hero[this], s__AltairSpells__AltairState_refundAbility[this])
                        set s__AltairSpells__AltairState_refundAbility[this]=0
                    endif
                    if s__AltairSpells__AltairState_swordToggle[this] and ( s__AltairSpells__AltairState_stacks[this] < AltairSF_AttackCost or not AltairSpells__AltairAlive(s__AltairSpells__AltairState_hero[this]) ) then
                        call s__AltairSpells__AltairState_SetToggle(this,false)
                    endif
                    call s__AltairSpells__AltairState_UpdateVisuals(this)
                    set s__AltairSpells__AltairState_refreshTimer[this]=s__AltairSpells__AltairState_refreshTimer[this] + 0.03
                    if s__AltairSpells__AltairState_refreshTimer[this] >= 0.09 then
                        set s__AltairSpells__AltairState_refreshTimer[this]=0.0
                        call s__AltairSpells__AltairState_Refresh(this)
                    endif
                    set index=index + 1
                endif
            endloop
        endfunction

    // ==================== Q: PPSH Spray ====================

        function s__AltairSpells__AltairBullet_KS_Loop takes nothing returns nothing
            local integer index= 0
            local integer this
            local real step= AltairQ_BulletSpeed * 0.03
            loop
                exitwhen index >= s__AltairSpells__AltairBullet_KS_count
                set this=s__AltairSpells__AltairBullet_KS_active[index]
                set s__AltairSpells__AltairBullet_KS_remaining[this]=s__AltairSpells__AltairBullet_KS_remaining[this] - step
                if s__AltairSpells__AltairBullet_KS_remaining[this] <= 0.0 then
                    call DestroyEffect(s__AltairSpells__AltairBullet_KS_art[this])
                    call DestroyEffect(EffectSpawn(AltairQ_HitModel , s__AltairSpells__AltairBullet_KS_targetX[this] , s__AltairSpells__AltairBullet_KS_targetY[this] , GetRandomReal(0.0, 359.0) , 1.5 , 0.5 , 5.0))
                    if GetRandomInt(1, 3) == 1 then
                        call DestroyEffect(EffectSpawn(Altair_DustModel , s__AltairSpells__AltairBullet_KS_targetX[this] , s__AltairSpells__AltairBullet_KS_targetY[this] , GetRandomReal(0.0, 359.0) , 1.5 , 0.4 , 0.0))
                    endif
                    set s__AltairSpells__AltairBullet_KS_art[this]=null
                    set s__AltairSpells__AltairBullet_KS_count=s__AltairSpells__AltairBullet_KS_count - 1
                    set s__AltairSpells__AltairBullet_KS_active[index]=s__AltairSpells__AltairBullet_KS_active[s__AltairSpells__AltairBullet_KS_count]
                    call s__AltairSpells__AltairBullet_KS_deallocate(this)
                    call GearTimer03Release()
                else
                    call BlzSetSpecialEffectX(s__AltairSpells__AltairBullet_KS_art[this], BlzGetLocalSpecialEffectX(s__AltairSpells__AltairBullet_KS_art[this]) + step * Cos(s__AltairSpells__AltairBullet_KS_angle[this]))
                    call BlzSetSpecialEffectY(s__AltairSpells__AltairBullet_KS_art[this], BlzGetLocalSpecialEffectY(s__AltairSpells__AltairBullet_KS_art[this]) + step * Sin(s__AltairSpells__AltairBullet_KS_angle[this]))
                    set index=index + 1
                endif
            endloop
        endfunction

        function s__AltairSpells__AltairBullet_KS_Fire takes real x,real y,real hitX,real hitY returns nothing
            local integer this= s__AltairSpells__AltairBullet_KS__allocate()
            set s__AltairSpells__AltairBullet_KS_targetX[this]=hitX
            set s__AltairSpells__AltairBullet_KS_targetY[this]=hitY
            set s__AltairSpells__AltairBullet_KS_angle[this]=Atan2(hitY - y, hitX - x)
            set s__AltairSpells__AltairBullet_KS_remaining[this]=SquareRoot(( hitX - x ) * ( hitX - x ) + ( hitY - y ) * ( hitY - y ))
            set s__AltairSpells__AltairBullet_KS_art[this]=EffectSpawn(AltairQ_BulletModel , x , y , s__AltairSpells__AltairBullet_KS_angle[this] * bj_RADTODEG , 2.0 , 0.8 , 70.0)
            set s__AltairSpells__AltairBullet_KS_active[s__AltairSpells__AltairBullet_KS_count]=this
            set s__AltairSpells__AltairBullet_KS_count=s__AltairSpells__AltairBullet_KS_count + 1
            call GearTimer03Acquire()
        endfunction


        function s__AltairSpells__AltairQ_KS_Hit takes integer this returns nothing
            local unit target
            call GroupEnumUnitsInRange(AltairSpells__AltairGroup, s__AltairSpells__AltairQ_KS_targetX[this], s__AltairSpells__AltairQ_KS_targetY[this], AltairQ_Aoe, NoDecor_Cond)
            loop
                set target=FirstOfGroup(AltairSpells__AltairGroup)
                exitwhen target == null
                call GroupRemoveUnit(AltairSpells__AltairGroup, target)
                if AltairSpells__AltairIsEnemy(s__AltairSpells__AltairQ_KS_hero[this] , target) then
                    set GearDamageNextSource=(AltairQ_ID) // INLINED!!
                    call dmgphys(s__AltairSpells__AltairQ_KS_hero[this] , target , s__AltairSpells__AltairQ_KS_damage[this])
                    call StunUnit(s__AltairSpells__AltairQ_KS_hero[this] , target , AltairQ_Stun)
                    call DestroyEffect(AddSpecialEffectTarget(AltairQ_HitModel, target, "chest"))
                endif
            endloop
            call DecorRemove(s__AltairSpells__AltairQ_KS_hero[this] , s__AltairSpells__AltairQ_KS_targetX[this] , s__AltairSpells__AltairQ_KS_targetY[this] , AltairQ_Aoe , AltairQ_Decor)
            call VisionTimed(GetOwningPlayer(s__AltairSpells__AltairQ_KS_hero[this]) , s__AltairSpells__AltairQ_KS_targetX[this] , s__AltairSpells__AltairQ_KS_targetY[this] , AltairQ_Aoe * 1.6 , 2.0)
            set s__AltairSpells__AltairQ_KS_dealt[this]=true
        endfunction

        function s__AltairSpells__AltairQ_KS_Loop takes nothing returns nothing
            local integer index= 0
            local integer this
            local real distance
            local real angle
            local real muzzleX
            local real muzzleY
            loop
                exitwhen index >= s__AltairSpells__AltairQ_KS_count
                set this=s__AltairSpells__AltairQ_KS_active[index]
                set s__AltairSpells__AltairQ_KS_elapsed[this]=s__AltairSpells__AltairQ_KS_elapsed[this] + 0.03
                set angle=GAngle2(s__AltairSpells__AltairQ_KS_hero[this] , s__AltairSpells__AltairQ_KS_targetX[this] , s__AltairSpells__AltairQ_KS_targetY[this])
                set muzzleX=GetUnitX(s__AltairSpells__AltairQ_KS_hero[this]) + 75.0 * Cos(angle)
                set muzzleY=GetUnitY(s__AltairSpells__AltairQ_KS_hero[this]) + 75.0 * Sin(angle)
                if not s__AltairSpells__AltairQ_KS_dealt[this] and s__AltairSpells__AltairQ_KS_elapsed[this] >= AltairQ_DamageDelay then
                    call s__AltairSpells__AltairQ_KS_Hit(this)
                endif
                set s__AltairSpells__AltairQ_KS_shotTimer[this]=s__AltairSpells__AltairQ_KS_shotTimer[this] + 0.03
                loop
                    exitwhen s__AltairSpells__AltairQ_KS_shotTimer[this] < AltairQ_ShotPeriod
                    set s__AltairSpells__AltairQ_KS_shotTimer[this]=s__AltairSpells__AltairQ_KS_shotTimer[this] - AltairQ_ShotPeriod
                    set distance=AltairQ_Aoe * SquareRoot(GetRandomReal(0.0, 1.0))
                    set angle=GetRandomReal(0.0, 2.0 * bj_PI)
                    call s__AltairSpells__AltairBullet_KS_Fire(muzzleX , muzzleY , s__AltairSpells__AltairQ_KS_targetX[this] + distance * Cos(angle) , s__AltairSpells__AltairQ_KS_targetY[this] + distance * Sin(angle))
                endloop
                set s__AltairSpells__AltairQ_KS_flashTimer[this]=s__AltairSpells__AltairQ_KS_flashTimer[this] + 0.03
                if s__AltairSpells__AltairQ_KS_flashTimer[this] >= 0.12 then
                    set s__AltairSpells__AltairQ_KS_flashTimer[this]=0.0
                    set angle=GAngle2(s__AltairSpells__AltairQ_KS_hero[this] , s__AltairSpells__AltairQ_KS_targetX[this] , s__AltairSpells__AltairQ_KS_targetY[this])
                    call DestroyEffect(EffectSpawn(AltairQ_MuzzleModel , muzzleX , muzzleY , angle * bj_RADTODEG , 2.0 , 0.35 , 90.0))
                    call DestroyEffect(EffectSpawn(AltairQ_FlashModel , muzzleX , muzzleY , angle * bj_RADTODEG , 1.5 , 0.8 , 90.0))
                endif
                if s__AltairSpells__AltairQ_KS_elapsed[this] >= AltairQ_SprayTime or not AltairSpells__AltairAlive(s__AltairSpells__AltairQ_KS_hero[this]) then
                    if not s__AltairSpells__AltairQ_KS_dealt[this] then
                        call s__AltairSpells__AltairQ_KS_Hit(this)
                    endif
                    set s__AltairSpells__AltairQ_KS_hero[this]=null
                    set s__AltairSpells__AltairQ_KS_count=s__AltairSpells__AltairQ_KS_count - 1
                    set s__AltairSpells__AltairQ_KS_active[index]=s__AltairSpells__AltairQ_KS_active[s__AltairSpells__AltairQ_KS_count]
                    call s__AltairSpells__AltairQ_KS_deallocate(this)
                    call GearTimer03Release()
                else
                    set index=index + 1
                endif
            endloop
        endfunction

        function s__AltairSpells__AltairQ_KS_Start takes unit caster,real positionX,real positionY returns nothing
            local integer this= s__AltairSpells__AltairQ_KS__allocate()
            local integer level= IMaxBJ(1, GetUnitAbilityLevel(caster, AltairQ_ID))
            set s__AltairSpells__AltairQ_KS_hero[this]=caster
            set s__AltairSpells__AltairQ_KS_targetX[this]=positionX
            set s__AltairSpells__AltairQ_KS_targetY[this]=positionY
            set s__AltairSpells__AltairQ_KS_elapsed[this]=0.0
            set s__AltairSpells__AltairQ_KS_shotTimer[this]=AltairQ_ShotPeriod
            set s__AltairSpells__AltairQ_KS_flashTimer[this]=0.12
            set s__AltairSpells__AltairQ_KS_dealt[this]=false
            set s__AltairSpells__AltairQ_KS_damage[this]=GetHeroInt(s__AltairSpells__AltairQ_KS_hero[this], true) * ( AltairQ_DamageIntBase + AltairQ_DamageIntStep * ( level - 1 ) ) + AltairQ_DamageStatic + AltairQ_DamageStaticStep * ( level - 1 )
            call SetUnitFacing(s__AltairSpells__AltairQ_KS_hero[this], GAngle2(s__AltairSpells__AltairQ_KS_hero[this] , s__AltairSpells__AltairQ_KS_targetX[this] , s__AltairSpells__AltairQ_KS_targetY[this]) * bj_RADTODEG)
            call SetUnitAnimation(s__AltairSpells__AltairQ_KS_hero[this], "attack")
            call ColorEffDummy3Alpha(((EffectSpawn(Altair_CircleModel , s__AltairSpells__AltairQ_KS_targetX[this] , s__AltairSpells__AltairQ_KS_targetY[this] , 0.0 , 2.0 , AltairQ_Aoe / 220.0 , 5.0)) ) , (( 0.25 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.35)*1.0)) // INLINED!!
            set s__AltairSpells__AltairQ_KS_active[s__AltairSpells__AltairQ_KS_count]=this
            set s__AltairSpells__AltairQ_KS_count=s__AltairSpells__AltairQ_KS_count + 1
            call GearTimer03Acquire()
        endfunction

    // ==================== W: free block granted by the Third Movement ====================

        function s__AltairSpells__AltairWBlock_KS_Loop takes nothing returns nothing
            local integer index= 0
            local integer this
            loop
                exitwhen index >= s__AltairSpells__AltairWBlock_KS_count
                set this=s__AltairSpells__AltairWBlock_KS_active[index]
                set s__AltairSpells__AltairWBlock_KS_remaining[this]=s__AltairSpells__AltairWBlock_KS_remaining[this] - 0.03
                if s__AltairSpells__AltairWBlock_KS_remaining[this] <= 0.0 or not AltairSpells__AltairAlive(s__AltairSpells__AltairWBlock_KS_target[this]) then
                    call DestroyEffect(s__AltairSpells__AltairWBlock_KS_art[this])
                    call RemoveSavedInteger(AltairSpells__AltairTable, GetHandleId(s__AltairSpells__AltairWBlock_KS_target[this]), 1)
                    set s__AltairSpells__AltairWBlock_KS_art[this]=null
                    set s__AltairSpells__AltairWBlock_KS_target[this]=null
                    set s__AltairSpells__AltairWBlock_KS_count=s__AltairSpells__AltairWBlock_KS_count - 1
                    set s__AltairSpells__AltairWBlock_KS_active[index]=s__AltairSpells__AltairWBlock_KS_active[s__AltairSpells__AltairWBlock_KS_count]
                    call s__AltairSpells__AltairWBlock_KS_deallocate(this)
                    call GearTimer03Release()
                else
                    set index=index + 1
                endif
            endloop
        endfunction

        function s__AltairSpells__AltairWBlock_KS_Grant takes unit whichUnit,real duration returns nothing
            local integer this= LoadInteger(AltairSpells__AltairTable, GetHandleId(whichUnit), 1)
            if this == 0 then
                set this=s__AltairSpells__AltairWBlock_KS__allocate()
                set s__AltairSpells__AltairWBlock_KS_target[this]=whichUnit
                set s__AltairSpells__AltairWBlock_KS_remaining[this]=0.0
                set s__AltairSpells__AltairWBlock_KS_art[this]=AddSpecialEffectTarget(AltairW_BlockModel, s__AltairSpells__AltairWBlock_KS_target[this], "overhead")
                call SaveInteger(AltairSpells__AltairTable, GetHandleId(s__AltairSpells__AltairWBlock_KS_target[this]), 1, this)
                set s__AltairSpells__AltairWBlock_KS_active[s__AltairSpells__AltairWBlock_KS_count]=this
                set s__AltairSpells__AltairWBlock_KS_count=s__AltairSpells__AltairWBlock_KS_count + 1
                call GearTimer03Acquire()
            endif
            set s__AltairSpells__AltairWBlock_KS_remaining[this]=RMaxBJ(s__AltairSpells__AltairWBlock_KS_remaining[this], duration)
        endfunction

        function s__AltairSpells__AltairWBlock_KS_Consume takes unit whichUnit returns boolean
            local integer this= LoadInteger(AltairSpells__AltairTable, GetHandleId(whichUnit), 1)
            if this == 0 or s__AltairSpells__AltairWBlock_KS_remaining[this] <= 0.0 then
                return false
            endif
            set s__AltairSpells__AltairWBlock_KS_remaining[this]=0.0
            call ColorEffDummy3Alpha(((AddSpecialEffectTarget(Altair_RingModel, s__AltairSpells__AltairWBlock_KS_target[this], "origin")) ) , (( 0.25 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.35)*1.0)) // INLINED!!
            return true
        endfunction

    // ==================== W: dash to an ally or an enemy ====================

        function s__AltairSpells__AltairW_KS_Arrive takes integer this returns nothing
            local real duration= AltairW_Duration + AltairW_DurationStep * ( s__AltairSpells__AltairW_KS_level[this] - 1 )
            local real x= GetUnitX(s__AltairSpells__AltairW_KS_target[this])
            local real y= GetUnitY(s__AltairSpells__AltairW_KS_target[this])
            if s__AltairSpells__AltairW_KS_ally[this] then
                // Third Movement: the plot element is rewritten into flowers.
                call UnitRemoveBuffs(s__AltairSpells__AltairW_KS_target[this], false, true)
                call s__AltairSpells__AltairWBlock_KS_Grant(s__AltairSpells__AltairW_KS_target[this] , duration)
                call s__GearSystems2___KS_HealOverTime_HPS_Start((s__AltairSpells__AltairW_KS_hero[this] ) , ( s__AltairSpells__AltairW_KS_target[this] ) , 0 , (( GetHeroInt(s__AltairSpells__AltairW_KS_hero[this], true) * ( AltairW_HealIntBase + AltairW_HealIntStep * ( s__AltairSpells__AltairW_KS_level[this] - 1 ) ) )*1.0) , (( duration)*1.0)) // INLINED!!
                call DestroyEffect(EffectSpawn(AltairW_PetalModel , x , y , GetRandomReal(0.0, 359.0) , 1.0 , 1.6 , 0.0))
                call DestroyEffect(EffectSpawn(AltairW_PetalModel , x , y , GetRandomReal(0.0, 359.0) , 1.3 , 1.1 , 60.0))
                call DestroyEffect(EffectSpawn(AltairW_RoseModel , x , y , 0.0 , 1.0 , 0.8 , 0.0))
                call DestroyEffect(AddSpecialEffectTarget(AltairW_AllyModel, s__AltairSpells__AltairW_KS_target[this], "origin"))
                call ColorEffDummy3Alpha(((EffectSpawn(Altair_CircleModel , x , y , 0.0 , 1.0 , 0.8 , 5.0)) ) , (( 0.25 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.35)*1.0)) // INLINED!!
            elseif AltairSpells__AltairIsEnemy(s__AltairSpells__AltairW_KS_hero[this] , s__AltairSpells__AltairW_KS_target[this]) then
                // Ninth Movement: every buff, shields included, is erased.
                call UnitRemoveBuffs(s__AltairSpells__AltairW_KS_target[this], true, false)
                call s__AltairSpells__AltairWBlock_KS_Consume(s__AltairSpells__AltairW_KS_target[this])
                call SaveInteger(hs, GetHandleId(s__AltairSpells__AltairW_KS_target[this]), KEY_SHIELD, 0)
                call DestroyEffect(EffectSpawn(AltairW_EraseModel , x , y , GetRandomReal(0.0, 359.0) , 1.0 , 1.3 , 0.0))
                call DestroyEffect(EffectSpawn(Altair_DarkImageModel , x , y , GetUnitFacing(s__AltairSpells__AltairW_KS_target[this]) , 1.0 , 1.3 , 0.0))
                set GearDamageNextSource=(AltairW_ID) // INLINED!!
                call dmgmag(s__AltairSpells__AltairW_KS_hero[this] , s__AltairSpells__AltairW_KS_target[this] , GetHeroInt(s__AltairSpells__AltairW_KS_hero[this], true) * ( AltairW_DamageIntBase + AltairW_DamageIntStep * ( s__AltairSpells__AltairW_KS_level[this] - 1 ) ) + AltairW_DamageStatic + AltairW_DamageStaticStep * ( s__AltairSpells__AltairW_KS_level[this] - 1 ))
            endif
            call DestroyEffect(EffectSpawn(Altair_SlashModel , x , y , GetUnitFacing(s__AltairSpells__AltairW_KS_hero[this]) , 1.5 , 0.8 , 60.0))
            call DecorRemove(s__AltairSpells__AltairW_KS_hero[this] , x , y , 200.0 , AltairW_Decor)
            call VisionTimed(GetOwningPlayer(s__AltairSpells__AltairW_KS_hero[this]) , x , y , 500.0 , 2.0)
        endfunction

        function s__AltairSpells__AltairW_KS_Loop takes nothing returns nothing
            local integer index= 0
            local integer this
            local real distance
            local real angle
            local real step
            local boolean finished
            loop
                exitwhen index >= s__AltairSpells__AltairW_KS_count
                set this=s__AltairSpells__AltairW_KS_active[index]
                set s__AltairSpells__AltairW_KS_elapsed[this]=s__AltairSpells__AltairW_KS_elapsed[this] + 0.03
                set finished=s__AltairSpells__AltairW_KS_elapsed[this] >= AltairW_MaxDashTime or not AltairSpells__AltairAlive(s__AltairSpells__AltairW_KS_target[this]) or not AltairSpells__AltairAlive(s__AltairSpells__AltairW_KS_hero[this])
                if not finished then
                    set distance=SR2(s__AltairSpells__AltairW_KS_hero[this] , s__AltairSpells__AltairW_KS_target[this])
                    set angle=GAngle(s__AltairSpells__AltairW_KS_hero[this] , s__AltairSpells__AltairW_KS_target[this])
                    if distance <= AltairW_ContactRange then
                        call s__AltairSpells__AltairW_KS_Arrive(this)
                        set finished=true
                    else
                        set step=RMinBJ(AltairW_Speed * 0.03, distance - AltairW_ContactRange * 0.5)
                        if (CheckCoordsInRect(gg_rct_Arena , ((GetUnitX(s__AltairSpells__AltairW_KS_hero[this]) + step * Cos(angle) )*1.0) , (( GetUnitY(s__AltairSpells__AltairW_KS_hero[this]) + step * Sin(angle))*1.0))) then // INLINED!!
                            call SetUnitX(s__AltairSpells__AltairW_KS_hero[this], GetUnitX(s__AltairSpells__AltairW_KS_hero[this]) + step * Cos(angle))
                            call SetUnitY(s__AltairSpells__AltairW_KS_hero[this], GetUnitY(s__AltairSpells__AltairW_KS_hero[this]) + step * Sin(angle))
                        endif
                        call DecorRemove(s__AltairSpells__AltairW_KS_hero[this] , GetUnitX(s__AltairSpells__AltairW_KS_hero[this]) , GetUnitY(s__AltairSpells__AltairW_KS_hero[this]) , 120.0 , AltairW_Decor)
                        call SetUnitFacing(s__AltairSpells__AltairW_KS_hero[this], angle * bj_RADTODEG)
                        set s__AltairSpells__AltairW_KS_trailTimer[this]=s__AltairSpells__AltairW_KS_trailTimer[this] + 0.03
                        if s__AltairSpells__AltairW_KS_trailTimer[this] >= 0.06 then
                            set s__AltairSpells__AltairW_KS_trailTimer[this]=0.0
                            // After-images: white for an ally, black for an enemy.
                            if s__AltairSpells__AltairW_KS_ally[this] then
                                call DestroyEffect(EffectSpawn(Altair_ImageModel , GetUnitX(s__AltairSpells__AltairW_KS_hero[this]) , GetUnitY(s__AltairSpells__AltairW_KS_hero[this]) , angle * bj_RADTODEG , 1.5 , 1.0 , 0.0))
                            else
                                call DestroyEffect(EffectSpawn(Altair_DarkImageModel , GetUnitX(s__AltairSpells__AltairW_KS_hero[this]) , GetUnitY(s__AltairSpells__AltairW_KS_hero[this]) , angle * bj_RADTODEG , 1.5 , 1.0 , 0.0))
                            endif
                        endif
                    endif
                endif
                if finished then
                    call StopSpellUnit2(s__AltairSpells__AltairW_KS_hero[this])
                    set s__AltairSpells__AltairW_KS_hero[this]=null
                    set s__AltairSpells__AltairW_KS_target[this]=null
                    set s__AltairSpells__AltairW_KS_count=s__AltairSpells__AltairW_KS_count - 1
                    set s__AltairSpells__AltairW_KS_active[index]=s__AltairSpells__AltairW_KS_active[s__AltairSpells__AltairW_KS_count]
                    call s__AltairSpells__AltairW_KS_deallocate(this)
                    call GearTimer03Release()
                else
                    set index=index + 1
                endif
            endloop
        endfunction

        function s__AltairSpells__AltairW_KS_Start takes unit caster,unit whichTarget returns boolean
            local integer this
            if whichTarget == null or whichTarget == caster then
                return false
            endif
            set this=s__AltairSpells__AltairW_KS__allocate()
            set s__AltairSpells__AltairW_KS_hero[this]=caster
            set s__AltairSpells__AltairW_KS_target[this]=whichTarget
            set s__AltairSpells__AltairW_KS_ally[this]=IsUnitAlly(s__AltairSpells__AltairW_KS_target[this], GetOwningPlayer(s__AltairSpells__AltairW_KS_hero[this]))
            set s__AltairSpells__AltairW_KS_level[this]=IMaxBJ(1, GetUnitAbilityLevel(s__AltairSpells__AltairW_KS_hero[this], AltairW_ID))
            set s__AltairSpells__AltairW_KS_elapsed[this]=0.0
            set s__AltairSpells__AltairW_KS_trailTimer[this]=0.0
            call StartSpellUnit2(s__AltairSpells__AltairW_KS_hero[this])
            call SetUnitAnimation(s__AltairSpells__AltairW_KS_hero[this], "spell")
            call DestroyEffect(EffectSpawn(Altair_SwitchModel , GetUnitX(s__AltairSpells__AltairW_KS_hero[this]) , GetUnitY(s__AltairSpells__AltairW_KS_hero[this]) , 0.0 , 1.5 , 0.8 , 0.0))
            set s__AltairSpells__AltairW_KS_active[s__AltairSpells__AltairW_KS_count]=this
            set s__AltairSpells__AltairW_KS_count=s__AltairSpells__AltairW_KS_count + 1
            call GearTimer03Acquire()
            return true
        endfunction

    // ==================== E: Outline Origin ====================
    // Train blockers, the shop base and Kyoraku's floor are system objects, never "restored".
    function AltairSpells__AltairE_Restore takes destructable decor returns nothing
        local real dx
        local real dy
        local integer id
        if decor == null or GetDestructableLife(decor) > 0.405 then
            return
        endif
        set id=GetDestructableTypeId(decor)
        set dx=GetDestructableX(decor) - AltairSpells__AltairEnumX
        set dy=GetDestructableY(decor) - AltairSpells__AltairEnumY
        if id != 0 and id != AltairR_TrainDecorID and id != 'B016' and id != 'B018' and dx * dx + dy * dy <= AltairSpells__AltairEnumRadius * AltairSpells__AltairEnumRadius then
            call DestructableRestoreLife(decor, GetDestructableMaxLife(decor), true)
            call ColorEffDummy3Alpha(((EffectSpawn(Altair_CircleModel , GetDestructableX(decor) , GetDestructableY(decor) , 0.0 , 1.0 , 0.6 , 10.0)) ) , (( 0.25 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.35)*1.0)) // INLINED!!
            call ColorEffDummy3Alpha(((EffectSpawn(AltairE_ClockModel , GetDestructableX(decor) , GetDestructableY(decor) , 0.0 , 1.5 , 0.8 , 40.0)) ) , (( 0.25 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.35)*1.0)) // INLINED!!
        endif
    endfunction

    function AltairSpells__AltairE_RestoreDecor takes nothing returns nothing
        call AltairSpells__AltairE_Restore(GetEnumDestructable())
    endfunction

    // Everything Factor Mimic took inside the aura comes back, independently of the area scan.
    function AltairSpells__AltairE_RestoreTaken takes nothing returns nothing
        local integer slot= 0
        loop
            exitwhen slot >= 128
            call AltairSpells__AltairE_Restore(AltairSpells__AltairRTaken[slot])
            set slot=slot + 1
        endloop
    endfunction


        function s__AltairSpells__AltairE_KS_ReduceCooldowns takes unit target returns nothing
            local integer index= 0
            local ability spell= BlzGetUnitAbilityByIndex(target, 0)
            loop
                exitwhen spell == null
                call ReduceCooldown(target , BlzGetAbilityId(spell) , AltairE_CooldownReduction)
                set index=index + 1
                set spell=BlzGetUnitAbilityByIndex(target, index)
            endloop
            set spell=null
        endfunction

        function s__AltairSpells__AltairE_KS_Release takes integer this returns nothing
            local integer level= IMaxBJ(1, GetUnitAbilityLevel(s__AltairSpells__AltairE_KS_hero[this], AltairE_ID))
            local real damage= GetHeroInt(s__AltairSpells__AltairE_KS_hero[this], true) * ( AltairE_DamageIntBase + AltairE_DamageIntStep * ( level - 1 ) )
            local real x= GetUnitX(s__AltairSpells__AltairE_KS_hero[this])
            local real y= GetUnitY(s__AltairSpells__AltairE_KS_hero[this])
            local effect sphere= EffectSpawn(AltairE_SphereModel , x , y , 0.0 , 1.0 , AltairE_SphereScale , 0.0)
            local unit target
            set s__AltairSpells__AltairE_KS_released[this]=true
            call ColorEffDummy3Alpha((s__AltairSpells__AltairE_KS_sword[this] ) , (( 0.0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.2)*1.0)) // INLINED!!
            set s__AltairSpells__AltairE_KS_sword[this]=null
            call ColorEffDummy3Alpha((sphere ) , (( AltairE_VisualTime - 0.4 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.4)*1.0)) // INLINED!!
            call ColorEffDummy3Alpha(((EffectSpawnScale(AltairE_ClockModel , x , y , 0.0 , 1.0 , 0.5 , 5.0 , 0.4 , 0.5 , AltairE_ClockScale)) ) , (( 0.25 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.35)*1.0)) // INLINED!!
            call ColorEffDummy3Alpha(((EffectSpawnScale(Altair_RingModel , x , y , 0.0 , 1.0 , 0.5 , 10.0 , 0.35 , 0.5 , AltairE_Aoe / 120.0)) ) , (( 0.25 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.35)*1.0)) // INLINED!!
            call GroupEnumUnitsInRange(AltairSpells__AltairGroup, x, y, AltairE_Aoe, NoDecor_Cond)
            loop
                set target=FirstOfGroup(AltairSpells__AltairGroup)
                exitwhen target == null
                call GroupRemoveUnit(AltairSpells__AltairGroup, target)
                if target != s__AltairSpells__AltairE_KS_hero[this] and AltairSpells__AltairAlive(target) and not IsUnitType(target, UNIT_TYPE_STRUCTURE) then
                    // Every ally and enemy returns to its origin: 5 sec off all cooldowns.
                    call s__AltairSpells__AltairE_KS_ReduceCooldowns(target)
                    call ColorEffDummy3Alpha(((AddSpecialEffectTarget(AltairE_ClockModel, target, "overhead")) ) , (( 0.25 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.35)*1.0)) // INLINED!!
                    if AltairSpells__AltairIsEnemy(s__AltairSpells__AltairE_KS_hero[this] , target) then
                        set GearDamageNextSource=(AltairE_ID) // INLINED!!
                        call dmgmag(s__AltairSpells__AltairE_KS_hero[this] , target , damage)
                        call DestroyEffect(AddSpecialEffectTarget(Altair_StampedeModel, target, "chest"))
                    endif
                endif
            endloop
            set AltairSpells__AltairEnumX=x
            set AltairSpells__AltairEnumY=y
            set AltairSpells__AltairEnumRadius=AltairE_Aoe
            call DecorRemove(s__AltairSpells__AltairE_KS_hero[this] , x , y , AltairE_Aoe , AltairE_Decor)
            call VisionTimed(GetOwningPlayer(s__AltairSpells__AltairE_KS_hero[this]) , x , y , AltairE_Aoe * 1.4 , 2.0)
            call SetRect(AltairSpells__AltairEnumRect, x - AltairE_Aoe, y - AltairE_Aoe, x + AltairE_Aoe, y + AltairE_Aoe)
            call EnumDestructablesInRect(AltairSpells__AltairEnumRect, null, function AltairSpells__AltairE_RestoreDecor)
            call AltairSpells__AltairE_RestoreTaken()
            set sphere=null
        endfunction

        function s__AltairSpells__AltairE_KS_Loop takes nothing returns nothing
            local integer index= 0
            local integer this
            loop
                exitwhen index >= s__AltairSpells__AltairE_KS_count
                set this=s__AltairSpells__AltairE_KS_active[index]
                set s__AltairSpells__AltairE_KS_elapsed[this]=s__AltairSpells__AltairE_KS_elapsed[this] + 0.03
                if not s__AltairSpells__AltairE_KS_released[this] and s__AltairSpells__AltairE_KS_elapsed[this] >= AltairE_StringTime then
                    call s__AltairSpells__AltairE_KS_Release(this)
                endif
                if s__AltairSpells__AltairE_KS_released[this] or not AltairSpells__AltairAlive(s__AltairSpells__AltairE_KS_hero[this]) then
                    if s__AltairSpells__AltairE_KS_sword[this] != null then
                        call DestroyEffect(s__AltairSpells__AltairE_KS_sword[this])
                        set s__AltairSpells__AltairE_KS_sword[this]=null
                    endif
                    set s__AltairSpells__AltairE_KS_hero[this]=null
                    set s__AltairSpells__AltairE_KS_count=s__AltairSpells__AltairE_KS_count - 1
                    set s__AltairSpells__AltairE_KS_active[index]=s__AltairSpells__AltairE_KS_active[s__AltairSpells__AltairE_KS_count]
                    call s__AltairSpells__AltairE_KS_deallocate(this)
                    call GearTimer03Release()
                else
                    set index=index + 1
                endif
            endloop
        endfunction

        function s__AltairSpells__AltairE_KS_Start takes unit caster returns nothing
            local integer this= s__AltairSpells__AltairE_KS__allocate()
            set s__AltairSpells__AltairE_KS_hero[this]=caster
            set s__AltairSpells__AltairE_KS_elapsed[this]=0.0
            set s__AltairSpells__AltairE_KS_released[this]=false
            // The PPSH is strung with a sword before the aura is released.
            set s__AltairSpells__AltairE_KS_sword[this]=EffectSpawn(Altair_SwordModel , GetUnitX(s__AltairSpells__AltairE_KS_hero[this]) + 60.0 * Cos(GetUnitFacing(s__AltairSpells__AltairE_KS_hero[this]) * bj_DEGTORAD) , GetUnitY(s__AltairSpells__AltairE_KS_hero[this]) + 60.0 * Sin(GetUnitFacing(s__AltairSpells__AltairE_KS_hero[this]) * bj_DEGTORAD) , GetUnitFacing(s__AltairSpells__AltairE_KS_hero[this]) , 1.0 , 0.2 , 110.0)
            call SetUnitAnimation(s__AltairSpells__AltairE_KS_hero[this], "spell")
            call ColorEffDummy3Alpha(((EffectSpawn(Altair_CircleModel , GetUnitX(s__AltairSpells__AltairE_KS_hero[this]) , GetUnitY(s__AltairSpells__AltairE_KS_hero[this]) , 0.0 , 1.0 , 1.5 , 5.0)) ) , (( 0.25 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.35)*1.0)) // INLINED!!
            set s__AltairSpells__AltairE_KS_active[s__AltairSpells__AltairE_KS_count]=this
            set s__AltairSpells__AltairE_KS_count=s__AltairSpells__AltairE_KS_count + 1
            call GearTimer03Acquire()
        endfunction

    // ==================== R: Factor Mimic ====================
    function AltairSpells__AltairR_CollectDecor takes nothing returns nothing
        local destructable decor= GetEnumDestructable()
        local real dx= GetDestructableX(decor) - AltairSpells__AltairEnumX
        local real dy= GetDestructableY(decor) - AltairSpells__AltairEnumY
        local integer id= GetDestructableTypeId(decor)
        if AltairSpells__AltairRCandidateCount < 64 and GetDestructableLife(decor) > 0.405 and dx * dx + dy * dy <= AltairSpells__AltairEnumRadius * AltairSpells__AltairEnumRadius then
            if AltairSpells__AltairDecorIndex(id) >= 0 or ( id == AltairR_TrainDecorID and AltairSpells__AltairEnumTrain ) then
                set AltairSpells__AltairRCandidate[AltairSpells__AltairRCandidateCount]=decor
                set AltairSpells__AltairRCandidateDistance[AltairSpells__AltairRCandidateCount]=dx * dx + dy * dy
                set AltairSpells__AltairRCandidateCount=AltairSpells__AltairRCandidateCount + 1
            endif
        endif
        set decor=null
    endfunction

    // The train dummies have Locust, so range enumeration cannot see them.
    function AltairSpells__AltairR_TrainKind takes real positionX,real positionY returns integer
        local unit train
        local integer kind= AltairR_KindMetro
        local real best= AltairR_TrainSearch * AltairR_TrainSearch
        local real dx
        local real dy
        call GroupEnumUnitsOfPlayer(AltairSpells__AltairGroup, Player(PLAYER_NEUTRAL_PASSIVE), null)
        loop
            set train=FirstOfGroup(AltairSpells__AltairGroup)
            exitwhen train == null
            call GroupRemoveUnit(AltairSpells__AltairGroup, train)
            if GetUnitTypeId(train) == AltairR_TrainMetroID or GetUnitTypeId(train) == AltairR_TrainThomasID then
                set dx=GetUnitX(train) - positionX
                set dy=GetUnitY(train) - positionY
                if dx * dx + dy * dy <= best then
                    set best=dx * dx + dy * dy
                    if GetUnitTypeId(train) == AltairR_TrainThomasID then
                        set kind=AltairR_KindThomas
                    else
                        set kind=AltairR_KindMetro
                    endif
                endif
            endif
        endloop
        return kind
    endfunction

    // R gate: a light splash at once, the seal unfolds (Birth) GateDelay later, DestroyEffect fades it by its death.

        function s__AltairSpells__AltairRGate_KS_Open takes real gateX,real gateY,real height,real angle returns nothing
            local integer this= s__AltairSpells__AltairRGate_KS__allocate()
            local effect splash= AddSpecialEffect(AltairR_SplashModel, gateX, gateY)
            set s__AltairSpells__AltairRGate_KS_x[this]=gateX
            set s__AltairSpells__AltairRGate_KS_y[this]=gateY
            set s__AltairSpells__AltairRGate_KS_z[this]=AltairSpells__AltairGroundZ(gateX , gateY) + height
            set s__AltairSpells__AltairRGate_KS_facing[this]=angle
            set s__AltairSpells__AltairRGate_KS_elapsed[this]=0.0
            set s__AltairSpells__AltairRGate_KS_gate[this]=null
            // The splash model only has Death: destroying it right away plays it once and removes it.
            call BlzSetSpecialEffectOrientation(splash, s__AltairSpells__AltairRGate_KS_facing[this], 0.0, 0.0)
            call BlzSetSpecialEffectPosition(splash, s__AltairSpells__AltairRGate_KS_x[this], s__AltairSpells__AltairRGate_KS_y[this], s__AltairSpells__AltairRGate_KS_z[this])
            call DestroyEffect(splash)
            set splash=null
            set s__AltairSpells__AltairRGate_KS_active[s__AltairSpells__AltairRGate_KS_count]=this
            set s__AltairSpells__AltairRGate_KS_count=s__AltairSpells__AltairRGate_KS_count + 1
            call GearTimer03Acquire()
        endfunction

        function s__AltairSpells__AltairRGate_KS_Loop takes nothing returns nothing
            local integer index= 0
            local integer this
            loop
                exitwhen index >= s__AltairSpells__AltairRGate_KS_count
                set this=s__AltairSpells__AltairRGate_KS_active[index]
                set s__AltairSpells__AltairRGate_KS_elapsed[this]=s__AltairSpells__AltairRGate_KS_elapsed[this] + 0.03
                if s__AltairSpells__AltairRGate_KS_gate[this] == null and s__AltairSpells__AltairRGate_KS_elapsed[this] >= AltairR_GateDelay then
                    set s__AltairSpells__AltairRGate_KS_gate[this]=AddSpecialEffect(AltairR_GateModel, s__AltairSpells__AltairRGate_KS_x[this], s__AltairSpells__AltairRGate_KS_y[this])
                    call BlzSetSpecialEffectOrientation(s__AltairSpells__AltairRGate_KS_gate[this], s__AltairSpells__AltairRGate_KS_facing[this], 0.0, 0.0)
                    call BlzSetSpecialEffectPosition(s__AltairSpells__AltairRGate_KS_gate[this], s__AltairSpells__AltairRGate_KS_x[this], s__AltairSpells__AltairRGate_KS_y[this], s__AltairSpells__AltairRGate_KS_z[this])
                    call BlzPlaySpecialEffect(s__AltairSpells__AltairRGate_KS_gate[this], ANIM_TYPE_BIRTH)
                endif
                if s__AltairSpells__AltairRGate_KS_elapsed[this] >= AltairR_PortalLife then
                    call DestroyEffect(s__AltairSpells__AltairRGate_KS_gate[this])
                    set s__AltairSpells__AltairRGate_KS_gate[this]=null
                    set s__AltairSpells__AltairRGate_KS_count=s__AltairSpells__AltairRGate_KS_count - 1
                    set s__AltairSpells__AltairRGate_KS_active[index]=s__AltairSpells__AltairRGate_KS_active[s__AltairSpells__AltairRGate_KS_count]
                    call s__AltairSpells__AltairRGate_KS_deallocate(this)
                    call GearTimer03Release()
                else
                    set index=index + 1
                endif
            endloop
        endfunction

    // One copy: leaves the portal together with the others, smashes everything on its way, then lands.

        function s__AltairSpells__AltairRMissile_KS_DecorDamage takes integer this returns real
            if AltairSpells__AltairKindWeight(s__AltairSpells__AltairRMissile_KS_kind[this]) >= 3 then
                return AltairR_DecorHeavy
            endif
            return AltairR_DecorSmall
        endfunction

        function s__AltairSpells__AltairRMissile_KS_Width takes integer this returns real
            local integer weight= AltairSpells__AltairKindWeight(s__AltairSpells__AltairRMissile_KS_kind[this])
            if weight == 1 then
                return 140.0
            elseif weight == 2 then
                return 190.0
            elseif weight == 3 then
                return 260.0
            endif
            return 360.0
        endfunction

        function s__AltairSpells__AltairRMissile_KS_Impact takes integer this returns nothing
            local integer weight= AltairSpells__AltairKindWeight(s__AltairSpells__AltairRMissile_KS_kind[this])
            local integer decorId= AltairSpells__AltairKindDecorId(s__AltairSpells__AltairRMissile_KS_kind[this])
            local real aoe= 220.0
            local real hitDamage= s__AltairSpells__AltairRMissile_KS_damage[this]
            local real stun= 0.3
            local integer hits
            local unit target
            if weight == 2 then
                set aoe=280.0
            elseif weight == 3 then
                set aoe=360.0
                set stun=0.5
            elseif weight == 4 then
                set aoe=500.0
                set stun=1.5
                call DestroyEffect(EffectSpawn(AltairR_TrainSlashModel , s__AltairSpells__AltairRMissile_KS_targetX[this] , s__AltairSpells__AltairRMissile_KS_targetY[this] , GetRandomReal(0.0, 359.0) , 1.0 , 1.33 , 1.0))
                call DestroyEffect(EffectSpawn(AltairR_TrainImpactModel , s__AltairSpells__AltairRMissile_KS_targetX[this] , s__AltairSpells__AltairRMissile_KS_targetY[this] , GetRandomReal(0.0, 359.0) , 1.0 , 2.0 , 1.0))
            endif
            if decorId == 'B00O' then // explosive barrel
                set aoe=aoe + 80.0
                set hitDamage=hitDamage * 1.5
                call DestroyEffect(EffectSpawn(AltairR_BarrelModel , s__AltairSpells__AltairRMissile_KS_targetX[this] , s__AltairSpells__AltairRMissile_KS_targetY[this] , 0.0 , 1.0 , 0.65 , 1.0))
            elseif decorId == 'B00T' then // hydrant
                call DestroyEffect(EffectSpawn(AltairR_HydrantModel , s__AltairSpells__AltairRMissile_KS_targetX[this] , s__AltairSpells__AltairRMissile_KS_targetY[this] , GetRandomReal(0.0, 359.0) , 0.75 , 1.25 , 1.0))
            elseif decorId == 'B00S' or decorId == 'B00X' or decorId == 'B00Y' or decorId == 'B014' then // metal
                call DestroyEffect(EffectSpawn(AltairR_MetalModel , s__AltairSpells__AltairRMissile_KS_targetX[this] , s__AltairSpells__AltairRMissile_KS_targetY[this] , GetRandomReal(0.0, 359.0) , 0.4 , 2.15 , 51.0))
            endif
            call DestroyEffect(EffectSpawn(AltairR_ImpactModel , s__AltairSpells__AltairRMissile_KS_targetX[this] , s__AltairSpells__AltairRMissile_KS_targetY[this] , GetRandomReal(0.0, 359.0) , 1.0 , 0.6 + 0.3 * weight , 1.0))
            call DestroyEffect(EffectSpawn(Altair_DustModel , s__AltairSpells__AltairRMissile_KS_targetX[this] , s__AltairSpells__AltairRMissile_KS_targetY[this] , GetRandomReal(0.0, 359.0) , 1.0 , 0.7 + 0.3 * weight , 1.0))
            call ColorEffDummy3Alpha(((EffectSpawnScale(Altair_RingModel , s__AltairSpells__AltairRMissile_KS_targetX[this] , s__AltairSpells__AltairRMissile_KS_targetY[this] , 0.0 , 1.0 , 0.5 , 10.0 , 0.25 , 0.5 , aoe / 100.0)) ) , (( 0.25 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.35)*1.0)) // INLINED!!
            call GroupEnumUnitsInRange(AltairSpells__AltairGroup, s__AltairSpells__AltairRMissile_KS_targetX[this], s__AltairSpells__AltairRMissile_KS_targetY[this], aoe, NoDecor_Cond)
            loop
                set target=FirstOfGroup(AltairSpells__AltairGroup)
                exitwhen target == null
                call GroupRemoveUnit(AltairSpells__AltairGroup, target)
                if AltairSpells__AltairIsEnemy(s__AltairSpells__AltairRMissile_KS_hero[this] , target) then
                    // Several copies landing on one enemy overload it.
                    set hits=LoadInteger(AltairSpells__AltairTable, s__AltairSpells__AltairRMissile_KS_throwKey[this], GetHandleId(target)) + 1
                    call SaveInteger(AltairSpells__AltairTable, s__AltairSpells__AltairRMissile_KS_throwKey[this], GetHandleId(target), hits)
                    set GearDamageNextSource=(AltairR_ID) // INLINED!!
                    call dmgphys(s__AltairSpells__AltairRMissile_KS_hero[this] , target , hitDamage)
                    call StunUnit(s__AltairSpells__AltairRMissile_KS_hero[this] , target , RMinBJ(AltairR_MaxStun, stun + AltairR_OverloadStun * ( hits - 1 )))
                    call DestroyEffect(AddSpecialEffectTarget(Altair_StampedeModel, target, "chest"))
                    if decorId == 'B00T' then
                        call MUE(target , AltairR_HydrantPush , 0.42 , Atan2(GetUnitY(target) - s__AltairSpells__AltairRMissile_KS_targetY[this], GetUnitX(target) - s__AltairSpells__AltairRMissile_KS_targetX[this]))
                    endif
                endif
            endloop
            call DecorRemove(s__AltairSpells__AltairRMissile_KS_hero[this] , s__AltairSpells__AltairRMissile_KS_targetX[this] , s__AltairSpells__AltairRMissile_KS_targetY[this] , aoe , s__AltairSpells__AltairRMissile_KS_DecorDamage(this))
            call VisionTimed(GetOwningPlayer(s__AltairSpells__AltairRMissile_KS_hero[this]) , s__AltairSpells__AltairRMissile_KS_targetX[this] , s__AltairSpells__AltairRMissile_KS_targetY[this] , aoe * 1.6 , 2.0)
        endfunction

        // Everything on the flight path is broken: decor, enemies hit once per copy and dragged along.
        function s__AltairSpells__AltairRMissile_KS_Smash takes integer this,real x,real y returns nothing
            local real width= s__AltairSpells__AltairRMissile_KS_Width(this)
            local unit target
            if s__AltairSpells__AltairRMissile_KS_smashCount[this] == 0 then
                call DecorRemove(s__AltairSpells__AltairRMissile_KS_hero[this] , x , y , width , s__AltairSpells__AltairRMissile_KS_DecorDamage(this))
            endif
            set s__AltairSpells__AltairRMissile_KS_smashCount[this]=s__AltairSpells__AltairRMissile_KS_smashCount[this] + 1
            if s__AltairSpells__AltairRMissile_KS_smashCount[this] >= 5 then
                set s__AltairSpells__AltairRMissile_KS_smashCount[this]=0
            endif
            call GroupEnumUnitsInRange(AltairSpells__AltairGroup, x, y, width, NoDecor_Cond)
            loop
                set target=FirstOfGroup(AltairSpells__AltairGroup)
                exitwhen target == null
                call GroupRemoveUnit(AltairSpells__AltairGroup, target)
                if AltairSpells__AltairIsEnemy(s__AltairSpells__AltairRMissile_KS_hero[this] , target) then
                    if not IsUnitInGroup(target, s__AltairSpells__AltairRMissile_KS_path[this]) then
                        call GroupAddUnit(s__AltairSpells__AltairRMissile_KS_path[this], target)
                        set GearDamageNextSource=(AltairR_ID) // INLINED!!
                        call dmgphys(s__AltairSpells__AltairRMissile_KS_hero[this] , target , s__AltairSpells__AltairRMissile_KS_damage[this] * AltairR_PathDamage)
                        call DestroyEffect(AddSpecialEffectTarget(Altair_HitModel, target, "chest"))
                        call MUE(target , AltairR_HitPush , AltairR_HitPushTime , s__AltairSpells__AltairRMissile_KS_flight[this])
                    endif
                    call MoveUnit(target , AltairR_DragStep , s__AltairSpells__AltairRMissile_KS_flight[this])
                endif
            endloop
            set target=null
        endfunction

        // Movement every 0.03 tick (cheap), path checks every 0.06 sec, decor on every 5th check.
        function s__AltairSpells__AltairRMissile_KS_Loop takes nothing returns nothing
            local integer index= 0
            local integer this
            local real progress
            local integer remainingCopies
            loop
                exitwhen index >= s__AltairSpells__AltairRMissile_KS_count
                set this=s__AltairSpells__AltairRMissile_KS_active[index]
                if s__AltairSpells__AltairRMissile_KS_delay[this] > 0.0 then
                    set s__AltairSpells__AltairRMissile_KS_delay[this]=s__AltairSpells__AltairRMissile_KS_delay[this] - 0.03
                    set index=index + 1
                else
                    set s__AltairSpells__AltairRMissile_KS_elapsed[this]=s__AltairSpells__AltairRMissile_KS_elapsed[this] + 0.03
                    set s__AltairSpells__AltairRMissile_KS_travelled[this]=s__AltairSpells__AltairRMissile_KS_travelled[this] + s__AltairSpells__AltairRMissile_KS_move[this]
                    set progress=RMinBJ(1.0, s__AltairSpells__AltairRMissile_KS_travelled[this] / s__AltairSpells__AltairRMissile_KS_range[this])
                    set s__AltairSpells__AltairRMissile_KS_curX[this]=s__AltairSpells__AltairRMissile_KS_curX[this] + s__AltairSpells__AltairRMissile_KS_move[this] * Cos(s__AltairSpells__AltairRMissile_KS_flight[this])
                    set s__AltairSpells__AltairRMissile_KS_curY[this]=s__AltairSpells__AltairRMissile_KS_curY[this] + s__AltairSpells__AltairRMissile_KS_move[this] * Sin(s__AltairSpells__AltairRMissile_KS_flight[this])
                    // Light and medium copies tumble slowly; heavy ones fly flat, without spinning.
                    if AltairSpells__AltairKindWeight(s__AltairSpells__AltairRMissile_KS_kind[this]) < 3 then
                        set s__AltairSpells__AltairRMissile_KS_spin[this]=s__AltairSpells__AltairRMissile_KS_spin[this] + AltairR_SpinSpeed * 0.03
                    endif
                    call BlzSetSpecialEffectPosition(s__AltairSpells__AltairRMissile_KS_art[this], s__AltairSpells__AltairRMissile_KS_curX[this], s__AltairSpells__AltairRMissile_KS_curY[this], s__AltairSpells__AltairRMissile_KS_startZ[this] + ( s__AltairSpells__AltairRMissile_KS_endZ[this] - s__AltairSpells__AltairRMissile_KS_startZ[this] ) * progress)
                    call BlzSetSpecialEffectOrientation(s__AltairSpells__AltairRMissile_KS_art[this], s__AltairSpells__AltairRMissile_KS_yaw[this], s__AltairSpells__AltairRMissile_KS_spin[this], 0.0)
                    set s__AltairSpells__AltairRMissile_KS_smashTimer[this]=s__AltairSpells__AltairRMissile_KS_smashTimer[this] + 0.03
                    // Path checks and the impact deal damage (the whole DmgSys runs for every hit): each runs
                    // in its own thread, so a big volley can never exhaust this loop's op limit and freeze copies.
                    if s__AltairSpells__AltairRMissile_KS_smashTimer[this] >= AltairR_SmashPeriod and progress < 1.0 then
                        set s__AltairSpells__AltairRMissile_KS_smashTimer[this]=0.0
                        call sx__AltairSpells__AltairRMissile_KS_Smash(this,s__AltairSpells__AltairRMissile_KS_curX[this] , s__AltairSpells__AltairRMissile_KS_curY[this])
                    endif
                    if progress >= 1.0 then
                        call sx__AltairSpells__AltairRMissile_KS_Smash(this,s__AltairSpells__AltairRMissile_KS_curX[this] , s__AltairSpells__AltairRMissile_KS_curY[this])
                        call sx__AltairSpells__AltairRMissile_KS_Impact(this)
                        // Every copy fades out smoothly instead of popping.
                        call ColorEffDummy3Alpha((s__AltairSpells__AltairRMissile_KS_art[this] ) , (( 0.0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.3)*1.0)) // INLINED!!
                        set remainingCopies=LoadInteger(AltairSpells__AltairTable, s__AltairSpells__AltairRMissile_KS_throwKey[this], 0) - 1
                        if remainingCopies <= 0 then
                            // The last copy of the volley owns the shared group.
                            call DestroyGroup(s__AltairSpells__AltairRMissile_KS_path[this])
                            call FlushChildHashtable(AltairSpells__AltairTable, s__AltairSpells__AltairRMissile_KS_throwKey[this])
                        else
                            call SaveInteger(AltairSpells__AltairTable, s__AltairSpells__AltairRMissile_KS_throwKey[this], 0, remainingCopies)
                        endif
                        set s__AltairSpells__AltairRMissile_KS_art[this]=null
                        set s__AltairSpells__AltairRMissile_KS_path[this]=null
                        set s__AltairSpells__AltairRMissile_KS_hero[this]=null
                        set s__AltairSpells__AltairRMissile_KS_count=s__AltairSpells__AltairRMissile_KS_count - 1
                        set s__AltairSpells__AltairRMissile_KS_active[index]=s__AltairSpells__AltairRMissile_KS_active[s__AltairSpells__AltairRMissile_KS_count]
                        call s__AltairSpells__AltairRMissile_KS_deallocate(this)
                        call GearTimer03Release()
                    else
                        set index=index + 1
                    endif
                endif
            endloop
        endfunction

        // Heavier copies fly slower; each speed is random inside its weight band.
        // The volley flies together: one common speed, heavy copies only slightly slower, small random spread.
        function s__AltairSpells__AltairRMissile_KS_Speed takes integer weight returns real
            local real speed= AltairR_ThrowSpeed * GetRandomReal(0.92, 1.08)
            if weight >= 3 then
                set speed=speed * 0.9
            endif
            return speed
        endfunction

        function s__AltairSpells__AltairRMissile_KS_Launch takes unit caster,integer copyKind,real fromX,real fromY,real fromZ,real positionX,real positionY,real delayTime,integer key,group shared returns nothing
            local integer this= s__AltairSpells__AltairRMissile_KS__allocate()
            local integer weight= AltairSpells__AltairKindWeight(copyKind)
            local real fade
            set s__AltairSpells__AltairRMissile_KS_hero[this]=caster
            set s__AltairSpells__AltairRMissile_KS_kind[this]=copyKind
            set s__AltairSpells__AltairRMissile_KS_level[this]=IMaxBJ(1, GetUnitAbilityLevel(caster, AltairR_ID))
            set s__AltairSpells__AltairRMissile_KS_throwKey[this]=key
            set s__AltairSpells__AltairRMissile_KS_startX[this]=fromX
            set s__AltairSpells__AltairRMissile_KS_startY[this]=fromY
            set s__AltairSpells__AltairRMissile_KS_startZ[this]=fromZ
            set s__AltairSpells__AltairRMissile_KS_targetX[this]=positionX
            set s__AltairSpells__AltairRMissile_KS_targetY[this]=positionY
            set s__AltairSpells__AltairRMissile_KS_delay[this]=RMaxBJ(0.03, delayTime)
            set s__AltairSpells__AltairRMissile_KS_elapsed[this]=0.0
            set s__AltairSpells__AltairRMissile_KS_speed[this]=s__AltairSpells__AltairRMissile_KS_Speed(weight)
            // Spread the copies' path work over different ticks.
            set s__AltairSpells__AltairRMissile_KS_smashTimer[this]=GetRandomReal(0.0, AltairR_SmashPeriod)
            set s__AltairSpells__AltairRMissile_KS_smashCount[this]=GetRandomInt(0, 4)
            set s__AltairSpells__AltairRMissile_KS_endZ[this]=AltairSpells__AltairGroundZ(s__AltairSpells__AltairRMissile_KS_targetX[this] , s__AltairSpells__AltairRMissile_KS_targetY[this])
            set s__AltairSpells__AltairRMissile_KS_curX[this]=s__AltairSpells__AltairRMissile_KS_startX[this]
            set s__AltairSpells__AltairRMissile_KS_curY[this]=s__AltairSpells__AltairRMissile_KS_startY[this]
            set s__AltairSpells__AltairRMissile_KS_duration[this]=RMaxBJ(0.2, SquareRoot(( s__AltairSpells__AltairRMissile_KS_targetX[this] - s__AltairSpells__AltairRMissile_KS_startX[this] ) * ( s__AltairSpells__AltairRMissile_KS_targetX[this] - s__AltairSpells__AltairRMissile_KS_startX[this] ) + ( s__AltairSpells__AltairRMissile_KS_targetY[this] - s__AltairSpells__AltairRMissile_KS_startY[this] ) * ( s__AltairSpells__AltairRMissile_KS_targetY[this] - s__AltairSpells__AltairRMissile_KS_startY[this] )) / s__AltairSpells__AltairRMissile_KS_speed[this])
            set s__AltairSpells__AltairRMissile_KS_flight[this]=Atan2(s__AltairSpells__AltairRMissile_KS_targetY[this] - s__AltairSpells__AltairRMissile_KS_startY[this], s__AltairSpells__AltairRMissile_KS_targetX[this] - s__AltairSpells__AltairRMissile_KS_startX[this])
            set s__AltairSpells__AltairRMissile_KS_yaw[this]=s__AltairSpells__AltairRMissile_KS_flight[this]
            // The Metro model faces backwards (RoundEnd turns it by 180 degrees).
            if copyKind == AltairR_KindMetro then
                set s__AltairSpells__AltairRMissile_KS_yaw[this]=s__AltairSpells__AltairRMissile_KS_yaw[this] + bj_PI
            endif
            set s__AltairSpells__AltairRMissile_KS_spin[this]=0.0
            if weight >= 3 then
                set s__AltairSpells__AltairRMissile_KS_spin[this]=AltairR_HeavyTilt
                if copyKind == AltairR_KindMetro then
                    set s__AltairSpells__AltairRMissile_KS_spin[this]=- AltairR_HeavyTilt
                endif
            endif
            set s__AltairSpells__AltairRMissile_KS_art[this]=AddSpecialEffect(AltairSpells__AltairKindModel(s__AltairSpells__AltairRMissile_KS_kind[this]), s__AltairSpells__AltairRMissile_KS_startX[this], s__AltairSpells__AltairRMissile_KS_startY[this])
            call BlzSetSpecialEffectScale(s__AltairSpells__AltairRMissile_KS_art[this], AltairSpells__AltairKindScale(s__AltairSpells__AltairRMissile_KS_kind[this]) * 0.7)
            call BlzSetSpecialEffectOrientation(s__AltairSpells__AltairRMissile_KS_art[this], s__AltairSpells__AltairRMissile_KS_yaw[this], s__AltairSpells__AltairRMissile_KS_spin[this], 0.0)
            call BlzSetSpecialEffectZ(s__AltairSpells__AltairRMissile_KS_art[this], s__AltairSpells__AltairRMissile_KS_startZ[this])
            // The copy materialises in the opened gate: hidden, then alpha 0 -> 255 over a random 0.24-0.4 sec
            // that ends when the volley leaves.
            set fade=GetRandomReal(AltairR_AppearMin, AltairR_AppearMax)
            call ColorEffDummy4(s__AltairSpells__AltairRMissile_KS_art[this] , RMaxBJ(0.0, s__AltairSpells__AltairRMissile_KS_delay[this] - fade) , 255 , 255 , 255 , fade)
            call DestroyEffect(EffectSpawn(Altair_SwitchModel , s__AltairSpells__AltairRMissile_KS_startX[this] , s__AltairSpells__AltairRMissile_KS_startY[this] , 0.0 , 1.5 , 0.7 , s__AltairSpells__AltairRMissile_KS_startZ[this] - AltairSpells__AltairGroundZ(s__AltairSpells__AltairRMissile_KS_startX[this] , s__AltairSpells__AltairRMissile_KS_startY[this])))
            set s__AltairSpells__AltairRMissile_KS_path[this]=shared
            set s__AltairSpells__AltairRMissile_KS_range[this]=RMaxBJ(1.0, SquareRoot(( s__AltairSpells__AltairRMissile_KS_targetX[this] - s__AltairSpells__AltairRMissile_KS_startX[this] ) * ( s__AltairSpells__AltairRMissile_KS_targetX[this] - s__AltairSpells__AltairRMissile_KS_startX[this] ) + ( s__AltairSpells__AltairRMissile_KS_targetY[this] - s__AltairSpells__AltairRMissile_KS_startY[this] ) * ( s__AltairSpells__AltairRMissile_KS_targetY[this] - s__AltairSpells__AltairRMissile_KS_startY[this] )))
            set s__AltairSpells__AltairRMissile_KS_move[this]=s__AltairSpells__AltairRMissile_KS_speed[this] * 0.03
            set s__AltairSpells__AltairRMissile_KS_travelled[this]=0.0
            set s__AltairSpells__AltairRMissile_KS_damage[this]=GetHeroInt(caster, true) * AltairSpells__AltairKindFactor(copyKind) + AltairR_DamageStatic + AltairR_DamageStaticStep * ( s__AltairSpells__AltairRMissile_KS_level[this] - 1 )
            set s__AltairSpells__AltairRMissile_KS_active[s__AltairSpells__AltairRMissile_KS_count]=this
            set s__AltairSpells__AltairRMissile_KS_count=s__AltairSpells__AltairRMissile_KS_count + 1
            call GearTimer03Acquire()
        endfunction


        function s__AltairSpells__AltairR_KS_Release takes integer this returns nothing
            set s__AltairSpells__AltairR_KS_stored[this]=0
            call RemoveSavedInteger(AltairSpells__AltairTable, GetHandleId(s__AltairSpells__AltairR_KS_hero[this]), 2)
        endfunction

        function s__AltairSpells__AltairR_KS_Loop takes nothing returns nothing
            local integer index= 0
            local integer this
            loop
                exitwhen index >= s__AltairSpells__AltairR_KS_count
                set this=s__AltairSpells__AltairR_KS_active[index]
                set s__AltairSpells__AltairR_KS_window[this]=s__AltairSpells__AltairR_KS_window[this] - 0.03
                if s__AltairSpells__AltairR_KS_stored[this] == 0 or s__AltairSpells__AltairR_KS_window[this] <= 0.0 or not AltairSpells__AltairAlive(s__AltairSpells__AltairR_KS_hero[this]) then
                    if s__AltairSpells__AltairR_KS_stored[this] > 0 then
                        call BlzStartUnitAbilityCooldown(s__AltairSpells__AltairR_KS_hero[this], AltairR_ID, AltairR_Cooldown)
                    endif
                    call s__AltairSpells__AltairR_KS_Release(this)
                    set s__AltairSpells__AltairR_KS_hero[this]=null
                    set s__AltairSpells__AltairR_KS_count=s__AltairSpells__AltairR_KS_count - 1
                    set s__AltairSpells__AltairR_KS_active[index]=s__AltairSpells__AltairR_KS_active[s__AltairSpells__AltairR_KS_count]
                    call s__AltairSpells__AltairR_KS_deallocate(this)
                    call GearTimer03Release()
                else
                    set index=index + 1
                endif
            endloop
        endfunction

        function s__AltairSpells__AltairR_KS_Absorb takes unit caster,real positionX,real positionY returns boolean
            local integer this
            local integer best
            local integer slot
            local integer id
            local boolean trainTaken= false
            local destructable decor
            local real decorX
            local real decorY
            call ColorEffDummy3Alpha(((EffectSpawn(Altair_CircleModel , positionX , positionY , 0.0 , 1.0 , AltairR_Aoe / 160.0 , 5.0)) ) , (( 0.25 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.35)*1.0)) // INLINED!!
            set AltairSpells__AltairEnumX=positionX
            set AltairSpells__AltairEnumY=positionY
            set AltairSpells__AltairEnumRadius=AltairR_Aoe
            set AltairSpells__AltairEnumTrain=GetHeroLevel(caster) >= AltairR_TrainHeroLevel
            set AltairSpells__AltairRCandidateCount=0
            call SetRect(AltairSpells__AltairEnumRect, positionX - AltairR_Aoe, positionY - AltairR_Aoe, positionX + AltairR_Aoe, positionY + AltairR_Aoe)
            call EnumDestructablesInRect(AltairSpells__AltairEnumRect, null, function AltairSpells__AltairR_CollectDecor)
            if AltairSpells__AltairRCandidateCount == 0 then
                return false
            endif
            set this=s__AltairSpells__AltairR_KS__allocate()
            set s__AltairSpells__AltairR_KS_hero[this]=caster
            set s__AltairSpells__AltairR_KS_stored[this]=0
            set s__AltairSpells__AltairR_KS_window[this]=AltairR_Window
            call SetUnitAnimation(s__AltairSpells__AltairR_KS_hero[this], "spell")
            loop
                exitwhen s__AltairSpells__AltairR_KS_stored[this] >= AltairR_MaxCopies or AltairSpells__AltairRCandidateCount == 0
                set best=0
                set slot=1
                loop
                    exitwhen slot >= AltairSpells__AltairRCandidateCount
                    if AltairSpells__AltairRCandidateDistance[slot] < AltairSpells__AltairRCandidateDistance[best] then
                        set best=slot
                    endif
                    set slot=slot + 1
                endloop
                set decor=AltairSpells__AltairRCandidate[best]
                set id=GetDestructableTypeId(decor)
                if id != AltairR_TrainDecorID or not trainTaken then
                    set decorX=GetDestructableX(decor)
                    set decorY=GetDestructableY(decor)
                    if id == AltairR_TrainDecorID then
                        set trainTaken=true
                        set s___AltairSpells__AltairR_KS_kind[s__AltairSpells__AltairR_KS_kind[this]+s__AltairSpells__AltairR_KS_stored[this]]=AltairSpells__AltairR_TrainKind(decorX , decorY)
                    else
                        set s___AltairSpells__AltairR_KS_kind[s__AltairSpells__AltairR_KS_kind[this]+s__AltairSpells__AltairR_KS_stored[this]]=AltairSpells__AltairDecorIndex(id)
                    endif
                    // A marker under the object, the original breaks, a perfect copy is stored.
                    // Destroyed decor returns on the round reset (DecorRestore) or by Outline Origin.
                    call ColorEffDummy3Alpha(((EffectSpawn(Altair_CircleModel , decorX , decorY , 0.0 , 1.5 , 0.4 + 0.25 * AltairSpells__AltairKindWeight(s___AltairSpells__AltairR_KS_kind[s__AltairSpells__AltairR_KS_kind[this]+s__AltairSpells__AltairR_KS_stored[this]]) , 8.0)) ) , (( 0.25 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.35)*1.0)) // INLINED!!
                    call ColorEffDummy3Alpha(((EffectSpawnScale(Altair_RingModel , decorX , decorY , 0.0 , 1.0 , 0.3 , 20.0 , 0.3 , 0.3 , 1.5)) ) , (( 0.25 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.35)*1.0)) // INLINED!!
                    call DestroyEffect(EffectSpawn(Altair_SwitchModel , decorX , decorY , 0.0 , 1.5 , 0.4 + 0.2 * AltairSpells__AltairKindWeight(s___AltairSpells__AltairR_KS_kind[s__AltairSpells__AltairR_KS_kind[this]+s__AltairSpells__AltairR_KS_stored[this]]) , 20.0))
                    call KillDestructable(decor)
                    if id != AltairR_TrainDecorID then
                        set AltairSpells__AltairRTaken[AltairSpells__AltairRTakenNext]=decor
                        set AltairSpells__AltairRTakenNext=ModuloInteger(AltairSpells__AltairRTakenNext + 1, 128)
                    endif
                    set s__AltairSpells__AltairR_KS_stored[this]=s__AltairSpells__AltairR_KS_stored[this] + 1
                endif
                set AltairSpells__AltairRCandidateCount=AltairSpells__AltairRCandidateCount - 1
                set AltairSpells__AltairRCandidate[best]=AltairSpells__AltairRCandidate[AltairSpells__AltairRCandidateCount]
                set AltairSpells__AltairRCandidateDistance[best]=AltairSpells__AltairRCandidateDistance[AltairSpells__AltairRCandidateCount]
                set AltairSpells__AltairRCandidate[AltairSpells__AltairRCandidateCount]=null
            endloop
            loop
                exitwhen AltairSpells__AltairRCandidateCount == 0
                set AltairSpells__AltairRCandidateCount=AltairSpells__AltairRCandidateCount - 1
                set AltairSpells__AltairRCandidate[AltairSpells__AltairRCandidateCount]=null
            endloop
            set decor=null
            call SaveInteger(AltairSpells__AltairTable, GetHandleId(s__AltairSpells__AltairR_KS_hero[this]), 2, this)
            call s__AltairSpells__AltairState_Voice((LoadInteger(AltairSpells__AltairTable, GetHandleId(s__AltairSpells__AltairR_KS_hero[this]), 0)),4 , "R" , 1 , 1)
            set s__AltairSpells__AltairR_KS_active[s__AltairSpells__AltairR_KS_count]=this
            set s__AltairSpells__AltairR_KS_count=s__AltairSpells__AltairR_KS_count + 1
            call GearTimer03Acquire()
            return true
        endfunction

        // As Erza T-form R: a big portal opens behind her, every copy appears in it at once and they all fly together.
        function s__AltairSpells__AltairR_KS_Throw takes integer this,real positionX,real positionY returns nothing
            local integer slot= 0
            local integer key
            local real angle= GAngle2(s__AltairSpells__AltairR_KS_hero[this] , positionX , positionY)
            local real portalX= GetUnitX(s__AltairSpells__AltairR_KS_hero[this]) - AltairR_PortalBack * Cos(angle)
            local real portalY= GetUnitY(s__AltairSpells__AltairR_KS_hero[this]) - AltairR_PortalBack * Sin(angle)
            local real portalZ= AltairSpells__AltairGroundZ(portalX , portalY) + AltairR_PortalHeight
            local real side
            local real back
            local real range
            local real drift
            local group hits= CreateGroup()
            call s__AltairSpells__AltairRGate_KS_Open(portalX , portalY , AltairR_PortalHeight , angle)
            call ColorEffDummy3Alpha(((EffectSpawnScale(Altair_RingModel , portalX , portalY , 0.0 , 1.0 , 0.4 , AltairR_PortalHeight , 0.3 , 0.4 , 3.5)) ) , (( 0.25 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.35)*1.0)) // INLINED!!
            call s__AltairSpells__AltairState_Voice((LoadInteger(AltairSpells__AltairTable, GetHandleId(s__AltairSpells__AltairR_KS_hero[this]), 0)),5 , "R" , 2 , 2)
            set AltairSpells__AltairRThrowCounter=AltairSpells__AltairRThrowCounter + 1
            // Negative parent keys cannot collide with unit handle ids.
            set key=- AltairSpells__AltairRThrowCounter
            call SaveInteger(AltairSpells__AltairTable, key, 0, s__AltairSpells__AltairR_KS_stored[this])
            call VisionTimed(GetOwningPlayer(s__AltairSpells__AltairR_KS_hero[this]) , GetUnitX(s__AltairSpells__AltairR_KS_hero[this]) + AltairR_FlightRange * 0.5 * Cos(angle) , GetUnitY(s__AltairSpells__AltairR_KS_hero[this]) + AltairR_FlightRange * 0.5 * Sin(angle) , AltairR_FlightRange * 0.6 + 300.0 , 2.5)
            if AltairR_Debug then
                call DisplayTimedTextToPlayer(GetOwningPlayer(s__AltairSpells__AltairR_KS_hero[this]), 0.0, 0.0, 3.0, "Factor Mimic: " + I2S(s__AltairSpells__AltairR_KS_stored[this]) + " copies launched together")
            endif
            call SetUnitFacing(s__AltairSpells__AltairR_KS_hero[this], angle * bj_RADTODEG)
            call SetUnitAnimation(s__AltairSpells__AltairR_KS_hero[this], "spell")
            loop
                exitwhen slot >= s__AltairSpells__AltairR_KS_stored[this]
                // Even lanes across the portal with jitter, so copies never sit inside each other.
                set side=- AltairR_PortalHalfWidth + ( slot + GetRandomReal(0.2, 0.8) ) * 2.0 * AltairR_PortalHalfWidth / s__AltairSpells__AltairR_KS_stored[this]
                set back=GetRandomReal(- 60.0, 60.0)
                set range=AltairR_FlightRange + GetRandomReal(- AltairR_FlightRangeRandom, AltairR_FlightRangeRandom)
                set drift=RMaxBJ(- AltairR_PortalHalfWidth, RMinBJ(AltairR_PortalHalfWidth, side * AltairR_LineDrift))
                call s__AltairSpells__AltairRMissile_KS_Launch(s__AltairSpells__AltairR_KS_hero[this] , s___AltairSpells__AltairR_KS_kind[s__AltairSpells__AltairR_KS_kind[this]+slot] , portalX + back * Cos(angle) + side * Cos(angle + bj_PI / 2.0) , portalY + back * Sin(angle) + side * Sin(angle + bj_PI / 2.0) , AltairSpells__AltairGroundZ(portalX , portalY) + GetRandomReal(AltairR_PortalMinHeight, AltairR_PortalMaxHeight) , GetUnitX(s__AltairSpells__AltairR_KS_hero[this]) + range * Cos(angle) + drift * Cos(angle + bj_PI / 2.0) , GetUnitY(s__AltairSpells__AltairR_KS_hero[this]) + range * Sin(angle) + drift * Sin(angle + bj_PI / 2.0) , AltairR_PortalOpen , key , hits)
                set slot=slot + 1
            endloop
            call BlzStartUnitAbilityCooldown(s__AltairSpells__AltairR_KS_hero[this], AltairR_ID, AltairR_Cooldown)
            call s__AltairSpells__AltairR_KS_Release(this)
            set hits=null
        endfunction

        function s__AltairSpells__AltairR_KS_Start takes unit caster,real positionX,real positionY returns boolean
            local integer this= LoadInteger(AltairSpells__AltairTable, GetHandleId(caster), 2)
            if this != 0 and s__AltairSpells__AltairR_KS_stored[this] > 0 then
                call s__AltairSpells__AltairR_KS_Throw(this,positionX , positionY)
                return true
            endif
            return s__AltairSpells__AltairR_KS_Absorb(caster , positionX , positionY)
        endfunction

    // ==================== T: Fate Reconstruction ====================

        function s__AltairSpells__AltairT_KS_CanEnter takes integer this,unit target returns boolean
            return target != s__AltairSpells__AltairT_KS_hero[this] and AltairSpells__AltairAlive(target) and IsUnitType(target, UNIT_TYPE_HERO) and GetUnitAbilityLevel(target, 'Aloc') == 0 and not IsUnitInGroup(target, s__AltairSpells__AltairT_KS_members[this]) and not IsUnitInGroup(target, s__AltairSpells__AltairT_KS_pulling[this]) and not CheckCoordsInRect(s__AltairSpells__AltairT_KS_realm[this] , GetUnitX(target) , GetUnitY(target))
        endfunction

        function s__AltairSpells__AltairT_KS_AddMember takes integer this,unit target returns nothing
            local real angle= GetRandomReal(0.0, 2.0 * bj_PI)
            local real distance= GetRandomReal(0.0, AltairT_RealmSpread)
            call DestroyEffect(EffectSpawn(AltairT_TeleportModel , GetUnitX(target) , GetUnitY(target) , 0.0 , 1.0 , 1.0 , 0.0))
            call GroupAddUnit(s__AltairSpells__AltairT_KS_members[this], target)
            call SetUnitPosition(target, GetRectCenterX(s__AltairSpells__AltairT_KS_realm[this]) + distance * Cos(angle), GetRectCenterY(s__AltairSpells__AltairT_KS_realm[this]) + distance * Sin(angle))
            call DestroyEffect(EffectSpawn(AltairT_TeleportModel , GetUnitX(target) , GetUnitY(target) , 0.0 , 1.0 , 1.0 , 0.0))
            call DestroyEffect(EffectSpawn(Altair_ImageModel , GetUnitX(target) , GetUnitY(target) , GetUnitFacing(target) , 1.0 , 1.2 , 0.0))
            if GetLocalPlayer() == GetOwningPlayer(target) then
                call PanCameraToTimed(GetUnitX(target), GetUnitY(target), 0.0)
            endif
        endfunction

        function s__AltairSpells__AltairT_KS_Pull takes integer this,unit target returns nothing
            call GroupAddUnit(s__AltairSpells__AltairT_KS_pulling[this], target)
            set s__AltairSpells__AltairT_KS_memberCount[this]=s__AltairSpells__AltairT_KS_memberCount[this] + 1
            call ColorEffDummy3Alpha(((AddSpecialEffectTarget(Altair_RingModel, target, "origin")) ) , (( 0.25 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.35)*1.0)) // INLINED!!
        endfunction

        function s__AltairSpells__AltairT_KS_End takes integer this returns nothing
            local integer slot= 0
            local unit target
            loop
                set target=FirstOfGroup(s__AltairSpells__AltairT_KS_pulling[this])
                exitwhen target == null
                call GroupRemoveUnit(s__AltairSpells__AltairT_KS_pulling[this], target)
            endloop
            loop
                set target=FirstOfGroup(s__AltairSpells__AltairT_KS_members[this])
                exitwhen target == null
                call GroupRemoveUnit(s__AltairSpells__AltairT_KS_members[this], target)
                if GetUnitTypeId(target) != 0 then
                    call SetUnitPosition(target, s__AltairSpells__AltairT_KS_portalX[this] + 130.0 * Cos(slot * bj_PI / 2.0), s__AltairSpells__AltairT_KS_portalY[this] + 130.0 * Sin(slot * bj_PI / 2.0))
                    call DestroyEffect(EffectSpawn(AltairT_TeleportModel , GetUnitX(target) , GetUnitY(target) , 0.0 , 1.0 , 1.0 , 0.0))
                    if GetLocalPlayer() == GetOwningPlayer(target) then
                        call PanCameraToTimed(GetUnitX(target), GetUnitY(target), 0.0)
                    endif
                endif
                set slot=slot + 1
            endloop
            set s__AltairSpells__AltairT_KS_memberCount[this]=0
            set s__AltairSpells__AltairT_KS_remaining[this]=0.0
            call ColorEffDummy3Alpha((s__AltairSpells__AltairT_KS_portal[this] ) , (( 0.0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.4)*1.0)) // INLINED!!
            call ColorEffDummy3Alpha((s__AltairSpells__AltairT_KS_ground[this] ) , (( 0.0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.4)*1.0)) // INLINED!!
            call ColorEffDummy3Alpha((s__AltairSpells__AltairT_KS_gate[this] ) , (( 0.0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.4)*1.0)) // INLINED!!
            call ColorEffDummy3Alpha(((EffectSpawnScale(Altair_RingModel , s__AltairSpells__AltairT_KS_portalX[this] , s__AltairSpells__AltairT_KS_portalY[this] , 0.0 , 1.0 , 0.5 , 10.0 , 0.35 , 0.5 , 4.0)) ) , (( 0.25 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.35)*1.0)) // INLINED!!
            set s__AltairSpells__AltairT_KS_portal[this]=null
            set s__AltairSpells__AltairT_KS_ground[this]=null
            set s__AltairSpells__AltairT_KS_gate[this]=null
            call WOSUI___WUI_TestHeroProgress((s__AltairSpells__AltairT_KS_hero[this] ) , ( AltairT_ID ) , ( "Fate Reconstruction" ) , (( 0.0 )*1.0) , (( 0.0 )*1.0) , ( true) , "") // INLINED!!
            call s__AltairSpells__AltairState_Voice((LoadInteger(AltairSpells__AltairTable, GetHandleId(s__AltairSpells__AltairT_KS_hero[this]), 0)),8 , "T" , 5 , 1)
            call BlzStartUnitAbilityCooldown(s__AltairSpells__AltairT_KS_hero[this], AltairT_ID, AltairT_Cooldown)
            call RemoveSavedInteger(AltairSpells__AltairTable, GetHandleId(s__AltairSpells__AltairT_KS_hero[this]), 3)
        endfunction

        // Members stay inside the realm; heroes walking into the open portal join while it has room.
        function s__AltairSpells__AltairT_KS_Tick takes integer this returns nothing
            local integer slot= 0
            local unit target
            local real angle
            local real minX= GetRectMinX(s__AltairSpells__AltairT_KS_realm[this]) + 48.0
            local real minY= GetRectMinY(s__AltairSpells__AltairT_KS_realm[this]) + 48.0
            local real maxX= GetRectMaxX(s__AltairSpells__AltairT_KS_realm[this]) - 48.0
            local real maxY= GetRectMaxY(s__AltairSpells__AltairT_KS_realm[this]) - 48.0
            if s__AltairSpells__AltairT_KS_pullTime[this] > 0.0 then
                // The portal drags its victims in before they vanish.
                set s__AltairSpells__AltairT_KS_pullTime[this]=s__AltairSpells__AltairT_KS_pullTime[this] - 0.03
                loop
                    exitwhen slot >= BlzGroupGetSize(s__AltairSpells__AltairT_KS_pulling[this])
                    set target=BlzGroupUnitAt(s__AltairSpells__AltairT_KS_pulling[this], slot)
                    set angle=Atan2(s__AltairSpells__AltairT_KS_portalY[this] - GetUnitY(target), s__AltairSpells__AltairT_KS_portalX[this] - GetUnitX(target))
                    if SR3(target , s__AltairSpells__AltairT_KS_portalX[this] , s__AltairSpells__AltairT_KS_portalY[this]) > 30.0 then
                        call SetUnitX(target, GetUnitX(target) + 30.0 * Cos(angle))
                        call SetUnitY(target, GetUnitY(target) + 30.0 * Sin(angle))
                    endif
                    set slot=slot + 1
                endloop
                if s__AltairSpells__AltairT_KS_pullTime[this] <= 0.0 then
                    if BlzGroupGetSize(s__AltairSpells__AltairT_KS_pulling[this]) > 0 then
                        call s__AltairSpells__AltairState_Voice((LoadInteger(AltairSpells__AltairTable, GetHandleId(s__AltairSpells__AltairT_KS_hero[this]), 0)),7 , "T" , 2 , 3)
                    endif
                    loop
                        set target=FirstOfGroup(s__AltairSpells__AltairT_KS_pulling[this])
                        exitwhen target == null
                        call GroupRemoveUnit(s__AltairSpells__AltairT_KS_pulling[this], target)
                        if AltairSpells__AltairAlive(target) then
                            call s__AltairSpells__AltairT_KS_AddMember(this,target)
                        endif
                    endloop
                endif
            endif
            set slot=0
            loop
                exitwhen slot >= BlzGroupGetSize(s__AltairSpells__AltairT_KS_members[this])
                set target=BlzGroupUnitAt(s__AltairSpells__AltairT_KS_members[this], slot)
                if AltairSpells__AltairAlive(target) then
                    if GetUnitX(target) < minX or GetUnitX(target) > maxX or GetUnitY(target) < minY or GetUnitY(target) > maxY then
                        call SetUnitX(target, RMaxBJ(minX, RMinBJ(maxX, GetUnitX(target))))
                        call SetUnitY(target, RMaxBJ(minY, RMinBJ(maxY, GetUnitY(target))))
                    endif
                endif
                set slot=slot + 1
            endloop
            if s__AltairSpells__AltairT_KS_memberCount[this] < AltairT_MaxMembers then
                call GroupEnumUnitsInRange(AltairSpells__AltairGroup, s__AltairSpells__AltairT_KS_portalX[this], s__AltairSpells__AltairT_KS_portalY[this], AltairT_EnterRadius, NoDecor_Cond)
                loop
                    set target=FirstOfGroup(AltairSpells__AltairGroup)
                    exitwhen target == null
                    call GroupRemoveUnit(AltairSpells__AltairGroup, target)
                    if s__AltairSpells__AltairT_KS_memberCount[this] < AltairT_MaxMembers and s__AltairSpells__AltairT_KS_CanEnter(this,target) then
                        set s__AltairSpells__AltairT_KS_memberCount[this]=s__AltairSpells__AltairT_KS_memberCount[this] + 1
                        call s__AltairSpells__AltairT_KS_AddMember(this,target)
                    endif
                endloop
            endif
            // The portal stays castable for one relocation; afterwards it waits for the realm.
            if not s__AltairSpells__AltairT_KS_relocated[this] and BlzGetUnitAbilityCooldownRemaining(s__AltairSpells__AltairT_KS_hero[this], AltairT_ID) > 0.0 then
                call BlzEndUnitAbilityCooldown(s__AltairSpells__AltairT_KS_hero[this], AltairT_ID)
            elseif s__AltairSpells__AltairT_KS_relocated[this] and BlzGetUnitAbilityCooldownRemaining(s__AltairSpells__AltairT_KS_hero[this], AltairT_ID) < s__AltairSpells__AltairT_KS_remaining[this] then
                call BlzStartUnitAbilityCooldown(s__AltairSpells__AltairT_KS_hero[this], AltairT_ID, s__AltairSpells__AltairT_KS_remaining[this] + 0.1)
            endif
            set s__AltairSpells__AltairT_KS_decorTimer[this]=s__AltairSpells__AltairT_KS_decorTimer[this] + 0.03
            if s__AltairSpells__AltairT_KS_decorTimer[this] >= 1.0 then
                set s__AltairSpells__AltairT_KS_decorTimer[this]=s__AltairSpells__AltairT_KS_decorTimer[this] - 1.0
                call DecorRemove(s__AltairSpells__AltairT_KS_hero[this] , s__AltairSpells__AltairT_KS_portalX[this] , s__AltairSpells__AltairT_KS_portalY[this] , AltairT_Aoe , AltairT_Decor)
                call VisionTimed(GetOwningPlayer(s__AltairSpells__AltairT_KS_hero[this]) , s__AltairSpells__AltairT_KS_portalX[this] , s__AltairSpells__AltairT_KS_portalY[this] , AltairT_Aoe * 2.0 , 1.2)
            endif
            call WOSUI___WUI_TestHeroProgress((s__AltairSpells__AltairT_KS_hero[this] ) , ( AltairT_ID ) , ( "Fate Reconstruction" ) , (( s__AltairSpells__AltairT_KS_remaining[this] )*1.0) , (( s__AltairSpells__AltairT_KS_total[this] )*1.0) , ( true) , "") // INLINED!!
            set target=null
        endfunction

        function s__AltairSpells__AltairT_KS_Loop takes nothing returns nothing
            local integer index= 0
            local integer this
            loop
                exitwhen index >= s__AltairSpells__AltairT_KS_count
                set this=s__AltairSpells__AltairT_KS_active[index]
                if s__AltairSpells__AltairT_KS_remaining[this] > 0.0 then
                    set s__AltairSpells__AltairT_KS_remaining[this]=s__AltairSpells__AltairT_KS_remaining[this] - 0.03
                    if s__AltairSpells__AltairT_KS_remaining[this] <= 0.0 or not AltairSpells__AltairAlive(s__AltairSpells__AltairT_KS_hero[this]) then
                        call s__AltairSpells__AltairT_KS_End(this)
                    else
                        call s__AltairSpells__AltairT_KS_Tick(this)
                    endif
                endif
                if s__AltairSpells__AltairT_KS_remaining[this] <= 0.0 then
                    call DestroyGroup(s__AltairSpells__AltairT_KS_members[this])
                    call DestroyGroup(s__AltairSpells__AltairT_KS_pulling[this])
                    set s__AltairSpells__AltairT_KS_members[this]=null
                    set s__AltairSpells__AltairT_KS_pulling[this]=null
                    set s__AltairSpells__AltairT_KS_realm[this]=null
                    set s__AltairSpells__AltairT_KS_hero[this]=null
                    set s__AltairSpells__AltairT_KS_count=s__AltairSpells__AltairT_KS_count - 1
                    set s__AltairSpells__AltairT_KS_active[index]=s__AltairSpells__AltairT_KS_active[s__AltairSpells__AltairT_KS_count]
                    call s__AltairSpells__AltairT_KS_deallocate(this)
                    call GearTimer03Release()
                else
                    set index=index + 1
                endif
            endloop
        endfunction

        function s__AltairSpells__AltairT_KS_PlacePortal takes integer this,real x,real y returns nothing
            local real facing= GAngle2(s__AltairSpells__AltairT_KS_hero[this] , x , y) + bj_PI
            set s__AltairSpells__AltairT_KS_portalX[this]=x
            set s__AltairSpells__AltairT_KS_portalY[this]=y
            set s__AltairSpells__AltairT_KS_portal[this]=AltairSpells__AltairPortal(s__AltairSpells__AltairT_KS_portalX[this] , s__AltairSpells__AltairT_KS_portalY[this] , AltairT_PortalHeight , facing , AltairT_PortalScale , 255 , 225 , 150)
            set s__AltairSpells__AltairT_KS_ground[this]=EffectSpawn(AltairT_GroundModel , s__AltairSpells__AltairT_KS_portalX[this] , s__AltairSpells__AltairT_KS_portalY[this] , 0.0 , 1.0 , 2.2 , 5.0)
            call ColorEffDummy3Alpha(((EffectSpawnScale(Altair_RingModel , s__AltairSpells__AltairT_KS_portalX[this] , s__AltairSpells__AltairT_KS_portalY[this] , 0.0 , 1.0 , 0.5 , 10.0 , 0.35 , 0.5 , 4.0)) ) , (( 0.25 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.35)*1.0)) // INLINED!!
        endfunction

        function s__AltairSpells__AltairT_KS_Start takes unit caster,real positionX,real positionY returns boolean
            local integer this= LoadInteger(AltairSpells__AltairTable, GetHandleId(caster), 3)
            local unit target
            local unit nearest
            local real best
            local real distance
            if this != 0 then
                if s__AltairSpells__AltairT_KS_relocated[this] then
                    return false
                endif
                set s__AltairSpells__AltairT_KS_relocated[this]=true
                call ColorEffDummy3Alpha((s__AltairSpells__AltairT_KS_portal[this] ) , (( 0.0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.3)*1.0)) // INLINED!!
                call ColorEffDummy3Alpha((s__AltairSpells__AltairT_KS_ground[this] ) , (( 0.0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.3)*1.0)) // INLINED!!
                call s__AltairSpells__AltairT_KS_PlacePortal(this,positionX , positionY)
                return true
            endif
            set this=s__AltairSpells__AltairT_KS__allocate()
            set s__AltairSpells__AltairT_KS_hero[this]=caster
            set s__AltairSpells__AltairT_KS_realm[this]=gg_rct_AltairRealm
            // Kenjaku interaction: during an active Prison Realm the alternate world is the prison itself.

                call GroupEnumUnitsInRect(AltairSpells__AltairGroup, gg_rct_Cage, null)
                loop
                    set target=FirstOfGroup(AltairSpells__AltairGroup)
                    exitwhen target == null
                    call GroupRemoveUnit(AltairSpells__AltairGroup, target)
                    if GetUnitAbilityLevel(target, KenjakuF2_Prison_Abi_ID) > 0 and AltairSpells__AltairAlive(target) then
                        set s__AltairSpells__AltairT_KS_realm[this]=gg_rct_Cage
                    endif
                endloop

            set s__AltairSpells__AltairT_KS_relocated[this]=false
            set s__AltairSpells__AltairT_KS_memberCount[this]=0
            set s__AltairSpells__AltairT_KS_pullTime[this]=AltairT_PullTime
            set s__AltairSpells__AltairT_KS_decorTimer[this]=1.0
            set s__AltairSpells__AltairT_KS_members[this]=CreateGroup()
            set s__AltairSpells__AltairT_KS_pulling[this]=CreateGroup()
            set s__AltairSpells__AltairT_KS_total[this]=AltairT_Duration
            if GetHeroLevel(s__AltairSpells__AltairT_KS_hero[this]) >= 35 then
                set s__AltairSpells__AltairT_KS_total[this]=s__AltairSpells__AltairT_KS_total[this] + AltairT_DurationLevel35
            endif
            set s__AltairSpells__AltairT_KS_remaining[this]=s__AltairSpells__AltairT_KS_total[this]
            call s__AltairSpells__AltairT_KS_PlacePortal(this,positionX , positionY)
            call s__AltairSpells__AltairState_Voice((LoadInteger(AltairSpells__AltairTable, GetHandleId(s__AltairSpells__AltairT_KS_hero[this]), 0)),6 , "T" , 1 , 1)
            set s__AltairSpells__AltairT_KS_gate[this]=AltairSpells__AltairPortal(GetRectCenterX(s__AltairSpells__AltairT_KS_realm[this]) , GetRectCenterY(s__AltairSpells__AltairT_KS_realm[this]) , AltairT_PortalHeight , 0.0 , AltairT_PortalScale * 0.6 , 255 , 225 , 150)
            call SetUnitAnimation(s__AltairSpells__AltairT_KS_hero[this], "spell")
            // Nearest heroes first, up to the member limit.
            loop
                exitwhen s__AltairSpells__AltairT_KS_memberCount[this] >= AltairT_MaxMembers
                set nearest=null
                set best=999999999.0
                call GroupEnumUnitsInRange(AltairSpells__AltairGroup, s__AltairSpells__AltairT_KS_portalX[this], s__AltairSpells__AltairT_KS_portalY[this], AltairT_Aoe, NoDecor_Cond)
                loop
                    set target=FirstOfGroup(AltairSpells__AltairGroup)
                    exitwhen target == null
                    call GroupRemoveUnit(AltairSpells__AltairGroup, target)
                    if s__AltairSpells__AltairT_KS_CanEnter(this,target) then
                        set distance=SR3(target , s__AltairSpells__AltairT_KS_portalX[this] , s__AltairSpells__AltairT_KS_portalY[this])
                        if distance < best then
                            set best=distance
                            set nearest=target
                        endif
                    endif
                endloop
                exitwhen nearest == null
                call s__AltairSpells__AltairT_KS_Pull(this,nearest)
            endloop
            call SaveInteger(AltairSpells__AltairTable, GetHandleId(s__AltairSpells__AltairT_KS_hero[this]), 3, this)
            set s__AltairSpells__AltairT_KS_active[s__AltairSpells__AltairT_KS_count]=this
            set s__AltairSpells__AltairT_KS_count=s__AltairSpells__AltairT_KS_count + 1
            call GearTimer03Acquire()
            set target=null
            set nearest=null
            return true
        endfunction

        function s__AltairSpells__AltairT_KS_EndFor takes unit caster returns nothing
            local integer this= LoadInteger(AltairSpells__AltairTable, GetHandleId(caster), 3)
            if this != 0 and s__AltairSpells__AltairT_KS_remaining[this] > 0.0 then
                call s__AltairSpells__AltairT_KS_End(this)
            endif
        endfunction

    // ==================== SQ: Sword Rush ====================

        function s__AltairSpells__AltairSQ_KS_Loop takes nothing returns nothing
            local integer index= 0
            local integer this
            local real step= AltairSQ_Speed * 0.03
            local real nextX
            local real nextY
            local unit target
            loop
                exitwhen index >= s__AltairSpells__AltairSQ_KS_count
                set this=s__AltairSpells__AltairSQ_KS_active[index]
                set nextX=GetUnitX(s__AltairSpells__AltairSQ_KS_hero[this]) + step * Cos(s__AltairSpells__AltairSQ_KS_angle[this])
                set nextY=GetUnitY(s__AltairSpells__AltairSQ_KS_hero[this]) + step * Sin(s__AltairSpells__AltairSQ_KS_angle[this])
                if s__AltairSpells__AltairSQ_KS_remaining[this] <= 0.0 or not (CheckCoordsInRect(gg_rct_Arena , ((nextX )*1.0) , (( nextY)*1.0))) or not AltairSpells__AltairAlive(s__AltairSpells__AltairSQ_KS_hero[this]) then // INLINED!!
                    call StopSpellUnit2(s__AltairSpells__AltairSQ_KS_hero[this])
                    call DestroyEffect(EffectSpawn(Altair_SlashModel , GetUnitX(s__AltairSpells__AltairSQ_KS_hero[this]) , GetUnitY(s__AltairSpells__AltairSQ_KS_hero[this]) , s__AltairSpells__AltairSQ_KS_angle[this] * bj_RADTODEG , 1.5 , 1.2 , 60.0))
                    call ColorEffDummy3Alpha((s__AltairSpells__AltairSQ_KS_left[this] ) , (( 0.0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.15)*1.0)) // INLINED!!
                    call ColorEffDummy3Alpha((s__AltairSpells__AltairSQ_KS_right[this] ) , (( 0.0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.15)*1.0)) // INLINED!!
                    call DestroyGroup(s__AltairSpells__AltairSQ_KS_hits[this])
                    set s__AltairSpells__AltairSQ_KS_left[this]=null
                    set s__AltairSpells__AltairSQ_KS_right[this]=null
                    set s__AltairSpells__AltairSQ_KS_hits[this]=null
                    set s__AltairSpells__AltairSQ_KS_hero[this]=null
                    set s__AltairSpells__AltairSQ_KS_count=s__AltairSpells__AltairSQ_KS_count - 1
                    set s__AltairSpells__AltairSQ_KS_active[index]=s__AltairSpells__AltairSQ_KS_active[s__AltairSpells__AltairSQ_KS_count]
                    call s__AltairSpells__AltairSQ_KS_deallocate(this)
                    call GearTimer03Release()
                else
                    set s__AltairSpells__AltairSQ_KS_remaining[this]=s__AltairSpells__AltairSQ_KS_remaining[this] - step
                    call SetUnitX(s__AltairSpells__AltairSQ_KS_hero[this], nextX)
                    call SetUnitY(s__AltairSpells__AltairSQ_KS_hero[this], nextY)
                    call BlzSetSpecialEffectPosition(s__AltairSpells__AltairSQ_KS_left[this], nextX + 70.0 * Cos(s__AltairSpells__AltairSQ_KS_angle[this] + bj_PI / 2.0), nextY + 70.0 * Sin(s__AltairSpells__AltairSQ_KS_angle[this] + bj_PI / 2.0), BlzGetUnitZ(s__AltairSpells__AltairSQ_KS_hero[this]) + 70.0)
                    call BlzSetSpecialEffectPosition(s__AltairSpells__AltairSQ_KS_right[this], nextX + 70.0 * Cos(s__AltairSpells__AltairSQ_KS_angle[this] - bj_PI / 2.0), nextY + 70.0 * Sin(s__AltairSpells__AltairSQ_KS_angle[this] - bj_PI / 2.0), BlzGetUnitZ(s__AltairSpells__AltairSQ_KS_hero[this]) + 70.0)
                    set s__AltairSpells__AltairSQ_KS_trailTimer[this]=s__AltairSpells__AltairSQ_KS_trailTimer[this] + 0.03
                    if s__AltairSpells__AltairSQ_KS_trailTimer[this] >= 0.06 then
                        set s__AltairSpells__AltairSQ_KS_trailTimer[this]=0.0
                        call DestroyEffect(EffectSpawn(Altair_ImageModel , nextX , nextY , s__AltairSpells__AltairSQ_KS_angle[this] * bj_RADTODEG , 1.5 , 1.0 , 0.0))
                    endif
                    call GroupEnumUnitsInRange(AltairSpells__AltairGroup, nextX, nextY, AltairSQ_Width, NoDecor_Cond)
                    loop
                        set target=FirstOfGroup(AltairSpells__AltairGroup)
                        exitwhen target == null
                        call GroupRemoveUnit(AltairSpells__AltairGroup, target)
                        if AltairSpells__AltairIsEnemy(s__AltairSpells__AltairSQ_KS_hero[this] , target) and not IsUnitInGroup(target, s__AltairSpells__AltairSQ_KS_hits[this]) then
                            call GroupAddUnit(s__AltairSpells__AltairSQ_KS_hits[this], target)
                            set GearDamageNextSource=(AltairSQ_ID) // INLINED!!
                            call dmgatk(s__AltairSpells__AltairSQ_KS_hero[this] , target , s__AltairSpells__AltairSQ_KS_damage[this])
                            call DestroyEffect(AddSpecialEffectTarget(Altair_SwordHitModel, target, "chest"))
                            call DestroyEffect(EffectSpawn(Altair_HitModel , GetUnitX(target) , GetUnitY(target) , 0.0 , 1.0 , 1.5 , 76.0))
                        endif
                    endloop
                    call DecorRemove(s__AltairSpells__AltairSQ_KS_hero[this] , nextX , nextY , AltairSQ_Width , AltairSQ_Decor)
                    set index=index + 1
                endif
            endloop
            set target=null
        endfunction

        function s__AltairSpells__AltairSQ_KS_Start takes unit caster,real positionX,real positionY returns nothing
            local integer this= s__AltairSpells__AltairSQ_KS__allocate()
            local integer level= IMaxBJ(1, GetUnitAbilityLevel(caster, AltairSQ_ID))
            set s__AltairSpells__AltairSQ_KS_hero[this]=caster
            set s__AltairSpells__AltairSQ_KS_angle[this]=GAngle2(s__AltairSpells__AltairSQ_KS_hero[this] , positionX , positionY)
            set s__AltairSpells__AltairSQ_KS_remaining[this]=AltairSQ_Range
            set s__AltairSpells__AltairSQ_KS_trailTimer[this]=0.0
            set s__AltairSpells__AltairSQ_KS_damage[this]=AltairSpells__AltairSwordDamage(s__AltairSpells__AltairSQ_KS_hero[this] , AltairSQ_DamageIntBase + AltairSQ_DamageIntStep * ( level - 1 ) , AltairSQ_DamageAtk)
            set s__AltairSpells__AltairSQ_KS_hits[this]=CreateGroup()
            set s__AltairSpells__AltairSQ_KS_left[this]=EffectSpawn(Altair_SwordModel , GetUnitX(s__AltairSpells__AltairSQ_KS_hero[this]) , GetUnitY(s__AltairSpells__AltairSQ_KS_hero[this]) , s__AltairSpells__AltairSQ_KS_angle[this] * bj_RADTODEG , 1.0 , 0.4 , 70.0)
            set s__AltairSpells__AltairSQ_KS_right[this]=EffectSpawn(Altair_SwordModel , GetUnitX(s__AltairSpells__AltairSQ_KS_hero[this]) , GetUnitY(s__AltairSpells__AltairSQ_KS_hero[this]) , s__AltairSpells__AltairSQ_KS_angle[this] * bj_RADTODEG , 1.0 , 0.4 , 70.0)
            call StartSpellUnit2(s__AltairSpells__AltairSQ_KS_hero[this])
            call SetUnitFacing(s__AltairSpells__AltairSQ_KS_hero[this], s__AltairSpells__AltairSQ_KS_angle[this] * bj_RADTODEG)
            call SetUnitAnimation(s__AltairSpells__AltairSQ_KS_hero[this], "attack")
            call DestroyEffect(EffectSpawn(AltairSQ_SlashModel , GetUnitX(s__AltairSpells__AltairSQ_KS_hero[this]) + 150.0 * Cos(s__AltairSpells__AltairSQ_KS_angle[this]) , GetUnitY(s__AltairSpells__AltairSQ_KS_hero[this]) + 150.0 * Sin(s__AltairSpells__AltairSQ_KS_angle[this]) , s__AltairSpells__AltairSQ_KS_angle[this] * bj_RADTODEG , 1.5 , 1.0 , 60.0))
            call VisionTimed(GetOwningPlayer(s__AltairSpells__AltairSQ_KS_hero[this]) , GetUnitX(s__AltairSpells__AltairSQ_KS_hero[this]) + AltairSQ_Range * 0.5 * Cos(s__AltairSpells__AltairSQ_KS_angle[this]) , GetUnitY(s__AltairSpells__AltairSQ_KS_hero[this]) + AltairSQ_Range * 0.5 * Sin(s__AltairSpells__AltairSQ_KS_angle[this]) , AltairSQ_Range * 0.7 , 1.5)
            set s__AltairSpells__AltairSQ_KS_active[s__AltairSpells__AltairSQ_KS_count]=this
            set s__AltairSpells__AltairSQ_KS_count=s__AltairSpells__AltairSQ_KS_count + 1
            call GearTimer03Acquire()
        endfunction

    // ==================== SW: Sword Storm (cone of swords) ====================
    function AltairSpells__AltairSW_Cast takes unit hero,real positionX,real positionY returns nothing
        local integer sword= 0
        local integer level= IMaxBJ(1, GetUnitAbilityLevel(hero, AltairSW_ID))
        local real center= GAngle2(hero , positionX , positionY)
        local real damage= AltairSpells__AltairSwordDamage(hero , AltairSW_DamageIntBase + AltairSW_DamageIntStep * ( level - 1 ) , AltairSW_DamageAtk)
        local real angle
        local group hits= CreateGroup()
        call SetUnitFacing(hero, center * bj_RADTODEG)
        call SetUnitAnimation(hero, "spell")
        call DestroyEffect(EffectSpawn(AltairSW_GateModel , GetUnitX(hero) , GetUnitY(hero) , center * bj_RADTODEG , 1.0 , 1.4 , 90.0))
        call VisionTimed(GetOwningPlayer(hero) , GetUnitX(hero) + AltairSW_Range * 0.5 * Cos(center) , GetUnitY(hero) + AltairSW_Range * 0.5 * Sin(center) , AltairSW_Range * 0.7 , 2.0)
        loop
            exitwhen sword >= AltairSW_Swords
            set angle=center + ( sword - ( AltairSW_Swords - 1 ) * 0.5 ) * AltairSW_Cone * bj_DEGTORAD / ( AltairSW_Swords - 1 )
            call s__AltairSpells__AltairBlade_KS_Launch(hero , GetUnitX(hero) - 40.0 * Cos(angle) , GetUnitY(hero) - 40.0 * Sin(angle) , 80.0 + GetRandomReal(0.0, 60.0) , angle , AltairSW_Speed + GetRandomReal(- 150.0, 150.0) , AltairSW_Range , AltairSW_Width , damage , hits)
            set sword=sword + 1
        endloop
        set hits=null
    endfunction

    // ==================== SE: Spinning Swords (horizontal ring, blades point outward as Erza TW) ====================

        function s__AltairSpells__AltairSE_KS_AddBlades takes integer this,integer wanted returns nothing
            loop
                exitwhen s__AltairSpells__AltairSE_KS_blades[this] >= IMinBJ(24, wanted)
                set s___AltairSpells__AltairSE_KS_blade[s__AltairSpells__AltairSE_KS_blade[this]+s__AltairSpells__AltairSE_KS_blades[this]]=AddSpecialEffect(Altair_SwordModel, GetUnitX(s__AltairSpells__AltairSE_KS_hero[this]), GetUnitY(s__AltairSpells__AltairSE_KS_hero[this]))
                call BlzSetSpecialEffectScale(s___AltairSpells__AltairSE_KS_blade[s__AltairSpells__AltairSE_KS_blade[this]+s__AltairSpells__AltairSE_KS_blades[this]], 0.3)
                set s__AltairSpells__AltairSE_KS_blades[this]=s__AltairSpells__AltairSE_KS_blades[this] + 1
            endloop
        endfunction

        function s__AltairSpells__AltairSE_KS_Loop takes nothing returns nothing
            local integer index= 0
            local integer slot
            local integer this
            local real bladeAngle
            local real z
            local unit target
            loop
                exitwhen index >= s__AltairSpells__AltairSE_KS_count
                set this=s__AltairSpells__AltairSE_KS_active[index]
                set s__AltairSpells__AltairSE_KS_remaining[this]=s__AltairSpells__AltairSE_KS_remaining[this] - 0.03
                if s__AltairSpells__AltairSE_KS_remaining[this] <= 0.0 or not AltairSpells__AltairAlive(s__AltairSpells__AltairSE_KS_hero[this]) then
                    set slot=0
                    loop
                        exitwhen slot >= s__AltairSpells__AltairSE_KS_blades[this]
                        call ColorEffDummy3Alpha((s___AltairSpells__AltairSE_KS_blade[s__AltairSpells__AltairSE_KS_blade[this]+slot] ) , (( 0.0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.12)*1.0)) // INLINED!!
                        set s___AltairSpells__AltairSE_KS_blade[s__AltairSpells__AltairSE_KS_blade[this]+slot]=null
                        set slot=slot + 1
                    endloop
                    call RemoveSavedInteger(AltairSpells__AltairTable, GetHandleId(s__AltairSpells__AltairSE_KS_hero[this]), 5)
                    set s__AltairSpells__AltairSE_KS_hero[this]=null
                    set s__AltairSpells__AltairSE_KS_count=s__AltairSpells__AltairSE_KS_count - 1
                    set s__AltairSpells__AltairSE_KS_active[index]=s__AltairSpells__AltairSE_KS_active[s__AltairSpells__AltairSE_KS_count]
                    call s__AltairSpells__AltairSE_KS_deallocate(this)
                    call GearTimer03Release()
                else
                    set s__AltairSpells__AltairSE_KS_angle[this]=s__AltairSpells__AltairSE_KS_angle[this] + AltairSE_SpinSpeed * 0.03 * ( 0.75 + 0.25 * s__AltairSpells__AltairSE_KS_power[this] )
                    set z=BlzGetUnitZ(s__AltairSpells__AltairSE_KS_hero[this]) + AltairSE_Height
                    set slot=0
                    loop
                        exitwhen slot >= s__AltairSpells__AltairSE_KS_blades[this]
                        set bladeAngle=s__AltairSpells__AltairSE_KS_angle[this] + slot * 2.0 * bj_PI / s__AltairSpells__AltairSE_KS_blades[this]
                        call BlzSetSpecialEffectPosition(s___AltairSpells__AltairSE_KS_blade[s__AltairSpells__AltairSE_KS_blade[this]+slot], GetUnitX(s__AltairSpells__AltairSE_KS_hero[this]) + AltairSE_Radius * Cos(bladeAngle), GetUnitY(s__AltairSpells__AltairSE_KS_hero[this]) + AltairSE_Radius * Sin(bladeAngle), z)
                        call BlzSetSpecialEffectYaw(s___AltairSpells__AltairSE_KS_blade[s__AltairSpells__AltairSE_KS_blade[this]+slot], bladeAngle)
                        set slot=slot + 1
                    endloop
                    set s__AltairSpells__AltairSE_KS_tickTimer[this]=s__AltairSpells__AltairSE_KS_tickTimer[this] + 0.03
                    if s__AltairSpells__AltairSE_KS_tickTimer[this] >= AltairSE_Period then
                        set s__AltairSpells__AltairSE_KS_tickTimer[this]=s__AltairSpells__AltairSE_KS_tickTimer[this] - AltairSE_Period
                        call DestroyEffect(EffectSpawn(AltairSE_SlashModel , GetUnitX(s__AltairSpells__AltairSE_KS_hero[this]) , GetUnitY(s__AltairSpells__AltairSE_KS_hero[this]) , s__AltairSpells__AltairSE_KS_angle[this] * bj_RADTODEG , 2.0 , 0.8 , 30.0))
                        call GroupEnumUnitsInRange(AltairSpells__AltairGroup, GetUnitX(s__AltairSpells__AltairSE_KS_hero[this]), GetUnitY(s__AltairSpells__AltairSE_KS_hero[this]), AltairSE_Aoe, NoDecor_Cond)
                        loop
                            set target=FirstOfGroup(AltairSpells__AltairGroup)
                            exitwhen target == null
                            call GroupRemoveUnit(AltairSpells__AltairGroup, target)
                            if AltairSpells__AltairIsEnemy(s__AltairSpells__AltairSE_KS_hero[this] , target) then
                                set GearDamageNextSource=(AltairSE_ID) // INLINED!!
                                call dmgatk(s__AltairSpells__AltairSE_KS_hero[this] , target , s__AltairSpells__AltairSE_KS_damage[this] * s__AltairSpells__AltairSE_KS_power[this])
                                call DestroyEffect(AddSpecialEffectTarget(Altair_StampedeModel, target, "chest"))
                                call DestroyEffect(AddSpecialEffectTarget(Altair_SwordHitModel, target, "chest"))
                            endif
                        endloop
                        call DecorRemove(s__AltairSpells__AltairSE_KS_hero[this] , GetUnitX(s__AltairSpells__AltairSE_KS_hero[this]) , GetUnitY(s__AltairSpells__AltairSE_KS_hero[this]) , AltairSE_Aoe , AltairSE_Decor)
                        call VisionTimed(GetOwningPlayer(s__AltairSpells__AltairSE_KS_hero[this]) , GetUnitX(s__AltairSpells__AltairSE_KS_hero[this]) , GetUnitY(s__AltairSpells__AltairSE_KS_hero[this]) , AltairSE_Aoe * 1.6 , 0.5)
                    endif
                    set index=index + 1
                endif
            endloop
            set target=null
        endfunction

        // recast: 0 for the first cast in the window, then 1, 2.
        function s__AltairSpells__AltairSE_KS_Start takes unit caster,integer recast returns nothing
            local integer this= LoadInteger(AltairSpells__AltairTable, GetHandleId(caster), 5)
            local integer level= IMaxBJ(1, GetUnitAbilityLevel(caster, AltairSE_ID))
            if this == 0 then
                set this=s__AltairSpells__AltairSE_KS__allocate()
                set s__AltairSpells__AltairSE_KS_hero[this]=caster
                set s__AltairSpells__AltairSE_KS_blades[this]=0
                set s__AltairSpells__AltairSE_KS_angle[this]=GetUnitFacing(s__AltairSpells__AltairSE_KS_hero[this]) * bj_DEGTORAD
                set s__AltairSpells__AltairSE_KS_tickTimer[this]=AltairSE_Period
                call SaveInteger(AltairSpells__AltairTable, GetHandleId(s__AltairSpells__AltairSE_KS_hero[this]), 5, this)
                set s__AltairSpells__AltairSE_KS_active[s__AltairSpells__AltairSE_KS_count]=this
                set s__AltairSpells__AltairSE_KS_count=s__AltairSpells__AltairSE_KS_count + 1
                call GearTimer03Acquire()
            endif
            set s__AltairSpells__AltairSE_KS_power[this]=1.0 + AltairSE_PowerStep * recast
            set s__AltairSpells__AltairSE_KS_damage[this]=AltairSpells__AltairSwordDamage(s__AltairSpells__AltairSE_KS_hero[this] , AltairSE_DamageIntBase + AltairSE_DamageIntStep * ( level - 1 ) , AltairSE_DamageAtk)
            set s__AltairSpells__AltairSE_KS_remaining[this]=AltairSE_Duration
            call s__AltairSpells__AltairSE_KS_AddBlades(this,AltairSE_Blades + AltairSE_BladesStep * recast)
            call ColorEffDummy3Alpha(((EffectSpawnScale(Altair_RingModel , GetUnitX(s__AltairSpells__AltairSE_KS_hero[this]) , GetUnitY(s__AltairSpells__AltairSE_KS_hero[this]) , 0.0 , 1.0 , 0.5 , 10.0 , 0.2 , 0.5 , AltairSE_Aoe / 110.0)) ) , (( 0.25 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.35)*1.0)) // INLINED!!
            call SetUnitAnimation(s__AltairSpells__AltairSE_KS_hero[this], "spell")
        endfunction

    // ==================== SR: Shield of Swords ====================

        function s__AltairSpells__AltairSR_KS_Loop takes nothing returns nothing
            local integer index= 0
            local integer slot
            local integer this
            local integer state
            local real bladeAngle
            local real z
            local unit target
            loop
                exitwhen index >= s__AltairSpells__AltairSR_KS_count
                set this=s__AltairSpells__AltairSR_KS_active[index]
                set state=LoadInteger(AltairSpells__AltairTable, GetHandleId(s__AltairSpells__AltairSR_KS_hero[this]), 0)
                set s__AltairSpells__AltairSR_KS_remaining[this]=s__AltairSpells__AltairSR_KS_remaining[this] - 0.03
                if state != 0 then
                    set s__AltairSpells__AltairState_shieldRemaining[state]=s__AltairSpells__AltairSR_KS_remaining[this]
                endif
                if s__AltairSpells__AltairSR_KS_remaining[this] <= 0.0 or not AltairSpells__AltairAlive(s__AltairSpells__AltairSR_KS_hero[this]) then
                    if state != 0 then
                        set s__AltairSpells__AltairState_shieldRemaining[state]=0.0
                    endif
                    set slot=0
                    loop
                        exitwhen slot >= AltairSR_RingBlades + AltairSR_WallBlades
                        call ColorEffDummy3Alpha((s___AltairSpells__AltairSR_KS_blade[s__AltairSpells__AltairSR_KS_blade[this]+slot] ) , (( 0.0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.2)*1.0)) // INLINED!!
                        set s___AltairSpells__AltairSR_KS_blade[s__AltairSpells__AltairSR_KS_blade[this]+slot]=null
                        set slot=slot + 1
                    endloop
                    call RemoveSavedInteger(AltairSpells__AltairTable, GetHandleId(s__AltairSpells__AltairSR_KS_hero[this]), 6)
                    set s__AltairSpells__AltairSR_KS_hero[this]=null
                    set s__AltairSpells__AltairSR_KS_count=s__AltairSpells__AltairSR_KS_count - 1
                    set s__AltairSpells__AltairSR_KS_active[index]=s__AltairSpells__AltairSR_KS_active[s__AltairSpells__AltairSR_KS_count]
                    call s__AltairSpells__AltairSR_KS_deallocate(this)
                    call GearTimer03Release()
                else
                    set s__AltairSpells__AltairSR_KS_angle[this]=s__AltairSpells__AltairSR_KS_angle[this] + AltairSR_SpinSpeed * 0.03
                    set z=BlzGetUnitZ(s__AltairSpells__AltairSR_KS_hero[this])
                    set slot=0
                    loop
                        exitwhen slot >= AltairSR_RingBlades
                        set bladeAngle=s__AltairSpells__AltairSR_KS_angle[this] + slot * 2.0 * bj_PI / AltairSR_RingBlades
                        call BlzSetSpecialEffectPosition(s___AltairSpells__AltairSR_KS_blade[s__AltairSpells__AltairSR_KS_blade[this]+slot], GetUnitX(s__AltairSpells__AltairSR_KS_hero[this]) + AltairSR_Radius * Cos(bladeAngle), GetUnitY(s__AltairSpells__AltairSR_KS_hero[this]) + AltairSR_Radius * Sin(bladeAngle), z + 60.0)
                        call BlzSetSpecialEffectYaw(s___AltairSpells__AltairSR_KS_blade[s__AltairSpells__AltairSR_KS_blade[this]+slot], bladeAngle)
                        set slot=slot + 1
                    endloop
                    // A fixed wall of blades marks the blocked direction.
                    loop
                        exitwhen slot >= AltairSR_RingBlades + AltairSR_WallBlades
                        set bladeAngle=s__AltairSpells__AltairSR_KS_blockAngle[this] + ( slot - AltairSR_RingBlades - ( AltairSR_WallBlades - 1 ) * 0.5 ) * AltairSR_Arc * bj_DEGTORAD / AltairSR_WallBlades
                        call BlzSetSpecialEffectPosition(s___AltairSpells__AltairSR_KS_blade[s__AltairSpells__AltairSR_KS_blade[this]+slot], GetUnitX(s__AltairSpells__AltairSR_KS_hero[this]) + AltairSR_WallRadius * Cos(bladeAngle), GetUnitY(s__AltairSpells__AltairSR_KS_hero[this]) + AltairSR_WallRadius * Sin(bladeAngle), z + 40.0 + 45.0 * ModuloInteger(slot, 2))
                        call BlzSetSpecialEffectYaw(s___AltairSpells__AltairSR_KS_blade[s__AltairSpells__AltairSR_KS_blade[this]+slot], bladeAngle)
                        set slot=slot + 1
                    endloop
                    set s__AltairSpells__AltairSR_KS_tickTimer[this]=s__AltairSpells__AltairSR_KS_tickTimer[this] + 0.03
                    if s__AltairSpells__AltairSR_KS_tickTimer[this] >= AltairSR_Period then
                        set s__AltairSpells__AltairSR_KS_tickTimer[this]=s__AltairSpells__AltairSR_KS_tickTimer[this] - AltairSR_Period
                        call DecorRemove(s__AltairSpells__AltairSR_KS_hero[this] , GetUnitX(s__AltairSpells__AltairSR_KS_hero[this]) , GetUnitY(s__AltairSpells__AltairSR_KS_hero[this]) , AltairSR_Radius + 60.0 , AltairSR_Decor)
                        call VisionTimed(GetOwningPlayer(s__AltairSpells__AltairSR_KS_hero[this]) , GetUnitX(s__AltairSpells__AltairSR_KS_hero[this]) , GetUnitY(s__AltairSpells__AltairSR_KS_hero[this]) , 600.0 , 0.5)
                        call GroupEnumUnitsInRange(AltairSpells__AltairGroup, GetUnitX(s__AltairSpells__AltairSR_KS_hero[this]), GetUnitY(s__AltairSpells__AltairSR_KS_hero[this]), AltairSR_Radius + 60.0, NoDecor_Cond)
                        loop
                            set target=FirstOfGroup(AltairSpells__AltairGroup)
                            exitwhen target == null
                            call GroupRemoveUnit(AltairSpells__AltairGroup, target)
                            if AltairSpells__AltairIsEnemy(s__AltairSpells__AltairSR_KS_hero[this] , target) then
                                set GearDamageNextSource=(AltairSR_ID) // INLINED!!
                                call dmgatk(s__AltairSpells__AltairSR_KS_hero[this] , target , s__AltairSpells__AltairSR_KS_damage[this])
                                call DestroyEffect(AddSpecialEffectTarget(Altair_SwordHitModel, target, "chest"))
                            endif
                        endloop
                    endif
                    set index=index + 1
                endif
            endloop
            set target=null
        endfunction

        function s__AltairSpells__AltairSR_KS_Start takes unit caster,real positionX,real positionY returns nothing
            local integer this= LoadInteger(AltairSpells__AltairTable, GetHandleId(caster), 6)
            local integer level= IMaxBJ(1, GetUnitAbilityLevel(caster, AltairSR_ID))
            local integer slot= 0
            local integer state= LoadInteger(AltairSpells__AltairTable, GetHandleId(caster), 0)
            if this == 0 then
                set this=s__AltairSpells__AltairSR_KS__allocate()
                set s__AltairSpells__AltairSR_KS_hero[this]=caster
                set s__AltairSpells__AltairSR_KS_angle[this]=0.0
                set s__AltairSpells__AltairSR_KS_tickTimer[this]=0.0
                loop
                    exitwhen slot >= AltairSR_RingBlades + AltairSR_WallBlades
                    set s___AltairSpells__AltairSR_KS_blade[s__AltairSpells__AltairSR_KS_blade[this]+slot]=AddSpecialEffect(Altair_SwordModel, GetUnitX(s__AltairSpells__AltairSR_KS_hero[this]), GetUnitY(s__AltairSpells__AltairSR_KS_hero[this]))
                    call BlzSetSpecialEffectScale(s___AltairSpells__AltairSR_KS_blade[s__AltairSpells__AltairSR_KS_blade[this]+slot], 0.25)
                    set slot=slot + 1
                endloop
                call SaveInteger(AltairSpells__AltairTable, GetHandleId(s__AltairSpells__AltairSR_KS_hero[this]), 6, this)
                set s__AltairSpells__AltairSR_KS_active[s__AltairSpells__AltairSR_KS_count]=this
                set s__AltairSpells__AltairSR_KS_count=s__AltairSpells__AltairSR_KS_count + 1
                call GearTimer03Acquire()
            endif
            set s__AltairSpells__AltairSR_KS_blockAngle[this]=GAngle2(s__AltairSpells__AltairSR_KS_hero[this] , positionX , positionY)
            set s__AltairSpells__AltairSR_KS_remaining[this]=AltairSR_Duration + AltairSR_DurationStep * ( level - 1 )
            set s__AltairSpells__AltairSR_KS_damage[this]=AltairSpells__AltairSwordDamage(s__AltairSpells__AltairSR_KS_hero[this] , AltairSR_DamageInt , AltairSR_DamageAtk)
            if state != 0 then
                set s__AltairSpells__AltairState_shieldAngle[state]=s__AltairSpells__AltairSR_KS_blockAngle[this]
                set s__AltairSpells__AltairState_shieldRemaining[state]=s__AltairSpells__AltairSR_KS_remaining[this]
            endif
            call SetUnitFacing(s__AltairSpells__AltairSR_KS_hero[this], s__AltairSpells__AltairSR_KS_blockAngle[this] * bj_RADTODEG)
            call SetUnitAnimation(s__AltairSpells__AltairSR_KS_hero[this], "spell")
            call ColorEffDummy3Alpha(((EffectSpawnScale(Altair_RingModel , GetUnitX(s__AltairSpells__AltairSR_KS_hero[this]) , GetUnitY(s__AltairSpells__AltairSR_KS_hero[this]) , 0.0 , 1.0 , 0.5 , 10.0 , 0.2 , 0.5 , 2.0)) ) , (( 0.25 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.35)*1.0)) // INLINED!!
        endfunction

    // ==================== ST: Rain of Swords ====================

        function s__AltairSpells__AltairSTSword_KS_Loop takes nothing returns nothing
            local integer index= 0
            local integer this
            local unit target
            loop
                exitwhen index >= s__AltairSpells__AltairSTSword_KS_count
                set this=s__AltairSpells__AltairSTSword_KS_active[index]
                set s__AltairSpells__AltairSTSword_KS_height[this]=s__AltairSpells__AltairSTSword_KS_height[this] - AltairST_DropSpeed * 0.03
                if s__AltairSpells__AltairSTSword_KS_height[this] <= 0.0 then
                    call ColorEffDummy3Alpha((s__AltairSpells__AltairSTSword_KS_art[this] ) , (( 0.25 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.2)*1.0)) // INLINED!!
                    call DestroyEffect(EffectSpawn(Altair_SlashModel , s__AltairSpells__AltairSTSword_KS_positionX[this] , s__AltairSpells__AltairSTSword_KS_positionY[this] , GetRandomReal(0.0, 359.0) , 1.5 , 0.6 , 5.0))
                    if GetRandomInt(1, 3) == 1 then
                        call DestroyEffect(EffectSpawn(Altair_DustModel , s__AltairSpells__AltairSTSword_KS_positionX[this] , s__AltairSpells__AltairSTSword_KS_positionY[this] , GetRandomReal(0.0, 359.0) , 1.5 , 0.6 , 0.0))
                    endif
                    call GroupEnumUnitsInRange(AltairSpells__AltairGroup, s__AltairSpells__AltairSTSword_KS_positionX[this], s__AltairSpells__AltairSTSword_KS_positionY[this], AltairST_ImpactAoe, NoDecor_Cond)
                    loop
                        set target=FirstOfGroup(AltairSpells__AltairGroup)
                        exitwhen target == null
                        call GroupRemoveUnit(AltairSpells__AltairGroup, target)
                        if AltairSpells__AltairIsEnemy(s__AltairSpells__AltairSTSword_KS_hero[this] , target) then
                            set GearDamageNextSource=(AltairST_ID) // INLINED!!
                            call dmgatk(s__AltairSpells__AltairSTSword_KS_hero[this] , target , s__AltairSpells__AltairSTSword_KS_damage[this])
                            call DestroyEffect(AddSpecialEffectTarget(Altair_StampedeModel, target, "chest"))
                        endif
                    endloop
                    set s__AltairSpells__AltairSTSword_KS_art[this]=null
                    set s__AltairSpells__AltairSTSword_KS_hero[this]=null
                    set s__AltairSpells__AltairSTSword_KS_count=s__AltairSpells__AltairSTSword_KS_count - 1
                    set s__AltairSpells__AltairSTSword_KS_active[index]=s__AltairSpells__AltairSTSword_KS_active[s__AltairSpells__AltairSTSword_KS_count]
                    call s__AltairSpells__AltairSTSword_KS_deallocate(this)
                    call GearTimer03Release()
                else
                    call BlzSetSpecialEffectZ(s__AltairSpells__AltairSTSword_KS_art[this], AltairSpells__AltairGroundZ(s__AltairSpells__AltairSTSword_KS_positionX[this] , s__AltairSpells__AltairSTSword_KS_positionY[this]) + s__AltairSpells__AltairSTSword_KS_height[this])
                    set index=index + 1
                endif
            endloop
            set target=null
        endfunction

        function s__AltairSpells__AltairSTSword_KS_Drop takes unit caster,real centerX,real centerY returns nothing
            local integer this= s__AltairSpells__AltairSTSword_KS__allocate()
            local real distance= AltairST_Aoe * SquareRoot(GetRandomReal(0.0, 1.0))
            local real angle= GetRandomReal(0.0, 2.0 * bj_PI)
            set s__AltairSpells__AltairSTSword_KS_hero[this]=caster
            set s__AltairSpells__AltairSTSword_KS_positionX[this]=centerX + distance * Cos(angle)
            set s__AltairSpells__AltairSTSword_KS_positionY[this]=centerY + distance * Sin(angle)
            set s__AltairSpells__AltairSTSword_KS_height[this]=AltairST_DropHeight
            set s__AltairSpells__AltairSTSword_KS_damage[this]=AltairSpells__AltairSwordDamage(s__AltairSpells__AltairSTSword_KS_hero[this] , AltairST_DamageInt , AltairST_DamageAtk)
            set s__AltairSpells__AltairSTSword_KS_art[this]=AddSpecialEffect(Altair_SwordModel, s__AltairSpells__AltairSTSword_KS_positionX[this], s__AltairSpells__AltairSTSword_KS_positionY[this])
            // Blade along X: pitch it to point straight down.
            call BlzSetSpecialEffectOrientation(s__AltairSpells__AltairSTSword_KS_art[this], angle, bj_PI / 2.0, 0.0)
            call BlzSetSpecialEffectScale(s__AltairSpells__AltairSTSword_KS_art[this], 0.45)
            call BlzSetSpecialEffectZ(s__AltairSpells__AltairSTSword_KS_art[this], AltairSpells__AltairGroundZ(s__AltairSpells__AltairSTSword_KS_positionX[this] , s__AltairSpells__AltairSTSword_KS_positionY[this]) + s__AltairSpells__AltairSTSword_KS_height[this])
            set s__AltairSpells__AltairSTSword_KS_active[s__AltairSpells__AltairSTSword_KS_count]=this
            set s__AltairSpells__AltairSTSword_KS_count=s__AltairSpells__AltairSTSword_KS_count + 1
            call GearTimer03Acquire()
        endfunction


        function s__AltairSpells__AltairST_KS_Loop takes nothing returns nothing
            local integer index= 0
            local integer this
            loop
                exitwhen index >= s__AltairSpells__AltairST_KS_count
                set this=s__AltairSpells__AltairST_KS_active[index]
                set s__AltairSpells__AltairST_KS_elapsed[this]=s__AltairSpells__AltairST_KS_elapsed[this] + 0.03
                if s__AltairSpells__AltairST_KS_elapsed[this] >= AltairST_Duration or not AltairSpells__AltairAlive(s__AltairSpells__AltairST_KS_hero[this]) then
                    call SetFly(s__AltairSpells__AltairST_KS_hero[this] , 0.0)
                    call StopSpellUnit(s__AltairSpells__AltairST_KS_hero[this])
                    call ColorEffDummy3Alpha((s__AltairSpells__AltairST_KS_circle[this] ) , (( 0.0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.3)*1.0)) // INLINED!!
                    set s__AltairSpells__AltairST_KS_circle[this]=null
                    call ColorEffDummy3Alpha(((EffectSpawnScale(Altair_RingModel , GetUnitX(s__AltairSpells__AltairST_KS_hero[this]) , GetUnitY(s__AltairSpells__AltairST_KS_hero[this]) , 0.0 , 1.0 , 0.5 , 10.0 , 0.3 , 0.5 , AltairST_Aoe / 100.0)) ) , (( 0.25 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.35)*1.0)) // INLINED!!
                    call WOSUI___WUI_TestHeroProgress((s__AltairSpells__AltairST_KS_hero[this] ) , ( AltairST_ID ) , ( "Rain of Swords" ) , (( 0.0 )*1.0) , (( 0.0 )*1.0) , ( true) , "") // INLINED!!
                    call RemoveSavedInteger(AltairSpells__AltairTable, GetHandleId(s__AltairSpells__AltairST_KS_hero[this]), 7)
                    set s__AltairSpells__AltairST_KS_hero[this]=null
                    set s__AltairSpells__AltairST_KS_count=s__AltairSpells__AltairST_KS_count - 1
                    set s__AltairSpells__AltairST_KS_active[index]=s__AltairSpells__AltairST_KS_active[s__AltairSpells__AltairST_KS_count]
                    call s__AltairSpells__AltairST_KS_deallocate(this)
                    call GearTimer03Release()
                else
                    call SetFly(s__AltairSpells__AltairST_KS_hero[this] , AltairST_Height * RMinBJ(1.0, s__AltairSpells__AltairST_KS_elapsed[this] / AltairST_RiseTime))
                    set s__AltairSpells__AltairST_KS_decorTimer[this]=s__AltairSpells__AltairST_KS_decorTimer[this] + 0.03
                    if s__AltairSpells__AltairST_KS_decorTimer[this] >= 1.0 then
                        set s__AltairSpells__AltairST_KS_decorTimer[this]=s__AltairSpells__AltairST_KS_decorTimer[this] - 1.0
                        call DecorRemove(s__AltairSpells__AltairST_KS_hero[this] , s__AltairSpells__AltairST_KS_centerX[this] , s__AltairSpells__AltairST_KS_centerY[this] , AltairST_Aoe , AltairST_Decor)
                        call VisionTimed(GetOwningPlayer(s__AltairSpells__AltairST_KS_hero[this]) , s__AltairSpells__AltairST_KS_centerX[this] , s__AltairSpells__AltairST_KS_centerY[this] , AltairST_Aoe * 1.4 , 1.2)
                    endif
                    set s__AltairSpells__AltairST_KS_spawnTimer[this]=s__AltairSpells__AltairST_KS_spawnTimer[this] + 0.03
                    loop
                        exitwhen s__AltairSpells__AltairST_KS_spawnTimer[this] < AltairST_SpawnPeriod
                        set s__AltairSpells__AltairST_KS_spawnTimer[this]=s__AltairSpells__AltairST_KS_spawnTimer[this] - AltairST_SpawnPeriod
                        call s__AltairSpells__AltairSTSword_KS_Drop(s__AltairSpells__AltairST_KS_hero[this] , s__AltairSpells__AltairST_KS_centerX[this] , s__AltairSpells__AltairST_KS_centerY[this])
                    endloop
                    call WOSUI___WUI_TestHeroProgress((s__AltairSpells__AltairST_KS_hero[this] ) , ( AltairST_ID ) , ( "Rain of Swords" ) , (( AltairST_Duration - s__AltairSpells__AltairST_KS_elapsed[this] )*1.0) , (( AltairST_Duration )*1.0) , ( true) , "") // INLINED!!
                    set index=index + 1
                endif
            endloop
        endfunction

        function s__AltairSpells__AltairST_KS_Start takes unit caster returns nothing
            local integer this= LoadInteger(AltairSpells__AltairTable, GetHandleId(caster), 7)
            if this != 0 then
                return
            endif
            set this=s__AltairSpells__AltairST_KS__allocate()
            set s__AltairSpells__AltairST_KS_hero[this]=caster
            set s__AltairSpells__AltairST_KS_centerX[this]=GetUnitX(s__AltairSpells__AltairST_KS_hero[this])
            set s__AltairSpells__AltairST_KS_centerY[this]=GetUnitY(s__AltairSpells__AltairST_KS_hero[this])
            set s__AltairSpells__AltairST_KS_elapsed[this]=0.0
            set s__AltairSpells__AltairST_KS_spawnTimer[this]=0.0
            set s__AltairSpells__AltairST_KS_decorTimer[this]=1.0
            set s__AltairSpells__AltairST_KS_circle[this]=EffectSpawn(AltairT_GroundModel , s__AltairSpells__AltairST_KS_centerX[this] , s__AltairSpells__AltairST_KS_centerY[this] , 0.0 , 1.0 , AltairST_Aoe / 150.0 , 5.0)
            call StartSpellUnit(s__AltairSpells__AltairST_KS_hero[this])
            call SetUnitAnimation(s__AltairSpells__AltairST_KS_hero[this], "spell")
            call DestroyEffect(EffectSpawn(Altair_SwitchModel , s__AltairSpells__AltairST_KS_centerX[this] , s__AltairSpells__AltairST_KS_centerY[this] , 0.0 , 1.0 , 1.2 , 0.0))
            call EffectSpawn2(AltairST_BeamModel , s__AltairSpells__AltairST_KS_centerX[this] , s__AltairSpells__AltairST_KS_centerY[this] , 0.0 , 1.0 , AltairST_Aoe / 550.0 , 0.0 , 2.5)
            call SaveInteger(AltairSpells__AltairTable, GetHandleId(s__AltairSpells__AltairST_KS_hero[this]), 7, this)
            set s__AltairSpells__AltairST_KS_active[s__AltairSpells__AltairST_KS_count]=this
            set s__AltairSpells__AltairST_KS_count=s__AltairSpells__AltairST_KS_count + 1
            call GearTimer03Acquire()
        endfunction

    // ==================== COMMON: one timer listener and hero lifecycle ====================
    function AltairSpells__AltairTimer03Loop takes nothing returns boolean
        call s__AltairSpells__AltairBlade_KS_Loop()
        call s__AltairSpells__AltairBullet_KS_Loop()
        call s__AltairSpells__AltairQ_KS_Loop()
        call s__AltairSpells__AltairW_KS_Loop()
        call s__AltairSpells__AltairWBlock_KS_Loop()
        call s__AltairSpells__AltairE_KS_Loop()
        call s__AltairSpells__AltairRGate_KS_Loop()
        call s__AltairSpells__AltairRMissile_KS_Loop()
        call s__AltairSpells__AltairR_KS_Loop()
        call s__AltairSpells__AltairT_KS_Loop()
        call s__AltairSpells__AltairSQ_KS_Loop()
        call s__AltairSpells__AltairSE_KS_Loop()
        call s__AltairSpells__AltairSR_KS_Loop()
        call s__AltairSpells__AltairSTSword_KS_Loop()
        call s__AltairSpells__AltairST_KS_Loop()
        call s__AltairSpells__AltairState_Loop()
        return false
    endfunction

    function Altair_Register takes unit hero returns nothing
        local integer state
        local integer slot= 0
        if GetUnitTypeId(hero) != Altair_ID or IsUnitIllusion(hero) then
            return
        endif
        if not AltairSpells__AltairListenerOn then
            set AltairSpells__AltairListenerOn=true
            call TriggerAddCondition(GearTimer03Listeners, Condition(function AltairSpells__AltairTimer03Loop))
        endif
        set state=LoadInteger(AltairSpells__AltairTable, GetHandleId(hero), 0)
        if state == 0 then
            set state=s__AltairSpells__AltairState__allocate()
            set s__AltairSpells__AltairState_hero[state]=hero
            set s__AltairSpells__AltairState_stacks[state]=0
            set s__AltairSpells__AltairState_shownStacks[state]=- 1
            set s__AltairSpells__AltairState_stackTimer[state]=0.0
            set s__AltairSpells__AltairState_swordToggle[state]=false
            set s__AltairSpells__AltairState_guardAngle[state]=0.0
            set s__AltairSpells__AltairState_seCost[state]=AltairSE_Cost
            set s__AltairSpells__AltairState_seWindow[state]=0.0
            set s__AltairSpells__AltairState_fRemaining[state]=0.0
            set s__AltairSpells__AltairState_fEffect[state]=null
            set s__AltairSpells__AltairState_reflectTarget[state]=null
            set s__AltairSpells__AltairState_reflectAmount[state]=0.0
            set s__AltairSpells__AltairState_shieldRemaining[state]=0.0
            set s__AltairSpells__AltairState_shieldAngle[state]=0.0
            set s__AltairSpells__AltairState_refundAbility[state]=0
            loop
                exitwhen slot > 6
                set s___AltairSpells__AltairState_holoLevel[s__AltairSpells__AltairState_holoLevel[state]+slot]=0
                set s___AltairSpells__AltairState_voiceCycle[s__AltairSpells__AltairState_voiceCycle[state]+slot]=0
                set s___AltairSpells__AltairState_voiceCycle[s__AltairSpells__AltairState_voiceCycle[state]+slot + 7]=0
                set s___AltairSpells__AltairState_voiceCycle[s__AltairSpells__AltairState_voiceCycle[state]+slot + 13]=0
                set s___AltairSpells__AltairState_swordDisabled[s__AltairSpells__AltairState_swordDisabled[state]+slot]=false
                if slot < AltairSF_GuardBlades then
                    set s___AltairSpells__AltairState_guard[s__AltairSpells__AltairState_guard[state]+slot]=null
                endif
                if slot >= 5 then
                    call UnitAddAbility(hero, AltairSpells__AltairHoloAbility[slot])
                    call UnitMakeAbilityPermanent(hero, true, AltairSpells__AltairHoloAbility[slot])
                endif
                call UnitAddAbility(hero, AltairSpells__AltairSwordAbility[slot])
                call UnitMakeAbilityPermanent(hero, true, AltairSpells__AltairSwordAbility[slot])
                set slot=slot + 1
            endloop
            call SaveInteger(AltairSpells__AltairTable, GetHandleId(hero), 0, state)
            call s__AltairSpells__AltairState_ApplyForm(state,Altair_FormHolopsicon)
            call s__AltairSpells__AltairState_Activate(state)
        endif
    endfunction

    function Altair_ResetForTest takes unit hero returns nothing
        local integer state
        call Altair_Register(hero)
        set state=LoadInteger(AltairSpells__AltairTable, GetHandleId(hero), 0)
        if state != 0 then
            set s__AltairSpells__AltairState_stacks[state]=(GetHeroLevel(s__AltairSpells__AltairState_hero[(state)]) + AltairSF_StackBonus) // INLINED!!
            set s__AltairSpells__AltairState_seCost[state]=AltairSE_Cost
        endif
    endfunction

    // Death.j: hero deaths feed Endless Swords; Altair's own death closes her realm.
    function Altair_Death takes unit dying returns nothing
        local integer index= 0
        local integer state
        if GetUnitTypeId(dying) == Altair_ID then
            call s__AltairSpells__AltairT_KS_EndFor(dying)
            set state=LoadInteger(AltairSpells__AltairTable, GetHandleId(dying), 0)
            if state != 0 then
                set s__AltairSpells__AltairState_fRemaining[state]=0.0
                call s__AltairSpells__AltairState_SetToggle(state,false)
            endif
        endif
        if IsUnitType(dying, UNIT_TYPE_HERO) and not IsUnitIllusion(dying) then
            loop
                exitwhen index >= s__AltairSpells__AltairState_count
                set state=s__AltairSpells__AltairState_active[index]
                if s__AltairSpells__AltairState_hero[state] != dying then
                    call s__AltairSpells__AltairState_AddStacks(state,AltairSF_DeathStacks)
                endif
                set index=index + 1
            endloop
        endif
    endfunction

    // DmgSys, incoming phase: W block, F reflection, SR directional shield, SF toggle.
    function Altair_IncomingDamage takes unit source,unit target,real damage,integer damageType returns real
        local integer state
        local boolean enemy
        local real angle
        if damage <= 0.0 or source == null or target == null then
            return damage
        endif
        set enemy=IsUnitEnemy(source, GetOwningPlayer(target))
        if enemy and s__AltairSpells__AltairWBlock_KS_Consume(target) then
            return LustSin(source , target , damage , damage)
        endif
        if GetUnitTypeId(target) != Altair_ID then
            return damage
        endif
        set state=LoadInteger(AltairSpells__AltairTable, GetHandleId(target), 0)
        if state == 0 then
            return damage
        endif
        if enemy and s__AltairSpells__AltairState_fRemaining[state] > 0.0 then
            set s__AltairSpells__AltairState_fRemaining[state]=0.0
            set s__AltairSpells__AltairState_reflectTarget[state]=source
            set s__AltairSpells__AltairState_reflectAmount[state]=damage
            return LustSin(source , target , damage , damage)
        endif
        if enemy and s__AltairSpells__AltairState_shieldRemaining[state] > 0.0 then
            set angle=Atan2(GetUnitY(source) - GetUnitY(target), GetUnitX(source) - GetUnitX(target))
            if Cos(angle - s__AltairSpells__AltairState_shieldAngle[state]) >= Cos(AltairSR_Arc * 0.5 * bj_DEGTORAD) then
                call DestroyEffect(AddSpecialEffectTarget(Altair_SwordHitModel, target, "chest"))
                return LustSin(source , target , damage , damage)
            endif
        endif
        // Toggled Endless Swords: every received attack is 10% weaker and costs 2 stacks.
        if s__AltairSpells__AltairState_swordToggle[state] and damageType == 0 then
            set damage=damage * AltairSF_AttackTaken
            call s__AltairSpells__AltairState_AddStacks(state,- AltairSF_AttackCost)
        endif
        return damage
    endfunction

    // ==================== Holopsicon: CastCheck entry points ====================
    function AltairQ_Start takes unit hero,real positionX,real positionY returns nothing
        call Altair_Register(hero)
        call s__AltairSpells__AltairQ_KS_Start(hero , positionX , positionY)
        call s__AltairSpells__AltairState_Voice((LoadInteger(AltairSpells__AltairTable, GetHandleId(hero), 0)),0 , "Q" , 1 , 4)
    endfunction

    function AltairW_Start takes unit hero,unit target returns boolean
        local integer state
        call Altair_Register(hero)
        if not s__AltairSpells__AltairW_KS_Start(hero , target) then
            return false
        endif
        // Third Movement for an ally, Ninth Movement for an enemy.
        set state=LoadInteger(AltairSpells__AltairTable, GetHandleId(hero), 0)
        if IsUnitAlly(target, GetOwningPlayer(hero)) then
            call s__AltairSpells__AltairState_Voice(state,1 , "W" , 1 , 1)
        else
            call s__AltairSpells__AltairState_Voice(state,2 , "W" , 2 , 2)
        endif
        return true
    endfunction

    function AltairE_Start takes unit hero returns nothing
        call Altair_Register(hero)
        call s__AltairSpells__AltairE_KS_Start(hero)
        call s__AltairSpells__AltairState_Voice((LoadInteger(AltairSpells__AltairTable, GetHandleId(hero), 0)),3 , "E" , 1 , 2)
    endfunction

    function AltairR_Start takes unit hero,real positionX,real positionY returns boolean
        local integer state
        call Altair_Register(hero)
        if s__AltairSpells__AltairR_KS_Start(hero , positionX , positionY) then
            return true
        endif
        set state=LoadInteger(AltairSpells__AltairTable, GetHandleId(hero), 0)
        call s__AltairSpells__AltairState_Refuse(state,AltairR_ID , "Factor Mimic: no decorations to copy here")
        return false
    endfunction

    function AltairT_Start takes unit hero,real positionX,real positionY returns boolean
        call Altair_Register(hero)
        return s__AltairSpells__AltairT_KS_Start(hero , positionX , positionY)
    endfunction

    function AltairF_Start takes unit hero returns nothing
        local integer state
        call Altair_Register(hero)
        set state=LoadInteger(AltairSpells__AltairTable, GetHandleId(hero), 0)
        set s__AltairSpells__AltairState_fRemaining[state]=AltairF_Duration
        call s__AltairSpells__AltairState_Voice(state,9 , "F" , 1 , 2)
        if s__AltairSpells__AltairState_fEffect[state] == null then
            set s__AltairSpells__AltairState_fEffect[state]=AddSpecialEffect(AltairF_Model, GetUnitX(hero), GetUnitY(hero))
            call BlzSetSpecialEffectScale(s__AltairSpells__AltairState_fEffect[state], AltairF_ModelScale)
            call BlzPlaySpecialEffect(s__AltairSpells__AltairState_fEffect[state], ANIM_TYPE_BIRTH)
        endif
        call ColorEffDummy3Alpha(((EffectSpawn(Altair_CircleModel , GetUnitX(hero) , GetUnitY(hero) , 0.0 , 1.0 , 0.9 , 5.0)) ) , (( 0.25 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.35)*1.0)) // INLINED!!
        call SetUnitAnimation(hero, "spell")
    endfunction

    // Meta Change during the realm ends it early.
    function AltairG_Start takes unit hero returns nothing
        local integer state
        call Altair_Register(hero)
        set state=LoadInteger(AltairSpells__AltairTable, GetHandleId(hero), 0)
        call s__AltairSpells__AltairT_KS_EndFor(hero)
        call s__AltairSpells__AltairState_SwitchForm(state,Altair_FormSword)
    endfunction

    // ==================== Sword Princess: CastCheck entry points ====================
    function AltairSQ_Start takes unit hero,real positionX,real positionY returns boolean
        local integer state
        call Altair_Register(hero)
        set state=LoadInteger(AltairSpells__AltairTable, GetHandleId(hero), 0)
        if not s__AltairSpells__AltairState_TrySpend(state,AltairSQ_Cost) then
            call s__AltairSpells__AltairState_Refuse(state,AltairSQ_ID , "Not enough sword stacks")
            return false
        endif
        call s__AltairSpells__AltairSQ_KS_Start(hero , positionX , positionY)
        call s__AltairSpells__AltairState_Voice(state,13 , "GQ" , 1 , 3)
        return true
    endfunction

    function AltairSW_Start takes unit hero,real positionX,real positionY returns boolean
        local integer state
        call Altair_Register(hero)
        set state=LoadInteger(AltairSpells__AltairTable, GetHandleId(hero), 0)
        if not s__AltairSpells__AltairState_TrySpend(state,AltairSW_Cost) then
            call s__AltairSpells__AltairState_Refuse(state,AltairSW_ID , "Not enough sword stacks")
            return false
        endif
        call AltairSpells__AltairSW_Cast(hero , positionX , positionY)
        call s__AltairSpells__AltairState_Voice(state,14 , "GW" , 1 , 2)
        return true
    endfunction

    // Each recast inside the window costs 2 more stacks (up to 6) and spins harder.
    function AltairSE_Start takes unit hero returns boolean
        local integer state
        local integer cost
        call Altair_Register(hero)
        set state=LoadInteger(AltairSpells__AltairTable, GetHandleId(hero), 0)
        set cost=s__AltairSpells__AltairState_seCost[state]
        if not s__AltairSpells__AltairState_TrySpend(state,cost) then
            call s__AltairSpells__AltairState_Refuse(state,AltairSE_ID , "Not enough sword stacks")
            return false
        endif
        call s__AltairSpells__AltairSE_KS_Start(hero , ( cost - AltairSE_Cost ) / AltairSE_CostStep)
        call s__AltairSpells__AltairState_Voice(state,15 , "GE" , 1 , 2)
        set s__AltairSpells__AltairState_seCost[state]=IMinBJ(AltairSE_CostMax, cost + AltairSE_CostStep)
        set s__AltairSpells__AltairState_seWindow[state]=AltairSE_RecastWindow
        return true
    endfunction

    function AltairSR_Start takes unit hero,real positionX,real positionY returns boolean
        local integer state
        call Altair_Register(hero)
        set state=LoadInteger(AltairSpells__AltairTable, GetHandleId(hero), 0)
        if not s__AltairSpells__AltairState_TrySpend(state,AltairSR_Cost) then
            call s__AltairSpells__AltairState_Refuse(state,AltairSR_ID , "Not enough sword stacks")
            return false
        endif
        call s__AltairSpells__AltairSR_KS_Start(hero , positionX , positionY)
        call s__AltairSpells__AltairState_Voice(state,16 , "GR" , 1 , 2)
        return true
    endfunction

    function AltairST_Start takes unit hero returns boolean
        local integer state
        call Altair_Register(hero)
        set state=LoadInteger(AltairSpells__AltairTable, GetHandleId(hero), 0)
        if not s__AltairSpells__AltairState_TrySpend(state,AltairST_Cost) then
            call s__AltairSpells__AltairState_Refuse(state,AltairST_ID , "Not enough sword stacks")
            return false
        endif
        call s__AltairSpells__AltairST_KS_Start(hero)
        call s__AltairSpells__AltairState_Voice(state,17 , "GT" , 1 , 2)
        return true
    endfunction

    function AltairSF_Start takes unit hero returns nothing
        local integer state
        call Altair_Register(hero)
        set state=LoadInteger(AltairSpells__AltairTable, GetHandleId(hero), 0)
        if not s__AltairSpells__AltairState_swordToggle[state] and s__AltairSpells__AltairState_stacks[state] < AltairSF_AttackCost then
            call s__AltairSpells__AltairState_Refuse(state,AltairSF_ID , "Not enough sword stacks")
            return
        endif
        call s__AltairSpells__AltairState_SetToggle(state,not s__AltairSpells__AltairState_swordToggle[state])
        if s__AltairSpells__AltairState_swordToggle[state] then
            call s__AltairSpells__AltairState_Voice(state,18 , "GF" , 1 , 1)
        endif
    endfunction

    function AltairSG_Start takes unit hero returns nothing
        local integer state
        call Altair_Register(hero)
        set state=LoadInteger(AltairSpells__AltairTable, GetHandleId(hero), 0)
        call s__AltairSpells__AltairState_SwitchForm(state,Altair_FormHolopsicon)
