        endfunction



        function s__PatriotSpells___PatriotSpells_R_Loop_PatriotR takes nothing returns nothing
            local integer i= 0
            local integer this
            local unit u
            local real x
            local real y
            local boolean remove

            loop
                exitwhen i > s__PatriotSpells___PatriotSpells_R_MUI_PatriotR
                set this=s__PatriotSpells___PatriotSpells_R_m_PatriotR[i]
                set remove=false

                if s__PatriotSpells___PatriotSpells_R_c[this] == null or GetUnitTypeId(s__PatriotSpells___PatriotSpells_R_c[this]) == 0 or not SpellBoolCaster(s__PatriotSpells___PatriotSpells_R_c[this]) or s__PatriotSpells___PatriotSpells_R_r[this] > s__PatriotSpells___PatriotSpells_R_rmax[this] then
                    set remove=true
                else
                    set s__PatriotSpells___PatriotSpells_R_r[this]=I2R(R2I(( s__PatriotSpells___PatriotSpells_R_r[this] + 0.03 ) * 1000.0 + 0.5)) / 1000.0
                    if s__PatriotSpells___PatriotSpells_R_check[this] == 0 then
                        if s__PatriotSpells___PatriotSpells_R_r[this] > PatriotR_CastTime then
                            set s__PatriotSpells___PatriotSpells_R_r5[this]=s__PatriotSpells___PatriotSpells_R_r5[this] + s__PatriotSpells___PatriotSpells_R_move[this]
                            if s__PatriotSpells___PatriotSpells_R_r5[this] > s__PatriotSpells___PatriotSpells_R_r7[this] or LoadInteger(hs, GetHandleId(s__PatriotSpells___PatriotSpells_R_c[this]), PatriotSpells___SH_R_ACT) == 1 then
                                set s__PatriotSpells___PatriotSpells_R_r[this]=0.0
                                set s__PatriotSpells___PatriotSpells_R_r2[this]=255.0
                                set s__PatriotSpells___PatriotSpells_R_rmax[this]=PatriotR_Duration
                                if GetHeroLevel(s__PatriotSpells___PatriotSpells_R_c[this]) < 35 then
                                    set remove=true
