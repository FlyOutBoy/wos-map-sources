                            set s__FrierenSpells__FrierenSpells_Q_scale[this]=s__FrierenSpells__FrierenSpells_Q_scale[this] + 0.01
                            set s__FrierenSpells__FrierenSpells_Q_k[this]=s__FrierenSpells__FrierenSpells_Q_k[this] + 1
                        endloop
                        if s__FrierenSpells__FrierenSpells_Q_r3[this] > 0.03 then
                            set s__FrierenSpells__FrierenSpells_Q_r3[this]=0
                            set s__FrierenSpells__FrierenSpells_Q_scale2[this]=s__FrierenSpells__FrierenSpells_Q_scale2[this] + 0.005
                            call DestroyEffect(EffectSpawnColor("war3mapimported\\wos_Mdx_Effect_05 Mikoto AZ_Dust Rush 01.mdl" , s__FrierenSpells__FrierenSpells_Q_x[this] , s__FrierenSpells__FrierenSpells_Q_y[this] , s__FrierenSpells__FrierenSpells_Q_a[this] * bj_RADTODEG , 1 , 1.1 , 1 , 255 , 255 , 255 , 115))
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_1baozha_90.mdl" , s__FrierenSpells__FrierenSpells_Q_x[this] , s__FrierenSpells__FrierenSpells_Q_y[this] , 1 , 1 , 1.75 , 1))
                            call DestroyEffect(EffectSpawnColor3("war3mapimported\\wos_whitering.mdx" , s__FrierenSpells__FrierenSpells_Q_x[this] + rkek * Cos(s__FrierenSpells__FrierenSpells_Q_a[this]) , s__FrierenSpells__FrierenSpells_Q_y[this] + rkek * Sin(s__FrierenSpells__FrierenSpells_Q_a[this]) , s__FrierenSpells__FrierenSpells_Q_a[this] * bj_RADTODEG , 3.75 , s__FrierenSpells__FrierenSpells_Q_scale2[this] , 265 , - 90 , 0 , 75 , 255 , 255))
                            call DestroyEffect(EffectSpawnColor("war3mapimported\\wos_cf2.mdx" , s__FrierenSpells__FrierenSpells_Q_x[this] + rkek * Cos(s__FrierenSpells__FrierenSpells_Q_a[this]) , s__FrierenSpells__FrierenSpells_Q_y[this] + rkek * Sin(s__FrierenSpells__FrierenSpells_Q_a[this]) , s__FrierenSpells__FrierenSpells_Q_a[this] * bj_RADTODEG , 1 , 1.75 , 15 , 255 , 255 , 255 , 125))
                        else
                            set s__FrierenSpells__FrierenSpells_Q_r3[this]=s__FrierenSpells__FrierenSpells_Q_r3[this] + 0.03
