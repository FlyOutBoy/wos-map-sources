                                call SaveInteger(hs, GetHandleId(s__FrierenSpells__FrierenSpells_T_u[this]), FrierenSpells__SH_FRIEREN_T_PUSH, 1)
                                call s__GearSystems2___KS_Flush_Start((GetHandleId(s__FrierenSpells__FrierenSpells_T_u[this]) ) , ( FrierenSpells__SH_FRIEREN_T_PUSH ) , ( 0 ) , (( 0.3)*1.0)) // INLINED!!
                                    call s__FrierenSpells__KS_MoveUnitFrir_MUE_Start1(s__FrierenSpells__FrierenSpells_T_u[this] , 1000 - SR3(s__FrierenSpells__FrierenSpells_T_u[this] , x , y) , 0.3 , GAngle3(x , y , s__FrierenSpells__FrierenSpells_T_u[this]))
                                endif
                                call GroupRemoveUnit(s__FrierenSpells__FrierenSpells_T_g[this], s__FrierenSpells__FrierenSpells_T_u[this])
                            endloop
                            set s__FrierenSpells__FrierenSpells_T_u[this]=null
