            set s__OkarunSpells___OkarunR_KS_check2[this]=0
            set s__OkarunSpells___OkarunR_KS_move[this]=100
            call StartSpellUnit2(s__OkarunSpells___OkarunR_KS_c[this])
            set s__OkarunSpells___OkarunR_KS_u[this]=null
            set s__OkarunSpells___OkarunR_KS_g[this]=CreateGroup()
            set s__OkarunSpells___OkarunR_KS_r4[this]=0
