    function TakeshiSpells___TakeshiTick10_On takes integer k returns nothing
        if not TakeshiSpells___TakeshiTick10_Active[k] then
            set TakeshiSpells___TakeshiTick10_Active[k]=true
            set TakeshiSpells___TakeshiTick10_Users=TakeshiSpells___TakeshiTick10_Users + 1
            if TakeshiSpells___TakeshiTick10_Users == 1 then
                call TimerStart(TakeshiSpells___TakeshiTick10_Timer, 0.1, true, TakeshiSpells___TakeshiTick10_Callback)
            endif
        endif
    endfunction

    function TakeshiSpells___TakeshiTick10_Off takes integer k returns nothing
        if TakeshiSpells___TakeshiTick10_Active[k] then
            set TakeshiSpells___TakeshiTick10_Active[k]=false
            set TakeshiSpells___TakeshiTick10_Users=TakeshiSpells___TakeshiTick10_Users - 1
            if TakeshiSpells___TakeshiTick10_Users <= 0 then
                set TakeshiSpells___TakeshiTick10_Users=0
                call PauseTimer(TakeshiSpells___TakeshiTick10_Timer)
            endif
        endif
    endfunction


    function TakeshiSpells___TakeshiTick_On takes integer k returns nothing
        if not TakeshiSpells___TakeshiTick_Active[k] then
            set TakeshiSpells___TakeshiTick_Active[k]=true
            set TakeshiSpells___TakeshiTick_Users=TakeshiSpells___TakeshiTick_Users + 1
            if TakeshiSpells___TakeshiTick_Users == 1 then
                call TimerStart(TakeshiSpells___TakeshiTick_Timer, 0.03, true, TakeshiSpells___TakeshiTick_Callback)
            endif
        endif
    endfunction

    function TakeshiSpells___TakeshiTick_Off takes integer k returns nothing
        if TakeshiSpells___TakeshiTick_Active[k] then
            set TakeshiSpells___TakeshiTick_Active[k]=false
            set TakeshiSpells___TakeshiTick_Users=TakeshiSpells___TakeshiTick_Users - 1
            if TakeshiSpells___TakeshiTick_Users <= 0 then
                set TakeshiSpells___TakeshiTick_Users=0
                call PauseTimer(TakeshiSpells___TakeshiTick_Timer)
            endif
        endif
    endfunction

    function TakeshiGAdd_Start takes unit c,real dmg returns nothing
        local real dmg2= LoadReal(hs, GetHandleId(c), TakeshiSpells___SH_TAKESHI_DMG) + dmg
        local real rmax= TakeshiG_TakenDamageToEnter
        if GetHeroLevel(c) >= 35 and LoadInteger(hs, GetHandleId(c), TakeshiSpells___SH_MODE_G) == 0 then
            set dmg2=RMaxBJ(0.00, RMinBJ(rmax, dmg2))
            if dmg2 >= rmax then
                if TakeshiDummy == null then
                    set TakeshiDummy=CreateUnit(GetOwningPlayer(c), TakeshiDummy_ID, GetRectCenterX(gg_rct_Caster), GetRectCenterY(gg_rct_Caster), 1)
                endif
            elseif TakeshiDummy != null then
                call RemoveUnit(TakeshiDummy)
                set TakeshiDummy=null
            endif
            call SaveReal(hs, GetHandleId(c), TakeshiSpells___SH_TAKESHI_DMG, dmg2)
            if dmg2 >= rmax then
                call WUI_HeroProgressDualCounter(c , TakeshiG2_ID , "Cambio Damage" , dmg2 , rmax , LoadReal(hs, GetHandleId(c), TakeshiSpells___SH_CAMBIO_EXT) , TakeshiG_ExtendMax , "+" + I2S(R2I(LoadReal(hs, GetHandleId(c), TakeshiSpells___SH_CAMBIO_EXT))) + " / " + I2S(R2I(TakeshiG_ExtendMax)) + " sec")
            else
                call WUI_HeroProgressSingle(c , TakeshiG2_ID)
                call WUI_HeroProgressCounter(c , TakeshiG2_ID , "Cambio Damage" , dmg2 , rmax)
            endif
        endif
    endfunction
    // Invulnerability: this spell contains a StartSpellUnit/Avul phase.

