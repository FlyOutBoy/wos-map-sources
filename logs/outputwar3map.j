                                exitwhen s__PatriotSpells___PatriotSpells_R_k[this] == 3
                                call MoveEff2(s___PatriotSpells___PatriotSpells_R_ee[s__PatriotSpells___PatriotSpells_R_ee[this]+s__PatriotSpells___PatriotSpells_R_k[this]] , s__PatriotSpells___PatriotSpells_R_move[this] , s__PatriotSpells___PatriotSpells_R_a[this])
                                call MoveEff2(s___PatriotSpells___PatriotSpells_R_ee[s__PatriotSpells___PatriotSpells_R_ee[this]+s__PatriotSpells___PatriotSpells_R_k[this] + 4] , s__PatriotSpells___PatriotSpells_R_move[this] , s__PatriotSpells___PatriotSpells_R_a[this])
                                set s__PatriotSpells___PatriotSpells_R_k[this]=s__PatriotSpells___PatriotSpells_R_k[this] + 1
                            endloop

                            if s__PatriotSpells___PatriotSpells_R_r2[this] > 0.0 then
                                call GroupClear(s__PatriotSpells___PatriotSpells_R_g[this])
                                set s__PatriotSpells___PatriotSpells_R_r6[this]=s__PatriotSpells___PatriotSpells_R_r7[this] - s__PatriotSpells___PatriotSpells_R_r5[this] + s__PatriotSpells___PatriotSpells_R_move[this]
                                if s__PatriotSpells___PatriotSpells_R_r6[this] < 0.0 then
