    function VisionTimed takes player p,real x,real y,real vision,real time returns nothing
        local fogmodifier fm
        local integer pid= GetPlayerId(p)
        local real now
        local real dx
        local real dy
        if not GearSystems2___GearVisionClockStarted then
            set GearSystems2___GearVisionClockStarted=true
            call TimerStart(GearSystems2___GearVisionClock, 1000000.0, false, null)
        endif
        set now=TimerGetElapsed(GearSystems2___GearVisionClock)
        // Skip when the previous reveal of this player (made < 0.12 s ago, same or larger
        // radius, centre within a quarter radius) already lasts as long as this one would.
        set dx=x - GearSystems2___GearVisionX[pid]
        set dy=y - GearSystems2___GearVisionY[pid]
        if now - GearSystems2___GearVisionMade[pid] < 0.12 and vision <= GearSystems2___GearVisionRadius[pid] and now + time <= GearSystems2___GearVisionExpire[pid] + 0.15 and dx * dx + dy * dy <= vision * vision * 0.0625 then
            return
        endif
        set GearSystems2___GearVisionX[pid]=x
        set GearSystems2___GearVisionY[pid]=y
        set GearSystems2___GearVisionRadius[pid]=vision
        set GearSystems2___GearVisionExpire[pid]=now + time
        set GearSystems2___GearVisionMade[pid]=now
        set fm=CreateFogModifierRadius(p, FOG_OF_WAR_VISIBLE, x, y, vision, true, false)
        call FogModifierStart(fm)
        call s__GearSystems2___KS_RemoveFog_MyRemoveFogModifier_Start((fm ) , (( time)*1.0)) // INLINED!!
        set fm=null
    endfunction
