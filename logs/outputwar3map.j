    //===========================================================================
    // Order Tracking (Бег без остановки)
    //===========================================================================
    function BrandishSpells__OnHeroPointOrder takes nothing returns boolean
        local unit u= GetOrderedUnit()
        local integer ord= GetIssuedOrderId()
        if GetUnitTypeId(u) == Brandish_ID then
            if ord == 851971 or ord == 851986 or ord == 851990 then
                call SaveInteger(BrandishSpells__hs, GetHandleId(u), BrandishSpells__SH_ORD_MODE, 1)
                call SaveInteger(BrandishSpells__hs, GetHandleId(u), BrandishSpells__SH_ORD_ID, ord)
                call SaveReal(BrandishSpells__hs, GetHandleId(u), BrandishSpells__SH_ORD_X, GetOrderPointX())
                call SaveReal(BrandishSpells__hs, GetHandleId(u), BrandishSpells__SH_ORD_Y, GetOrderPointY())
            endif
        endif
        set u=null
        return false
    endfunction

    function BrandishSpells__OnHeroTargetOrder takes nothing returns boolean
        local unit u= GetOrderedUnit()
        local integer ord= GetIssuedOrderId()
        if GetUnitTypeId(u) == Brandish_ID then
            if ord == 851971 or ord == 851983 then
                call SaveInteger(BrandishSpells__hs, GetHandleId(u), BrandishSpells__SH_ORD_MODE, 2)
                call SaveInteger(BrandishSpells__hs, GetHandleId(u), BrandishSpells__SH_ORD_ID, ord)
                call SaveUnitHandle(BrandishSpells__hs, GetHandleId(u), BrandishSpells__SH_ORD_TARGET, GetOrderTargetUnit())
            endif
        endif
        set u=null
        return false
    endfunction

    function BrandishSpells__OnHeroImmediateOrder takes nothing returns boolean
        local unit u= GetOrderedUnit()
        local integer ord= GetIssuedOrderId()
        if GetUnitTypeId(u) == Brandish_ID then
            if ord == 851972 or ord == 851993 then
                call SaveInteger(BrandishSpells__hs, GetHandleId(u), BrandishSpells__SH_ORD_MODE, 0)
            endif
        endif
        set u=null
        return false
    endfunction

    function Brandish_RestoreOrder takes unit c,integer animIndex returns nothing
        local integer mode= LoadInteger(BrandishSpells__hs, GetHandleId(c), BrandishSpells__SH_ORD_MODE)
        local real ox
        local real oy
        local real dx
        local real dy
        local integer oid
        local unit tu

        // 1. Герой на бегу в точку
        if mode == 1 then
            set ox=LoadReal(BrandishSpells__hs, GetHandleId(c), BrandishSpells__SH_ORD_X)
            set oy=LoadReal(BrandishSpells__hs, GetHandleId(c), BrandishSpells__SH_ORD_Y)
            set dx=ox - GetUnitX(c)
            set dy=oy - GetUnitY(c)
            // Если до цели больше 75 единиц — сразу возобновляем бег без анимации каста
            if ( dx * dx + dy * dy ) > 5625.0 then
                set oid=LoadInteger(BrandishSpells__hs, GetHandleId(c), BrandishSpells__SH_ORD_ID)
                call IssuePointOrderById(c, oid, ox, oy)
                return
            endif
        // 2. Герой на бегу к цели атаки/приказа
        elseif mode == 2 then
            set tu=LoadUnitHandle(BrandishSpells__hs, GetHandleId(c), BrandishSpells__SH_ORD_TARGET)
            if tu != null and GetWidgetLife(tu) > 0.405 then
                set oid=LoadInteger(BrandishSpells__hs, GetHandleId(c), BrandishSpells__SH_ORD_ID)
                call IssueTargetOrderById(c, oid, tu)
                set tu=null
                return
            endif
            set tu=null
        endif

        // 3. Герой стоит на месте (или уже добежал) — проигрываем анимацию
        call SetUnitAnimationByIndex(c, animIndex)
        call s__GearSystems2___KS_RemoveUnit_MyRemoveUnit_Start((c ) , (( 0.03 )*1.0) , 2 , - 1 , ( animIndex) , "") // INLINED!!
    endfunction

        function s__BrandishSpells__BrandishOrderInit_onInit takes nothing returns nothing
            local trigger tPoint= CreateTrigger()
            local trigger tTarget= CreateTrigger()
            local trigger tImmediate= CreateTrigger()
            local integer i= 0
            
        endfunction

