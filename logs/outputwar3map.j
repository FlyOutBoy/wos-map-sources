                set m=s__ItemsElementsFx_Mark(s__ItemsElementsFx_CINDER , s__ItemsElementsFx_src[this] , s__ItemsElementsFx_c[this] , s__ItemsElementsFx_u[this] , 3.5 , "Environment\\SmallBuildingFire\\SmallBuildingFire2.mdl")
                set s__ItemsElementsFx_dmg2[m]=CinderFang_Bonus * (I2R(GetHeroAgi((s__ItemsElementsFx_c[this]), true))) // INLINED!!
                set s__ItemsElementsFx_charges[m]=1
