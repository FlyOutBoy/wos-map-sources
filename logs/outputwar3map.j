                            call AddUnitAnimationProperties(s__AlucardSpells__AlucardSpells_R_c[this], "lumber", true)
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_Aluc_Explode_blood.mdl" , s__AlucardSpells__AlucardSpells_R_x[this] , s__AlucardSpells__AlucardSpells_R_y[this] , GetRandomReal(0, 359) , 1.2 , 1.5 , 1))
                            call s__GearSystems2___KS_DelayedSound_NextSound_Start(("war3mapimported\\Hero_Alucard_R2" ) , (( 2.6)*1.0)) // INLINED!!
                            call BlzSetUnitSkin(s__AlucardSpells__AlucardSpells_R_c[this], Alucard_Morph_ID)
                            call AAUniversalTooltips_SetUnitForm(s__AlucardSpells__AlucardSpells_R_c[this] , 1)
