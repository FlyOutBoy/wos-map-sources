                            set s__MilimSpells___MilimQKS_y[this]=GetUnitY(s__MilimSpells___MilimQKS_td[this])
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_az_hitheavy.mdl" , s__MilimSpells___MilimQKS_x[this] , s__MilimSpells___MilimQKS_y[this] , s__MilimSpells___MilimQKS_a[this] * bj_RADTODEG , 0.5 , 4.25 , 125))
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_BDEF (124)2.mdx" , s__MilimSpells___MilimQKS_x[this] , s__MilimSpells___MilimQKS_y[this] , GetRandomReal(0, 359) , 1 , 2.5 , 125))
                            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", s__MilimSpells___MilimQKS_td[this], "chest"))
                            call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_tx-ha_nitu.mdl" , GetUnitX(s__MilimSpells___MilimQKS_c[this]) , GetUnitY(s__MilimSpells___MilimQKS_c[this]) , s__MilimSpells___MilimQKS_a[this] * bj_RADTODEG , 2 , 2.45 , 2 , 255 , 255 , 255 , 255))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_senji-wind-impact-2.mdx" , s__MilimSpells___MilimQKS_x[this] + 190 * Cos(s__MilimSpells___MilimQKS_a[this]) , s__MilimSpells___MilimQKS_y[this] + 190 * Sin(s__MilimSpells___MilimQKS_a[this]) , s__MilimSpells___MilimQKS_a[this] * bj_RADTODEG , 2 , 1.15 , 85))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_senji-wind-impact-2.mdx" , s__MilimSpells___MilimQKS_x[this] + 290 * Cos(s__MilimSpells___MilimQKS_a[this]) , s__MilimSpells___MilimQKS_y[this] + 290 * Sin(s__MilimSpells___MilimQKS_a[this]) , s__MilimSpells___MilimQKS_a[this] * bj_RADTODEG , 1.9 , 1.35 , 85))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_senji-wind-impact-2.mdx" , s__MilimSpells___MilimQKS_x[this] + 390 * Cos(s__MilimSpells___MilimQKS_a[this]) , s__MilimSpells___MilimQKS_y[this] + 390 * Sin(s__MilimSpells___MilimQKS_a[this]) , s__MilimSpells___MilimQKS_a[this] * bj_RADTODEG , 1.8 , 1.55 , 85))
                        call EffectSpawn2("war3mapimported\\wos_LD2209 (157).mdx" , s__MilimSpells___MilimQKS_x[this] , s__MilimSpells___MilimQKS_y[this] , GetRandomReal(0, 359) , 1 , 0.8 , 0 , 1)
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_bloodex-special-23.mdl" , GetUnitX(s__MilimSpells___MilimQKS_td[this]) , GetUnitY(s__MilimSpells___MilimQKS_td[this]) , GetRandomReal(0, 359) , 2.5 , 2 , 80))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_az_hitheavy.mdl" , s__MilimSpells___MilimQKS_x[this] + 25 * Cos(s__MilimSpells___MilimQKS_a[this]) , s__MilimSpells___MilimQKS_y[this] + 25 * Sin(s__MilimSpells___MilimQKS_a[this]) , s__MilimSpells___MilimQKS_a[this] * bj_RADTODEG , 1 , 2.25 , 125))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_cf2.mdx" , s__MilimSpells___MilimQKS_x[this] + 125 * Cos(s__MilimSpells___MilimQKS_a[this]) , s__MilimSpells___MilimQKS_y[this] + 125 * Sin(s__MilimSpells___MilimQKS_a[this]) , s__MilimSpells___MilimQKS_a[this] * bj_RADTODEG , 0.6 , 1.45 , 15))
                          call DecorRemove(s__MilimSpells___MilimQKS_c[this] , s__MilimSpells___MilimQKS_x[this] , s__MilimSpells___MilimQKS_y[this] , MilimQ_DamageAoe2 , 25)
                                set s__MilimSpells___MilimQKS_r[this]=99999
                                call GroupEnumUnitsInRange(s__MilimSpells___MilimQKS_g[this], s__MilimSpells___MilimQKS_x[this], s__MilimSpells___MilimQKS_y[this], MilimQ_DamageAoe2, NoDecor_Cond)
                        loop
                            set s__MilimSpells___MilimQKS_u[this]=FirstOfGroup(s__MilimSpells___MilimQKS_g[this])
                            exitwhen s__MilimSpells___MilimQKS_u[this] == null
                            if SpellBool(s__MilimSpells___MilimQKS_u[this]) and IsUnitEnemy(s__MilimSpells___MilimQKS_u[this], GetOwningPlayer(s__MilimSpells___MilimQKS_c[this])) then
                                set GearDamageNextSource=('A0HG') // INLINED!!
                                call dmgphys(s__MilimSpells___MilimQKS_c[this] , s__MilimSpells___MilimQKS_u[this] , s__MilimSpells___MilimQKS_dmg[this])
                                call MUE(s__MilimSpells___MilimQKS_u[this] , MilimQ_PushRange , MilimQ_PushDuration , s__MilimSpells___MilimQKS_a[this])
                            endif
                            call GroupRemoveUnit(s__MilimSpells___MilimQKS_g[this], s__MilimSpells___MilimQKS_u[this])
                        endloop
                           endif
                           endif
                else
                    
                        call StopSpellUnit2(s__MilimSpells___MilimQKS_c[this])
                    call SetUnitTimeScale(s__MilimSpells___MilimQKS_c[this], 1)
                    call DestroyEffect(s__MilimSpells___MilimQKS_e[this])
                    call DestroyEffect(s__MilimSpells___MilimQKS_e2[this])
                    call DestroyEffect(s__MilimSpells___MilimQKS_e3[this])
                    call DestroyGroup(s__MilimSpells___MilimQKS_g[this])
                    call DestroyGroup(s__MilimSpells___MilimQKS_g2[this])
                    set s__MilimSpells___MilimQKS_g[this]=null
                    set s__MilimSpells___MilimQKS_g2[this]=null
                    set s__MilimSpells___MilimQKS_c[this]=null
                    set s__MilimSpells___MilimQKS_e[this]=null
                    set s__MilimSpells___MilimQKS_e2[this]=null
                    set s__MilimSpells___MilimQKS_e3[this]=null
                    set s__MilimSpells___MilimQKS_u[this]=null
                    set s__MilimSpells___MilimQKS_m_MilimQ[i]=s__MilimSpells___MilimQKS_m_MilimQ[s__MilimSpells___MilimQKS_MUI_MilimQ]
                    set s__MilimSpells___MilimQKS_MUI_MilimQ=s__MilimSpells___MilimQKS_MUI_MilimQ - 1
                    set i=i - 1 // revisit: the moved instance must not skip this tick
                    if s__MilimSpells___MilimQKS_MUI_MilimQ == - 1 then
                        call MilimSpells___MilimTick_Off(0)
                    endif
                    call s__MilimSpells___MilimQKS_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction
        function s__MilimSpells___MilimQKS_MilimQ_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__MilimSpells___MilimQKS__allocate()
            set s__MilimSpells___MilimQKS_MUI_MilimQ=s__MilimSpells___MilimQKS_MUI_MilimQ + 1
            set s__MilimSpells___MilimQKS_m_MilimQ[s__MilimSpells___MilimQKS_MUI_MilimQ]=this
            set s__MilimSpells___MilimQKS_c[this]=NewC
            set s__MilimSpells___MilimQKS_td[this]=null
            set s__MilimSpells___MilimQKS_x[this]=NewX
            set s__MilimSpells___MilimQKS_y[this]=NewY
            set s__MilimSpells___MilimQKS_r[this]=0
            set s__MilimSpells___MilimQKS_r2[this]=0
            set s__MilimSpells___MilimQKS_r5[this]=0
            set s__MilimSpells___MilimQKS_k3[this]=0
            set s__MilimSpells___MilimQKS_r7[this]=MilimQ_Range
            set s__MilimSpells___MilimQKS_check[this]=0
            set s__MilimSpells___MilimQKS_move[this]=120
            set s__MilimSpells___MilimQKS_check2[this]=0
            call StartSpellUnit2(s__MilimSpells___MilimQKS_c[this])
            set s__MilimSpells___MilimQKS_g[this]=CreateGroup()
            set s__MilimSpells___MilimQKS_g2[this]=CreateGroup()
            set s__MilimSpells___MilimQKS_u[this]=null
            set s__MilimSpells___MilimQKS_a[this]=GAngle2(s__MilimSpells___MilimQKS_c[this] , s__MilimSpells___MilimQKS_x[this] , s__MilimSpells___MilimQKS_y[this]) // Angle Between points
            set s__MilimSpells___MilimQKS_aoe[this]=MilimQ_DamageAoe
            set s__MilimSpells___MilimQKS_dmg[this]=GetHeroAgi(s__MilimSpells___MilimQKS_c[this], true) * ( MilimQ_DamageAgiBase + ( MilimQ_DamageAgiStep * ( GetUnitAbilityLevel(s__MilimSpells___MilimQKS_c[this], MilimQ_ID) - 1 ) ) )
            set s__MilimSpells___MilimQKS_dmg[this]=s__MilimSpells___MilimQKS_dmg[this] + MilimQ_Damage2StaticBase + ( MilimQ_Damage2StaticStep * ( GetUnitAbilityLevel(s__MilimSpells___MilimQKS_c[this], MilimQ_ID) - 1 ) )
            set s__MilimSpells___MilimQKS_dmg[this]=s__MilimSpells___MilimQKS_dmg[this] + MilimQ_ThresholdAgiBonus * I2R(MilimG_GetThresholdCount(s__MilimSpells___MilimQKS_c[this])) * GetHeroAgi(s__MilimSpells___MilimQKS_c[this], true)
            if LoadInteger(hs, GetHandleId(s__MilimSpells___MilimQKS_c[this]), MilimSpells___SH_MODE_T) == 1 then
                set s__MilimSpells___MilimQKS_dmg[this]=s__MilimSpells___MilimQKS_dmg[this] + MilimT_DmgAdd * GetHeroAgi(s__MilimSpells___MilimQKS_c[this], true)
            endif
            set s__MilimSpells___MilimQKS_rmax[this]=2.1
            set s__MilimSpells___MilimQKS_e[this]=AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdx", s__MilimSpells___MilimQKS_c[this], "hand right")
            set s__MilimSpells___MilimQKS_e2[this]=AddSpecialEffectTarget("war3mapImported\\wos_file00001662.mdl", s__MilimSpells___MilimQKS_c[this], "hand right")
            set s__MilimSpells___MilimQKS_e3[this]=AddSpecialEffectTarget("war3mapimported\\wos_SlidingDustWithRocks.mdx", s__MilimSpells___MilimQKS_c[this], "origin")
                call SetUnitAnimationByIndex(s__MilimSpells___MilimQKS_c[this], 7)
                call SetUnitTimeScale(s__MilimSpells___MilimQKS_c[this], 1.5)
                call MakeSound("war3mapimported\\Hero_Milim_Q 1")
            if s__MilimSpells___MilimQKS_MUI_MilimQ == 0 then
                call MilimSpells___MilimTick_On(0)
            endif
        endfunction
   



    // h — ìàêñèìàëüíàÿ âûñîòà, d — äëèòåëüíîñòü, x — ïðîøåäøåå âðåìÿ.
    function s__MilimSpells___MilimWKS_Parabola takes real h,real d,real x returns real
        return ( 4.00 * h / d ) * ( d - x ) * ( x / d )
    endfunction

    function s__MilimSpells___MilimWKS_Loop_MilimW takes nothing returns nothing
        local integer this
        local integer i= 0
        local real currentX
        local real currentY

        loop
            exitwhen i > s__MilimSpells___MilimWKS_MUI_MilimW
            set this=s__MilimSpells___MilimWKS_m_MilimW[i]

            if SpellBoolCaster(s__MilimSpells___MilimWKS_c[this]) and s__MilimSpells___MilimWKS_r[this] < s__MilimSpells___MilimWKS_JUMP_DURATION then
                call DebugUnit2(s__MilimSpells___MilimWKS_c[this])
               // call BlzSetSpecialEffectYaw(e, a-180*bj_DEGTORAD)

                if s__MilimSpells___MilimWKS_delayElapsed[this] < s__MilimSpells___MilimWKS_JUMP_DELAY then
                    set s__MilimSpells___MilimWKS_delayElapsed[this]=s__MilimSpells___MilimWKS_delayElapsed[this] + s__MilimSpells___MilimWKS_TIMER_PERIOD
                    if s__MilimSpells___MilimWKS_delayElapsed[this] > s__MilimSpells___MilimWKS_JUMP_DELAY then
                        set s__MilimSpells___MilimWKS_delayElapsed[this]=s__MilimSpells___MilimWKS_JUMP_DELAY
                    endif
                    if s__MilimSpells___MilimWKS_delayElapsed[this] == 0.03 then
                    
        set s__MilimSpells___MilimWKS_e[this]=EffectSpawn("war3mapImported\\wos_tx-liuying03_pink3.mdl" , GetUnitX(s__MilimSpells___MilimWKS_c[this]) , GetUnitY(s__MilimSpells___MilimWKS_c[this]) , s__MilimSpells___MilimWKS_a[this] * bj_RADTODEG , 2.7 , 0.4 , 150 + s__MilimSpells___MilimWKS_EFFECT_Z_OFFSET)
        call BlzSetSpecialEffectPitch(s__MilimSpells___MilimWKS_e[this], - 180.00 * bj_DEGTORAD)
        call BlzSetSpecialEffectYaw(s__MilimSpells___MilimWKS_e[this], s__MilimSpells___MilimWKS_a[this])
      //  set delayElapsed = 999
                    endif
                    // Äî íà÷àëà ïðûæêà ýôôåêò îñòà¸òñÿ íà êàñòåðå.
                    //call BlzSetSpecialEffectPitch(e, -180.00 * bj_DEGTORAD)
                else
                    set s__MilimSpells___MilimWKS_r[this]=s__MilimSpells___MilimWKS_r[this] + s__MilimSpells___MilimWKS_TIMER_PERIOD
                    if s__MilimSpells___MilimWKS_r[this] > s__MilimSpells___MilimWKS_JUMP_DURATION then
                        set s__MilimSpells___MilimWKS_r[this]=s__MilimSpells___MilimWKS_JUMP_DURATION
                    endif

                    set s__MilimSpells___MilimWKS_progress[this]=s__MilimSpells___MilimWKS_r[this] / s__MilimSpells___MilimWKS_JUMP_DURATION
                    set currentX=s__MilimSpells___MilimWKS_startX[this] + ( s__MilimSpells___MilimWKS_x[this] - s__MilimSpells___MilimWKS_startX[this] ) * s__MilimSpells___MilimWKS_progress[this]
                    set currentY=s__MilimSpells___MilimWKS_startY[this] + ( s__MilimSpells___MilimWKS_y[this] - s__MilimSpells___MilimWKS_startY[this] ) * s__MilimSpells___MilimWKS_progress[this]
                    set s__MilimSpells___MilimWKS_f[this]=s__MilimSpells___MilimWKS_Parabola(s__MilimSpells___MilimWKS_JUMP_HEIGHT , s__MilimSpells___MilimWKS_JUMP_DURATION , s__MilimSpells___MilimWKS_r[this])

                    call PosUnit(s__MilimSpells___MilimWKS_c[this] , currentX , currentY)
                    call SetFly(s__MilimSpells___MilimWKS_c[this] , s__MilimSpells___MilimWKS_f[this])
                    if s__MilimSpells___MilimWKS_r[this] == s__MilimSpells___MilimWKS_JUMP_DURATION / 2 then
                    call DestroyEffect(s__MilimSpells___MilimWKS_e[this])
                    set s__MilimSpells___MilimWKS_e[this]=null
        set s__MilimSpells___MilimWKS_e[this]=EffectSpawn("war3mapImported\\wos_tx-liuying03_pink3.mdl" , GetUnitX(s__MilimSpells___MilimWKS_c[this]) , GetUnitY(s__MilimSpells___MilimWKS_c[this]) , s__MilimSpells___MilimWKS_a[this] * bj_RADTODEG , 1.5 , 0.5 , s__MilimSpells___MilimWKS_f[this] + s__MilimSpells___MilimWKS_EFFECT_Z_OFFSET)
                    endif
                    // Ïëàâíûé pitch îò -180 ãðàäóñîâ äî 0.
                    set s__MilimSpells___MilimWKS_effectProgress[this]=s__MilimSpells___MilimWKS_progress[this] //* progress * (3.00 - 2.00 * progress)
                // call BlzSetSpecialEffectPitch(e, (-180.00 * (1.00 - effectProgress)) * bj_DEGTORAD)

                    // Íà ïîäú¸ìå ýôôåêò íàõîäèòñÿ íàä êàñòåðîì, íà ñïóñêå — ïîä íèì.
                    if s__MilimSpells___MilimWKS_progress[this] <= 0.50 then
                     //   call BlzSetSpecialEffectPitch(e, (-180.00) * bj_DEGTORAD)
                       // call BJDebugMsg("1")
                        call BlzSetSpecialEffectPosition(s__MilimSpells___MilimWKS_e[this], GetUnitX(s__MilimSpells___MilimWKS_c[this]), GetUnitY(s__MilimSpells___MilimWKS_c[this]), s__MilimSpells___MilimWKS_f[this] + s__MilimSpells___MilimWKS_EFFECT_Z_OFFSET)
