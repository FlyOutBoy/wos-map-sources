                    set rr=RMinBJ(1.0, s__FrierenSpells__FrierenSpells_T2_mergeTime[this] / 0.5)
                    call BlzSetSpecialEffectScale(s__FrierenSpells__FrierenSpells_T2_e[this], ( 0.01 + 1.74 * RMinBJ(1.0, s__FrierenSpells__FrierenSpells_T2_r[this] / FrierenT2_GrowTime) ) * ( 1.0 - rr ) + 2.625 * rr)
                    call BlzSetSpecialEffectScale(s__FrierenSpells__FrierenSpells_T2_e2[this], ( 0.01 + 2.24 * RMinBJ(1.0, s__FrierenSpells__FrierenSpells_T2_r[this] / FrierenT2_GrowTime) ) * ( 1.0 - rr ) + 3.375 * rr)
