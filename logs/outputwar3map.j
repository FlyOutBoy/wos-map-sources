                        set s__PatriotSpells___PatriotSpells_T2_e2[this]=EffectSpawn("war3mapimported\\wos_Windwalk Black.mdx" , GetUnitX(s__PatriotSpells___PatriotSpells_T2_c[this]) + 150.0 * Cos(s__PatriotSpells___PatriotSpells_T2_a[this]) , GetUnitY(s__PatriotSpells___PatriotSpells_T2_c[this]) + 150.0 * Sin(s__PatriotSpells___PatriotSpells_T2_a[this]) , s__PatriotSpells___PatriotSpells_T2_a[this] * bj_RADTODEG , 0.65 , 2.0 , 125.0)
