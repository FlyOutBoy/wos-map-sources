                        set dx=GetUnitX(s__TojiSpells___TojiSpells_W_td[this]) - GetUnitX(s__TojiSpells___TojiSpells_W_c[this])
                        set dy=GetUnitY(s__TojiSpells___TojiSpells_W_td[this]) - GetUnitY(s__TojiSpells___TojiSpells_W_c[this])
                        set distance=SquareRoot(dx * dx + dy * dy)
                        if distance > TojiW_ChainMaxRange and GetUnitAbilityLevel(s__TojiSpells___TojiSpells_W_td[this], 'Avul') == 0 then
                            set angle=Atan2(dy, dx)
                            call PosUnit(s__TojiSpells___TojiSpells_W_td[this] , GetUnitX(s__TojiSpells___TojiSpells_W_c[this]) + TojiW_ChainMaxRange * Cos(angle) , GetUnitY(s__TojiSpells___TojiSpells_W_c[this]) + TojiW_ChainMaxRange * Sin(angle))
                        endif
                        call MoveLightningEx(s__TojiSpells___TojiSpells_W_chain[this], true, GetUnitX(s__TojiSpells___TojiSpells_W_c[this]), GetUnitY(s__TojiSpells___TojiSpells_W_c[this]), 110.0, GetUnitX(s__TojiSpells___TojiSpells_W_td[this]), GetUnitY(s__TojiSpells___TojiSpells_W_td[this]), 110.0)
                        if s__TojiSpells___TojiSpells_W_r[this] >= s__TojiSpells___TojiSpells_W_chainDuration[this] then
                            set remove=true
                        endif
                    endif

                elseif s__TojiSpells___TojiSpells_W_state[this] == 2 then
                    set dx=GetUnitX(s__TojiSpells___TojiSpells_W_c[this]) - s__TojiSpells___TojiSpells_W_x[this]
                    set dy=GetUnitY(s__TojiSpells___TojiSpells_W_c[this]) - s__TojiSpells___TojiSpells_W_y[this]
                    set distance=SquareRoot(dx * dx + dy * dy)
                    set step=s__TojiSpells___TojiSpells_W_move[this] + TojiW_ReturnMoveBonus
                    if distance <= step then
                        set remove=true
                    else
                        set angle=Atan2(dy, dx)
                        set s__TojiSpells___TojiSpells_W_x[this]=s__TojiSpells___TojiSpells_W_x[this] + step * Cos(angle)
                        set s__TojiSpells___TojiSpells_W_y[this]=s__TojiSpells___TojiSpells_W_y[this] + step * Sin(angle)
                        call BlzSetSpecialEffectPosition(s__TojiSpells___TojiSpells_W_e[this], s__TojiSpells___TojiSpells_W_x[this], s__TojiSpells___TojiSpells_W_y[this], 110.0)
                        call MoveLightningEx(s__TojiSpells___TojiSpells_W_chain[this], true, GetUnitX(s__TojiSpells___TojiSpells_W_c[this]), GetUnitY(s__TojiSpells___TojiSpells_W_c[this]), 110.0, s__TojiSpells___TojiSpells_W_x[this], s__TojiSpells___TojiSpells_W_y[this], 110.0)
                    endif

                elseif s__TojiSpells___TojiSpells_W_state[this] == 3 then
                    if s__TojiSpells___TojiSpells_W_td[this] == null or GetUnitTypeId(s__TojiSpells___TojiSpells_W_td[this]) == 0 or GetWidgetLife(s__TojiSpells___TojiSpells_W_td[this]) <= 0.405 or GetUnitAbilityLevel(s__TojiSpells___TojiSpells_W_td[this], TojiW_Debuff_ID) == 0 then
                        set remove=true
                    else
                        if not IsUnitPaused(s__TojiSpells___TojiSpells_W_td[this]) then
                            set s__TojiSpells___TojiSpells_W_r[this]=I2R(R2I(( s__TojiSpells___TojiSpells_W_r[this] + 0.03 ) * 1000.0 + 0.5)) / 1000.0
                        endif
                        set s__TojiSpells___TojiSpells_W_pullElapsed[this]=RoundReal(s__TojiSpells___TojiSpells_W_pullElapsed[this] + 0.03 , 3)
                        set step=s__TojiSpells___TojiSpells_W_pullMove[this]
                        if step > s__TojiSpells___TojiSpells_W_pullRemaining[this] then
                            set step=s__TojiSpells___TojiSpells_W_pullRemaining[this]
                        endif
                        if step > 0.0 and GetUnitAbilityLevel(s__TojiSpells___TojiSpells_W_td[this], 'Avul') == 0 then
                            call MoveUnit(s__TojiSpells___TojiSpells_W_td[this] , step , s__TojiSpells___TojiSpells_W_pullAngle[this])
                            set s__TojiSpells___TojiSpells_W_pullRemaining[this]=s__TojiSpells___TojiSpells_W_pullRemaining[this] - step
                        endif
                        
                        // Срабатывает один раз в момент завершения притягивания:
                        if s__TojiSpells___TojiSpells_W_pullElapsed[this] >= TojiW2_PullDuration or s__TojiSpells___TojiSpells_W_pullRemaining[this] <= 0.5 then
                            call DecorRemove(s__TojiSpells___TojiSpells_W_c[this] , GetUnitX(s__TojiSpells___TojiSpells_W_td[this]) , GetUnitY(s__TojiSpells___TojiSpells_W_td[this]) , 350 , TojiW2_DecorDamage)
                            set s__TojiSpells___TojiSpells_W_state[this]=1
                        endif

                        set dx=GetUnitX(s__TojiSpells___TojiSpells_W_td[this]) - GetUnitX(s__TojiSpells___TojiSpells_W_c[this])
                        set dy=GetUnitY(s__TojiSpells___TojiSpells_W_td[this]) - GetUnitY(s__TojiSpells___TojiSpells_W_c[this])
                        set distance=SquareRoot(dx * dx + dy * dy)
                        if distance > TojiW_ChainMaxRange then
                            set angle=Atan2(dy, dx)
                            call PosUnit(s__TojiSpells___TojiSpells_W_td[this] , GetUnitX(s__TojiSpells___TojiSpells_W_c[this]) + TojiW_ChainMaxRange * Cos(angle) , GetUnitY(s__TojiSpells___TojiSpells_W_c[this]) + TojiW_ChainMaxRange * Sin(angle))
                        endif
                        call MoveLightningEx(s__TojiSpells___TojiSpells_W_chain[this], true, GetUnitX(s__TojiSpells___TojiSpells_W_c[this]), GetUnitY(s__TojiSpells___TojiSpells_W_c[this]), 110.0, GetUnitX(s__TojiSpells___TojiSpells_W_td[this]), GetUnitY(s__TojiSpells___TojiSpells_W_td[this]), 110.0)
                        if s__TojiSpells___TojiSpells_W_r[this] >= s__TojiSpells___TojiSpells_W_chainDuration[this] then
                            set remove=true
                        endif
                    endif
                endif

                if remove then
                    call WOSUI___WUI_TestHeroProgress((s__TojiSpells___TojiSpells_W_c[this] ) , ( TojiW_ID ) , ( "Chain of a Thousand Miles" ) , (( 0.00 )*1.0) , (( 0.00 )*1.0) , ( true) , "") // INLINED!!
                    if s__TojiSpells___TojiSpells_W_c[this] != null then
                        call SetPlayerAbilityAvailable(GetOwningPlayer(s__TojiSpells___TojiSpells_W_c[this]), TojiW2_ID, false)
                        call SetPlayerAbilityAvailable(GetOwningPlayer(s__TojiSpells___TojiSpells_W_c[this]), TojiW_ID, true)
                    endif
                    if s__TojiSpells___TojiSpells_W_e[this] != null then
                        call DestroyEffect(s__TojiSpells___TojiSpells_W_e[this])
                    endif
                    if s__TojiSpells___TojiSpells_W_e2[this] != null then
                        call DestroyEffect(s__TojiSpells___TojiSpells_W_e2[this])
                    endif
                    if s__TojiSpells___TojiSpells_W_chain[this] != null then
                        call DestroyLightning(s__TojiSpells___TojiSpells_W_chain[this])
                    endif
                    if s__TojiSpells___TojiSpells_W_g[this] != null then
                        call DestroyGroup(s__TojiSpells___TojiSpells_W_g[this])
                    endif
                    set s__TojiSpells___TojiSpells_W_e[this]=null
                    set s__TojiSpells___TojiSpells_W_e2[this]=null
                    set s__TojiSpells___TojiSpells_W_chain[this]=null
                    set s__TojiSpells___TojiSpells_W_g[this]=null
                    set s__TojiSpells___TojiSpells_W_td[this]=null
                    set s__TojiSpells___TojiSpells_W_c[this]=null
                    call s__TojiSpells___TojiSpells_W_deallocate(this)
                    set s__TojiSpells___TojiSpells_W_m_TojiW[i]=s__TojiSpells___TojiSpells_W_m_TojiW[s__TojiSpells___TojiSpells_W_MUI_TojiW]
                    set s__TojiSpells___TojiSpells_W_MUI_TojiW=s__TojiSpells___TojiSpells_W_MUI_TojiW - 1
                    if s__TojiSpells___TojiSpells_W_MUI_TojiW == - 1 then
                        call TojiSpells___TojiTimer03Release()
                    endif
                else
                    if s__TojiSpells___TojiSpells_W_state[this] == 1 or s__TojiSpells___TojiSpells_W_state[this] == 3 then
                        call WOSUI___WUI_TestHeroProgress((s__TojiSpells___TojiSpells_W_c[this] ) , ( TojiW_ID ) , ( "Chain of a Thousand Miles" ) , (( s__TojiSpells___TojiSpells_W_chainDuration[this] - s__TojiSpells___TojiSpells_W_r[this] )*1.0) , (( s__TojiSpells___TojiSpells_W_chainDuration[this] )*1.0) , ( true) , "") // INLINED!!
                    endif
                    set i=i + 1
                endif
            endloop
            set picked=null
        endfunction

        function s__TojiSpells___TojiSpells_W_TojiW_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__TojiSpells___TojiSpells_W__allocate()
            set s__TojiSpells___TojiSpells_W_MUI_TojiW=s__TojiSpells___TojiSpells_W_MUI_TojiW + 1
            set s__TojiSpells___TojiSpells_W_m_TojiW[s__TojiSpells___TojiSpells_W_MUI_TojiW]=this
            set s__TojiSpells___TojiSpells_W_c[this]=NewC
            set s__TojiSpells___TojiSpells_W_td[this]=null
            set s__TojiSpells___TojiSpells_W_g[this]=CreateGroup()
            set s__TojiSpells___TojiSpells_W_state[this]=0
            set s__TojiSpells___TojiSpells_W_level[this]=GetUnitAbilityLevel(NewC, TojiW_ID)
            if s__TojiSpells___TojiSpells_W_level[this] < 1 then
                set s__TojiSpells___TojiSpells_W_level[this]=1
            endif
            set s__TojiSpells___TojiSpells_W_a[this]=GAngle2(NewC , NewX , NewY)
            set s__TojiSpells___TojiSpells_W_x[this]=GetUnitX(NewC) + 75.0 * Cos(s__TojiSpells___TojiSpells_W_a[this])
            set s__TojiSpells___TojiSpells_W_y[this]=GetUnitY(NewC) + 75.0 * Sin(s__TojiSpells___TojiSpells_W_a[this])
            set s__TojiSpells___TojiSpells_W_r[this]=0.0
            set s__TojiSpells___TojiSpells_W_r6[this]=0.0
            set s__TojiSpells___TojiSpells_W_r7[this]=TojiW_RangeBase + TojiW_RangeStep * ( s__TojiSpells___TojiSpells_W_level[this] - 1 )
            set s__TojiSpells___TojiSpells_W_move[this]=TojiW_MoveBase + TojiW_MoveStep * ( s__TojiSpells___TojiSpells_W_level[this] - 1 )
            set s__TojiSpells___TojiSpells_W_dmg[this]=GetHeroAgi(NewC, true) * ( TojiW_DamageAgiBase + TojiW_DamageAgiStep * ( s__TojiSpells___TojiSpells_W_level[this] - 1 ) )
            set s__TojiSpells___TojiSpells_W_dmg[this]=s__TojiSpells___TojiSpells_W_dmg[this] + TojiW_Damage2StaticBase + TojiW_Damage2StaticStep * ( s__TojiSpells___TojiSpells_W_level[this] - 1 )
            set s__TojiSpells___TojiSpells_W_dmg[this]=s__TojiSpells___TojiSpells_W_dmg[this] + TojiSpells___TojiE_ConsumeLeapBonus(NewC)
            call MakeSound("war3mapimported\\Hero_Toji_W 1")
            set s__TojiSpells___TojiSpells_W_tdMoveSpeed[this]=0.0
            set s__TojiSpells___TojiSpells_W_tdSlowSpeed[this]=0.0
            set s__TojiSpells___TojiSpells_W_e2[this]=null
            set s__TojiSpells___TojiSpells_W_pullAngle[this]=0.0
            set s__TojiSpells___TojiSpells_W_pullMove[this]=0.0
            set s__TojiSpells___TojiSpells_W_pullRemaining[this]=0.0
            set s__TojiSpells___TojiSpells_W_pullElapsed[this]=0.0
            set s__TojiSpells___TojiSpells_W_e[this]=AddSpecialEffect("war3mapImported\\wos_hook1.mdl", s__TojiSpells___TojiSpells_W_x[this], s__TojiSpells___TojiSpells_W_y[this])
            call BlzSetSpecialEffectScale(s__TojiSpells___TojiSpells_W_e[this], 2.10)
            call BlzSetSpecialEffectYaw(s__TojiSpells___TojiSpells_W_e[this], s__TojiSpells___TojiSpells_W_a[this])
            call BlzSetSpecialEffectZ(s__TojiSpells___TojiSpells_W_e[this], 110.0)
            set s__TojiSpells___TojiSpells_W_chain[this]=AddLightningEx("TJ01", true, GetUnitX(NewC), GetUnitY(NewC), 110.0, s__TojiSpells___TojiSpells_W_x[this], s__TojiSpells___TojiSpells_W_y[this], 110.0)
            call SetUnitFacing(NewC, s__TojiSpells___TojiSpells_W_a[this] * bj_RADTODEG)
            call SetUnitAnimationByIndex(NewC, 13)
            call MakeSound("war3mapImported\\Hero_Toji_W")
            call VisionTimed(GetOwningPlayer(NewC) , NewX , NewY , 750 , 6)
            if s__TojiSpells___TojiSpells_W_MUI_TojiW == 0 then
                call TojiSpells___TojiTimer03Acquire()
            endif
        endfunction

        function s__TojiSpells___TojiSpells_W_TojiW2_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer i= 0
            local integer this
            local real casterX
            local real casterY
            local real targetX
            local real targetY
            local real baseAngle
            local real difference
            local real distance
            local real inward
            local real sideAngle
            local real pullDistance
            local integer pid
            local real tojiDx
            local real tojiDy
            loop
                exitwhen i > s__TojiSpells___TojiSpells_W_MUI_TojiW
                set this=s__TojiSpells___TojiSpells_W_m_TojiW[i]
                if s__TojiSpells___TojiSpells_W_c[this] == NewC and s__TojiSpells___TojiSpells_W_state[this] == 1 then
                    set casterX=GetUnitX(NewC)
                    set casterY=GetUnitY(NewC)
                    set targetX=GetUnitX(s__TojiSpells___TojiSpells_W_td[this])
                    set targetY=GetUnitY(s__TojiSpells___TojiSpells_W_td[this])
                    set baseAngle=Atan2(targetY - casterY, targetX - casterX)
                    set difference=( NewX - targetX ) * Cos(baseAngle + bj_PI * 0.5) + ( NewY - targetY ) * Sin(baseAngle + bj_PI * 0.5)
                    set distance=SquareRoot(( targetX - casterX ) * ( targetX - casterX ) + ( targetY - casterY ) * ( targetY - casterY ))
                    if difference <= TojiW2_SideClickDeadzone and difference >= - TojiW2_SideClickDeadzone then
                        set inward=TojiW2_CenterPullRange
                        if inward > distance - 125.0 then
                            set inward=distance - 125.0
                        endif
                        if inward < 0.0 then
                            set inward=0.0
                        endif
                        set s__TojiSpells___TojiSpells_W_pullX[this]=targetX + inward * Cos(baseAngle + bj_PI)
                        set s__TojiSpells___TojiSpells_W_pullY[this]=targetY + inward * Sin(baseAngle + bj_PI)
                    else
                        set inward=TojiW2_SideInwardRange
                        if inward > distance - 125.0 then
                            set inward=distance - 125.0
                        endif
                        if inward < 0.0 then
                            set inward=0.0
                        endif
                        if difference > 0.0 then
                            set sideAngle=baseAngle + bj_PI * 0.5
                        else
                            set sideAngle=baseAngle - bj_PI * 0.5
                        endif
                        set s__TojiSpells___TojiSpells_W_pullX[this]=targetX + TojiW2_SidePullRange * Cos(sideAngle) + inward * Cos(baseAngle + bj_PI)
                        set s__TojiSpells___TojiSpells_W_pullY[this]=targetY + TojiW2_SidePullRange * Sin(sideAngle) + inward * Sin(baseAngle + bj_PI)
                    endif
                    set pullDistance=SquareRoot(( s__TojiSpells___TojiSpells_W_pullX[this] - targetX ) * ( s__TojiSpells___TojiSpells_W_pullX[this] - targetX ) + ( s__TojiSpells___TojiSpells_W_pullY[this] - targetY ) * ( s__TojiSpells___TojiSpells_W_pullY[this] - targetY ))
                    set s__TojiSpells___TojiSpells_W_pullAngle[this]=Atan2(s__TojiSpells___TojiSpells_W_pullY[this] - targetY, s__TojiSpells___TojiSpells_W_pullX[this] - targetX)
                    set s__TojiSpells___TojiSpells_W_pullRemaining[this]=pullDistance
                    set s__TojiSpells___TojiSpells_W_pullElapsed[this]=0.0
                    if TojiW2_PullDuration > 0.03 then
                        set s__TojiSpells___TojiSpells_W_pullMove[this]=pullDistance / ( TojiW2_PullDuration / 0.03 )
                    else
                        set s__TojiSpells___TojiSpells_W_pullMove[this]=pullDistance
                    endif
                    if s__TojiSpells___TojiSpells_W_pullMove[this] < 0.0 then
                        set s__TojiSpells___TojiSpells_W_pullMove[this]=0.0
                    endif
                    set s__TojiSpells___TojiSpells_W_state[this]=3
                    call MakeSound("war3mapImported\\Hero_Toji_W2 1")

                    // Возобновление движения на бегу
                    set pid=GetPlayerId(GetOwningPlayer(NewC))
                    set tojiDx=TojiSpells___Toji_LastOrderX[pid] - casterX
                    set tojiDy=TojiSpells___Toji_LastOrderY[pid] - casterY
                    if TojiSpells___Toji_IsMoving[pid] and ( tojiDx * tojiDx + tojiDy * tojiDy > 100.0 * 100.0 ) then
                        call IssuePointOrder(NewC, "move", TojiSpells___Toji_LastOrderX[pid], TojiSpells___Toji_LastOrderY[pid])
                    endif

                    set i=s__TojiSpells___TojiSpells_W_MUI_TojiW + 1
                else
                    set i=i + 1
                endif
            endloop
        endfunction



        function s__TojiSpells___TojiSpells_E_Loop_TojiE takes nothing returns nothing
            local integer i= 0
            local integer this
            local unit target
            local real step
            local boolean remove
            loop
                exitwhen i > s__TojiSpells___TojiSpells_E_MUI_TojiE
                set this=s__TojiSpells___TojiSpells_E_m_TojiE[i]
                set remove=false

                if s__TojiSpells___TojiSpells_E_c[this] == null or GetUnitTypeId(s__TojiSpells___TojiSpells_E_c[this]) == 0 or GetWidgetLife(s__TojiSpells___TojiSpells_E_c[this]) <= 0.405 then
                    set remove=true
                elseif s__TojiSpells___TojiSpells_E_traveled[this] < s__TojiSpells___TojiSpells_E_distance[this] then
                    set step=s__TojiSpells___TojiSpells_E_move[this]
                    if s__TojiSpells___TojiSpells_E_r2[this] > 0.0 then
                        set s__TojiSpells___TojiSpells_E_r2[this]=0.0
                        call DecorRemove(s__TojiSpells___TojiSpells_E_c[this] , GetUnitX(s__TojiSpells___TojiSpells_E_c[this]) , GetUnitY(s__TojiSpells___TojiSpells_E_c[this]) , TojiE_HitAoe , TojiE_DecorDamage)
                    else
                        set s__TojiSpells___TojiSpells_E_r2[this]=s__TojiSpells___TojiSpells_E_r2[this] + 0.03
                    endif
                    call MoveUnit(s__TojiSpells___TojiSpells_E_c[this] , step , s__TojiSpells___TojiSpells_E_a[this])
                    call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_blackblink.mdx" , GetUnitX(s__TojiSpells___TojiSpells_E_c[this]) , GetUnitY(s__TojiSpells___TojiSpells_E_c[this]) , s__TojiSpells___TojiSpells_E_a[this] * bj_RADTODEG + 90 , 3 , 1.35 , GetUnitFlyHeight(s__TojiSpells___TojiSpells_E_c[this]) , 0 , 0 , 0 , 255))
                    set s__TojiSpells___TojiSpells_E_traveled[this]=s__TojiSpells___TojiSpells_E_traveled[this] + step
                    call BlzSetSpecialEffectPosition(s__TojiSpells___TojiSpells_E_e[this], GetUnitX(s__TojiSpells___TojiSpells_E_c[this]), GetUnitY(s__TojiSpells___TojiSpells_E_c[this]), 50.0)

                    if s__TojiSpells___TojiSpells_E_level25[this] then
                        call GroupClear(s__TojiSpells___TojiSpells_E_scanGroup[this])
                        call GroupEnumUnitsInRange(s__TojiSpells___TojiSpells_E_scanGroup[this], GetUnitX(s__TojiSpells___TojiSpells_E_c[this]), GetUnitY(s__TojiSpells___TojiSpells_E_c[this]), TojiE_HitAoe, NoDecor_Cond)
                        loop
                            set target=FirstOfGroup(s__TojiSpells___TojiSpells_E_scanGroup[this])
                            exitwhen target == null
                            call GroupRemoveUnit(s__TojiSpells___TojiSpells_E_scanGroup[this], target)
                            if IsUnitEnemy(target, GetOwningPlayer(s__TojiSpells___TojiSpells_E_c[this])) and SpellBool(target) and not IsUnitInGroup(target, s__TojiSpells___TojiSpells_E_hitGroup[this]) then
                                call GroupAddUnit(s__TojiSpells___TojiSpells_E_hitGroup[this], target)
                                set GearDamageNextSource=('A0H3') // INLINED!!
                                call dmgphys(s__TojiSpells___TojiSpells_E_c[this] , target , TojiSpells___TojiAbilityDamage(s__TojiSpells___TojiSpells_E_c[this] , target , s__TojiSpells___TojiSpells_E_attackDamage[this]))
                                call MUE(target , TojiE_Level25ThrowRange , TojiE_Level25ThrowDuration , s__TojiSpells___TojiSpells_E_a[this])
                                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", target, "chest"))
                            endif
                        endloop
                    endif
                    if s__TojiSpells___TojiSpells_E_traveled[this] >= s__TojiSpells___TojiSpells_E_distance[this] then
                        set remove=true
                    endif
                else
                    set remove=true
                endif

                if remove then
                    if s__TojiSpells___TojiSpells_E_c[this] != null then
                        call SetUnitTimeScale(s__TojiSpells___TojiSpells_E_c[this], 1.0)
                    endif
                    if s__TojiSpells___TojiSpells_E_e[this] != null then
                        call DestroyEffect(s__TojiSpells___TojiSpells_E_e[this])
                    endif
                    call DestroyGroup(s__TojiSpells___TojiSpells_E_scanGroup[this])
                    call DestroyGroup(s__TojiSpells___TojiSpells_E_hitGroup[this])
                    set s__TojiSpells___TojiSpells_E_e[this]=null
                    set s__TojiSpells___TojiSpells_E_scanGroup[this]=null
                    set s__TojiSpells___TojiSpells_E_hitGroup[this]=null
                    set s__TojiSpells___TojiSpells_E_c[this]=null
                    set target=null
                    call s__TojiSpells___TojiSpells_E_deallocate(this)
                    set s__TojiSpells___TojiSpells_E_m_TojiE[i]=s__TojiSpells___TojiSpells_E_m_TojiE[s__TojiSpells___TojiSpells_E_MUI_TojiE]
                    set s__TojiSpells___TojiSpells_E_MUI_TojiE=s__TojiSpells___TojiSpells_E_MUI_TojiE - 1
                    if s__TojiSpells___TojiSpells_E_MUI_TojiE == - 1 then
                        call TojiSpells___TojiTimer03Release()
                    endif
                else
                    set i=i + 1
                endif
            endloop
            set target=null
        endfunction

        function s__TojiSpells___TojiSpells_E_InitCharges takes unit whichUnit returns nothing
            local integer abilityLevel= GetUnitAbilityLevel(whichUnit, TojiE_ID)
            local real recharge
            if abilityLevel < 1 then
                set abilityLevel=1
            elseif abilityLevel > 5 then
                set abilityLevel=5
            endif
            set recharge=TojiE_RechargeBase - TojiE_RechargeStep * ( abilityLevel - 1 )
            call s__KS_SpellStacks_MyAddSpellStacks_Start((whichUnit ) , ( TojiE_ID ) , ( 0 ) , ( TojiE_MaxCharges ) , (( recharge)*1.0)) // INLINED!!
        endfunction

        function s__TojiSpells___TojiSpells_E_TojiE_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer abilityLevel= GetUnitAbilityLevel(NewC, TojiE_ID)
            local integer diceCount
            local integer diceSides
            local integer dice= 0
            local real startX= GetUnitX(NewC)
            local real startY= GetUnitY(NewC)
            local real dx= NewX - startX
            local real dy= NewY - startY
            local real targetDistance= SquareRoot(dx * dx + dy * dy)
            local real maxDistance
            local integer this
            
            if abilityLevel < 1 then
                set abilityLevel=1
            endif
            set maxDistance=TojiE_RangeBase + TojiE_RangeStep * ( abilityLevel - 1 )
            set targetDistance=maxDistance
            call s__TojiSpells___TojiSpells_E_InitCharges(NewC)
            if (LoadInteger(hs, GetHandleId(((NewC))), GearSystems2___SH_STACK_COUNT)) <= 0 and BlzGetUnitAbilityCooldownRemaining(NewC, TojiE_ID) <= 0.00 then // INLINED!!
                call s__KS_SpellStacks_AddStacks((NewC ) , ( 1)) // INLINED!!
            endif
            if not SpellStacksTryUse(NewC) then
                return
            endif

            if targetDistance <= 1.0 then
                if GetHeroLevel(NewC) >= 25 then
                    call TojiSpells___TojiE_AddLeapBuff(NewC)
                endif
                return
            endif

            set this=s__TojiSpells___TojiSpells_E__allocate()
            set s__TojiSpells___TojiSpells_E_MUI_TojiE=s__TojiSpells___TojiSpells_E_MUI_TojiE + 1
            set s__TojiSpells___TojiSpells_E_m_TojiE[s__TojiSpells___TojiSpells_E_MUI_TojiE]=this
            set s__TojiSpells___TojiSpells_E_c[this]=NewC
            set s__TojiSpells___TojiSpells_E_scanGroup[this]=CreateGroup()
            set s__TojiSpells___TojiSpells_E_hitGroup[this]=CreateGroup()
            set s__TojiSpells___TojiSpells_E_a[this]=Atan2(dy, dx)
            set s__TojiSpells___TojiSpells_E_traveled[this]=0.0
            call ColorDummy32(s__TojiSpells___TojiSpells_E_c[this] , 0 , 255 , 255 , 255 , 0.15)
            call ColorDummy4(s__TojiSpells___TojiSpells_E_c[this] , 0.3 , 255 , 255 , 255 , 0.15)
            set s__TojiSpells___TojiSpells_E_distance[this]=targetDistance
            if TojiE_DashDuration > 0.03 then
                set s__TojiSpells___TojiSpells_E_move[this]=targetDistance / ( TojiE_DashDuration / 0.03 )
            else
                set s__TojiSpells___TojiSpells_E_move[this]=targetDistance
            endif
            if s__TojiSpells___TojiSpells_E_move[this] < 1.0 then
                set s__TojiSpells___TojiSpells_E_move[this]=1.0
            endif
            set s__TojiSpells___TojiSpells_E_level25[this]=GetHeroLevel(NewC) >= 25
            set s__TojiSpells___TojiSpells_E_attackDamage[this]=0.0
            if s__TojiSpells___TojiSpells_E_level25[this] then
                set diceCount=BlzGetUnitDiceNumber(NewC, 0)
                set diceSides=BlzGetUnitDiceSides(NewC, 0)
                set s__TojiSpells___TojiSpells_E_attackDamage[this]=I2R(BlzGetUnitBaseDamage(NewC, 0))
                loop
                    exitwhen dice >= diceCount
                    set s__TojiSpells___TojiSpells_E_attackDamage[this]=s__TojiSpells___TojiSpells_E_attackDamage[this] + GetRandomInt(1, diceSides)
                    set dice=dice + 1
                endloop
                set s__TojiSpells___TojiSpells_E_attackDamage[this]=s__TojiSpells___TojiSpells_E_attackDamage[this] * ( TojiE_Level25DamageAtk / 100.00 ) + GetHeroAgi(NewC, true) * TojiE_Level25DamageAgi
                call TojiSpells___TojiE_AddLeapBuff(NewC)
            endif
            
            call BlzSetUnitFacingEx(s__TojiSpells___TojiSpells_E_c[this], s__TojiSpells___TojiSpells_E_a[this] * bj_RADTODEG)
            call SetUnitAnimationByIndex(NewC, 4)
            call s__GearSystems2___KS_RemoveUnit_MyRemoveUnit_Start((s__TojiSpells___TojiSpells_E_c[this] ) , (( 0.03 )*1.0) , 2 , - 1 , ( 4) , "") // INLINED!!
            call SetUnitTimeScale(NewC, 2.0)
            set s__TojiSpells___TojiSpells_E_e[this]=AddSpecialEffectTarget("war3mapimported\\wos_Windwalk Black.mdx", s__TojiSpells___TojiSpells_E_c[this], "origin")
            if IntegerCdKey(s__TojiSpells___TojiSpells_E_c[this] , SH_ICD_SOUND_E_CD , 10) then
                if GetRandomInt(1, 2) == 1 then
                    call MakeSound("war3mapimported\\Hero_Toji_E3")
                else
                    call MakeSound("war3mapimported\\Hero_Toji_E4")
                endif
            endif
            if GetRandomInt(1, 2) == 1 then
                call MakeSound("war3mapimported\\Hero_Toji_E")
            else
                call MakeSound("war3mapimported\\Hero_Toji_E2")
            endif
            if s__TojiSpells___TojiSpells_E_MUI_TojiE == 0 then
                call TojiSpells___TojiTimer03Acquire()
            endif
        endfunction

        // Duration meter (same WOSHeroMeter window as Gojo E), one per player.


        function s__TojiSpells___TojiSpells_R_Insectoids_Loop_TojiRI takes nothing returns nothing
            local integer i= 0
            local integer n
            local integer hid
            local integer invisLevel
            local integer this
            local unit target
            local effect mosquito
            local group swapGroup
            local real progress
            local real targetX
            local real targetY
            local real targetZ
            local real moveX
            local real moveY
            local real moveZ
            local real moveAngle
            local real moveDistance
            local real moveStart
            local real boundaryDistance
            local real dx
            local real dy
            local real damage
            local boolean inside
            local boolean hit
            local boolean remove
            loop
                exitwhen i > s__TojiSpells___TojiSpells_R_Insectoids_MUI_TojiRI
                set this=s__TojiSpells___TojiSpells_R_Insectoids_m_TojiRI[i]
                set remove=false

                if s__TojiSpells___TojiSpells_R_Insectoids_c[this] == null or GetUnitTypeId(s__TojiSpells___TojiSpells_R_Insectoids_c[this]) == 0 then
                    set remove=true
                else
                    set s__TojiSpells___TojiSpells_R_Insectoids_elapsed[this]=RoundReal(s__TojiSpells___TojiSpells_R_Insectoids_elapsed[this] + 0.03 , 3)

                    if s__TojiSpells___TojiSpells_R_Insectoids_elapsed[this] <= 0.80 then
                        set progress=s__TojiSpells___TojiSpells_R_Insectoids_elapsed[this] / 0.80
                        if progress > 1.0 then
                            set progress=1.0
                        endif
                        set n=0
                        loop
                            exitwhen n >= 48
                            set mosquito=LoadEffectHandle(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], n)
                            set targetX=LoadReal(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 1000 + n)
                            set targetY=LoadReal(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 2000 + n)
                            set targetZ=LoadReal(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 3000 + n)
                            if mosquito != null then
                                call BlzSetSpecialEffectPosition(mosquito, s__TojiSpells___TojiSpells_R_Insectoids_startX[this] + ( targetX - s__TojiSpells___TojiSpells_R_Insectoids_startX[this] ) * progress, s__TojiSpells___TojiSpells_R_Insectoids_startY[this] + ( targetY - s__TojiSpells___TojiSpells_R_Insectoids_startY[this] ) * progress, 70.0 + ( targetZ - 70.0 ) * progress)
                            endif
                            set n=n + 1
                        endloop
                    else
                        set n=0
                        loop
                            exitwhen n >= 48
                            set mosquito=LoadEffectHandle(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], n)
                            if mosquito != null then
                                if LoadInteger(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 12000 + n) == 0 and s__TojiSpells___TojiSpells_R_Insectoids_elapsed[this] >= LoadReal(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 4000 + n) then
                                    set targetX=LoadReal(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 1000 + n)
                                    set targetY=LoadReal(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 2000 + n)
                                    set targetZ=LoadReal(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 3000 + n)
                                    set moveAngle=GetRandomReal(0.0, 2.0 * bj_PI)
                                    set moveDistance=GetRandomReal(150.0, 550.0)
                                    set moveX=targetX + moveDistance * Cos(moveAngle)
                                    set moveY=targetY + moveDistance * Sin(moveAngle)

                                    set dx=moveX - s__TojiSpells___TojiSpells_R_Insectoids_centerX[this]
                                    set dy=moveY - s__TojiSpells___TojiSpells_R_Insectoids_centerY[this]
                                    set boundaryDistance=SquareRoot(dx * dx + dy * dy)
                                    if boundaryDistance > TojiR_Aoe + 135.0 then
                                        set moveAngle=Atan2(s__TojiSpells___TojiSpells_R_Insectoids_centerY[this] - targetY, s__TojiSpells___TojiSpells_R_Insectoids_centerX[this] - targetX) + GetRandomReal(- 0.75, 0.75)
                                        set moveX=targetX + moveDistance * Cos(moveAngle)
                                        set moveY=targetY + moveDistance * Sin(moveAngle)
                                        set dx=moveX - s__TojiSpells___TojiSpells_R_Insectoids_centerX[this]
                                        set dy=moveY - s__TojiSpells___TojiSpells_R_Insectoids_centerY[this]
                                        set boundaryDistance=SquareRoot(dx * dx + dy * dy)
                                        if boundaryDistance > TojiR_Aoe + 135.0 then
                                            set moveX=s__TojiSpells___TojiSpells_R_Insectoids_centerX[this] + dx * ( ( TojiR_Aoe + 135.0 ) / boundaryDistance )
                                            set moveY=s__TojiSpells___TojiSpells_R_Insectoids_centerY[this] + dy * ( ( TojiR_Aoe + 135.0 ) / boundaryDistance )
                                        endif
                                    endif

                                    set moveZ=GetRandomReal(40.0, 280.0)

                                    call SaveReal(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 5000 + n, targetX)
                                    call SaveReal(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 6000 + n, targetY)
                                    call SaveReal(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 7000 + n, targetZ)
                                    call SaveReal(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 8000 + n, moveX)
                                    call SaveReal(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 9000 + n, moveY)
                                    call SaveReal(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 10000 + n, moveZ)
                                    call SaveReal(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 11000 + n, s__TojiSpells___TojiSpells_R_Insectoids_elapsed[this])
                                    call SaveReal(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 4000 + n, s__TojiSpells___TojiSpells_R_Insectoids_elapsed[this] + GetRandomReal(0.81, 1.02))
                                    call SaveInteger(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 12000 + n, 1)
                                    call BlzSetSpecialEffectYaw(mosquito, Atan2(moveY - targetY, moveX - targetX))
                                endif

                                if LoadInteger(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 12000 + n) == 1 then
                                    set targetX=LoadReal(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 5000 + n)
                                    set targetY=LoadReal(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 6000 + n)
                                    set targetZ=LoadReal(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 7000 + n)
                                    set moveX=LoadReal(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 8000 + n)
                                    set moveY=LoadReal(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 9000 + n)
                                    set moveZ=LoadReal(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 10000 + n)
                                    set moveStart=LoadReal(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 11000 + n)
                                    set progress=( s__TojiSpells___TojiSpells_R_Insectoids_elapsed[this] - moveStart ) / 0.81
                                    if progress >= 1.0 then
                                        set progress=1.0
                                        call SaveReal(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 1000 + n, moveX)
                                        call SaveReal(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 2000 + n, moveY)
                                        call SaveReal(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 3000 + n, moveZ)
                                        call SaveInteger(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 12000 + n, 0)
                                    endif
                                    call BlzSetSpecialEffectPosition(mosquito, targetX + ( moveX - targetX ) * progress, targetY + ( moveY - targetY ) * progress, targetZ + ( moveZ - targetZ ) * progress)
                                endif
                            endif
                            set n=n + 1
                        endloop

                        set s__TojiSpells___TojiSpells_R_Insectoids_scanClock[this]=RoundReal(s__TojiSpells___TojiSpells_R_Insectoids_scanClock[this] + 0.03 , 3)
                        set s__TojiSpells___TojiSpells_R_Insectoids_damageClock[this]=RoundReal(s__TojiSpells___TojiSpells_R_Insectoids_damageClock[this] + 0.03 , 3)
                        set inside=false
                        if GetWidgetLife(s__TojiSpells___TojiSpells_R_Insectoids_c[this]) > 0.405 then
                            set dx=GetUnitX(s__TojiSpells___TojiSpells_R_Insectoids_c[this]) - s__TojiSpells___TojiSpells_R_Insectoids_centerX[this]
                            set dy=GetUnitY(s__TojiSpells___TojiSpells_R_Insectoids_c[this]) - s__TojiSpells___TojiSpells_R_Insectoids_centerY[this]
                            set inside=dx * dx + dy * dy <= TojiR_Aoe * TojiR_Aoe
                        endif

                        if inside then
                            set s__TojiSpells___TojiSpells_R_Insectoids_casterInside[this]=true
                            call UnitRemoveAbility(s__TojiSpells___TojiSpells_R_Insectoids_c[this], TojiR_SlowBuff_ID)
                            call UnitRemoveAbility(s__TojiSpells___TojiSpells_R_Insectoids_c[this], 'B01B')
                            call UnitRemoveAbility(s__TojiSpells___TojiSpells_R_Insectoids_c[this], 'B01A')
                            call UnitRemoveAbility(s__TojiSpells___TojiSpells_R_Insectoids_c[this], 'B01C')
                            call UnitRemoveAbility(s__TojiSpells___TojiSpells_R_Insectoids_c[this], 'B019')
                            call UnitRemoveAbility(s__TojiSpells___TojiSpells_R_Insectoids_c[this], 'B00T')
                            if not s__TojiSpells___TojiSpells_R_Insectoids_invisPrepared[this] then
                                set invisLevel=GetUnitAbilityLevel(s__TojiSpells___TojiSpells_R_Insectoids_c[this], TojiR_InvisAbility2_ID)
                                if invisLevel == 0 then
                                    call UnitAddAbility(s__TojiSpells___TojiSpells_R_Insectoids_c[this], TojiR_InvisAbility2_ID)
                                    call UnitMakeAbilityPermanent(s__TojiSpells___TojiSpells_R_Insectoids_c[this], true, TojiR_InvisAbility2_ID)
                                    call SetPlayerAbilityAvailable(GetOwningPlayer(s__TojiSpells___TojiSpells_R_Insectoids_c[this]), TojiR_InvisAbility2_ID, true)
                                    set s__TojiSpells___TojiSpells_R_Insectoids_invisAdded[this]=true
                                endif
                                set s__TojiSpells___TojiSpells_R_Insectoids_invisPrepared[this]=true
                            endif
                            
                            if GetUnitAbilityLevel(s__TojiSpells___TojiSpells_R_Insectoids_c[this], TojiR_InvisBuff_ID) == 0 then
                                call SetPlayerAbilityAvailable(GetOwningPlayer(s__TojiSpells___TojiSpells_R_Insectoids_c[this]), TojiR_InvisAbility2_ID, true)
                                call IssueImmediateOrder(s__TojiSpells___TojiSpells_R_Insectoids_c[this], "windwalk")
                            else
                                call SetPlayerAbilityAvailable(GetOwningPlayer(s__TojiSpells___TojiSpells_R_Insectoids_c[this]), TojiR_InvisAbility2_ID, false)
                            endif
                        elseif s__TojiSpells___TojiSpells_R_Insectoids_casterInside[this] then
                            set s__TojiSpells___TojiSpells_R_Insectoids_casterInside[this]=false
                            call UnitRemoveAbility(s__TojiSpells___TojiSpells_R_Insectoids_c[this], TojiR_InvisBuff_ID)
                            if s__TojiSpells___TojiSpells_R_Insectoids_invisAdded[this] then
                                call UnitRemoveAbility(s__TojiSpells___TojiSpells_R_Insectoids_c[this], TojiR_InvisAbility2_ID)
                                set s__TojiSpells___TojiSpells_R_Insectoids_invisAdded[this]=false
                            else
                                call SetPlayerAbilityAvailable(GetOwningPlayer(s__TojiSpells___TojiSpells_R_Insectoids_c[this]), TojiR_InvisAbility2_ID, true)
                            endif
                            set s__TojiSpells___TojiSpells_R_Insectoids_invisPrepared[this]=false
                        endif

                        if s__TojiSpells___TojiSpells_R_Insectoids_scanClock[this] >= 0.12 then
                            set s__TojiSpells___TojiSpells_R_Insectoids_scanClock[this]=RoundReal(s__TojiSpells___TojiSpells_R_Insectoids_scanClock[this] - 0.12 , 3)
                            call GroupClear(s__TojiSpells___TojiSpells_R_Insectoids_scanGroup[this])
                            call GroupEnumUnitsInRange(s__TojiSpells___TojiSpells_R_Insectoids_scanGroup[this], s__TojiSpells___TojiSpells_R_Insectoids_centerX[this], s__TojiSpells___TojiSpells_R_Insectoids_centerY[this], TojiR_Aoe, NoDecor_Cond)
                            call GroupClear(s__TojiSpells___TojiSpells_R_Insectoids_keepGroup[this])

                            loop
                                set target=FirstOfGroup(s__TojiSpells___TojiSpells_R_Insectoids_affectedGroup[this])
                                exitwhen target == null
                                call GroupRemoveUnit(s__TojiSpells___TojiSpells_R_Insectoids_affectedGroup[this], target)
                                if IsUnitInGroup(target, s__TojiSpells___TojiSpells_R_Insectoids_scanGroup[this]) and IsUnitEnemy(target, GetOwningPlayer(s__TojiSpells___TojiSpells_R_Insectoids_c[this])) and SpellBool(target) then
                                    call GroupAddUnit(s__TojiSpells___TojiSpells_R_Insectoids_keepGroup[this], target)
                                endif
                            endloop

                            loop
                                set target=FirstOfGroup(s__TojiSpells___TojiSpells_R_Insectoids_scanGroup[this])
                                exitwhen target == null
                                call GroupRemoveUnit(s__TojiSpells___TojiSpells_R_Insectoids_scanGroup[this], target)
                                if IsUnitEnemy(target, GetOwningPlayer(s__TojiSpells___TojiSpells_R_Insectoids_c[this])) and SpellBool(target) then
                                    set hid=GetHandleId(target)
                                    if not IsUnitInGroup(target, s__TojiSpells___TojiSpells_R_Insectoids_keepGroup[this]) then
                                        call GroupAddUnit(s__TojiSpells___TojiSpells_R_Insectoids_keepGroup[this], target)
                                    endif
                                    call SlowUnit(s__TojiSpells___TojiSpells_R_Insectoids_c[this] , target , TojiR_SlowPercent , TojiR_SlowDuration)
                                endif
                            endloop
                            set swapGroup=s__TojiSpells___TojiSpells_R_Insectoids_affectedGroup[this]
                            set s__TojiSpells___TojiSpells_R_Insectoids_affectedGroup[this]=s__TojiSpells___TojiSpells_R_Insectoids_keepGroup[this]
                            set s__TojiSpells___TojiSpells_R_Insectoids_keepGroup[this]=swapGroup
                            set swapGroup=null
                        endif

                        if s__TojiSpells___TojiSpells_R_Insectoids_damageClock[this] >= TojiR_DamageInterval then
                            set s__TojiSpells___TojiSpells_R_Insectoids_damageClock[this]=RoundReal(s__TojiSpells___TojiSpells_R_Insectoids_damageClock[this] - TojiR_DamageInterval , 3)
                            set damage=s__TojiSpells___TojiSpells_R_Insectoids_damagePerSecond[this] * TojiR_DamageInterval + s__TojiSpells___TojiSpells_R_Insectoids_leapBonus[this]
                            set hit=false
                            call DecorRemove(s__TojiSpells___TojiSpells_R_Insectoids_c[this] , s__TojiSpells___TojiSpells_R_Insectoids_centerX[this] , s__TojiSpells___TojiSpells_R_Insectoids_centerY[this] , TojiR_Aoe , TojiR_DecorDamage)
                            call GroupClear(s__TojiSpells___TojiSpells_R_Insectoids_damageGroup[this])
                            call GroupEnumUnitsInRange(s__TojiSpells___TojiSpells_R_Insectoids_damageGroup[this], s__TojiSpells___TojiSpells_R_Insectoids_centerX[this], s__TojiSpells___TojiSpells_R_Insectoids_centerY[this], TojiR_Aoe, NoDecor_Cond)
                            loop
                                set target=FirstOfGroup(s__TojiSpells___TojiSpells_R_Insectoids_damageGroup[this])
                                exitwhen target == null
                                call GroupRemoveUnit(s__TojiSpells___TojiSpells_R_Insectoids_damageGroup[this], target)
                                if IsUnitEnemy(target, GetOwningPlayer(s__TojiSpells___TojiSpells_R_Insectoids_c[this])) and SpellBool(target) then
                                    set GearDamageNextSource=('A0H4') // INLINED!!
                                    call dmgphys(s__TojiSpells___TojiSpells_R_Insectoids_c[this] , target , TojiSpells___TojiAbilityDamage(s__TojiSpells___TojiSpells_R_Insectoids_c[this] , target , damage))
                                    set hit=true
                                endif
                            endloop
                            if hit then
                                set s__TojiSpells___TojiSpells_R_Insectoids_leapBonus[this]=0.0
                            endif
                        endif

                        if s__TojiSpells___TojiSpells_R_Insectoids_elapsed[this] >= 0.80 + s__TojiSpells___TojiSpells_R_Insectoids_r5[this] then
                            set remove=true
                        endif
                    endif
                endif

                if remove then
                    call WOSUI___WUI_TestHeroProgress((s__TojiSpells___TojiSpells_R_Insectoids_c[this] ) , ( TojiR_ID ) , ( "Cursed Spirit Swarm" ) , (( 0.00 )*1.0) , (( 0.00 )*1.0) , ( true) , "") // INLINED!!
                else
                    call WOSUI___WUI_TestHeroProgress((s__TojiSpells___TojiSpells_R_Insectoids_c[this] ) , ( TojiR_ID ) , ( "Cursed Spirit Swarm" ) , (( 0.80 + s__TojiSpells___TojiSpells_R_Insectoids_r5[this] - s__TojiSpells___TojiSpells_R_Insectoids_elapsed[this] )*1.0) , (( 0.80 + s__TojiSpells___TojiSpells_R_Insectoids_r5[this] )*1.0) , ( true) , "") // INLINED!!
                endif

                if remove then
