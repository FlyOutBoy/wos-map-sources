function s__GearSystems2___KS_DamageOverTime_DmgPTime_Start takes unit NewC,unit NewTd,real NewDmg,real NewDuration,real NewPeriod,integer NewTD,string NewS returns nothing
    local integer this= s__GearSystems2___KS_DamageOverTime__allocate()
    local integer totalTicks
    set s__GearSystems2___KS_DamageOverTime_MUI_5=s__GearSystems2___KS_DamageOverTime_MUI_5 + 1
    set s__GearSystems2___KS_DamageOverTime_m_5[s__GearSystems2___KS_DamageOverTime_MUI_5]=this
