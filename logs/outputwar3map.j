                                        call StunUnit(s__AinzSpells__AinzW_KS_c[this] , s__AinzSpells__AinzW_KS_u[this] , AinzE_WallHitStun)
                                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_1baozha_90.mdl" , GetUnitX(s__AinzSpells__AinzW_KS_u[this]) , GetUnitY(s__AinzSpells__AinzW_KS_u[this]) , GetRandomReal(0, 359) , 0.75 , 1.35 , 0))
                                    endif
