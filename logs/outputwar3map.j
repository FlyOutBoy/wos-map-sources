        endfunction



//library AlucardSpells ends
//library AstaSpells:

    //===========================================================================
    // Модуль отслеживания приказов (Order Tracking & Animation Restore)
    //===========================================================================
    function AstaSpells__OnAstaPointOrder takes nothing returns boolean
        local unit u= GetOrderedUnit()
        local integer ord= GetIssuedOrderId()
        if GetUnitTypeId(u) == Asta_ID then
            if ord == 851971 or ord == 851986 or ord == 851990 then
                call SaveInteger(hs, GetHandleId(u), AstaSpells__SH_ORD_MODE, 1)
                call SaveInteger(hs, GetHandleId(u), AstaSpells__SH_ORD_ID, ord)
                call SaveReal(hs, GetHandleId(u), AstaSpells__SH_ORD_X, GetOrderPointX())
                call SaveReal(hs, GetHandleId(u), AstaSpells__SH_ORD_Y, GetOrderPointY())
            endif
        endif
        set u=null
        return false
    endfunction

    function AstaSpells__OnAstaTargetOrder takes nothing returns boolean
        local unit u= GetOrderedUnit()
        local integer ord= GetIssuedOrderId()
        if GetUnitTypeId(u) == Asta_ID then
            if ord == 851971 or ord == 851983 then
                call SaveInteger(hs, GetHandleId(u), AstaSpells__SH_ORD_MODE, 2)
                call SaveInteger(hs, GetHandleId(u), AstaSpells__SH_ORD_ID, ord)
                call SaveUnitHandle(hs, GetHandleId(u), AstaSpells__SH_ORD_TARGET, GetOrderTargetUnit())
            endif
        endif
        set u=null
        return false
    endfunction

    function AstaSpells__OnAstaImmediateOrder takes nothing returns boolean
        local unit u= GetOrderedUnit()
        local integer ord= GetIssuedOrderId()
        if GetUnitTypeId(u) == Asta_ID then
            if ord == 851972 or ord == 851993 then
                call SaveInteger(hs, GetHandleId(u), AstaSpells__SH_ORD_MODE, 0)
            endif
        endif
        set u=null
        return false
    endfunction

    function Asta_RestoreOrder takes unit c,integer animIndex returns nothing
        local integer mode= LoadInteger(hs, GetHandleId(c), AstaSpells__SH_ORD_MODE)
        local real ox
        local real oy
        local real dx
        local real dy
        local integer oid
        local unit tu

        if mode == 1 then
            set ox=LoadReal(hs, GetHandleId(c), AstaSpells__SH_ORD_X)
            set oy=LoadReal(hs, GetHandleId(c), AstaSpells__SH_ORD_Y)
            set dx=ox - GetUnitX(c)
            set dy=oy - GetUnitY(c)
            if ( dx * dx + dy * dy ) > 5625.0 then
                set oid=LoadInteger(hs, GetHandleId(c), AstaSpells__SH_ORD_ID)
                call IssuePointOrderById(c, oid, ox, oy)
                return
            endif
        elseif mode == 2 then
            set tu=LoadUnitHandle(hs, GetHandleId(c), AstaSpells__SH_ORD_TARGET)
            if tu != null and GetWidgetLife(tu) > 0.405 then
                set oid=LoadInteger(hs, GetHandleId(c), AstaSpells__SH_ORD_ID)
                call IssueTargetOrderById(c, oid, tu)
                set tu=null
                return
            endif
            set tu=null
        endif

        call SetUnitAnimationByIndex(c, animIndex)
        call s__GearSystems2___KS_RemoveUnit_MyRemoveUnit_Start((c ) , (( 0.03 )*1.0) , 2 , - 1 , ( animIndex) , "") // INLINED!!
    endfunction

        function s__AstaSpells__AstaOrderInit_onInit takes nothing returns nothing
            local trigger tPoint= CreateTrigger()
            local trigger tTarget= CreateTrigger()
            local trigger tImmediate= CreateTrigger()
            local integer i= 0
            loop
                exitwhen i >= 16
                call TriggerRegisterPlayerUnitEvent(tPoint, Player(i), EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER, null)
                call TriggerRegisterPlayerUnitEvent(tTarget, Player(i), EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER, null)
                call TriggerRegisterPlayerUnitEvent(tImmediate, Player(i), EVENT_PLAYER_UNIT_ISSUED_ORDER, null)
                set i=i + 1
            endloop
            call TriggerAddCondition(tPoint, Condition(function AstaSpells__OnAstaPointOrder))
            call TriggerAddCondition(tTarget, Condition(function AstaSpells__OnAstaTargetOrder))
            call TriggerAddCondition(tImmediate, Condition(function AstaSpells__OnAstaImmediateOrder))
        endfunction

    //===========================================================================
    // Управление глобальными таймерами
    //===========================================================================
    function AstaSpells__AstaTimer03Acquire takes nothing returns nothing
        set AstaSpells__AstaTimer03Users=AstaSpells__AstaTimer03Users + 1
        if AstaSpells__AstaTimer03Users == 1 then
            call TimerStart(AstaSpells__AstaTimer03, 0.03, true, AstaSpells__AstaTimer03Callback)
        endif
    endfunction

    function AstaSpells__AstaTimer03Release takes nothing returns nothing
        set AstaSpells__AstaTimer03Users=AstaSpells__AstaTimer03Users - 1
        if AstaSpells__AstaTimer03Users <= 0 then
            set AstaSpells__AstaTimer03Users=0
            call PauseTimer(AstaSpells__AstaTimer03)
        endif
    endfunction

    function AstaSpells__AstaTimer05Acquire takes nothing returns nothing
        set AstaSpells__AstaTimer05Users=AstaSpells__AstaTimer05Users + 1
        if AstaSpells__AstaTimer05Users == 1 then
            call TimerStart(AstaSpells__AstaTimer05, 0.05, true, AstaSpells__AstaTimer05Callback)
        endif
    endfunction

    function AstaSpells__AstaTimer05Release takes nothing returns nothing
        set AstaSpells__AstaTimer05Users=AstaSpells__AstaTimer05Users - 1
        if AstaSpells__AstaTimer05Users <= 0 then
            set AstaSpells__AstaTimer05Users=0
            call PauseTimer(AstaSpells__AstaTimer05)
        endif
    endfunction

    //===========================================================================
    // Структуры способностей
    //===========================================================================


        function s__AstaSpells__AstaSpells_Q_Loop_AstaQ takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__AstaSpells__AstaSpells_Q_MUI_AstaQ
                set this=s__AstaSpells__AstaSpells_Q_m_AstaQ[i]
                if SpellBoolCaster(s__AstaSpells__AstaSpells_Q_c[this]) and s__AstaSpells__AstaSpells_Q_r[this] <= s__AstaSpells__AstaSpells_Q_rmax[this] then
                    set s__AstaSpells__AstaSpells_Q_r[this]=I2R(R2I(( s__AstaSpells__AstaSpells_Q_r[this] + 0.03 ) * 1000.0 + 0.5)) / 1000.0
                    if s__AstaSpells__AstaSpells_Q_r[this] < AstaQ_CastTime then
                        call DebugUnit2(s__AstaSpells__AstaSpells_Q_c[this])
                    endif
                    if s__AstaSpells__AstaSpells_Q_r[this] == 0.39 then
                        call MakeSound("war3mapimported\\Hero_Asta_Q2")
                        call MakeSound("war3mapimported\\Hero_Asta_Q2")
                        set s__AstaSpells__AstaSpells_Q_e[this]=EffectSpawn4("war3mapImported\\wos_blackslash.mdx" , GetUnitX(s__AstaSpells__AstaSpells_Q_c[this]) - 100 * Cos(s__AstaSpells__AstaSpells_Q_a[this]) , GetUnitY(s__AstaSpells__AstaSpells_Q_c[this]) - 100 * Sin(s__AstaSpells__AstaSpells_Q_a[this]) , s__AstaSpells__AstaSpells_Q_a[this] * bj_RADTODEG , 0.65 , 0.5 , 155 , - 20)
                        set s__AstaSpells__AstaSpells_Q_e2[this]=EffectSpawn4("war3mapImported\\wos_blackslash.mdx" , GetUnitX(s__AstaSpells__AstaSpells_Q_c[this]) - 100 * Cos(s__AstaSpells__AstaSpells_Q_a[this]) , GetUnitY(s__AstaSpells__AstaSpells_Q_c[this]) - 100 * Sin(s__AstaSpells__AstaSpells_Q_a[this]) , s__AstaSpells__AstaSpells_Q_a[this] * bj_RADTODEG , 0.65 , 0.5 , 155 , - 340)
                        set s__AstaSpells__AstaSpells_Q_e3[this]=EffectSpawn("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl" , GetUnitX(s__AstaSpells__AstaSpells_Q_c[this]) + 250 * Cos(s__AstaSpells__AstaSpells_Q_a[this]) , GetUnitY(s__AstaSpells__AstaSpells_Q_c[this]) + 250 * Sin(s__AstaSpells__AstaSpells_Q_a[this]) , s__AstaSpells__AstaSpells_Q_a[this] * bj_RADTODEG , 0.65 , 3 , 135)
                        call MoveEff(s__AstaSpells__AstaSpells_Q_e3[this] , 10 , s__AstaSpells__AstaSpells_Q_a[this])
                        set s__AstaSpells__AstaSpells_Q_scale[this]=1.0
                        set s__AstaSpells__AstaSpells_Q_k3[this]=0
                        if GetUnitAbilityLevel(s__AstaSpells__AstaSpells_Q_c[this], AstaSword2_ID) > 0 then
                            set s__AstaSpells__AstaSpells_Q_scale[this]=( 1.0 + ( AstaTQ_AoeBonus / 100.0 ) )
                            set s__AstaSpells__AstaSpells_Q_aoe[this]=s__AstaSpells__AstaSpells_Q_aoe[this] * ( 1.0 + ( AstaTQ_AoeBonus / 100.0 ) )
                            set s__AstaSpells__AstaSpells_Q_k3[this]=1
                            set s__AstaSpells__AstaSpells_Q_dmg[this]=s__AstaSpells__AstaSpells_Q_dmg[this] + AstaTQ_DmgBonus * GetHeroAgi(s__AstaSpells__AstaSpells_Q_c[this], true)
                            call BlzSetSpecialEffectHeight(s__AstaSpells__AstaSpells_Q_e[this], BlzGetLocalSpecialEffectZ(s__AstaSpells__AstaSpells_Q_e[this]) * ( 1.0 + ( AstaTQ_AoeBonus / 100.0 ) ))
                        endif
                        call ScaleEffDummy(s__AstaSpells__AstaSpells_Q_e[this] , 0.3 , 0.5 , 2.6 * s__AstaSpells__AstaSpells_Q_scale[this])
                        call ScaleEffDummy(s__AstaSpells__AstaSpells_Q_e2[this] , 0.3 , 0.5 , 2.6 * s__AstaSpells__AstaSpells_Q_scale[this])
                    endif
                    if s__AstaSpells__AstaSpells_Q_r[this] == AstaQ_CastTime then
                        call StopSpellUnit2(s__AstaSpells__AstaSpells_Q_c[this])
                        if GetUnitAbilityLevel(s__AstaSpells__AstaSpells_Q_c[this], AstaQ_ID) >= 5 then
                            call s__GearSystems2___KS_SpellTimer_SpellTimer_Timer_Start((s__AstaSpells__AstaSpells_Q_c[this] ) , (( 4 )*1.0) , ( AstaQ2_ID ) , ( AstaQ_ID) , 0) // INLINED!!
                            call s__GearSystems2___KS_BuffTimer_MyBuffTime_Start((s__AstaSpells__AstaSpells_Q_c[this] ) , 0 , (( 4 )*1.0) , ( "BTNHero_Asta_Q2" ) , ( false ) , - 1 , 1 , 0 , ( 0)) // INLINED!!
                        endif
                    endif
                    if s__AstaSpells__AstaSpells_Q_r[this] >= AstaQ_CastTime then
                        set s__AstaSpells__AstaSpells_Q_x[this]=(BlzGetLocalSpecialEffectX((s__AstaSpells__AstaSpells_Q_e[this]))) + 280 * Cos(s__AstaSpells__AstaSpells_Q_a[this]) // INLINED!!
                        set s__AstaSpells__AstaSpells_Q_y[this]=(BlzGetLocalSpecialEffectY((s__AstaSpells__AstaSpells_Q_e[this]))) + 280 * Sin(s__AstaSpells__AstaSpells_Q_a[this]) // INLINED!!
                        call MoveEff(s__AstaSpells__AstaSpells_Q_e[this] , s__AstaSpells__AstaSpells_Q_move[this] , s__AstaSpells__AstaSpells_Q_a[this])
                        call MoveEff(s__AstaSpells__AstaSpells_Q_e2[this] , s__AstaSpells__AstaSpells_Q_move[this] , s__AstaSpells__AstaSpells_Q_a[this])
                        call MoveEff(s__AstaSpells__AstaSpells_Q_e3[this] , s__AstaSpells__AstaSpells_Q_move[this] , s__AstaSpells__AstaSpells_Q_a[this])
                        if s__AstaSpells__AstaSpells_Q_move[this] < 100.0 then
                            set s__AstaSpells__AstaSpells_Q_move[this]=s__AstaSpells__AstaSpells_Q_move[this] + 1.25
                        endif
