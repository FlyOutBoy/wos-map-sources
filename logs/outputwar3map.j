                            set s___RimuruSpells___Rimuru3T_KS_ee[s__RimuruSpells___Rimuru3T_KS_ee[this]+s__RimuruSpells___Rimuru3T_KS_k[this]]=null
                        endif
                        set s__RimuruSpells___Rimuru3T_KS_k[this]=s__RimuruSpells___Rimuru3T_KS_k[this] + 1
                    endloop
                    // Destroy ALL lightning slots (3 banks Г— ring)
                    set s__RimuruSpells___Rimuru3T_KS_k[this]=0
                    loop
                        exitwhen s__RimuruSpells___Rimuru3T_KS_k[this] == ring * 3
                        if s___RimuruSpells___Rimuru3T_KS_ls[s__RimuruSpells___Rimuru3T_KS_ls[this]+s__RimuruSpells___Rimuru3T_KS_k[this]] != null then
                            call DestroyLightning(s___RimuruSpells___Rimuru3T_KS_ls[s__RimuruSpells___Rimuru3T_KS_ls[this]+s__RimuruSpells___Rimuru3T_KS_k[this]])
                            set s___RimuruSpells___Rimuru3T_KS_ls[s__RimuruSpells___Rimuru3T_KS_ls[this]+s__RimuruSpells___Rimuru3T_KS_k[this]]=null
                        endif
                        set s__RimuruSpells___Rimuru3T_KS_k[this]=s__RimuruSpells___Rimuru3T_KS_k[this] + 1
                    endloop
                    call DestroyGroup(s__RimuruSpells___Rimuru3T_KS_g[this])
                    call DestroyGroup(s__RimuruSpells___Rimuru3T_KS_g2[this]) // was missing in original
                    call SetUnitTimeScale(s__RimuruSpells___Rimuru3T_KS_c[this], 1)
                    set s__RimuruSpells___Rimuru3T_KS_c[this]=null
                    set s__RimuruSpells___Rimuru3T_KS_e2[this]=null
                    set s__RimuruSpells___Rimuru3T_KS_u[this]=null
                    set s__RimuruSpells___Rimuru3T_KS_g[this]=null
                    set s__RimuruSpells___Rimuru3T_KS_g2[this]=null
                    set s__RimuruSpells___Rimuru3T_KS_m_Rimuru3T[i]=s__RimuruSpells___Rimuru3T_KS_m_Rimuru3T[s__RimuruSpells___Rimuru3T_KS_MUI_Rimuru3T]
                    set s__RimuruSpells___Rimuru3T_KS_MUI_Rimuru3T=s__RimuruSpells___Rimuru3T_KS_MUI_Rimuru3T - 1
                    if s__RimuruSpells___Rimuru3T_KS_MUI_Rimuru3T == - 1 then
                        call RimuruSpells___RimuruTimer03Release()
                    endif
                    call s__RimuruSpells___Rimuru3T_KS_deallocate(this)
                set i=i - 1
                endif
                set i=i + 1
            endloop
        endfunction
        function s__RimuruSpells___Rimuru3T_KS_Rimuru3T_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__RimuruSpells___Rimuru3T_KS__allocate()
            local integer ring= 15
            local real angle
            set s__RimuruSpells___Rimuru3T_KS_MUI_Rimuru3T=s__RimuruSpells___Rimuru3T_KS_MUI_Rimuru3T + 1
            set s__RimuruSpells___Rimuru3T_KS_m_Rimuru3T[s__RimuruSpells___Rimuru3T_KS_MUI_Rimuru3T]=this
            set s__RimuruSpells___Rimuru3T_KS_c[this]=NewC
            set s__RimuruSpells___Rimuru3T_KS_x[this]=NewX
            set s__RimuruSpells___Rimuru3T_KS_y[this]=NewY
            set s__RimuruSpells___Rimuru3T_KS_r[this]=0
            set s__RimuruSpells___Rimuru3T_KS_r2[this]=0
            set s__RimuruSpells___Rimuru3T_KS_r3[this]=0 // FIX: explicitly zero r3/r4 so leftover values from a
            set s__RimuruSpells___Rimuru3T_KS_r4[this]=0 //      previous struct allocation don't corrupt phase math
            set s__RimuruSpells___Rimuru3T_KS_check[this]=0
            set s__RimuruSpells___Rimuru3T_KS_check2[this]=0
            set s__RimuruSpells___Rimuru3T_KS_u[this]=null
            set s__RimuruSpells___Rimuru3T_KS_k3[this]=0
            set s__RimuruSpells___Rimuru3T_KS_e2[this]=null
            set s__RimuruSpells___Rimuru3T_KS_g[this]=CreateGroup()
            set s__RimuruSpells___Rimuru3T_KS_g2[this]=CreateGroup()
            // FIX: zero all lightning slots so null-guards in Loop work on first cycle
            set s__RimuruSpells___Rimuru3T_KS_k[this]=0
            loop
                exitwhen s__RimuruSpells___Rimuru3T_KS_k[this] == ring * 3 // ring is 15, constant
                set s___RimuruSpells___Rimuru3T_KS_ls[s__RimuruSpells___Rimuru3T_KS_ls[this]+s__RimuruSpells___Rimuru3T_KS_k[this]]=null
                set s__RimuruSpells___Rimuru3T_KS_k[this]=s__RimuruSpells___Rimuru3T_KS_k[this] + 1
            endloop
            set s__RimuruSpells___Rimuru3T_KS_aoe[this]=RimuruT3_DamageAoe
            set s__RimuruSpells___Rimuru3T_KS_scale[this]=s__RimuruSpells___Rimuru3T_KS_aoe[this] / 900
            set angle=GAngle2(s__RimuruSpells___Rimuru3T_KS_c[this] , s__RimuruSpells___Rimuru3T_KS_x[this] , s__RimuruSpells___Rimuru3T_KS_y[this])
            set s__RimuruSpells___Rimuru3T_KS_rmax[this]=6.5
            //call StartSpellUnit(c)
            if LoadInteger(hs, GetHandleId(s__RimuruSpells___Rimuru3T_KS_c[this]), RimuruSpells___SH_RIM_MAIN_STAT) == 0 then
                set s__RimuruSpells___Rimuru3T_KS_dmg[this]=GetHeroInt(s__RimuruSpells___Rimuru3T_KS_c[this], true) * RimuruT3_DamageIntBase
            else
                set s__RimuruSpells___Rimuru3T_KS_dmg[this]=GetHeroAgi(s__RimuruSpells___Rimuru3T_KS_c[this], true) * RimuruT3_DamageIntBase
            endif
            call SetUnitFacing(s__RimuruSpells___Rimuru3T_KS_c[this], angle * bj_RADTODEG)
            call SetUnitAnimationByIndex(s__RimuruSpells___Rimuru3T_KS_c[this], 6)
            call SetUnitTimeScale(s__RimuruSpells___Rimuru3T_KS_c[this], 1.6)
            call MakeSound("war3mapimported\\Hero_Rimuru3_T")
            if s__RimuruSpells___Rimuru3T_KS_MUI_Rimuru3T == 0 then
                call RimuruSpells___RimuruTimer03Acquire()
            endif
        endfunction

    
