                call ItemsSpells__ElemHit(s__ItemsElementsFx_c[this] , s__ItemsElementsFx_u[this] , s__ItemsElementsFx_src[this] , s__ItemsElementsFx_dmg[this] , true , 3)
                set m=s__ItemsElementsFx_Mark(s__ItemsElementsFx_VOLT , s__ItemsElementsFx_src[this] , s__ItemsElementsFx_c[this] , s__ItemsElementsFx_u[this] , VoltThread_Duration , "")
                set s__ItemsElementsFx_dmg2[m]=VoltThread_Bonus * (I2R(GetHeroAgi((s__ItemsElementsFx_c[this]), true))) // INLINED!!
