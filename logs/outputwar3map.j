                call SaveInteger(hs, GetHandleId(GetOwningPlayer(s__StarrkSpells___StarrkSpells_W_c[this])), StarrkSpells___SH_WOLF_ULT, 1)
                call SetUnitTimeScale(s__StarrkSpells___StarrkSpells_W_c[this], 0.4)
                set s__StarrkSpells___StarrkSpells_W_e[this]=AddSpecialEffectTarget("war3mapimported\\wos_ChuShou_BY_Wood_Effect_Glow_GuiPaiQiGong_XuLiblue.mdx", s__StarrkSpells___StarrkSpells_W_c[this], "hand left")
                set s__StarrkSpells___StarrkSpells_W_e2[this]=AddSpecialEffectTarget("war3mapimported\\wos_ChuShou_BY_Wood_Effect_Glow_GuiPaiQiGong_XuLiblue.mdx", s__StarrkSpells___StarrkSpells_W_c[this], "hand right")
            endif
            call SaveInteger(hs, GetHandleId(GetOwningPlayer(s__StarrkSpells___StarrkSpells_W_c[this])), StarrkSpells___SH_W_SKILL, 1)
            if s__StarrkSpells___StarrkSpells_W_MUI_StarrkW == 0 then
                call StarrkSpells___StarrkTick_On(2)
            endif
        endfunction



        function s__StarrkSpells___StarrkSpells_E_Loop_StarrkE takes nothing returns nothing
            local integer this
