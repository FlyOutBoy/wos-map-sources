        function s__KenjakuSpells___KenjakuTick_Loop_Loop takes nothing returns nothing
            if KenjakuSpells___KenjakuTick_Active[0] then
                call s__KenjakuSpells___KenjakuQ_KS_Loop_KenjakuQ()
            endif
            if KenjakuSpells___KenjakuTick_Active[1] then
                call s__KenjakuSpells___KenjakuQ2_KS_Loop_KenjakuQ2()
            endif
            if KenjakuSpells___KenjakuTick_Active[2] then
                call s__KenjakuSpells___KenjakuW_KS_Loop_KenjakuW()
            endif
            if KenjakuSpells___KenjakuTick_Active[3] then
                call s__KenjakuSpells___KenjakuW2_KS_Loop_KenjakuW2()
            endif
            if KenjakuSpells___KenjakuTick_Active[4] then
                call s__KenjakuSpells___KenjakuE_KS_Loop_KenjakuE()
            endif
            if KenjakuSpells___KenjakuTick_Active[5] then
                call s__KenjakuSpells___KenjakuE2_KS_Loop_KenjakuE2()
            endif
            if KenjakuSpells___KenjakuTick_Active[6] then
                call s__KenjakuSpells___KenjakuR_KS_Loop_KenjakuR()
            endif
            if KenjakuSpells___KenjakuTick_Active[7] then
                call s__KenjakuSpells___KenjakuR2_KS_Loop_KenjakuR2()
            endif
            if KenjakuSpells___KenjakuTick_Active[8] then
                call s__KenjakuSpells___KenjakuT_KS_Loop_KenjakuT()
            endif
            if KenjakuSpells___KenjakuTick_Active[9] then
                call s__KenjakuSpells___KenjakuF2_KS_Loop_KenjakuF2()
            endif
        endfunction

        function s__KenjakuSpells___KenjakuTick_Loop_onInit takes nothing returns nothing
            set KenjakuSpells___KenjakuTick_Callback=function s__KenjakuSpells___KenjakuTick_Loop_Loop
        endfunction


