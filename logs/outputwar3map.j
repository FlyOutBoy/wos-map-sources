                    set s__AlucardSpells__AlucardSpells_R_MUI_AlucardR=s__AlucardSpells__AlucardSpells_R_MUI_AlucardR - 1
                    set i=i - 1 // revisit: the moved instance must not skip this tick
                    if s__AlucardSpells__AlucardSpells_R_MUI_AlucardR == - 1 then
                        call AlucardSpells__AlucardTick05_Off(2)
                    endif
                    call s__AlucardSpells__AlucardSpells_R_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction

        function s__AlucardSpells__AlucardSpells_R_AlucardR_Start takes unit NewC returns nothing
            local integer this= s__AlucardSpells__AlucardSpells_R__allocate()
            local real tmp_y= 0
            set s__AlucardSpells__AlucardSpells_R_MUI_AlucardR=s__AlucardSpells__AlucardSpells_R_MUI_AlucardR + 1
            set s__AlucardSpells__AlucardSpells_R_m_AlucardR[s__AlucardSpells__AlucardSpells_R_MUI_AlucardR]=this
            set s__AlucardSpells__AlucardSpells_R_c[this]=NewC
            set s__AlucardSpells__AlucardSpells_R_x[this]=GetUnitX(s__AlucardSpells__AlucardSpells_R_c[this])
            set s__AlucardSpells__AlucardSpells_R_y[this]=GetUnitY(s__AlucardSpells__AlucardSpells_R_c[this])
            set s__AlucardSpells__AlucardSpells_R_r[this]=0
            set s__AlucardSpells__AlucardSpells_R_r2[this]=10
            set s__AlucardSpells__AlucardSpells_R_r3[this]=10
            set s__AlucardSpells__AlucardSpells_R_check2[this]=0
            set s__AlucardSpells__AlucardSpells_R_k2[this]=GetPlayerId(GetOwningPlayer(s__AlucardSpells__AlucardSpells_R_c[this]))
            call StartSpellUnit2(s__AlucardSpells__AlucardSpells_R_c[this])
            set s__AlucardSpells__AlucardSpells_R_check[this]=0
            set s__AlucardSpells__AlucardSpells_R_u[this]=null
            set s__AlucardSpells__AlucardSpells_R_a[this]=GetUnitFacing(s__AlucardSpells__AlucardSpells_R_c[this]) * bj_DEGTORAD // Angle Between points
            set s__AlucardSpells__AlucardSpells_R_rmax[this]=1
            call UnitAddAbility(s__AlucardSpells__AlucardSpells_R_c[this], AlucardR_Armor)
            if GetUnitAbilityLevel(s__AlucardSpells__AlucardSpells_R_c[this], AlucardR_ID) == 1 then
                call UnitAddAbility(s__AlucardSpells__AlucardSpells_R_c[this], AlterSaberR_Regen0)
            elseif GetUnitAbilityLevel(s__AlucardSpells__AlucardSpells_R_c[this], AlucardR_ID) == 2 then
                call UnitAddAbility(s__AlucardSpells__AlucardSpells_R_c[this], AlterSaberR_Regen1)
            elseif GetUnitAbilityLevel(s__AlucardSpells__AlucardSpells_R_c[this], AlucardR_ID) == 3 then
                call UnitAddAbility(s__AlucardSpells__AlucardSpells_R_c[this], AlterSaberR_Regen2)
            elseif GetUnitAbilityLevel(s__AlucardSpells__AlucardSpells_R_c[this], AlucardR_ID) == 4 then
                call UnitAddAbility(s__AlucardSpells__AlucardSpells_R_c[this], AlterSaberR_Regen3)
            elseif GetUnitAbilityLevel(s__AlucardSpells__AlucardSpells_R_c[this], AlucardR_ID) == 5 then
                call UnitAddAbility(s__AlucardSpells__AlucardSpells_R_c[this], AlterSaberR_Regen4)
            endif
            call SaveInteger(hs, GetHandleId(GetOwningPlayer(s__AlucardSpells__AlucardSpells_R_c[this])), SH_Alucard_ALUCARDQ_ID, 1)
            
            call SetUnitAbilityLevel(s__AlucardSpells__AlucardSpells_R_c[this], AlucardR_Armor, GetUnitAbilityLevel(s__AlucardSpells__AlucardSpells_R_c[this], AlucardR_ID))
            set s__AlucardSpells__AlucardSpells_R_r5[this]=( GetUnitState(s__AlucardSpells__AlucardSpells_R_c[this], UNIT_STATE_LIFE) * ( ( AlucardR_HpCostBase + AlucardR_HpCostStep * ( GetUnitAbilityLevel(s__AlucardSpells__AlucardSpells_R_c[this], AlucardR_ID) - 1 ) ) / 100 ) ) / 20
            call VisionTimed(GetOwningPlayer(s__AlucardSpells__AlucardSpells_R_c[this]) , GetUnitX(s__AlucardSpells__AlucardSpells_R_c[this]) , GetUnitY(s__AlucardSpells__AlucardSpells_R_c[this]) , 1800 , s__AlucardSpells__AlucardSpells_R_rmax[this])
            call SetUnitTimeScale(s__AlucardSpells__AlucardSpells_R_c[this], 1.5)
            call SetUnitAnimationByIndex(s__AlucardSpells__AlucardSpells_R_c[this], 18)
            call MakeSound("war3mapimported\\Hero_Alucard_R")
            call MakeSound("war3mapimported\\Hero_Alucard_R3")
            if s__AlucardSpells__AlucardSpells_R_MUI_AlucardR == 0 then
                call AlucardSpells__AlucardTick05_On(2)
            endif
        endfunction



        function s__AlucardSpells__AlucardSpells_T_Loop_AlucardT takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__AlucardSpells__AlucardSpells_T_MUI_AlucardT
                set this=s__AlucardSpells__AlucardSpells_T_m_AlucardT[i]
                if SpellBoolCaster(s__AlucardSpells__AlucardSpells_T_td[this]) and s__AlucardSpells__AlucardSpells_T_r[this] <= s__AlucardSpells__AlucardSpells_T_rmax[this] and ( GetUnitAbilityLevel(s__AlucardSpells__AlucardSpells_T_td[this], AlucardT_Buff_ID) > 0 or GetUnitAbilityLevel(s__AlucardSpells__AlucardSpells_T_td[this], AlucardT2_Buff_ID) > 0 ) then
                    set s__AlucardSpells__AlucardSpells_T_r[this]=s__AlucardSpells__AlucardSpells_T_r[this] + 0.05
                    set s__AlucardSpells__AlucardSpells_T_r[this]=RoundReal(s__AlucardSpells__AlucardSpells_T_r[this] , 3)
                    if s__AlucardSpells__AlucardSpells_T_r5[this] >= 100 then
                    call BlzSetSpecialEffectPosition(s__AlucardSpells__AlucardSpells_T_e2[this], GetUnitX(s__AlucardSpells__AlucardSpells_T_td[this]), GetUnitY(s__AlucardSpells__AlucardSpells_T_td[this]), GetUnitFlyHeight(s__AlucardSpells__AlucardSpells_T_td[this]) + 150)
                    call EffVision(s__AlucardSpells__AlucardSpells_T_e2[this] , s__AlucardSpells__AlucardSpells_T_td[this])
                    endif
                   // call BlzSetSpecialEffectPosition(e3, GetUnitX(td), GetUnitY(td), GetUnitFlyHeight(td) + 1)
                    //call EffVision(e3, td)
                else
                 if s__AlucardSpells__AlucardSpells_T_r5[this] >= 100 then
                    call DestroyEffect(s__AlucardSpells__AlucardSpells_T_e2[this])
                    call BlzSetSpecialEffectTimeScale(s__AlucardSpells__AlucardSpells_T_e2[this], 2.5)
                    endif
                   // call DestroyEffect(e3)
                 //   call BlzSetSpecialEffectTimeScale(e3, 2.5)
                    call SaveInteger(hs, GetHandleId(GetOwningPlayer(s__AlucardSpells__AlucardSpells_T_td[this])), AlucardSpells__SH_T_IMMUN_TIME_TARGET, 0)
                    call SaveInteger(hs, GetHandleId(GetOwningPlayer(s__AlucardSpells__AlucardSpells_T_c[this])), AlucardSpells__SH_T_IMMUN_TIME, 0)
                    set s__AlucardSpells__AlucardSpells_T_c[this]=null
                    set s__AlucardSpells__AlucardSpells_T_td[this]=null
                    set s__AlucardSpells__AlucardSpells_T_e2[this]=null
                    set s__AlucardSpells__AlucardSpells_T_e3[this]=null
                    set s__AlucardSpells__AlucardSpells_T_m_AlucardT[i]=s__AlucardSpells__AlucardSpells_T_m_AlucardT[s__AlucardSpells__AlucardSpells_T_MUI_AlucardT]
                    set s__AlucardSpells__AlucardSpells_T_MUI_AlucardT=s__AlucardSpells__AlucardSpells_T_MUI_AlucardT - 1
                    set i=i - 1 // revisit: the moved instance must not skip this tick
                    if s__AlucardSpells__AlucardSpells_T_MUI_AlucardT == - 1 then
                        call AlucardSpells__AlucardTick05_Off(3)
                    endif
                    call s__AlucardSpells__AlucardSpells_T_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction

        function s__AlucardSpells__AlucardSpells_T_AlucardT_Start takes unit NewC,unit NewTd,real NewAdd,real NewHeal,integer NewCheck returns nothing
            local integer this= s__AlucardSpells__AlucardSpells_T__allocate()
            set s__AlucardSpells__AlucardSpells_T_MUI_AlucardT=s__AlucardSpells__AlucardSpells_T_MUI_AlucardT + 1
            set s__AlucardSpells__AlucardSpells_T_m_AlucardT[s__AlucardSpells__AlucardSpells_T_MUI_AlucardT]=this
            set s__AlucardSpells__AlucardSpells_T_c[this]=NewC
            set s__AlucardSpells__AlucardSpells_T_td[this]=NewTd
            set s__AlucardSpells__AlucardSpells_T_x[this]=GetUnitX(s__AlucardSpells__AlucardSpells_T_td[this])
            set s__AlucardSpells__AlucardSpells_T_y[this]=GetUnitY(s__AlucardSpells__AlucardSpells_T_td[this])
            set s__AlucardSpells__AlucardSpells_T_check[this]=NewCheck
            set s__AlucardSpells__AlucardSpells_T_r5[this]=NewAdd
            set s__AlucardSpells__AlucardSpells_T_r6[this]=NewHeal
            set s__AlucardSpells__AlucardSpells_T_r[this]=0
            if s__AlucardSpells__AlucardSpells_T_r5[this] >= 100 then
            set s__AlucardSpells__AlucardSpells_T_e2[this]=EffectSpawn("war3mapImported\\wos_[Spell]EnergyShield-blackred.mdx" , s__AlucardSpells__AlucardSpells_T_x[this] , s__AlucardSpells__AlucardSpells_T_y[this] , 1 , 1 , 1.5 , 155)
            endif
            if s__AlucardSpells__AlucardSpells_T_check[this] == 0 then
            call CurseUnit(s__AlucardSpells__AlucardSpells_T_c[this] , s__AlucardSpells__AlucardSpells_T_td[this] , 6)
            set s__AlucardSpells__AlucardSpells_T_rmax[this]=AlucardT_Duration
            call s__GearSystems2___KS_BuffTimer_MyBuffTime_Start((s__AlucardSpells__AlucardSpells_T_c[this] ) , 0 , (( s__AlucardSpells__AlucardSpells_T_rmax[this] )*1.0) , ( "BTNHero_Alucard_T" ) , ( false ) , - 1 , 1 , 0 , ( 1)) // INLINED!!
            call DestroyEffect(EffectSpawn("war3mapimported\\wos_HakkeStart.mdx" , s__AlucardSpells__AlucardSpells_T_x[this] , s__AlucardSpells__AlucardSpells_T_y[this] , GetRandomReal(0, 359) , 0.3 , 1.45 , 5))
            else
            set s__AlucardSpells__AlucardSpells_T_rmax[this]=AlucardT_Duration / 2
            endif
            //set e3 = EffectSpawn("war3mapImported\\wos_[By XeSHTeG]Alucard Circle.mdl", x, y, 0, 0.5, 0.85, 1)
            call SaveInteger(hs, GetHandleId(GetOwningPlayer(s__AlucardSpells__AlucardSpells_T_td[this])), AlucardSpells__SH_T_IMMUN_TIME_TARGET, 1)
            call SaveInteger(hs, GetHandleId(GetOwningPlayer(s__AlucardSpells__AlucardSpells_T_c[this])), AlucardSpells__SH_T_IMMUN_TIME, 1)
            call SaveReal(hs, GetHandleId(GetOwningPlayer(s__AlucardSpells__AlucardSpells_T_c[this])), AlucardSpells__SH_T_IMMUN_ADD_DMG, s__AlucardSpells__AlucardSpells_T_r5[this] / 100)
            call SaveReal(hs, GetHandleId(GetOwningPlayer(s__AlucardSpells__AlucardSpells_T_c[this])), AlucardSpells__SH_T_IMMUN_ADD_HEAL, s__AlucardSpells__AlucardSpells_T_r6[this] / 100)
            if s__AlucardSpells__AlucardSpells_T_MUI_AlucardT == 0 then
                call AlucardSpells__AlucardTick05_On(3)
            endif
        endfunction

