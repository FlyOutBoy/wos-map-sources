                        set s__OkarunSpells___OkarunF_KS_y[this]=LoadReal(hs, GetHandleId(s__OkarunSpells___OkarunF_KS_c[this]), OkarunSpells___SH_REAL_Y)
                        set s__OkarunSpells___OkarunF_KS_td[this]=null
                        // Only unit-target orders may follow the saved target.
                        if order == OrderId("smart") or order == OrderId("attack") or order == OrderId(OkarunW_Order) or order == OrderId(OkarunE_Order) or order == OrderId(OkarunR_Order) then
                            set s__OkarunSpells___OkarunF_KS_td[this]=LoadUnitHandle(hs, GetHandleId(s__OkarunSpells___OkarunF_KS_c[this]), OkarunSpells___SH_UNIT_TARGET)
                        endif
                        if s__OkarunSpells___OkarunF_KS_td[this] != null and GetUnitTypeId(s__OkarunSpells___OkarunF_KS_td[this]) != 0 and GetWidgetLife(s__OkarunSpells___OkarunF_KS_td[this]) > 0.405 then
                            set s__OkarunSpells___OkarunF_KS_x[this]=GetUnitX(s__OkarunSpells___OkarunF_KS_td[this])
                            set s__OkarunSpells___OkarunF_KS_y[this]=GetUnitY(s__OkarunSpells___OkarunF_KS_td[this])
                        endif
                        if moving then
                            if GetHeroLevel(s__OkarunSpells___OkarunF_KS_c[this]) >= 35 then
                                set s__OkarunSpells___OkarunF_KS_r3[this]=s__OkarunSpells___OkarunF_KS_r3[this] + s__OkarunSpells___OkarunF_KS_r5[this] * ( ( OkarunF_AddSpeedPercentPerSec + 1 ) * 0.01 ) * 0.03
                            else
                                set s__OkarunSpells___OkarunF_KS_r3[this]=s__OkarunSpells___OkarunF_KS_r3[this] + s__OkarunSpells___OkarunF_KS_r5[this] * ( OkarunF_AddSpeedPercentPerSec * 0.01 ) * 0.03
                            endif
                            set s__OkarunSpells___OkarunF_KS_r3[this]=RMinBJ(s__OkarunSpells___OkarunF_KS_r3[this], s__OkarunSpells___OkarunF_KS_r5[this])
                        endif
                        if GetUnitAbilityLevel(s__OkarunSpells___OkarunF_KS_c[this], OkarunT_Buff_ID) > 0 then
                            set s__OkarunSpells___OkarunF_KS_r3[this]=OkarunT_Speed(s__OkarunSpells___OkarunF_KS_c[this])
                            set s__OkarunSpells___OkarunF_KS_r5[this]=s__OkarunSpells___OkarunF_KS_r3[this]
                        endif
                        if moving and LoadInteger(hs, GetHandleId(s__OkarunSpells___OkarunF_KS_c[this]), OkarunSpells___SH_SPELL_P) == 0 then
                            set s__OkarunSpells___OkarunF_KS_r7[this]=s__OkarunSpells___OkarunF_KS_r7[this] + 0.03
                            if s__OkarunSpells___OkarunF_KS_r7[this] + 0.0001 >= OkarunF_OrderRepeatPeriod and SR3(s__OkarunSpells___OkarunF_KS_c[this] , s__OkarunSpells___OkarunF_KS_x[this] , s__OkarunSpells___OkarunF_KS_y[this]) > 150.00 then
                                set s__OkarunSpells___OkarunF_KS_r7[this]=0.00
                                if s__OkarunSpells___OkarunF_KS_td[this] != null and GetUnitTypeId(s__OkarunSpells___OkarunF_KS_td[this]) != 0 and GetWidgetLife(s__OkarunSpells___OkarunF_KS_td[this]) > 0.405 then
                                    call IssueTargetOrderById(s__OkarunSpells___OkarunF_KS_c[this], order, s__OkarunSpells___OkarunF_KS_td[this])
                                else
                                    call IssuePointOrderById(s__OkarunSpells___OkarunF_KS_c[this], order, s__OkarunSpells___OkarunF_KS_x[this], s__OkarunSpells___OkarunF_KS_y[this])
                                endif
                            endif
                        else
                            set s__OkarunSpells___OkarunF_KS_r7[this]=0.00
                        endif
                        if moving and LoadInteger(hs, GetHandleId(s__OkarunSpells___OkarunF_KS_c[this]), OkarunSpells___SH_SPELL_P) == 0 and GetUnitAbilityLevel(s__OkarunSpells___OkarunF_KS_c[this], 'BPSE') == 0 and GetUnitAbilityLevel(s__OkarunSpells___OkarunF_KS_c[this], 'BEer') == 0 then
                            set distance=SR3(s__OkarunSpells___OkarunF_KS_c[this] , s__OkarunSpells___OkarunF_KS_x[this] , s__OkarunSpells___OkarunF_KS_y[this])
                            // 0.31c2 control: add only the speed above native movement,
                            // along the current facing so turns and pathing stay native.
                            set s__OkarunSpells___OkarunF_KS_move[this]=RMaxBJ(0.00, s__OkarunSpells___OkarunF_KS_r3[this] - GetUnitMoveSpeed(s__OkarunSpells___OkarunF_KS_c[this])) * 0.03
                            set s__OkarunSpells___OkarunF_KS_move[this]=RMinBJ(s__OkarunSpells___OkarunF_KS_move[this], RMaxBJ(0.00, distance - 150.00))
                            if s__OkarunSpells___OkarunF_KS_move[this] > 0.00 then
                                set s__OkarunSpells___OkarunF_KS_a[this]=GetUnitFacing(s__OkarunSpells___OkarunF_KS_c[this]) * bj_DEGTORAD
                                call MoveUnit(s__OkarunSpells___OkarunF_KS_c[this] , s__OkarunSpells___OkarunF_KS_move[this] , s__OkarunSpells___OkarunF_KS_a[this])
                            endif
                        endif
                    endif

                    if s__OkarunSpells___OkarunF_KS_r2[this] > 0.06 then
                        set s__OkarunSpells___OkarunF_KS_r2[this]=0.03
                        if GetUnitAbilityLevel(s__OkarunSpells___OkarunF_KS_c[this], OkarunT_Buff_ID) > 0 then
                                set s__OkarunSpells___OkarunF_KS_r3[this]=OkarunT_Speed(s__OkarunSpells___OkarunF_KS_c[this])
                            endif
                        call WOSUI___WUI_TestHeroProgress((s__OkarunSpells___OkarunF_KS_c[this] ) , ( OkarunF_ID ) , ( "Current speed" ) , (( s__OkarunSpells___OkarunF_KS_r3[this] )*1.0) , (( s__OkarunSpells___OkarunF_KS_r5[this] )*1.0) , ( false ) , ( R2SW(s__OkarunSpells___OkarunF_KS_r3[this], 0, 2))) // INLINED!!
                    else
                        set s__OkarunSpells___OkarunF_KS_r2[this]=s__OkarunSpells___OkarunF_KS_r2[this] + 0.03
                    endif
                    if GetUnitAbilityLevel(s__OkarunSpells___OkarunF_KS_c[this], OkarunT_Buff_ID) == 0 and ( GetUnitCurrentOrder(s__OkarunSpells___OkarunF_KS_c[this]) == OrderId("stop") or GetUnitCurrentOrder(s__OkarunSpells___OkarunF_KS_c[this]) == 0 or IsUnitPaused(s__OkarunSpells___OkarunF_KS_c[this]) == true or GetUnitAbilityLevel(s__OkarunSpells___OkarunF_KS_c[this], 'BPSE') == 1 ) and LoadInteger(hs, GetHandleId(s__OkarunSpells___OkarunF_KS_c[this]), OkarunSpells___SH_SPELL_P) == 0 then
                        set s__OkarunSpells___OkarunF_KS_r3[this]=s__OkarunSpells___OkarunF_KS_r3[this] - ( s__OkarunSpells___OkarunF_KS_r5[this] * ( OkarunF_DecreaseSpeedPercentPerSec / 100 ) )
                        if s__OkarunSpells___OkarunF_KS_r3[this] < GetUnitMoveSpeed(s__OkarunSpells___OkarunF_KS_c[this]) then
                      //  if CheckCoordsInRect(gg_rct_Base, GetUnitX(c), GetUnitY(c)) == false and IsUnitType(c,UNIT_TYPE_DEAD)== false and IntegerCd(c,"sound cd",40)  then 
                            
                          //  endif
                            set s__OkarunSpells___OkarunF_KS_r3[this]=GetUnitMoveSpeed(s__OkarunSpells___OkarunF_KS_c[this])
                        endif
                    endif
                    set s__OkarunSpells___OkarunF_KS_r3[this]=RMinBJ(s__OkarunSpells___OkarunF_KS_r3[this], s__OkarunSpells___OkarunF_KS_r5[this])
                    call SaveReal(hs, GetHandleId(s__OkarunSpells___OkarunF_KS_c[this]), OkarunSpells___SH_CURRENT_SPEED1, s__OkarunSpells___OkarunF_KS_r3[this])
                else
                    call WOSUI___WUI_TestHeroProgress((s__OkarunSpells___OkarunF_KS_c[this] ) , ( OkarunF_ID ) , ( "Current speed" ) , (( 0.00 )*1.0) , (( 0.00 )*1.0) , ( true) , "") // INLINED!!
                    call DestroyEffect(s__OkarunSpells___OkarunF_KS_e[this])
                    set s__OkarunSpells___OkarunF_KS_c[this]=null
                    set s__OkarunSpells___OkarunF_KS_td[this]=null
                    set s__OkarunSpells___OkarunF_KS_e[this]=null
                    set s__OkarunSpells___OkarunF_KS_m_OkarunF[i]=s__OkarunSpells___OkarunF_KS_m_OkarunF[s__OkarunSpells___OkarunF_KS_MUI_OkarunF]
                    set s__OkarunSpells___OkarunF_KS_MUI_OkarunF=s__OkarunSpells___OkarunF_KS_MUI_OkarunF - 1
                    set i=i - 1 // revisit: the moved instance must not skip this tick
                    if s__OkarunSpells___OkarunF_KS_MUI_OkarunF == - 1 then
                        call OkarunSpells___OkarunTick_Off(6)
                    endif
                    call s__OkarunSpells___OkarunF_KS_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction
        function s__OkarunSpells___OkarunF_KS_OkarunF_Start takes unit NewC returns nothing
            local integer this= s__OkarunSpells___OkarunF_KS__allocate()
            set s__OkarunSpells___OkarunF_KS_MUI_OkarunF=s__OkarunSpells___OkarunF_KS_MUI_OkarunF + 1
            set s__OkarunSpells___OkarunF_KS_m_OkarunF[s__OkarunSpells___OkarunF_KS_MUI_OkarunF]=this
            set s__OkarunSpells___OkarunF_KS_c[this]=NewC
            set s__OkarunSpells___OkarunF_KS_td[this]=null
            set s__OkarunSpells___OkarunF_KS_check[this]=GetUnitTypeId(s__OkarunSpells___OkarunF_KS_c[this])
            set s__OkarunSpells___OkarunF_KS_r[this]=0
            set s__OkarunSpells___OkarunF_KS_r2[this]=0
            set s__OkarunSpells___OkarunF_KS_r6[this]=0.2
            set s__OkarunSpells___OkarunF_KS_r7[this]=0
            set s__OkarunSpells___OkarunF_KS_k2[this]=GetPlayerId(GetOwningPlayer(s__OkarunSpells___OkarunF_KS_c[this]))
            set s__OkarunSpells___OkarunF_KS_r5[this]=OkarunF_MaxSpeed(s__OkarunSpells___OkarunF_KS_c[this])
            set s__OkarunSpells___OkarunF_KS_r3[this]=GetUnitMoveSpeed(s__OkarunSpells___OkarunF_KS_c[this]) // СЃС‚Р°СЂС‚РѕРІР°СЏ СЃРєРѕСЂРѕСЃС‚СЊ (РєР°Рї РґРІРёР¶РєР°)
            set s__OkarunSpells___OkarunF_KS_e[this]=AddSpecialEffectTarget("war3mapimported\\wos_windwalk blood.mdx", s__OkarunSpells___OkarunF_KS_c[this], "origin")
            if s__OkarunSpells___OkarunF_KS_MUI_OkarunF == 0 then
                call OkarunSpells___OkarunTick_On(6)
            endif
        endfunction

