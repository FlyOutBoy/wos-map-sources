            call StartSpellUnit2(s__AlucardSpells__AlucardSpells_Q_c[this])
            set s__AlucardSpells__AlucardSpells_Q_g[this]=CreateGroup()
            set s__AlucardSpells__AlucardSpells_Q_g2[this]=CreateGroup()
            set s__AlucardSpells__AlucardSpells_Q_u[this]=null
            set s__AlucardSpells__AlucardSpells_Q_a[this]=GAngle2(s__AlucardSpells__AlucardSpells_Q_c[this] , s__AlucardSpells__AlucardSpells_Q_x[this] , s__AlucardSpells__AlucardSpells_Q_y[this]) // Angle Between points
            set s__AlucardSpells__AlucardSpells_Q_check[this]=0
            set s__AlucardSpells__AlucardSpells_Q_k[this]=0
            set s__AlucardSpells__AlucardSpells_Q_aoe[this]=AlucardQ_DamageAoe + 25
            set s__AlucardSpells__AlucardSpells_Q_dmg[this]=GetHeroAgi(s__AlucardSpells__AlucardSpells_Q_c[this], true) * ( AlucardQ2_DamageAgiBase + ( AlucardQ2_DamageAgiStep * ( GetUnitAbilityLevel(s__AlucardSpells__AlucardSpells_Q_c[this], AlucardQ_ID) - 1 ) ) )
            set s__AlucardSpells__AlucardSpells_Q_dmg[this]=s__AlucardSpells__AlucardSpells_Q_dmg[this] + AlucardQ2_Damage2StaticBase + ( AlucardQ2_Damage2StaticStep * ( GetUnitAbilityLevel(s__AlucardSpells__AlucardSpells_Q_c[this], AlucardQ_ID) - 1 ) )
