                        call SetUnitFacing(s__PatriotSpells___PatriotSpells_T2_c[this], s__PatriotSpells___PatriotSpells_T2_a[this] * bj_RADTODEG)

                        // 15 тиков на подъем от 155 до fly
                        set s__PatriotSpells___PatriotSpells_T2_r5[this]=( s__PatriotSpells___PatriotSpells_T2_fly[this] - 155.0 ) / 15.0
                        set s__PatriotSpells___PatriotSpells_T2_r6[this]=SR0(GetUnitX(s__PatriotSpells___PatriotSpells_T2_c[this]) + 150.0 * Cos(s__PatriotSpells___PatriotSpells_T2_a[this]) , GetUnitY(s__PatriotSpells___PatriotSpells_T2_c[this]) + 150.0 * Sin(s__PatriotSpells___PatriotSpells_T2_a[this]) , s__PatriotSpells___PatriotSpells_T2_x[this] , s__PatriotSpells___PatriotSpells_T2_y[this]) / 15.0
                        set s__PatriotSpells___PatriotSpells_T2_scale[this]=0.15
