//library EnvironmentRoundRules:

// Training phase restarts are not completed match rounds.
// Shared by actual decor/train damage and its Game Info snapshot.
function GetEnvironmentRoundNumber takes nothing returns integer
    if TestMode then
        return 1
    endif
    return IMaxBJ(1, CurrentRound)
endfunction


//library EnvironmentRoundRules ends
//library TestHeroAdapter:
function TestHero_Register takes unit u returns nothing
    call sc___prototype13_evaluate(1,u)
endfunction
function TestHero_Reset takes unit u returns nothing
    if u == null then
        return
    endif
    if IsUnitType(u, UNIT_TYPE_DEAD) then
        call ReviveHero(u, GetUnitX(u), GetUnitY(u), false)
    endif
    call SetUnitState(u, UNIT_STATE_LIFE, GetUnitState(u, UNIT_STATE_MAX_LIFE))
    call SetUnitState(u, UNIT_STATE_MANA, GetUnitState(u, UNIT_STATE_MAX_MANA))
    call sc___prototype13_evaluate(2,u)
    call BlzEndUnitAbilityCooldown(u, Q_ID)
    call BlzEndUnitAbilityCooldown(u, W_ID)
    call BlzEndUnitAbilityCooldown(u, E_ID)
    call BlzEndUnitAbilityCooldown(u, R_ID)
    call BlzEndUnitAbilityCooldown(u, T_ID)
    call BlzEndUnitAbilityCooldown(u, F_ID)
    call BlzEndUnitAbilityCooldown(u, G_ID)
    call ClearTextMessages()
endfunction

