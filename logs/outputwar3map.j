    function SacredGearBooster takes unit c,real dmg returns real
    if HasCachedItem(c , SacredGearBooster_Item_ID) > 0 and GetUnitAbilityLevel(c, SacredGearBooster_CDAbility_ID) > 0 and BlzGetUnitAbilityCooldownRemaining(c, SacredGearBooster_CDAbility_ID) == 0 then
            set dmg=dmg + ( GetMainStatValue(c , true) * SacredGearBooster_Damage )
            call BlzStartUnitAbilityCooldown(c, SacredGearBooster_CDAbility_ID, SacredGearBooster_CD)
            if SacredGearBooster_CastAbil != 0 then
                set SacredGearBooster_Proc=true
            endif
            endif
            return dmg
    endfunction
    // Любой нажатый активный предмет (не только с уроном): SGB уходит в КД, а CastCheck режет КД предмета.
    // Предметы с уроном уже прокнули через SacredGearBooster (урон + КД) — повторно не срабатывает.
    function SacredGearBooster_ItemCast takes unit c,integer abilId returns nothing
        local integer slot= 0
        local item it
        if SacredGearBooster_Proc or HasCachedItem(c , SacredGearBooster_Item_ID) == 0 or GetUnitAbilityLevel(c, SacredGearBooster_CDAbility_ID) == 0 or BlzGetUnitAbilityCooldownRemaining(c, SacredGearBooster_CDAbility_ID) > 0 then
            return
        endif
        loop
            exitwhen slot > 5
            set it=UnitItemInSlot(c, slot)
            if it != null and BlzGetItemAbility(it, abilId) != null then
                call BlzStartUnitAbilityCooldown(c, SacredGearBooster_CDAbility_ID, SacredGearBooster_CD)
                set SacredGearBooster_Proc=true
                set slot=6
            endif
            set slot=slot + 1
        endloop
        set it=null
    endfunction
    // Kusanagi active: one dash + strike per enemy in range, then back to the cast point.
    // Paused while dashing; elemental grades are also invulnerable. -1 sec cooldown per target.

        function s__ItemsSpells__ItemsSpells_Kusanagi_finish takes integer this returns nothing
            local real cd
            if GetWidgetLife(s__ItemsSpells__ItemsSpells_Kusanagi_c[this]) > 0.405 then
                call BlinkEff(s__ItemsSpells__ItemsSpells_Kusanagi_c[this])
                call PosUnit(s__ItemsSpells__ItemsSpells_Kusanagi_c[this] , s__ItemsSpells__ItemsSpells_Kusanagi_x[this] , s__ItemsSpells__ItemsSpells_Kusanagi_y[this])
                call BlinkEff(s__ItemsSpells__ItemsSpells_Kusanagi_c[this])
            endif
            call StopSpellUnit2(s__ItemsSpells__ItemsSpells_Kusanagi_c[this])
            if s__ItemsSpells__ItemsSpells_Kusanagi_elem[this] > 0 then
                call UnitRemoveAbility(s__ItemsSpells__ItemsSpells_Kusanagi_c[this], 'Avul')
            endif
            // -1 sec cooldown per struck target
            if s__ItemsSpells__ItemsSpells_Kusanagi_hits[this] > 0 then
                set cd=BlzGetUnitAbilityCooldownRemaining(s__ItemsSpells__ItemsSpells_Kusanagi_c[this], Kusanagi_Abi_ID) - I2R(s__ItemsSpells__ItemsSpells_Kusanagi_hits[this])
                if cd > 0.05 then
                    call BlzStartUnitAbilityCooldown(s__ItemsSpells__ItemsSpells_Kusanagi_c[this], Kusanagi_Abi_ID, cd)
                else
                    call BlzEndUnitAbilityCooldown(s__ItemsSpells__ItemsSpells_Kusanagi_c[this], Kusanagi_Abi_ID)
                endif
            endif
            call DestroyEffect(s__ItemsSpells__ItemsSpells_Kusanagi_aura[this])
            call DestroyGroup(s__ItemsSpells__ItemsSpells_Kusanagi_g[this])
            set s__ItemsSpells__ItemsSpells_Kusanagi_aura[this]=null
            set s__ItemsSpells__ItemsSpells_Kusanagi_g[this]=null
            set s__ItemsSpells__ItemsSpells_Kusanagi_c[this]=null
        endfunction

        function s__ItemsSpells__ItemsSpells_Kusanagi_strike takes integer this returns boolean
            local unit u
            local real a
            local real ux
            local real uy
            loop
                set u=FirstOfGroup(s__ItemsSpells__ItemsSpells_Kusanagi_g[this])
                exitwhen u == null
                call GroupRemoveUnit(s__ItemsSpells__ItemsSpells_Kusanagi_g[this], u)
                exitwhen SpellBool(u) and IsUnitEnemy(u, GetOwningPlayer(s__ItemsSpells__ItemsSpells_Kusanagi_c[this]))
            endloop
            if u == null then
                return false
            endif
            set ux=GetUnitX(u)
            set uy=GetUnitY(u)
            set a=GetRandomReal(0, 359) * bj_DEGTORAD
            call BlinkEff(s__ItemsSpells__ItemsSpells_Kusanagi_c[this])
            call PosUnit(s__ItemsSpells__ItemsSpells_Kusanagi_c[this] , ux - Kusanagi_BehindDistance * Cos(a) , uy - Kusanagi_BehindDistance * Sin(a))
            call SetUnitFacing(s__ItemsSpells__ItemsSpells_Kusanagi_c[this], GAngle(s__ItemsSpells__ItemsSpells_Kusanagi_c[this] , u) * bj_RADTODEG)
            call SetUnitTimeScale(s__ItemsSpells__ItemsSpells_Kusanagi_c[this], 3)
            call SetUnitAnimation(s__ItemsSpells__ItemsSpells_Kusanagi_c[this], "attack")
            set s__ItemsSpells__ItemsSpells_Kusanagi_hits[this]=s__ItemsSpells__ItemsSpells_Kusanagi_hits[this] + 1
            set GearDamageNextSource=(s__ItemsSpells__ItemsSpells_Kusanagi_source[this]) // INLINED!!
            call dmgatk(s__ItemsSpells__ItemsSpells_Kusanagi_c[this] , u , GetAttack(s__ItemsSpells__ItemsSpells_Kusanagi_c[this]) * s__ItemsSpells__ItemsSpells_Kusanagi_mult[this])
            if s__ItemsSpells__ItemsSpells_Kusanagi_elem[this] > 0 then
                set GearDamageNextSource=(s__ItemsSpells__ItemsSpells_Kusanagi_source[this]) // INLINED!!
                call ErzaPassive(s__ItemsSpells__ItemsSpells_Kusanagi_c[this] , u , s__ItemsSpells__ItemsSpells_Kusanagi_elem[this])
            endif
            call DestroyEffect(EffectSpawn(s__ItemsSpells__ItemsSpells_Kusanagi_slash[this] , ux , uy , GetRandomReal(0, 359) , Kusanagi_SlashSpeed , 2.5 , 25))
            call DestroyEffect(EffectSpawn("war3mapimported\\wos_A_[doft]hero_skeletonking_n2s_e_star.mdx" , ux , uy , a * bj_RADTODEG , 0.35 , 3 , 145))
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", u, "chest"))
            call MakeSound("war3mapimported\\Hero_Tomioka_F_Cut")
            if s__ItemsSpells__ItemsSpells_Kusanagi_elem[this] == 1 then
                call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\wos_fire explosion.mdl", u, "chest"))
            elseif s__ItemsSpells__ItemsSpells_Kusanagi_elem[this] == 2 then
                call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\wos_waterexplosion.mdl", u, "chest"))
            elseif s__ItemsSpells__ItemsSpells_Kusanagi_elem[this] == 3 then
                call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\wos_SasukeYh-41.mdl", u, "chest"))
            else
                call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\wos_bloodex-special-23.mdl", u, "chest"))
            endif
            set u=null
            return true
        endfunction

        function s__ItemsSpells__ItemsSpells_Kusanagi_Loop_Kusanagi takes nothing returns nothing
            local integer this
            local integer i= 0
            local boolean alive
            loop
                exitwhen i > s__ItemsSpells__ItemsSpells_Kusanagi_MUI_Kus
                set this=s__ItemsSpells__ItemsSpells_Kusanagi_m_Kus[i]
                set alive=SpellBoolCaster(s__ItemsSpells__ItemsSpells_Kusanagi_c[this])
                if alive then
                    set s__ItemsSpells__ItemsSpells_Kusanagi_r[this]=s__ItemsSpells__ItemsSpells_Kusanagi_r[this] + 0.03
                    if s__ItemsSpells__ItemsSpells_Kusanagi_r[this] >= Kusanagi_StrikeInterval then
                        set s__ItemsSpells__ItemsSpells_Kusanagi_r[this]=0
                        set alive=s__ItemsSpells__ItemsSpells_Kusanagi_strike(this)
                    endif
                endif
                if not alive then
                    call s__ItemsSpells__ItemsSpells_Kusanagi_finish(this)
                    set s__ItemsSpells__ItemsSpells_Kusanagi_m_Kus[i]=s__ItemsSpells__ItemsSpells_Kusanagi_m_Kus[s__ItemsSpells__ItemsSpells_Kusanagi_MUI_Kus]
                    set s__ItemsSpells__ItemsSpells_Kusanagi_MUI_Kus=s__ItemsSpells__ItemsSpells_Kusanagi_MUI_Kus - 1
                    set i=i - 1
                    if s__ItemsSpells__ItemsSpells_Kusanagi_MUI_Kus == - 1 then
                        call ItemsSpells__ItemsTick_Off(17)
                    endif
                    call s__ItemsSpells__ItemsSpells_Kusanagi_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction

        function s__ItemsSpells__ItemsSpells_Kusanagi_Kusanagi_Start takes unit NewC,real tx,real ty returns nothing
            local integer this= s__ItemsSpells__ItemsSpells_Kusanagi__allocate()
            local string auraModel
            set s__ItemsSpells__ItemsSpells_Kusanagi_MUI_Kus=s__ItemsSpells__ItemsSpells_Kusanagi_MUI_Kus + 1
            set s__ItemsSpells__ItemsSpells_Kusanagi_m_Kus[s__ItemsSpells__ItemsSpells_Kusanagi_MUI_Kus]=this
            set s__ItemsSpells__ItemsSpells_Kusanagi_c[this]=NewC
            set s__ItemsSpells__ItemsSpells_Kusanagi_x[this]=GetUnitX(s__ItemsSpells__ItemsSpells_Kusanagi_c[this])
            set s__ItemsSpells__ItemsSpells_Kusanagi_y[this]=GetUnitY(s__ItemsSpells__ItemsSpells_Kusanagi_c[this])
            set s__ItemsSpells__ItemsSpells_Kusanagi_mult[this]=KusanagiGrade_AtkMult
            if HasCachedItem(s__ItemsSpells__ItemsSpells_Kusanagi_c[this] , KusanagiFire_ID) > 0 then
                set s__ItemsSpells__ItemsSpells_Kusanagi_elem[this]=1
                set s__ItemsSpells__ItemsSpells_Kusanagi_source[this]=KusanagiFire_ID
                set s__ItemsSpells__ItemsSpells_Kusanagi_slash[this]="war3mapImported\\wos_KusanagiSlashFire.mdx"
                set auraModel="war3mapImported\\wos_KusanagiAuraFire.mdx"
            elseif HasCachedItem(s__ItemsSpells__ItemsSpells_Kusanagi_c[this] , KusanagiWater_ID) > 0 then
                set s__ItemsSpells__ItemsSpells_Kusanagi_elem[this]=2
                set s__ItemsSpells__ItemsSpells_Kusanagi_source[this]=KusanagiWater_ID
                set s__ItemsSpells__ItemsSpells_Kusanagi_slash[this]="war3mapImported\\wos_BrightBlueSlash.mdx"
                set auraModel="war3mapImported\\wos_KusanagiAuraWater.mdx"
            elseif HasCachedItem(s__ItemsSpells__ItemsSpells_Kusanagi_c[this] , KusanagiElectro_ID) > 0 then
                set s__ItemsSpells__ItemsSpells_Kusanagi_elem[this]=3
                set s__ItemsSpells__ItemsSpells_Kusanagi_source[this]=KusanagiElectro_ID
                set s__ItemsSpells__ItemsSpells_Kusanagi_slash[this]="war3mapImported\\wos_KusanagiSlashElectro.mdx"
                set auraModel="war3mapImported\\wos_KusanagiAuraElectro.mdx"
            else
                set s__ItemsSpells__ItemsSpells_Kusanagi_elem[this]=0
                set s__ItemsSpells__ItemsSpells_Kusanagi_source[this]=Kusanagi_ID
                set s__ItemsSpells__ItemsSpells_Kusanagi_mult[this]=Kusanagi_AtkMult
                set s__ItemsSpells__ItemsSpells_Kusanagi_slash[this]="war3mapImported\\wos_KusanagiSlashWhite.mdx"
                set auraModel="war3mapImported\\wos_KusanagiAuraWhite.mdx"
            endif
            set s__ItemsSpells__ItemsSpells_Kusanagi_aura[this]=AddSpecialEffectTarget(auraModel, s__ItemsSpells__ItemsSpells_Kusanagi_c[this], "chest")
            set s__ItemsSpells__ItemsSpells_Kusanagi_g[this]=CreateGroup()
            call GroupEnumUnitsInRange(s__ItemsSpells__ItemsSpells_Kusanagi_g[this], tx, ty, Kusanagi_Aoe, NoDecor_Cond)
            set s__ItemsSpells__ItemsSpells_Kusanagi_r[this]=Kusanagi_StrikeInterval // first dash on the next tick
            set s__ItemsSpells__ItemsSpells_Kusanagi_hits[this]=0
            call StartSpellUnit2(s__ItemsSpells__ItemsSpells_Kusanagi_c[this])
            if s__ItemsSpells__ItemsSpells_Kusanagi_elem[this] > 0 then
                call UnitAddAbility(s__ItemsSpells__ItemsSpells_Kusanagi_c[this], 'Avul') // elemental grades: invulnerable while dashing
            endif
            if s__ItemsSpells__ItemsSpells_Kusanagi_MUI_Kus == 0 then
                call ItemsSpells__ItemsTick_On(17)
            endif
        endfunction

    // Timed green strength: Hashirama Cells (+15, refresh) and Rhitta (+5 per hit, up to +35).

        function s__ItemsSpells__ItemsSpells_TimedStr_find takes unit u,integer whichKind returns integer
            local integer i= 0
            local integer this
            loop
                exitwhen i > s__ItemsSpells__ItemsSpells_TimedStr_MUI_Str
                set this=s__ItemsSpells__ItemsSpells_TimedStr_m_Str[i]
                if s__ItemsSpells__ItemsSpells_TimedStr_c[this] == u and s__ItemsSpells__ItemsSpells_TimedStr_kind[this] == whichKind then
                    return this
                endif
                set i=i + 1
            endloop
            return 0
        endfunction

        function s__ItemsSpells__ItemsSpells_TimedStr_setStacks takes integer this,integer newStacks returns nothing
            local integer n= 1
            if s__ItemsSpells__ItemsSpells_TimedStr_kind[this] == 1 then
                if newStacks > 0 then
                    call UnitAddAbility(s__ItemsSpells__ItemsSpells_TimedStr_c[this], HashiramaCells_Str_ID)
                    call UnitMakeAbilityPermanent(s__ItemsSpells__ItemsSpells_TimedStr_c[this], true, HashiramaCells_Str_ID)
                    if s__ItemsSpells__ItemsSpells_TimedStr_indicator[this] != null then
                        call SetItemCharges(s__ItemsSpells__ItemsSpells_TimedStr_indicator[this], 15)
                        set s__ItemsSpells__ItemsSpells_TimedStr_indicatorPending[this]=true
                    endif
                else
                    call UnitRemoveAbility(s__ItemsSpells__ItemsSpells_TimedStr_c[this], HashiramaCells_Str_ID)
                    if s__ItemsSpells__ItemsSpells_TimedStr_indicator[this] != null then
                        call SetItemCharges(s__ItemsSpells__ItemsSpells_TimedStr_indicator[this], 0)
                        set s__ItemsSpells__ItemsSpells_TimedStr_indicator[this]=null
                        set s__ItemsSpells__ItemsSpells_TimedStr_indicatorPending[this]=false
                    endif
                endif
            else
                loop
                    exitwhen n > Rhitta_StrMaxStacks
                    if n <= newStacks then
                        if GetUnitAbilityLevel(s__ItemsSpells__ItemsSpells_TimedStr_c[this], Rhitta_Str_ID[n]) == 0 then
                            call UnitAddAbility(s__ItemsSpells__ItemsSpells_TimedStr_c[this], Rhitta_Str_ID[n])
                            call UnitMakeAbilityPermanent(s__ItemsSpells__ItemsSpells_TimedStr_c[this], true, Rhitta_Str_ID[n])
                        endif
                    else
                        call UnitRemoveAbility(s__ItemsSpells__ItemsSpells_TimedStr_c[this], Rhitta_Str_ID[n])
                    endif
                    set n=n + 1
                endloop
            endif
            set s__ItemsSpells__ItemsSpells_TimedStr_stacks[this]=newStacks
        endfunction

        function s__ItemsSpells__ItemsSpells_TimedStr_Loop_TimedStr takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__ItemsSpells__ItemsSpells_TimedStr_MUI_Str
                set this=s__ItemsSpells__ItemsSpells_TimedStr_m_Str[i]
                // Warcraft consumes one charge after SPELL_EFFECT; repair once after that event.
                if s__ItemsSpells__ItemsSpells_TimedStr_indicatorPending[this] then
                    set s__ItemsSpells__ItemsSpells_TimedStr_indicatorPending[this]=false
                    if s__ItemsSpells__ItemsSpells_TimedStr_indicator[this] != null then
                        call SetItemCharges(s__ItemsSpells__ItemsSpells_TimedStr_indicator[this], 15)
                    endif
                endif
                set s__ItemsSpells__ItemsSpells_TimedStr_left[this]=s__ItemsSpells__ItemsSpells_TimedStr_left[this] - 0.05
                if s__ItemsSpells__ItemsSpells_TimedStr_left[this] <= 0 then
                    call s__ItemsSpells__ItemsSpells_TimedStr_setStacks(this,0)
                    set s__ItemsSpells__ItemsSpells_TimedStr_c[this]=null
                    set s__ItemsSpells__ItemsSpells_TimedStr_m_Str[i]=s__ItemsSpells__ItemsSpells_TimedStr_m_Str[s__ItemsSpells__ItemsSpells_TimedStr_MUI_Str]
                    set s__ItemsSpells__ItemsSpells_TimedStr_MUI_Str=s__ItemsSpells__ItemsSpells_TimedStr_MUI_Str - 1
                    set i=i - 1
                    if s__ItemsSpells__ItemsSpells_TimedStr_MUI_Str == - 1 then
                        call ItemsSpells__ItemsTick05_Off(2)
                    endif
                    call s__ItemsSpells__ItemsSpells_TimedStr_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction

        function s__ItemsSpells__ItemsSpells_TimedStr_Add takes unit u,integer whichKind,integer addStacks,integer maxStacks,real duration returns nothing
            local integer this= s__ItemsSpells__ItemsSpells_TimedStr_find(u , whichKind)
            if this == 0 then
                set this=s__ItemsSpells__ItemsSpells_TimedStr__allocate()
                set s__ItemsSpells__ItemsSpells_TimedStr_MUI_Str=s__ItemsSpells__ItemsSpells_TimedStr_MUI_Str + 1
                set s__ItemsSpells__ItemsSpells_TimedStr_m_Str[s__ItemsSpells__ItemsSpells_TimedStr_MUI_Str]=this
                set s__ItemsSpells__ItemsSpells_TimedStr_c[this]=u
                set s__ItemsSpells__ItemsSpells_TimedStr_kind[this]=whichKind
                set s__ItemsSpells__ItemsSpells_TimedStr_indicator[this]=null
                set s__ItemsSpells__ItemsSpells_TimedStr_indicatorPending[this]=false
                set s__ItemsSpells__ItemsSpells_TimedStr_stacks[this]=0
                if s__ItemsSpells__ItemsSpells_TimedStr_MUI_Str == 0 then
                    call ItemsSpells__ItemsTick05_On(2)
                endif
            endif
            if whichKind == 1 then
                if s__ItemsSpells__ItemsSpells_TimedStr_indicator[this] != null then
                    call SetItemCharges(s__ItemsSpells__ItemsSpells_TimedStr_indicator[this], 0)
                endif
                set s__ItemsSpells__ItemsSpells_TimedStr_indicator[this]=GetItemOfTypeFromUnitBJ(u, HashiramaCells_ID)
            endif
            call s__ItemsSpells__ItemsSpells_TimedStr_setStacks(this,IMinBJ(maxStacks, s__ItemsSpells__ItemsSpells_TimedStr_stacks[this] + addStacks))
            set s__ItemsSpells__ItemsSpells_TimedStr_left[this]=duration
        endfunction

    function Kusanagi_Start takes unit c,real x,real y returns nothing
        call s__ItemsSpells__ItemsSpells_Kusanagi_Kusanagi_Start(c , x , y)
    endfunction

    function HashiramaCells_Start takes unit c returns nothing
        local real cost= GetUnitState(c, UNIT_STATE_LIFE) * ( HashiramaCells_HpCost / 100 )
        call SetUnitState(c, UNIT_STATE_LIFE, RMaxBJ(1, GetUnitState(c, UNIT_STATE_LIFE) - cost))
        call s__ItemsSpells__ItemsSpells_TimedStr_Add(c , 1 , 1 , 1 , HashiramaCells_Duration)
        call DestroyEffect(EffectSpawnColor("war3mapimported\\wos_by_wood_bashenan_juqi_2_2.mdl" , GetUnitX(c) , GetUnitY(c) , 0.0 , 0.5 , 3.0 , 155.0 , 125 , 255 , 100 , 255))
    endfunction

    // Hashirama Cells passive: allied heroes near the damaged owner heal 15% of the damage.
    function HashiramaCells_AllyHeal_Start takes unit td,real dmg returns nothing
        local group g= CreateGroup()
        local unit u
        local real heal= dmg * ( HashiramaCells_AllyHeal / 100 )
        call GroupEnumUnitsInRange(g, GetUnitX(td), GetUnitY(td), HashiramaCells_AllyAoe, NoDecor_Cond)
        loop
            set u=FirstOfGroup(g)
            exitwhen u == null
            call GroupRemoveUnit(g, u)
            if u != td and IsUnitType(u, UNIT_TYPE_HERO) and not IsUnitIllusion(u) and GetWidgetLife(u) > 0.405 and IsUnitAlly(u, GetOwningPlayer(td)) then
                call SetHpCurrent2(td , u , heal)
            endif
        endloop
        call DestroyGroup(g)
        set g=null
    endfunction

    function CoreDrill_Buff takes integer typedmg,integer level returns integer
        if typedmg == 1 then
            if level == 1 then
                return 'B052'
            elseif level == 2 then
                return 'B053'
            elseif level == 3 then
                return 'B054'
            elseif level == 4 then
                return 'B055'
            endif
            return 'B056'
        endif
        if level == 1 then
            return 'B04D'
        elseif level == 2 then
            return 'B04E'
        elseif level == 3 then
            return 'B04F'
        elseif level == 4 then
            return 'B050'
        endif
        return 'B051'
    endfunction

    // Shows the current stack count of one type on the holder; the previously shown
    // level's buff is removed first, so only one icon per type remains. Multi-hit
    // abilities do not recast it on every hit: same level within the gap is skipped
    // (the visual buff still has >= Duration - Gap left; stacks live in hs anyway).
    function ItemsSpells__CoreDrill_ShowBuff takes unit c,integer typedmg,integer stacks,real now returns nothing
        local integer h= GetHandleId(c)
        local integer pid= GetPlayerId(GetOwningPlayer(c))
        local integer abi= CoreDrill_PhysAbi
        local unit d
        local integer shownKey= SH_CORE_DRILL_PHYS_SHOWN
        local integer castKey= SH_CORE_DRILL_PHYS_CAST
        local integer shown
        if typedmg == 1 then
            set abi=CoreDrill_MagAbi
            set shownKey=SH_CORE_DRILL_MAG_SHOWN
            set castKey=SH_CORE_DRILL_MAG_CAST
        endif
        set shown=LoadInteger(hs, h, shownKey)
        if shown == stacks and HaveSavedReal(hs, h, castKey) and now - LoadReal(hs, h, castKey) < CoreDrill_RecastGap then
            return
        endif
        if shown != 0 and shown != stacks then
            call UnitRemoveAbility(c, CoreDrill_Buff(typedmg , shown))
        endif
        call SaveInteger(hs, h, shownKey, stacks)
        call SaveReal(hs, h, castKey, now)
        if CoreDrill_Dummy[pid] == null or GetUnitTypeId(CoreDrill_Dummy[pid]) == 0 or GetWidgetLife(CoreDrill_Dummy[pid]) < 1 then
            set CoreDrill_Dummy[pid]=CreateUnit(Player(pid), 'h0C9', GetRectCenterX(gg_rct_Caster), GetRectCenterY(gg_rct_Caster), 0)
            set CoreDrill_DummyAbi[pid]=0
        endif
        set d=CoreDrill_Dummy[pid]
        if CoreDrill_DummyAbi[pid] != abi then
            if CoreDrill_DummyAbi[pid] != 0 then
                call UnitRemoveAbility(d, CoreDrill_DummyAbi[pid])
            endif
            call UnitAddAbility(d, abi)
            set CoreDrill_DummyAbi[pid]=abi
        endif
        call SetUnitAbilityLevel(d, abi, stacks)
        call SetUnitFacing(d, GAngle(d , c) * bj_RADTODEG)
        call IssueTargetOrder(d, "innerfire", c)
        set d=null
    endfunction

    // Core Drill: physical (2) or magic (1) ability damage adds a stack of that type.
    // Expired stacks restart at 1; each new stack refreshes the duration of its type.
    function CoreDrill_AddStack takes unit c,integer typedmg returns nothing
        local integer h= GetHandleId(c)
        local integer stacksKey= SH_CORE_DRILL_PHYS
        local integer endKey= SH_CORE_DRILL_PHYS_END
        local integer stacks= 0
        local real now
        if not CoreDrill_ClockStarted then
            set CoreDrill_ClockStarted=true
            call TimerStart(CoreDrill_Clock, 1000000.0, false, null)
        endif
        set now=TimerGetElapsed(CoreDrill_Clock)
        if typedmg == 1 then
            set stacksKey=SH_CORE_DRILL_MAG
            set endKey=SH_CORE_DRILL_MAG_END
        endif
        if now < LoadReal(hs, h, endKey) then
            set stacks=LoadInteger(hs, h, stacksKey)
        endif
        set stacks=IMinBJ(CoreDrill_MaxStacks, stacks + 1)
        call SaveInteger(hs, h, stacksKey, stacks)
        call SaveReal(hs, h, endKey, now + CoreDrill_Duration)
        call ItemsSpells__CoreDrill_ShowBuff(c , typedmg , stacks , now)
    endfunction

    function RhittaStr_Add takes unit c,integer hits returns nothing
        if hits > 0 then
            call s__ItemsSpells__ItemsSpells_TimedStr_Add(c , 2 , hits , Rhitta_StrMaxStacks , Rhitta_StrDuration)
        endif
    endfunction


        function s__ItemsSpells__ItemsSpells_FunnyBarrel_Loop_FunnyBarrel takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__ItemsSpells__ItemsSpells_FunnyBarrel_MUI_Item1
                set this=s__ItemsSpells__ItemsSpells_FunnyBarrel_m_Item1[i]
                if s__ItemsSpells__ItemsSpells_FunnyBarrel_r[this] <= s__ItemsSpells__ItemsSpells_FunnyBarrel_rmax[this] then
                    set s__ItemsSpells__ItemsSpells_FunnyBarrel_r[this]=s__ItemsSpells__ItemsSpells_FunnyBarrel_r[this] + 0.03
                    call MoveEff(s__ItemsSpells__ItemsSpells_FunnyBarrel_e[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_move[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_a[this])
                    set s__ItemsSpells__ItemsSpells_FunnyBarrel_r3[this]=s__ItemsSpells__ItemsSpells_FunnyBarrel_r3[this] + s__ItemsSpells__ItemsSpells_FunnyBarrel_move[this]
                    set s__ItemsSpells__ItemsSpells_FunnyBarrel_r2[this]=s__ItemsSpells__ItemsSpells_FunnyBarrel_r2[this] + 9
                    call BlzSetSpecialEffectHeight(s__ItemsSpells__ItemsSpells_FunnyBarrel_e[this], Parabola(800 , s__ItemsSpells__ItemsSpells_FunnyBarrel_sr[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_r3[this]))
                    call BlzSetSpecialEffectRoll(s__ItemsSpells__ItemsSpells_FunnyBarrel_e[this], s__ItemsSpells__ItemsSpells_FunnyBarrel_r2[this] * bj_DEGTORAD)
                    if s__ItemsSpells__ItemsSpells_FunnyBarrel_k3[this] == 1 then
                    call MoveEff(s__ItemsSpells__ItemsSpells_FunnyBarrel_e2[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_move[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_a[this])
                    call BlzSetSpecialEffectHeight(s__ItemsSpells__ItemsSpells_FunnyBarrel_e2[this], Parabola(800 , s__ItemsSpells__ItemsSpells_FunnyBarrel_sr[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_r3[this]))
                    endif
                else
                    call GroupEnumUnitsInRange(s__ItemsSpells__ItemsSpells_FunnyBarrel_g[this], s__ItemsSpells__ItemsSpells_FunnyBarrel_x[this], s__ItemsSpells__ItemsSpells_FunnyBarrel_y[this], s__ItemsSpells__ItemsSpells_FunnyBarrel_aoe[this], NoDecor_Cond)
                    loop
                        set s__ItemsSpells__ItemsSpells_FunnyBarrel_u[this]=FirstOfGroup(s__ItemsSpells__ItemsSpells_FunnyBarrel_g[this])
                        exitwhen s__ItemsSpells__ItemsSpells_FunnyBarrel_u[this] == null
                        if SpellBool(s__ItemsSpells__ItemsSpells_FunnyBarrel_u[this]) and IsUnitEnemy(s__ItemsSpells__ItemsSpells_FunnyBarrel_u[this], GetOwningPlayer(s__ItemsSpells__ItemsSpells_FunnyBarrel_c[this])) then
                            set GearDamageNextSource=('I00G') // INLINED!!
                            call dmgmag(s__ItemsSpells__ItemsSpells_FunnyBarrel_c[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_u[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_dmg[this])
                            set GearDamageNextSource=('I00G') // INLINED!!
                            call ErzaPassive(s__ItemsSpells__ItemsSpells_FunnyBarrel_c[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_u[this] , 1)
                        endif
                        call GroupRemoveUnit(s__ItemsSpells__ItemsSpells_FunnyBarrel_g[this], s__ItemsSpells__ItemsSpells_FunnyBarrel_u[this])
                    endloop
                    call DecorRemove(s__ItemsSpells__ItemsSpells_FunnyBarrel_c[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_x[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_y[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_aoe[this] , ItemActive_DecorDamage)
                     if s__ItemsSpells__ItemsSpells_FunnyBarrel_k3[this] == 1 then
                    call DestroyEffect(s__ItemsSpells__ItemsSpells_FunnyBarrel_e2[this])
                    call BambiettaG2_Start(s__ItemsSpells__ItemsSpells_FunnyBarrel_c[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_x[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_y[this])
		    set s__ItemsSpells__ItemsSpells_FunnyBarrel_k3[this]=0
                    endif

                    call DestroyEffect(EffectSpawn("war3mapimported\\wos_GZ_jntxn (11)_R1-200.mdl" , s__ItemsSpells__ItemsSpells_FunnyBarrel_x[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_y[this] , 1 , 1 , 0.65 , 1))
                    call UnitSpawn(Player(PLAYER_NEUTRAL_PASSIVE) , Fire_ID , s__ItemsSpells__ItemsSpells_FunnyBarrel_x[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_y[this] , 1 , 1 , 1.75 , 45 , FunnyBarrel_FireExist)
                    call ColorEffDummy3Alpha((s__ItemsSpells__ItemsSpells_FunnyBarrel_e[this] ) , (( 0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 1)*1.0)) // INLINED!!
                    call DestroyGroup(s__ItemsSpells__ItemsSpells_FunnyBarrel_g[this])
                    set s__ItemsSpells__ItemsSpells_FunnyBarrel_c[this]=null
                    set s__ItemsSpells__ItemsSpells_FunnyBarrel_g[this]=null
                    set s__ItemsSpells__ItemsSpells_FunnyBarrel_u[this]=null
                    set s__ItemsSpells__ItemsSpells_FunnyBarrel_e[this]=null
                    set s__ItemsSpells__ItemsSpells_FunnyBarrel_m_Item1[i]=s__ItemsSpells__ItemsSpells_FunnyBarrel_m_Item1[s__ItemsSpells__ItemsSpells_FunnyBarrel_MUI_Item1]
                    set s__ItemsSpells__ItemsSpells_FunnyBarrel_MUI_Item1=s__ItemsSpells__ItemsSpells_FunnyBarrel_MUI_Item1 - 1
                    if s__ItemsSpells__ItemsSpells_FunnyBarrel_MUI_Item1 == - 1 then
                        call ItemsSpells__ItemsTick_Off(0)
                    endif
                    call s__ItemsSpells__ItemsSpells_FunnyBarrel_deallocate(this)
                    set i=i - 1
                endif
                set i=i + 1
            endloop
        endfunction

        function s__ItemsSpells__ItemsSpells_FunnyBarrel_FunnyBarrel_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__ItemsSpells__ItemsSpells_FunnyBarrel__allocate()
            set s__ItemsSpells__ItemsSpells_FunnyBarrel_MUI_Item1=s__ItemsSpells__ItemsSpells_FunnyBarrel_MUI_Item1 + 1
            set s__ItemsSpells__ItemsSpells_FunnyBarrel_m_Item1[s__ItemsSpells__ItemsSpells_FunnyBarrel_MUI_Item1]=this
            set s__ItemsSpells__ItemsSpells_FunnyBarrel_c[this]=NewC
            set s__ItemsSpells__ItemsSpells_FunnyBarrel_x[this]=NewX
            set s__ItemsSpells__ItemsSpells_FunnyBarrel_y[this]=NewY
            set s__ItemsSpells__ItemsSpells_FunnyBarrel_g[this]=CreateGroup()
            set s__ItemsSpells__ItemsSpells_FunnyBarrel_u[this]=null
            set s__ItemsSpells__ItemsSpells_FunnyBarrel_a[this]=GAngle2(s__ItemsSpells__ItemsSpells_FunnyBarrel_c[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_x[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_y[this])
