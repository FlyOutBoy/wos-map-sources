        function s__MahoragaSpells___MahoragaTick_Loop_Loop takes nothing returns nothing
            if MahoragaSpells___MahoragaTick_Active[0] then
                call s__MahoragaSpells___MahoragaSpells_Q_Loop_MahoragaQ()
            endif
            if MahoragaSpells___MahoragaTick_Active[1] then
                call s__MahoragaSpells___MahoragaSpells_Q_Loop_MahoragaQ2()
            endif
            if MahoragaSpells___MahoragaTick_Active[2] then
                call s__MahoragaSpells___MahoragaSpells_E_Loop_MahoragaE3()
            endif
            if MahoragaSpells___MahoragaTick_Active[3] then
                call s__MahoragaSpells___MahoragaSpells_E_Loop_MahoragaE()
            endif
            if MahoragaSpells___MahoragaTick_Active[4] then
                call s__MahoragaSpells___MahoragaSpells_E_Loop_MahoragaE2()
            endif
            if MahoragaSpells___MahoragaTick_Active[5] then
                call s__MahoragaSpells___MahoragaSpells_W_Loop_MahoragaW2()
            endif
            if MahoragaSpells___MahoragaTick_Active[6] then
                call s__MahoragaSpells___MahoragaSpells_W_Loop_MahoragaW()
            endif
            if MahoragaSpells___MahoragaTick_Active[7] then
                call s__MahoragaSpells___MahoragaSpells_T_Loop_MahoragaT()
            endif
            if MahoragaSpells___MahoragaTick_Active[8] then
                call s__MahoragaSpells___MahoragaSpells_F_Loop_MahoragaF()
            endif
        endfunction

        function s__MahoragaSpells___MahoragaTick_Loop_onInit takes nothing returns nothing
            set MahoragaSpells___MahoragaTick_Callback=function s__MahoragaSpells___MahoragaTick_Loop_Loop
        endfunction


        function s__MahoragaSpells___MahoragaTick10_Loop_Loop takes nothing returns nothing
            if MahoragaSpells___MahoragaTick10_Active[0] then
                call s__MahoragaSpells___MahoragaSpells_G_Loop_MahoragaG()
            endif
        endfunction

        function s__MahoragaSpells___MahoragaTick10_Loop_onInit takes nothing returns nothing
            set MahoragaSpells___MahoragaTick10_Callback=function s__MahoragaSpells___MahoragaTick10_Loop_Loop
        endfunction



