                                set s__PatriotSpells___PatriotSpells_R_check[this]=1
                                call SaveReal(hs, GetHandleId(s__PatriotSpells___PatriotSpells_R_c[this]), PatriotSpells___SH_R_X, s__PatriotSpells___PatriotSpells_R_x1[this])
                                call SaveReal(hs, GetHandleId(s__PatriotSpells___PatriotSpells_R_c[this]), PatriotSpells___SH_R_Y, s__PatriotSpells___PatriotSpells_R_y1[this])
                            endif

                            set s__PatriotSpells___PatriotSpells_R_x1[this]=s__PatriotSpells___PatriotSpells_R_x1[this] + s__PatriotSpells___PatriotSpells_R_move[this] * Cos(s__PatriotSpells___PatriotSpells_R_a[this])
                            set s__PatriotSpells___PatriotSpells_R_y1[this]=s__PatriotSpells___PatriotSpells_R_y1[this] + s__PatriotSpells___PatriotSpells_R_move[this] * Sin(s__PatriotSpells___PatriotSpells_R_a[this])
                            call SaveReal(hs, GetHandleId(s__PatriotSpells___PatriotSpells_R_c[this]), PatriotSpells___SH_R_X, s__PatriotSpells___PatriotSpells_R_x1[this])
                            call SaveReal(hs, GetHandleId(s__PatriotSpells___PatriotSpells_R_c[this]), PatriotSpells___SH_R_Y, s__PatriotSpells___PatriotSpells_R_y1[this])

                            set s__PatriotSpells___PatriotSpells_R_k[this]=0
