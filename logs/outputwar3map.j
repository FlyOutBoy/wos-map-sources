                        set s__PatriotSpells___PatriotSpells_T2_e6[this]=EffectSpawn("war3mapImported\\wos_OPm (434)3small.mdx" , GetUnitX(s__PatriotSpells___PatriotSpells_T2_c[this]) + 150.0 * Cos(s__PatriotSpells___PatriotSpells_T2_a[this]) , GetUnitY(s__PatriotSpells___PatriotSpells_T2_c[this]) + 150.0 * Sin(s__PatriotSpells___PatriotSpells_T2_a[this]) , s__PatriotSpells___PatriotSpells_T2_a[this] * bj_RADTODEG , 2.0 , 3.0 , 125.0)
                    endif

                    if s__PatriotSpells___PatriotSpells_T2_r[this] > PatriotT2_CastTime then
