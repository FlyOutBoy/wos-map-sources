            endif
            if MilimSpells___MilimTick_Active[4] then
                call s__MilimSpells___MilimTKS_Loop_MilimT()
            endif
            if MilimSpells___MilimTick_Active[5] then
                call s__MilimSpells___MilimT2KS_Loop_MilimT2()
            endif
            if MilimSpells___MilimTick_Active[6] then
                call s__MilimSpells___MilimWKS_Loop_MilimW()
            endif
        endfunction

