    function ErzaESpells__ErzaETick10_On takes integer k returns nothing
        if not ErzaESpells__ErzaETick10_Active[k] then
            set ErzaESpells__ErzaETick10_Active[k]=true
            set ErzaESpells__ErzaETick10_Users=ErzaESpells__ErzaETick10_Users + 1
            if ErzaESpells__ErzaETick10_Users == 1 then
                call TimerStart(ErzaESpells__ErzaETick10_Timer, 0.1, true, ErzaESpells__ErzaETick10_Callback)
            endif
        endif
