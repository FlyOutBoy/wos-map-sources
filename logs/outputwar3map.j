//library TojiSpells:

    function TojiSpells___Toji_TrackPointOrder takes nothing returns boolean
        local unit u= GetOrderedUnit()
        local integer ord
        local integer pid
        if GetUnitTypeId(u) == Toji_ID then
            set ord=GetIssuedOrderId()
            if ord == 851971 or ord == 851986 then
                set pid=GetPlayerId(GetOwningPlayer(u))
                set TojiSpells___Toji_LastOrderX[pid]=GetOrderPointX()
                set TojiSpells___Toji_LastOrderY[pid]=GetOrderPointY()
                set TojiSpells___Toji_IsMoving[pid]=true
            endif
        endif
        set u=null
        return false
    endfunction

    function TojiSpells___Toji_TrackStopOrder takes nothing returns boolean
        local unit u= GetOrderedUnit()
        local integer ord
        if GetUnitTypeId(u) == Toji_ID then
            set ord=GetIssuedOrderId()
            if ord == 851972 or ord == 851973 then
                set TojiSpells___Toji_IsMoving[GetPlayerId(GetOwningPlayer(u))]=false
            endif
        endif
        set u=null
        return false
    endfunction

    function TojiSpells___Toji_TrackTargetOrder takes nothing returns boolean
        local unit u= GetOrderedUnit()
        if GetUnitTypeId(u) == Toji_ID then
            set TojiSpells___Toji_IsMoving[GetPlayerId(GetOwningPlayer(u))]=false
        endif
        set u=null
        return false
    endfunction

    function TojiSpells___TojiE_AddLeapBuff takes unit c returns nothing
        call BuffUnit01(c , c , TojiE_AbiBuff_ID , "innerfire" , 1)
    endfunction

    function TojiSpells___TojiE_ConsumeLeapBonus takes unit c returns real
        local integer key= TojiSpells___SH_TOJIE_LEAPBUFFSTACKS
        local integer stacks= GetUnitAbilityLevel(c, TojiE_Buff_ID)
        if stacks <= 0 then
            return 0.0
        endif
        call UnitRemoveAbility(c, TojiE_Buff_ID)
        call SaveInteger(hs, GetHandleId(c), key, 0)
        return GetHeroAgi(c, true) * TojiE_NextAbilityAgiBonus * stacks
    endfunction

    function TojiE_GetLeapBuffStacks takes unit c returns integer
        return LoadInteger(hs, GetHandleId(c), TojiSpells___SH_TOJIE_LEAPBUFFSTACKS)
    endfunction

    function TojiSpells___TojiAbilityDamage takes unit c,unit td,real damage returns real
        local integer stacks= 0
        if c == null or td == null or GetUnitTypeId(c) != Toji_ID or damage <= 0.00 then
            return damage
        endif

        if GetUnitAbilityLevel(td, TojiG_Debuff5_ID) > 0 then
            set stacks=5
            call UnitRemoveAbility(td, TojiG_Debuff5_ID)
        elseif GetUnitAbilityLevel(td, TojiG_Debuff4_ID) > 0 then
            set stacks=5
            call UnitRemoveAbility(td, TojiG_Debuff4_ID)
        elseif GetUnitAbilityLevel(td, TojiG_Debuff3_ID) > 0 then
            set stacks=4
            call UnitRemoveAbility(td, TojiG_Debuff3_ID)
        elseif GetUnitAbilityLevel(td, TojiG_Debuff2_ID) > 0 then
            set stacks=3
            call UnitRemoveAbility(td, TojiG_Debuff2_ID)
        elseif GetUnitAbilityLevel(td, TojiG_Debuff1_ID) > 0 then
            set stacks=2
            call UnitRemoveAbility(td, TojiG_Debuff1_ID)
        endif

        if stacks > 0 then
            call BuffUnit01(c , td , TojiG_AbiDebuff_ID , "curse" , stacks)
            set damage=damage * ( 1.00 + stacks * TojiG_DamageIncreasePerStack / 100.00 )
        endif
        return damage
    endfunction

    function TojiSpells___TojiTimer03Acquire takes nothing returns nothing
        set TojiSpells___TojiTimer03Users=TojiSpells___TojiTimer03Users + 1
        if TojiSpells___TojiTimer03Users == 1 then
            call TimerStart(TojiSpells___TojiTimer03, 0.03, true, TojiSpells___TojiTimer03Callback)
        endif
    endfunction

    function TojiSpells___TojiTimer03Release takes nothing returns nothing
        set TojiSpells___TojiTimer03Users=TojiSpells___TojiTimer03Users - 1
        if TojiSpells___TojiTimer03Users <= 0 then
            set TojiSpells___TojiTimer03Users=0
            call PauseTimer(TojiSpells___TojiTimer03)
        endif
    endfunction

    function TojiSpells___TojiTimer05Acquire takes nothing returns nothing
        set TojiSpells___TojiTimer05Users=TojiSpells___TojiTimer05Users + 1
        if TojiSpells___TojiTimer05Users == 1 then
            call TimerStart(TojiSpells___TojiTimer05, 0.05, true, TojiSpells___TojiTimer05Callback)
        endif
    endfunction

    function TojiSpells___TojiTimer05Release takes nothing returns nothing
        set TojiSpells___TojiTimer05Users=TojiSpells___TojiTimer05Users - 1
        if TojiSpells___TojiTimer05Users <= 0 then
            set TojiSpells___TojiTimer05Users=0
            call PauseTimer(TojiSpells___TojiTimer05)
        endif
    endfunction

    // Invulnerability: this spell contains a StartSpellUnit/Avul phase.


        function s__TojiSpells___TojiSpells_Q_Loop_TojiQ takes nothing returns nothing
            local integer i= 0
            local integer this
            local unit picked
            local real dx
            local real dy
            local real distance
            local real step
            local real hitDamage
            local boolean remove
            local real rr1
            local real rr2
            local boolean finishAnimation
            local real fly= 150.0
            local real rr4= 50.0

            loop
                exitwhen i > s__TojiSpells___TojiSpells_Q_MUI_TojiQ
