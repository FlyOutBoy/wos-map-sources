        function s__RaidenSpells___RaidenQ_KS_RaidenQ_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__RaidenSpells___RaidenQ_KS__allocate()
            set s__RaidenSpells___RaidenQ_KS_MUI_RaidenQ=s__RaidenSpells___RaidenQ_KS_MUI_RaidenQ + 1
            set s__RaidenSpells___RaidenQ_KS_m_RaidenQ[s__RaidenSpells___RaidenQ_KS_MUI_RaidenQ]=this
            set s__RaidenSpells___RaidenQ_KS_c[this]=NewC
            set s__RaidenSpells___RaidenQ_KS_x[this]=NewX
            set s__RaidenSpells___RaidenQ_KS_y[this]=NewY
            set s__RaidenSpells___RaidenQ_KS_r[this]=0
            set s__RaidenSpells___RaidenQ_KS_r2[this]=10
            set s__RaidenSpells___RaidenQ_KS_r3[this]=1
            set s__RaidenSpells___RaidenQ_KS_k2[this]=0
            set s__RaidenSpells___RaidenQ_KS_check[this]=0
            call DebugUnit2(s__RaidenSpells___RaidenQ_KS_c[this])
            set s__RaidenSpells___RaidenQ_KS_dashTravelled[this]=0
            set s__RaidenSpells___RaidenQ_KS_move[this]=60
            set s__RaidenSpells___RaidenQ_KS_sr[this]=SR3(s__RaidenSpells___RaidenQ_KS_c[this] , s__RaidenSpells___RaidenQ_KS_x[this] , s__RaidenSpells___RaidenQ_KS_y[this])
            if s__RaidenSpells___RaidenQ_KS_sr[this] < RaidenQ_MinMove then
                set s__RaidenSpells___RaidenQ_KS_sr[this]=RaidenQ_MinMove
            endif
            set s__RaidenSpells___RaidenQ_KS_r_prepare[this]=RaidenQ_CastTime
            set s__RaidenSpells___RaidenQ_KS_rmax[this]=s__RaidenSpells___RaidenQ_KS_r_prepare[this] + ( ( s__RaidenSpells___RaidenQ_KS_sr[this] / s__RaidenSpells___RaidenQ_KS_move[this] ) * 0.03 )
            call SaveInteger(hs, GetHandleId(s__RaidenSpells___RaidenQ_KS_c[this]), RaidenSpells___SH_Q_ABI, 1)
            set s__RaidenSpells___RaidenQ_KS_g[this]=CreateGroup()
            set s__RaidenSpells___RaidenQ_KS_g2[this]=CreateGroup()
            set s__RaidenSpells___RaidenQ_KS_scale[this]=5.75
            set s__RaidenSpells___RaidenQ_KS_u[this]=null
            set s__RaidenSpells___RaidenQ_KS_check2[this]=0
            if LoadInteger(hs, GetHandleId(s__RaidenSpells___RaidenQ_KS_c[this]), RaidenSpells___SH_RAIDEN_T2) > 0 then
                set s__RaidenSpells___RaidenQ_KS_k2[this]=2
            elseif LoadInteger(hs, GetHandleId(s__RaidenSpells___RaidenQ_KS_c[this]), RaidenSpells___SH_RAIDEN_T) > 0 then
                set s__RaidenSpells___RaidenQ_KS_k2[this]=1
            elseif LoadInteger(hs, GetHandleId(s__RaidenSpells___RaidenQ_KS_c[this]), RaidenSpells___SH_RAIDEN_W) > 0 then
                set s__RaidenSpells___RaidenQ_KS_check2[this]=1
            endif
            if s__RaidenSpells___RaidenQ_KS_k2[this] == 2 then
                set s__RaidenSpells___RaidenQ_KS_src[this]=DamageSourceVariant(RaidenQ_ID , 2 , "TTQ")
            else
                set s__RaidenSpells___RaidenQ_KS_src[this]=DamageSourceVariant(RaidenQ_ID , s__RaidenSpells___RaidenQ_KS_k2[this] , "TQ")
            endif
            set s__RaidenSpells___RaidenQ_KS_a[this]=GAngle2(s__RaidenSpells___RaidenQ_KS_c[this] , s__RaidenSpells___RaidenQ_KS_x[this] , s__RaidenSpells___RaidenQ_KS_y[this])
            set s__RaidenSpells___RaidenQ_KS_aoe[this]=RaidenQ_DamageAoeCheck
            set s__RaidenSpells___RaidenQ_KS_dmg[this]=GetHeroAgi(s__RaidenSpells___RaidenQ_KS_c[this], true) * ( RaidenQ_DamageAgiBase + ( RaidenQ_DamageAgiStep * ( GetUnitAbilityLevel(s__RaidenSpells___RaidenQ_KS_c[this], RaidenQ_ID) - 1 ) ) )
            set s__RaidenSpells___RaidenQ_KS_dmg[this]=s__RaidenSpells___RaidenQ_KS_dmg[this] + RaidenQ_Damage2StaticBase + ( RaidenQ_Damage2StaticStep * ( GetUnitAbilityLevel(s__RaidenSpells___RaidenQ_KS_c[this], RaidenQ_ID) - 1 ) )
            if s__RaidenSpells___RaidenQ_KS_k2[this] == 2 then
                set s__RaidenSpells___RaidenQ_KS_move[this]=120
                set s__RaidenSpells___RaidenQ_KS_scale[this]=6.3
                set s__RaidenSpells___RaidenQ_KS_r_prepare[this]=RaidenQ_CastTime + 0.33
                set s__RaidenSpells___RaidenQ_KS_rmax[this]=s__RaidenSpells___RaidenQ_KS_r_prepare[this] + 0.42
                call SetUnitAnimationByIndex(s__RaidenSpells___RaidenQ_KS_c[this], 6)
                call SetUnitTimeScale(s__RaidenSpells___RaidenQ_KS_c[this], 0.5)
                call MakeSound("war3mapimported\\Hero_Raiden_TT Q")
                call MakeSound("war3mapimported\\Hero_Raiden_TT_Q_1")
                set s__RaidenSpells___RaidenQ_KS_dmg[this]=s__RaidenSpells___RaidenQ_KS_dmg[this] + GetHeroAgi(s__RaidenSpells___RaidenQ_KS_c[this], true) * RaidenTTQ_DamageAgiBonus
            elseif s__RaidenSpells___RaidenQ_KS_k2[this] == 1 then
                set s__RaidenSpells___RaidenQ_KS_move[this]=RaidenTQ_Range / 15.0
                set s__RaidenSpells___RaidenQ_KS_scale[this]=6.3
                set s__RaidenSpells___RaidenQ_KS_r_prepare[this]=RaidenQ_CastTime + 0.27
                set s__RaidenSpells___RaidenQ_KS_rmax[this]=s__RaidenSpells___RaidenQ_KS_r_prepare[this] + 0.45
                call SetUnitAnimationByIndex(s__RaidenSpells___RaidenQ_KS_c[this], 12)
                call SetUnitTimeScale(s__RaidenSpells___RaidenQ_KS_c[this], 1.25)
                call MakeSound("war3mapimported\\Hero_Raiden_TQ")
                set s__RaidenSpells___RaidenQ_KS_dmg[this]=s__RaidenSpells___RaidenQ_KS_dmg[this] + GetHeroAgi(s__RaidenSpells___RaidenQ_KS_c[this], true) * RaidenTQ_DamageAgiBonus
            elseif s__RaidenSpells___RaidenQ_KS_k2[this] == 0 then
                call SetUnitAnimationByIndex(s__RaidenSpells___RaidenQ_KS_c[this], 21)
                call MakeSound("war3mapimported\\Hero_Raiden_Q")
                set s__RaidenSpells___RaidenQ_KS_dmg[this]=s__RaidenSpells___RaidenQ_KS_dmg[this] / 3
                call SetUnitTimeScale(s__RaidenSpells___RaidenQ_KS_c[this], 1)
            endif
            call SetUnitFacing(s__RaidenSpells___RaidenQ_KS_c[this], s__RaidenSpells___RaidenQ_KS_a[this] * bj_RADTODEG)
            set s__RaidenSpells___RaidenQ_KS_r5[this]=0
            if s__RaidenSpells___RaidenQ_KS_MUI_RaidenQ == 0 then
                call RaidenSpells___RaidenTick_On(0)
            endif
        endfunction
    
    function RaidenSpells___OnRaidenPointOrder takes nothing returns boolean
        local unit u= GetOrderedUnit()
        local integer id= GetUnitTypeId(u)
        local integer ord= GetIssuedOrderId()
        if id == Raiden_ID or id == Raiden_Morph_ID then
            if ord == 851971 or ord == 851986 or ord == 851990 then
                call SaveInteger(hs, GetHandleId(u), RaidenSpells___SH_ORD_MODE, 1)
                call SaveInteger(hs, GetHandleId(u), RaidenSpells___SH_ORD_ID, ord)
                call SaveReal(hs, GetHandleId(u), RaidenSpells___SH_ORD_X, GetOrderPointX())
                call SaveReal(hs, GetHandleId(u), RaidenSpells___SH_ORD_Y, GetOrderPointY())
            endif
        endif
        set u=null
        return false
    endfunction

    function RaidenSpells___OnRaidenTargetOrder takes nothing returns boolean
        local unit u= GetOrderedUnit()
        local integer id= GetUnitTypeId(u)
        local integer ord= GetIssuedOrderId()
        if id == Raiden_ID or id == Raiden_Morph_ID then
            if ord == 851971 or ord == 851983 then
                call SaveInteger(hs, GetHandleId(u), RaidenSpells___SH_ORD_MODE, 2)
                call SaveInteger(hs, GetHandleId(u), RaidenSpells___SH_ORD_ID, ord)
                call SaveUnitHandle(hs, GetHandleId(u), RaidenSpells___SH_ORD_TARGET, GetOrderTargetUnit())
            endif
        endif
        set u=null
        return false
    endfunction

    function RaidenSpells___OnRaidenImmediateOrder takes nothing returns boolean
        local unit u= GetOrderedUnit()
        local integer id= GetUnitTypeId(u)
        local integer ord= GetIssuedOrderId()
        if id == Raiden_ID or id == Raiden_Morph_ID then
            if ord == 851972 or ord == 851993 then
                call SaveInteger(hs, GetHandleId(u), RaidenSpells___SH_ORD_MODE, 0)
            endif
        endif
        set u=null
        return false
    endfunction

    function Raiden_RestoreOrder takes unit c,integer animIndex returns nothing
        local integer mode= LoadInteger(hs, GetHandleId(c), RaidenSpells___SH_ORD_MODE)
        local real ox
        local real oy
        local real dx
        local real dy
        local integer oid
        local unit tu

        if mode == 1 then
            set ox=LoadReal(hs, GetHandleId(c), RaidenSpells___SH_ORD_X)
            set oy=LoadReal(hs, GetHandleId(c), RaidenSpells___SH_ORD_Y)
            set dx=ox - GetUnitX(c)
            set dy=oy - GetUnitY(c)
            // Если до точки назначения больше 75 единиц — продолжаем бег
            if ( dx * dx + dy * dy ) > 5625.0 then
                set oid=LoadInteger(hs, GetHandleId(c), RaidenSpells___SH_ORD_ID)
                call IssuePointOrderById(c, oid, ox, oy)
                return
            endif
        elseif mode == 2 then
            set tu=LoadUnitHandle(hs, GetHandleId(c), RaidenSpells___SH_ORD_TARGET)
            if tu != null and GetWidgetLife(tu) > 0.405 then
                set oid=LoadInteger(hs, GetHandleId(c), RaidenSpells___SH_ORD_ID)
                call IssueTargetOrderById(c, oid, tu)
                set tu=null
                return
            endif
            set tu=null
        endif

        // Если стоял на месте или уже дошёл до цели
        call SetUnitAnimationByIndex(c, animIndex)
    endfunction

        function s__RaidenSpells___RaidenOrderInit_onInit takes nothing returns nothing
            local trigger tPoint= CreateTrigger()
            local trigger tTarget= CreateTrigger()
            local trigger tImmediate= CreateTrigger()
            local integer i= 0
            loop
                exitwhen i >= 16
                call TriggerRegisterPlayerUnitEvent(tPoint, Player(i), EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER, null)
                call TriggerRegisterPlayerUnitEvent(tTarget, Player(i), EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER, null)
                call TriggerRegisterPlayerUnitEvent(tImmediate, Player(i), EVENT_PLAYER_UNIT_ISSUED_ORDER, null)
                set i=i + 1
            endloop
            call TriggerAddCondition(tPoint, Condition(function RaidenSpells___OnRaidenPointOrder))
            call TriggerAddCondition(tTarget, Condition(function RaidenSpells___OnRaidenTargetOrder))
            call TriggerAddCondition(tImmediate, Condition(function RaidenSpells___OnRaidenImmediateOrder))
        endfunction



        function s__RaidenSpells___RaidenW_KS_Loop_RaidenW takes nothing returns nothing
            local integer this
            local integer i= 0

            loop
                exitwhen i > s__RaidenSpells___RaidenW_KS_MUI_RaidenW
                set this=s__RaidenSpells___RaidenW_KS_m_RaidenW[i]
                if SpellBoolCaster(s__RaidenSpells___RaidenW_KS_c[this]) and s__RaidenSpells___RaidenW_KS_r[this] <= s__RaidenSpells___RaidenW_KS_rmax[this] and LoadInteger(hs, GetHandleId(s__RaidenSpells___RaidenW_KS_c[this]), RaidenSpells___SH_RAIDEN_T) == 0 then
                    if not IsUnitPaused(s__RaidenSpells___RaidenW_KS_c[this]) then
                        set s__RaidenSpells___RaidenW_KS_r[this]=s__RaidenSpells___RaidenW_KS_r[this] + 0.03
                    endif
                    if s__RaidenSpells___RaidenW_KS_r[this] == 0.15 then
                        set s__RaidenSpells___RaidenW_KS_r6[this]=BlzGetUnitAbilityCooldown(s__RaidenSpells___RaidenW_KS_c[this], RaidenW_ID, GetUnitAbilityLevel(s__RaidenSpells___RaidenW_KS_c[this], RaidenW_ID) - 1)
                    endif
                    if s__RaidenSpells___RaidenW_KS_r3[this] > 0.15 then
                        set s__RaidenSpells___RaidenW_KS_r3[this]=0
                        call BlzStartUnitAbilityCooldown(s__RaidenSpells___RaidenW_KS_c[this], RaidenW_ID, s__RaidenSpells___RaidenW_KS_r6[this])
                    else
                        set s__RaidenSpells___RaidenW_KS_r3[this]=s__RaidenSpells___RaidenW_KS_r3[this] + 0.03
                    endif
                    if s__RaidenSpells___RaidenW_KS_r[this] == 0.51 then
                        call BlzSetSpecialEffectTimeScale(s__RaidenSpells___RaidenW_KS_e[this], 0.25)
                    endif
                    if s__RaidenSpells___RaidenW_KS_r[this] > 0.27 then
                        set s__RaidenSpells___RaidenW_KS_a[this]=GetUnitFacing(s__RaidenSpells___RaidenW_KS_td[this]) * bj_DEGTORAD
