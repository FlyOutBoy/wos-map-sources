                call SaveReal(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 1000 + n, targetX)
                call SaveReal(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 2000 + n, targetY)
                call SaveReal(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 3000 + n, targetZ)
                call SaveReal(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 4000 + n, 0.80)
                call SaveInteger(TojiSpells___TojiR_Hash, s__TojiSpells___TojiSpells_R_Insectoids_effectParent[this], 12000 + n, 0)
