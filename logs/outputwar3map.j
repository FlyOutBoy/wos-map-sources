    function InoriSpells___InoriTick10_On takes integer k returns nothing
        if not InoriSpells___InoriTick10_Active[k] then
            set InoriSpells___InoriTick10_Active[k]=true
            set InoriSpells___InoriTick10_Users=InoriSpells___InoriTick10_Users + 1
            if InoriSpells___InoriTick10_Users == 1 then
                call TimerStart(InoriSpells___InoriTick10_Timer, 0.1, true, InoriSpells___InoriTick10_Callback)
            endif
        endif
    endfunction

    function InoriSpells___InoriTick10_Off takes integer k returns nothing
        if InoriSpells___InoriTick10_Active[k] then
            set InoriSpells___InoriTick10_Active[k]=false
            set InoriSpells___InoriTick10_Users=InoriSpells___InoriTick10_Users - 1
            if InoriSpells___InoriTick10_Users <= 0 then
                set InoriSpells___InoriTick10_Users=0
                call PauseTimer(InoriSpells___InoriTick10_Timer)
            endif
        endif
    endfunction


    function InoriSpells___InoriTick_On takes integer k returns nothing
        if not InoriSpells___InoriTick_Active[k] then
            set InoriSpells___InoriTick_Active[k]=true
            set InoriSpells___InoriTick_Users=InoriSpells___InoriTick_Users + 1
            if InoriSpells___InoriTick_Users == 1 then
                call TimerStart(InoriSpells___InoriTick_Timer, 0.03, true, InoriSpells___InoriTick_Callback)
            endif
        endif
    endfunction

    function InoriSpells___InoriTick_Off takes integer k returns nothing
        if InoriSpells___InoriTick_Active[k] then
            set InoriSpells___InoriTick_Active[k]=false
            set InoriSpells___InoriTick_Users=InoriSpells___InoriTick_Users - 1
            if InoriSpells___InoriTick_Users <= 0 then
                set InoriSpells___InoriTick_Users=0
                call PauseTimer(InoriSpells___InoriTick_Timer)
            endif
        endif
    endfunction




    function InoriCrystalMode takes unit c returns boolean
        return LoadInteger(hs, GetHandleId(c), InoriSpells___SH_INORI_E_ACTIVE) == 1 or LoadInteger(hs, GetHandleId(c), InoriSpells___SH_MODE_T) == 1
    endfunction

    // After every E / T2 change and skin swap (a skin swap restores the skin's missile art).
    function InoriAttackArt takes unit c returns nothing
        if InoriCrystalMode(c) then
            call BlzSetUnitAttackCooldown(c, 1.8, 0)
            call BlzSetUnitWeaponStringField(c, UNIT_WEAPON_SF_ATTACK_PROJECTILE_ART, 0, "")
        else
            call BlzSetUnitAttackCooldown(c, 2.0, 0)
            call BlzSetUnitWeaponStringField(c, UNIT_WEAPON_SF_ATTACK_PROJECTILE_ART, 0, InoriAtk_Bullet)
        endif
    endfunction


    

    function BuffUnitInori2 takes unit c,unit u,integer level returns nothing
            local integer i= GetPlayerId(GetOwningPlayer(c))
            if inoridummy1[i] == null or GetWidgetLife(inoridummy1[i]) < 1 then
                set inoridummy1[i]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'h0C9', GetRectCenterX(gg_rct_Caster), GetRectCenterY(gg_rct_Caster), 0)
                call UnitAddAbility(inoridummy1[i], 'A06G')
            endif
            if level > 0 then
                if GetUnitAbilityLevel(inoridummy1[i], 'A06G') == 0 then
                    call UnitAddAbility(inoridummy1[i], 'A06G')
                endif
                call SetUnitAbilityLevel(inoridummy1[i], 'A06G', level)
                call SetUnitFacing(inoridummy1[i], GAngle(inoridummy1[i] , u) * bj_RADTODEG)
                call IssueTargetOrder(inoridummy1[i], "curse", u)
            endif
    endfunction

    // Invulnerability: this spell contains a StartSpellUnit/Avul phase.
        function s__InoriSpells___InoriQ_KS_Loop_InoriQ takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__InoriSpells___InoriQ_KS_MUI_InoriQ
                set this=s__InoriSpells___InoriQ_KS_m_InoriQ[i]
                if SpellBoolCaster(s__InoriSpells___InoriQ_KS_c[this]) and s__InoriSpells___InoriQ_KS_r[this] <= s__InoriSpells___InoriQ_KS_rmax[this] then
                    set s__InoriSpells___InoriQ_KS_r[this]=I2R(R2I(( s__InoriSpells___InoriQ_KS_r[this] + 0.03 ) * 1000.0 + 0.5)) / 1000.0
                    if s__InoriSpells___InoriQ_KS_check2[this] == 0 then
                        if s__InoriSpells___InoriQ_KS_check[this] == 0 then
                            call DebugUnit2(s__InoriSpells___InoriQ_KS_c[this])
                            if s__InoriSpells___InoriQ_KS_r[this] >= 0.45 then
                                call StopSpellUnit2(s__InoriSpells___InoriQ_KS_c[this])
                                set s__InoriSpells___InoriQ_KS_check[this]=1
                                set s__InoriSpells___InoriQ_KS_k2[this]=0
                                set s__InoriSpells___InoriQ_KS_move[this]=150
                                set s__InoriSpells___InoriQ_KS_r5[this]=0
                                set s__InoriSpells___InoriQ_KS_r6[this]=1
                                set s__InoriSpells___InoriQ_KS_x1[this]=GetUnitX(s__InoriSpells___InoriQ_KS_c[this]) + 30 * Cos(s__InoriSpells___InoriQ_KS_a[this])
                                set s__InoriSpells___InoriQ_KS_y1[this]=GetUnitY(s__InoriSpells___InoriQ_KS_c[this]) + 30 * Sin(s__InoriSpells___InoriQ_KS_a[this])
                                call SetUnitAnimationByIndex(s__InoriSpells___InoriQ_KS_c[this], 3)
                                call DestroyEffect(EffectSpawn("war3mapImported\\wos_Alucard bulletfire.mdl" , s__InoriSpells___InoriQ_KS_x1[this] + 35 * Cos(s__InoriSpells___InoriQ_KS_a[this]) , s__InoriSpells___InoriQ_KS_y1[this] + 35 * Sin(s__InoriSpells___InoriQ_KS_a[this]) , s__InoriSpells___InoriQ_KS_a[this] * bj_RADTODEG , 1 , 3 , 100))
                                call MakeSound("war3mapimported\\HeroInori_Q2")
                                set s__InoriSpells___InoriQ_KS_e[this]=EffectSpawn("war3mapImported\\wos_Alucard bullet.mdl" , s__InoriSpells___InoriQ_KS_x1[this] , s__InoriSpells___InoriQ_KS_y1[this] , s__InoriSpells___InoriQ_KS_a[this] * bj_RADTODEG , 1 , 0.7 , 150)
                                set s__InoriSpells___InoriQ_KS_e2[this]=EffectSpawn("war3mapImported\\wos_Marco bullet.mdl" , s__InoriSpells___InoriQ_KS_x1[this] , s__InoriSpells___InoriQ_KS_y1[this] , s__InoriSpells___InoriQ_KS_a[this] * bj_RADTODEG , 0.5 , 0.7 , 150)
                                call ColorEffDummy3Alpha((EffectSpawn("war3mapImported\\wos_alucard bullet_backward.mdl" , s__InoriSpells___InoriQ_KS_x1[this] + 130 * Cos(s__InoriSpells___InoriQ_KS_a[this]) , GetUnitY(s__InoriSpells___InoriQ_KS_c[this]) + 130 * Sin(s__InoriSpells___InoriQ_KS_a[this]) , GetRandomReal(0, 359) , 1 , 1 , 0) ) , (( 1 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 1)*1.0)) // INLINED!!
                                set s__InoriSpells___InoriQ_KS_rmax[this]=2
                                set s__InoriSpells___InoriQ_KS_r[this]=0
                            endif
                        elseif s__InoriSpells___InoriQ_KS_check[this] == 1 then
                            if s__InoriSpells___InoriQ_KS_r5[this] >= s__InoriSpells___InoriQ_KS_r7[this] or s__InoriSpells___InoriQ_KS_k2[this] > 0 then
                                set s__InoriSpells___InoriQ_KS_r[this]=9999
                            endif
                            set s__InoriSpells___InoriQ_KS_k[this]=0
                           
                            set s__InoriSpells___InoriQ_KS_r5[this]=s__InoriSpells___InoriQ_KS_r5[this] + s__InoriSpells___InoriQ_KS_move[this]
                            call MoveEff2(s__InoriSpells___InoriQ_KS_e[this] , s__InoriSpells___InoriQ_KS_move[this] , s__InoriSpells___InoriQ_KS_a[this])
                            call MoveEff2(s__InoriSpells___InoriQ_KS_e2[this] , s__InoriSpells___InoriQ_KS_move[this] , s__InoriSpells___InoriQ_KS_a[this])
                            if s__InoriSpells___InoriQ_KS_r6[this] >= 0.0 then
                                set s__InoriSpells___InoriQ_KS_r6[this]=0
                                call GroupClear(s__InoriSpells___InoriQ_KS_g[this])
                                call GroupEnumUnitsInRange(s__InoriSpells___InoriQ_KS_g[this], (BlzGetLocalSpecialEffectX((s__InoriSpells___InoriQ_KS_e[this]))), (BlzGetLocalSpecialEffectY((s__InoriSpells___InoriQ_KS_e[this]))), s__InoriSpells___InoriQ_KS_aoe[this], NoDecor_Cond) // INLINED!!
                                loop
                                    set s__InoriSpells___InoriQ_KS_u[this]=FirstOfGroup(s__InoriSpells___InoriQ_KS_g[this])
                                    exitwhen s__InoriSpells___InoriQ_KS_u[this] == null or s__InoriSpells___InoriQ_KS_k2[this] > 0
                                    if SpellBool(s__InoriSpells___InoriQ_KS_u[this]) and IsUnitEnemy(s__InoriSpells___InoriQ_KS_u[this], GetOwningPlayer(s__InoriSpells___InoriQ_KS_c[this])) and IsUnitInGroup(s__InoriSpells___InoriQ_KS_u[this], s__InoriSpells___InoriQ_KS_g2[this]) == false then
                                        if s__InoriSpells___InoriQ_KS_k2[this] == 0 then
                                            set GearDamageNextSource=(s__InoriSpells___InoriQ_KS_src[this]) // INLINED!!
                                            call dmgmag(s__InoriSpells___InoriQ_KS_c[this] , s__InoriSpells___InoriQ_KS_u[this] , s__InoriSpells___InoriQ_KS_dmg[this])
                                            if LoadInteger(hs, GetHandleId(s__InoriSpells___InoriQ_KS_c[this]), InoriSpells___SH_INORI_E_ACTIVE) == 0 and LoadInteger(hs, GetHandleId(s__InoriSpells___InoriQ_KS_c[this]), InoriSpells___SH_PAS_CD) == 0 and LoadInteger(hs, GetHandleId(s__InoriSpells___InoriQ_KS_c[this]), InoriSpells___SH_MODE_T) == 0 then
                                                set s__InoriSpells___InoriQ_KS_check3[this]=LoadInteger(hs, GetHandleId(s__InoriSpells___InoriQ_KS_c[this]), InoriSpells___SH_INORI_E)
                                                if s__InoriSpells___InoriQ_KS_check3[this] < 4 then
                                                    call SaveInteger(hs, GetHandleId(s__InoriSpells___InoriQ_KS_c[this]), InoriSpells___SH_INORI_E, s__InoriSpells___InoriQ_KS_check3[this] + 1)
                                                endif
                                            endif
                                            set s__InoriSpells___InoriQ_KS_k2[this]=s__InoriSpells___InoriQ_KS_k2[this] + 1
                                            call MUE(s__InoriSpells___InoriQ_KS_u[this] , 50 , 0.12 , s__InoriSpells___InoriQ_KS_a[this])
                                            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", s__InoriSpells___InoriQ_KS_u[this], "chest"))
                                        endif
                                    endif
                                    call GroupRemoveUnit(s__InoriSpells___InoriQ_KS_g[this], s__InoriSpells___InoriQ_KS_u[this])
                                endloop
                                set s__InoriSpells___InoriQ_KS_u[this]=null
                            else
                                set s__InoriSpells___InoriQ_KS_r6[this]=s__InoriSpells___InoriQ_KS_r6[this] + 0.03
                            endif
                            if s__InoriSpells___InoriQ_KS_r2[this] >= 0.03 then
                                set s__InoriSpells___InoriQ_KS_r2[this]=0
                                call DecorRemove(s__InoriSpells___InoriQ_KS_c[this] , (BlzGetLocalSpecialEffectX((s__InoriSpells___InoriQ_KS_e[this]))) , (BlzGetLocalSpecialEffectY((s__InoriSpells___InoriQ_KS_e[this]))) , s__InoriSpells___InoriQ_KS_aoe[this] + 75 , 25) // INLINED!!
                                call VisionTimed(GetOwningPlayer(s__InoriSpells___InoriQ_KS_c[this]) , (BlzGetLocalSpecialEffectX((s__InoriSpells___InoriQ_KS_e[this]))) , (BlzGetLocalSpecialEffectY((s__InoriSpells___InoriQ_KS_e[this]))) , 600 , 1) // INLINED!!
                            else
                                set s__InoriSpells___InoriQ_KS_r2[this]=s__InoriSpells___InoriQ_KS_r2[this] + 0.03
                            endif
                        endif
                    elseif s__InoriSpells___InoriQ_KS_check2[this] == 1 then
                        if s__InoriSpells___InoriQ_KS_r[this] == 0.03 then
                            set s__InoriSpells___InoriQ_KS_move[this]=30
                            set s__InoriSpells___InoriQ_KS_r5[this]=0
                            set s__InoriSpells___InoriQ_KS_x1[this]=GetUnitX(s__InoriSpells___InoriQ_KS_c[this]) + 0 * Cos(s__InoriSpells___InoriQ_KS_a[this])
                            set s__InoriSpells___InoriQ_KS_y1[this]=GetUnitY(s__InoriSpells___InoriQ_KS_c[this]) + 0 * Sin(s__InoriSpells___InoriQ_KS_a[this])
                            set s__InoriSpells___InoriQ_KS_rmax[this]=2
                        endif
                        set s__InoriSpells___InoriQ_KS_k[this]=0
                        if s__InoriSpells___InoriQ_KS_r[this] > 0.45 then
                            loop
                                exitwhen s__InoriSpells___InoriQ_KS_k[this] > 2 or s__InoriSpells___InoriQ_KS_r[this] > 99
                                set s__InoriSpells___InoriQ_KS_r5[this]=s__InoriSpells___InoriQ_KS_r5[this] + s__InoriSpells___InoriQ_KS_move[this]
                                if s__InoriSpells___InoriQ_KS_r5[this] >= InoriEQ_Range then
                                    set s__InoriSpells___InoriQ_KS_r[this]=9999
                                endif
                                set s__InoriSpells___InoriQ_KS_x1[this]=s__InoriSpells___InoriQ_KS_x1[this] + s__InoriSpells___InoriQ_KS_move[this] * Cos(s__InoriSpells___InoriQ_KS_a[this])
                                set s__InoriSpells___InoriQ_KS_y1[this]=s__InoriSpells___InoriQ_KS_y1[this] + s__InoriSpells___InoriQ_KS_move[this] * Sin(s__InoriSpells___InoriQ_KS_a[this])
                                call s__GearSystems2___KS_RemoveEffect_MyRemoveEff_Start((EffectSpawn3("war3mapImported\\Wos_InoriCrystall.mdl" , s__InoriSpells___InoriQ_KS_x1[this] , s__InoriSpells___InoriQ_KS_y1[this] , s__InoriSpells___InoriQ_KS_a[this] * bj_RADTODEG + 180 + GetRandomReal(- 10, 10) , GetRandomReal(2.5, 3.25) , GetRandomReal(0.45, 0.8) , 130 , - 90) ) , (( 0.5)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
                                set s__InoriSpells___InoriQ_KS_k[this]=s__InoriSpells___InoriQ_KS_k[this] + 1
                            endloop
                            call GroupClear(s__InoriSpells___InoriQ_KS_g[this])
                            call GroupEnumUnitsInRange(s__InoriSpells___InoriQ_KS_g[this], s__InoriSpells___InoriQ_KS_x1[this], s__InoriSpells___InoriQ_KS_y1[this], s__InoriSpells___InoriQ_KS_aoe[this], NoDecor_Cond)
                            loop
                                set s__InoriSpells___InoriQ_KS_u[this]=FirstOfGroup(s__InoriSpells___InoriQ_KS_g[this])
                                exitwhen s__InoriSpells___InoriQ_KS_u[this] == null
                                if SpellBool(s__InoriSpells___InoriQ_KS_u[this]) and IsUnitEnemy(s__InoriSpells___InoriQ_KS_u[this], GetOwningPlayer(s__InoriSpells___InoriQ_KS_c[this])) then
                                    if IsUnitInGroup(s__InoriSpells___InoriQ_KS_u[this], s__InoriSpells___InoriQ_KS_g2[this]) == false then
                                        set GearDamageNextSource=(s__InoriSpells___InoriQ_KS_src[this]) // INLINED!!
                                        call dmgmag(s__InoriSpells___InoriQ_KS_c[this] , s__InoriSpells___InoriQ_KS_u[this] , s__InoriSpells___InoriQ_KS_dmg[this])
                                        call StunUnit(s__InoriSpells___InoriQ_KS_c[this] , s__InoriSpells___InoriQ_KS_u[this] , InoriEQ_Stun)
                                        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", s__InoriSpells___InoriQ_KS_u[this], "chest"))
                                           
                                        call GroupAddUnit(s__InoriSpells___InoriQ_KS_g2[this], s__InoriSpells___InoriQ_KS_u[this])
                                    endif
                                    call MoveUnit(s__InoriSpells___InoriQ_KS_u[this] , s__InoriSpells___InoriQ_KS_move[this] * 4.5 , s__InoriSpells___InoriQ_KS_a[this])
                                endif
                                call GroupRemoveUnit(s__InoriSpells___InoriQ_KS_g[this], s__InoriSpells___InoriQ_KS_u[this])
                            endloop
                            set s__InoriSpells___InoriQ_KS_u[this]=null
                            if s__InoriSpells___InoriQ_KS_r2[this] >= 0.03 then
