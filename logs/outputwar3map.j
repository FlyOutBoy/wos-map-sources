        call ErzaAbiArmorAdd(c , Erza5Q_ID , Erza5W_ID , Erza5E_ID , Erza5R_ID , Erza5T_ID , Erza5F_ID , true , GetUnitAbilityLevel(c, ErzaT_ID))
