                            call VisionTimed(GetOwningPlayer(s__PatriotSpells___PatriotSpells_T2_c[this]) , s__PatriotSpells___PatriotSpells_T2_x[this] , s__PatriotSpells___PatriotSpells_T2_y[this] , 1000.0 , 2.0)
                        else
