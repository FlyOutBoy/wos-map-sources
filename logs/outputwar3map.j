    endfunction
    function HarribelE_Start takes unit c returns nothing
        if LoadInteger(hs, GetHandleId(GetOwningPlayer(c)), HarribelSpells___SH_MORPH_E) == 0 then
            call s__HarribelSpells___HarribelSpells_E_HarribelE_Start(c)
        endif
    endfunction
    function HarribelE2_Start takes unit c returns nothing
        if LoadInteger(hs, GetHandleId(GetOwningPlayer(c)), HarribelSpells___SH_W_SKILL) == 1 then
            return
        endif
            call s__HarribelSpells___HarribelSpells_E_HarribelE2_Start(c)
