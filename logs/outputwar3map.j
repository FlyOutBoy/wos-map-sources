                        set s__AstaSpells__AstaSpells_Q_r[this]=999.0
                        call s__AstaSpells__AstaSpells_Q_AstaQ3_Start(s__AstaSpells__AstaSpells_Q_c[this] , s__AstaSpells__AstaSpells_Q_x[this] , s__AstaSpells__AstaSpells_Q_y[this] , 2)
                        call MakeSound("war3mapimported\\Hero_Asta_Q2")
                        call StopSpellUnit2(s__AstaSpells__AstaSpells_Q_c[this])
                    endif
                else
                    call DestroyGroup(s__AstaSpells__AstaSpells_Q_g[this])
                    call DestroyGroup(s__AstaSpells__AstaSpells_Q_g2[this])
                    set s__AstaSpells__AstaSpells_Q_g[this]=null
                    set s__AstaSpells__AstaSpells_Q_g2[this]=null
                    set s__AstaSpells__AstaSpells_Q_c[this]=null
                    set s__AstaSpells__AstaSpells_Q_e[this]=null
                    set s__AstaSpells__AstaSpells_Q_e2[this]=null
                    set s__AstaSpells__AstaSpells_Q_e3[this]=null
                    set s__AstaSpells__AstaSpells_Q_e4[this]=null
                    set s__AstaSpells__AstaSpells_Q_u[this]=null
                    set s__AstaSpells__AstaSpells_Q_m_AstaQ2[i]=s__AstaSpells__AstaSpells_Q_m_AstaQ2[s__AstaSpells__AstaSpells_Q_MUI_AstaQ2]
                    set s__AstaSpells__AstaSpells_Q_MUI_AstaQ2=s__AstaSpells__AstaSpells_Q_MUI_AstaQ2 - 1
                    set i=i - 1
                    call s__AstaSpells__AstaSpells_Q_deallocate(this)
                    if s__AstaSpells__AstaSpells_Q_MUI_AstaQ2 == - 1 then
                        call AstaSpells__AstaTimer03Release()
                    endif
                endif
                set i=i + 1
            endloop
        endfunction

