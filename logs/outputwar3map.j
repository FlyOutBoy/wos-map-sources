                                set s__FrierenSpells__FrierenSpells_Q_x[this]=s__FrierenSpells__FrierenSpells_Q_x1[this] + s__FrierenSpells__FrierenSpells_Q_move[this] * Cos(s__FrierenSpells__FrierenSpells_Q_a[this])
                                set s__FrierenSpells__FrierenSpells_Q_y[this]=s__FrierenSpells__FrierenSpells_Q_y1[this] + s__FrierenSpells__FrierenSpells_Q_move[this] * Sin(s__FrierenSpells__FrierenSpells_Q_a[this])
                            endif
                            set rkek=0
                            call EffectSpawnColor2("war3mapimported\\wos_ulqashar.mdx" , s__FrierenSpells__FrierenSpells_Q_x[this] , s__FrierenSpells__FrierenSpells_Q_y[this] , s__FrierenSpells__FrierenSpells_Q_a[this] * bj_RADTODEG , 1 , s__FrierenSpells__FrierenSpells_Q_scale[this] , 150 + s__FrierenSpells__FrierenSpells_Q_r[this] * 80 , 0.45 , 0 , 15 , 255 , 145)
