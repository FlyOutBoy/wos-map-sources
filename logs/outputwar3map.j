//library WOSUI:
function WOSUI___WUI_TestPassive takes string name,framehandle parent returns framehandle
    local framehandle container= BlzCreateFrameByType("BACKDROP", name, parent, "", 0)
    call BlzFrameSetTexture(container, WUI_EMPTY_TEXTURE, 0, true)
    return container
endfunction
function WOSUI___WUI_TestPiece takes string name,framehandle parent,string texture returns framehandle
    local framehandle piece= BlzCreateFrameByType("BACKDROP", name, parent, "", 0)
    call BlzFrameSetTexture(piece, texture, 0, true)
    call BlzFrameSetEnable(piece, false)
    return piece
endfunction
function WOSUI___WUI_TestPin takes framehandle child,framehandle owner,real x,real y,real width,real height returns nothing
    call BlzFrameClearAllPoints(child)
    call BlzFrameSetPoint(child, FRAMEPOINT_CENTER, owner, FRAMEPOINT_CENTER, x, y)
    call BlzFrameSetSize(child, width, height)
endfunction
function WOSUI___WUI_TestGoldFrame takes string name,framehandle owner,real thickness,real gem returns framehandle
    // Checkpoint 27: every former bevel + corner-gem frame is the quiet edge of
    // the top-right block: soft fading gold divider lines, no gems. The size
    // arguments are kept for the existing callers.
    local framehandle edge= WOSUI___WUI_TestPassive(name , owner)
    local framehandle piece
    call BlzFrameSetAllPoints(edge, owner)
    call BlzFrameSetEnable(edge, false)
    set piece=WOSUI___WUI_TestPiece(name + "T" , edge , "UI\\WOS\\divider-h.tga")
    call BlzFrameSetPoint(piece, FRAMEPOINT_LEFT, owner, FRAMEPOINT_TOPLEFT, 0.00, 0.00)
    call BlzFrameSetPoint(piece, FRAMEPOINT_RIGHT, owner, FRAMEPOINT_TOPRIGHT, 0.00, 0.00)
    call BlzFrameSetSize(piece, 0.00, 0.003)
    call BlzFrameSetAlpha(piece, 170)
    set piece=WOSUI___WUI_TestPiece(name + "B" , edge , "UI\\WOS\\divider-h.tga")
    call BlzFrameSetPoint(piece, FRAMEPOINT_LEFT, owner, FRAMEPOINT_BOTTOMLEFT, 0.00, 0.00)
    call BlzFrameSetPoint(piece, FRAMEPOINT_RIGHT, owner, FRAMEPOINT_BOTTOMRIGHT, 0.00, 0.00)
    call BlzFrameSetSize(piece, 0.00, 0.003)
    call BlzFrameSetAlpha(piece, 170)
    set piece=WOSUI___WUI_TestPiece(name + "L" , edge , "UI\\WOS\\divider-v.tga")
    call BlzFrameSetPoint(piece, FRAMEPOINT_TOP, owner, FRAMEPOINT_TOPLEFT, 0.00, 0.00)
    call BlzFrameSetPoint(piece, FRAMEPOINT_BOTTOM, owner, FRAMEPOINT_BOTTOMLEFT, 0.00, 0.00)
    call BlzFrameSetSize(piece, 0.003, 0.00)
    call BlzFrameSetAlpha(piece, 170)
    set piece=WOSUI___WUI_TestPiece(name + "R" , edge , "UI\\WOS\\divider-v.tga")
    call BlzFrameSetPoint(piece, FRAMEPOINT_TOP, owner, FRAMEPOINT_TOPRIGHT, 0.00, 0.00)
    call BlzFrameSetPoint(piece, FRAMEPOINT_BOTTOM, owner, FRAMEPOINT_BOTTOMRIGHT, 0.00, 0.00)
    call BlzFrameSetSize(piece, 0.003, 0.00)
    call BlzFrameSetAlpha(piece, 170)
    set piece=null
    return edge
endfunction
// Included inside the generated TEST WOSUI adapter. No initializer or timer.
// Style helpers are copied from current MAIN WOSUI by minimal_ui().

function WOSUI___WUI_TestHeroProgress takes unit hero,integer abilityId,string title,real remaining,real total,boolean seconds,string valueText returns nothing
    local integer pid
    local integer index
    local integer textKey
    local framehandle back= null
    local framehandle icon= null
    local framehandle edge= null
    local real fraction
    if hero == null then
        return
    endif
    set pid=GetPlayerId(GetOwningPlayer(hero))
    if pid >= 24 then
        return
    endif
    if WOSUI___WUI_TestBarKeys == null then
        if total <= 0.0 then
            return
        endif
        set WOSUI___WUI_TestBarKeys=InitHashtable()
    endif
    set index=LoadInteger(WOSUI___WUI_TestBarKeys, GetHandleId(hero), abilityId)
    if index == 0 and total > 0.0 and ( remaining > 0.0 or not seconds ) then
        set WOSUI___WUI_TestBarCount=WOSUI___WUI_TestBarCount + 1
        set index=WOSUI___WUI_TestBarCount
        call SaveInteger(WOSUI___WUI_TestBarKeys, GetHandleId(hero), abilityId, index)
        // All clients allocate the same handles before local presentation.
        set WOSUI___WUI_TestBarPanel[index]=WOSUI___WUI_TestPassive("WOSTestHeroBar" , BlzGetOriginFrame(ORIGIN_FRAME_GAME_UI, 0))
        call BlzFrameSetTexture(WOSUI___WUI_TestBarPanel[index], WUI_PANEL_TEXTURE, 0, true)
        call BlzFrameSetSize(WOSUI___WUI_TestBarPanel[index], 0.140, 0.025)
        call BlzFrameSetEnable(WOSUI___WUI_TestBarPanel[index], false)
        // Follow the stock minimap at any aspect ratio; do not float in screen centre.
        call BlzFrameSetPoint(WOSUI___WUI_TestBarPanel[index], FRAMEPOINT_BOTTOMLEFT, BlzGetOriginFrame(ORIGIN_FRAME_MINIMAP, 0), FRAMEPOINT_TOPLEFT, 0.003, 0.006 + 0.030 * WOSUI___WUI_TestBarOwnerSlots[pid])
        set WOSUI___WUI_TestBarOwnerSlots[pid]=WOSUI___WUI_TestBarOwnerSlots[pid] + 1
        set edge=WOSUI___WUI_TestGoldFrame("WOSTestHeroBarEdge" , WOSUI___WUI_TestBarPanel[index] , 0.0032 , 0.0070)
        set back=WOSUI___WUI_TestPiece("WOSTestHeroBarBack" , WOSUI___WUI_TestBarPanel[index] , "UI\\WOS\\bar-back.tga")
        call WOSUI___WUI_TestPin(back , WOSUI___WUI_TestBarPanel[index] , 0.012 , - 0.004 , 0.104 , 0.007)
        set WOSUI___WUI_TestBarFill[index]=WOSUI___WUI_TestPiece("WOSTestHeroBarFill" , WOSUI___WUI_TestBarPanel[index] , "UI\\WOS\\meter-fill.tga")
        call BlzFrameSetPoint(WOSUI___WUI_TestBarFill[index], FRAMEPOINT_LEFT, WOSUI___WUI_TestBarPanel[index], FRAMEPOINT_CENTER, - 0.040, - 0.004)
        set icon=WOSUI___WUI_TestPiece("WOSTestHeroBarIcon" , WOSUI___WUI_TestBarPanel[index] , BlzGetAbilityIcon(abilityId))
        call WOSUI___WUI_TestPin(icon , WOSUI___WUI_TestBarPanel[index] , - 0.055 , 0.000 , 0.019 , 0.019)
        set WOSUI___WUI_TestBarCaption[index]=BlzCreateFrameByType("TEXT", "WOSTestHeroBarTitle", WOSUI___WUI_TestBarPanel[index], "", 0)
        call BlzFrameSetEnable(WOSUI___WUI_TestBarCaption[index], false)
        call BlzFrameSetFont(WOSUI___WUI_TestBarCaption[index], "Fonts\\FRIZQT__.TTF", 0.008, 0)
        call BlzFrameSetTextAlignment(WOSUI___WUI_TestBarCaption[index], TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
        call WOSUI___WUI_TestPin(WOSUI___WUI_TestBarCaption[index] , WOSUI___WUI_TestBarPanel[index] , 0.012 , 0.006 , 0.104 , 0.011)
        set WOSUI___WUI_TestBarValue[index]=BlzCreateFrameByType("TEXT", "WOSTestHeroBarValue", WOSUI___WUI_TestBarPanel[index], "", 0)
        call BlzFrameSetEnable(WOSUI___WUI_TestBarValue[index], false)
        call BlzFrameSetFont(WOSUI___WUI_TestBarValue[index], "Fonts\\FRIZQT__.TTF", 0.007, 0)
        call BlzFrameSetTextAlignment(WOSUI___WUI_TestBarValue[index], TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
        call WOSUI___WUI_TestPin(WOSUI___WUI_TestBarValue[index] , WOSUI___WUI_TestBarPanel[index] , 0.012 , - 0.004 , 0.104 , 0.009)
        set WOSUI___WUI_TestBarTextKey[index]=- 1
        call BlzFrameSetVisible(WOSUI___WUI_TestBarPanel[index], false)
    endif
    if index > 0 and GetLocalPlayer() == Player(pid) then
        if total <= 0.0 or ( seconds and remaining <= 0.0 ) or IsUnitType(hero, UNIT_TYPE_DEAD) then
            call BlzFrameSetVisible(WOSUI___WUI_TestBarPanel[index], false)
        else
            set fraction=RMaxBJ(0.0, RMinBJ(1.0, remaining / total))
            call BlzFrameSetSize(WOSUI___WUI_TestBarFill[index], RMaxBJ(0.0002, 0.104 * fraction), 0.006)
            if WOSUI___WUI_TestBarTitle[index] != title then
                set WOSUI___WUI_TestBarTitle[index]=title
                call BlzFrameSetText(WOSUI___WUI_TestBarCaption[index], "|cffffd36b" + title + "|r")
            endif
            set textKey=R2I(remaining * 10.0 + 0.5)
            if valueText != "" then
                call BlzFrameSetText(WOSUI___WUI_TestBarValue[index], "|cffffff00" + valueText + "|r")
            elseif WOSUI___WUI_TestBarTextKey[index] != textKey then
                set WOSUI___WUI_TestBarTextKey[index]=textKey
                call BlzFrameSetText(WOSUI___WUI_TestBarValue[index], "|cffffff00" + R2SW(remaining, 1, 1) + "|r")
            endif
            call BlzFrameSetVisible(WOSUI___WUI_TestBarPanel[index], true)
        endif
    endif
    set back=null
    set icon=null
    set edge=null
endfunction
