set base=base + 100
endif
if GetUnitAbilityLevel(c, 'A0HU') > 0 then
set base=base + 40
endif
if GetUnitAbilityLevel(c, 'A0I4') > 0 then
set base=base + 80
endif
if GetUnitAbilityLevel(c, Kusanagi_Atk_ID) > 0 then
set base=base + 40
endif
