    call SetPlayerAbilityAvailable(GetOwningPlayer(c), RimuruE4_ID, true)
    if BlzGetUnitAbilityCooldownRemaining(c, RimuruE4_ID) < RimuruE345_CD_SWAP then
    call OkarunEggCd(c , RimuruE4_ID , RimuruE345_CD_SWAP)
    endif
