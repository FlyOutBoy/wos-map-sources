    function ItemsSpells__ItemsTick_On takes integer k returns nothing
        if not ItemsSpells__ItemsTick_Active[k] then
            set ItemsSpells__ItemsTick_Active[k]=true
            set ItemsSpells__ItemsTick_Users=ItemsSpells__ItemsTick_Users + 1
            if ItemsSpells__ItemsTick_Users == 1 then
                call TimerStart(ItemsSpells__ItemsTick_Timer, 0.03, true, ItemsSpells__ItemsTick_Callback)
            endif
        endif
    endfunction

    function ItemsSpells__ItemsTick_Off takes integer k returns nothing
        if ItemsSpells__ItemsTick_Active[k] then
            set ItemsSpells__ItemsTick_Active[k]=false
            set ItemsSpells__ItemsTick_Users=ItemsSpells__ItemsTick_Users - 1
            if ItemsSpells__ItemsTick_Users <= 0 then
                set ItemsSpells__ItemsTick_Users=0
                call PauseTimer(ItemsSpells__ItemsTick_Timer)
            endif
        endif
    endfunction


    function ItemsSpells__ItemsTick05_On takes integer k returns nothing
        if not ItemsSpells__ItemsTick05_Active[k] then
            set ItemsSpells__ItemsTick05_Active[k]=true
            set ItemsSpells__ItemsTick05_Users=ItemsSpells__ItemsTick05_Users + 1
            if ItemsSpells__ItemsTick05_Users == 1 then
                call TimerStart(ItemsSpells__ItemsTick05_Timer, 0.05, true, ItemsSpells__ItemsTick05_Callback)
            endif
        endif
    endfunction

    function ItemsSpells__ItemsTick05_Off takes integer k returns nothing
        if ItemsSpells__ItemsTick05_Active[k] then
            set ItemsSpells__ItemsTick05_Active[k]=false
            set ItemsSpells__ItemsTick05_Users=ItemsSpells__ItemsTick05_Users - 1
            if ItemsSpells__ItemsTick05_Users <= 0 then
                set ItemsSpells__ItemsTick05_Users=0
                call PauseTimer(ItemsSpells__ItemsTick05_Timer)
            endif
        endif
    endfunction

