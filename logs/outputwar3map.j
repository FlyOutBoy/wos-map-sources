                        set s__ItemsElementsFx_phase[this]=1
                        set s__ItemsElementsFx_next[this]=0.2
                        set s__ItemsElementsFx_e2[this]=EffectSpawn("Abilities\\Spells\\Human\\FlameStrike\\FlameStrikeEmbers.mdl" , s__ItemsElementsFx_x[this] , s__ItemsElementsFx_y[this] , 0 , 1 , 1.6 , 0)
                        call ColorEffDummy3Alpha((EffectSpawn("war3mapImported\\wos_yc_firebeam2.mdx" , s__ItemsElementsFx_x[this] , s__ItemsElementsFx_y[this] , 0 , 1.12 , 0.7 , 0) ) , (( 0.535714 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.892857)*1.0)) // INLINED!!
                        // One eruption; six ground pulses follow on the same instance.
                        call GroupEnumUnitsInRange(ItemsElements_Group, s__ItemsElementsFx_x[this], s__ItemsElementsFx_y[this], CrimsonScripture_Aoe, NoDecor_Cond)
                        loop
                            set v=FirstOfGroup(ItemsElements_Group)
                            exitwhen v == null
                            call GroupRemoveUnit(ItemsElements_Group, v)
                            if ItemsSpells__ElemValid(s__ItemsElementsFx_c[this] , v) then
                                call ItemsSpells__ElemHit(s__ItemsElementsFx_c[this] , v , s__ItemsElementsFx_src[this] , s__ItemsElementsFx_dmg[this] , true , 1)
                            endif
