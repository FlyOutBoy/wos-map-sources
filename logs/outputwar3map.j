                    endif
                set s__GearSystems2___KS_BuffTimer_frame0_pas2[s__GearSystems2___KS_BuffTimer_k2[this]]=BlzCreateFrameByType("SIMPLESTATUSBAR", "2FaceBackGround", s__GearSystems2___KS_BuffTimer_frame0_pas1[s__GearSystems2___KS_BuffTimer_k2[this]], "", 0)
