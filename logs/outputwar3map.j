                    if s__TakeshiSpells___TakeshiSpells_Q_r[this] >= 0.45 then
                        if s__TakeshiSpells___TakeshiSpells_Q_r2[this] > 0.03 then
                            set s__TakeshiSpells___TakeshiSpells_Q_r2[this]=0
                            call EffectSpawn2("war3mapImported\\wos_Bubbles2.mdx" , s__TakeshiSpells___TakeshiSpells_Q_x1[this] , s__TakeshiSpells___TakeshiSpells_Q_y1[this] , GetRandomReal(0, 359) , 1 , 6 , GetRandomReal(50, 150) , 0.21)
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_BY_Wood_Effect_Kula_2_YiYingCun0.mdl" , s__TakeshiSpells___TakeshiSpells_Q_x1[this] + 100 * Cos(s__TakeshiSpells___TakeshiSpells_Q_a[this]) , s__TakeshiSpells___TakeshiSpells_Q_y1[this] + 100 * Sin(s__TakeshiSpells___TakeshiSpells_Q_a[this]) , s__TakeshiSpells___TakeshiSpells_Q_a[this] * bj_RADTODEG , 0.5 , 2.5 , 75))
                        else
                            set s__TakeshiSpells___TakeshiSpells_Q_r2[this]=s__TakeshiSpells___TakeshiSpells_Q_r2[this] + 0.03
                        endif
                        set s__TakeshiSpells___TakeshiSpells_Q_r5[this]=s__TakeshiSpells___TakeshiSpells_Q_r5[this] + s__TakeshiSpells___TakeshiSpells_Q_move[this]
                        if s__TakeshiSpells___TakeshiSpells_Q_r5[this] >= s__TakeshiSpells___TakeshiSpells_Q_r8[this] then
                            set s__TakeshiSpells___TakeshiSpells_Q_r[this]=s__TakeshiSpells___TakeshiSpells_Q_rmax[this]
                        endif
                        if LoadInteger(hs, GetHandleId(s__TakeshiSpells___TakeshiSpells_Q_c[this]), TakeshiSpells___SH_DEF_T) > 0 then
