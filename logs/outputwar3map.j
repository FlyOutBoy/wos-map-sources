                                        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", s__ErzaTSpells__Erza5Q_KS_td[this], "chest"))
                                        call ColorEffDummy3Alpha((s___ErzaTSpells__Erza5Q_KS_ee[s__ErzaTSpells__Erza5Q_KS_ee[this]+s__ErzaTSpells__Erza5Q_KS_k[this]] ) , (( 0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.15)*1.0)) // INLINED!!
                                        call StunUnit(s__ErzaTSpells__Erza5Q_KS_c[this] , s__ErzaTSpells__Erza5Q_KS_td[this] , 0.2)
