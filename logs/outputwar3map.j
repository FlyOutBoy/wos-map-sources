    function MilimSpells___MilimTick05_On takes integer k returns nothing
        if not MilimSpells___MilimTick05_Active[k] then
            set MilimSpells___MilimTick05_Active[k]=true
            set MilimSpells___MilimTick05_Users=MilimSpells___MilimTick05_Users + 1
            if MilimSpells___MilimTick05_Users == 1 then
                call TimerStart(MilimSpells___MilimTick05_Timer, 0.05, true, MilimSpells___MilimTick05_Callback)
            endif
        endif
    endfunction

    function MilimSpells___MilimTick05_Off takes integer k returns nothing
        if MilimSpells___MilimTick05_Active[k] then
            set MilimSpells___MilimTick05_Active[k]=false
            set MilimSpells___MilimTick05_Users=MilimSpells___MilimTick05_Users - 1
            if MilimSpells___MilimTick05_Users <= 0 then
                set MilimSpells___MilimTick05_Users=0
                call PauseTimer(MilimSpells___MilimTick05_Timer)
            endif
        endif
    endfunction


    function MilimSpells___MilimTick_On takes integer k returns nothing
        if not MilimSpells___MilimTick_Active[k] then
            set MilimSpells___MilimTick_Active[k]=true
            set MilimSpells___MilimTick_Users=MilimSpells___MilimTick_Users + 1
            if MilimSpells___MilimTick_Users == 1 then
                call TimerStart(MilimSpells___MilimTick_Timer, 0.03, true, MilimSpells___MilimTick_Callback)
            endif
        endif
    endfunction

    function MilimSpells___MilimTick_Off takes integer k returns nothing
        if MilimSpells___MilimTick_Active[k] then
            set MilimSpells___MilimTick_Active[k]=false
            set MilimSpells___MilimTick_Users=MilimSpells___MilimTick_Users - 1
            if MilimSpells___MilimTick_Users <= 0 then
                set MilimSpells___MilimTick_Users=0
                call PauseTimer(MilimSpells___MilimTick_Timer)
            endif
        endif
    endfunction

       
    // Passive (G) bar divisions already passed: 0..3.
    function MilimG_GetThresholdCount takes unit c returns integer
        local real damage= LoadReal(hs, GetHandleId(c), MilimSpells___SH_MILIM_G_DMG)
        local integer count= 0
        if damage >= MilimG_DamagetoStats1 then
            set count=count + 1
        endif
        if damage >= MilimG_DamagetoStats2 then
            set count=count + 1
        endif
        if damage >= MilimG_DamagetoStats3 then
            set count=count + 1
        endif
        return count
    endfunction

    function MilimT2_GetThresholdBonus takes unit c returns real
        if GetHeroLevel(c) < 35 then
            return 0.00
        endif
        return MilimT2_ThresholdAgiBonus * I2R(MilimG_GetThresholdCount(c))
    endfunction

        function s__MilimSpells___MilimQKS_Loop_MilimQ takes nothing returns nothing
            local integer this
            local integer i= 0
            
            loop
                exitwhen i > s__MilimSpells___MilimQKS_MUI_MilimQ
                set this=s__MilimSpells___MilimQKS_m_MilimQ[i]
                if SpellBoolCaster(s__MilimSpells___MilimQKS_c[this]) and s__MilimSpells___MilimQKS_r[this] <= s__MilimSpells___MilimQKS_rmax[this] then
                    set s__MilimSpells___MilimQKS_r[this]=s__MilimSpells___MilimQKS_r[this] + 0.03
                        call DebugUnit2(s__MilimSpells___MilimQKS_c[this])
                        if s__MilimSpells___MilimQKS_check[this] == 0 then
                        if s__MilimSpells___MilimQKS_r[this] == 0.3 then
                        call SetUnitAnimationByIndex(s__MilimSpells___MilimQKS_c[this], 3)
                        
                call SetUnitTimeScale(s__MilimSpells___MilimQKS_c[this], 1.25)
                call DestroyEffect(EffectSpawn("war3mapImported\\wos_bdef (383).mdl" , GetUnitX(s__MilimSpells___MilimQKS_c[this]) , GetUnitY(s__MilimSpells___MilimQKS_c[this]) , s__MilimSpells___MilimQKS_a[this] * bj_RADTODEG , 1.25 , 1 , 1))
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_DustWindFaster3.mdl" , GetUnitX(s__MilimSpells___MilimQKS_c[this]) , GetUnitY(s__MilimSpells___MilimQKS_c[this]) , s__MilimSpells___MilimQKS_a[this] * bj_RADTODEG , 1.25 , 1 , 1))
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_cf2.mdl" , GetUnitX(s__MilimSpells___MilimQKS_c[this]) , GetUnitY(s__MilimSpells___MilimQKS_c[this]) , s__MilimSpells___MilimQKS_a[this] * bj_RADTODEG , 1.25 , 1 , 1))
                        endif
                        if s__MilimSpells___MilimQKS_r[this] == 0.54 then
                        call SetUnitTimeScale(s__MilimSpells___MilimQKS_c[this], 0)
                
                        endif
                        if s__MilimSpells___MilimQKS_r[this] > 0.3 then
                            if s__MilimSpells___MilimQKS_r5[this] <= s__MilimSpells___MilimQKS_r7[this] then //SR3(c, x, y) > 120 then
                                set s__MilimSpells___MilimQKS_r5[this]=s__MilimSpells___MilimQKS_r5[this] + s__MilimSpells___MilimQKS_move[this]
                                call MoveUnit(s__MilimSpells___MilimQKS_c[this] , s__MilimSpells___MilimQKS_move[this] , s__MilimSpells___MilimQKS_a[this])
                                call SetUnitFacing(s__MilimSpells___MilimQKS_c[this], s__MilimSpells___MilimQKS_a[this] * bj_RADTODEG)
                                call GroupClear(s__MilimSpells___MilimQKS_g[this])
                                call DecorRemove(s__MilimSpells___MilimQKS_c[this] , GetUnitX(s__MilimSpells___MilimQKS_c[this]) , GetUnitY(s__MilimSpells___MilimQKS_c[this]) , s__MilimSpells___MilimQKS_aoe[this] , 20)
                                
                                    call GroupEnumUnitsInRange(s__MilimSpells___MilimQKS_g[this], GetUnitX(s__MilimSpells___MilimQKS_c[this]), GetUnitY(s__MilimSpells___MilimQKS_c[this]), s__MilimSpells___MilimQKS_aoe[this] + 25, NoDecor_Cond)
                                    loop
                                        set s__MilimSpells___MilimQKS_u[this]=FirstOfGroup(s__MilimSpells___MilimQKS_g[this])
                                        exitwhen s__MilimSpells___MilimQKS_u[this] == null or s__MilimSpells___MilimQKS_check[this] == 1
                                        if SpellBool(s__MilimSpells___MilimQKS_u[this]) and IsUnitEnemy(s__MilimSpells___MilimQKS_u[this], GetOwningPlayer(s__MilimSpells___MilimQKS_c[this])) then
                                            set s__MilimSpells___MilimQKS_check[this]=1
                                            call s__GearSystems2___KS_RemoveEffect_MyRemoveEff_Start((AddSpecialEffectTarget("war3mapimported\\wos_ChuShou_BY_Wood_Effect_Glow_GuiPaiQiGong_XuLiblue.mdx", s__MilimSpells___MilimQKS_c[this], "hand right") ) , (( 0.18)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
                                            call SetUnitTimeScale(s__MilimSpells___MilimQKS_c[this], 1.5)
                                            set s__MilimSpells___MilimQKS_td[this]=s__MilimSpells___MilimQKS_u[this]
                                            set s__MilimSpells___MilimQKS_r[this]=0
                                            call SetUnitPosition(s__MilimSpells___MilimQKS_td[this], GetUnitX(s__MilimSpells___MilimQKS_c[this]) + 110 * Cos(s__MilimSpells___MilimQKS_a[this]), GetUnitY(s__MilimSpells___MilimQKS_c[this]) + 110 * Sin(s__MilimSpells___MilimQKS_a[this]))
                                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_HakkeStart.mdx" , GetUnitX(s__MilimSpells___MilimQKS_c[this]) + 110 * Cos(s__MilimSpells___MilimQKS_a[this]) , GetUnitY(s__MilimSpells___MilimQKS_c[this]) + 110 * Sin(s__MilimSpells___MilimQKS_a[this]) , 0 , 1.75 , 0.75 , 5))
                                        endif
                                        call GroupRemoveUnit(s__MilimSpells___MilimQKS_g[this], s__MilimSpells___MilimQKS_u[this])
                                    endloop
                                    set s__MilimSpells___MilimQKS_u[this]=null
                            
                                set s__MilimSpells___MilimQKS_r6[this]=90
                                if s__MilimSpells___MilimQKS_r2[this] > 0.03 then
                                    set s__MilimSpells___MilimQKS_r2[this]=0
                                else
                                    set s__MilimSpells___MilimQKS_r2[this]=s__MilimSpells___MilimQKS_r2[this] + 0.03
                                endif
                            else
                                set s__MilimSpells___MilimQKS_r[this]=9999
                            endif
                        endif
                    elseif s__MilimSpells___MilimQKS_check[this] == 1 then
