    function AlterSaberSpells__AlterSaberTick50_On takes integer k returns nothing
        if not AlterSaberSpells__AlterSaberTick50_Active[k] then
            set AlterSaberSpells__AlterSaberTick50_Active[k]=true
            set AlterSaberSpells__AlterSaberTick50_Users=AlterSaberSpells__AlterSaberTick50_Users + 1
            if AlterSaberSpells__AlterSaberTick50_Users == 1 then
                call TimerStart(AlterSaberSpells__AlterSaberTick50_Timer, 0.5, true, AlterSaberSpells__AlterSaberTick50_Callback)
            endif
        endif
    endfunction

    function AlterSaberSpells__AlterSaberTick50_Off takes integer k returns nothing
        if AlterSaberSpells__AlterSaberTick50_Active[k] then
            set AlterSaberSpells__AlterSaberTick50_Active[k]=false
            set AlterSaberSpells__AlterSaberTick50_Users=AlterSaberSpells__AlterSaberTick50_Users - 1
            if AlterSaberSpells__AlterSaberTick50_Users <= 0 then
                set AlterSaberSpells__AlterSaberTick50_Users=0
                call PauseTimer(AlterSaberSpells__AlterSaberTick50_Timer)
            endif
        endif
    endfunction


