        function s__ItemsSpells__ItemsSpells_DeathNote_Loop_DeathNote takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__ItemsSpells__ItemsSpells_DeathNote_MUI_Item9
                set this=s__ItemsSpells__ItemsSpells_DeathNote_m_Item9[i]
                if s__ItemsSpells__ItemsSpells_DeathNote_r[this] < 0.06 then
                set s__ItemsSpells__ItemsSpells_DeathNote_r[this]=s__ItemsSpells__ItemsSpells_DeathNote_r[this] + 0.03
                endif
                if s__ItemsSpells__ItemsSpells_DeathNote_r[this] > 0.03 then
                if SpellBoolCaster(s__ItemsSpells__ItemsSpells_DeathNote_td[this]) and s__ItemsSpells__ItemsSpells_DeathNote_r[this] <= s__ItemsSpells__ItemsSpells_DeathNote_rmax[this] and GetUnitAbilityLevel(s__ItemsSpells__ItemsSpells_DeathNote_td[this], DeathNote_Buff_ID) > 0 then
                if GetUnitAbilityLevel(s__ItemsSpells__ItemsSpells_DeathNote_td[this], 'Avul') == 0 then
                set s__ItemsSpells__ItemsSpells_DeathNote_r[this]=s__ItemsSpells__ItemsSpells_DeathNote_r[this] + 0.03
                endif
                    set s__ItemsSpells__ItemsSpells_DeathNote_a[this]=GAngle5(s__ItemsSpells__ItemsSpells_DeathNote_e[this] , GetUnitX(s__ItemsSpells__ItemsSpells_DeathNote_td[this]) , GetUnitY(s__ItemsSpells__ItemsSpells_DeathNote_td[this]))
                    set s__ItemsSpells__ItemsSpells_DeathNote_x[this]=GetUnitX(s__ItemsSpells__ItemsSpells_DeathNote_td[this])
                    set s__ItemsSpells__ItemsSpells_DeathNote_y[this]=GetUnitY(s__ItemsSpells__ItemsSpells_DeathNote_td[this])
                    call BlzSetSpecialEffectYaw(s__ItemsSpells__ItemsSpells_DeathNote_e[this], s__ItemsSpells__ItemsSpells_DeathNote_a[this])
                    call BlzSetSpecialEffectPosition(s__ItemsSpells__ItemsSpells_DeathNote_e[this], s__ItemsSpells__ItemsSpells_DeathNote_x[this], s__ItemsSpells__ItemsSpells_DeathNote_y[this], 0)
                    
                    else
                    call ColorEffDummy3Alpha((s__ItemsSpells__ItemsSpells_DeathNote_e[this] ) , (( 0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.5)*1.0)) // INLINED!!
                    if GetUnitAbilityLevel(s__ItemsSpells__ItemsSpells_DeathNote_td[this], DeathNote_Buff_ID) > 0 then
                    set GearDamageNextSource=('I044') // INLINED!!
                    call dmgmag(s__ItemsSpells__ItemsSpells_DeathNote_c[this] , s__ItemsSpells__ItemsSpells_DeathNote_td[this] , s__ItemsSpells__ItemsSpells_DeathNote_dmg[this])
                   
                     call DestroyEffect(EffectSpawn("war3mapimported\\wos_AZ_TS_TZRed.mdl" , s__ItemsSpells__ItemsSpells_DeathNote_x[this] , s__ItemsSpells__ItemsSpells_DeathNote_y[this] , s__ItemsSpells__ItemsSpells_DeathNote_a[this] * bj_RADTODEG + 90 , 2.5 , 1.5 , 1))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_YC_CrossFlashred.mdl" , s__ItemsSpells__ItemsSpells_DeathNote_x[this] + 25 * Cos(s__ItemsSpells__ItemsSpells_DeathNote_a[this]) , s__ItemsSpells__ItemsSpells_DeathNote_y[this] + 25 * Sin(s__ItemsSpells__ItemsSpells_DeathNote_a[this]) , 1 , 1.15 , 1.475 , 125))
                    call UnitRemoveAbility(s__ItemsSpells__ItemsSpells_DeathNote_td[this], DeathNote_Buff_ID)
                    endif
                    set s__ItemsSpells__ItemsSpells_DeathNote_c[this]=null
                    set s__ItemsSpells__ItemsSpells_DeathNote_td[this]=null
                    set s__ItemsSpells__ItemsSpells_DeathNote_e[this]=null
                    set s__ItemsSpells__ItemsSpells_DeathNote_e2[this]=null
                    set s__ItemsSpells__ItemsSpells_DeathNote_m_Item9[i]=s__ItemsSpells__ItemsSpells_DeathNote_m_Item9[s__ItemsSpells__ItemsSpells_DeathNote_MUI_Item9]
                    set s__ItemsSpells__ItemsSpells_DeathNote_MUI_Item9=s__ItemsSpells__ItemsSpells_DeathNote_MUI_Item9 - 1
                    if s__ItemsSpells__ItemsSpells_DeathNote_MUI_Item9 == - 1 then
                        call ItemsSpells__ItemsTick_Off(15)
                    endif
                    call s__ItemsSpells__ItemsSpells_DeathNote_deallocate(this)
                    set i=i - 1
                endif
                endif
                set i=i + 1
            endloop
        endfunction

