    function OkarunSpells___OkarunTick_On takes integer k returns nothing
        if not OkarunSpells___OkarunTick_Active[k] then
            set OkarunSpells___OkarunTick_Active[k]=true
            set OkarunSpells___OkarunTick_Users=OkarunSpells___OkarunTick_Users + 1
            if OkarunSpells___OkarunTick_Users == 1 then
                call TimerStart(OkarunSpells___OkarunTick_Timer, 0.03, true, OkarunSpells___OkarunTick_Callback)
            endif
        endif
    endfunction

    function OkarunSpells___OkarunTick_Off takes integer k returns nothing
        if OkarunSpells___OkarunTick_Active[k] then
            set OkarunSpells___OkarunTick_Active[k]=false
            set OkarunSpells___OkarunTick_Users=OkarunSpells___OkarunTick_Users - 1
            if OkarunSpells___OkarunTick_Users <= 0 then
                set OkarunSpells___OkarunTick_Users=0
                call PauseTimer(OkarunSpells___OkarunTick_Timer)
            endif
        endif
    endfunction

    function OkarunF_MaxSpeed takes unit c returns real
        local integer level= GetHeroLevel(c)
        if level >= 35 then
            return OkarunF_MaxSpeed4
        elseif level >= 25 then
            return OkarunF_MaxSpeed3
        elseif level >= 18 then
            return OkarunF_MaxSpeed2
        elseif level >= 12 then
            return OkarunF_MaxSpeed1
        endif
        if level >= 6 then
            return OkarunF_MaxSpeed0
        endif
        return GetUnitMoveSpeed(c)
    endfunction

    function OkarunT_Speed takes unit c returns real
        return OkarunT_MoveSpeed
    endfunction

