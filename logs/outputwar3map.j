    function CrocodileSpells__CrocodileBonus_Refresh takes unit u,integer abilityId returns nothing
            local ability a= BlzGetUnitAbility(u, abilityId)
            local integer level= GetUnitAbilityLevel(u, abilityId)
            local integer levels= BlzGetAbilityIntegerField(a, ABILITY_IF_LEVELS)
            if a != null and level > 0 then
                // Native item bonuses have one level. Ensure Inc really changes
                // level before restoring it, so updated stat fields are applied.
                if levels <= level then
                    call BlzSetAbilityIntegerField(a, ABILITY_IF_LEVELS, level + 1)
                endif
                call IncUnitAbilityLevel(u, abilityId)
                call DecUnitAbilityLevel(u, abilityId)
                if levels <= level then
                    call BlzSetAbilityIntegerField(a, ABILITY_IF_LEVELS, levels)
                endif
            endif
            set a=null
    endfunction

    // PauseUnit is boolean: overlapping owned casts must release only the last lock.
//================================ Crocodile Sand ========================================
    function CrocodileSpells__CrocodileSand_SlowTarget takes unit c,unit u returns nothing
        if GetHeroLevel(c) >= CrocodileSand_ThirdSlowHeroLevel then
            call SlowUnit(c , u , CrocodileSand_SlowLevel35 , 1)
        elseif GetHeroLevel(c) >= CrocodileSand_SecondSlowHeroLevel then
            call SlowUnit(c , u , CrocodileSand_SlowLevel25 , 1)
        else
            call SlowUnit(c , u , CrocodileSand_Slow , 1)
        endif
    endfunction


        function s__CrocodileSpells__CrocodileSand_Struct_CellOf takes real v returns integer
            return R2I(( v + 65536.0 ) / CrocodileSpells__CrocodileSand_Cell)
        endfunction

        // Box half-size >= MinDistance keeps the spacing query on one cell too.
        function s__CrocodileSpells__CrocodileSand_Struct_GridAdd takes integer this returns nothing
            local real half= RMaxBJ(s__CrocodileSpells__CrocodileSand_Struct_radius[this], CrocodileSand_MinDistance)
            local integer cx
            local integer cy
            local integer key
            local integer n
            set s__CrocodileSpells__CrocodileSand_Struct_gx0[this]=(R2I(( ((s__CrocodileSpells__CrocodileSand_Struct_x[this] - half)*1.0) + 65536.0 ) / CrocodileSpells__CrocodileSand_Cell)) // INLINED!!
            set s__CrocodileSpells__CrocodileSand_Struct_gx1[this]=(R2I(( ((s__CrocodileSpells__CrocodileSand_Struct_x[this] + half)*1.0) + 65536.0 ) / CrocodileSpells__CrocodileSand_Cell)) // INLINED!!
            set s__CrocodileSpells__CrocodileSand_Struct_gy0[this]=(R2I(( ((s__CrocodileSpells__CrocodileSand_Struct_y[this] - half)*1.0) + 65536.0 ) / CrocodileSpells__CrocodileSand_Cell)) // INLINED!!
            set s__CrocodileSpells__CrocodileSand_Struct_gy1[this]=(R2I(( ((s__CrocodileSpells__CrocodileSand_Struct_y[this] + half)*1.0) + 65536.0 ) / CrocodileSpells__CrocodileSand_Cell)) // INLINED!!
            set cx=s__CrocodileSpells__CrocodileSand_Struct_gx0[this]
            loop
                exitwhen cx > s__CrocodileSpells__CrocodileSand_Struct_gx1[this]
                set cy=s__CrocodileSpells__CrocodileSand_Struct_gy0[this]
                loop
                    exitwhen cy > s__CrocodileSpells__CrocodileSand_Struct_gy1[this]
                    set key=cx * 512 + cy
                    set n=LoadInteger(CrocodileSpells__CrocodileSand_Grid, key, 0) + 1
                    call SaveInteger(CrocodileSpells__CrocodileSand_Grid, key, 0, n)
                    call SaveInteger(CrocodileSpells__CrocodileSand_Grid, key, n, this)
                    set cy=cy + 1
                endloop
                set cx=cx + 1
            endloop
        endfunction

        function s__CrocodileSpells__CrocodileSand_Struct_GridRemove takes integer this returns nothing
            local integer cx= s__CrocodileSpells__CrocodileSand_Struct_gx0[this]
            local integer cy
            local integer key
            local integer n
            local integer j
            loop
                exitwhen cx > s__CrocodileSpells__CrocodileSand_Struct_gx1[this]
                set cy=s__CrocodileSpells__CrocodileSand_Struct_gy0[this]
                loop
                    exitwhen cy > s__CrocodileSpells__CrocodileSand_Struct_gy1[this]
                    set key=cx * 512 + cy
                    set n=LoadInteger(CrocodileSpells__CrocodileSand_Grid, key, 0)
                    set j=1
                    loop
                        exitwhen j > n
                        if LoadInteger(CrocodileSpells__CrocodileSand_Grid, key, j) == this then
                            call SaveInteger(CrocodileSpells__CrocodileSand_Grid, key, j, LoadInteger(CrocodileSpells__CrocodileSand_Grid, key, n))
                            call RemoveSavedInteger(CrocodileSpells__CrocodileSand_Grid, key, n)
                            call SaveInteger(CrocodileSpells__CrocodileSand_Grid, key, 0, n - 1)
                            exitwhen true
                        endif
                        set j=j + 1
                    endloop
                    set cy=cy + 1
                endloop
                set cx=cx + 1
            endloop
        endfunction

        function s__CrocodileSpells__CrocodileSand_Struct_CrocodileSand_CreateVisual takes integer this returns nothing
            set s__CrocodileSpells__CrocodileSand_Struct_largeVisual[this]=s__CrocodileSpells__CrocodileSand_Struct_radius[this] >= CrocodileSand_LargeAoe
            set s__CrocodileSpells__CrocodileSand_Struct_e[this]=EffectSpawn("war3mapImported\\wos_ysjsm45.mdl" , s__CrocodileSpells__CrocodileSand_Struct_x[this] , s__CrocodileSpells__CrocodileSand_Struct_y[this] , GetRandomReal(0, 359) , 0.5 , s__CrocodileSpells__CrocodileSand_Struct_radius[this] / 165.0 , 0)
            call BlzSetSpecialEffectAlpha(s__CrocodileSpells__CrocodileSand_Struct_e[this], 0)
            call ColorEffDummy4(s__CrocodileSpells__CrocodileSand_Struct_e[this] , 0 , 255 , 255 , 255 , 0.39)
        endfunction


        function s__CrocodileSpells__CrocodileSand_Struct_CrocodileSand_IsOnGround takes unit u,unit source returns boolean
            local integer this
            local real px= GetUnitX(u)
            local real py= GetUnitY(u)
            local real dx
            local real dy
            local integer key= (R2I(( ((px)*1.0) + 65536.0 ) / CrocodileSpells__CrocodileSand_Cell)) * 512 + (R2I(( ((py)*1.0) + 65536.0 ) / CrocodileSpells__CrocodileSand_Cell)) // INLINED!!
            local integer n= LoadInteger(CrocodileSpells__CrocodileSand_Grid, key, 0)
            local integer i= 1
            loop
                exitwhen i > n
                set this=LoadInteger(CrocodileSpells__CrocodileSand_Grid, key, i)
                if ( source == null or s__CrocodileSpells__CrocodileSand_Struct_c[this] == source ) and not s__CrocodileSpells__CrocodileSand_Struct_endNow[this] and s__CrocodileSpells__CrocodileSand_Struct_r[this] < s__CrocodileSpells__CrocodileSand_Struct_rmax[this] then
                    set dx=px - s__CrocodileSpells__CrocodileSand_Struct_x[this]
                    set dy=py - s__CrocodileSpells__CrocodileSand_Struct_y[this]
                    if dx * dx + dy * dy <= s__CrocodileSpells__CrocodileSand_Struct_radius[this] * s__CrocodileSpells__CrocodileSand_Struct_radius[this] then
                        return true
                    endif
                endif
                set i=i + 1
            endloop
            return false
        endfunction

        // Every 0.5 sec: ONE enumeration over the box of all live sand, then each unit
        // reads only its own grid cell (was one GroupEnum per sand patch).
        function s__CrocodileSpells__CrocodileSand_Struct_CrocodileSand_Pulse takes nothing returns nothing
            local integer i= 0
            local integer this
            local unit u
            local unit lastOwner
            local real minX= 1000000.0
            local real minY= 1000000.0
            local real maxX= - 1000000.0
            local real maxY= - 1000000.0
            local real dx
            local real dy
            local integer key
            local integer n
            loop
                exitwhen i > s__CrocodileSpells__CrocodileSand_Struct_MUI
                set this=s__CrocodileSpells__CrocodileSand_Struct_m[i]
                if not s__CrocodileSpells__CrocodileSand_Struct_endNow[this] and s__CrocodileSpells__CrocodileSand_Struct_r[this] < s__CrocodileSpells__CrocodileSand_Struct_rmax[this] then
                    set minX=RMinBJ(minX, s__CrocodileSpells__CrocodileSand_Struct_x[this] - s__CrocodileSpells__CrocodileSand_Struct_radius[this])
                    set minY=RMinBJ(minY, s__CrocodileSpells__CrocodileSand_Struct_y[this] - s__CrocodileSpells__CrocodileSand_Struct_radius[this])
                    set maxX=RMaxBJ(maxX, s__CrocodileSpells__CrocodileSand_Struct_x[this] + s__CrocodileSpells__CrocodileSand_Struct_radius[this])
                    set maxY=RMaxBJ(maxY, s__CrocodileSpells__CrocodileSand_Struct_y[this] + s__CrocodileSpells__CrocodileSand_Struct_radius[this])
                endif
                set i=i + 1
            endloop
            if minX > maxX then
                return
            endif
            if CrocodileSpells__CrocodileSand_ScanRect == null then
                set CrocodileSpells__CrocodileSand_ScanRect=Rect(minX, minY, maxX, maxY)
            else
                call SetRect(CrocodileSpells__CrocodileSand_ScanRect, minX, minY, maxX, maxY)
            endif
            if CrocodileSpells__CrocodileSand_ScanGroup == null then
                set CrocodileSpells__CrocodileSand_ScanGroup=CreateGroup()
            endif
            call GroupEnumUnitsInRect(CrocodileSpells__CrocodileSand_ScanGroup, CrocodileSpells__CrocodileSand_ScanRect, NoDecor_Cond)
            loop
                set u=FirstOfGroup(CrocodileSpells__CrocodileSand_ScanGroup)
                exitwhen u == null
                call GroupRemoveUnit(CrocodileSpells__CrocodileSand_ScanGroup, u)
                if SpellBool(u) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) then
                    set key=(R2I(( ((GetUnitX(u))*1.0) + 65536.0 ) / CrocodileSpells__CrocodileSand_Cell)) * 512 + (R2I(( ((GetUnitY(u))*1.0) + 65536.0 ) / CrocodileSpells__CrocodileSand_Cell)) // INLINED!!
                    set n=LoadInteger(CrocodileSpells__CrocodileSand_Grid, key, 0)
                    set lastOwner=null
                    set i=1
                    loop
                        exitwhen i > n
                        set this=LoadInteger(CrocodileSpells__CrocodileSand_Grid, key, i)
                        if s__CrocodileSpells__CrocodileSand_Struct_c[this] != lastOwner and not s__CrocodileSpells__CrocodileSand_Struct_endNow[this] and s__CrocodileSpells__CrocodileSand_Struct_r[this] < s__CrocodileSpells__CrocodileSand_Struct_rmax[this] and IsUnitEnemy(u, GetOwningPlayer(s__CrocodileSpells__CrocodileSand_Struct_c[this])) then
                            set dx=GetUnitX(u) - s__CrocodileSpells__CrocodileSand_Struct_x[this]
                            set dy=GetUnitY(u) - s__CrocodileSpells__CrocodileSand_Struct_y[this]
                            if dx * dx + dy * dy <= s__CrocodileSpells__CrocodileSand_Struct_radius[this] * s__CrocodileSpells__CrocodileSand_Struct_radius[this] then
                                // One slow per owner per pulse, however many patches overlap.
                                call CrocodileSpells__CrocodileSand_SlowTarget(s__CrocodileSpells__CrocodileSand_Struct_c[this] , u)
                                set lastOwner=s__CrocodileSpells__CrocodileSand_Struct_c[this]
                            endif
                        endif
                        set i=i + 1
                    endloop
                endif
            endloop
            set u=null
            set lastOwner=null
        endfunction

        function s__CrocodileSpells__CrocodileSand_Struct_Loop_CrocodileSand takes nothing returns nothing
            local integer i= 0
            local integer this
            set CrocodileSpells__CrocodileSand_PulseClock=CrocodileSpells__CrocodileSand_PulseClock + CrocodileSpells__CrocodilePeriod
            if CrocodileSpells__CrocodileSand_PulseClock + 0.001 >= 0.5 then
                set CrocodileSpells__CrocodileSand_PulseClock=0.0
                call s__CrocodileSpells__CrocodileSand_Struct_CrocodileSand_Pulse()
            endif
            loop
                exitwhen i > s__CrocodileSpells__CrocodileSand_Struct_MUI
                set this=s__CrocodileSpells__CrocodileSand_Struct_m[i]
                set s__CrocodileSpells__CrocodileSand_Struct_r[this]=RoundReal(s__CrocodileSpells__CrocodileSand_Struct_r[this] + CrocodileSpells__CrocodilePeriod , 3)
                if s__CrocodileSpells__CrocodileSand_Struct_endNow[this] or s__CrocodileSpells__CrocodileSand_Struct_r[this] + 0.001 >= s__CrocodileSpells__CrocodileSand_Struct_rmax[this] or GetUnitTypeId(s__CrocodileSpells__CrocodileSand_Struct_c[this]) == 0 or LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileSand_Struct_c[this]), CrocodileSpells__CrocodileCore_DataKey) == 0 then
                    if s__CrocodileSpells__CrocodileSand_Struct_e[this] != null then
                        call ColorEffDummy3Alpha((s__CrocodileSpells__CrocodileSand_Struct_e[this] ) , (( 0.0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( CrocodileSand_FadeTime)*1.0)) // INLINED!!
                    endif
                    call s__CrocodileSpells__CrocodileSand_Struct_GridRemove(this)
                    set s__CrocodileSpells__CrocodileSand_Struct_c[this]=null
                    set s__CrocodileSpells__CrocodileSand_Struct_e[this]=null
                    set s__CrocodileSpells__CrocodileSand_Struct_m[i]=s__CrocodileSpells__CrocodileSand_Struct_m[s__CrocodileSpells__CrocodileSand_Struct_MUI]
                    set s__CrocodileSpells__CrocodileSand_Struct_MUI=s__CrocodileSpells__CrocodileSand_Struct_MUI - 1
                    call s__CrocodileSpells__CrocodileSand_Struct_deallocate(this)
                    if s__CrocodileSpells__CrocodileSand_Struct_MUI == - 1 then
                        if CrocodileSpells__CrocodileSand_ScanGroup != null then
                            call DestroyGroup(CrocodileSpells__CrocodileSand_ScanGroup)
                            set CrocodileSpells__CrocodileSand_ScanGroup=null
                        endif
                        set CrocodileSpells__CrocodileSand_PulseClock=0.0
                        call GearTimer03Release()
                    endif
                else
                    set i=i + 1
                endif
            endloop
        endfunction

        function s__CrocodileSpells__CrocodileSand_Struct_CrocodileSand_Start takes unit NewC,real NewX,real NewY,real NewAoe,boolean qHit returns nothing
            local integer key= (R2I(( ((NewX)*1.0) + 65536.0 ) / CrocodileSpells__CrocodileSand_Cell)) * 512 + (R2I(( ((NewY)*1.0) + 65536.0 ) / CrocodileSpells__CrocodileSand_Cell)) // INLINED!!
            local integer n= LoadInteger(CrocodileSpells__CrocodileSand_Grid, key, 0)
            local integer i= 1
            local integer this
            local real dx
            local real dy
            loop
                exitwhen i > n
                set this=LoadInteger(CrocodileSpells__CrocodileSand_Grid, key, i)
                set dx=s__CrocodileSpells__CrocodileSand_Struct_x[this] - NewX
                set dy=s__CrocodileSpells__CrocodileSand_Struct_y[this] - NewY
                if not s__CrocodileSpells__CrocodileSand_Struct_endNow[this] and s__CrocodileSpells__CrocodileSand_Struct_r[this] < s__CrocodileSpells__CrocodileSand_Struct_rmax[this] and dx * dx + dy * dy + 0.001 < CrocodileSand_MinDistance * CrocodileSand_MinDistance then
                    // All existing sand objects enforce spacing. Only refresh our own.
                    if s__CrocodileSpells__CrocodileSand_Struct_c[this] == NewC and not qHit then
                        if NewAoe > s__CrocodileSpells__CrocodileSand_Struct_radius[this] then
                            call s__CrocodileSpells__CrocodileSand_Struct_GridRemove(this)
                            set s__CrocodileSpells__CrocodileSand_Struct_radius[this]=NewAoe
                            call s__CrocodileSpells__CrocodileSand_Struct_GridAdd(this)
                        endif
                        set s__CrocodileSpells__CrocodileSand_Struct_r[this]=0.0
                        set s__CrocodileSpells__CrocodileSand_Struct_rmax[this]=CrocodileSand_GroundDuration
                        set s__CrocodileSpells__CrocodileSand_Struct_largeVisual[this]=s__CrocodileSpells__CrocodileSand_Struct_radius[this] >= CrocodileSand_LargeAoe
                        call BlzSetSpecialEffectScale(s__CrocodileSpells__CrocodileSand_Struct_e[this], s__CrocodileSpells__CrocodileSand_Struct_radius[this] / 165.0)
                    endif
                    return
                endif
                set i=i + 1
            endloop
            set this=s__CrocodileSpells__CrocodileSand_Struct__allocate()
            set s__CrocodileSpells__CrocodileSand_Struct_MUI=s__CrocodileSpells__CrocodileSand_Struct_MUI + 1
            set s__CrocodileSpells__CrocodileSand_Struct_m[s__CrocodileSpells__CrocodileSand_Struct_MUI]=this
            if s__CrocodileSpells__CrocodileSand_Struct_MUI == 0 then
                call GearTimer03Acquire()
            endif
            set s__CrocodileSpells__CrocodileSand_Struct_c[this]=NewC
            set s__CrocodileSpells__CrocodileSand_Struct_x[this]=NewX
            set s__CrocodileSpells__CrocodileSand_Struct_y[this]=NewY
            set s__CrocodileSpells__CrocodileSand_Struct_radius[this]=NewAoe
            set s__CrocodileSpells__CrocodileSand_Struct_r[this]=0.0
            set s__CrocodileSpells__CrocodileSand_Struct_pulse[this]=0.0
            set s__CrocodileSpells__CrocodileSand_Struct_endNow[this]=false
            set s__CrocodileSpells__CrocodileSand_Struct_rmax[this]=CrocodileSand_GroundDuration
            call s__CrocodileSpells__CrocodileSand_Struct_GridAdd(this)
            call s__CrocodileSpells__CrocodileSand_Struct_CrocodileSand_CreateVisual(this)
        endfunction




        function s__CrocodileSpells__CrocodileSand_Debuff_Apply takes unit source,unit target returns boolean
            local integer this
            if source == null or not SpellBoolCaster(source) or IsUnitIllusion(source) or target == null or not SpellBool(target) or not IsUnitEnemy(target, GetOwningPlayer(source)) or IsUnitType(target, UNIT_TYPE_STRUCTURE) or GetUnitAbilityLevel(target, 'Aloc') > 0 or CrocodileQ_SandMark_Ability_ID == 0 or CrocodileQ_SandMark_Buff_ID == 0 then
                return false
            endif
            call BuffUnit01(source , target , CrocodileQ_SandMark_Ability_ID , "slow" , 1)
            set this=LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(target), CrocodileSpells__CrocodileSand_DebuffKey)
            if this != 0 then
                set s__CrocodileSpells__CrocodileSand_Debuff_c[this]=source // One tracker per target; latest successful mark owns its trail.
                set s__CrocodileSpells__CrocodileSand_Debuff_buffGrace[this]=CrocodileQ_SandMark_Grace
                return false
            endif
            set this=s__CrocodileSpells__CrocodileSand_Debuff__allocate()
            set s__CrocodileSpells__CrocodileSand_Debuff_c[this]=source
            set s__CrocodileSpells__CrocodileSand_Debuff_u[this]=target
            set s__CrocodileSpells__CrocodileSand_Debuff_lastX[this]=GetUnitX(s__CrocodileSpells__CrocodileSand_Debuff_u[this])
            set s__CrocodileSpells__CrocodileSand_Debuff_lastY[this]=GetUnitY(s__CrocodileSpells__CrocodileSand_Debuff_u[this])
            set s__CrocodileSpells__CrocodileSand_Debuff_pulse[this]=0.0
            set s__CrocodileSpells__CrocodileSand_Debuff_r[this]=0.0
            set s__CrocodileSpells__CrocodileSand_Debuff_buffSeen[this]=false
            set s__CrocodileSpells__CrocodileSand_Debuff_buffGrace[this]=CrocodileQ_SandMark_Grace
            set s__CrocodileSpells__CrocodileSand_Debuff_e[this]=null // The native buff owns its indicator and lifetime.
            call SaveInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileSand_Debuff_u[this]), CrocodileSpells__CrocodileSand_DebuffKey, this)
            set s__CrocodileSpells__CrocodileSand_Debuff_MUI=s__CrocodileSpells__CrocodileSand_Debuff_MUI + 1
            set s__CrocodileSpells__CrocodileSand_Debuff_m[s__CrocodileSpells__CrocodileSand_Debuff_MUI]=this
            if s__CrocodileSpells__CrocodileSand_Debuff_MUI == 0 then
                call GearTimer03Acquire()
            endif
            return true
        endfunction

        function s__CrocodileSpells__CrocodileSand_Debuff_Loop_CrocodileSandDebuff takes nothing returns nothing
            local integer i= 0
            local integer this
            local real px
            local real py
            local real dx
            local real dy
            loop
                exitwhen i > s__CrocodileSpells__CrocodileSand_Debuff_MUI
                set this=s__CrocodileSpells__CrocodileSand_Debuff_m[i]
                set s__CrocodileSpells__CrocodileSand_Debuff_r[this]=RoundReal(s__CrocodileSpells__CrocodileSand_Debuff_r[this] + CrocodileSpells__CrocodilePeriod , 3)
                set s__CrocodileSpells__CrocodileSand_Debuff_buffGrace[this]=RMaxBJ(0.0, s__CrocodileSpells__CrocodileSand_Debuff_buffGrace[this] - CrocodileSpells__CrocodilePeriod)
                if GetUnitAbilityLevel(s__CrocodileSpells__CrocodileSand_Debuff_u[this], CrocodileQ_SandMark_Buff_ID) > 0 then
                    set s__CrocodileSpells__CrocodileSand_Debuff_buffSeen[this]=true
                endif
                if ( GetUnitAbilityLevel(s__CrocodileSpells__CrocodileSand_Debuff_u[this], CrocodileQ_SandMark_Buff_ID) == 0 and ( s__CrocodileSpells__CrocodileSand_Debuff_buffSeen[this] or s__CrocodileSpells__CrocodileSand_Debuff_buffGrace[this] <= 0.0 ) ) or GetUnitTypeId(s__CrocodileSpells__CrocodileSand_Debuff_u[this]) == 0 or GetWidgetLife(s__CrocodileSpells__CrocodileSand_Debuff_u[this]) <= 0.405 or not SpellBoolCaster(s__CrocodileSpells__CrocodileSand_Debuff_c[this]) or LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileSand_Debuff_c[this]), CrocodileSpells__CrocodileCore_DataKey) == 0 then
                    call RemoveSavedInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileSand_Debuff_u[this]), CrocodileSpells__CrocodileSand_DebuffKey)
                    call DestroyEffect(s__CrocodileSpells__CrocodileSand_Debuff_e[this])
                    set s__CrocodileSpells__CrocodileSand_Debuff_e[this]=null
                    set s__CrocodileSpells__CrocodileSand_Debuff_u[this]=null
                    set s__CrocodileSpells__CrocodileSand_Debuff_c[this]=null
                    set s__CrocodileSpells__CrocodileSand_Debuff_m[i]=s__CrocodileSpells__CrocodileSand_Debuff_m[s__CrocodileSpells__CrocodileSand_Debuff_MUI]
                    set s__CrocodileSpells__CrocodileSand_Debuff_MUI=s__CrocodileSpells__CrocodileSand_Debuff_MUI - 1
                    call s__CrocodileSpells__CrocodileSand_Debuff_deallocate(this)
                    if s__CrocodileSpells__CrocodileSand_Debuff_MUI == - 1 then
                        call GearTimer03Release()
                    endif
                else
                    set s__CrocodileSpells__CrocodileSand_Debuff_pulse[this]=s__CrocodileSpells__CrocodileSand_Debuff_pulse[this] + CrocodileSpells__CrocodilePeriod
                    if s__CrocodileSpells__CrocodileSand_Debuff_pulse[this] + 0.001 >= CrocodileSpells__CrocodileSand_TrackPeriod and GetUnitAbilityLevel(s__CrocodileSpells__CrocodileSand_Debuff_u[this], CrocodileQ_SandMark_Buff_ID) > 0 and GetUnitTypeId(s__CrocodileSpells__CrocodileSand_Debuff_c[this]) != 0 and IsUnitEnemy(s__CrocodileSpells__CrocodileSand_Debuff_u[this], GetOwningPlayer(s__CrocodileSpells__CrocodileSand_Debuff_c[this])) then
                        set s__CrocodileSpells__CrocodileSand_Debuff_pulse[this]=0.0
                        set px=GetUnitX(s__CrocodileSpells__CrocodileSand_Debuff_u[this])
                        set py=GetUnitY(s__CrocodileSpells__CrocodileSand_Debuff_u[this])
                        set dx=px - s__CrocodileSpells__CrocodileSand_Debuff_lastX[this]
                        set dy=py - s__CrocodileSpells__CrocodileSand_Debuff_lastY[this]
                        if dx * dx + dy * dy >= CrocodileSand_MinDistance * CrocodileSand_MinDistance then
                            call s__CrocodileSpells__CrocodileSand_Struct_CrocodileSand_Start(s__CrocodileSpells__CrocodileSand_Debuff_c[this] , px , py , CrocodileSand_Radius , true)
                            set s__CrocodileSpells__CrocodileSand_Debuff_lastX[this]=px
                            set s__CrocodileSpells__CrocodileSand_Debuff_lastY[this]=py
                        endif
                    endif
                    set i=i + 1
                endif
            endloop
        endfunction

    function CrocodileQ_ApplySandMark takes unit c,unit u returns nothing
        if s__CrocodileSpells__CrocodileSand_Debuff_Apply(c , u) then
            call s__CrocodileSpells__CrocodileSand_Struct_CrocodileSand_Start(c , GetUnitX(u) , GetUnitY(u) , CrocodileSand_Radius , true)
        endif
    endfunction

//================================ Crocodile Q - Desert Spada ========================================
    function CrocodileSpells__CrocodileDecor_NewKey takes nothing returns integer
        set CrocodileSpells__CrocodileDecorKey=CrocodileSpells__CrocodileDecorKey + 1
        return CrocodileSpells__CrocodileDecorKey
    endfunction

    function CrocodileSpells__CrocodileW_CheckQ takes unit source,real sx,real sy,real angle,real fromDistance,real toDistance,real qRadius returns nothing
        // Synchronous notification avoids a Q/W struct forward dependency.
        set CrocodileSpells__CrocodileW_QSource=source
        set CrocodileSpells__CrocodileW_QStartX=sx
        set CrocodileSpells__CrocodileW_QStartY=sy
        set CrocodileSpells__CrocodileW_QAngle=angle
        set CrocodileSpells__CrocodileW_QFrom=fromDistance
        set CrocodileSpells__CrocodileW_QTo=toDistance
        set CrocodileSpells__CrocodileW_QRadius=qRadius
        if CrocodileSpells__CrocodileW_QContact != null then
            call TriggerEvaluate(CrocodileSpells__CrocodileW_QContact)
        endif
        set CrocodileSpells__CrocodileW_QSource=null
    endfunction

    // MAIN calls this only after a positive final hit. Rejected hits never
    // consume W's per-target allowance. The context is restored after damage.
    function CrocodileG_CanDrainMana takes unit c,unit target returns boolean
        local integer hits
        if c != CrocodileSpells__CrocodileG_ManaSource or CrocodileSpells__CrocodileG_ManaContext == 0 then
            return true
        elseif CrocodileSpells__CrocodileG_ManaContext < 0 then
            return false
        endif
        set hits=LoadInteger(CrocodileSpells__CrocodileDecorHits, CrocodileSpells__CrocodileG_ManaContext, GetHandleId(target))
        if hits >= CrocodileW_ManaBurnHits then
            return false
        endif
        call SaveInteger(CrocodileSpells__CrocodileDecorHits, CrocodileSpells__CrocodileG_ManaContext, GetHandleId(target), hits + 1)
        return true
    endfunction

    function CrocodileSpells__Crocodile_SpellDamage takes unit c,unit target,real amount,integer manaContext returns nothing
        local unit previousSource= CrocodileSpells__CrocodileG_ManaSource
        local integer previousContext= CrocodileSpells__CrocodileG_ManaContext
        set CrocodileSpells__CrocodileG_ManaSource=c
        set CrocodileSpells__CrocodileG_ManaContext=manaContext
        call dmgphys(c , target , amount)
        set CrocodileSpells__CrocodileG_ManaSource=previousSource
        set CrocodileSpells__CrocodileG_ManaContext=previousContext
        set previousSource=null
    endfunction

    function CrocodileSpells__Crocodile_ApplySharedMark takes unit c,unit target returns nothing
        if GetHeroLevel(c) >= CrocodileQ_SharedMarkHeroLevel then
            call CrocodileQ_ApplySandMark(c , target)
        endif
    endfunction

    function CrocodileSpells__CrocodileE_MaxCharges takes unit c returns integer
        local integer level= GetUnitAbilityLevel(c, CrocodileE_ID)
        if level == 0 then
            return 0
        elseif GetHeroLevel(c) >= CrocodileE_ThirdChargeHeroLevel then
            return 3
        elseif level >= 3 then
            return 2
        endif
        return 1
    endfunction

    function CrocodileSpells__CrocodileE_RechargeTime takes unit c returns real
        return RMaxBJ(CrocodileSpells__CrocodilePeriod, BlzGetUnitAbilityCooldown(c, CrocodileE_ID, IMaxBJ(0, GetUnitAbilityLevel(c, CrocodileE_ID) - 1)))
    endfunction

    function CrocodileSpells__CrocodileQ_Pull takes unit u,real x,real y returns nothing
        local real duration= RMaxBJ(CrocodileSpells__CrocodilePeriod, CrocodileQ_PullDuration - CrocodileSpells__CrocodilePeriod)
        local real distance= RMinBJ(CrocodileQ_PullDistance, SR3(u , x , y))
        // MUE includes a final tick at r == rmax. Account for it so both the
        // configured duration and distance are respected; retain MAIN CC resistance.
        if distance > 1.0 then
            call MUE(u , distance * duration / ( duration + CrocodileSpells__CrocodilePeriod ) , duration , Atan2(y - GetUnitY(u), x - GetUnitX(u)))
        endif
    endfunction


        function s__CrocodileSpells__CrocodileQ_ExplosionDecor_CrocodileQExplosionDecor_Scan takes integer this returns nothing
            local real amount= 0.0
            local real section
            loop
                exitwhen amount >= s__CrocodileSpells__CrocodileQ_ExplosionDecor_distance[this]
                set section=RMinBJ(s__CrocodileSpells__CrocodileQ_ExplosionDecor_scanStep[this], s__CrocodileSpells__CrocodileQ_ExplosionDecor_distance[this] - amount)
                call DecorRemoveLine(s__CrocodileSpells__CrocodileQ_ExplosionDecor_c[this] , s__CrocodileSpells__CrocodileQ_ExplosionDecor_x[this] + amount * Cos(s__CrocodileSpells__CrocodileQ_ExplosionDecor_a[this]) , s__CrocodileSpells__CrocodileQ_ExplosionDecor_y[this] + amount * Sin(s__CrocodileSpells__CrocodileQ_ExplosionDecor_a[this]) , s__CrocodileSpells__CrocodileQ_ExplosionDecor_a[this] , section , s__CrocodileSpells__CrocodileQ_ExplosionDecor_radius[this] , 25.0 , CrocodileSpells__CrocodileDecorHits , s__CrocodileSpells__CrocodileQ_ExplosionDecor_decorKey[this])
                set amount=amount + section
            endloop
        endfunction

        function s__CrocodileSpells__CrocodileQ_ExplosionDecor_Loop_CrocodileQExplosionDecor takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__CrocodileSpells__CrocodileQ_ExplosionDecor_MUI
                set this=s__CrocodileSpells__CrocodileQ_ExplosionDecor_m[i]
                set s__CrocodileSpells__CrocodileQ_ExplosionDecor_r[this]=RoundReal(s__CrocodileSpells__CrocodileQ_ExplosionDecor_r[this] + CrocodileSpells__CrocodilePeriod , 3)
                set s__CrocodileSpells__CrocodileQ_ExplosionDecor_pulse[this]=s__CrocodileSpells__CrocodileQ_ExplosionDecor_pulse[this] + CrocodileSpells__CrocodilePeriod
                if SpellBoolCaster(s__CrocodileSpells__CrocodileQ_ExplosionDecor_c[this]) and LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileQ_ExplosionDecor_c[this]), CrocodileSpells__CrocodileCore_DataKey) != 0 and ( s__CrocodileSpells__CrocodileQ_ExplosionDecor_pulse[this] + 0.001 >= CrocodileQ_DecorRetryPeriod or s__CrocodileSpells__CrocodileQ_ExplosionDecor_r[this] + 0.001 >= s__CrocodileSpells__CrocodileQ_ExplosionDecor_rmax[this] ) then
                    set s__CrocodileSpells__CrocodileQ_ExplosionDecor_pulse[this]=0.0
                    call s__CrocodileSpells__CrocodileQ_ExplosionDecor_CrocodileQExplosionDecor_Scan(this)
                endif
                if s__CrocodileSpells__CrocodileQ_ExplosionDecor_r[this] + 0.001 >= s__CrocodileSpells__CrocodileQ_ExplosionDecor_rmax[this] or not SpellBoolCaster(s__CrocodileSpells__CrocodileQ_ExplosionDecor_c[this]) or LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileQ_ExplosionDecor_c[this]), CrocodileSpells__CrocodileCore_DataKey) == 0 then
                    call FlushChildHashtable(CrocodileSpells__CrocodileDecorHits, s__CrocodileSpells__CrocodileQ_ExplosionDecor_decorKey[this])
                    set s__CrocodileSpells__CrocodileQ_ExplosionDecor_c[this]=null
                    set s__CrocodileSpells__CrocodileQ_ExplosionDecor_m[i]=s__CrocodileSpells__CrocodileQ_ExplosionDecor_m[s__CrocodileSpells__CrocodileQ_ExplosionDecor_MUI]
                    set s__CrocodileSpells__CrocodileQ_ExplosionDecor_MUI=s__CrocodileSpells__CrocodileQ_ExplosionDecor_MUI - 1
                    call s__CrocodileSpells__CrocodileQ_ExplosionDecor_deallocate(this)
                    if s__CrocodileSpells__CrocodileQ_ExplosionDecor_MUI == - 1 then
                        call GearTimer03Release()
                    endif
                else
                    set i=i + 1
                endif
            endloop
        endfunction

        function s__CrocodileSpells__CrocodileQ_ExplosionDecor_CrocodileQExplosionDecor_Start takes unit NewC,real NewX,real NewY,real NewA,real NewDistance,real NewRadius,real NewScanStep returns nothing
            local integer this= s__CrocodileSpells__CrocodileQ_ExplosionDecor__allocate()
            set s__CrocodileSpells__CrocodileQ_ExplosionDecor_MUI=s__CrocodileSpells__CrocodileQ_ExplosionDecor_MUI + 1
            set s__CrocodileSpells__CrocodileQ_ExplosionDecor_m[s__CrocodileSpells__CrocodileQ_ExplosionDecor_MUI]=this
            if s__CrocodileSpells__CrocodileQ_ExplosionDecor_MUI == 0 then
                call GearTimer03Acquire()
            endif
            set s__CrocodileSpells__CrocodileQ_ExplosionDecor_c[this]=NewC
            set s__CrocodileSpells__CrocodileQ_ExplosionDecor_x[this]=NewX
            set s__CrocodileSpells__CrocodileQ_ExplosionDecor_y[this]=NewY
            set s__CrocodileSpells__CrocodileQ_ExplosionDecor_a[this]=NewA
            set s__CrocodileSpells__CrocodileQ_ExplosionDecor_distance[this]=NewDistance
            set s__CrocodileSpells__CrocodileQ_ExplosionDecor_radius[this]=NewRadius
            set s__CrocodileSpells__CrocodileQ_ExplosionDecor_scanStep[this]=RMaxBJ(1.0, NewScanStep)
            set s__CrocodileSpells__CrocodileQ_ExplosionDecor_r[this]=0.0
            set s__CrocodileSpells__CrocodileQ_ExplosionDecor_rmax[this]=RMaxBJ(CrocodileSpells__CrocodilePeriod, CrocodileQ_DecorRetryDuration)
            set s__CrocodileSpells__CrocodileQ_ExplosionDecor_pulse[this]=0.0
            set s__CrocodileSpells__CrocodileQ_ExplosionDecor_decorKey[this]=CrocodileSpells__CrocodileDecor_NewKey()
            call s__CrocodileSpells__CrocodileQ_ExplosionDecor_CrocodileQExplosionDecor_Scan(this)
        endfunction



        function s__CrocodileSpells__CrocodileQ_Struct_CrocodileQ_ClearVisuals takes integer this returns nothing
            local integer trail
            call DestroyEffect(s__CrocodileSpells__CrocodileQ_Struct_e[this])
            set s__CrocodileSpells__CrocodileQ_Struct_e[this]=null
            loop
                exitwhen s__CrocodileSpells__CrocodileQ_Struct_trails[this] == 0
                set trail=s__CrocodileSpells__CrocodileQ_Struct_trails[this]
                set s__CrocodileSpells__CrocodileQ_Struct_trails[this]=s__CrocodileSpells__CrocodileQ_Trail_next[trail]
                call DestroyEffect(s__CrocodileSpells__CrocodileQ_Trail_e[trail])
                set s__CrocodileSpells__CrocodileQ_Trail_e[trail]=null
                call s__CrocodileSpells__CrocodileQ_Trail_deallocate(trail)
            endloop
        endfunction

