                            else
                                set s__PatriotSpells___PatriotSpells_R_r3[this]=s__PatriotSpells___PatriotSpells_R_r3[this] + 0.03
                            endif
                        endif
                    else
                        call SaveReal(hs, GetHandleId(s__PatriotSpells___PatriotSpells_R_c[this]), PatriotSpells___SH_R_X, s__PatriotSpells___PatriotSpells_R_x1[this])
                        call SaveReal(hs, GetHandleId(s__PatriotSpells___PatriotSpells_R_c[this]), PatriotSpells___SH_R_Y, s__PatriotSpells___PatriotSpells_R_y1[this])

                        if s__PatriotSpells___PatriotSpells_R_r[this] == 1.02 then
                            set s__PatriotSpells___PatriotSpells_R_k[this]=0
                            loop
                                exitwhen s__PatriotSpells___PatriotSpells_R_k[this] == 3
                                call DestroyEffect(s___PatriotSpells___PatriotSpells_R_ee[s__PatriotSpells___PatriotSpells_R_ee[this]+s__PatriotSpells___PatriotSpells_R_k[this] + 4])
                                set s___PatriotSpells___PatriotSpells_R_ee[s__PatriotSpells___PatriotSpells_R_ee[this]+s__PatriotSpells___PatriotSpells_R_k[this] + 4]=null
                                set s__PatriotSpells___PatriotSpells_R_k[this]=s__PatriotSpells___PatriotSpells_R_k[this] + 1
                            endloop
                        endif

                        if s__PatriotSpells___PatriotSpells_R_r2[this] > 0.45 then
                            set s__PatriotSpells___PatriotSpells_R_k[this]=0
                            loop
                                exitwhen s__PatriotSpells___PatriotSpells_R_k[this] == 3
                                set x=(BlzGetLocalSpecialEffectX((s___PatriotSpells___PatriotSpells_R_ee[s__PatriotSpells___PatriotSpells_R_ee[this]+s__PatriotSpells___PatriotSpells_R_k[this]]))) // INLINED!!
                                set y=(BlzGetLocalSpecialEffectY((s___PatriotSpells___PatriotSpells_R_ee[s__PatriotSpells___PatriotSpells_R_ee[this]+s__PatriotSpells___PatriotSpells_R_k[this]]))) // INLINED!!
                                if s__PatriotSpells___PatriotSpells_R_k[this] == 1 then
                                    call DecorRemove(s__PatriotSpells___PatriotSpells_R_c[this] , x , y , s__PatriotSpells___PatriotSpells_R_aoe[this] , 25.0)
                                    call VisionTimed(GetOwningPlayer(s__PatriotSpells___PatriotSpells_R_c[this]) , x , y , 1000.0 , 2.0)
                                endif
                                call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_BY_Wood_Effect_Kula_2_YiYingCun2.mdl" , x + 250.0 * Cos(s__PatriotSpells___PatriotSpells_R_a[this]) , y + 250.0 * Sin(s__PatriotSpells___PatriotSpells_R_a[this]) , s__PatriotSpells___PatriotSpells_R_a[this] * bj_RADTODEG , 0.95 , 2.25 , 50.0 , 255 , 255 , 255 , 190))
                                call DestroyEffect(EffectSpawn("war3mapimported\\wos_3yue_5.mdl" , x , y , GetRandomReal(0, 359) , 1.5 , 0.6 , 0.0))
                                call DestroyEffect(EffectSpawn("war3mapimported\\wos_LD2209 (157).mdx" , x , y , GetRandomReal(0, 359) , 1.0 , 1.0 , 0.0))
                                call DestroyEffect(EffectSpawn("war3mapimported\\wos_1baozha_90.mdl" , x , y , GetRandomReal(0, 359) , 1.0 , 1.25 , 0.0))
                                set s__PatriotSpells___PatriotSpells_R_k[this]=s__PatriotSpells___PatriotSpells_R_k[this] + 1
                            endloop

                            call GroupClear(s__PatriotSpells___PatriotSpells_R_g[this])
                            call GroupEnumUnitsInRange(s__PatriotSpells___PatriotSpells_R_g[this], s__PatriotSpells___PatriotSpells_R_x1[this], s__PatriotSpells___PatriotSpells_R_y1[this], s__PatriotSpells___PatriotSpells_R_aoe[this] + 75.0, NoDecor_Cond)
                            loop
                                set u=FirstOfGroup(s__PatriotSpells___PatriotSpells_R_g[this])
                                exitwhen u == null
                                if IsUnitEnemy(u, GetOwningPlayer(s__PatriotSpells___PatriotSpells_R_c[this])) and SpellBool(u) then
                                    set GearDamageNextSource=('A0EA') // INLINED!!
                                    call dmgphys(s__PatriotSpells___PatriotSpells_R_c[this] , u , s__PatriotSpells___PatriotSpells_R_dmg2[this])
                                    if GetHeroLevel(s__PatriotSpells___PatriotSpells_R_c[this]) >= 35 then
                                        call PatriotPas(s__PatriotSpells___PatriotSpells_R_c[this] , u)
