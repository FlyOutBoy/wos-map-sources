                    if s__PatriotSpells___PatriotSpells_T2_r[this] == 1.95 then
                        set s__PatriotSpells___PatriotSpells_T2_scale[this]=0.15
                        call MakeSound("war3mapimported\\Hero_Patriot_T2 3")
                        // 15 тиков на падение от fly до 0 (2.40 - 1.95 = 0.45 сек)
                        set s__PatriotSpells___PatriotSpells_T2_r5[this]=s__PatriotSpells___PatriotSpells_T2_fly[this] / 15.0
                        call BlzSetSpecialEffectPosition(s__PatriotSpells___PatriotSpells_T2_e[this], s__PatriotSpells___PatriotSpells_T2_x[this], s__PatriotSpells___PatriotSpells_T2_y[this], s__PatriotSpells___PatriotSpells_T2_fly[this])
                        call BlzSetSpecialEffectPosition(s__PatriotSpells___PatriotSpells_T2_e2[this], s__PatriotSpells___PatriotSpells_T2_x[this], s__PatriotSpells___PatriotSpells_T2_y[this], s__PatriotSpells___PatriotSpells_T2_fly[this])
                        call BlzSetSpecialEffectPosition(s__PatriotSpells___PatriotSpells_T2_e4[this], s__PatriotSpells___PatriotSpells_T2_x[this], s__PatriotSpells___PatriotSpells_T2_y[this], s__PatriotSpells___PatriotSpells_T2_fly[this])
                        call BlzSetSpecialEffectPosition(s__PatriotSpells___PatriotSpells_T2_e5[this], s__PatriotSpells___PatriotSpells_T2_x[this], s__PatriotSpells___PatriotSpells_T2_y[this], s__PatriotSpells___PatriotSpells_T2_fly[this])
                        call BlzSetSpecialEffectPosition(s__PatriotSpells___PatriotSpells_T2_e6[this], s__PatriotSpells___PatriotSpells_T2_x[this], s__PatriotSpells___PatriotSpells_T2_y[this], s__PatriotSpells___PatriotSpells_T2_fly[this])
                        call BlzSetSpecialEffectPitch(s__PatriotSpells___PatriotSpells_T2_e[this], - 270.0 * bj_DEGTORAD)
                    endif

