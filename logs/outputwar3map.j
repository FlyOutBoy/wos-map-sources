            set s__AlucardSpells__AlucardSpells_Q_a[this]=GAngle(s__AlucardSpells__AlucardSpells_Q_c[this] , s__AlucardSpells__AlucardSpells_Q_td[this])
            call SetUnitFacing(s__AlucardSpells__AlucardSpells_Q_c[this], s__AlucardSpells__AlucardSpells_Q_a[this] * bj_RADTODEG)
            call MakeSound("war3mapimported\\Hero_Alucard_Q1")
            call SetUnitAnimationByIndex(s__AlucardSpells__AlucardSpells_Q_c[this], 12)
            call SetUnitTimeScale(s__AlucardSpells__AlucardSpells_Q_c[this], 0.65)
            set s__AlucardSpells__AlucardSpells_Q_k[this]=GetRandomInt(1, 3)
            if s__AlucardSpells__AlucardSpells_Q_k[this] == 1 then
                call MakeSound("war3mapimported\\Hero_Alucard_Q2 01")
            elseif s__AlucardSpells__AlucardSpells_Q_k[this] == 2 then
                call MakeSound("war3mapimported\\Hero_Alucard_Q2 02")
            elseif s__AlucardSpells__AlucardSpells_Q_k[this] == 3 then
                call MakeSound("war3mapimported\\Hero_Alucard_Q2 03")
            endif
            call DestroyEffect(EffectSpawn("war3mapimported\\wos_krk (1971).mdl" , GetUnitX(s__AlucardSpells__AlucardSpells_Q_c[this]) , GetUnitY(s__AlucardSpells__AlucardSpells_Q_c[this]) , GetRandomReal(0, 359) , 0.65 , 1.25 , 0))
            if s__AlucardSpells__AlucardSpells_Q_MUI_AlucardQ == 0 then
                call AlucardSpells__AlucardTick_Off(4)
                call AlucardSpells__AlucardTick_On(5)
            endif
