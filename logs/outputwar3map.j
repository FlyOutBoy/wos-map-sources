            set s__DarkShikiSpells__DarkShikiG_KS_check[this]=0
            set s__DarkShikiSpells__DarkShikiG_KS_check2[this]=0
            set s__DarkShikiSpells__DarkShikiG_KS_k2[this]=GetPlayerId(GetOwningPlayer(s__DarkShikiSpells__DarkShikiG_KS_c[this]))
