                                call MakeSound("war3mapImported\\Hero_Erza1_T4")
                                call PosUnit(s__ErzaWSpells__Erza2T_KS_td[this] , GetUnitX(s__ErzaWSpells__Erza2T_KS_c[this]) + 130 * Cos(s__ErzaWSpells__Erza2T_KS_a[this]) , GetUnitY(s__ErzaWSpells__Erza2T_KS_c[this]) + 130 * Sin(s__ErzaWSpells__Erza2T_KS_a[this]))
                            endif
                        endif
                    elseif s__ErzaWSpells__Erza2T_KS_check[this] == 1 then
                        set s__ErzaWSpells__Erza2T_KS_x[this]=GetUnitX(s__ErzaWSpells__Erza2T_KS_td[this])
                        set s__ErzaWSpells__Erza2T_KS_y[this]=GetUnitY(s__ErzaWSpells__Erza2T_KS_td[this])
                        if s__ErzaWSpells__Erza2T_KS_r[this] == s__ErzaWSpells__Erza2T_KS_rmax[this] then
                            call SetUnitAnimation(s__ErzaWSpells__Erza2T_KS_td[this], "death")
                        call DecorRemove(s__ErzaWSpells__Erza2T_KS_c[this] , s__ErzaWSpells__Erza2T_KS_x[this] , s__ErzaWSpells__Erza2T_KS_y[this] , s__ErzaWSpells__Erza2T_KS_aoe[this] , 70)
                            call VisionTimed(GetOwningPlayer(s__ErzaWSpells__Erza2T_KS_c[this]) , s__ErzaWSpells__Erza2T_KS_x[this] , s__ErzaWSpells__Erza2T_KS_y[this] , 1250 , 2)
                            call ColorEffDummy3Alpha((EffectSpawn("war3mapImported\\wos_blue spin slash.mdl" , s__ErzaWSpells__Erza2T_KS_x[this] , s__ErzaWSpells__Erza2T_KS_y[this] , s__ErzaWSpells__Erza2T_KS_a[this] * bj_RADTODEG + 120 , 1 , 0.75 , 1) ) , (( 0.5 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.675)*1.0)) // INLINED!!
                            call ColorEffDummy3Alpha((EffectSpawn("war3mapImported\\wos_blue spin slash.mdl" , s__ErzaWSpells__Erza2T_KS_x[this] , s__ErzaWSpells__Erza2T_KS_y[this] , s__ErzaWSpells__Erza2T_KS_a[this] * bj_RADTODEG + 240 , 1 , 1.25 , 1) ) , (( 0.5 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.675)*1.0)) // INLINED!!
                            call ColorEffDummy3Alpha((EffectSpawn("war3mapImported\\wos_blue spin slash.mdl" , s__ErzaWSpells__Erza2T_KS_x[this] , s__ErzaWSpells__Erza2T_KS_y[this] , s__ErzaWSpells__Erza2T_KS_a[this] * bj_RADTODEG + 360 , 1 , 1.75 , 1) ) , (( 0.5 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.675)*1.0)) // INLINED!!
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_Opdef17 (1110).mdl" , s__ErzaWSpells__Erza2T_KS_x[this] , s__ErzaWSpells__Erza2T_KS_y[this] , GetRandomReal(0, 359) , 1.15 , 1.5 , 35))
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_obr08 (214).mdl" , s__ErzaWSpells__Erza2T_KS_x[this] , s__ErzaWSpells__Erza2T_KS_y[this] , GetRandomReal(0, 359) , 1.15 , 2.5 , 1))
                            call GroupEnumUnitsInRange(s__ErzaWSpells__Erza2T_KS_g[this], s__ErzaWSpells__Erza2T_KS_x[this], s__ErzaWSpells__Erza2T_KS_y[this], s__ErzaWSpells__Erza2T_KS_aoe[this], NoDecor_Cond)
                            loop
                                set s__ErzaWSpells__Erza2T_KS_u[this]=FirstOfGroup(s__ErzaWSpells__Erza2T_KS_g[this])
                                exitwhen s__ErzaWSpells__Erza2T_KS_u[this] == null
                                if IsUnitEnemy(s__ErzaWSpells__Erza2T_KS_u[this], GetOwningPlayer(s__ErzaWSpells__Erza2T_KS_c[this])) and SpellBool(s__ErzaWSpells__Erza2T_KS_u[this]) then
                                    set GearDamageNextSource=('A03B') // INLINED!!
                                    call dmgmag(s__ErzaWSpells__Erza2T_KS_c[this] , s__ErzaWSpells__Erza2T_KS_u[this] , s__ErzaWSpells__Erza2T_KS_dmg[this])
                                    set GearDamageNextSource=('A03B') // INLINED!!
                                    call ErzaPassive(s__ErzaWSpells__Erza2T_KS_c[this] , s__ErzaWSpells__Erza2T_KS_u[this] , 2)
                                endif
                                call GroupRemoveUnit(s__ErzaWSpells__Erza2T_KS_g[this], s__ErzaWSpells__Erza2T_KS_u[this])
                            endloop
                           
                        endif
                    endif
                else
                    call DestroyEffect(s__ErzaWSpells__Erza2T_KS_e[this])
                    call DestroyEffect(s__ErzaWSpells__Erza2T_KS_e2[this])
                    call StopSpellUnit2(s__ErzaWSpells__Erza2T_KS_c[this])
                    call DestroyGroup(s__ErzaWSpells__Erza2T_KS_g[this])
                    set s__ErzaWSpells__Erza2T_KS_g[this]=null
                    set s__ErzaWSpells__Erza2T_KS_c[this]=null
                    set s__ErzaWSpells__Erza2T_KS_td[this]=null
                    set s__ErzaWSpells__Erza2T_KS_e[this]=null
                    set s__ErzaWSpells__Erza2T_KS_e2[this]=null
                    set s__ErzaWSpells__Erza2T_KS_u[this]=null
                    set s__ErzaWSpells__Erza2T_KS_m_ErzaT[i]=s__ErzaWSpells__Erza2T_KS_m_ErzaT[s__ErzaWSpells__Erza2T_KS_MUI_ErzaT]
                    set s__ErzaWSpells__Erza2T_KS_MUI_ErzaT=s__ErzaWSpells__Erza2T_KS_MUI_ErzaT - 1
                    set i=i - 1 // revisit: the moved instance must not skip this tick
                    if s__ErzaWSpells__Erza2T_KS_MUI_ErzaT == - 1 then
                        call ErzaWSpells__ErzaWTick_Off(3)
                    endif
                    call s__ErzaWSpells__Erza2T_KS_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction
        function s__ErzaWSpells__Erza2T_KS_ErzaT_Start takes unit NewC,unit NewTd returns nothing
            local integer this= s__ErzaWSpells__Erza2T_KS__allocate()
            set s__ErzaWSpells__Erza2T_KS_MUI_ErzaT=s__ErzaWSpells__Erza2T_KS_MUI_ErzaT + 1
            set s__ErzaWSpells__Erza2T_KS_m_ErzaT[s__ErzaWSpells__Erza2T_KS_MUI_ErzaT]=this
            set s__ErzaWSpells__Erza2T_KS_c[this]=NewC
            set s__ErzaWSpells__Erza2T_KS_td[this]=NewTd
            set s__ErzaWSpells__Erza2T_KS_r[this]=0
            set s__ErzaWSpells__Erza2T_KS_r2[this]=0
            set s__ErzaWSpells__Erza2T_KS_check[this]=0
            call StartSpellUnit2(s__ErzaWSpells__Erza2T_KS_c[this])
            set s__ErzaWSpells__Erza2T_KS_g[this]=CreateGroup()
            set s__ErzaWSpells__Erza2T_KS_u[this]=null
            set s__ErzaWSpells__Erza2T_KS_a[this]=GAngle(s__ErzaWSpells__Erza2T_KS_c[this] , s__ErzaWSpells__Erza2T_KS_td[this]) // Angle Between points
            call SetUnitFacing(s__ErzaWSpells__Erza2T_KS_c[this], s__ErzaWSpells__Erza2T_KS_a[this] * bj_RADTODEG)
            set s__ErzaWSpells__Erza2T_KS_aoe[this]=Erza2T_DamageAoe
            set s__ErzaWSpells__Erza2T_KS_dmg[this]=GetHeroAgi(s__ErzaWSpells__Erza2T_KS_c[this], true) * Erza2T_DamageAgiBase
            set s__ErzaWSpells__Erza2T_KS_rmax[this]=5
            set s__ErzaWSpells__Erza2T_KS_move[this]=80
            set s__ErzaWSpells__Erza2T_KS_e[this]=AddSpecialEffectTarget("war3mapImported\\wos_aurapartred2.mdx", s__ErzaWSpells__Erza2T_KS_c[this], "origin")
            call SetUnitTimeScale(s__ErzaWSpells__Erza2T_KS_c[this], 0.65)
            call SetUnitAnimationByIndex(s__ErzaWSpells__Erza2T_KS_c[this], 5)
            call MakeSound("war3mapImported\\Hero_Erza2_T")
            if s__ErzaWSpells__Erza2T_KS_MUI_ErzaT == 0 then
                call ErzaWSpells__ErzaWTick_On(3)
            endif
        endfunction

    //----------------------------Erza-----------------------------------------------
      
    function Erza2Q_Start takes unit c,unit td returns nothing
        call s__ErzaWSpells__Erza2Q_KS_ErzaQ_Start(c , td)
    endfunction
    function Erza2W_Start takes unit c returns nothing
        call s__ErzaWSpells__Erza2W_KS_ErzaW_Start(c)
    endfunction
    function Erza2E_Start takes unit c,real x,real y returns nothing
        call s__ErzaWSpells__Erza2E_KS_ErzaE_Start(c , x , y)
    endfunction
    function Erza2R_Start takes unit c,real x,real y returns nothing
        call s__ErzaWSpells__Erza2R_KS_ErzaR_Start(c , x , y)
    endfunction
    function Erza2T_Start takes unit c,unit td returns nothing
        call s__ErzaWSpells__Erza2T_KS_ErzaT_Start(c , td)
    endfunction
   

        function s__ErzaWSpells__ErzaWTick_Loop_Loop takes nothing returns nothing
            if ErzaWSpells__ErzaWTick_Active[0] then
                call s__ErzaWSpells__Erza2Q_KS_Loop_ErzaQ()
            endif
            if ErzaWSpells__ErzaWTick_Active[1] then
                call s__ErzaWSpells__Erza2E_KS_Loop_ErzaE()
            endif
            if ErzaWSpells__ErzaWTick_Active[2] then
                call s__ErzaWSpells__Erza2R_KS_Loop_ErzaR()
            endif
            if ErzaWSpells__ErzaWTick_Active[3] then
                call s__ErzaWSpells__Erza2T_KS_Loop_ErzaT()
            endif
        endfunction

        function s__ErzaWSpells__ErzaWTick_Loop_onInit takes nothing returns nothing
            set ErzaWSpells__ErzaWTick_Callback=function s__ErzaWSpells__ErzaWTick_Loop_Loop
        endfunction


        function s__ErzaWSpells__ErzaWTick10_Loop_Loop takes nothing returns nothing
            if ErzaWSpells__ErzaWTick10_Active[0] then
                call s__ErzaWSpells__Erza2W_KS_Loop_ErzaW()
            endif
        endfunction

        function s__ErzaWSpells__ErzaWTick10_Loop_onInit takes nothing returns nothing
            set ErzaWSpells__ErzaWTick10_Callback=function s__ErzaWSpells__ErzaWTick10_Loop_Loop
        endfunction


//library ErzaWSpells ends
//library FrostnovaSpells:

    function FrostnovaQRange takes unit hero,integer level returns real
        local real distance= FrostnovaQ_Range + FrostnovaQ_RangeStep * ( IMaxBJ(1, level) - 1 )
        if GetHeroLevel(hero) >= 35 then
            set distance=distance + FrostnovaQ_RangeBonus35
        endif
        return distance
    endfunction

    function FrostnovaWRange takes unit hero returns real
        if GetHeroLevel(hero) >= 35 then
            return FrostnovaW_Range + FrostnovaW_RangeBonus35
        endif
        return FrostnovaW_Range
    endfunction

    // Q7 plays at 90% of MakeSound's volume.
    function FrostnovaSpells__FrostnovaQ7Sound takes nothing returns nothing
        if BankaiActive then
            call GearSoundPlay(FrostnovaSpells__FrostnovaSoundPath + "Q7.mp3" , 36 , false , null)
        else
            call GearSoundPlay(FrostnovaSpells__FrostnovaSoundPath + "Q7.mp3" , 114 , false , null)
        endif
    endfunction

    
    // A dead hero can read life above 0.405 (a heal landing after death), so
    // SpellBoolCaster alone kept Q charges orbiting her corpse until revive.
    function FrostnovaSpells__FrostnovaAlive takes unit hero returns boolean
        return SpellBoolCaster(hero) and not IsUnitType(hero, UNIT_TYPE_DEAD)
    endfunction

    // ==================== COMMON: Q charges and shared mode flag ====================

        function s__FrostnovaSpells__FrostnovaState_Activate takes integer this returns nothing
            if not s__FrostnovaSpells__FrostnovaState_ticking[this] then
                set s__FrostnovaSpells__FrostnovaState_ticking[this]=true
                set s__FrostnovaSpells__FrostnovaState_active[s__FrostnovaSpells__FrostnovaState_count]=this
                set s__FrostnovaSpells__FrostnovaState_count=s__FrostnovaSpells__FrostnovaState_count + 1
                call GearTimer03Acquire()
            endif
        endfunction

        function s__FrostnovaSpells__FrostnovaState_RefreshShield takes integer this returns nothing
            // Rare cast: the shared one-shot buff caster in gg_rct_Caster; a recast renews the native 4 sec buff.
            call BuffUnit01(s__FrostnovaSpells__FrostnovaState_hero[this] , s__FrostnovaSpells__FrostnovaState_hero[this] , FrostnovaT_ShieldAbilityID , "frostarmor" , 1)
            set s__FrostnovaSpells__FrostnovaState_shieldRemaining[this]=FrostnovaT_ShieldDuration
            call s__FrostnovaSpells__FrostnovaState_Activate(this)
        endfunction

        function s__FrostnovaSpells__FrostnovaState_SetIcons takes integer this,boolean enhanced returns nothing
            local integer level= 0
            local string prefix= "ReplaceableTextures\\CommandButtons\\BTNHero_Frostnova_"
            if enhanced then
                set prefix=prefix + "T"
            endif
            // Per-unit art avoids changing a second Frostnova's normal icons.
            loop
                exitwhen level >= 5
                call BlzSetAbilityStringLevelField(BlzGetUnitAbility(s__FrostnovaSpells__FrostnovaState_hero[this], FrostnovaQ_ID), ABILITY_SLF_ICON_NORMAL, level, prefix + "Q.blp")
                call BlzSetAbilityStringLevelField(BlzGetUnitAbility(s__FrostnovaSpells__FrostnovaState_hero[this], FrostnovaW_ID), ABILITY_SLF_ICON_NORMAL, level, prefix + "W.blp")
                call BlzSetAbilityStringLevelField(BlzGetUnitAbility(s__FrostnovaSpells__FrostnovaState_hero[this], FrostnovaE_ID), ABILITY_SLF_ICON_NORMAL, level, prefix + "E.blp")
                call BlzSetAbilityStringLevelField(BlzGetUnitAbility(s__FrostnovaSpells__FrostnovaState_hero[this], FrostnovaR_ID), ABILITY_SLF_ICON_NORMAL, level, prefix + "R.blp")
                set level=level + 1
            endloop
        endfunction

        // Only a Q/W/E/R cast can start a line. Casts during speech are skipped.
        function s__FrostnovaSpells__FrostnovaState_Voice takes integer this,boolean onCast returns nothing
            local real duration= 4.05
            if not onCast or s__FrostnovaSpells__FrostnovaState_winterRemaining[this] <= 0.0 or s__FrostnovaSpells__FrostnovaState_voiceRemaining[this] > 0.0001 then
                return
            endif
            if s__FrostnovaSpells__FrostnovaState_nextVoice[this] == 3 then
                set duration=4.677
            elseif s__FrostnovaSpells__FrostnovaState_nextVoice[this] == 4 then
                set duration=5.252
            endif
            call MakeSound(FrostnovaSpells__FrostnovaSoundPath + "T" + I2S(s__FrostnovaSpells__FrostnovaState_nextVoice[this]))
            call s__FrostnovaSpells__FrostnovaState_RefreshShield(this)
            set s__FrostnovaSpells__FrostnovaState_nextVoice[this]=s__FrostnovaSpells__FrostnovaState_nextVoice[this] + 1
            if s__FrostnovaSpells__FrostnovaState_nextVoice[this] > 4 then
                set s__FrostnovaSpells__FrostnovaState_nextVoice[this]=2
            endif
            set s__FrostnovaSpells__FrostnovaState_voiceRemaining[this]=duration + 0.03
            set s__FrostnovaSpells__FrostnovaState_voiceDuration[this]=s__FrostnovaSpells__FrostnovaState_voiceRemaining[this]
        endfunction



        // Six slots are the Q charges themselves. Only effect alpha is local.
        function s__FrostnovaSpells__FrostnovaState_UpdateShards takes integer this returns nothing
            local integer index= 0
            local integer row
            local real side
            local real orbitAngle
            local real orientationAngle= GetUnitFacing(s__FrostnovaSpells__FrostnovaState_hero[this]) * bj_DEGTORAD
            local real positionX
            local real positionY
            local real z
            local integer alpha= 255
            local effect shardEffect
            local effect shadow
            set s__FrostnovaSpells__FrostnovaState_enhancedShards[this]=s__FrostnovaSpells__FrostnovaState_winterRemaining[this] > 0.0
            // Use the actual viewer: a neutral player's vision must not hide
            // the charges from a player who can see the hero.
            if IsUnitInvisible(s__FrostnovaSpells__FrostnovaState_hero[this], GetLocalPlayer()) or not IsUnitVisible(s__FrostnovaSpells__FrostnovaState_hero[this], GetLocalPlayer()) then
                set alpha=0
            endif
            loop
                exitwhen index >= 6
                set shardEffect=LoadEffectHandle(FrostnovaSpells__FrostnovaTable, GetHandleId(s__FrostnovaSpells__FrostnovaState_hero[this]), 100 + index)
                if index < (LoadInteger(hs, GetHandleId(((s__FrostnovaSpells__FrostnovaState_hero[this]))), GearSystems2___SH_STACK_COUNT)) and FrostnovaSpells__FrostnovaAlive(s__FrostnovaSpells__FrostnovaState_hero[this]) and GetUnitTypeId(s__FrostnovaSpells__FrostnovaState_hero[this]) != 0 then // INLINED!!
                    set row=R2I(I2R(index) / 2.0)
                    set side=1.0
                    if ModuloInteger(index, 2) == 0 then
                        set side=- 1.0
                    endif
                    set orbitAngle=orientationAngle + s__FrostnovaSpells__FrostnovaState_orbitTime[this] * FrostnovaQ_OrbitSpeed + row * bj_PI / 3.0 + side * bj_PI / 2.0
                    set positionX=GetUnitX(s__FrostnovaSpells__FrostnovaState_hero[this]) + ( FrostnovaQ_OrbitSide + row * FrostnovaQ_OrbitRowSide ) * Cos(orbitAngle)
                    set positionY=GetUnitY(s__FrostnovaSpells__FrostnovaState_hero[this]) + ( FrostnovaQ_OrbitSide + row * FrostnovaQ_OrbitRowSide ) * Sin(orbitAngle)
                    set z=BlzGetUnitZ(s__FrostnovaSpells__FrostnovaState_hero[this]) + FrostnovaQ_OrbitHeight + index * FrostnovaQ_OrbitLayerHeight + Sin(s__FrostnovaSpells__FrostnovaState_orbitTime[this] * 1.7 + index) * FrostnovaQ_OrbitSway
                    if shardEffect == null then
                        set shardEffect=AddSpecialEffect(FrostnovaQ_Model, positionX, positionY)
                        call SaveEffectHandle(FrostnovaSpells__FrostnovaTable, GetHandleId(s__FrostnovaSpells__FrostnovaState_hero[this]), 100 + index, shardEffect)
                        call BlzSetSpecialEffectScale(shardEffect, FrostnovaQ_ModelScale / FrostnovaQ_OrbitScaleDivisor)
                        call BlzPlaySpecialEffect(shardEffect, ANIM_TYPE_STAND)
                    endif
                    call BlzSetSpecialEffectPosition(shardEffect, positionX, positionY, z)
                    call BlzSetSpecialEffectYaw(shardEffect, orbitAngle + bj_PI / 2.0)
                    call BlzSetSpecialEffectAlpha(shardEffect, alpha)
                elseif shardEffect != null then
                    call DestroyEffect(shardEffect)
                    call RemoveSavedHandle(FrostnovaSpells__FrostnovaTable, GetHandleId(s__FrostnovaSpells__FrostnovaState_hero[this]), 100 + index)
                endif
                set shadow=LoadEffectHandle(FrostnovaSpells__FrostnovaTable, GetHandleId(s__FrostnovaSpells__FrostnovaState_hero[this]), 200 + index)
                if s__FrostnovaSpells__FrostnovaState_enhancedShards[this] and index < (LoadInteger(hs, GetHandleId(((s__FrostnovaSpells__FrostnovaState_hero[this]))), GearSystems2___SH_STACK_COUNT)) and FrostnovaSpells__FrostnovaAlive(s__FrostnovaSpells__FrostnovaState_hero[this]) and GetUnitTypeId(s__FrostnovaSpells__FrostnovaState_hero[this]) != 0 then // INLINED!!
                    if shadow == null then
                        set shadow=AddSpecialEffect(FrostnovaTQ_ShadowModel, positionX, positionY)
                        call SaveEffectHandle(FrostnovaSpells__FrostnovaTable, GetHandleId(s__FrostnovaSpells__FrostnovaState_hero[this]), 200 + index, shadow)
                        call BlzSetSpecialEffectScale(shadow, FrostnovaQ_ModelScale * FrostnovaTQ_ParticleScale / FrostnovaQ_OrbitScaleDivisor)
                        call BlzPlaySpecialEffect(shadow, ANIM_TYPE_STAND)
                    endif
                    call BlzSetSpecialEffectPosition(shadow, positionX - 35.0 * Cos(orbitAngle + bj_PI / 2.0), positionY - 35.0 * Sin(orbitAngle + bj_PI / 2.0), z - 10.0)
                    call BlzSetSpecialEffectYaw(shadow, orbitAngle + bj_PI / 2.0)
                    call BlzSetSpecialEffectAlpha(shadow, alpha * FrostnovaTQ_ParticleAlpha / 255)
                elseif shadow != null then
                    call DestroyEffect(shadow)
                    call RemoveSavedHandle(FrostnovaSpells__FrostnovaTable, GetHandleId(s__FrostnovaSpells__FrostnovaState_hero[this]), 200 + index)
                endif
                set index=index + 1
            endloop
            set shadow=null
            set shardEffect=null
        endfunction

        function s__FrostnovaSpells__FrostnovaState_RefreshRange takes integer this returns nothing
            local integer level= 0
            local boolean enhancedRange= GetHeroLevel(s__FrostnovaSpells__FrostnovaState_hero[this]) >= 35
            if s__FrostnovaSpells__FrostnovaState_rangeBonus[this] == enhancedRange then
                return
            endif
            set s__FrostnovaSpells__FrostnovaState_rangeBonus[this]=enhancedRange
            loop
                exitwhen level == 5
                call BlzSetAbilityRealLevelField(BlzGetUnitAbility(s__FrostnovaSpells__FrostnovaState_hero[this], FrostnovaQ_ID), ABILITY_RLF_CAST_RANGE, level, FrostnovaQRange(s__FrostnovaSpells__FrostnovaState_hero[this] , level + 1))
                call BlzSetAbilityRealLevelField(BlzGetUnitAbility(s__FrostnovaSpells__FrostnovaState_hero[this], FrostnovaW_ID), ABILITY_RLF_CAST_RANGE, level, FrostnovaWRange(s__FrostnovaSpells__FrostnovaState_hero[this]))
                set level=level + 1
            endloop
        endfunction

        function s__FrostnovaSpells__FrostnovaState_RefreshCharges takes integer this returns nothing
            local integer level= GetUnitAbilityLevel(s__FrostnovaSpells__FrostnovaState_hero[this], FrostnovaQ_ID)
            local integer maximum= IMinBJ(6, 2 + 2 * ( ( IMaxBJ(1, level) - 1 ) / 2 ))
            local integer oldMaximum= (s__KS_SpellStacks_GetMaxStackCount((s__FrostnovaSpells__FrostnovaState_hero[this]))) // INLINED!!
            set s__FrostnovaSpells__FrostnovaState_qLevel[this]=level
            // Same tracker and native cooldown scheduling as TojiE.
            call s__KS_SpellStacks_MyAddSpellStacks_Start((s__FrostnovaSpells__FrostnovaState_hero[this] ) , ( FrostnovaQ_ID ) , ( 0 ) , ( maximum ) , (( FrostnovaQ_Recharge + FrostnovaQ_RechargeStep * ( IMaxBJ(1, level) - 1 ))*1.0)) // INLINED!!
            if oldMaximum > 0 and maximum > oldMaximum then
                call s__KS_SpellStacks_AddStacks((s__FrostnovaSpells__FrostnovaState_hero[this] ) , ( maximum - oldMaximum)) // INLINED!!
            endif
            call s__FrostnovaSpells__FrostnovaState_UpdateShards(this)
            call s__FrostnovaSpells__FrostnovaState_Activate(this)
        endfunction

        function s__FrostnovaSpells__FrostnovaState_Loop takes nothing returns nothing
            local integer index= 0
            local integer this
            loop
                exitwhen index >= s__FrostnovaSpells__FrostnovaState_count
                set this=s__FrostnovaSpells__FrostnovaState_active[index]
                if GetUnitTypeId(s__FrostnovaSpells__FrostnovaState_hero[this]) != 0 and GetUnitAbilityLevel(s__FrostnovaSpells__FrostnovaState_hero[this], FrostnovaQ_ID) != s__FrostnovaSpells__FrostnovaState_qLevel[this] then
                    call s__FrostnovaSpells__FrostnovaState_RefreshCharges(this)
                endif
                if GetUnitTypeId(s__FrostnovaSpells__FrostnovaState_hero[this]) != 0 and s__FrostnovaSpells__FrostnovaState_rangeBonus[this] != ( GetHeroLevel(s__FrostnovaSpells__FrostnovaState_hero[this]) >= 35 ) then
                    call s__FrostnovaSpells__FrostnovaState_RefreshRange(this)
                endif
                set s__FrostnovaSpells__FrostnovaState_qCastDelay[this]=RMaxBJ(0.0, s__FrostnovaSpells__FrostnovaState_qCastDelay[this] - 0.03)
                set s__FrostnovaSpells__FrostnovaState_orbitTime[this]=s__FrostnovaSpells__FrostnovaState_orbitTime[this] + 0.03
                set s__FrostnovaSpells__FrostnovaState_voiceRemaining[this]=RMaxBJ(0.0, s__FrostnovaSpells__FrostnovaState_voiceRemaining[this] - 0.03)
                if s__FrostnovaSpells__FrostnovaState_shieldRemaining[this] > 0.0 then
                    if not IsUnitPaused(s__FrostnovaSpells__FrostnovaState_hero[this]) then
                        set s__FrostnovaSpells__FrostnovaState_shieldRemaining[this]=RMaxBJ(0.0, s__FrostnovaSpells__FrostnovaState_shieldRemaining[this] - 0.03)
                    endif
                    if s__FrostnovaSpells__FrostnovaState_shieldRemaining[this] <= 0.0001 or GetWidgetLife(s__FrostnovaSpells__FrostnovaState_hero[this]) <= 0.405 then
                        set s__FrostnovaSpells__FrostnovaState_shieldRemaining[this]=0.0
                        call UnitRemoveAbility(s__FrostnovaSpells__FrostnovaState_hero[this], FrostnovaT_ShieldBuffID)
                    endif
                endif
                if not FrostnovaSpells__FrostnovaAlive(s__FrostnovaSpells__FrostnovaState_hero[this]) or GetUnitTypeId(s__FrostnovaSpells__FrostnovaState_hero[this]) == 0 then
                    set s__FrostnovaSpells__FrostnovaState_winterRemaining[this]=0.0
                endif
                // A recovered charge never bypasses the personal between-shot delay.
                if (LoadInteger(hs, GetHandleId(((s__FrostnovaSpells__FrostnovaState_hero[this]))), GearSystems2___SH_STACK_COUNT)) > 0 then // INLINED!!
                    if s__FrostnovaSpells__FrostnovaState_qCastDelay[this] <= 0.0001 then
                        call BlzEndUnitAbilityCooldown(s__FrostnovaSpells__FrostnovaState_hero[this], FrostnovaQ_ID)
                    elseif RAbsBJ(BlzGetUnitAbilityCooldownRemaining(s__FrostnovaSpells__FrostnovaState_hero[this], FrostnovaQ_ID) - s__FrostnovaSpells__FrostnovaState_qCastDelay[this]) > 0.04 then
                        call BlzStartUnitAbilityCooldown(s__FrostnovaSpells__FrostnovaState_hero[this], FrostnovaQ_ID, s__FrostnovaSpells__FrostnovaState_qCastDelay[this])
                    endif
                endif
                set s__FrostnovaSpells__FrostnovaState_previousQCharges[this]=(LoadInteger(hs, GetHandleId(((s__FrostnovaSpells__FrostnovaState_hero[this]))), GearSystems2___SH_STACK_COUNT)) // INLINED!!
                call s__FrostnovaSpells__FrostnovaState_UpdateShards(this)
                if GetUnitTypeId(s__FrostnovaSpells__FrostnovaState_hero[this]) == 0 then
                    set s__FrostnovaSpells__FrostnovaState_ticking[this]=false
                    set s__FrostnovaSpells__FrostnovaState_count=s__FrostnovaSpells__FrostnovaState_count - 1
                    set s__FrostnovaSpells__FrostnovaState_active[index]=s__FrostnovaSpells__FrostnovaState_active[s__FrostnovaSpells__FrostnovaState_count]
                    call GearTimer03Release()
                    call s__KS_SpellStacks_Stop((s__FrostnovaSpells__FrostnovaState_hero[this])) // INLINED!!
                    call RemoveSavedInteger(FrostnovaSpells__FrostnovaTable, GetHandleId(s__FrostnovaSpells__FrostnovaState_hero[this]), 0)
                    set s__FrostnovaSpells__FrostnovaState_hero[this]=null
                    call s__FrostnovaSpells__FrostnovaState_deallocate(this)
                else
                    set index=index + 1
                endif
            endloop
        endfunction
    // Clamp the displacement ray to every Icefield that currently contains u.
    function FrostnovaSpells__FrostnovaIcefieldPush takes unit target,real remainingDistance,real angle returns real
        local integer index= 0
        local integer field
        local real dx
        local real dy
        local real projection
        local real perpendicular
        local real radius
        loop
            exitwhen index >= FrostnovaSpells__FrostnovaIcefieldCount
            set field=FrostnovaSpells__FrostnovaIcefields[index]
            set dx=GetUnitX(target) - FrostnovaSpells__FrostnovaIcefieldX[field]
            set dy=GetUnitY(target) - FrostnovaSpells__FrostnovaIcefieldY[field]
            set radius=FrostnovaSpells__FrostnovaIcefieldRadius[field]
            if dx * dx + dy * dy <= radius * radius then
                set projection=dx * Cos(angle) + dy * Sin(angle)
                set perpendicular=dx * Sin(angle) - dy * Cos(angle)
                set remainingDistance=RMinBJ(remainingDistance, RMaxBJ(0.0, SquareRoot(RMaxBJ(0.0, radius * radius - perpendicular * perpendicular)) - projection - 16.0))
            endif
            set index=index + 1
        endloop
        return remainingDistance
    endfunction

    // ==================== F: Yeti Princess (shared debuff) ====================

        function s__FrostnovaSpells__FrostnovaF_KS_StacksOn takes unit target returns integer
            local integer this= LoadInteger(FrostnovaSpells__FrostnovaTable, GetHandleId(target), 1)
            if this == 0 or ( GetUnitAbilityLevel(target, s__FrostnovaSpells__FrostnovaF_KS_buffId[this]) == 0 and s__FrostnovaSpells__FrostnovaF_KS_applyRemaining[this] <= 0.0001 ) then
                return 0
            endif
            return s__FrostnovaSpells__FrostnovaF_KS_stacks[this]
        endfunction

        function s__FrostnovaSpells__FrostnovaF_KS_ClearOldBuffs takes unit target,integer currentBuff returns nothing
            local integer level= 1
            loop
                exitwhen level > 10
                if FrostnovaSpells__FrostnovaFBuff[level] != currentBuff and GetUnitAbilityLevel(target, FrostnovaSpells__FrostnovaFBuff[level]) > 0 then
                    call UnitRemoveAbility(target, FrostnovaSpells__FrostnovaFBuff[level])
                endif
                set level=level + 1
            endloop
        endfunction

        function s__FrostnovaSpells__FrostnovaF_KS_Apply takes unit caster,unit target,boolean enhanced returns nothing
            local integer this= LoadInteger(FrostnovaSpells__FrostnovaTable, GetHandleId(target), 1)
            local unit dummy
            local integer abilityLevel
            local integer nativeStacks= 0
            local integer nativeLevel
            local boolean nativeEnhanced= false
            if GetHeroLevel(caster) < FrostnovaF_RequiredLevel or not IsUnitEnemy(target, GetOwningPlayer(caster)) or not SpellBool(target) or IsUnitType(target, UNIT_TYPE_STRUCTURE) or IsUnitType(target, UNIT_TYPE_MAGIC_IMMUNE) then
                return
            endif
            if DebuffImmune_Start(target , 1) == 0 then
                return
            endif
            // Recover the visible count before replacing every older F/TF tier.
            set abilityLevel=1
            loop
                exitwhen abilityLevel > 10
                if GetUnitAbilityLevel(target, FrostnovaSpells__FrostnovaFBuff[abilityLevel]) > 0 then
                    set nativeLevel=abilityLevel
                    if nativeLevel > 5 then
                        set nativeLevel=nativeLevel - 5
                        set nativeEnhanced=true
                    endif
                    set nativeStacks=IMaxBJ(nativeStacks, nativeLevel)
                endif
                set abilityLevel=abilityLevel + 1
            endloop
            if this == 0 then
                set this=s__FrostnovaSpells__FrostnovaF_KS__allocate()
                set s__FrostnovaSpells__FrostnovaF_KS_target[this]=target
                set s__FrostnovaSpells__FrostnovaF_KS_stacks[this]=nativeStacks
                set s__FrostnovaSpells__FrostnovaF_KS_empowered[this]=nativeEnhanced
                set s__FrostnovaSpells__FrostnovaF_KS_buffId[this]=0
                set s__FrostnovaSpells__FrostnovaF_KS_damageCountdown[this]=1.0
                set s__FrostnovaSpells__FrostnovaF_KS_active[s__FrostnovaSpells__FrostnovaF_KS_count]=this
                set s__FrostnovaSpells__FrostnovaF_KS_count=s__FrostnovaSpells__FrostnovaF_KS_count + 1
                call SaveInteger(FrostnovaSpells__FrostnovaTable, GetHandleId(target), 1, this)
                call GearTimer03Acquire()
            elseif nativeStacks > 0 then
                set s__FrostnovaSpells__FrostnovaF_KS_stacks[this]=IMaxBJ(s__FrostnovaSpells__FrostnovaF_KS_stacks[this], nativeStacks)
                set s__FrostnovaSpells__FrostnovaF_KS_empowered[this]=s__FrostnovaSpells__FrostnovaF_KS_empowered[this] or nativeEnhanced
            elseif s__FrostnovaSpells__FrostnovaF_KS_applyRemaining[this] <= 0.0001 then
                set s__FrostnovaSpells__FrostnovaF_KS_stacks[this]=0
                set s__FrostnovaSpells__FrostnovaF_KS_empowered[this]=false
                set s__FrostnovaSpells__FrostnovaF_KS_damageCountdown[this]=1.0
            endif
            set s__FrostnovaSpells__FrostnovaF_KS_hero[this]=caster
            set s__FrostnovaSpells__FrostnovaF_KS_stacks[this]=IMinBJ(FrostnovaF_MaxStacks, s__FrostnovaSpells__FrostnovaF_KS_stacks[this] + 1)
            set s__FrostnovaSpells__FrostnovaF_KS_empowered[this]=s__FrostnovaSpells__FrostnovaF_KS_empowered[this] or enhanced
            if s__FrostnovaSpells__FrostnovaF_KS_empowered[this] then
                set abilityLevel=s__FrostnovaSpells__FrostnovaF_KS_stacks[this] + 5
                set s__FrostnovaSpells__FrostnovaF_KS_buffId[this]=FrostnovaSpells__FrostnovaFBuff[abilityLevel]
                set s__FrostnovaSpells__FrostnovaF_KS_remainingTime[this]=FrostnovaTF_Duration
            else
                set abilityLevel=s__FrostnovaSpells__FrostnovaF_KS_stacks[this]
                set s__FrostnovaSpells__FrostnovaF_KS_buffId[this]=FrostnovaSpells__FrostnovaFBuff[abilityLevel]
                set s__FrostnovaSpells__FrostnovaF_KS_remainingTime[this]=FrostnovaF_Duration
            endif
            set s__FrostnovaSpells__FrostnovaF_KS_applyRemaining[this]=FrostnovaF_ApplyGrace
            call VisionTimed(GetOwningPlayer(caster) , GetUnitX(target) , GetUnitY(target) , FrostnovaQ_Aoe * 2.0 , 1.0)
            set s__FrostnovaSpells__FrostnovaF_KS_damage[this]=I2R(GetHeroInt(caster, true)) * FrostnovaTF_DamageInt
            // Dedicated caster: never put two Slow abilities on DummyPlayer.
            // Offensive orders use Frostnova's owner, not the victim's owner.
            set dummy=FrostnovaSpells__FrostnovaDummy[GetPlayerId(GetOwningPlayer(caster))]
            if dummy == null or GetWidgetLife(dummy) <= 0.405 then
                set dummy=CreateUnit(GetOwningPlayer(caster), 'h0C9', GetUnitX(target), GetUnitY(target), 0.0)
                set FrostnovaSpells__FrostnovaDummy[GetPlayerId(GetOwningPlayer(caster))]=dummy
            endif
            call UnitAddAbility(dummy, FrostnovaF_DebuffID)
            call IssueImmediateOrder(dummy, "slowoff")
            call SetUnitAbilityLevel(dummy, FrostnovaF_DebuffID, abilityLevel)
            call BlzEndUnitAbilityCooldown(dummy, FrostnovaF_DebuffID)
            call IssueTargetOrder(dummy, "slow", target)
            if GetUnitAbilityLevel(target, s__FrostnovaSpells__FrostnovaF_KS_buffId[this]) > 0 then
                call s__FrostnovaSpells__FrostnovaF_KS_ClearOldBuffs(target , s__FrostnovaSpells__FrostnovaF_KS_buffId[this])
                set s__FrostnovaSpells__FrostnovaF_KS_applyRemaining[this]=0.0
            endif
            set dummy=null
        endfunction

        function s__FrostnovaSpells__FrostnovaF_KS_Loop takes nothing returns nothing
            local integer index= 0
            local integer this
            local real pulseDamage
            loop
                exitwhen index >= s__FrostnovaSpells__FrostnovaF_KS_count
                set this=s__FrostnovaSpells__FrostnovaF_KS_active[index]
                set s__FrostnovaSpells__FrostnovaF_KS_applyRemaining[this]=RMaxBJ(0.0, s__FrostnovaSpells__FrostnovaF_KS_applyRemaining[this] - 0.03)
                if s__FrostnovaSpells__FrostnovaF_KS_applyRemaining[this] > 0.0 and GetUnitAbilityLevel(s__FrostnovaSpells__FrostnovaF_KS_target[this], s__FrostnovaSpells__FrostnovaF_KS_buffId[this]) > 0 then
                    call s__FrostnovaSpells__FrostnovaF_KS_ClearOldBuffs(s__FrostnovaSpells__FrostnovaF_KS_target[this] , s__FrostnovaSpells__FrostnovaF_KS_buffId[this])
                    set s__FrostnovaSpells__FrostnovaF_KS_applyRemaining[this]=0.0
                endif
                set s__FrostnovaSpells__FrostnovaF_KS_remainingTime[this]=s__FrostnovaSpells__FrostnovaF_KS_remainingTime[this] - 0.03
                set s__FrostnovaSpells__FrostnovaF_KS_damageCountdown[this]=s__FrostnovaSpells__FrostnovaF_KS_damageCountdown[this] - 0.03
                // The last second ends inside this 0.03 step when the duration is not a
                // multiple of it (4 / 5 sec): still pay that final tick.
                if s__FrostnovaSpells__FrostnovaF_KS_damageCountdown[this] <= 0.0001 and s__FrostnovaSpells__FrostnovaF_KS_remainingTime[this] > - 0.0299 and GetUnitTypeId(s__FrostnovaSpells__FrostnovaF_KS_hero[this]) != 0 and SpellBoolCaster(s__FrostnovaSpells__FrostnovaF_KS_target[this]) and GetUnitAbilityLevel(s__FrostnovaSpells__FrostnovaF_KS_target[this], s__FrostnovaSpells__FrostnovaF_KS_buffId[this]) > 0 then
                    set s__FrostnovaSpells__FrostnovaF_KS_damageCountdown[this]=s__FrostnovaSpells__FrostnovaF_KS_damageCountdown[this] + 1.0
                    if ( s__FrostnovaSpells__FrostnovaF_KS_empowered[this] or GetHeroLevel(s__FrostnovaSpells__FrostnovaF_KS_hero[this]) >= 35 ) and SpellBool(s__FrostnovaSpells__FrostnovaF_KS_target[this]) then
                        set pulseDamage=s__FrostnovaSpells__FrostnovaF_KS_damage[this] * s__FrostnovaSpells__FrostnovaF_KS_stacks[this]
                        if s__FrostnovaSpells__FrostnovaF_KS_empowered[this] and GetHeroLevel(s__FrostnovaSpells__FrostnovaF_KS_hero[this]) >= 35 then
                            set pulseDamage=pulseDamage + GetHeroInt(s__FrostnovaSpells__FrostnovaF_KS_hero[this], true) * FrostnovaTF_DamageBonus35
                        endif
                        set GearDamageNextSource=(FrostnovaF_ID) // INLINED!!
                        call dmgmag(s__FrostnovaSpells__FrostnovaF_KS_hero[this] , s__FrostnovaSpells__FrostnovaF_KS_target[this] , pulseDamage)
                    endif
                endif
                if GetUnitTypeId(s__FrostnovaSpells__FrostnovaF_KS_target[this]) == 0 or not SpellBoolCaster(s__FrostnovaSpells__FrostnovaF_KS_target[this]) or GetUnitTypeId(s__FrostnovaSpells__FrostnovaF_KS_hero[this]) == 0 or s__FrostnovaSpells__FrostnovaF_KS_remainingTime[this] <= 0.0001 or ( GetUnitAbilityLevel(s__FrostnovaSpells__FrostnovaF_KS_target[this], s__FrostnovaSpells__FrostnovaF_KS_buffId[this]) == 0 and s__FrostnovaSpells__FrostnovaF_KS_applyRemaining[this] <= 0.0001 ) then
                    call UnitRemoveAbility(s__FrostnovaSpells__FrostnovaF_KS_target[this], s__FrostnovaSpells__FrostnovaF_KS_buffId[this])
                    call RemoveSavedInteger(FrostnovaSpells__FrostnovaTable, GetHandleId(s__FrostnovaSpells__FrostnovaF_KS_target[this]), 1)
                    set s__FrostnovaSpells__FrostnovaF_KS_hero[this]=null
                    set s__FrostnovaSpells__FrostnovaF_KS_target[this]=null
                    set s__FrostnovaSpells__FrostnovaF_KS_count=s__FrostnovaSpells__FrostnovaF_KS_count - 1
                    set s__FrostnovaSpells__FrostnovaF_KS_active[index]=s__FrostnovaSpells__FrostnovaF_KS_active[s__FrostnovaSpells__FrostnovaF_KS_count]
                    call s__FrostnovaSpells__FrostnovaF_KS_deallocate(this)
                    call GearTimer03Release()
                else
                    set index=index + 1
                endif
            endloop
        endfunction
    // ==================== Q: Ice Javelins ====================

        function s__FrostnovaSpells__FrostnovaQ_KS_Loop takes nothing returns nothing
            local integer index= 0
            local integer this
            local unit target
            local effect impact
            local unit firstTarget
            local real best
            local real d
            local real step
            loop
                exitwhen index >= s__FrostnovaSpells__FrostnovaQ_KS_count
                set this=s__FrostnovaSpells__FrostnovaQ_KS_active[index]
                // A dead or removed caster ends her javelins in place: no flight, hit or damage.
                if GetUnitTypeId(s__FrostnovaSpells__FrostnovaQ_KS_hero[this]) == 0 or not FrostnovaSpells__FrostnovaAlive(s__FrostnovaSpells__FrostnovaQ_KS_hero[this]) then
                    set s__FrostnovaSpells__FrostnovaQ_KS_remainingDistance[this]=0.0
                else
                    set step=RMinBJ(s__FrostnovaSpells__FrostnovaQ_KS_distancePerTick[this], s__FrostnovaSpells__FrostnovaQ_KS_remainingDistance[this])
                    if not (CheckCoordsInRect(gg_rct_Arena , ((s__FrostnovaSpells__FrostnovaQ_KS_positionX[this] + step * Cos(s__FrostnovaSpells__FrostnovaQ_KS_angle[this]) )*1.0) , (( s__FrostnovaSpells__FrostnovaQ_KS_positionY[this] + step * Sin(s__FrostnovaSpells__FrostnovaQ_KS_angle[this]))*1.0))) then // INLINED!!
                        set step=0.0
                        set s__FrostnovaSpells__FrostnovaQ_KS_remainingDistance[this]=0.0
                    endif
                    call MoveEff2(s__FrostnovaSpells__FrostnovaQ_KS_mainEffect[this] , step , s__FrostnovaSpells__FrostnovaQ_KS_angle[this])
                    call MoveEff2(s__FrostnovaSpells__FrostnovaQ_KS_trail[this] , step , s__FrostnovaSpells__FrostnovaQ_KS_angle[this])
                    if s__FrostnovaSpells__FrostnovaQ_KS_shadow[this] != null then
                        call MoveEff2(s__FrostnovaSpells__FrostnovaQ_KS_shadow[this] , step , s__FrostnovaSpells__FrostnovaQ_KS_angle[this])
                    endif
                    set s__FrostnovaSpells__FrostnovaQ_KS_positionX[this]=(BlzGetLocalSpecialEffectX((s__FrostnovaSpells__FrostnovaQ_KS_mainEffect[this]))) // INLINED!!
                    set s__FrostnovaSpells__FrostnovaQ_KS_positionY[this]=(BlzGetLocalSpecialEffectY((s__FrostnovaSpells__FrostnovaQ_KS_mainEffect[this]))) // INLINED!!
                    set s__FrostnovaSpells__FrostnovaQ_KS_remainingDistance[this]=s__FrostnovaSpells__FrostnovaQ_KS_remainingDistance[this] - step
                    set s__FrostnovaSpells__FrostnovaQ_KS_flightTime[this]=s__FrostnovaSpells__FrostnovaQ_KS_flightTime[this] + 0.03
                    set s__FrostnovaSpells__FrostnovaQ_KS_height[this]=s__FrostnovaSpells__FrostnovaQ_KS_startHeight[this] + ( FrostnovaQ_FlightHeight - s__FrostnovaSpells__FrostnovaQ_KS_startHeight[this] ) * RMinBJ(1.0, s__FrostnovaSpells__FrostnovaQ_KS_flightTime[this] / FrostnovaQ_DescendTime)
                    call BlzSetSpecialEffectZ(s__FrostnovaSpells__FrostnovaQ_KS_mainEffect[this], s__FrostnovaSpells__FrostnovaQ_KS_originZ[this] + s__FrostnovaSpells__FrostnovaQ_KS_height[this])
                    if s__FrostnovaSpells__FrostnovaQ_KS_shadow[this] != null then
                        call BlzSetSpecialEffectZ(s__FrostnovaSpells__FrostnovaQ_KS_shadow[this], s__FrostnovaSpells__FrostnovaQ_KS_originZ[this] + s__FrostnovaSpells__FrostnovaQ_KS_height[this] - 10.0)
                    endif
                    call BlzSetSpecialEffectZ(s__FrostnovaSpells__FrostnovaQ_KS_trail[this], s__FrostnovaSpells__FrostnovaQ_KS_originZ[this] + s__FrostnovaSpells__FrostnovaQ_KS_height[this] + FrostnovaQ_TrailHeightOffset)
                    set firstTarget=null
                    set best=99999999.0
                    call GroupEnumUnitsInRange(s__FrostnovaSpells__FrostnovaQ_KS_targets[this], s__FrostnovaSpells__FrostnovaQ_KS_positionX[this], s__FrostnovaSpells__FrostnovaQ_KS_positionY[this], s__FrostnovaSpells__FrostnovaQ_KS_radius[this], null)
                    loop
                        set target=FirstOfGroup(s__FrostnovaSpells__FrostnovaQ_KS_targets[this])
                        exitwhen target == null
                        call GroupRemoveUnit(s__FrostnovaSpells__FrostnovaQ_KS_targets[this], target)
                        if IsUnitEnemy(target, GetOwningPlayer(s__FrostnovaSpells__FrostnovaQ_KS_hero[this])) and SpellBool(target) and not IsUnitType(target, UNIT_TYPE_STRUCTURE) and not IsUnitInGroup(target, s__FrostnovaSpells__FrostnovaQ_KS_hit[this]) then
                            if s__FrostnovaSpells__FrostnovaQ_KS_enhanced[this] then
                                call GroupAddUnit(s__FrostnovaSpells__FrostnovaQ_KS_hit[this], target)
                                call FrostnovaSpells__FrostnovaQ7Sound()
                                call s__FrostnovaSpells__FrostnovaF_KS_Apply(s__FrostnovaSpells__FrostnovaQ_KS_hero[this] , target , true)
                                call StunUnit(s__FrostnovaSpells__FrostnovaQ_KS_hero[this] , target , FrostnovaQ_Stun)
                                set GearDamageNextSource=(FrostnovaQ_ID) // INLINED!!
                                call dmgmag(s__FrostnovaSpells__FrostnovaQ_KS_hero[this] , target , s__FrostnovaSpells__FrostnovaQ_KS_damage[this])
                                // Keep the requested half-size hit in world space;
                                // never scale an effect attached to a unit.
                                set impact=AddSpecialEffect(FrostnovaTQ_ImpactModel, GetUnitX(target), GetUnitY(target))
                                call BlzSetSpecialEffectZ(impact, BlzGetUnitZ(target) + 80.0)
                                call BlzSetSpecialEffectScale(impact, FrostnovaTQ_ImpactScale)
                                call DestroyEffect(impact)
                            else
                            set d=( GetUnitX(target) - s__FrostnovaSpells__FrostnovaQ_KS_positionX[this] ) * Cos(s__FrostnovaSpells__FrostnovaQ_KS_angle[this]) + ( GetUnitY(target) - s__FrostnovaSpells__FrostnovaQ_KS_positionY[this] ) * Sin(s__FrostnovaSpells__FrostnovaQ_KS_angle[this])
                            if d < best then
                                set best=d
                                set firstTarget=target
                            endif
                            endif
                        endif
                    endloop
                    set s__FrostnovaSpells__FrostnovaQ_KS_environmentCountdown[this]=s__FrostnovaSpells__FrostnovaQ_KS_environmentCountdown[this] - 0.03
                    if s__FrostnovaSpells__FrostnovaQ_KS_environmentCountdown[this] <= 0.0001 or firstTarget != null or s__FrostnovaSpells__FrostnovaQ_KS_remainingDistance[this] <= 0.0 then
                        set s__FrostnovaSpells__FrostnovaQ_KS_environmentCountdown[this]=0.12
                        call VisionTimed(GetOwningPlayer(s__FrostnovaSpells__FrostnovaQ_KS_hero[this]) , s__FrostnovaSpells__FrostnovaQ_KS_positionX[this] , s__FrostnovaSpells__FrostnovaQ_KS_positionY[this] , s__FrostnovaSpells__FrostnovaQ_KS_radius[this] * 2.0 , 1.0)
                        call DecorRemove(s__FrostnovaSpells__FrostnovaQ_KS_hero[this] , s__FrostnovaSpells__FrostnovaQ_KS_positionX[this] , s__FrostnovaSpells__FrostnovaQ_KS_positionY[this] , s__FrostnovaSpells__FrostnovaQ_KS_radius[this] , FrostnovaQ_DecorDamage)
                    endif
                    if firstTarget != null then
                        call FrostnovaSpells__FrostnovaQ7Sound()
                        call s__FrostnovaSpells__FrostnovaF_KS_Apply(s__FrostnovaSpells__FrostnovaQ_KS_hero[this] , firstTarget , s__FrostnovaSpells__FrostnovaQ_KS_enhanced[this])
                        call StunUnit(s__FrostnovaSpells__FrostnovaQ_KS_hero[this] , firstTarget , FrostnovaQ_Stun)
                        set GearDamageNextSource=(FrostnovaQ_ID) // INLINED!!
                        call dmgmag(s__FrostnovaSpells__FrostnovaQ_KS_hero[this] , firstTarget , s__FrostnovaSpells__FrostnovaQ_KS_damage[this])
                        // Play the full hit animation in world space; do not inherit the hero's attachment scale.
                        set impact=AddSpecialEffect(FrostnovaQ_ImpactModel, GetUnitX(firstTarget), GetUnitY(firstTarget))
                        call BlzSetSpecialEffectZ(impact, BlzGetUnitZ(firstTarget) + 80.0)
                        call s__GearSystems2___KS_RemoveEffect_MyRemoveEff_Start((impact ) , (( 1.0)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
                        set s__FrostnovaSpells__FrostnovaQ_KS_remainingDistance[this]=0.0
                    endif
                endif
                if s__FrostnovaSpells__FrostnovaQ_KS_remainingDistance[this] <= 0.0 or GetUnitTypeId(s__FrostnovaSpells__FrostnovaQ_KS_hero[this]) == 0 then
                    call DestroyEffect(s__FrostnovaSpells__FrostnovaQ_KS_mainEffect[this])
                    if s__FrostnovaSpells__FrostnovaQ_KS_shadow[this] != null then
                        call DestroyEffect(s__FrostnovaSpells__FrostnovaQ_KS_shadow[this])
                        set s__FrostnovaSpells__FrostnovaQ_KS_shadow[this]=null
                    endif
                    call DestroyEffect(s__FrostnovaSpells__FrostnovaQ_KS_trail[this])
                    call DestroyGroup(s__FrostnovaSpells__FrostnovaQ_KS_hit[this])
                    set s__FrostnovaSpells__FrostnovaQ_KS_hit[this]=null
                    call DestroyGroup(s__FrostnovaSpells__FrostnovaQ_KS_targets[this])
                    set s__FrostnovaSpells__FrostnovaQ_KS_mainEffect[this]=null
                    set s__FrostnovaSpells__FrostnovaQ_KS_trail[this]=null
                    set s__FrostnovaSpells__FrostnovaQ_KS_targets[this]=null
                    set s__FrostnovaSpells__FrostnovaQ_KS_hero[this]=null
                    set s__FrostnovaSpells__FrostnovaQ_KS_count=s__FrostnovaSpells__FrostnovaQ_KS_count - 1
                    set s__FrostnovaSpells__FrostnovaQ_KS_active[index]=s__FrostnovaSpells__FrostnovaQ_KS_active[s__FrostnovaSpells__FrostnovaQ_KS_count]
                    call s__FrostnovaSpells__FrostnovaQ_KS_deallocate(this)
                    call GearTimer03Release()
                else
                    set index=index + 1
                endif
            endloop
            set target=null
            set firstTarget=null
            set impact=null
        endfunction

        function s__FrostnovaSpells__FrostnovaQ_KS_Start takes unit caster,real targetX,real targetY returns boolean
            local integer state= LoadInteger(FrostnovaSpells__FrostnovaTable, GetHandleId(caster), 0)
            local integer this
            local integer slot
            local integer row
            local real side= 1.0
            local real orientationAngle
            local real orbitAngle
            local effect shard
            if state == 0 then
                return false
            endif
            call s__FrostnovaSpells__FrostnovaState_UpdateShards(state)
            if s__FrostnovaSpells__FrostnovaState_qCastDelay[state] > 0.0001 then
                call s__GearSystems2___KS_AddMana_Start((caster ) , (( I2R(BlzGetAbilityIntegerLevelField(BlzGetUnitAbility(caster, FrostnovaQ_ID), ABILITY_ILF_MANA_COST, GetUnitAbilityLevel(caster, FrostnovaQ_ID) - 1)) )*1.0) , (( 0.03)*1.0)) // INLINED!!
                return false
            endif
            set slot=(LoadInteger(hs, GetHandleId(((caster))), GearSystems2___SH_STACK_COUNT)) - 1 // INLINED!!
            if not SpellStacksTryUse(caster) then
                call s__GearSystems2___KS_AddMana_Start((caster ) , (( I2R(BlzGetAbilityIntegerLevelField(BlzGetUnitAbility(caster, FrostnovaQ_ID), ABILITY_ILF_MANA_COST, GetUnitAbilityLevel(caster, FrostnovaQ_ID) - 1)) )*1.0) , (( 0.03)*1.0)) // INLINED!!
                return false
            endif
            set s__FrostnovaSpells__FrostnovaState_qCastDelay[state]=FrostnovaQ_UseCooldown + 0.03
            set s__FrostnovaSpells__FrostnovaState_previousQCharges[state]=(LoadInteger(hs, GetHandleId(((caster))), GearSystems2___SH_STACK_COUNT)) // INLINED!!
            // Seed the empty-pool cooldown before the shared 0.05 tick can
            // mistake the engine's pending cooldown write for a free charge.
            // The shared deferred callback restores the exact recharge remainder.
            if s__FrostnovaSpells__FrostnovaState_previousQCharges[state] == 0 then
                call BlzStartUnitAbilityCooldown(caster, FrostnovaQ_ID, FrostnovaQ_Recharge + FrostnovaQ_RechargeStep * ( GetUnitAbilityLevel(caster, FrostnovaQ_ID) - 1 ))
            endif
            set shard=LoadEffectHandle(FrostnovaSpells__FrostnovaTable, GetHandleId(caster), 100 + slot)
            call RemoveSavedHandle(FrostnovaSpells__FrostnovaTable, GetHandleId(caster), 100 + slot)
            set this=s__FrostnovaSpells__FrostnovaQ_KS__allocate()
            set s__FrostnovaSpells__FrostnovaQ_KS_hero[this]=caster
            set row=R2I(I2R(slot) / 2.0)
            if ModuloInteger(slot, 2) == 0 then
                set side=- 1.0
            endif
            set orientationAngle=GetUnitFacing(s__FrostnovaSpells__FrostnovaQ_KS_hero[this]) * bj_DEGTORAD
            set orbitAngle=orientationAngle + s__FrostnovaSpells__FrostnovaState_orbitTime[state] * FrostnovaQ_OrbitSpeed + row * bj_PI / 3.0 + side * bj_PI / 2.0
            set s__FrostnovaSpells__FrostnovaQ_KS_positionX[this]=GetUnitX(s__FrostnovaSpells__FrostnovaQ_KS_hero[this]) + ( FrostnovaQ_OrbitSide + row * FrostnovaQ_OrbitRowSide ) * Cos(orbitAngle)
            set s__FrostnovaSpells__FrostnovaQ_KS_positionY[this]=GetUnitY(s__FrostnovaSpells__FrostnovaQ_KS_hero[this]) + ( FrostnovaQ_OrbitSide + row * FrostnovaQ_OrbitRowSide ) * Sin(orbitAngle)
            set s__FrostnovaSpells__FrostnovaQ_KS_height[this]=FrostnovaQ_OrbitHeight + slot * FrostnovaQ_OrbitLayerHeight + Sin(s__FrostnovaSpells__FrostnovaState_orbitTime[state] * 1.7 + slot) * FrostnovaQ_OrbitSway
            set s__FrostnovaSpells__FrostnovaQ_KS_startHeight[this]=s__FrostnovaSpells__FrostnovaQ_KS_height[this]
            set s__FrostnovaSpells__FrostnovaQ_KS_flightTime[this]=0.0
            set s__FrostnovaSpells__FrostnovaQ_KS_originZ[this]=BlzGetUnitZ(s__FrostnovaSpells__FrostnovaQ_KS_hero[this])
            set s__FrostnovaSpells__FrostnovaQ_KS_angle[this]=Atan2(targetY - s__FrostnovaSpells__FrostnovaQ_KS_positionY[this], targetX - s__FrostnovaSpells__FrostnovaQ_KS_positionX[this])
            set s__FrostnovaSpells__FrostnovaQ_KS_damage[this]=FrostnovaQ_DamageStatic + GetHeroInt(s__FrostnovaSpells__FrostnovaQ_KS_hero[this], true) * ( FrostnovaQ_DamageIntBase + FrostnovaQ_DamageIntStep * ( GetUnitAbilityLevel(s__FrostnovaSpells__FrostnovaQ_KS_hero[this], FrostnovaQ_ID) - 1 ) )
            set s__FrostnovaSpells__FrostnovaQ_KS_enhanced[this]=s__FrostnovaSpells__FrostnovaState_winterRemaining[state] > 0.0
            if s__FrostnovaSpells__FrostnovaQ_KS_enhanced[this] then
                call s__FrostnovaSpells__FrostnovaState_Voice(state,true)
            else
                set s__FrostnovaSpells__FrostnovaState_nextNormalVoice[state]=ModuloInteger(s__FrostnovaSpells__FrostnovaState_nextNormalVoice[state], 5) + 1
                call MakeSound(FrostnovaSpells__FrostnovaSoundPath + "Q" + I2S(s__FrostnovaSpells__FrostnovaState_nextNormalVoice[state]))
            endif

            call MakeSoundVolume(FrostnovaSpells__FrostnovaSoundPath + "Q6" , 114)
            set s__FrostnovaSpells__FrostnovaQ_KS_remainingDistance[this]=FrostnovaQRange(s__FrostnovaSpells__FrostnovaQ_KS_hero[this] , GetUnitAbilityLevel(s__FrostnovaSpells__FrostnovaQ_KS_hero[this], FrostnovaQ_ID))
            set s__FrostnovaSpells__FrostnovaQ_KS_distancePerTick[this]=FrostnovaQ_Speed * 0.03
            if s__FrostnovaSpells__FrostnovaQ_KS_enhanced[this] then
                set s__FrostnovaSpells__FrostnovaQ_KS_distancePerTick[this]=s__FrostnovaSpells__FrostnovaQ_KS_distancePerTick[this] * FrostnovaTQ_SpeedMultiplier
            endif
            set s__FrostnovaSpells__FrostnovaQ_KS_radius[this]=FrostnovaQ_Aoe
            set s__FrostnovaSpells__FrostnovaQ_KS_environmentCountdown[this]=0.0
            set s__FrostnovaSpells__FrostnovaQ_KS_targets[this]=CreateGroup()
            set s__FrostnovaSpells__FrostnovaQ_KS_hit[this]=CreateGroup()
            set s__FrostnovaSpells__FrostnovaQ_KS_shadow[this]=LoadEffectHandle(FrostnovaSpells__FrostnovaTable, GetHandleId(caster), 200 + slot)
            call RemoveSavedHandle(FrostnovaSpells__FrostnovaTable, GetHandleId(caster), 200 + slot)
            if s__FrostnovaSpells__FrostnovaQ_KS_enhanced[this] and shard != null then
                call DestroyEffect(shard)
                set shard=null
            endif
            set s__FrostnovaSpells__FrostnovaQ_KS_mainEffect[this]=shard
            set shard=null
            if s__FrostnovaSpells__FrostnovaQ_KS_mainEffect[this] == null then
                if s__FrostnovaSpells__FrostnovaQ_KS_enhanced[this] then
                    set s__FrostnovaSpells__FrostnovaQ_KS_mainEffect[this]=AddSpecialEffect(FrostnovaTQ_Model, s__FrostnovaSpells__FrostnovaQ_KS_positionX[this], s__FrostnovaSpells__FrostnovaQ_KS_positionY[this])
                else
                    set s__FrostnovaSpells__FrostnovaQ_KS_mainEffect[this]=AddSpecialEffect(FrostnovaQ_Model, s__FrostnovaSpells__FrostnovaQ_KS_positionX[this], s__FrostnovaSpells__FrostnovaQ_KS_positionY[this])
                endif
                call BlzPlaySpecialEffect(s__FrostnovaSpells__FrostnovaQ_KS_mainEffect[this], ANIM_TYPE_STAND)
            endif
            call s__GearSystems2___KS_RemoveUnit_MyRemoveUnit_Start((s__FrostnovaSpells__FrostnovaQ_KS_hero[this] ) , (( 0.01 )*1.0) , 2 , - 1 , ( 1) , "") // INLINED!!
            if s__FrostnovaSpells__FrostnovaQ_KS_enhanced[this] and s__FrostnovaSpells__FrostnovaQ_KS_shadow[this] == null then
                set s__FrostnovaSpells__FrostnovaQ_KS_shadow[this]=AddSpecialEffect(FrostnovaTQ_ShadowModel, s__FrostnovaSpells__FrostnovaQ_KS_positionX[this], s__FrostnovaSpells__FrostnovaQ_KS_positionY[this])
                call BlzPlaySpecialEffect(s__FrostnovaSpells__FrostnovaQ_KS_shadow[this], ANIM_TYPE_STAND)
            endif
            if s__FrostnovaSpells__FrostnovaQ_KS_shadow[this] != null then
                call ScaleEffDummy(s__FrostnovaSpells__FrostnovaQ_KS_shadow[this] , FrostnovaQ_GrowTime , FrostnovaQ_ModelScale * FrostnovaTQ_ParticleScale / FrostnovaQ_OrbitScaleDivisor , FrostnovaQ_ModelScale * FrostnovaTQ_ParticleScale)
                call BlzSetSpecialEffectAlpha(s__FrostnovaSpells__FrostnovaQ_KS_shadow[this], FrostnovaTQ_ParticleAlpha)
                call BlzSetSpecialEffectPosition(s__FrostnovaSpells__FrostnovaQ_KS_shadow[this], s__FrostnovaSpells__FrostnovaQ_KS_positionX[this] - 55.0 * Cos(s__FrostnovaSpells__FrostnovaQ_KS_angle[this]), s__FrostnovaSpells__FrostnovaQ_KS_positionY[this] - 55.0 * Sin(s__FrostnovaSpells__FrostnovaQ_KS_angle[this]), s__FrostnovaSpells__FrostnovaQ_KS_originZ[this] + s__FrostnovaSpells__FrostnovaQ_KS_height[this] - 10.0)
                call BlzSetSpecialEffectYaw(s__FrostnovaSpells__FrostnovaQ_KS_shadow[this], s__FrostnovaSpells__FrostnovaQ_KS_angle[this])
            endif
            call ScaleEffDummy(s__FrostnovaSpells__FrostnovaQ_KS_mainEffect[this] , FrostnovaQ_GrowTime , FrostnovaQ_ModelScale / FrostnovaQ_OrbitScaleDivisor , FrostnovaQ_ModelScale)
            call BlzSetSpecialEffectAlpha(s__FrostnovaSpells__FrostnovaQ_KS_mainEffect[this], 255)
            set s__FrostnovaSpells__FrostnovaQ_KS_trail[this]=AddSpecialEffect(FrostnovaQ_TrailModel, s__FrostnovaSpells__FrostnovaQ_KS_positionX[this], s__FrostnovaSpells__FrostnovaQ_KS_positionY[this])
            call BlzSetSpecialEffectScale(s__FrostnovaSpells__FrostnovaQ_KS_trail[this], FrostnovaQ_TrailScale)
            call BlzSetSpecialEffectPosition(s__FrostnovaSpells__FrostnovaQ_KS_trail[this], s__FrostnovaSpells__FrostnovaQ_KS_positionX[this], s__FrostnovaSpells__FrostnovaQ_KS_positionY[this], s__FrostnovaSpells__FrostnovaQ_KS_originZ[this] + s__FrostnovaSpells__FrostnovaQ_KS_height[this] + FrostnovaQ_TrailHeightOffset)
            call BlzSetSpecialEffectYaw(s__FrostnovaSpells__FrostnovaQ_KS_trail[this], s__FrostnovaSpells__FrostnovaQ_KS_angle[this])
            call s__FrostnovaSpells__FrostnovaState_UpdateShards(state)
            call BlzSetSpecialEffectZ(s__FrostnovaSpells__FrostnovaQ_KS_mainEffect[this], s__FrostnovaSpells__FrostnovaQ_KS_originZ[this] + s__FrostnovaSpells__FrostnovaQ_KS_height[this])
            call BlzSetSpecialEffectYaw(s__FrostnovaSpells__FrostnovaQ_KS_mainEffect[this], s__FrostnovaSpells__FrostnovaQ_KS_angle[this])
            set s__FrostnovaSpells__FrostnovaQ_KS_active[s__FrostnovaSpells__FrostnovaQ_KS_count]=this
            set s__FrostnovaSpells__FrostnovaQ_KS_count=s__FrostnovaSpells__FrostnovaQ_KS_count + 1
            call GearTimer03Acquire()
            return true
        endfunction
    // ==================== W: Northern Winds ====================

        function s__FrostnovaSpells__FrostnovaW_KS_Loop takes nothing returns nothing
            local integer index= 0
            local integer this
            local boolean blocked
            local unit target
            local real visualRadius
            local real progress
            local real step
            loop
                exitwhen index >= s__FrostnovaSpells__FrostnovaW_KS_count
                set this=s__FrostnovaSpells__FrostnovaW_KS_active[index]
                set blocked=false
                if s__FrostnovaSpells__FrostnovaW_KS_preparationRemaining[this] > 0.0 then
                    set s__FrostnovaSpells__FrostnovaW_KS_preparationRemaining[this]=RMaxBJ(0.0, s__FrostnovaSpells__FrostnovaW_KS_preparationRemaining[this] - 0.03)
                    if not FrostnovaSpells__FrostnovaAlive(s__FrostnovaSpells__FrostnovaW_KS_hero[this]) or GetUnitTypeId(s__FrostnovaSpells__FrostnovaW_KS_hero[this]) == 0 then
                        set s__FrostnovaSpells__FrostnovaW_KS_preparationRemaining[this]=0.0
                        set s__FrostnovaSpells__FrostnovaW_KS_remainingDistance[this]=0.0
                    elseif s__FrostnovaSpells__FrostnovaW_KS_preparationRemaining[this] <= 0.0001 then
                        set s__FrostnovaSpells__FrostnovaW_KS_preparationRemaining[this]=0.0
                        set s__FrostnovaSpells__FrostnovaW_KS_positionX[this]=GetUnitX(s__FrostnovaSpells__FrostnovaW_KS_hero[this])
                        set s__FrostnovaSpells__FrostnovaW_KS_positionY[this]=GetUnitY(s__FrostnovaSpells__FrostnovaW_KS_hero[this])
                        set s__FrostnovaSpells__FrostnovaW_KS_mainEffect[this]=AddSpecialEffect(FrostnovaW_Model, s__FrostnovaSpells__FrostnovaW_KS_positionX[this], s__FrostnovaSpells__FrostnovaW_KS_positionY[this])
                        set s__FrostnovaSpells__FrostnovaW_KS_trail[this]=AddSpecialEffect(FrostnovaW_AirModel, s__FrostnovaSpells__FrostnovaW_KS_positionX[this], s__FrostnovaSpells__FrostnovaW_KS_positionY[this])
                        call BlzSetSpecialEffectYaw(s__FrostnovaSpells__FrostnovaW_KS_mainEffect[this], s__FrostnovaSpells__FrostnovaW_KS_angle[this])
                        call BlzSetSpecialEffectYaw(s__FrostnovaSpells__FrostnovaW_KS_trail[this], s__FrostnovaSpells__FrostnovaW_KS_angle[this])
                        if s__FrostnovaSpells__FrostnovaW_KS_voiced[this] then
                            call MakeSound(FrostnovaSpells__FrostnovaSoundPath + "W3")
                        endif
                    endif
                    if s__FrostnovaSpells__FrostnovaW_KS_preparationRemaining[this] <= 0.0001 and s__FrostnovaSpells__FrostnovaW_KS_paused[this] then
                        if s__FrostnovaSpells__FrostnovaW_KS_ownsInvulnerability[this] then
                            call StopSpellUnit(s__FrostnovaSpells__FrostnovaW_KS_hero[this])
                            set s__FrostnovaSpells__FrostnovaW_KS_ownsInvulnerability[this]=false
                        else
                            call StopSpellUnit2(s__FrostnovaSpells__FrostnovaW_KS_hero[this])
                        endif
                        set s__FrostnovaSpells__FrostnovaW_KS_paused[this]=false
                        call DestroyEffect(s__FrostnovaSpells__FrostnovaW_KS_hand[this])
                        set s__FrostnovaSpells__FrostnovaW_KS_hand[this]=null
                    endif
                endif
                if s__FrostnovaSpells__FrostnovaW_KS_preparationRemaining[this] <= 0.0001 and s__FrostnovaSpells__FrostnovaW_KS_remainingDistance[this] > 0.0 then
                    set step=RMinBJ(s__FrostnovaSpells__FrostnovaW_KS_distancePerTick[this], s__FrostnovaSpells__FrostnovaW_KS_remainingDistance[this])
                    if not (CheckCoordsInRect(gg_rct_Arena , ((s__FrostnovaSpells__FrostnovaW_KS_positionX[this] + step * Cos(s__FrostnovaSpells__FrostnovaW_KS_angle[this]) )*1.0) , (( s__FrostnovaSpells__FrostnovaW_KS_positionY[this] + step * Sin(s__FrostnovaSpells__FrostnovaW_KS_angle[this]))*1.0))) then // INLINED!!
                        set step=0.0
                        set blocked=true
                    endif
                    call MoveEff2(s__FrostnovaSpells__FrostnovaW_KS_mainEffect[this] , step , s__FrostnovaSpells__FrostnovaW_KS_angle[this])
                    call MoveEff2(s__FrostnovaSpells__FrostnovaW_KS_trail[this] , step , s__FrostnovaSpells__FrostnovaW_KS_angle[this])
                    set s__FrostnovaSpells__FrostnovaW_KS_positionX[this]=(BlzGetLocalSpecialEffectX((s__FrostnovaSpells__FrostnovaW_KS_mainEffect[this]))) // INLINED!!
                    set s__FrostnovaSpells__FrostnovaW_KS_positionY[this]=(BlzGetLocalSpecialEffectY((s__FrostnovaSpells__FrostnovaW_KS_mainEffect[this]))) // INLINED!!
                    set s__FrostnovaSpells__FrostnovaW_KS_remainingDistance[this]=s__FrostnovaSpells__FrostnovaW_KS_remainingDistance[this] - step
                    call BlzSetSpecialEffectZ(s__FrostnovaSpells__FrostnovaW_KS_mainEffect[this], BlzGetUnitZ(s__FrostnovaSpells__FrostnovaW_KS_hero[this]) + 80.0)
                    call BlzSetSpecialEffectZ(s__FrostnovaSpells__FrostnovaW_KS_trail[this], BlzGetUnitZ(s__FrostnovaSpells__FrostnovaW_KS_hero[this]) + 80.0)
                    set progress=1.0 - s__FrostnovaSpells__FrostnovaW_KS_remainingDistance[this] / s__FrostnovaSpells__FrostnovaW_KS_maxDistance[this]

                    set s__FrostnovaSpells__FrostnovaW_KS_radius[this]=FrostnovaW_StartAoe + ( FrostnovaW_Aoe - FrostnovaW_StartAoe ) * progress
                    set visualRadius=s__FrostnovaSpells__FrostnovaW_KS_radius[this]

                    if s__FrostnovaSpells__FrostnovaW_KS_enhanced[this] then
                        set s__FrostnovaSpells__FrostnovaW_KS_radius[this]=RMaxBJ(s__FrostnovaSpells__FrostnovaW_KS_radius[this], FrostnovaW_StartAoe + ( s__FrostnovaSpells__FrostnovaW_KS_maxDistance[this] - s__FrostnovaSpells__FrostnovaW_KS_remainingDistance[this] ) * Sin(FrostnovaTW_Angle * bj_DEGTORAD / 2.0))

                        set visualRadius=visualRadius + ( s__FrostnovaSpells__FrostnovaW_KS_radius[this] - visualRadius ) * progress * progress
                    endif
                    if s__FrostnovaSpells__FrostnovaW_KS_enhanced[this] then
                    set visualRadius=visualRadius * ( 1.0 - 0.5 * ( 1.0 - s__FrostnovaSpells__FrostnovaW_KS_remainingDistance[this] / s__FrostnovaSpells__FrostnovaW_KS_maxDistance[this] ) )
                    endif
                    call BlzSetSpecialEffectScale(s__FrostnovaSpells__FrostnovaW_KS_mainEffect[this], FrostnovaW_ModelScale * visualRadius / FrostnovaW_Aoe)
                    call BlzSetSpecialEffectScale(s__FrostnovaSpells__FrostnovaW_KS_trail[this], FrostnovaW_AirScale * visualRadius / FrostnovaW_Aoe)
                    set s__FrostnovaSpells__FrostnovaW_KS_environmentCountdown[this]=s__FrostnovaSpells__FrostnovaW_KS_environmentCountdown[this] - 0.03
                    if s__FrostnovaSpells__FrostnovaW_KS_environmentCountdown[this] <= 0.0001 or s__FrostnovaSpells__FrostnovaW_KS_remainingDistance[this] <= 0.0 then
                        set s__FrostnovaSpells__FrostnovaW_KS_environmentCountdown[this]=0.12
                        call VisionTimed(GetOwningPlayer(s__FrostnovaSpells__FrostnovaW_KS_hero[this]) , s__FrostnovaSpells__FrostnovaW_KS_positionX[this] , s__FrostnovaSpells__FrostnovaW_KS_positionY[this] , s__FrostnovaSpells__FrostnovaW_KS_radius[this] * 2.0 , 1.0)
                        call DecorRemove(s__FrostnovaSpells__FrostnovaW_KS_hero[this] , s__FrostnovaSpells__FrostnovaW_KS_positionX[this] , s__FrostnovaSpells__FrostnovaW_KS_positionY[this] , s__FrostnovaSpells__FrostnovaW_KS_radius[this] , FrostnovaW_DecorDamage)
                    endif
                    call GroupEnumUnitsInRange(s__FrostnovaSpells__FrostnovaW_KS_targets[this], s__FrostnovaSpells__FrostnovaW_KS_positionX[this], s__FrostnovaSpells__FrostnovaW_KS_positionY[this], s__FrostnovaSpells__FrostnovaW_KS_radius[this], null)
                    loop
                        set target=FirstOfGroup(s__FrostnovaSpells__FrostnovaW_KS_targets[this])
                        exitwhen target == null
                        call GroupRemoveUnit(s__FrostnovaSpells__FrostnovaW_KS_targets[this], target)
                        if IsUnitEnemy(target, GetOwningPlayer(s__FrostnovaSpells__FrostnovaW_KS_hero[this])) and SpellBool(target) and not IsUnitType(target, UNIT_TYPE_STRUCTURE) and not IsUnitInGroup(target, s__FrostnovaSpells__FrostnovaW_KS_hit[this]) then
                            call GroupAddUnit(s__FrostnovaSpells__FrostnovaW_KS_hit[this], target)
                            call s__FrostnovaSpells__FrostnovaF_KS_Apply(s__FrostnovaSpells__FrostnovaW_KS_hero[this] , target , s__FrostnovaSpells__FrostnovaW_KS_enhanced[this])
                            call MUE(target , FrostnovaSpells__FrostnovaIcefieldPush(target , s__FrostnovaSpells__FrostnovaW_KS_push[this] * ( 1.0 - ( 1.0 - FrostnovaW_PushFalloff ) * RMinBJ(1.0, ( s__FrostnovaSpells__FrostnovaW_KS_maxDistance[this] - s__FrostnovaSpells__FrostnovaW_KS_remainingDistance[this] ) / s__FrostnovaSpells__FrostnovaW_KS_maxDistance[this]) ) , s__FrostnovaSpells__FrostnovaW_KS_angle[this]) , 0.3 , s__FrostnovaSpells__FrostnovaW_KS_angle[this])
                            set GearDamageNextSource=(FrostnovaW_ID) // INLINED!!
                            call dmgmag(s__FrostnovaSpells__FrostnovaW_KS_hero[this] , target , s__FrostnovaSpells__FrostnovaW_KS_damage[this])
                        endif
                    endloop
                endif
                if blocked or s__FrostnovaSpells__FrostnovaW_KS_remainingDistance[this] <= 0.0 or GetUnitTypeId(s__FrostnovaSpells__FrostnovaW_KS_hero[this]) == 0 then
                    call DestroyEffect(s__FrostnovaSpells__FrostnovaW_KS_mainEffect[this])
                    call DestroyEffect(s__FrostnovaSpells__FrostnovaW_KS_trail[this])
                    call DestroyGroup(s__FrostnovaSpells__FrostnovaW_KS_targets[this])
                    call SaveInteger(FrostnovaSpells__FrostnovaTable, GetHandleId(s__FrostnovaSpells__FrostnovaW_KS_hit[this]), 0, LoadInteger(FrostnovaSpells__FrostnovaTable, GetHandleId(s__FrostnovaSpells__FrostnovaW_KS_hit[this]), 0) - 1)
                    if LoadInteger(FrostnovaSpells__FrostnovaTable, GetHandleId(s__FrostnovaSpells__FrostnovaW_KS_hit[this]), 0) == 0 then
                        call FlushChildHashtable(FrostnovaSpells__FrostnovaTable, GetHandleId(s__FrostnovaSpells__FrostnovaW_KS_hit[this]))
                        call DestroyGroup(s__FrostnovaSpells__FrostnovaW_KS_hit[this])
                    endif
                    set s__FrostnovaSpells__FrostnovaW_KS_mainEffect[this]=null
                    set s__FrostnovaSpells__FrostnovaW_KS_trail[this]=null
                    set s__FrostnovaSpells__FrostnovaW_KS_targets[this]=null
                    set s__FrostnovaSpells__FrostnovaW_KS_hit[this]=null
                    set s__FrostnovaSpells__FrostnovaW_KS_hero[this]=null
                    set s__FrostnovaSpells__FrostnovaW_KS_count=s__FrostnovaSpells__FrostnovaW_KS_count - 1
                    set s__FrostnovaSpells__FrostnovaW_KS_active[index]=s__FrostnovaSpells__FrostnovaW_KS_active[s__FrostnovaSpells__FrostnovaW_KS_count]
                    call s__FrostnovaSpells__FrostnovaW_KS_deallocate(this)
                    call GearTimer03Release()
                else
                    set index=index + 1
                endif
            endloop
            set target=null
        endfunction

        function s__FrostnovaSpells__FrostnovaW_KS_Start takes unit caster,real targetX,real targetY returns nothing
            local integer state= LoadInteger(FrostnovaSpells__FrostnovaTable, GetHandleId(caster), 0)
            local integer this
            local integer k= 0
            local integer maximum= 0
            local boolean hadInvulnerability= GetUnitAbilityLevel(caster, 'Avul') > 0
            local group sharedHit= CreateGroup()
            if s__FrostnovaSpells__FrostnovaState_winterRemaining[state] > 0.0 then
                call s__FrostnovaSpells__FrostnovaState_Voice(state,true)
            else
                call MakeSound(FrostnovaSpells__FrostnovaSoundPath + "W")
            endif
            call MakeSound(FrostnovaSpells__FrostnovaSoundPath + "W2")
            // TW is no longer invulnerable: both forms only pause for the cast.
            call StartSpellUnit2(caster)
            if s__FrostnovaSpells__FrostnovaState_winterRemaining[state] > 0.0 then
                set k=- 1
                set maximum=1
            endif
            call SaveInteger(FrostnovaSpells__FrostnovaTable, GetHandleId(sharedHit), 0, maximum - k + 1)
            loop
                exitwhen k > maximum
                set this=s__FrostnovaSpells__FrostnovaW_KS__allocate()
                set s__FrostnovaSpells__FrostnovaW_KS_hero[this]=caster
                set s__FrostnovaSpells__FrostnovaW_KS_positionX[this]=GetUnitX(s__FrostnovaSpells__FrostnovaW_KS_hero[this])
                set s__FrostnovaSpells__FrostnovaW_KS_positionY[this]=GetUnitY(s__FrostnovaSpells__FrostnovaW_KS_hero[this])
                set s__FrostnovaSpells__FrostnovaW_KS_angle[this]=Atan2(targetY - s__FrostnovaSpells__FrostnovaW_KS_positionY[this], targetX - s__FrostnovaSpells__FrostnovaW_KS_positionX[this]) + k * FrostnovaTW_Angle * bj_DEGTORAD
                set s__FrostnovaSpells__FrostnovaW_KS_enhanced[this]=s__FrostnovaSpells__FrostnovaState_winterRemaining[state] > 0.0
                set s__FrostnovaSpells__FrostnovaW_KS_damage[this]=FrostnovaW_DamageStatic + GetHeroInt(s__FrostnovaSpells__FrostnovaW_KS_hero[this], true) * ( FrostnovaW_DamageIntBase + FrostnovaW_DamageIntStep * ( GetUnitAbilityLevel(s__FrostnovaSpells__FrostnovaW_KS_hero[this], FrostnovaW_ID) - 1 ) )
                set s__FrostnovaSpells__FrostnovaW_KS_maxDistance[this]=FrostnovaWRange(s__FrostnovaSpells__FrostnovaW_KS_hero[this])
                set s__FrostnovaSpells__FrostnovaW_KS_remainingDistance[this]=s__FrostnovaSpells__FrostnovaW_KS_maxDistance[this]
                set s__FrostnovaSpells__FrostnovaW_KS_distancePerTick[this]=FrostnovaW_Speed * 0.03
                if GetHeroLevel(s__FrostnovaSpells__FrostnovaW_KS_hero[this]) >= 25 then
                    set s__FrostnovaSpells__FrostnovaW_KS_distancePerTick[this]=s__FrostnovaSpells__FrostnovaW_KS_distancePerTick[this] * FrostnovaW_SpeedBonus25
                endif
                set s__FrostnovaSpells__FrostnovaW_KS_push[this]=FrostnovaW_Push

            call SetUnitAnimationByIndex(s__FrostnovaSpells__FrostnovaW_KS_hero[this], 1)
                if s__FrostnovaSpells__FrostnovaW_KS_enhanced[this] then
                    set s__FrostnovaSpells__FrostnovaW_KS_push[this]=FrostnovaTW_Push
                endif
                set s__FrostnovaSpells__FrostnovaW_KS_environmentCountdown[this]=0.0
                set s__FrostnovaSpells__FrostnovaW_KS_targets[this]=CreateGroup()
                set s__FrostnovaSpells__FrostnovaW_KS_hit[this]=sharedHit
                set s__FrostnovaSpells__FrostnovaW_KS_preparationRemaining[this]=FrostnovaW_Preparation
                set s__FrostnovaSpells__FrostnovaW_KS_radius[this]=FrostnovaW_StartAoe
                set s__FrostnovaSpells__FrostnovaW_KS_paused[this]=k == 0
                set s__FrostnovaSpells__FrostnovaW_KS_ownsInvulnerability[this]=false
                set s__FrostnovaSpells__FrostnovaW_KS_voiced[this]=k == 0
                set s__FrostnovaSpells__FrostnovaW_KS_mainEffect[this]=null
                set s__FrostnovaSpells__FrostnovaW_KS_trail[this]=null
                set s__FrostnovaSpells__FrostnovaW_KS_hand[this]=null
                if s__FrostnovaSpells__FrostnovaW_KS_paused[this] then
                    set s__FrostnovaSpells__FrostnovaW_KS_hand[this]=AddSpecialEffectTarget("war3mapImported\\wos_Frostnova_ChuShou_BY_Wood_Effect_Glow_GuiPaiQiGong_XuLiblue.mdx", s__FrostnovaSpells__FrostnovaW_KS_hero[this], "hand left")

                endif
                set s__FrostnovaSpells__FrostnovaW_KS_active[s__FrostnovaSpells__FrostnovaW_KS_count]=this
                set s__FrostnovaSpells__FrostnovaW_KS_count=s__FrostnovaSpells__FrostnovaW_KS_count + 1
                call GearTimer03Acquire()
                set k=k + 1
            endloop
            set sharedHit=null
        endfunction
    // ==================== E: Frostnova ====================
    // One field per caster: recasting moves/refreshes it, never adds another loop.

        function s__FrostnovaSpells__FrostnovaE_KS_RefreshBuffs takes integer this returns nothing
            local unit target
            local unit dummy
            if FrostnovaSpells__FrostnovaAlive(s__FrostnovaSpells__FrostnovaE_KS_hero[this]) and ( GetUnitX(s__FrostnovaSpells__FrostnovaE_KS_hero[this]) - s__FrostnovaSpells__FrostnovaE_KS_positionX[this] ) * ( GetUnitX(s__FrostnovaSpells__FrostnovaE_KS_hero[this]) - s__FrostnovaSpells__FrostnovaE_KS_positionX[this] ) + ( GetUnitY(s__FrostnovaSpells__FrostnovaE_KS_hero[this]) - s__FrostnovaSpells__FrostnovaE_KS_positionY[this] ) * ( GetUnitY(s__FrostnovaSpells__FrostnovaE_KS_hero[this]) - s__FrostnovaSpells__FrostnovaE_KS_positionY[this] ) <= FrostnovaE_Aoe * FrostnovaE_Aoe then
                // Own one-shot caster: the shared dummy's Cripple/Slow orders below replaced this Inner Fire order.
                call BuffUnit01(s__FrostnovaSpells__FrostnovaE_KS_hero[this] , s__FrostnovaSpells__FrostnovaE_KS_hero[this] , FrostnovaE_ResistAbilityID , "innerfire" , 1)
            endif
            call GroupEnumUnitsInRange(s__FrostnovaSpells__FrostnovaE_KS_targets[this], s__FrostnovaSpells__FrostnovaE_KS_positionX[this], s__FrostnovaSpells__FrostnovaE_KS_positionY[this], FrostnovaE_Aoe, null)
            loop
                set target=FirstOfGroup(s__FrostnovaSpells__FrostnovaE_KS_targets[this])
                exitwhen target == null
                call GroupRemoveUnit(s__FrostnovaSpells__FrostnovaE_KS_targets[this], target)
                if IsUnitEnemy(target, GetOwningPlayer(s__FrostnovaSpells__FrostnovaE_KS_hero[this])) and SpellBool(target) and not IsUnitType(target, UNIT_TYPE_STRUCTURE) and not IsUnitType(target, UNIT_TYPE_MAGIC_IMMUNE) then
                    set dummy=FrostnovaSpells__FrostnovaDummy[GetPlayerId(GetOwningPlayer(s__FrostnovaSpells__FrostnovaE_KS_hero[this]))]
                    if dummy == null or GetWidgetLife(dummy) <= 0.405 then
                        set dummy=CreateUnit(GetOwningPlayer(s__FrostnovaSpells__FrostnovaE_KS_hero[this]), 'h0C9', GetUnitX(target), GetUnitY(target), 0.0)
                        set FrostnovaSpells__FrostnovaDummy[GetPlayerId(GetOwningPlayer(s__FrostnovaSpells__FrostnovaE_KS_hero[this]))]=dummy
                    endif
                    call UnitAddAbility(dummy, FrostnovaE_HealCutAbilityID)
                    call IssueTargetOrder(dummy, "cripple", target)
                endif
            endloop
            set dummy=null
            set target=null
        endfunction

        function s__FrostnovaSpells__FrostnovaE_KS_Explode takes integer this returns nothing
            local unit target
            local integer k
            set s__FrostnovaSpells__FrostnovaE_KS_positionX[this]=GetUnitX(s__FrostnovaSpells__FrostnovaE_KS_hero[this])
            set s__FrostnovaSpells__FrostnovaE_KS_positionY[this]=GetUnitY(s__FrostnovaSpells__FrostnovaE_KS_hero[this])
            set s__FrostnovaSpells__FrostnovaE_KS_mainEffect[this]=AddSpecialEffect(FrostnovaE_Model, s__FrostnovaSpells__FrostnovaE_KS_positionX[this], s__FrostnovaSpells__FrostnovaE_KS_positionY[this])
            set s__FrostnovaSpells__FrostnovaE_KS_fieldEffect[this]=EffectSpawn("war3mapImported\\wos_az_snowflake01.mdx" , s__FrostnovaSpells__FrostnovaE_KS_positionX[this] , s__FrostnovaSpells__FrostnovaE_KS_positionY[this] , 1 , 1 , 4 , 1)
            call BlzSetSpecialEffectScale(s__FrostnovaSpells__FrostnovaE_KS_mainEffect[this], FrostnovaE_ModelScale)
            if s__FrostnovaSpells__FrostnovaE_KS_enhanced[this] then
                set s__FrostnovaSpells__FrostnovaE_KS_aura[this]=AddSpecialEffectTarget(FrostnovaTE_Model, s__FrostnovaSpells__FrostnovaE_KS_hero[this], "origin")
                set s__FrostnovaSpells__FrostnovaE_KS_area[this]=AddSpecialEffectTarget(FrostnovaTE_AreaModel, s__FrostnovaSpells__FrostnovaE_KS_hero[this], "origin")
                call BlzPlaySpecialEffect(s__FrostnovaSpells__FrostnovaE_KS_aura[this], ANIM_TYPE_STAND)
                call BlzPlaySpecialEffect(s__FrostnovaSpells__FrostnovaE_KS_area[this], ANIM_TYPE_STAND)
            endif
            call s__GearSystems2___KS_BuffTimer_SetDuration((s__FrostnovaSpells__FrostnovaE_KS_hero[this] ) , (( s__FrostnovaSpells__FrostnovaE_KS_remainingTime[this] )*1.0) , ( "BTNHero_Frostnova_E" ) , ( 2)) // INLINED!!
            if s__FrostnovaSpells__FrostnovaE_KS_enhanced[this] then
                call s__GearSystems2___KS_BuffTimer_SetDuration((s__FrostnovaSpells__FrostnovaE_KS_hero[this] ) , (( s__FrostnovaSpells__FrostnovaE_KS_remainingTime[this] )*1.0) , ( "BTNHero_Frostnova_TE" ) , ( 3)) // INLINED!!
            endif
            call VisionTimed(GetOwningPlayer(s__FrostnovaSpells__FrostnovaE_KS_hero[this]) , s__FrostnovaSpells__FrostnovaE_KS_positionX[this] , s__FrostnovaSpells__FrostnovaE_KS_positionY[this] , FrostnovaE_Aoe * 1.5 , s__FrostnovaSpells__FrostnovaE_KS_remainingTime[this])
            call DecorRemove(s__FrostnovaSpells__FrostnovaE_KS_hero[this] , s__FrostnovaSpells__FrostnovaE_KS_positionX[this] , s__FrostnovaSpells__FrostnovaE_KS_positionY[this] , FrostnovaE_Aoe , FrostnovaE_DecorDamage)
            call s__FrostnovaSpells__FrostnovaE_KS_RefreshBuffs(this)
            set s__FrostnovaSpells__FrostnovaE_KS_buffCountdown[this]=FrostnovaE_BuffPeriod
            call MakeSound(FrostnovaSpells__FrostnovaSoundPath + "E3")
            call MakeSound(FrostnovaSpells__FrostnovaSoundPath + "E4")
            call GroupEnumUnitsInRange(s__FrostnovaSpells__FrostnovaE_KS_targets[this], s__FrostnovaSpells__FrostnovaE_KS_positionX[this], s__FrostnovaSpells__FrostnovaE_KS_positionY[this], FrostnovaE_Aoe, null)
            loop
                set target=FirstOfGroup(s__FrostnovaSpells__FrostnovaE_KS_targets[this])
                exitwhen target == null
                call GroupRemoveUnit(s__FrostnovaSpells__FrostnovaE_KS_targets[this], target)
                if IsUnitEnemy(target, GetOwningPlayer(s__FrostnovaSpells__FrostnovaE_KS_hero[this])) and SpellBool(target) and not IsUnitType(target, UNIT_TYPE_STRUCTURE) then
                    call s__FrostnovaSpells__FrostnovaF_KS_Apply(s__FrostnovaSpells__FrostnovaE_KS_hero[this] , target , s__FrostnovaSpells__FrostnovaE_KS_enhanced[this])
                    set GearDamageNextSource=(FrostnovaE_ID) // INLINED!!
                    call dmgmag(s__FrostnovaSpells__FrostnovaE_KS_hero[this] , target , GetHeroInt(s__FrostnovaSpells__FrostnovaE_KS_hero[this], true) * ( FrostnovaE_BurstDamageIntBase + FrostnovaE_BurstDamageIntStep * ( GetUnitAbilityLevel(s__FrostnovaSpells__FrostnovaE_KS_hero[this], FrostnovaE_ID) - 1 ) ))
                    call MUE(target , FrostnovaE_Push , 0.3 , Atan2(GetUnitY(target) - s__FrostnovaSpells__FrostnovaE_KS_positionY[this], GetUnitX(target) - s__FrostnovaSpells__FrostnovaE_KS_positionX[this]))
                    if s__FrostnovaSpells__FrostnovaE_KS_enhanced[this] then
                        call StunUnit(s__FrostnovaSpells__FrostnovaE_KS_hero[this] , target , FrostnovaTE_Stun)
                    endif
                endif
            endloop
            if s__FrostnovaSpells__FrostnovaE_KS_burst[this] != null then
                call DestroyEffect(s__FrostnovaSpells__FrostnovaE_KS_burst[this])
                call DestroyEffect(s__FrostnovaSpells__FrostnovaE_KS_burst2[this])
            endif
            set k=0
            loop
                exitwhen k >= 8
                call DestroyEffect(EffectSpawn("war3mapImported\\wos_Frostnova_a (81).mdx" , s__FrostnovaSpells__FrostnovaE_KS_positionX[this] + 105.0 * Cos(k * bj_PI / 4.0) , s__FrostnovaSpells__FrostnovaE_KS_positionY[this] + 105.0 * Sin(k * bj_PI / 4.0) , k * 45.0 , 1.25 , FrostnovaE_SpikeScale , 0))
                set k=k + 1
            endloop
            set s__FrostnovaSpells__FrostnovaE_KS_burst[this]=AddSpecialEffect(FrostnovaQ_ImpactModel, s__FrostnovaSpells__FrostnovaE_KS_positionX[this], s__FrostnovaSpells__FrostnovaE_KS_positionY[this])
            set s__FrostnovaSpells__FrostnovaE_KS_burstCountdown[this]=FrostnovaE_BurstDuration
            set target=null
        endfunction

        function s__FrostnovaSpells__FrostnovaE_KS_Loop takes nothing returns nothing
            local integer index= 0
            local integer this
            local unit target
            loop
                exitwhen index >= s__FrostnovaSpells__FrostnovaE_KS_count
                set this=s__FrostnovaSpells__FrostnovaE_KS_active[index]
                if s__FrostnovaSpells__FrostnovaE_KS_preparationRemaining[this] > 0.0 then
                    set s__FrostnovaSpells__FrostnovaE_KS_preparationRemaining[this]=RMaxBJ(0.0, s__FrostnovaSpells__FrostnovaE_KS_preparationRemaining[this] - 0.03)
                    if not FrostnovaSpells__FrostnovaAlive(s__FrostnovaSpells__FrostnovaE_KS_hero[this]) or GetUnitTypeId(s__FrostnovaSpells__FrostnovaE_KS_hero[this]) == 0 then
                        set s__FrostnovaSpells__FrostnovaE_KS_preparationRemaining[this]=0.0
                        set s__FrostnovaSpells__FrostnovaE_KS_remainingTime[this]=0.0
                    elseif s__FrostnovaSpells__FrostnovaE_KS_preparationRemaining[this] <= 0.0001 then
                        set s__FrostnovaSpells__FrostnovaE_KS_preparationRemaining[this]=0.0
                        call s__FrostnovaSpells__FrostnovaE_KS_Explode(this)
                    endif
                    if s__FrostnovaSpells__FrostnovaE_KS_preparationRemaining[this] <= 0.0001 and s__FrostnovaSpells__FrostnovaE_KS_paused[this] then
                        call StopSpellUnit2(s__FrostnovaSpells__FrostnovaE_KS_hero[this])
                        set s__FrostnovaSpells__FrostnovaE_KS_paused[this]=false
                    endif
                else
                    set s__FrostnovaSpells__FrostnovaE_KS_remainingTime[this]=s__FrostnovaSpells__FrostnovaE_KS_remainingTime[this] - 0.03
                    set s__FrostnovaSpells__FrostnovaE_KS_buffCountdown[this]=s__FrostnovaSpells__FrostnovaE_KS_buffCountdown[this] - 0.03
                    if s__FrostnovaSpells__FrostnovaE_KS_buffCountdown[this] <= 0.0001 and s__FrostnovaSpells__FrostnovaE_KS_remainingTime[this] > 0.0 then
                        set s__FrostnovaSpells__FrostnovaE_KS_buffCountdown[this]=FrostnovaE_BuffPeriod
                        call s__FrostnovaSpells__FrostnovaE_KS_RefreshBuffs(this)
                    endif
                    if s__FrostnovaSpells__FrostnovaE_KS_aura[this] != null and not FrostnovaSpells__FrostnovaAlive(s__FrostnovaSpells__FrostnovaE_KS_hero[this]) then
                        call DestroyEffect(s__FrostnovaSpells__FrostnovaE_KS_aura[this])
                        call DestroyEffect(s__FrostnovaSpells__FrostnovaE_KS_area[this])
                        set s__FrostnovaSpells__FrostnovaE_KS_area[this]=null
                        set s__FrostnovaSpells__FrostnovaE_KS_aura[this]=null
                        call s__GearSystems2___KS_BuffTimer_SetDuration((s__FrostnovaSpells__FrostnovaE_KS_hero[this] ) , (( 0.0 )*1.0) , ( "BTNHero_Frostnova_TE" ) , ( 3)) // INLINED!!
                    endif
                    set s__FrostnovaSpells__FrostnovaE_KS_damageCountdown[this]=s__FrostnovaSpells__FrostnovaE_KS_damageCountdown[this] - 0.03
                    set s__FrostnovaSpells__FrostnovaE_KS_burstCountdown[this]=s__FrostnovaSpells__FrostnovaE_KS_burstCountdown[this] - 0.03
                    if s__FrostnovaSpells__FrostnovaE_KS_burst[this] != null and s__FrostnovaSpells__FrostnovaE_KS_burstCountdown[this] <= 0.0001 then
                        // The Splat Stand loops every second; keep it only for the burst.

                        call DestroyEffect(s__FrostnovaSpells__FrostnovaE_KS_burst[this])
                        set s__FrostnovaSpells__FrostnovaE_KS_burst[this]=null
                        call DestroyEffect(s__FrostnovaSpells__FrostnovaE_KS_burst2[this])
                        set s__FrostnovaSpells__FrostnovaE_KS_burst2[this]=null
                    endif
                    if s__FrostnovaSpells__FrostnovaE_KS_damageCountdown[this] <= 0.0001 and GetUnitTypeId(s__FrostnovaSpells__FrostnovaE_KS_hero[this]) != 0 then
                        set s__FrostnovaSpells__FrostnovaE_KS_damageCountdown[this]=s__FrostnovaSpells__FrostnovaE_KS_damageCountdown[this] + 1.0
                        call GroupEnumUnitsInRange(s__FrostnovaSpells__FrostnovaE_KS_targets[this], s__FrostnovaSpells__FrostnovaE_KS_positionX[this], s__FrostnovaSpells__FrostnovaE_KS_positionY[this], FrostnovaE_Aoe, null)
                        loop
                            set target=FirstOfGroup(s__FrostnovaSpells__FrostnovaE_KS_targets[this])
                            exitwhen target == null
                            call GroupRemoveUnit(s__FrostnovaSpells__FrostnovaE_KS_targets[this], target)
                            if IsUnitEnemy(target, GetOwningPlayer(s__FrostnovaSpells__FrostnovaE_KS_hero[this])) and SpellBool(target) and not IsUnitType(target, UNIT_TYPE_STRUCTURE) then
                                call s__FrostnovaSpells__FrostnovaF_KS_Apply(s__FrostnovaSpells__FrostnovaE_KS_hero[this] , target , s__FrostnovaSpells__FrostnovaE_KS_enhanced[this])
                                set GearDamageNextSource=(FrostnovaE_ID) // INLINED!!
                                call dmgmag(s__FrostnovaSpells__FrostnovaE_KS_hero[this] , target , s__FrostnovaSpells__FrostnovaE_KS_damage[this])
                            endif
                        endloop
                        if s__FrostnovaSpells__FrostnovaE_KS_enhanced[this] and FrostnovaSpells__FrostnovaAlive(s__FrostnovaSpells__FrostnovaE_KS_hero[this]) then
                            call VisionTimed(GetOwningPlayer(s__FrostnovaSpells__FrostnovaE_KS_hero[this]) , GetUnitX(s__FrostnovaSpells__FrostnovaE_KS_hero[this]) , GetUnitY(s__FrostnovaSpells__FrostnovaE_KS_hero[this]) , FrostnovaTE_Aoe * 1.5 , 1.1)
                            call GroupEnumUnitsInRange(s__FrostnovaSpells__FrostnovaE_KS_targets[this], GetUnitX(s__FrostnovaSpells__FrostnovaE_KS_hero[this]), GetUnitY(s__FrostnovaSpells__FrostnovaE_KS_hero[this]), FrostnovaTE_Aoe, null)
                            loop
                                set target=FirstOfGroup(s__FrostnovaSpells__FrostnovaE_KS_targets[this])
                                exitwhen target == null
                                call GroupRemoveUnit(s__FrostnovaSpells__FrostnovaE_KS_targets[this], target)
                                if IsUnitEnemy(target, GetOwningPlayer(s__FrostnovaSpells__FrostnovaE_KS_hero[this])) and SpellBool(target) and not IsUnitType(target, UNIT_TYPE_STRUCTURE) then
                                    call s__FrostnovaSpells__FrostnovaF_KS_Apply(s__FrostnovaSpells__FrostnovaE_KS_hero[this] , target , true)
                                    set GearDamageNextSource=(FrostnovaE_ID) // INLINED!!
                                    call dmgmag(s__FrostnovaSpells__FrostnovaE_KS_hero[this] , target , GetHeroInt(s__FrostnovaSpells__FrostnovaE_KS_hero[this], true) * FrostnovaTE_DamageInt)
                                endif
                            endloop
                        endif
                    endif
                endif
                set s__FrostnovaSpells__FrostnovaE_KS_invulnerabilityRemaining[this]=RMaxBJ(0.0, s__FrostnovaSpells__FrostnovaE_KS_invulnerabilityRemaining[this] - 0.03)
                if ( s__FrostnovaSpells__FrostnovaE_KS_invulnerabilityRemaining[this] <= 0.0001 or not FrostnovaSpells__FrostnovaAlive(s__FrostnovaSpells__FrostnovaE_KS_hero[this]) ) and s__FrostnovaSpells__FrostnovaE_KS_ownsInvulnerability[this] then
                    call UnitRemoveAbility(s__FrostnovaSpells__FrostnovaE_KS_hero[this], 'Avul')
                    set s__FrostnovaSpells__FrostnovaE_KS_ownsInvulnerability[this]=false
                endif
                if s__FrostnovaSpells__FrostnovaE_KS_remainingTime[this] <= 0.0001 or GetUnitTypeId(s__FrostnovaSpells__FrostnovaE_KS_hero[this]) == 0 then
                    if s__FrostnovaSpells__FrostnovaE_KS_ownsInvulnerability[this] then
                        call UnitRemoveAbility(s__FrostnovaSpells__FrostnovaE_KS_hero[this], 'Avul')
                    endif
                    call s__GearSystems2___KS_BuffTimer_SetDuration((s__FrostnovaSpells__FrostnovaE_KS_hero[this] ) , (( 0.0 )*1.0) , ( "BTNHero_Frostnova_E" ) , ( 2)) // INLINED!!
                    call s__GearSystems2___KS_BuffTimer_SetDuration((s__FrostnovaSpells__FrostnovaE_KS_hero[this] ) , (( 0.0 )*1.0) , ( "BTNHero_Frostnova_TE" ) , ( 3)) // INLINED!!
                    call RemoveSavedInteger(FrostnovaSpells__FrostnovaTable, GetHandleId(s__FrostnovaSpells__FrostnovaE_KS_hero[this]), 2)
                    if s__FrostnovaSpells__FrostnovaE_KS_burst[this] != null then
                        call DestroyEffect(s__FrostnovaSpells__FrostnovaE_KS_burst[this])
                        set s__FrostnovaSpells__FrostnovaE_KS_burst[this]=null
                        call DestroyEffect(s__FrostnovaSpells__FrostnovaE_KS_burst2[this])
                        set s__FrostnovaSpells__FrostnovaE_KS_burst2[this]=null
                    endif
                    call DestroyEffect(s__FrostnovaSpells__FrostnovaE_KS_mainEffect[this])
                    call DestroyEffect(s__FrostnovaSpells__FrostnovaE_KS_fieldEffect[this])
                    call DestroyEffect(s__FrostnovaSpells__FrostnovaE_KS_aura[this])
                    call DestroyEffect(s__FrostnovaSpells__FrostnovaE_KS_area[this])
                    set s__FrostnovaSpells__FrostnovaE_KS_area[this]=null
                    set s__FrostnovaSpells__FrostnovaE_KS_aura[this]=null
                    call DestroyGroup(s__FrostnovaSpells__FrostnovaE_KS_targets[this])
                    set s__FrostnovaSpells__FrostnovaE_KS_mainEffect[this]=null
                    set s__FrostnovaSpells__FrostnovaE_KS_fieldEffect[this]=null
                    set s__FrostnovaSpells__FrostnovaE_KS_targets[this]=null
                    set s__FrostnovaSpells__FrostnovaE_KS_hero[this]=null
                    set s__FrostnovaSpells__FrostnovaE_KS_count=s__FrostnovaSpells__FrostnovaE_KS_count - 1
                    set s__FrostnovaSpells__FrostnovaE_KS_active[index]=s__FrostnovaSpells__FrostnovaE_KS_active[s__FrostnovaSpells__FrostnovaE_KS_count]
                    call s__FrostnovaSpells__FrostnovaE_KS_deallocate(this)
                    call GearTimer03Release()
                else
                    set index=index + 1
                endif
            endloop
            set target=null
        endfunction

        function s__FrostnovaSpells__FrostnovaE_KS_Start takes unit caster returns nothing
            local integer state= LoadInteger(FrostnovaSpells__FrostnovaTable, GetHandleId(caster), 0)
            local integer this= LoadInteger(FrostnovaSpells__FrostnovaTable, GetHandleId(caster), 2)
            if this == 0 then
                set this=s__FrostnovaSpells__FrostnovaE_KS__allocate()
                set s__FrostnovaSpells__FrostnovaE_KS_hero[this]=caster
                set s__FrostnovaSpells__FrostnovaE_KS_ownsInvulnerability[this]=false
                set s__FrostnovaSpells__FrostnovaE_KS_burst[this]=null
                set s__FrostnovaSpells__FrostnovaE_KS_targets[this]=CreateGroup()
                set s__FrostnovaSpells__FrostnovaE_KS_mainEffect[this]=null
                set s__FrostnovaSpells__FrostnovaE_KS_fieldEffect[this]=null
                set s__FrostnovaSpells__FrostnovaE_KS_aura[this]=null
                set s__FrostnovaSpells__FrostnovaE_KS_area[this]=null
                set s__FrostnovaSpells__FrostnovaE_KS_paused[this]=false
                call SaveInteger(FrostnovaSpells__FrostnovaTable, GetHandleId(s__FrostnovaSpells__FrostnovaE_KS_hero[this]), 2, this)
                set s__FrostnovaSpells__FrostnovaE_KS_active[s__FrostnovaSpells__FrostnovaE_KS_count]=this
                set s__FrostnovaSpells__FrostnovaE_KS_count=s__FrostnovaSpells__FrostnovaE_KS_count + 1
                call GearTimer03Acquire()
            endif
            call DestroyEffect(s__FrostnovaSpells__FrostnovaE_KS_aura[this])
            call DestroyEffect(s__FrostnovaSpells__FrostnovaE_KS_area[this])
            set s__FrostnovaSpells__FrostnovaE_KS_area[this]=null
            set s__FrostnovaSpells__FrostnovaE_KS_aura[this]=null
            set s__FrostnovaSpells__FrostnovaE_KS_buffCountdown[this]=0.0
            set s__FrostnovaSpells__FrostnovaE_KS_positionX[this]=GetUnitX(s__FrostnovaSpells__FrostnovaE_KS_hero[this])
            set s__FrostnovaSpells__FrostnovaE_KS_positionY[this]=GetUnitY(s__FrostnovaSpells__FrostnovaE_KS_hero[this])
            set s__FrostnovaSpells__FrostnovaE_KS_preparationRemaining[this]=FrostnovaE_Preparation
            set s__FrostnovaSpells__FrostnovaE_KS_remainingTime[this]=FrostnovaE_Duration
            if not s__FrostnovaSpells__FrostnovaE_KS_paused[this] then
                call StartSpellUnit2(s__FrostnovaSpells__FrostnovaE_KS_hero[this])
                set s__FrostnovaSpells__FrostnovaE_KS_paused[this]=true
            endif
            if s__FrostnovaSpells__FrostnovaState_winterRemaining[state] > 0.0 then
                call s__FrostnovaSpells__FrostnovaState_Voice(state,true)
            else
                call MakeSound(FrostnovaSpells__FrostnovaSoundPath + "E")
            endif
            call MakeSound(FrostnovaSpells__FrostnovaSoundPath + "E2")
            if s__FrostnovaSpells__FrostnovaE_KS_mainEffect[this] != null then
                call DestroyEffect(s__FrostnovaSpells__FrostnovaE_KS_mainEffect[this])
                set s__FrostnovaSpells__FrostnovaE_KS_mainEffect[this]=null
            endif
            if s__FrostnovaSpells__FrostnovaE_KS_fieldEffect[this] != null then
                call DestroyEffect(s__FrostnovaSpells__FrostnovaE_KS_fieldEffect[this])
                set s__FrostnovaSpells__FrostnovaE_KS_fieldEffect[this]=null
            endif
            set s__FrostnovaSpells__FrostnovaE_KS_damageCountdown[this]=1.0
            set s__FrostnovaSpells__FrostnovaE_KS_damage[this]=GetHeroInt(s__FrostnovaSpells__FrostnovaE_KS_hero[this], true) * ( FrostnovaE_DamageIntBase + FrostnovaE_DamageIntStep * ( GetUnitAbilityLevel(s__FrostnovaSpells__FrostnovaE_KS_hero[this], FrostnovaE_ID) - 1 ) )
            set s__FrostnovaSpells__FrostnovaE_KS_enhanced[this]=s__FrostnovaSpells__FrostnovaState_winterRemaining[state] > 0.0
            if not s__FrostnovaSpells__FrostnovaE_KS_ownsInvulnerability[this] and GetUnitAbilityLevel(s__FrostnovaSpells__FrostnovaE_KS_hero[this], 'Avul') == 0 then
                call UnitAddAbility(s__FrostnovaSpells__FrostnovaE_KS_hero[this], 'Avul')
                set s__FrostnovaSpells__FrostnovaE_KS_ownsInvulnerability[this]=true
            endif
            call SetUnitAnimationByIndex(s__FrostnovaSpells__FrostnovaE_KS_hero[this], 3)
            call SetUnitTimeScale(s__FrostnovaSpells__FrostnovaE_KS_hero[this], 1.5)
            set s__FrostnovaSpells__FrostnovaE_KS_invulnerabilityRemaining[this]=FrostnovaE_Preparation + FrostnovaE_Invulnerability
        endfunction
    // ==================== R: Icefield ====================

        function s__FrostnovaSpells__FrostnovaR_KS_CheckExits takes integer this returns nothing
            local unit target
            local integer targetHandle
            local integer crystalIndex
            local real targetDistance
            local real previousDistance
            local real angle
            local effect crystal
            call GroupEnumUnitsInRange(s__FrostnovaSpells__FrostnovaR_KS_targets[this], s__FrostnovaSpells__FrostnovaR_KS_positionX[this], s__FrostnovaSpells__FrostnovaR_KS_positionY[this], s__FrostnovaSpells__FrostnovaR_KS_radius[this] + FrostnovaTR_ExitBand, null)
            // Observe every previously inside unit, even after a long blink.
            loop
                set target=FirstOfGroup(s__FrostnovaSpells__FrostnovaR_KS_insideTargets[this])
                exitwhen target == null
                call GroupRemoveUnit(s__FrostnovaSpells__FrostnovaR_KS_insideTargets[this], target)
                call GroupAddUnit(s__FrostnovaSpells__FrostnovaR_KS_targets[this], target)
            endloop
            loop
                set target=FirstOfGroup(s__FrostnovaSpells__FrostnovaR_KS_targets[this])
                exitwhen target == null
                call GroupRemoveUnit(s__FrostnovaSpells__FrostnovaR_KS_targets[this], target)
                if IsUnitEnemy(target, GetOwningPlayer(s__FrostnovaSpells__FrostnovaR_KS_hero[this])) and SpellBool(target) and not IsUnitType(target, UNIT_TYPE_STRUCTURE) then
                    set targetHandle=GetHandleId(target)
                    set targetDistance=SquareRoot(( GetUnitX(target) - s__FrostnovaSpells__FrostnovaR_KS_positionX[this] ) * ( GetUnitX(target) - s__FrostnovaSpells__FrostnovaR_KS_positionX[this] ) + ( GetUnitY(target) - s__FrostnovaSpells__FrostnovaR_KS_positionY[this] ) * ( GetUnitY(target) - s__FrostnovaSpells__FrostnovaR_KS_positionY[this] ))
                    if HaveSavedReal(FrostnovaSpells__FrostnovaTable, this, targetHandle) then
                        set previousDistance=LoadReal(FrostnovaSpells__FrostnovaTable, this, targetHandle)
                        // Only an actual exit into the outer band applies a native root.
                        if previousDistance <= s__FrostnovaSpells__FrostnovaR_KS_radius[this] and targetDistance > s__FrostnovaSpells__FrostnovaR_KS_radius[this] and targetDistance <= s__FrostnovaSpells__FrostnovaR_KS_radius[this] + FrostnovaTR_ExitBand and not HaveSavedReal(FrostnovaSpells__FrostnovaTable, this, - targetHandle) then
                            call RootUnit(s__FrostnovaSpells__FrostnovaR_KS_hero[this] , target , FrostnovaTR_ExitRoot)
                            call SaveReal(FrostnovaSpells__FrostnovaTable, this, - targetHandle, 1.0)
                            set crystalIndex=0
                            set angle=GetRandomReal(0.0, 2.0 * bj_PI)
                            loop
                                exitwhen crystalIndex == 4
                                set crystal=AddSpecialEffect(FrostnovaTR_CrystalModel, GetUnitX(target) + FrostnovaTR_TrapRadius * Cos(angle), GetUnitY(target) + FrostnovaTR_TrapRadius * Sin(angle))
                                call BlzSetSpecialEffectScale(crystal, FrostnovaTR_CrystalScale)
                                call BlzPlaySpecialEffect(crystal, ANIM_TYPE_STAND)
                                call SaveEffectHandle(FrostnovaSpells__FrostnovaTable, this, - 1000 - s__FrostnovaSpells__FrostnovaR_KS_crystalCount[this], crystal)
                                set s__FrostnovaSpells__FrostnovaR_KS_crystalCount[this]=s__FrostnovaSpells__FrostnovaR_KS_crystalCount[this] + 1
                                set angle=angle + bj_PI / 2.0
                                set crystalIndex=crystalIndex + 1
                            endloop
                        endif
                    endif
                    if targetDistance <= s__FrostnovaSpells__FrostnovaR_KS_radius[this] then
                        call SaveReal(FrostnovaSpells__FrostnovaTable, this, targetHandle, targetDistance)
                        call GroupAddUnit(s__FrostnovaSpells__FrostnovaR_KS_insideTargets[this], target)
                    else
                        call RemoveSavedReal(FrostnovaSpells__FrostnovaTable, this, targetHandle)
                    endif
                else
                    call RemoveSavedReal(FrostnovaSpells__FrostnovaTable, this, GetHandleId(target))
                endif
            endloop
            set target=null
            set crystal=null
        endfunction

        function s__FrostnovaSpells__FrostnovaR_KS_Loop takes nothing returns nothing
            local integer index= 0
            local integer fieldIndex
            local integer this
            local unit target
            local real orientationAngle
            local real radial
            local real cx
            local real cy
            local effect blast
            loop
                exitwhen index >= s__FrostnovaSpells__FrostnovaR_KS_count
                set this=s__FrostnovaSpells__FrostnovaR_KS_active[index]
                if s__FrostnovaSpells__FrostnovaR_KS_formation[this] > 0.0 then
                    set s__FrostnovaSpells__FrostnovaR_KS_formation[this]=RMaxBJ(0.0, s__FrostnovaSpells__FrostnovaR_KS_formation[this] - 0.03)
                    call BlzSetSpecialEffectScale(s__FrostnovaSpells__FrostnovaR_KS_mainEffect[this], RMaxBJ(0.05, 1.0 - s__FrostnovaSpells__FrostnovaR_KS_formation[this] / FrostnovaR_Formation) * s__FrostnovaSpells__FrostnovaR_KS_radius[this] / FrostnovaR_ModelRadius)
                    if s__FrostnovaSpells__FrostnovaR_KS_formation[this] <= 0.0001 then
                        set s__FrostnovaSpells__FrostnovaR_KS_formation[this]=0.0
                        call MakeSound(FrostnovaSpells__FrostnovaSoundPath + "R3")
                        if LoadInteger(FrostnovaSpells__FrostnovaTable, GetHandleId(s__FrostnovaSpells__FrostnovaR_KS_hero[this]), 4) == this then
                            call s__GearSystems2___KS_BuffTimer_SetDuration((s__FrostnovaSpells__FrostnovaR_KS_hero[this] ) , (( s__FrostnovaSpells__FrostnovaR_KS_remainingTime[this] )*1.0) , ( "BTNHero_Frostnova_R" ) , ( 4)) // INLINED!!
                        endif
                    endif
                else
                    set s__FrostnovaSpells__FrostnovaR_KS_remainingTime[this]=s__FrostnovaSpells__FrostnovaR_KS_remainingTime[this] - 0.03
                    if s__FrostnovaSpells__FrostnovaR_KS_enhanced[this] then
                        set s__FrostnovaSpells__FrostnovaR_KS_exitCountdown[this]=s__FrostnovaSpells__FrostnovaR_KS_exitCountdown[this] - 0.03
                        if s__FrostnovaSpells__FrostnovaR_KS_exitCountdown[this] <= 0.0001 then
                            set s__FrostnovaSpells__FrostnovaR_KS_exitCountdown[this]=s__FrostnovaSpells__FrostnovaR_KS_exitCountdown[this] + 0.12
                            call s__FrostnovaSpells__FrostnovaR_KS_CheckExits(this)
                        endif
                    endif
                    set s__FrostnovaSpells__FrostnovaR_KS_damageCountdown[this]=s__FrostnovaSpells__FrostnovaR_KS_damageCountdown[this] - 0.03
                    if s__FrostnovaSpells__FrostnovaR_KS_damageCountdown[this] <= 0.0001 and GetUnitTypeId(s__FrostnovaSpells__FrostnovaR_KS_hero[this]) != 0 then
                        set s__FrostnovaSpells__FrostnovaR_KS_damageCountdown[this]=s__FrostnovaSpells__FrostnovaR_KS_damageCountdown[this] + 1.0
                        call DecorRemove(s__FrostnovaSpells__FrostnovaR_KS_hero[this] , s__FrostnovaSpells__FrostnovaR_KS_positionX[this] , s__FrostnovaSpells__FrostnovaR_KS_positionY[this] , s__FrostnovaSpells__FrostnovaR_KS_radius[this] , FrostnovaR_DecorDamage)
                        call GroupEnumUnitsInRange(s__FrostnovaSpells__FrostnovaR_KS_targets[this], s__FrostnovaSpells__FrostnovaR_KS_positionX[this], s__FrostnovaSpells__FrostnovaR_KS_positionY[this], s__FrostnovaSpells__FrostnovaR_KS_radius[this], null)
                        loop
                            set target=FirstOfGroup(s__FrostnovaSpells__FrostnovaR_KS_targets[this])
                            exitwhen target == null
                            call GroupRemoveUnit(s__FrostnovaSpells__FrostnovaR_KS_targets[this], target)
                            if IsUnitEnemy(target, GetOwningPlayer(s__FrostnovaSpells__FrostnovaR_KS_hero[this])) and SpellBool(target) and not IsUnitType(target, UNIT_TYPE_STRUCTURE) then
                                call s__FrostnovaSpells__FrostnovaF_KS_Apply(s__FrostnovaSpells__FrostnovaR_KS_hero[this] , target , s__FrostnovaSpells__FrostnovaR_KS_enhanced[this])
                                set GearDamageNextSource=(FrostnovaR_ID) // INLINED!!
                                call dmgmag(s__FrostnovaSpells__FrostnovaR_KS_hero[this] , target , s__FrostnovaSpells__FrostnovaR_KS_damage[this] + GetHeroInt(s__FrostnovaSpells__FrostnovaR_KS_hero[this], true) * FrostnovaR_StackDamageInt * s__FrostnovaSpells__FrostnovaF_KS_StacksOn(target))
                            endif
                        endloop
                    endif
                    if s__FrostnovaSpells__FrostnovaR_KS_enhanced[this] and GetUnitTypeId(s__FrostnovaSpells__FrostnovaR_KS_hero[this]) != 0 then
                        set s__FrostnovaSpells__FrostnovaR_KS_burstCountdown[this]=s__FrostnovaSpells__FrostnovaR_KS_burstCountdown[this] - 0.03
                        if s__FrostnovaSpells__FrostnovaR_KS_burstCountdown[this] <= 0.0001 then
                            set s__FrostnovaSpells__FrostnovaR_KS_burstCountdown[this]=s__FrostnovaSpells__FrostnovaR_KS_burstCountdown[this] + FrostnovaTR_BurstPeriod
                            set orientationAngle=GetRandomReal(0.0, 2.0 * bj_PI)
                            set radial=RMaxBJ(0.0, s__FrostnovaSpells__FrostnovaR_KS_radius[this] - FrostnovaTR_BurstAoe) * SquareRoot(GetRandomReal(0.0, 1.0))
                            set cx=s__FrostnovaSpells__FrostnovaR_KS_positionX[this] + radial * Cos(orientationAngle)
                            set cy=s__FrostnovaSpells__FrostnovaR_KS_positionY[this] + radial * Sin(orientationAngle)
                            set blast=AddSpecialEffect(FrostnovaTR_BurstModel, cx, cy)
                            call BlzSetSpecialEffectScale(blast, FrostnovaTR_BurstScale)
                            call DestroyEffect(blast)
                            call GroupEnumUnitsInRange(s__FrostnovaSpells__FrostnovaR_KS_targets[this], cx, cy, FrostnovaTR_BurstAoe, null)
                            loop
                                set target=FirstOfGroup(s__FrostnovaSpells__FrostnovaR_KS_targets[this])
                                exitwhen target == null
                                call GroupRemoveUnit(s__FrostnovaSpells__FrostnovaR_KS_targets[this], target)
                                if IsUnitEnemy(target, GetOwningPlayer(s__FrostnovaSpells__FrostnovaR_KS_hero[this])) and SpellBool(target) and not IsUnitType(target, UNIT_TYPE_STRUCTURE) then
                                    call s__FrostnovaSpells__FrostnovaF_KS_Apply(s__FrostnovaSpells__FrostnovaR_KS_hero[this] , target , true)
                                    set GearDamageNextSource=(FrostnovaR_ID) // INLINED!!
                                    call dmgmag(s__FrostnovaSpells__FrostnovaR_KS_hero[this] , target , GetHeroInt(s__FrostnovaSpells__FrostnovaR_KS_hero[this], true) * FrostnovaTR_BurstDamageInt)
                                endif
                            endloop
                        endif
                    endif
                endif
                // Fixed gameplay radius. Only the initial formation scales the art.
                if s__FrostnovaSpells__FrostnovaR_KS_remainingTime[this] <= 0.0001 or GetUnitTypeId(s__FrostnovaSpells__FrostnovaR_KS_hero[this]) == 0 then
                    loop
                        exitwhen s__FrostnovaSpells__FrostnovaR_KS_crystalCount[this] == 0
                        set s__FrostnovaSpells__FrostnovaR_KS_crystalCount[this]=s__FrostnovaSpells__FrostnovaR_KS_crystalCount[this] - 1
                        call DestroyEffect(LoadEffectHandle(FrostnovaSpells__FrostnovaTable, this, - 1000 - s__FrostnovaSpells__FrostnovaR_KS_crystalCount[this]))
                    endloop
                    set fieldIndex=LoadInteger(FrostnovaSpells__FrostnovaTable, this, 30)
                    set FrostnovaSpells__FrostnovaIcefieldCount=FrostnovaSpells__FrostnovaIcefieldCount - 1
                    set FrostnovaSpells__FrostnovaIcefields[fieldIndex]=FrostnovaSpells__FrostnovaIcefields[FrostnovaSpells__FrostnovaIcefieldCount]
                    call SaveInteger(FrostnovaSpells__FrostnovaTable, FrostnovaSpells__FrostnovaIcefields[fieldIndex], 30, fieldIndex)
                    if LoadInteger(FrostnovaSpells__FrostnovaTable, GetHandleId(s__FrostnovaSpells__FrostnovaR_KS_hero[this]), 4) == this then
                        call s__GearSystems2___KS_BuffTimer_SetDuration((s__FrostnovaSpells__FrostnovaR_KS_hero[this] ) , (( 0.0 )*1.0) , ( "BTNHero_Frostnova_R" ) , ( 4)) // INLINED!!
                        call RemoveSavedInteger(FrostnovaSpells__FrostnovaTable, GetHandleId(s__FrostnovaSpells__FrostnovaR_KS_hero[this]), 4)
                    endif
                    call FlushChildHashtable(FrostnovaSpells__FrostnovaTable, this)
                    call DestroyEffect(s__FrostnovaSpells__FrostnovaR_KS_mainEffect[this])
                    call DestroyGroup(s__FrostnovaSpells__FrostnovaR_KS_targets[this])
                    call DestroyGroup(s__FrostnovaSpells__FrostnovaR_KS_insideTargets[this])
                    set s__FrostnovaSpells__FrostnovaR_KS_insideTargets[this]=null
                    set s__FrostnovaSpells__FrostnovaR_KS_targets[this]=null
                    set s__FrostnovaSpells__FrostnovaR_KS_mainEffect[this]=null
                    set s__FrostnovaSpells__FrostnovaR_KS_hero[this]=null
                    set s__FrostnovaSpells__FrostnovaR_KS_count=s__FrostnovaSpells__FrostnovaR_KS_count - 1
                    set s__FrostnovaSpells__FrostnovaR_KS_active[index]=s__FrostnovaSpells__FrostnovaR_KS_active[s__FrostnovaSpells__FrostnovaR_KS_count]
                    call s__FrostnovaSpells__FrostnovaR_KS_deallocate(this)
                    call GearTimer03Release()
                else
                    set index=index + 1
                endif
            endloop
            set target=null
            set blast=null
        endfunction

        function s__FrostnovaSpells__FrostnovaR_KS_Start takes unit caster,real targetX,real targetY returns nothing
            local integer state= LoadInteger(FrostnovaSpells__FrostnovaTable, GetHandleId(caster), 0)
            local integer this= s__FrostnovaSpells__FrostnovaR_KS__allocate()
            local unit target
            set s__FrostnovaSpells__FrostnovaR_KS_hero[this]=caster
            set s__FrostnovaSpells__FrostnovaR_KS_positionX[this]=targetX
            set s__FrostnovaSpells__FrostnovaR_KS_positionY[this]=targetY
            set s__FrostnovaSpells__FrostnovaR_KS_damage[this]=GetHeroInt(s__FrostnovaSpells__FrostnovaR_KS_hero[this], true) * ( FrostnovaR_DamageIntBase + FrostnovaR_DamageIntStep * ( GetUnitAbilityLevel(s__FrostnovaSpells__FrostnovaR_KS_hero[this], FrostnovaR_ID) - 1 ) )
            set s__FrostnovaSpells__FrostnovaR_KS_enhanced[this]=s__FrostnovaSpells__FrostnovaState_winterRemaining[state] > 0.0
            if s__FrostnovaSpells__FrostnovaR_KS_enhanced[this] then
                call s__FrostnovaSpells__FrostnovaState_Voice(state,true)
            else
                call MakeSound(FrostnovaSpells__FrostnovaSoundPath + "R")
            endif
            call MakeSound(FrostnovaSpells__FrostnovaSoundPath + "R2")
            call SaveInteger(FrostnovaSpells__FrostnovaTable, GetHandleId(s__FrostnovaSpells__FrostnovaR_KS_hero[this]), 4, this)
            call s__GearSystems2___KS_BuffTimer_SetDuration((s__FrostnovaSpells__FrostnovaR_KS_hero[this] ) , (( 0.0 )*1.0) , ( "BTNHero_Frostnova_R" ) , ( 4)) // INLINED!!
            set s__FrostnovaSpells__FrostnovaR_KS_formation[this]=FrostnovaR_Formation
            set s__FrostnovaSpells__FrostnovaR_KS_damageCountdown[this]=1.0
            set s__FrostnovaSpells__FrostnovaR_KS_burstCountdown[this]=FrostnovaTR_BurstPeriod
            set s__FrostnovaSpells__FrostnovaR_KS_radius[this]=FrostnovaR_Aoe
            set s__FrostnovaSpells__FrostnovaR_KS_remainingTime[this]=FrostnovaR_Duration + FrostnovaR_DurationStep * ( GetUnitAbilityLevel(s__FrostnovaSpells__FrostnovaR_KS_hero[this], FrostnovaR_ID) - 1 )
            call VisionTimed(GetOwningPlayer(s__FrostnovaSpells__FrostnovaR_KS_hero[this]) , s__FrostnovaSpells__FrostnovaR_KS_positionX[this] , s__FrostnovaSpells__FrostnovaR_KS_positionY[this] , s__FrostnovaSpells__FrostnovaR_KS_radius[this] * 1.5 , s__FrostnovaSpells__FrostnovaR_KS_remainingTime[this] + s__FrostnovaSpells__FrostnovaR_KS_formation[this])
            set s__FrostnovaSpells__FrostnovaR_KS_exitCountdown[this]=0.0
            set s__FrostnovaSpells__FrostnovaR_KS_crystalCount[this]=0
            set FrostnovaSpells__FrostnovaIcefields[FrostnovaSpells__FrostnovaIcefieldCount]=this
            call SaveInteger(FrostnovaSpells__FrostnovaTable, this, 30, FrostnovaSpells__FrostnovaIcefieldCount)
            set FrostnovaSpells__FrostnovaIcefieldCount=FrostnovaSpells__FrostnovaIcefieldCount + 1
            set FrostnovaSpells__FrostnovaIcefieldX[this]=s__FrostnovaSpells__FrostnovaR_KS_positionX[this]
            set FrostnovaSpells__FrostnovaIcefieldY[this]=s__FrostnovaSpells__FrostnovaR_KS_positionY[this]
            set FrostnovaSpells__FrostnovaIcefieldRadius[this]=s__FrostnovaSpells__FrostnovaR_KS_radius[this]
            call SetUnitAnimationByIndex(s__FrostnovaSpells__FrostnovaR_KS_hero[this], 4)
            set s__FrostnovaSpells__FrostnovaR_KS_targets[this]=CreateGroup()
            set s__FrostnovaSpells__FrostnovaR_KS_insideTargets[this]=CreateGroup()
            if s__FrostnovaSpells__FrostnovaR_KS_enhanced[this] then
                call DestroyEffect(EffectSpawn(FrostnovaTR_StartModel , s__FrostnovaSpells__FrostnovaR_KS_positionX[this] , s__FrostnovaSpells__FrostnovaR_KS_positionY[this] , 1 , 1 , FrostnovaTR_StartScale , 15))
                call GroupEnumUnitsInRange(s__FrostnovaSpells__FrostnovaR_KS_targets[this], s__FrostnovaSpells__FrostnovaR_KS_positionX[this], s__FrostnovaSpells__FrostnovaR_KS_positionY[this], s__FrostnovaSpells__FrostnovaR_KS_radius[this], null)
                loop
                    set target=FirstOfGroup(s__FrostnovaSpells__FrostnovaR_KS_targets[this])
                    exitwhen target == null
                    call GroupRemoveUnit(s__FrostnovaSpells__FrostnovaR_KS_targets[this], target)
                    if IsUnitEnemy(target, GetOwningPlayer(s__FrostnovaSpells__FrostnovaR_KS_hero[this])) and SpellBool(target) and not IsUnitType(target, UNIT_TYPE_STRUCTURE) then
                        call RootUnit(s__FrostnovaSpells__FrostnovaR_KS_hero[this] , target , FrostnovaTR_StartRoot)
                        call SaveReal(FrostnovaSpells__FrostnovaTable, this, GetHandleId(target), SquareRoot(( GetUnitX(target) - s__FrostnovaSpells__FrostnovaR_KS_positionX[this] ) * ( GetUnitX(target) - s__FrostnovaSpells__FrostnovaR_KS_positionX[this] ) + ( GetUnitY(target) - s__FrostnovaSpells__FrostnovaR_KS_positionY[this] ) * ( GetUnitY(target) - s__FrostnovaSpells__FrostnovaR_KS_positionY[this] )))
                        call GroupAddUnit(s__FrostnovaSpells__FrostnovaR_KS_insideTargets[this], target)
                    endif
                endloop
            endif
            set s__FrostnovaSpells__FrostnovaR_KS_mainEffect[this]=AddSpecialEffect(FrostnovaR_Model, s__FrostnovaSpells__FrostnovaR_KS_positionX[this], s__FrostnovaSpells__FrostnovaR_KS_positionY[this])
            call BlzSetSpecialEffectAlpha(s__FrostnovaSpells__FrostnovaR_KS_mainEffect[this], 200)
            call BlzSetSpecialEffectScale(s__FrostnovaSpells__FrostnovaR_KS_mainEffect[this], 0.05 * s__FrostnovaSpells__FrostnovaR_KS_radius[this] / FrostnovaR_ModelRadius)
            call BlzSetSpecialEffectColor(s__FrostnovaSpells__FrostnovaR_KS_mainEffect[this], 80, 180, 255)
            set s__FrostnovaSpells__FrostnovaR_KS_active[s__FrostnovaSpells__FrostnovaR_KS_count]=this
            set s__FrostnovaSpells__FrostnovaR_KS_count=s__FrostnovaSpells__FrostnovaR_KS_count + 1
            call GearTimer03Acquire()
            set target=null
        endfunction
    // ==================== T: Winter's Scar ====================

        function s__FrostnovaSpells__FrostnovaT_KS_Loop takes nothing returns nothing
            local integer index= 0
            local integer this
            local integer state
            loop
                exitwhen index >= s__FrostnovaSpells__FrostnovaT_KS_count
                set this=s__FrostnovaSpells__FrostnovaT_KS_active[index]
                set state=LoadInteger(FrostnovaSpells__FrostnovaTable, GetHandleId(s__FrostnovaSpells__FrostnovaT_KS_hero[this]), 0)
                if not IsUnitPaused(s__FrostnovaSpells__FrostnovaT_KS_hero[this]) then
                    set s__FrostnovaSpells__FrostnovaState_winterRemaining[state]=RMaxBJ(0.0, s__FrostnovaSpells__FrostnovaState_winterRemaining[state] - 0.03)
                endif
                if not FrostnovaSpells__FrostnovaAlive(s__FrostnovaSpells__FrostnovaT_KS_hero[this]) or GetUnitTypeId(s__FrostnovaSpells__FrostnovaT_KS_hero[this]) == 0 then
                    set s__FrostnovaSpells__FrostnovaState_winterRemaining[state]=0.0
                endif
                if s__FrostnovaSpells__FrostnovaState_winterRemaining[state] <= 0.0001 then
                    set s__FrostnovaSpells__FrostnovaState_winterRemaining[state]=0.0
                    call s__FrostnovaSpells__FrostnovaState_SetIcons(state,false)
                    call s__FrostnovaSpells__FrostnovaState_UpdateShards(state)
                    call WOSUI___WUI_TestHeroProgress((s__FrostnovaSpells__FrostnovaT_KS_hero[this] ) , ( FrostnovaT_ID ) , ( "Winter's Scar" ) , (( 0.0 )*1.0) , (( 0.0 )*1.0) , ( true) , "") // INLINED!!
                    call RemoveSavedInteger(FrostnovaSpells__FrostnovaTable, GetHandleId(s__FrostnovaSpells__FrostnovaT_KS_hero[this]), 3)
                    call DestroyEffect(s__FrostnovaSpells__FrostnovaT_KS_mainEffect[this])
                    set s__FrostnovaSpells__FrostnovaT_KS_mainEffect[this]=null
                    set s__FrostnovaSpells__FrostnovaT_KS_hero[this]=null
                    set s__FrostnovaSpells__FrostnovaT_KS_count=s__FrostnovaSpells__FrostnovaT_KS_count - 1
                    set s__FrostnovaSpells__FrostnovaT_KS_active[index]=s__FrostnovaSpells__FrostnovaT_KS_active[s__FrostnovaSpells__FrostnovaT_KS_count]
                    call s__FrostnovaSpells__FrostnovaT_KS_deallocate(this)
                    call GearTimer03Release()
                else
                    if s__FrostnovaSpells__FrostnovaState_voiceRemaining[state] > 0.0001 then
                        call WUI_HeroProgressDualText(s__FrostnovaSpells__FrostnovaT_KS_hero[this] , FrostnovaT_ID , "Winter's Scar" , s__FrostnovaSpells__FrostnovaState_winterRemaining[state] , FrostnovaT_Duration , s__FrostnovaSpells__FrostnovaState_shieldRemaining[state] , FrostnovaT_ShieldDuration , "|cffffffffShield: " + R2SW(s__FrostnovaSpells__FrostnovaState_shieldRemaining[state], 0, 1) + "s|r")
                    else
                        call WUI_HeroProgressDualText(s__FrostnovaSpells__FrostnovaT_KS_hero[this] , FrostnovaT_ID , "Winter's Scar" , s__FrostnovaSpells__FrostnovaState_winterRemaining[state] , FrostnovaT_Duration , 0.0 , 1.0 , "|cffffffffShield Ready|r")
                    endif
                    set index=index + 1
                endif
            endloop
        endfunction

        function s__FrostnovaSpells__FrostnovaT_KS_Start takes unit caster returns nothing
            local integer state= LoadInteger(FrostnovaSpells__FrostnovaTable, GetHandleId(caster), 0)
            local integer this= LoadInteger(FrostnovaSpells__FrostnovaTable, GetHandleId(caster), 3)
            if this == 0 then
                set this=s__FrostnovaSpells__FrostnovaT_KS__allocate()
                set s__FrostnovaSpells__FrostnovaT_KS_hero[this]=caster
                set s__FrostnovaSpells__FrostnovaT_KS_mainEffect[this]=AddSpecialEffectTarget(FrostnovaT_Model, s__FrostnovaSpells__FrostnovaT_KS_hero[this], "origin")
                call BlzPlaySpecialEffect(s__FrostnovaSpells__FrostnovaT_KS_mainEffect[this], ANIM_TYPE_STAND)
                call SaveInteger(FrostnovaSpells__FrostnovaTable, GetHandleId(s__FrostnovaSpells__FrostnovaT_KS_hero[this]), 3, this)
                set s__FrostnovaSpells__FrostnovaT_KS_active[s__FrostnovaSpells__FrostnovaT_KS_count]=this
                set s__FrostnovaSpells__FrostnovaT_KS_count=s__FrostnovaSpells__FrostnovaT_KS_count + 1
                call GearTimer03Acquire()
            endif
            call VisionTimed(GetOwningPlayer(s__FrostnovaSpells__FrostnovaT_KS_hero[this]) , GetUnitX(s__FrostnovaSpells__FrostnovaT_KS_hero[this]) , GetUnitY(s__FrostnovaSpells__FrostnovaT_KS_hero[this]) , FrostnovaTE_Aoe * 2.0 , 2.0)
            call MakeSound(FrostnovaSpells__FrostnovaSoundPath + "T1")
            call MakeSound(FrostnovaSpells__FrostnovaSoundPath + "T5")
            set s__FrostnovaSpells__FrostnovaState_voiceRemaining[state]=RMaxBJ(s__FrostnovaSpells__FrostnovaState_voiceRemaining[state], 4.393)
            set s__FrostnovaSpells__FrostnovaState_voiceDuration[state]=s__FrostnovaSpells__FrostnovaState_voiceRemaining[state]
            set s__FrostnovaSpells__FrostnovaState_nextVoice[state]=2
            set s__FrostnovaSpells__FrostnovaState_winterRemaining[state]=FrostnovaT_Duration
            call s__FrostnovaSpells__FrostnovaState_SetIcons(state,true)
            call s__FrostnovaSpells__FrostnovaState_RefreshShield(state)
            call BlzStartUnitAbilityCooldown(s__FrostnovaSpells__FrostnovaT_KS_hero[this], FrostnovaW_ID, RMaxBJ(0.0, BlzGetUnitAbilityCooldownRemaining(s__FrostnovaSpells__FrostnovaT_KS_hero[this], FrostnovaW_ID) - FrostnovaT_CooldownReduction))
            call BlzStartUnitAbilityCooldown(s__FrostnovaSpells__FrostnovaT_KS_hero[this], FrostnovaE_ID, RMaxBJ(0.0, BlzGetUnitAbilityCooldownRemaining(s__FrostnovaSpells__FrostnovaT_KS_hero[this], FrostnovaE_ID) - FrostnovaT_CooldownReduction))
            call BlzStartUnitAbilityCooldown(s__FrostnovaSpells__FrostnovaT_KS_hero[this], FrostnovaR_ID, RMaxBJ(0.0, BlzGetUnitAbilityCooldownRemaining(s__FrostnovaSpells__FrostnovaT_KS_hero[this], FrostnovaR_ID) - FrostnovaT_CooldownReduction))
            call WUI_HeroProgressDualText(s__FrostnovaSpells__FrostnovaT_KS_hero[this] , FrostnovaT_ID , "Winter's Scar" , s__FrostnovaSpells__FrostnovaState_winterRemaining[state] , FrostnovaT_Duration , s__FrostnovaSpells__FrostnovaState_shieldRemaining[state] , FrostnovaT_ShieldDuration , "|cffffffffShield: " + R2SW(s__FrostnovaSpells__FrostnovaState_shieldRemaining[state], 0, 1) + "s|r")
            call s__KS_SpellStacks_RestoreAllStacks((s__FrostnovaSpells__FrostnovaT_KS_hero[this])) // INLINED!!
            set s__FrostnovaSpells__FrostnovaState_qCastDelay[state]=0.0
            call s__GearSystems2___KS_RemoveUnit_MyRemoveUnit_Start((s__FrostnovaSpells__FrostnovaT_KS_hero[this] ) , (( 0.03 )*1.0) , 2 , - 1 , ( 6) , "") // INLINED!!
            call SetUnitTimeScale(s__FrostnovaSpells__FrostnovaT_KS_hero[this], 2.15)
            call s__GearSystems2___KS_RemoveUnit_MyRemoveUnit_Start((s__FrostnovaSpells__FrostnovaT_KS_hero[this] ) , (( 0.5 )*1.0) , 1 , (( 1)*1.0) , - 1 , "") // INLINED!!
            call BlzEndUnitAbilityCooldown(s__FrostnovaSpells__FrostnovaT_KS_hero[this], FrostnovaQ_ID)
            call s__FrostnovaSpells__FrostnovaState_UpdateShards(state)
        endfunction
    // ==================== COMMON: one timer listener and hero lifecycle ====================
    function FrostnovaSpells__FrostnovaTimer03Loop takes nothing returns boolean
        call s__FrostnovaSpells__FrostnovaQ_KS_Loop()
        call s__FrostnovaSpells__FrostnovaW_KS_Loop()
        call s__FrostnovaSpells__FrostnovaE_KS_Loop()
        call s__FrostnovaSpells__FrostnovaR_KS_Loop()
        call s__FrostnovaSpells__FrostnovaT_KS_Loop()
        call s__FrostnovaSpells__FrostnovaF_KS_Loop()
        call s__FrostnovaSpells__FrostnovaState_Loop()
        return false
    endfunction
    function Frostnova_Register takes unit hero returns nothing
        local integer state
        if GetUnitTypeId(hero) != Frostnova_ID or IsUnitIllusion(hero) then
            return
        endif
        if not FrostnovaSpells__FrostnovaListenerOn then
            set FrostnovaSpells__FrostnovaListenerOn=true
            call TriggerAddCondition(GearTimer03Listeners, Condition(function FrostnovaSpells__FrostnovaTimer03Loop))
        endif
        set state=LoadInteger(FrostnovaSpells__FrostnovaTable, GetHandleId(hero), 0)
        if state == 0 then
            set state=s__FrostnovaSpells__FrostnovaState__allocate()
            set s__FrostnovaSpells__FrostnovaState_hero[state]=hero
            set s__FrostnovaSpells__FrostnovaState_qLevel[state]=0
            set s__FrostnovaSpells__FrostnovaState_qCastDelay[state]=0.0
            set s__FrostnovaSpells__FrostnovaState_previousQCharges[state]=0
            set s__FrostnovaSpells__FrostnovaState_winterRemaining[state]=0.0
            set s__FrostnovaSpells__FrostnovaState_ticking[state]=false
            set s__FrostnovaSpells__FrostnovaState_orbitTime[state]=0.0
            set s__FrostnovaSpells__FrostnovaState_voiceRemaining[state]=0.0
            set s__FrostnovaSpells__FrostnovaState_voiceDuration[state]=0.0
            set s__FrostnovaSpells__FrostnovaState_shieldRemaining[state]=0.0
            set s__FrostnovaSpells__FrostnovaState_nextVoice[state]=2
            set s__FrostnovaSpells__FrostnovaState_nextNormalVoice[state]=0
            set s__FrostnovaSpells__FrostnovaState_enhancedShards[state]=false
            set s__FrostnovaSpells__FrostnovaState_rangeBonus[state]=false
            call SaveInteger(FrostnovaSpells__FrostnovaTable, GetHandleId(hero), 0, state)
            call UnitAddAbility(hero, FrostnovaF_ID)
            call UnitMakeAbilityPermanent(hero, true, FrostnovaF_ID)
        endif
        call s__FrostnovaSpells__FrostnovaState_RefreshRange(state)
        if s__FrostnovaSpells__FrostnovaState_qLevel[state] != GetUnitAbilityLevel(hero, FrostnovaQ_ID) or (s__KS_SpellStacks_GetMaxStackCount((hero))) == 0 then // INLINED!!
            call s__FrostnovaSpells__FrostnovaState_RefreshCharges(state)
        endif
    endfunction
    function Frostnova_ResetForTest takes unit hero returns nothing
        local integer state
        call Frostnova_Register(hero)
        set state=LoadInteger(FrostnovaSpells__FrostnovaTable, GetHandleId(hero), 0)
        if state == 0 then
            return
        endif
        set s__FrostnovaSpells__FrostnovaState_qCastDelay[state]=0.0
        call s__KS_SpellStacks_RestoreAllStacks((hero)) // INLINED!!
        call s__FrostnovaSpells__FrostnovaState_UpdateShards(state)
    endfunction
    function Frostnova_Death takes unit hero returns nothing
        local integer state= LoadInteger(FrostnovaSpells__FrostnovaTable, GetHandleId(hero), 0)
        if state != 0 then
            set s__FrostnovaSpells__FrostnovaState_winterRemaining[state]=0.0
            call s__KS_SpellStacks_RestoreAllStacks((hero)) // INLINED!!
            set s__FrostnovaSpells__FrostnovaState_qCastDelay[state]=0.0
            call s__FrostnovaSpells__FrostnovaState_UpdateShards(state)
            call s__FrostnovaSpells__FrostnovaState_Activate(state)
        endif
    endfunction

    // ==================== Q / W / E / R / T: CastCheck entry points ====================
    function FrostnovaQ_Start takes unit hero,real positionX,real positionY returns boolean
        call Frostnova_Register(hero)
        return s__FrostnovaSpells__FrostnovaQ_KS_Start(hero , positionX , positionY)
    endfunction

    function FrostnovaW_Start takes unit hero,real positionX,real positionY returns nothing
        call Frostnova_Register(hero)
        call s__FrostnovaSpells__FrostnovaW_KS_Start(hero , positionX , positionY)
    endfunction

    function FrostnovaE_Start takes unit hero returns nothing
        call Frostnova_Register(hero)
        call s__FrostnovaSpells__FrostnovaE_KS_Start(hero)
    endfunction

    function FrostnovaR_Start takes unit hero,real positionX,real positionY returns nothing
        call Frostnova_Register(hero)
        call s__FrostnovaSpells__FrostnovaR_KS_Start(hero , positionX , positionY)
    endfunction

    function FrostnovaT_Start takes unit hero returns nothing
        call Frostnova_Register(hero)
        call s__FrostnovaSpells__FrostnovaT_KS_Start(hero)
    endfunction
    function FrostnovaSpells__InitFrostnovaSpells takes nothing returns nothing
        set FrostnovaSpells__FrostnovaFBuff[1]=FrostnovaF1_BuffID
        set FrostnovaSpells__FrostnovaFBuff[2]=FrostnovaF2_BuffID
        set FrostnovaSpells__FrostnovaFBuff[3]=FrostnovaF3_BuffID
        set FrostnovaSpells__FrostnovaFBuff[4]=FrostnovaF4_BuffID
        set FrostnovaSpells__FrostnovaFBuff[5]=FrostnovaF5_BuffID
        set FrostnovaSpells__FrostnovaFBuff[6]=FrostnovaTF1_BuffID
        set FrostnovaSpells__FrostnovaFBuff[7]=FrostnovaTF2_BuffID
        set FrostnovaSpells__FrostnovaFBuff[8]=FrostnovaTF3_BuffID
        set FrostnovaSpells__FrostnovaFBuff[9]=FrostnovaTF4_BuffID
        set FrostnovaSpells__FrostnovaFBuff[10]=FrostnovaTF5_BuffID
        // Lazy listener registration in Frostnova_Register; no private timer.
    endfunction

//library FrostnovaSpells ends
//library LaxusSpells:

    //===========================================================================
    // МОДУЛЬ ORDER TRACKING (БЕГ БЕЗ ОСТАНОВКИ)
    //===========================================================================
    function LaxusSpells___OnHeroPointOrder takes nothing returns boolean
        local unit u= GetOrderedUnit()
        local integer ord= GetIssuedOrderId()
        if GetUnitTypeId(u) == Laxus_ID then
            if ord == 851971 or ord == 851986 or ord == 851990 then
                call SaveInteger(hs, GetHandleId(u), LaxusSpells___SH_ORD_MODE, 1)
                call SaveInteger(hs, GetHandleId(u), LaxusSpells___SH_ORD_ID, ord)
                call SaveReal(hs, GetHandleId(u), LaxusSpells___SH_ORD_X, GetOrderPointX())
                call SaveReal(hs, GetHandleId(u), LaxusSpells___SH_ORD_Y, GetOrderPointY())
            endif
        endif
        set u=null
        return false
    endfunction

    function LaxusSpells___OnHeroTargetOrder takes nothing returns boolean
        local unit u= GetOrderedUnit()
        local integer ord= GetIssuedOrderId()
        if GetUnitTypeId(u) == Laxus_ID then
            if ord == 851971 or ord == 851983 then
                call SaveInteger(hs, GetHandleId(u), LaxusSpells___SH_ORD_MODE, 2)
                call SaveInteger(hs, GetHandleId(u), LaxusSpells___SH_ORD_ID, ord)
                call SaveUnitHandle(hs, GetHandleId(u), LaxusSpells___SH_ORD_TARGET, GetOrderTargetUnit())
            endif
        endif
        set u=null
        return false
    endfunction

    function LaxusSpells___OnHeroImmediateOrder takes nothing returns boolean
        local unit u= GetOrderedUnit()
        local integer ord= GetIssuedOrderId()
        if GetUnitTypeId(u) == Laxus_ID then
            if ord == 851972 or ord == 851993 then
                call SaveInteger(hs, GetHandleId(u), LaxusSpells___SH_ORD_MODE, 0)
            endif
        endif
        set u=null
        return false
    endfunction

    function LaxusSpells___LaxusQ_Release takes unit c,boolean invulnerable returns nothing
        if invulnerable then
            call UnitRemoveAbility(c, 'Avul')
        endif
        call SetUnitTimeScale(c, 1.00)
        call PauseUnit(c, false)
        call GearSelectOnlyHero(c)
    endfunction

    function Laxus_RestoreOrder takes unit c,integer animIndex returns nothing
        local integer mode= LoadInteger(hs, GetHandleId(c), LaxusSpells___SH_ORD_MODE)
        local real ox
        local real oy
        local real dx
        local real dy
        local integer oid
        local unit tu

        if mode == 1 then
            set ox=LoadReal(hs, GetHandleId(c), LaxusSpells___SH_ORD_X)
            set oy=LoadReal(hs, GetHandleId(c), LaxusSpells___SH_ORD_Y)
            set dx=ox - GetUnitX(c)
            set dy=oy - GetUnitY(c)
            if ( dx * dx + dy * dy ) > 5625.0 then
                set oid=LoadInteger(hs, GetHandleId(c), LaxusSpells___SH_ORD_ID)
                call IssuePointOrderById(c, oid, ox, oy)
                return
            endif
        elseif mode == 2 then
            set tu=LoadUnitHandle(hs, GetHandleId(c), LaxusSpells___SH_ORD_TARGET)
            if tu != null and GetWidgetLife(tu) > 0.405 then
                set oid=LoadInteger(hs, GetHandleId(c), LaxusSpells___SH_ORD_ID)
                call IssueTargetOrderById(c, oid, tu)
                set tu=null
                return
            endif
            set tu=null
        endif

        call SetUnitAnimationByIndex(c, animIndex)
    endfunction

        function s__LaxusSpells___LaxusOrderInit_onInit takes nothing returns nothing
            local trigger tPoint= CreateTrigger()
            local trigger tTarget= CreateTrigger()
            local trigger tImmediate= CreateTrigger()
            local integer i= 0
            loop
                exitwhen i >= 16
                call TriggerRegisterPlayerUnitEvent(tPoint, Player(i), EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER, null)
                call TriggerRegisterPlayerUnitEvent(tTarget, Player(i), EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER, null)
                call TriggerRegisterPlayerUnitEvent(tImmediate, Player(i), EVENT_PLAYER_UNIT_ISSUED_ORDER, null)
                set i=i + 1
            endloop
            call TriggerAddCondition(tPoint, Condition(function LaxusSpells___OnHeroPointOrder))
            call TriggerAddCondition(tTarget, Condition(function LaxusSpells___OnHeroTargetOrder))
            call TriggerAddCondition(tImmediate, Condition(function LaxusSpells___OnHeroImmediateOrder))
        endfunction

    //===========================================================================
    // ТАЙМЕРЫ И МЕНЕДЖМЕНТ
    //===========================================================================
    function LaxusSpells___LaxusTimer03Acquire takes nothing returns nothing
        set LaxusSpells___LaxusTimer03Users=LaxusSpells___LaxusTimer03Users + 1
        if LaxusSpells___LaxusTimer03Users == 1 then
            call TimerStart(LaxusSpells___LaxusTimer03, 0.03, true, LaxusSpells___LaxusTimer03Callback)
        endif
    endfunction

    function LaxusSpells___LaxusTimer03Release takes nothing returns nothing
        set LaxusSpells___LaxusTimer03Users=LaxusSpells___LaxusTimer03Users - 1
        if LaxusSpells___LaxusTimer03Users <= 0 then
            set LaxusSpells___LaxusTimer03Users=0
            call PauseTimer(LaxusSpells___LaxusTimer03)
        endif
    endfunction

    //===========================================================================
    // СИСТЕМА ОБРАТНОЙ ЗАМЕНЫ W2 -> W ПРИ ИСТЕЧЕНИИ 3 СЕКУНД
    //===========================================================================


        function s__LaxusSpells___LaxusW2_Revert_Loop takes nothing returns nothing
            local integer i= 0
            local integer this
            loop
                exitwhen i > s__LaxusSpells___LaxusW2_Revert_m_count
