        // При достижении лимита лечение добавляется к существующему шару.
        // Визуально одновременно остаётся много шаров, но рост ограничен.
        function s__RimuruSpells___RimuruG_KS_FindActive takes unit whichUnit returns integer
            local integer i= 0
            local integer this
            loop
                exitwhen i > s__RimuruSpells___RimuruG_KS_MUI_RimuruG
                set this=s__RimuruSpells___RimuruG_KS_m_RimuruG[i]
                if s__RimuruSpells___RimuruG_KS_c[this] == whichUnit then
                    return this
                endif
                set i=i + 1
            endloop
            return 0
        endfunction

        function s__RimuruSpells___RimuruG_KS_CountActive takes unit whichUnit returns integer
            if whichUnit == null then
