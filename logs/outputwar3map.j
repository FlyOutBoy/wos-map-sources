        function s__AlterSaberSpells__AlterSaberTick_Loop_Loop takes nothing returns nothing
            if AlterSaberSpells__AlterSaberTick_Active[0] then
                call s__AlterSaberSpells__AlterSaberQ_KS_Loop_AlterSaberQ()
            endif
            if AlterSaberSpells__AlterSaberTick_Active[1] then
                call s__AlterSaberSpells__AlterSaberW2_KS_Loop_AlterSaberW2()
            endif
            if AlterSaberSpells__AlterSaberTick_Active[2] then
                call s__AlterSaberSpells__AlterSaberE_KS_Loop_AlterSaberE()
            endif
            if AlterSaberSpells__AlterSaberTick_Active[3] then
                call s__AlterSaberSpells__AlterSaberComboW_KS_Loop_AlterSaberComboW()
            endif
            if AlterSaberSpells__AlterSaberTick_Active[4] then
                call s__AlterSaberSpells__AlterSaberComboE_KS_Loop_AlterSaberComboE()
            endif
            if AlterSaberSpells__AlterSaberTick_Active[5] then
                call s__AlterSaberSpells__AlterSaberR_KS_Loop_AlterSaberR()
            endif
            if AlterSaberSpells__AlterSaberTick_Active[6] then
                call s__AlterSaberSpells__AlterSaberT_KS_Loop_AlterSaberT()
            endif
        endfunction

