    // Возвращает сохранённую живую иллюзию.
    function FrierenSpells__FrierenR_GetIllusion takes unit c returns unit
        local unit illusion= LoadUnitHandle(hs, GetHandleId(c), FrierenSpells__SH_FRIEREN_R_ILLUSION)
        if illusion != null and GetUnitTypeId(illusion) != 0 and GetUnitState(illusion, UNIT_STATE_LIFE) > 0.405 then
            return illusion
        endif
        call RemoveSavedHandle(hs, GetHandleId(c), FrierenSpells__SH_FRIEREN_R_ILLUSION)
        set illusion=null
        return null
    endfunction
