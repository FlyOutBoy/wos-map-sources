        local boolean start2= false
        local real x1= LoadReal(hs, GetHandleId(GetOwningPlayer(c)), ErzaTSpells__SH_FIRE_X)
        local real y1= LoadReal(hs, GetHandleId(GetOwningPlayer(c)), ErzaTSpells__SH_FIRE_Y)
        local real x2= LoadReal(hs, GetHandleId(GetOwningPlayer(c)), ErzaTSpells__SH_WATER_X)
        local real y2= LoadReal(hs, GetHandleId(GetOwningPlayer(c)), ErzaTSpells__SH_WATER_Y)
        local real x3= LoadReal(hs, GetHandleId(GetOwningPlayer(c)), ErzaTSpells__SH_LIGHTNING_X)
        local real y3= LoadReal(hs, GetHandleId(GetOwningPlayer(c)), ErzaTSpells__SH_LIGHTNING_Y)
        if LoadInteger(hs, GetHandleId(c), ErzaTSpells__SH_T_ARMOR_ACTIVE) == 1 then
            call GroupEnumUnitsInRange(g, x, y, 1800, NoDecor_Cond)
            loop
                set u=FirstOfGroup(g)
                exitwhen u == null
                if IsUnitAlly(u, GetOwningPlayer(c)) then
                    if GetUnitTypeId(u) == Gray_ID1 or GetUnitTypeId(u) == Gray_ID2 then
                        set k1=k1 + 1
                    endif
                    if GetUnitTypeId(u) == Natsu_ID then
                        set k2=k2 + 1
                    endif
                    if GetUnitTypeId(u) == Laxus_ID then
                        set k3=k3 + 1
                    endif
                endif
                call GroupRemoveUnit(g, u)
            endloop
            if k1 > 0 and k2 > 0 then // Natsu + Gray, same attach as R form
                if counter1 == 0 and counter2 == 0 then
                    if IntegerCdKey(c , SH_ICD_ELEM_GAIN_CD , 60) then
                        call SaveInteger(hs, GetHandleId(c), ErzaTSpells__SH_ERZA_5_TT, 7)
                        call SaveInteger(hs, GetHandleId(c), ErzaTSpells__SH_ERZA_5_TT2, 7)
                        call s__ErzaTSpells__Erza5TT_KS_ErzaTT_Start(c , 0 , 0)
                    else
                        call DisplayTimedTextToPlayer(GetOwningPlayer(c), 0, 0, 1, "Elemental gain on cooldown")
                    endif
                endif
            elseif k2 > 0 and k3 > 0 then // Natsu + Laxus, same attach as R form
                // Store the pair as regular fire + lightning so every T-form
                // ability creates exactly the same ErzaPassive effects.
                if counter1 == 0 and counter2 == 0 then
                    if IntegerCdKey(c , SH_ICD_ELEM_GAIN_CD , 60) then
                        call SaveInteger(hs, GetHandleId(c), ErzaTSpells__SH_ERZA_5_TT, 1)
                        call SaveInteger(hs, GetHandleId(c), ErzaTSpells__SH_ERZA_5_TT2, 3)
                        call s__ErzaTSpells__Erza5TT_KS_ErzaTT_Start(c , 4 , 4)
                    else
                        call DisplayTimedTextToPlayer(GetOwningPlayer(c), 0, 0, 1, "Elemental gain on cooldown")
                    endif
                endif
            else
                if x1 != 0 and SR3(c , x1 , y1) <= Erza1R_DamageAoe and counter1 != 1 and counter2 != 1 then
                    if counter1 == 0 then
                        set counter1=1
                        set start1=true
                    elseif counter2 == 0 then
                        set counter2=1
                        set start2=true
                    endif
                endif
                if x2 != 0 and SR3(c , x2 , y2) <= Erza2W_Aoe and counter1 != 2 and counter2 != 2 then
                    if counter1 == 0 then
                        set counter1=2
                        set start1=true
                    elseif counter2 == 0 then
                        set counter2=2
                        set start2=true
                    endif
                endif
                if x3 != 0 and SR3(c , x3 , y3) <= Erza3W_Aoe and counter1 != 3 and counter2 != 3 then
                    if counter1 == 0 then
                        set counter1=3
                        set start1=true
                    elseif counter2 == 0 then
                        set counter2=3
                        set start2=true
                    endif
                endif
                if start1 then
                    call SaveInteger(hs, GetHandleId(c), ErzaTSpells__SH_ERZA_5_TT, counter1)
                    call s__ErzaTSpells__Erza5TT_KS_ErzaTT_Start(c , counter1 , 1)
                endif
                if start2 then
                    call SaveInteger(hs, GetHandleId(c), ErzaTSpells__SH_ERZA_5_TT2, counter2)
                    call s__ErzaTSpells__Erza5TT_KS_ErzaTT_Start(c , counter2 , 2)
                endif
            endif
        endif
        call DestroyGroup(g)
        set g=null
        set u=null
    endfunction
    function Erza5F_Start takes unit c,real x,real y returns nothing
        call s__ErzaTSpells__Erza5F_KS_ErzaF_Start(c , x , y)
    endfunction

        function s__ErzaTSpells__ErzaTTick_Loop_Loop takes nothing returns nothing
            if ErzaTSpells__ErzaTTick_Active[0] then
                call s__ErzaTSpells__Erza5Q_KS_Loop_ErzaQ()
            endif
            if ErzaTSpells__ErzaTTick_Active[1] then
                call s__ErzaTSpells__Erza5W_KS_Loop_ErzaW()
            endif
            if ErzaTSpells__ErzaTTick_Active[2] then
                call s__ErzaTSpells__Erza5E_KS_Loop_ErzaE()
            endif
            if ErzaTSpells__ErzaTTick_Active[3] then
                call s__ErzaTSpells__Erza5R2_KS_Loop_ErzaR2()
            endif
            if ErzaTSpells__ErzaTTick_Active[4] then
                call s__ErzaTSpells__Erza5R_KS_Loop_ErzaR()
            endif
            if ErzaTSpells__ErzaTTick_Active[5] then
                call s__ErzaTSpells__Erza5T_KS_Loop_ErzaT()
            endif
            if ErzaTSpells__ErzaTTick_Active[6] then
                call s__ErzaTSpells__Erza5F_KS_Loop_ErzaF()
            endif
        endfunction

        function s__ErzaTSpells__ErzaTTick_Loop_onInit takes nothing returns nothing
            set ErzaTSpells__ErzaTTick_Callback=function s__ErzaTSpells__ErzaTTick_Loop_Loop
        endfunction


        function s__ErzaTSpells__ErzaTTick05_Loop_Loop takes nothing returns nothing
            if ErzaTSpells__ErzaTTick05_Active[0] then
                call s__ErzaTSpells__Erza5TT_KS_Loop_ErzaTT()
            endif
        endfunction

        function s__ErzaTSpells__ErzaTTick05_Loop_onInit takes nothing returns nothing
            set ErzaTSpells__ErzaTTick05_Callback=function s__ErzaTSpells__ErzaTTick05_Loop_Loop
        endfunction


//library ErzaTSpells ends
//library FrierenSpells:
    function FrierenSpells__FrierenCloneCheck takes unit c returns boolean
        return IsUnitIllusion(c) == false and GetUnitTypeId(c) != FrierenTR_unitid
    endfunction
    function FrierenSpells__FrierenQ_UnlockFinisher takes unit c returns nothing
        // Q3 has one object level; do not inherit Q1's learned rank.
        call UnitAddAbility(c, FrierenQ3_ID)
        call UnitMakeAbilityPermanent(c, true, FrierenQ3_ID)
        call SetUnitAbilityLevel(c, FrierenQ3_ID, 1)
        call SaveInteger(hs, GetHandleId(GetOwningPlayer(c)), SH_Frieren_FRIERENQ_ID, 0)
        call SetPlayerAbilityAvailable(GetOwningPlayer(c), FrierenQ2_ID, false)
        call s__GearSystems2___KS_SpellTimer_SpellTimer_Timer_Start((c ) , (( FrierenQ_TimeSwap_Q3 )*1.0) , ( FrierenQ3_ID ) , ( FrierenQ_ID) , 0) // INLINED!!
        call s__GearSystems2___KS_BuffTimer_MyBuffTime_Start((c ) , 0 , (( FrierenQ_TimeSwap_Q3 )*1.0) , ( "BTNHero_Frieren_Q3" ) , ( false ) , - 1 , 1 , 0 , ( 1)) // INLINED!!
    endfunction
    function FrierenSpells__UpdateGIcon takes integer stacks returns nothing
        if stacks >= 10 then
            call BlzSetAbilityIcon(FrierenG_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Frieren_G3.blp")
        elseif stacks >= 5 then
            call BlzSetAbilityIcon(FrierenG_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Frieren_G2.blp")
        else
            call BlzSetAbilityIcon(FrierenG_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Frieren_G.blp")
        endif
    endfunction
    function FrierenF_Stacks takes unit c returns nothing
        local unit f
        local integer stacks
        if GetHeroLevel(c) <= 6 then
            return
        endif
    // Фрирен кастует сама — поиск юнитов не нужен.
        if GetUnitTypeId(c) == Frieren_ID then
            set stacks=S2I(TasAbilityChargeBox_GetValue(c , FrierenF_ID))
            if stacks < 10 then
                set stacks=stacks + 1
                call TasAbilityChargeBox_SetValue(c , FrierenF_ID , I2S(stacks))
                call FrierenSpells__UpdateGIcon(stacks)
                if stacks == 5 or stacks == 10 then
                    call BlzEndUnitAbilityCooldown(c, FrierenG_ID)
                endif
            endif
            return
        endif
        call GroupEnumUnitsInRange(FrierenSpells__FrierenF_Group, GetUnitX(c), GetUnitY(c), 1500.00, null)
        loop
            set f=FirstOfGroup(FrierenSpells__FrierenF_Group)
            exitwhen f == null
            call GroupRemoveUnit(FrierenSpells__FrierenF_Group, f)
            if GetUnitTypeId(f) == Frieren_ID and IsUnitAlly(f, GetOwningPlayer(c)) and GetWidgetLife(f) > 0.405 then
                set stacks=S2I(TasAbilityChargeBox_GetValue(f , FrierenF_ID))
                if stacks < 10 then
                    set stacks=stacks + 1
                    call TasAbilityChargeBox_SetValue(f , FrierenF_ID , I2S(stacks))
                    call FrierenSpells__UpdateGIcon(stacks)
                    if stacks == 5 or stacks == 10 then
                        call BlzEndUnitAbilityCooldown(f, FrierenG_ID)
                    endif
                endif
                set f=null
                return
            endif
        endloop
        set f=null
    endfunction
    function FrierenSpells__FrierenTimer03Acquire takes nothing returns nothing
        set FrierenSpells__FrierenTimer03Users=FrierenSpells__FrierenTimer03Users + 1
        if FrierenSpells__FrierenTimer03Users == 1 then
            call TimerStart(FrierenSpells__FrierenTimer03, 0.03, true, FrierenSpells__FrierenTimer03Callback)
        endif
    endfunction
    function FrierenSpells__FrierenTimer03Release takes nothing returns nothing
        set FrierenSpells__FrierenTimer03Users=FrierenSpells__FrierenTimer03Users - 1
        if FrierenSpells__FrierenTimer03Users <= 0 then
            set FrierenSpells__FrierenTimer03Users=0
            call PauseTimer(FrierenSpells__FrierenTimer03)
        endif
    endfunction
    // Max travel along angle a from (px,py) that keeps the missile within
    // radius R of the real Frieren (hx,hy): clone casts must not reach 2000
    // past the clone itself.
    function FrierenRayLimit takes real px,real py,real a,real hx,real hy,real R returns real
        local real dx= px - hx
        local real dy= py - hy
        local real b= dx * Cos(a) + dy * Sin(a)
        local real c= dx * dx + dy * dy - R * R
        local real d= b * b - c
        if d <= 0.00 then
            return 0.00
        endif
        return RMaxBJ(0.00, RMinBJ(R, - b + SquareRoot(d)))
    endfunction

        function s__FrierenSpells__FrierenSpells_Q_Loop_FrierenQ takes nothing returns nothing
            local integer this
            local integer i= 0
            local real rkek= 0
            loop
                exitwhen i > s__FrierenSpells__FrierenSpells_Q_MUI_FrierenQ
                set this=s__FrierenSpells__FrierenSpells_Q_m_FrierenQ[i]
                if SpellBoolCaster(s__FrierenSpells__FrierenSpells_Q_c[this]) and s__FrierenSpells__FrierenSpells_Q_r[this] <= s__FrierenSpells__FrierenSpells_Q_rmax[this] then
                    set s__FrierenSpells__FrierenSpells_Q_r[this]=I2R(R2I(( s__FrierenSpells__FrierenSpells_Q_r[this] + 0.03 ) * 1000.0 + 0.5)) / 1000.0
                    if s__FrierenSpells__FrierenSpells_Q_check[this] == 0 then
                        call DebugUnit2(s__FrierenSpells__FrierenSpells_Q_c[this])
                        if s__FrierenSpells__FrierenSpells_Q_r[this] == 0.24 then
                            set s__FrierenSpells__FrierenSpells_Q_r5[this]=190
                            set s__FrierenSpells__FrierenSpells_Q_e[this]=EffectSpawn3("war3mapImported\\wos_frieren_sign.mdl" , GetUnitX(s__FrierenSpells__FrierenSpells_Q_c[this]) + s__FrierenSpells__FrierenSpells_Q_r5[this] * Cos(s__FrierenSpells__FrierenSpells_Q_a[this]) , GetUnitY(s__FrierenSpells__FrierenSpells_Q_c[this]) + s__FrierenSpells__FrierenSpells_Q_r5[this] * Sin(s__FrierenSpells__FrierenSpells_Q_a[this]) , s__FrierenSpells__FrierenSpells_Q_a[this] * bj_RADTODEG , 1 , 1 , 160 , - 90)
                            call ScaleEffDummy(s__FrierenSpells__FrierenSpells_Q_e[this] , 0.15 , 0.01 , 1.1)
                        endif
                        if s__FrierenSpells__FrierenSpells_Q_r[this] > 0.33 then
                            if s__FrierenSpells__FrierenSpells_Q_r2[this] > 0.09 then
                                set s__FrierenSpells__FrierenSpells_Q_r2[this]=0
                            else
                                set s__FrierenSpells__FrierenSpells_Q_r2[this]=s__FrierenSpells__FrierenSpells_Q_r2[this] + 0.03
                            endif
                            if s__FrierenSpells__FrierenSpells_Q_r3[this] > 0.15 then
                                set s__FrierenSpells__FrierenSpells_Q_r3[this]=0
                            else
                                set s__FrierenSpells__FrierenSpells_Q_r3[this]=s__FrierenSpells__FrierenSpells_Q_r3[this] + 0.03
                            endif
                        endif
                        call DebugUnit2(s__FrierenSpells__FrierenSpells_Q_c[this])
                        if s__FrierenSpells__FrierenSpells_Q_r[this] == FrierenQ_CastTime then
                            call DestroyEffect(EffectSpawnColor("war3mapimported\\wos_by_wood_bashenan_juqi_2_2.mdl" , GetUnitX(s__FrierenSpells__FrierenSpells_Q_c[this]) + s__FrierenSpells__FrierenSpells_Q_r5[this] * Cos(s__FrierenSpells__FrierenSpells_Q_a[this]) , GetUnitY(s__FrierenSpells__FrierenSpells_Q_c[this]) + s__FrierenSpells__FrierenSpells_Q_r5[this] * Sin(s__FrierenSpells__FrierenSpells_Q_a[this]) , 0 , 1 , 2.5 , 255 , 255 , 255 , 255 , 255))
                        endif
                        if s__FrierenSpells__FrierenSpells_Q_r[this] >= FrierenQ_CastTime then
                            call StopSpellUnit2(s__FrierenSpells__FrierenSpells_Q_c[this])
                            set s__FrierenSpells__FrierenSpells_Q_check[this]=1
                            if FrierenSpells__FrierenCloneCheck(s__FrierenSpells__FrierenSpells_Q_c[this]) then
                                call MakeSound("war3mapimported\\Hero_Frieren_Q1 1")
                            endif
                            set s__FrierenSpells__FrierenSpells_Q_x1[this]=GetUnitX(s__FrierenSpells__FrierenSpells_Q_c[this]) + 150 * Cos(s__FrierenSpells__FrierenSpells_Q_a[this])
                            set s__FrierenSpells__FrierenSpells_Q_y1[this]=GetUnitY(s__FrierenSpells__FrierenSpells_Q_c[this]) + 150 * Sin(s__FrierenSpells__FrierenSpells_Q_a[this])
                            set s__FrierenSpells__FrierenSpells_Q_rmax[this]=( s__FrierenSpells__FrierenSpells_Q_r7[this] / s__FrierenSpells__FrierenSpells_Q_move[this] ) * 0.03
                            set s__FrierenSpells__FrierenSpells_Q_r[this]=0
                            set s__FrierenSpells__FrierenSpells_Q_r2[this]=10
                            set s__FrierenSpells__FrierenSpells_Q_scale[this]=7.25
                            set s__FrierenSpells__FrierenSpells_Q_scale2[this]=1.765
                            set s__FrierenSpells__FrierenSpells_Q_r5[this]=0
                        endif
                    elseif s__FrierenSpells__FrierenSpells_Q_check[this] == 1 then
                        if s__FrierenSpells__FrierenSpells_Q_move[this] >= s__FrierenSpells__FrierenSpells_Q_r7[this] then
                            set s__FrierenSpells__FrierenSpells_Q_r[this]=9999
                            call DestroyEffect(EffectSpawnColor("war3mapimported\\wos_by_wood_bashenan_juqi_2_2.mdl" , s__FrierenSpells__FrierenSpells_Q_x[this] , s__FrierenSpells__FrierenSpells_Q_y[this] , 0 , 1 , 3.5 , 255 , 255 , 255 , 255 , 255))
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_1baozha_90.mdl" , s__FrierenSpells__FrierenSpells_Q_x[this] , s__FrierenSpells__FrierenSpells_Q_y[this] , 1 , 1 , 2.15 , 1))
                            call EffectSpawn2("war3mapimported\\wos_LD2209 (157).mdx" , s__FrierenSpells__FrierenSpells_Q_x[this] , s__FrierenSpells__FrierenSpells_Q_y[this] , GetRandomReal(0, 359) , 1 , 1.8 , 0 , 1)
                            call EffectSpawn2("war3mapimported\\wos_LD2209 (157).mdx" , s__FrierenSpells__FrierenSpells_Q_x[this] , s__FrierenSpells__FrierenSpells_Q_y[this] , GetRandomReal(0, 359) , 1 , 2.2 , 0 , 1)
                            //    call EffectSpawn2("war3mapimported\\wos_kamni.mdx", x, y, GetRandomReal(0, 359), 1.5 , 1.2, 0, 0.35)
                            call DestroyEffect(EffectSpawn("war3mapimported\\wos_T_dustgaraa2.mdx" , s__FrierenSpells__FrierenSpells_Q_x[this] , s__FrierenSpells__FrierenSpells_Q_y[this] , GetRandomReal(0, 359) , 1 , 1.5 , 0))
                            call DestroyEffect(EffectSpawn("war3mapimported\\wos_T_dustgaraa2.mdx" , s__FrierenSpells__FrierenSpells_Q_x[this] , s__FrierenSpells__FrierenSpells_Q_y[this] , GetRandomReal(0, 359) , 1 , 2 , 0))
                            call DestroyEffect(EffectSpawn("war3mapimported\\wos_BY_Wood_Eff_Ord_YeYe_Eat_DiBanZhaKai2.mdx" , s__FrierenSpells__FrierenSpells_Q_x[this] , s__FrierenSpells__FrierenSpells_Q_y[this] , GetRandomReal(0, 359) , 1.5 , 1.35 , 0))
