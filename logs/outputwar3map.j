                            endif
                            call GroupRemoveUnit(s__PatriotSpells___PatriotSpells_T2_g[this], u)
                        endloop
                        call StopSpellUnit(s__PatriotSpells___PatriotSpells_T2_c[this])
                    endif
                endif

                if remove then
                    if s__PatriotSpells___PatriotSpells_T2_e[this] != null then
                        call DestroyEffect(s__PatriotSpells___PatriotSpells_T2_e[this])
                    endif
                    if s__PatriotSpells___PatriotSpells_T2_e2[this] != null then
