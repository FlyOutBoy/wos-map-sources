                            exitwhen s__AinzSpells__AinzW_KS_u[this] == null
                            if SpellBool(s__AinzSpells__AinzW_KS_u[this]) and IsUnitEnemy(s__AinzSpells__AinzW_KS_u[this], GetOwningPlayer(s__AinzSpells__AinzW_KS_c[this])) then
                                if not IsUnitInGroup(s__AinzSpells__AinzW_KS_u[this], s__AinzSpells__AinzW_KS_g2[this]) then
                                    call GroupAddUnit(s__AinzSpells__AinzW_KS_g2[this], s__AinzSpells__AinzW_KS_u[this])
                                    set GearDamageNextSource=('A0FL') // INLINED!!
