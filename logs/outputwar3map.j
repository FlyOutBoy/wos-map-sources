        loop
            exitwhen i > s__GearSystems2___KS_FlushReal_MUI
            set this=s__GearSystems2___KS_FlushReal_m[i]
            if s__GearSystems2___KS_FlushReal_r[this] < s__GearSystems2___KS_FlushReal_rmax[this] then
                set s__GearSystems2___KS_FlushReal_r[this]=I2R(R2I(( s__GearSystems2___KS_FlushReal_r[this] + 0.03 ) * 1000.0 + 0.5)) / 1000.0 // = RoundReal(r + 0.03, 3), r >= 0; no call per instance tick
                if LoadReal(hs, s__GearSystems2___KS_FlushReal_id[this], s__GearSystems2___KS_FlushReal_child_id[this]) == s__GearSystems2___KS_FlushReal_r2[this] then
                    set s__GearSystems2___KS_FlushReal_r[this]=9999
                endif
            else
                if s__GearSystems2___KS_FlushReal_r[this] != 9999 then
                    call SaveReal(hs, s__GearSystems2___KS_FlushReal_id[this], s__GearSystems2___KS_FlushReal_child_id[this], s__GearSystems2___KS_FlushReal_r2[this])
                endif
                if LoadInteger(s__GearSystems2___KS_FlushReal_pending, s__GearSystems2___KS_FlushReal_id[this], s__GearSystems2___KS_FlushReal_child_id[this]) == this then
                    call RemoveSavedInteger(s__GearSystems2___KS_FlushReal_pending, s__GearSystems2___KS_FlushReal_id[this], s__GearSystems2___KS_FlushReal_child_id[this])
                endif
                set s__GearSystems2___KS_FlushReal_m[i]=s__GearSystems2___KS_FlushReal_m[s__GearSystems2___KS_FlushReal_MUI]
                set s__GearSystems2___KS_FlushReal_MUI=s__GearSystems2___KS_FlushReal_MUI - 1
                set i=i - 1 // revisit: the moved instance must not skip this tick
                if s__GearSystems2___KS_FlushReal_MUI == - 1 then
                    call GearTimer03Release()
                endif
                call s__GearSystems2___KS_FlushReal_deallocate(this)
            endif
            set i=i + 1
        endloop
    endfunction

    function s__GearSystems2___KS_FlushReal_Start takes integer NewId,integer NewChild_Id,real NewValue,real NewRmax returns nothing
        local integer this= LoadInteger(s__GearSystems2___KS_FlushReal_pending, NewId, NewChild_Id)
        if this != 0 and s__GearSystems2___KS_FlushReal_r2[this] == NewValue and s__GearSystems2___KS_FlushReal_r[this] != 9999 then
            // Same reset already pending: only an earlier deadline matters.
            if s__GearSystems2___KS_FlushReal_rmax[this] - s__GearSystems2___KS_FlushReal_r[this] > NewRmax then
                set s__GearSystems2___KS_FlushReal_r[this]=0
                set s__GearSystems2___KS_FlushReal_rmax[this]=NewRmax
            endif
            return
        endif
        set this=s__GearSystems2___KS_FlushReal__allocate()
        call SaveInteger(s__GearSystems2___KS_FlushReal_pending, NewId, NewChild_Id, this)
        set s__GearSystems2___KS_FlushReal_MUI=s__GearSystems2___KS_FlushReal_MUI + 1
        set s__GearSystems2___KS_FlushReal_m[s__GearSystems2___KS_FlushReal_MUI]=this
        set s__GearSystems2___KS_FlushReal_r[this]=0
        set s__GearSystems2___KS_FlushReal_rmax[this]=NewRmax
        set s__GearSystems2___KS_FlushReal_id[this]=NewId
        set s__GearSystems2___KS_FlushReal_child_id[this]=NewChild_Id
        set s__GearSystems2___KS_FlushReal_r2[this]=NewValue
        if s__GearSystems2___KS_FlushReal_MUI == 0 then
            call GearTimer03Acquire()
        endif
    endfunction

//===========================================================================
// Р СџРЎС“Р В±Р В»Р С‘РЎвЂЎР Р…РЎвЂ№Р Вµ Р С•Р В±РЎвЂРЎР‚РЎвЂљР С”Р С‘ РІР‚вЂќ Р Р†РЎвЂ№Р В·Р С•Р Р†РЎвЂ№ Р С—Р ВµРЎР‚Р ВµР Р†Р ВµР Т‘Р ВµР Р…РЎвЂ№ Р Р…Р В° Р Р…Р С•Р Р†РЎвЂ№Р Вµ РЎРѓРЎвЂљРЎР‚РЎС“Р С”РЎвЂљРЎС“РЎР‚РЎвЂ№
//===========================================================================
function MyFlush takes integer id,integer childid,integer value,real r returns nothing
    call s__GearSystems2___KS_Flush_Start(id , childid , value , r)
endfunction

function MyAddMana takes unit c,real mana,real r returns nothing
    call s__GearSystems2___KS_AddMana_Start(c , mana , r)
endfunction

function MyFlushBuff takes integer id,integer childid,integer value,unit c,integer buff_id returns nothing
    call s__GearSystems2___KS_FlushBuff_Start(id , childid , value , c , buff_id)
endfunction

function MyFlushReal takes integer id,integer childid,integer value,real r returns nothing
    call s__GearSystems2___KS_FlushReal_Start(id , childid , value , r)
endfunction

    // A pause inside an instant spell event can strand the engine's cast state.
    // One shared one-shot queue runs after that event; stop/end can cancel it.
    function GearCancelSpellPause takes unit c returns boolean
        local integer i= 0
        loop
            exitwhen i >= GearSystems2___GearSpellPauseCount
            if GearSystems2___GearSpellPauseUnits[i] == c then
                set GearSystems2___GearSpellPauseCount=GearSystems2___GearSpellPauseCount - 1
                set GearSystems2___GearSpellPauseUnits[i]=GearSystems2___GearSpellPauseUnits[GearSystems2___GearSpellPauseCount]
                set GearSystems2___GearSpellPauseExtended[i]=GearSystems2___GearSpellPauseExtended[GearSystems2___GearSpellPauseCount]
                set GearSystems2___GearSpellPauseUnits[GearSystems2___GearSpellPauseCount]=null
                if GearSystems2___GearSpellPauseCount == 0 then
                    call PauseTimer(GearSystems2___GearSpellPauseClock)
                endif
                return true
            endif
            set i=i + 1
        endloop
        return false
    endfunction

    function GearSystems2___GearApplySpellPauses takes nothing returns nothing
        local unit c
        local boolean extended
        loop
            exitwhen GearSystems2___GearSpellPauseCount == 0
            set GearSystems2___GearSpellPauseCount=GearSystems2___GearSpellPauseCount - 1
            set c=GearSystems2___GearSpellPauseUnits[GearSystems2___GearSpellPauseCount]
            set extended=GearSystems2___GearSpellPauseExtended[GearSystems2___GearSpellPauseCount]
            set GearSystems2___GearSpellPauseUnits[GearSystems2___GearSpellPauseCount]=null
            if c != null and GetUnitTypeId(c) != 0 and not IsUnitType(c, UNIT_TYPE_DEAD) then
                if extended then
                    call SaveInteger(hs, GetHandleId(c), GearSystems2___SH_SPELL_EX_PAUSE_OWNERS, LoadInteger(hs, GetHandleId(c), GearSystems2___SH_SPELL_EX_PAUSE_OWNERS) + 1)
                    call BlzPauseUnitEx(c, true)
                else
                    call PauseUnit(c, true)
                endif
            endif
        endloop
        set c=null
    endfunction

    function GearPauseSpellStart takes unit c,boolean extended returns nothing
        local integer i= 0
        local eventid castEventId= GetTriggerEventId()
        if c == null then
            return
        endif
        if castEventId == EVENT_PLAYER_UNIT_SPELL_EFFECT or castEventId == EVENT_PLAYER_UNIT_SPELL_CAST or castEventId == EVENT_PLAYER_UNIT_SPELL_CHANNEL or castEventId == EVENT_UNIT_SPELL_EFFECT or castEventId == EVENT_UNIT_SPELL_CAST or castEventId == EVENT_UNIT_SPELL_CHANNEL then
            loop
                exitwhen i >= GearSystems2___GearSpellPauseCount
                if GearSystems2___GearSpellPauseUnits[i] == c then
                    // Same-frame start/debug calls must not stack native stuns.
                    set GearSystems2___GearSpellPauseExtended[i]=extended
                    return
                endif
                set i=i + 1
            endloop
            set GearSystems2___GearSpellPauseUnits[GearSystems2___GearSpellPauseCount]=c
            set GearSystems2___GearSpellPauseExtended[GearSystems2___GearSpellPauseCount]=extended
            set GearSystems2___GearSpellPauseCount=GearSystems2___GearSpellPauseCount + 1
            if GearSystems2___GearSpellPauseCount == 1 then
                call TimerStart(GearSystems2___GearSpellPauseClock, 0.01, false, function GearSystems2___GearApplySpellPauses)
            endif
        else
            call GearCancelSpellPause(c)
            if extended then
                call SaveInteger(hs, GetHandleId(c), GearSystems2___SH_SPELL_EX_PAUSE_OWNERS, LoadInteger(hs, GetHandleId(c), GearSystems2___SH_SPELL_EX_PAUSE_OWNERS) + 1)
                call BlzPauseUnitEx(c, true)
            else
                call PauseUnit(c, true)
            endif
        endif
        set castEventId=null
    endfunction

    function GearStopSpellPause takes unit c,boolean extended returns nothing
        local boolean pending= GearCancelSpellPause(c)
        local integer owners
        if extended then
            if not pending then
                set owners=LoadInteger(hs, GetHandleId(c), GearSystems2___SH_SPELL_EX_PAUSE_OWNERS)
                if owners > 0 then
                    call SaveInteger(hs, GetHandleId(c), GearSystems2___SH_SPELL_EX_PAUSE_OWNERS, owners - 1)
                    call BlzPauseUnitEx(c, false)
                endif
            endif
        else
            call PauseUnit(c, false)
        endif
    endfunction

    // Ordinary Channel casts pause before their animation is selected.
    // Only Ice Coffin uses the deferred instant-event queue above.
    function GearPauseSpellImmediate takes unit c,boolean extended returns nothing
        call GearCancelSpellPause(c)
        if extended then
            call SaveInteger(hs, GetHandleId(c), GearSystems2___SH_SPELL_EX_PAUSE_OWNERS, LoadInteger(hs, GetHandleId(c), GearSystems2___SH_SPELL_EX_PAUSE_OWNERS) + 1)
            call BlzPauseUnitEx(c, true)
        else
            call PauseUnit(c, true)
        endif
    endfunction

    function StartSpellUnit takes unit c returns nothing
        call IssueImmediateOrder(c, "stop")
        call SetUnitTimeScale(c, 1)
        call UnitAddAbility(c, 'Avul')
        call GearPauseSpellImmediate(c , false)
    endfunction
    function StartSpellUnit2 takes unit c returns nothing
        call IssueImmediateOrder(c, "stop")
        call SetUnitTimeScale(c, 1)
        call GearPauseSpellImmediate(c , false)
    endfunction
    function StartSpellUnit2_2 takes unit c returns nothing
        call IssueImmediateOrder(c, "stop")
        call SetUnitTimeScale(c, 1)
        call GearPauseSpellImmediate(c , true)
    endfunction
    // After a hero's spell the owner keeps only that hero selected (summons, clicked
    // targets and other units leave the selection). Untouched when already sole.
    function GearSelectOnlyHero takes unit c returns nothing
        local integer pid= GetPlayerId(GetOwningPlayer(c))
        local unit u
        local boolean other= false
        if pid >= 10 or Hero[pid] != c or c == null then
            return
        endif
        if GetLocalPlayer() == Player(pid) then
            call GroupEnumUnitsSelected(GearSelectScan, Player(pid), null)
            loop
                set u=FirstOfGroup(GearSelectScan)
                exitwhen u == null
                call GroupRemoveUnit(GearSelectScan, u)
                if u != c then
                    set other=true
                endif
            endloop
            if other or not IsUnitSelected(c, Player(pid)) then
                call ClearSelection()
                call SelectUnit(c, true)
            endif
        endif
        set u=null
    endfunction
    function StopSpellUnit takes unit c returns nothing
        call IssueImmediateOrder(c, "stop")
        call SetUnitTimeScale(c, 1)
        call UnitRemoveAbility(c, 'Avul')
        call GearStopSpellPause(c , false)
        call SaveInteger(hs, GetHandleId(GetOwningPlayer(c)), GearSystems2___SH_AHK_PIDOR, 1)
        call s__GearSystems2___KS_Flush_Start((GetHandleId(GetOwningPlayer(c)) ) , ( GearSystems2___SH_AHK_PIDOR ) , ( 0 ) , (( ahk_delay)*1.0)) // INLINED!!
        call GearSelectOnlyHero(c)
    endfunction
    function StopSpellUnit2 takes unit c returns nothing
        call IssueImmediateOrder(c, "stop")
        call SetUnitTimeScale(c, 1)
        call GearStopSpellPause(c , false)
        call SaveInteger(hs, GetHandleId(GetOwningPlayer(c)), GearSystems2___SH_AHK_PIDOR, 1)
        call s__GearSystems2___KS_Flush_Start((GetHandleId(GetOwningPlayer(c)) ) , ( GearSystems2___SH_AHK_PIDOR ) , ( 0 ) , (( ahk_delay)*1.0)) // INLINED!!
        call GearSelectOnlyHero(c)
    endfunction
    function StopSpellUnit2_2 takes unit c returns nothing
        call IssueImmediateOrder(c, "stop")
        call SetUnitTimeScale(c, 1)
        call GearStopSpellPause(c , true)
        call SaveInteger(hs, GetHandleId(GetOwningPlayer(c)), GearSystems2___SH_AHK_PIDOR, 1)
        call s__GearSystems2___KS_Flush_Start((GetHandleId(GetOwningPlayer(c)) ) , ( GearSystems2___SH_AHK_PIDOR ) , ( 0 ) , (( ahk_delay)*1.0)) // INLINED!!
        call GearSelectOnlyHero(c)
    endfunction
    // For queued instant buttons: preserve the order through their scripted windup.
    function StartSpellUnitQueued takes unit c,boolean invulnerable returns nothing
        call SetUnitTimeScale(c, 1)
        if invulnerable then
            call UnitAddAbility(c, 'Avul')
        endif
        call GearPauseSpellStart(c , false)
    endfunction
    function StopSpellUnitQueued takes unit c,boolean invulnerable returns nothing
        call SetUnitTimeScale(c, 1)
        if invulnerable then
            call UnitRemoveAbility(c, 'Avul')
        endif
        call GearStopSpellPause(c , false)
        call SaveInteger(hs, GetHandleId(GetOwningPlayer(c)), GearSystems2___SH_AHK_PIDOR, 1)
        call s__GearSystems2___KS_Flush_Start((GetHandleId(GetOwningPlayer(c)) ) , ( GearSystems2___SH_AHK_PIDOR ) , ( 0 ) , (( ahk_delay)*1.0)) // INLINED!!
        call GearSelectOnlyHero(c)
    endfunction

    function SpeedToLevel takes real r returns integer
    local real min= 0.05
    local real step= 0.05
    local integer lvl
    if r <= min then
        return 1
    endif
    if r >= 1.0 then
        return 20
    endif
    set lvl=R2I(( r - min ) / step) + 1
    if lvl < 1 then
        set lvl=1
    elseif lvl > 20 then
        set lvl=20
    endif
    return lvl
endfunction
    function BuffUnitMS takes unit c,unit u,real speed returns nothing
        local integer i= GetPlayerId(GetOwningPlayer(c))
        local integer level= SpeedToLevel(speed)
        if DummyPlayer[i] == null or GetWidgetLife(DummyPlayer[i]) < 1 then
            set DummyPlayer[i]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'h0C9', GetRectCenterX(gg_rct_Caster), GetRectCenterY(gg_rct_Caster), 0)
            call UnitAddAbility(DummyPlayer[i], 'A00D')
        endif
        if level > 0 then
            if GetUnitAbilityLevel(DummyPlayer[i], 'A00D') == 0 then
                call UnitAddAbility(DummyPlayer[i], 'A00D')
            endif
            call SetUnitAbilityLevel(DummyPlayer[i], 'A00D', level)
            call SetUnitFacing(DummyPlayer[i], GAngle(DummyPlayer[i] , u) * bj_RADTODEG)
            call IssueTargetOrder(DummyPlayer[i], "bloodlust", u)
        endif
    endfunction
    // One-shot numeric attribution. Consumed even when the target is invalid.
    function DamageSource takes integer sourceId returns nothing
        set GearDamageNextSource=sourceId
    endfunction
    // Separate Damage Stats row for a morph/combo form of one ability. Call on cast, not per hit.
    // Variant 0 is the ability itself; keys lie above every rawcode, so gameplay checks
    // against ability ids (A000..Azzz) never match them.
    function DamageSourceVariant takes integer baseId,integer variant,string caption returns integer
        local integer key
        if variant <= 0 then
            return baseId
        endif
        set key=LoadInteger(GearDamageVariants, baseId, variant)
        if key == 0 then
            set GearDamageVariantCount=GearDamageVariantCount + 1
            set key=2100000000 + GearDamageVariantCount
            call SaveInteger(GearDamageVariants, baseId, variant, key)
            call SaveInteger(GearDamageVariants, key, 0, baseId)
            call SaveStr(GearDamageVariants, key, 1, caption)
        endif
        return key
    endfunction
    // Ability behind a Damage Stats instance (gameplay hooks compare ability ids).
    function DamageSourceBase takes integer sourceId returns integer
        if sourceId > 2100000000 then
            return LoadInteger(GearDamageVariants, sourceId, 0)
        endif
        return sourceId
    endfunction
    // Spell structs with a mode field (0 base, 1 morph, 2 morph + T): one lookup, no strings built.
    function DamageSourceMode takes integer baseId,integer mode,string caption1,string caption2 returns integer
        if mode == 1 then
            return DamageSourceVariant(baseId , 1 , caption1)
        elseif mode == 2 then
            return DamageSourceVariant(baseId , 2 , caption2)
        endif
        return baseId
    endfunction
    // Element/poison follow-ups must never feed the offensive item-proc chain.
    // Numeric attribution survives NextDmg and periodic instances, unlike a synchronous flag.
    function ItemDamageCanProc takes integer sourceId returns boolean
        set sourceId=DamageSourceBase(sourceId)
        return not ( sourceId <= - 101 and sourceId >= - 111 ) and sourceId != 'I00W' and sourceId != 'I04C' and sourceId != 'I03Y' and sourceId != 'I02H'
    endfunction
    // Same-hit flat amplification is safe for elemental ticks; it schedules no new hit.
    function ItemDamageCanReceiveQuincy takes integer sourceId returns boolean
        return true // Same-hit amplification accepts every damage source, including item ticks/reflections.
    endfunction
    function dmgmag takes unit c,unit td,real dmg returns nothing
        local integer previousSource= GearDamageActiveSource
        set GearDamageActiveSource=GearDamageNextSource
        set GearDamageNextSource=0
    if c != null and td != null and GetWidgetLife(td) > 0.405 then
    call UnitDamageTarget(c, td, dmg, false, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_NORMAL, null)
    endif
        set GearDamageActiveSource=previousSource
    endfunction
    function dmgmag2 takes unit c,unit td,real dmg,string s returns nothing
        local integer previousSource= GearDamageActiveSource
        set GearDamageActiveSource=GearDamageNextSource
        set GearDamageNextSource=0
    if c != null and td != null and GetWidgetLife(td) > 0.405 then
    if s == "kurikara" then
    set KurikaraTrigger=true
    endif
    call UnitDamageTarget(c, td, dmg, false, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_NORMAL, null)
    if s == "kurikara" then
    set KurikaraTrigger=false
    endif
    endif
        set GearDamageActiveSource=previousSource
    endfunction
    function dmgphys takes unit c,unit td,real dmg returns nothing
        local integer previousSource= GearDamageActiveSource
        set GearDamageActiveSource=GearDamageNextSource
        set GearDamageNextSource=0
    if c != null and td != null and GetWidgetLife(td) > 0.405 then
    call UnitDamageTarget(c, td, dmg, false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_FIRE, null)
    endif
        set GearDamageActiveSource=previousSource
    endfunction
    function dmgphysattack takes unit c,unit td,real dmg returns nothing
        local integer previousSource= GearDamageActiveSource
        local boolean previousFollowup= GearDamageAttackFollowup
        set GearDamageActiveSource=GearDamageNextSource
        set GearDamageNextSource=0
        set GearDamageAttackFollowup=true
        if c != null and td != null and GetWidgetLife(td) > 0.405 then
            call UnitDamageTarget(c, td, dmg, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_FIRE, null)
        endif
        set GearDamageAttackFollowup=previousFollowup
        set GearDamageActiveSource=previousSource
    endfunction
    function dmgatk takes unit c,unit td,real dmg returns nothing
        local integer previousSource= GearDamageActiveSource
        set GearDamageActiveSource=GearDamageNextSource
        set GearDamageNextSource=0
    if c != null and td != null and GetWidgetLife(td) > 0.405 then
    call UnitDamageTarget(c, td, dmg, true, false, ATTACK_TYPE_MELEE, DAMAGE_TYPE_NORMAL, null)
    endif
        set GearDamageActiveSource=previousSource
    endfunction
    function spelldmg takes unit c,unit td,real dmg returns nothing
        local integer previousSource= GearDamageActiveSource
        set GearDamageActiveSource=GearDamageNextSource
        set GearDamageNextSource=0
        if c != null and td != null and GetWidgetLife(td) > 0.405 then
        call UnitDamageTarget(c, td, dmg, false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_UNIVERSAL, null)
   endif
        set GearDamageActiveSource=previousSource
   endfunction
    function PathableCheck takes real x,real y returns boolean
        return CheckCoordsInRect(gg_rct_Arena , x , y)
    endfunction
    function PathableCheck3 takes real x,real y returns boolean
        return CheckCoordsInRect(gg_rct_Arena , x , y)
    endfunction
    function PathableCheck2 takes real x,real y returns boolean
        return true
    endfunction
    function MoveUnit takes unit c,real sr,real a returns nothing
    local real startX
    local real startY
    local real move=sr
    local real targetX
    local real targetY

    if c == null or move == 0 or (LoadInteger(hs, GetHandleId((c)), GearSystems2___SH_CC_PROTECTION_OWNERS) > 0) then // INLINED!!
        return
    endif

    set startX=GetUnitX(c)
    set startY=GetUnitY(c)

    
    
    

    set targetX=startX + move * Cos(a)
    set targetY=startY + move * Sin(a)

    if (CheckCoordsInRect(gg_rct_Arena , ((targetX )*1.0) , (( targetY)*1.0))) then // INLINED!!
        call SetUnitX(c, targetX)
        call SetUnitY(c, targetY)
    endif
endfunction
function MoveUnit3 takes unit c,real sr,real a returns nothing
    local real startX
    local real startY
    local real move
    local real targetX
    local real targetY

    if c == null or (LoadInteger(hs, GetHandleId((c)), GearSystems2___SH_CC_PROTECTION_OWNERS) > 0) then // INLINED!!
        return
    endif

    set startX=GetUnitX(c)
    set startY=GetUnitY(c)

    
    set move=sc__UnitMoveWall_GetMoveDistance(c , startX , startY , a , sr)

    if move <= 0.00 then
        return
    endif

    set targetX=startX + move * Cos(a)
    set targetY=startY + move * Sin(a)

    if (CheckCoordsInRect(gg_rct_Arena , ((targetX )*1.0) , (( targetY)*1.0))) then // INLINED!!
        call SetUnitX(c, targetX)
        call SetUnitY(c, targetY)
    endif
endfunction
    // Getter is based on index 0 and 1
// Setter is based on index 1 and 2
// WHY BLIZZARD WHYYYYY
function SetUnitRange takes unit u,real newRange returns nothing
        call BlzSetUnitWeaponRealField(u, UNIT_WEAPON_RF_ATTACK_RANGE, 1, newRange - BlzGetUnitWeaponRealField(u, UNIT_WEAPON_RF_ATTACK_RANGE, 0) + BlzGetUnitWeaponRealField(u, UNIT_WEAPON_RF_ATTACK_RANGE, 1))
endfunction
 
// Setting small AoE range for a unit also sets its attack cooldown and the range at index 1...
// Why ? I don't know. Here's a fix.
// Must test with the other types of AoE and indexes
function SetUnitAoESmall takes unit u,integer index,real newAoE returns nothing
    local real r=BlzGetUnitAttackCooldown(u, index)
    local real r2=BlzGetUnitWeaponRealField(u, UNIT_WEAPON_RF_ATTACK_RANGE, 0)
    call BlzSetUnitWeaponRealField(u, UNIT_WEAPON_RF_ATTACK_AREA_OF_EFFECT_SMALL_DAMAGE, index, newAoE)
    call BlzSetUnitAttackCooldown(u, r, index)
    call SetUnitRange(u , r2)
endfunction
    function PosUnit takes unit c,real x,real y returns nothing
    local integer k= 0
    local integer steps
    local real angle
    local real distance
    local real step
    local real oldX
    local real oldY

    if c == null then
        return
    endif

    set angle=GAngle2(c , x , y)
    set distance=SR3(c , x , y)

    if distance < 300.00 then
        set steps=5
    elseif distance < 800.00 then
        set steps=10
    else
        set steps=20
    endif

    set step=distance / I2R(steps)

    loop
        exitwhen k >= steps

        set oldX=GetUnitX(c)
        set oldY=GetUnitY(c)

        call MoveUnit(c , step , angle)

        
        if GetUnitX(c) == oldX and GetUnitY(c) == oldY then
            return
        endif

        set k=k + 1
    endloop
endfunction
    function MoveEff takes effect e,real sr,real a returns nothing
        if (CheckCoordsInRect(gg_rct_Arena , (((BlzGetLocalSpecialEffectX((e))) + sr * Cos(a) )*1.0) , (( (BlzGetLocalSpecialEffectY((e))) + sr * Sin(a))*1.0))) then // INLINED!!
            call BlzSetSpecialEffectPosition(e, (BlzGetLocalSpecialEffectX((e))) + sr * Cos(a), (BlzGetLocalSpecialEffectY((e))) + sr * Sin(a), BlzGetLocalSpecialEffectZ(e)) // INLINED!!
        endif
    endfunction
    function MoveUnit2 takes unit c,real sr,real a returns nothing
        call SetUnitX(c, GetUnitX(c) + sr * Cos(a))
        call SetUnitY(c, GetUnitY(c) + sr * Sin(a))
       endfunction



    function s__UnitMoveWall_Add takes integer id,real x,real y,real angle,real length,real curve,real offset,real radius,real checkStep returns nothing

        if not s__UnitMoveWall_active[id] then
            set s__UnitMoveWall_count=s__UnitMoveWall_count + 1
            set s__UnitMoveWall_walls[s__UnitMoveWall_count]=id
            set s__UnitMoveWall_slot[id]=s__UnitMoveWall_count
            set s__UnitMoveWall_active[id]=true
        endif

        set s__UnitMoveWall_wallX[id]=x
        set s__UnitMoveWall_wallY[id]=y
        set s__UnitMoveWall_wallAngle[id]=angle
        set s__UnitMoveWall_wallLength[id]=length
        set s__UnitMoveWall_wallCurve[id]=curve
        set s__UnitMoveWall_wallOffset[id]=offset
        set s__UnitMoveWall_wallRadius[id]=radius
        set s__UnitMoveWall_wallCheckStep[id]=checkStep
    endfunction

    function s__UnitMoveWall_Remove takes integer id returns nothing
        local integer index
        local integer last

        if not s__UnitMoveWall_active[id] then
            return
        endif

        set index=s__UnitMoveWall_slot[id]
        set last=s__UnitMoveWall_walls[s__UnitMoveWall_count]

        set s__UnitMoveWall_walls[index]=last
        set s__UnitMoveWall_slot[last]=index

        set s__UnitMoveWall_walls[s__UnitMoveWall_count]=0
        set s__UnitMoveWall_slot[id]=0
        set s__UnitMoveWall_active[id]=false

        set s__UnitMoveWall_wallX[id]=0.00
        set s__UnitMoveWall_wallY[id]=0.00
        set s__UnitMoveWall_wallAngle[id]=0.00
        set s__UnitMoveWall_wallLength[id]=0.00
        set s__UnitMoveWall_wallCurve[id]=0.00
        set s__UnitMoveWall_wallOffset[id]=0.00
        set s__UnitMoveWall_wallRadius[id]=0.00
        set s__UnitMoveWall_wallCheckStep[id]=0.00

        set s__UnitMoveWall_count=s__UnitMoveWall_count - 1
    endfunction
        function s__UnitMoveWall_GetMoveDistance takes unit u,real startX,real startY,real angle,real wanted returns real

        local integer i= 0
        local integer id

        local real test
        local real step
        local real px
        local real py
        local real dx
        local real dy

        local real lengthAngle
        local real localLength
        local real localWidth
        local real halfLength
        local real normalized
        local real curveOffset
        local real difference
        local real collisionRadius
        local real closest= wanted

        if u == null or wanted <= 0.00 then
            return 0.00
        endif

        loop
            exitwhen i > s__UnitMoveWall_count

            set id=s__UnitMoveWall_walls[i]
            set halfLength=s__UnitMoveWall_wallLength[id] * 0.50
            set step=s__UnitMoveWall_wallCheckStep[id]

            if step <= 0.00 then
                set step=16.00
            endif

            
            set collisionRadius=s__UnitMoveWall_wallRadius[id] + BlzGetUnitCollisionSize(u)

            set lengthAngle=s__UnitMoveWall_wallAngle[id] + bj_PI * 0.50
            set test=step

            loop
                exitwhen test > closest

                set px=startX + test * Cos(angle)
                set py=startY + test * Sin(angle)

                set dx=px - s__UnitMoveWall_wallX[id]
                set dy=py - s__UnitMoveWall_wallY[id]

                
                set localLength=dx * Cos(lengthAngle) + dy * Sin(lengthAngle)

                if localLength >= - halfLength - collisionRadius and localLength <= halfLength + collisionRadius then

                    
                    set localWidth=dx * Cos(s__UnitMoveWall_wallAngle[id]) + dy * Sin(s__UnitMoveWall_wallAngle[id])

                    set normalized=localLength / halfLength

                    set curveOffset=s__UnitMoveWall_wallOffset[id] - s__UnitMoveWall_wallCurve[id] * normalized * normalized

                    set difference=localWidth - curveOffset

                    if difference < 0.00 then
                        set difference=- difference
                    endif

                    if difference <= collisionRadius then
                        
                        set closest=test - step

                        if closest < 0.00 then
                            set closest=0.00
                        endif
                    endif
                endif

                set test=test + step
            endloop

            set i=i + 1
        endloop

        return closest
    endfunction
    function MoveEff2 takes effect e,real sr,real a returns nothing
        call BlzSetSpecialEffectPosition(e, (BlzGetLocalSpecialEffectX((e))) + sr * Cos(a), (BlzGetLocalSpecialEffectY((e))) + sr * Sin(a), BlzGetLocalSpecialEffectZ(e)) // INLINED!!
    endfunction
    
    function SetFly takes unit c,real fly returns nothing
    
        if GetUnitAbilityLevel(c, 'Arav') == 0 then
            call UnitAddAbility(c, 'Arav')
            call SetUnitFlyHeight(c, fly, 0)
            call UnitRemoveAbility(c, 'Arav')
        else
            call SetUnitFlyHeight(c, fly, 0)
        endif
    endfunction
    function SetFlyInit takes unit c returns nothing
     
            call UnitAddAbility(c, 'Arav')
            call UnitRemoveAbility(c, 'Arav')
            
            call SetUnitFlyHeight(c, 9999, 0)
            call SetUnitFlyHeight(c, 0, 0)
    endfunction
       

