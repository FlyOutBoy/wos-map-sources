    function BarraganSpells__BarraganTick05_On takes integer k returns nothing
        if not BarraganSpells__BarraganTick05_Active[k] then
            set BarraganSpells__BarraganTick05_Active[k]=true
            set BarraganSpells__BarraganTick05_Users=BarraganSpells__BarraganTick05_Users + 1
            if BarraganSpells__BarraganTick05_Users == 1 then
                call TimerStart(BarraganSpells__BarraganTick05_Timer, 0.05, true, BarraganSpells__BarraganTick05_Callback)
            endif
        endif
    endfunction

    function BarraganSpells__BarraganTick05_Off takes integer k returns nothing
        if BarraganSpells__BarraganTick05_Active[k] then
            set BarraganSpells__BarraganTick05_Active[k]=false
            set BarraganSpells__BarraganTick05_Users=BarraganSpells__BarraganTick05_Users - 1
            if BarraganSpells__BarraganTick05_Users <= 0 then
                set BarraganSpells__BarraganTick05_Users=0
                call PauseTimer(BarraganSpells__BarraganTick05_Timer)
            endif
        endif
    endfunction


    function BarraganSpells__BarraganTick_On takes integer k returns nothing
        if not BarraganSpells__BarraganTick_Active[k] then
            set BarraganSpells__BarraganTick_Active[k]=true
            set BarraganSpells__BarraganTick_Users=BarraganSpells__BarraganTick_Users + 1
            if BarraganSpells__BarraganTick_Users == 1 then
                call TimerStart(BarraganSpells__BarraganTick_Timer, 0.03, true, BarraganSpells__BarraganTick_Callback)
            endif
        endif
    endfunction

    function BarraganSpells__BarraganTick_Off takes integer k returns nothing
        if BarraganSpells__BarraganTick_Active[k] then
            set BarraganSpells__BarraganTick_Active[k]=false
            set BarraganSpells__BarraganTick_Users=BarraganSpells__BarraganTick_Users - 1
            if BarraganSpells__BarraganTick_Users <= 0 then
                set BarraganSpells__BarraganTick_Users=0
                call PauseTimer(BarraganSpells__BarraganTick_Timer)
            endif
        endif
    endfunction

    function BarraganPassiveBurn takes unit c,unit td returns nothing
    local real dmg= 0
    if GetHeroLevel(c) >= 35 then
    set dmg=BarraganG_Damage2Static_35
    elseif GetHeroLevel(c) >= 25 then
    set dmg=BarraganG_Damage2Static_25
    else
    set dmg=BarraganG_Damage2Static_6
    endif
    set dmg=dmg + ( GetHeroInt(c, true) * BarraganG_DamageIntBase )
        set GearDamageNextSource=('A0B8') // INLINED!!
        call s__GearSystems2___KS_DamageOverTime_DmgPTime_Start((c ) , ( td ) , (( dmg )*1.0) , (( BarraganG_DamageDuration )*1.0) , (( BarraganG_DamagePeriodic )*1.0) , ( 1) , "") // INLINED!!
        call EffectSpawnTarget("war3mapImported\\wos_zz-fire-ore-hit1-zihei_2.mdx" , td , "origin" , GetRandomReal(0, 359) , 1.15 , 2 , 0 , BarraganG_DamageDuration)
    endfunction
    
    // Invulnerability: this spell contains a StartSpellUnit/Avul phase.


        function s__BarraganSpells__HeroSpells_Q_Loop_BarraganQ takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__BarraganSpells__HeroSpells_Q_MUI_BarraganQ
                set this=s__BarraganSpells__HeroSpells_Q_m_BarraganQ[i]
                if SpellBoolCaster(s__BarraganSpells__HeroSpells_Q_c[this]) and s__BarraganSpells__HeroSpells_Q_r[this] <= s__BarraganSpells__HeroSpells_Q_rmax[this] then
                    set s__BarraganSpells__HeroSpells_Q_r[this]=s__BarraganSpells__HeroSpells_Q_r[this] + 0.03
                    if s__BarraganSpells__HeroSpells_Q_k2[this] == 0 then // 0 - normal spell, 1 - morph spell, 2( only for q) enchaned with T morph spell
                        if s__BarraganSpells__HeroSpells_Q_check[this] == 0 then
                            if s__BarraganSpells__HeroSpells_Q_r[this] >= BarraganQ_CastTime then
                                call StopSpellUnit2(s__BarraganSpells__HeroSpells_Q_c[this])
                                call DestroyEffect(s__BarraganSpells__HeroSpells_Q_e2[this])
                                set s__BarraganSpells__HeroSpells_Q_check[this]=1
                                call MakeSound("war3mapimported\\Hero_Barragan_Q2")
                                set s__BarraganSpells__HeroSpells_Q_x1[this]=( GetUnitX(s__BarraganSpells__HeroSpells_Q_c[this]) + 20 * Cos(s__BarraganSpells__HeroSpells_Q_a[this] + 90 * bj_DEGTORAD) ) + 79 * Cos(s__BarraganSpells__HeroSpells_Q_a[this])
                                set s__BarraganSpells__HeroSpells_Q_y1[this]=( GetUnitY(s__BarraganSpells__HeroSpells_Q_c[this]) + 20 * Sin(s__BarraganSpells__HeroSpells_Q_a[this] + 90 * bj_DEGTORAD) ) + 79 * Sin(s__BarraganSpells__HeroSpells_Q_a[this])
                                set s__BarraganSpells__HeroSpells_Q_move[this]=0
                                set s__BarraganSpells__HeroSpells_Q_scale[this]=0.5
                                set s__BarraganSpells__HeroSpells_Q_rmax[this]=1.5
                                set s__BarraganSpells__HeroSpells_Q_r[this]=0
                                set s__BarraganSpells__HeroSpells_Q_r7[this]=0
                            endif
                        elseif s__BarraganSpells__HeroSpells_Q_check[this] == 1 then
                           
                            set s__BarraganSpells__HeroSpells_Q_k[this]=0
                            loop
                                exitwhen s__BarraganSpells__HeroSpells_Q_k[this] > 1
                                if s__BarraganSpells__HeroSpells_Q_r[this] < 0.09 then
                                    set s__BarraganSpells__HeroSpells_Q_move[this]=s__BarraganSpells__HeroSpells_Q_move[this] + 9 + ( s__BarraganSpells__HeroSpells_Q_scale[this] * 8 )
                                else
                                    set s__BarraganSpells__HeroSpells_Q_move[this]=s__BarraganSpells__HeroSpells_Q_move[this] + 18 + ( s__BarraganSpells__HeroSpells_Q_scale[this] * 9 )
                                endif
                                if (CheckCoordsInRect(gg_rct_Arena , ((s__BarraganSpells__HeroSpells_Q_x1[this] + s__BarraganSpells__HeroSpells_Q_move[this] * Cos(s__BarraganSpells__HeroSpells_Q_a[this]) )*1.0) , (( s__BarraganSpells__HeroSpells_Q_y1[this] + s__BarraganSpells__HeroSpells_Q_move[this] * Sin(s__BarraganSpells__HeroSpells_Q_a[this]))*1.0))) then // INLINED!!
                                    set s__BarraganSpells__HeroSpells_Q_x[this]=s__BarraganSpells__HeroSpells_Q_x1[this] + s__BarraganSpells__HeroSpells_Q_move[this] * Cos(s__BarraganSpells__HeroSpells_Q_a[this])
                                    set s__BarraganSpells__HeroSpells_Q_y[this]=s__BarraganSpells__HeroSpells_Q_y1[this] + s__BarraganSpells__HeroSpells_Q_move[this] * Sin(s__BarraganSpells__HeroSpells_Q_a[this])
                                endif
                                call EffectSpawnColor2("war3mapimported\\wos_ulqashar.mdx" , s__BarraganSpells__HeroSpells_Q_x[this] , s__BarraganSpells__HeroSpells_Q_y[this] , s__BarraganSpells__HeroSpells_Q_a[this] * bj_RADTODEG , 1 , s__BarraganSpells__HeroSpells_Q_scale[this] , 180 + s__BarraganSpells__HeroSpells_Q_r[this] * 80 , 0.51 , 255 , 25 , 25 , 255)
                                call EffectSpawnColor2("war3mapimported\\wos_ulqashar.mdx" , s__BarraganSpells__HeroSpells_Q_x[this] , s__BarraganSpells__HeroSpells_Q_y[this] , s__BarraganSpells__HeroSpells_Q_a[this] * bj_RADTODEG , 1 , s__BarraganSpells__HeroSpells_Q_scale[this] * 0.7 , 180 + s__BarraganSpells__HeroSpells_Q_r[this] * 80 , 0.45 , 225 , 225 , 225 , 205)
                                
                                set s__BarraganSpells__HeroSpells_Q_scale[this]=s__BarraganSpells__HeroSpells_Q_scale[this] + 0.3
