            loop
                exitwhen i > s__AinzSpells__AinzW_KS_MUI_AinzW2
                set this=s__AinzSpells__AinzW_KS_m_AinzW2[i]
                if SpellBoolCaster(s__AinzSpells__AinzW_KS_c[this]) and s__AinzSpells__AinzW_KS_d[this] != null and GetUnitState(s__AinzSpells__AinzW_KS_d[this], UNIT_STATE_LIFE) > 0.405 and s__AinzSpells__AinzW_KS_distance[this] < AinzW_KnightRunRange then
                    set s__AinzSpells__AinzW_KS_r[this]=s__AinzSpells__AinzW_KS_r[this] + 0.03
                    if s__AinzSpells__AinzW_KS_r[this] < 0.39 then
                        set s__AinzSpells__AinzW_KS_a[this]=GAngle(s__AinzSpells__AinzW_KS_d[this] , s__AinzSpells__AinzW_KS_td[this])
