                            call WOSUI___WUI_TestHeroProgress((s__StarrkSpells___StarrkSpells_E_c[this] ) , ( StarrkE_ID ) , ( "Resurreccion Los Lobos [Level 1]" ) , (( s__StarrkSpells___StarrkSpells_E_rmax[this] - s__StarrkSpells___StarrkSpells_E_r[this] )*1.0) , (( s__StarrkSpells___StarrkSpells_E_rmax[this] )*1.0) , ( true) , "") // INLINED!!
                        endif
                        if s__StarrkSpells___StarrkSpells_E_check2[this] == 0 and LoadInteger(hs, GetHandleId(s__StarrkSpells___StarrkSpells_E_c[this]), StarrkSpells___SH_STARK_T) == 1 then
                            set s__StarrkSpells___StarrkSpells_E_rmax[this]=s__StarrkSpells___StarrkSpells_E_rmax[this] + StarrkT_Duration
                            set s__StarrkSpells___StarrkSpells_E_check2[this]=1
                        endif
                        if s__StarrkSpells___StarrkSpells_E_r2[this] > 0.94 then
