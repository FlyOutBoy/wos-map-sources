                set s__MilimSpells___MilimRKS_m_MilimR[i]=s__MilimSpells___MilimRKS_m_MilimR[s__MilimSpells___MilimRKS_MUI_MilimR]
                set s__MilimSpells___MilimRKS_MUI_MilimR=s__MilimSpells___MilimRKS_MUI_MilimR - 1
                if s__MilimSpells___MilimRKS_MUI_MilimR == - 1 then
                    call MilimSpells___MilimTick_Off(3)
                endif
                call s__MilimSpells___MilimRKS_deallocate(this)
                set i=i - 1
            endif

            set i=i + 1
        endloop
    endfunction

    function s__MilimSpells___MilimRKS_MilimR_Start takes unit NewC,real NewX,real NewY returns nothing
        local integer this= s__MilimSpells___MilimRKS__allocate()

        set s__MilimSpells___MilimRKS_MUI_MilimR=s__MilimSpells___MilimRKS_MUI_MilimR + 1
        set s__MilimSpells___MilimRKS_m_MilimR[s__MilimSpells___MilimRKS_MUI_MilimR]=this
        set s__MilimSpells___MilimRKS_c[this]=NewC
        set s__MilimSpells___MilimRKS_x[this]=NewX
        set s__MilimSpells___MilimRKS_y[this]=NewY
        set s__MilimSpells___MilimRKS_a[this]=GAngle2(s__MilimSpells___MilimRKS_c[this] , s__MilimSpells___MilimRKS_x[this] , s__MilimSpells___MilimRKS_y[this])
        set s__MilimSpells___MilimRKS_r[this]=0.00
        set s__MilimSpells___MilimRKS_launched[this]=0

        // Ëþáîé þíèò ïîëó÷àåò ýòîò ïîëíûé óðîí òîëüêî îò ïåðâîãî ïîïàâøåãî ñíàðÿäà.
        set s__MilimSpells___MilimRKS_dmg[this]=GetHeroAgi(s__MilimSpells___MilimRKS_c[this], true) * ( MilimR_DamageAgiBase + MilimR_DamageAgiStep * ( GetUnitAbilityLevel(s__MilimSpells___MilimRKS_c[this], MilimR_ID) - 1 ) )
        if LoadInteger(hs, GetHandleId(s__MilimSpells___MilimRKS_c[this]), MilimSpells___SH_MODE_T) == 1 then
            set s__MilimSpells___MilimRKS_dmg[this]=s__MilimSpells___MilimRKS_dmg[this] + MilimT_DmgAdd * GetHeroAgi(s__MilimSpells___MilimRKS_c[this], true)
        endif
        set s__MilimSpells___MilimRKS_g[this]=CreateGroup()
        set s__MilimSpells___MilimRKS_g2[this]=CreateGroup()
        call SaveInteger(hs, GetHandleId(s__MilimSpells___MilimRKS_g[this]), MilimSpells___SH_MILIMR_PROJECTILES_LEFT, 0)

        call SaveInteger(hs, GetHandleId(GetOwningPlayer(s__MilimSpells___MilimRKS_c[this])), SH_Milim_MILIMR_ID, 0)
        call StartSpellUnit(s__MilimSpells___MilimRKS_c[this])
        call SetUnitAnimationByIndex(s__MilimSpells___MilimRKS_c[this], 7)
        call MakeSound("war3mapimported\\Hero_Milim_R 1")
        call MakeSound("war3mapimported\\Hero_Milim_R 2")
        // ÇÀÒÛ×ÊÀ: ýôôåêò ïîäãîòîâêè ê âûïóñêó ñíàðÿäîâ.

        if s__MilimSpells___MilimRKS_MUI_MilimR == 0 then
            call MilimSpells___MilimTick_On(3)
        endif
    endfunction



        function s__MilimSpells___MilimTKS_Loop_MilimT takes nothing returns nothing
            local integer this
            local integer i= 0
            local real hp
            loop
                exitwhen i > s__MilimSpells___MilimTKS_MUI_MilimT
                set this=s__MilimSpells___MilimTKS_m_MilimT[i]
                if SpellBoolCaster(s__MilimSpells___MilimTKS_c[this]) and s__MilimSpells___MilimTKS_r[this] <= s__MilimSpells___MilimTKS_rmax[this] and CheckCoordsInRect(gg_rct_Base , GetUnitX(s__MilimSpells___MilimTKS_c[this]) , GetUnitY(s__MilimSpells___MilimTKS_c[this])) == false then
                    if s__MilimSpells___MilimTKS_check[this] == 0 then
                        call DebugUnit2(s__MilimSpells___MilimTKS_c[this])
                        set s__MilimSpells___MilimTKS_r[this]=s__MilimSpells___MilimTKS_r[this] + 0.03
                        set s__MilimSpells___MilimTKS_x[this]=GetUnitX(s__MilimSpells___MilimTKS_c[this])
                        set s__MilimSpells___MilimTKS_y[this]=GetUnitY(s__MilimSpells___MilimTKS_c[this])
                        set s__MilimSpells___MilimTKS_r[this]=RoundReal(s__MilimSpells___MilimTKS_r[this] , 3)
                        call BlzSetSpecialEffectPosition(s__MilimSpells___MilimTKS_e[this], s__MilimSpells___MilimTKS_x[this], s__MilimSpells___MilimTKS_y[this], 0)
                        if s__MilimSpells___MilimTKS_r2[this] > 0.15 then
                        set s__MilimSpells___MilimTKS_r2[this]=0
                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_Opdef17 (282).mdl" , s__MilimSpells___MilimTKS_x[this] , s__MilimSpells___MilimTKS_y[this] , GetRandomReal(0, 359) , 1.15 , 1.55 , 1))
                        else
                        set s__MilimSpells___MilimTKS_r2[this]=s__MilimSpells___MilimTKS_r2[this] + 0.03
                        endif
                        if s__MilimSpells___MilimTKS_r[this] == 0.51 then
                            call SetPlayerAbilityAvailable(GetOwningPlayer(s__MilimSpells___MilimTKS_c[this]), MilimT_ID, false)
                            call UnitAddAbility(s__MilimSpells___MilimTKS_c[this], MilimT2_ID)
                            call SetPlayerAbilityAvailable(GetOwningPlayer(s__MilimSpells___MilimTKS_c[this]), MilimT2_ID, true)
                            call DecorRemove(s__MilimSpells___MilimTKS_c[this] , s__MilimSpells___MilimTKS_x[this] , s__MilimSpells___MilimTKS_y[this] , 800 , 50)
                            call VisionTimed(GetOwningPlayer(s__MilimSpells___MilimTKS_c[this]) , s__MilimSpells___MilimTKS_x[this] , s__MilimSpells___MilimTKS_y[this] , 1500 , 2)
                            call BlzSetUnitSkin(s__MilimSpells___MilimTKS_c[this], Milim2_ID)
                            //call FixAura(c)
                            call ScaleEffDummy(s__MilimSpells___MilimTKS_e[this] , 0.5 , 3 , 6)
                            call ScaleEffDummy(s__MilimSpells___MilimTKS_e2[this] , 0.5 , 1 , 2.5)
                            call ColorEffDummy3Alpha((s__MilimSpells___MilimTKS_e[this] ) , (( 0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.6)*1.0)) // INLINED!!
                            call ColorEffDummy3Alpha((s__MilimSpells___MilimTKS_e2[this] ) , (( 0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.35)*1.0)) // INLINED!!
                            call StopSpellUnit2(s__MilimSpells___MilimTKS_c[this])
                            set s__MilimSpells___MilimTKS_e3[this]=AddSpecialEffectTarget("war3mapImported\\wos_aurafbred.mdx", s__MilimSpells___MilimTKS_c[this], "origin")
                            set s__MilimSpells___MilimTKS_check[this]=1
                            set s__MilimSpells___MilimTKS_r[this]=0
                            
                            call DestroyEffect(EffectSpawn3("war3mapImported\\wos_mei-qqsfx-5.mdl" , GetUnitX(s__MilimSpells___MilimTKS_c[this]) , GetUnitY(s__MilimSpells___MilimTKS_c[this]) , 1 , 0.85 , 4 , 1 , - 90))
                        endif
                    elseif s__MilimSpells___MilimTKS_check[this] == 1 then
                        if IsUnitPaused(s__MilimSpells___MilimTKS_c[this]) == false then
                            set s__MilimSpells___MilimTKS_r[this]=s__MilimSpells___MilimTKS_r[this] + 0.03
                        endif
                        set s__MilimSpells___MilimTKS_r[this]=RoundReal(s__MilimSpells___MilimTKS_r[this] , 3)
                        if s__MilimSpells___MilimTKS_rmax[this] - s__MilimSpells___MilimTKS_r[this] >= 0 then
                            call WOSUI___WUI_TestHeroProgress((s__MilimSpells___MilimTKS_c[this] ) , ( MilimT_ID ) , ( "True Form" ) , (( s__MilimSpells___MilimTKS_rmax[this] - s__MilimSpells___MilimTKS_r[this] )*1.0) , (( s__MilimSpells___MilimTKS_rmax[this] )*1.0) , ( true) , "") // INLINED!!
                        endif
                        set s__MilimSpells___MilimTKS_x[this]=GetUnitX(s__MilimSpells___MilimTKS_c[this])
                        set s__MilimSpells___MilimTKS_y[this]=GetUnitY(s__MilimSpells___MilimTKS_c[this])
                    endif
                else
                    set hp=GetUnitState(s__MilimSpells___MilimTKS_c[this], UNIT_STATE_LIFE) / GetUnitState(s__MilimSpells___MilimTKS_c[this], UNIT_STATE_MAX_LIFE)
                    call BlzSetUnitMaxHP(s__MilimSpells___MilimTKS_c[this], BlzGetUnitMaxHP(s__MilimSpells___MilimTKS_c[this]) - MilimT_MaxHpBonus)
                    call SetUnitState(s__MilimSpells___MilimTKS_c[this], UNIT_STATE_LIFE, GetUnitState(s__MilimSpells___MilimTKS_c[this], UNIT_STATE_MAX_LIFE) * hp)
                    call UnitRemoveAbility(s__MilimSpells___MilimTKS_c[this], MilimT_HpRegenAbi)
                    call BlzSetUnitSkin(s__MilimSpells___MilimTKS_c[this], Milim_ID)
                    //call FixAura(c)
                    call BlzSetAbilityIcon(Milim_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Milim_Icon.blp")
                    call SaveInteger(hs, GetHandleId(s__MilimSpells___MilimTKS_c[this]), MilimSpells___SH_MODE_T, 0)
                    call SetPlayerAbilityAvailable(GetOwningPlayer(s__MilimSpells___MilimTKS_c[this]), MilimT_ID, true)
                    call SetPlayerAbilityAvailable(GetOwningPlayer(s__MilimSpells___MilimTKS_c[this]), MilimT2_ID, false)
                    if s__MilimSpells___MilimTKS_check[this] == 0 then
                        call StopSpellUnit2(s__MilimSpells___MilimTKS_c[this])
                        call DestroyEffect(s__MilimSpells___MilimTKS_e2[this])
                    else
                        call DestroyEffect(s__MilimSpells___MilimTKS_e3[this])
                    endif
                        call WOSUI___WUI_TestHeroProgress((s__MilimSpells___MilimTKS_c[this] ) , ( MilimT_ID ) , ( "True Form" ) , (( 0.00 )*1.0) , (( 0.00 )*1.0) , ( true) , "") // INLINED!!
                    set s__MilimSpells___MilimTKS_c[this]=null
                    set s__MilimSpells___MilimTKS_e[this]=null
                    set s__MilimSpells___MilimTKS_e2[this]=null
                    set s__MilimSpells___MilimTKS_e3[this]=null
                    set s__MilimSpells___MilimTKS_m_MilimT[i]=s__MilimSpells___MilimTKS_m_MilimT[s__MilimSpells___MilimTKS_MUI_MilimT]
                    set s__MilimSpells___MilimTKS_MUI_MilimT=s__MilimSpells___MilimTKS_MUI_MilimT - 1
                    set i=i - 1 // revisit: the moved instance must not skip this tick
                    if s__MilimSpells___MilimTKS_MUI_MilimT == - 1 then
                        call MilimSpells___MilimTick_Off(4)
                    endif
                    call s__MilimSpells___MilimTKS_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction
        function s__MilimSpells___MilimTKS_MilimT_Start takes unit NewC returns nothing
            local integer this= s__MilimSpells___MilimTKS__allocate()
            local real hp
            set s__MilimSpells___MilimTKS_MUI_MilimT=s__MilimSpells___MilimTKS_MUI_MilimT + 1
            set s__MilimSpells___MilimTKS_m_MilimT[s__MilimSpells___MilimTKS_MUI_MilimT]=this
            set s__MilimSpells___MilimTKS_c[this]=NewC
            set hp=GetUnitState(s__MilimSpells___MilimTKS_c[this], UNIT_STATE_LIFE) / GetUnitState(s__MilimSpells___MilimTKS_c[this], UNIT_STATE_MAX_LIFE)
            call BlzSetUnitMaxHP(s__MilimSpells___MilimTKS_c[this], BlzGetUnitMaxHP(s__MilimSpells___MilimTKS_c[this]) + MilimT_MaxHpBonus)
            call SetUnitState(s__MilimSpells___MilimTKS_c[this], UNIT_STATE_LIFE, GetUnitState(s__MilimSpells___MilimTKS_c[this], UNIT_STATE_MAX_LIFE) * hp)
            call UnitAddAbility(s__MilimSpells___MilimTKS_c[this], MilimT_HpRegenAbi)
            set s__MilimSpells___MilimTKS_x[this]=GetUnitX(s__MilimSpells___MilimTKS_c[this])
            set s__MilimSpells___MilimTKS_y[this]=GetUnitY(s__MilimSpells___MilimTKS_c[this])
            call StartSpellUnit2(s__MilimSpells___MilimTKS_c[this])
            set s__MilimSpells___MilimTKS_check[this]=0
            set s__MilimSpells___MilimTKS_r2[this]=0
            set s__MilimSpells___MilimTKS_r[this]=0
            set s__MilimSpells___MilimTKS_k2[this]=GetPlayerId(GetOwningPlayer(s__MilimSpells___MilimTKS_c[this]))
            call SaveInteger(hs, GetHandleId(s__MilimSpells___MilimTKS_c[this]), MilimSpells___SH_MODE_T, 1)
            set s__MilimSpells___MilimTKS_rmax[this]=MilimT_Duration
            call MakeSound("war3mapimported\\Hero_Milim_T 1")
            call MakeSound("war3mapimported\\Hero_Milim_T 2")
            call DestroyEffect(EffectSpawn("war3mapimported\\wos_HakkeStart.mdx" , s__MilimSpells___MilimTKS_x[this] , s__MilimSpells___MilimTKS_y[this] , GetRandomReal(0, 359) , 1 , 1.25 , 5))
            set s__MilimSpells___MilimTKS_e[this]=EffectSpawn("war3mapImported\\wos_ZK-SM_XL8.mdl" , GetUnitX(s__MilimSpells___MilimTKS_c[this]) , GetUnitY(s__MilimSpells___MilimTKS_c[this]) , 1 , 1.25 , 2 , 0)
            call BlzSetAbilityIcon(Milim_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Milim_T.blp")
            if s__MilimSpells___MilimTKS_MUI_MilimT == 0 then
                call MilimSpells___MilimTick_On(4)
            endif
        endfunction
    // Ýòè ïàðàìåòðû äîáàâèòü â ñóùåñòâóþùèé globals áèáëèîòåêè MilimSpells.

    // Invulnerability: this spell contains a StartSpellUnit/Avul phase.



    function s__MilimSpells___MilimT2KS_Loop_MilimT2 takes nothing returns nothing
        local integer this
        local integer i= 0
        local integer damageCount
        local real add= - 1
        local real targetA
        local real angleDiff
        local real maxTurn= s__MilimSpells___MilimT2KS_AIM_TURN_SPEED * bj_DEGTORAD * 0.03
        local real turnLimit= s__MilimSpells___MilimT2KS_AIM_TURN_LIMIT * bj_DEGTORAD
        local real beamEffectLife
        local real damageMove
        local real damageAoe
        local real damageX
        local real damageY
        local effect beamEffect
        local integer beamSegment

        loop
            exitwhen i > s__MilimSpells___MilimT2KS_MUI_MilimT2
            set this=s__MilimSpells___MilimT2KS_m_MilimT2[i]
            if s__MilimSpells___MilimT2KS_check[this] == 0 then
                // Нижняя строка — время каста, верхняя (красная) — доп. урон AGI от порогов G.
                call WUI_HeroProgressDualText(s__MilimSpells___MilimT2KS_c[this] , MilimT2_ID , "Drago Nova" , MilimT2_ChargeTime - s__MilimSpells___MilimT2KS_r[this] , MilimT2_ChargeTime , s__MilimSpells___MilimT2KS_thresholdBonus[this] , MilimT2_ThresholdAgiBonus * 3.00 , "+AGI x " + R2SW(s__MilimSpells___MilimT2KS_thresholdBonus[this], 0, 2))
            endif

            if SpellBoolCaster(s__MilimSpells___MilimT2KS_c[this]) and s__MilimSpells___MilimT2KS_check[this] < 2 then
                call DebugUnit(s__MilimSpells___MilimT2KS_c[this])
                    if s__MilimSpells___MilimT2KS_r3[this] > 0.22 then
                    set s__MilimSpells___MilimT2KS_r3[this]=0
                    call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_13684996917731847118.mdl" , GetUnitX(s__MilimSpells___MilimT2KS_c[this]) + add * Cos(s__MilimSpells___MilimT2KS_a[this]) , GetUnitY(s__MilimSpells___MilimT2KS_c[this]) + add * Sin(s__MilimSpells___MilimT2KS_a[this]) , GetRandomReal(0, 359) , 1.50 , 2.00 , 255.00 , 255 , 255 , 255 , 165))
                    else
                    set s__MilimSpells___MilimT2KS_r3[this]=s__MilimSpells___MilimT2KS_r3[this] + 0.03
                    endif
                if s__MilimSpells___MilimT2KS_check[this] == 0 then
                    set s__MilimSpells___MilimT2KS_r[this]=s__MilimSpells___MilimT2KS_r[this] + 0.03

                    // Æåëàåìûé óãîë ìûøè ñíà÷àëà îãðàíè÷èâàåòñÿ ñåêòîðîì
                    // baseA - 120 ãðàäóñîâ ... baseA + 120 ãðàäóñîâ.
                    set targetA=GAngle2(s__MilimSpells___MilimT2KS_c[this] , GetMouseX(GetOwningPlayer(s__MilimSpells___MilimT2KS_c[this])) , GetMouseY(GetOwningPlayer(s__MilimSpells___MilimT2KS_c[this])))
                    set angleDiff=targetA - s__MilimSpells___MilimT2KS_baseA[this]
                    if angleDiff > bj_PI then
                        set angleDiff=angleDiff - 2.00 * bj_PI
                    elseif angleDiff < - bj_PI then
                        set angleDiff=angleDiff + 2.00 * bj_PI
                    endif

                    if angleDiff > turnLimit then
                        set targetA=s__MilimSpells___MilimT2KS_baseA[this] + turnLimit
                    elseif angleDiff < - turnLimit then
                        set targetA=s__MilimSpells___MilimT2KS_baseA[this] - turnLimit
                    else
                        set targetA=s__MilimSpells___MilimT2KS_baseA[this] + angleDiff
                    endif
                    
                    // Ãåðîé è ýôôåêò ïëàâíî èäóò ê ðàçðåø¸ííîìó óãëó.
                    set angleDiff=targetA - s__MilimSpells___MilimT2KS_a[this]
                    if angleDiff > bj_PI then
                        set angleDiff=angleDiff - 2.00 * bj_PI
                    elseif angleDiff < - bj_PI then
                        set angleDiff=angleDiff + 2.00 * bj_PI
                    endif

                    if angleDiff > maxTurn then
                        set s__MilimSpells___MilimT2KS_a[this]=s__MilimSpells___MilimT2KS_a[this] + maxTurn
                    elseif angleDiff < - maxTurn then
                        set s__MilimSpells___MilimT2KS_a[this]=s__MilimSpells___MilimT2KS_a[this] - maxTurn
                    else
                        set s__MilimSpells___MilimT2KS_a[this]=targetA
                    endif

                    call BlzSetUnitFacingEx(s__MilimSpells___MilimT2KS_c[this], s__MilimSpells___MilimT2KS_a[this] * bj_RADTODEG)
                    call BlzSetSpecialEffectPosition(s__MilimSpells___MilimT2KS_e[this], GetUnitX(s__MilimSpells___MilimT2KS_c[this]), GetUnitY(s__MilimSpells___MilimT2KS_c[this]), 0.00)
                    call BlzSetSpecialEffectYaw(s__MilimSpells___MilimT2KS_e[this], s__MilimSpells___MilimT2KS_a[this])
                    call BlzSetSpecialEffectYaw(s__MilimSpells___MilimT2KS_e4[this], s__MilimSpells___MilimT2KS_a[this])

                    // Keep the additional R-style charge effects in front of Milim
                    // while she turns towards the mouse cursor.
                    if s__MilimSpells___MilimT2KS_r[this] == 0.30 then
                        set s__MilimSpells___MilimT2KS_castFrontFx[this]=EffectSpawnScale("war3mapImported\\wos_file00000739.mdl" , GetUnitX(s__MilimSpells___MilimT2KS_c[this]) + 90.00 * Cos(s__MilimSpells___MilimT2KS_a[this]) , GetUnitY(s__MilimSpells___MilimT2KS_c[this]) + 90.00 * Sin(s__MilimSpells___MilimT2KS_a[this]) , s__MilimSpells___MilimT2KS_a[this] * bj_RADTODEG , 1.00 , 1 , 100.00 , 0.75 , 1 , 3.45)
                        call BlzSetSpecialEffectAlpha(s__MilimSpells___MilimT2KS_castFrontFx[this], 150)
                        set s__MilimSpells___MilimT2KS_castFrontGlowFx[this]=EffectSpawnScale("war3mapImported\\wos_ChuShou_BY_Wood_Effect_Glow_GuiPaiQiGong_XuLiblue.mdl" , GetUnitX(s__MilimSpells___MilimT2KS_c[this]) + 90.00 * Cos(s__MilimSpells___MilimT2KS_a[this]) , GetUnitY(s__MilimSpells___MilimT2KS_c[this]) + 90.00 * Sin(s__MilimSpells___MilimT2KS_a[this]) , s__MilimSpells___MilimT2KS_a[this] * bj_RADTODEG , 1.00 , 1 , 100.00 , 0.75 , 1 , 2.50)
                        set s__MilimSpells___MilimT2KS_castFrontBallFx[this]=EffectSpawnScale("war3mapImported\\wos_xtyball2.mdx" , GetUnitX(s__MilimSpells___MilimT2KS_c[this]) + 90.00 * Cos(s__MilimSpells___MilimT2KS_a[this]) , GetUnitY(s__MilimSpells___MilimT2KS_c[this]) + 90.00 * Sin(s__MilimSpells___MilimT2KS_a[this]) , s__MilimSpells___MilimT2KS_a[this] * bj_RADTODEG , 1.00 , 1 , 0.00 , 0.75 , 1 , 1.85)
                    endif
                    if s__MilimSpells___MilimT2KS_castFrontFx[this] != null then
                        call BlzSetSpecialEffectPosition(s__MilimSpells___MilimT2KS_castFrontFx[this], GetUnitX(s__MilimSpells___MilimT2KS_c[this]) + 90.00 * Cos(s__MilimSpells___MilimT2KS_a[this]), GetUnitY(s__MilimSpells___MilimT2KS_c[this]) + 90.00 * Sin(s__MilimSpells___MilimT2KS_a[this]), 100.00)
                        call BlzSetSpecialEffectYaw(s__MilimSpells___MilimT2KS_castFrontFx[this], s__MilimSpells___MilimT2KS_a[this])
                        call BlzSetSpecialEffectPosition(s__MilimSpells___MilimT2KS_castFrontGlowFx[this], GetUnitX(s__MilimSpells___MilimT2KS_c[this]) + 90.00 * Cos(s__MilimSpells___MilimT2KS_a[this]), GetUnitY(s__MilimSpells___MilimT2KS_c[this]) + 90.00 * Sin(s__MilimSpells___MilimT2KS_a[this]), 165.00)
                        call BlzSetSpecialEffectYaw(s__MilimSpells___MilimT2KS_castFrontGlowFx[this], s__MilimSpells___MilimT2KS_a[this])
                        call BlzSetSpecialEffectPosition(s__MilimSpells___MilimT2KS_castFrontBallFx[this], GetUnitX(s__MilimSpells___MilimT2KS_c[this]) + 90.00 * Cos(s__MilimSpells___MilimT2KS_a[this]), GetUnitY(s__MilimSpells___MilimT2KS_c[this]) + 90.00 * Sin(s__MilimSpells___MilimT2KS_a[this]), 0.00)
                        call BlzSetSpecialEffectYaw(s__MilimSpells___MilimT2KS_castFrontBallFx[this], s__MilimSpells___MilimT2KS_a[this])
                    endif

                    if s__MilimSpells___MilimT2KS_r[this] == 1.5 then
                        call MakeSound("war3mapimported\\Hero_Milim_T2 2")
                        call MakeSound("war3mapimported\\Hero_Milim_T2 3")
                    endif

                    if s__MilimSpells___MilimT2KS_r[this] >= MilimT2_ChargeTime then
                        set s__MilimSpells___MilimT2KS_check[this]=1
                        set s__MilimSpells___MilimT2KS_r[this]=0.00
                        set s__MilimSpells___MilimT2KS_r2[this]=0.00
                        set s__MilimSpells___MilimT2KS_move[this]=0.00
