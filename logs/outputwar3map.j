                    call BlzStartUnitAbilityCooldown(s__AlucardSpells__AlucardSpells_R_c[this], AlucardT_ID, BlzGetUnitAbilityCooldownRemaining(s__AlucardSpells__AlucardSpells_R_c[this], AlucardT2_ID))
