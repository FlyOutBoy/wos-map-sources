 set b=false
endif
if id == TsunaQ_ID or id == TsunaQ2_ID or id == TakeshiQ_ID or id == TakeshiE_ID or id == TakeshiGQ_ID or id == DarkShikiQ_ID or id == KiritoQ_ID or id == KiritoF_ID or id == KiritoR2_ID then
 set b=false
endif
if id == DarkShikiQ2_ID or id == Erza4W_ID or id == RimuruW2_ID or id == AstaW2_ID or id == AstaW_ID or id == TojiE_ID or id == AstaE_ID or id == BarraganE2_ID or id == StarrkE2_ID then
 set b=false
endif
if ( id == BambiettaW_ID and LoadInteger(hs, GetHandleId(GetOwningPlayer(c)), SH_CastCheck_MORPH_T) > 0 ) then
 set b=false
endif
if idc == Raiden_ID then
if id == RaidenQ_ID then
set b=false
endif

endif

if id == CrocodileE_ID then
set b=false
endif



 endif
 return b
endfunction
// Refund of a cancelled cast: only the mana the engine really took since the
// SPELL_CAST snapshot, never more than the cost (no free mana when the patched
// engine skipped the payment).
function CastCancel_Refund takes unit c,integer id returns nothing
    local integer h= GetHandleId(c)
    local real paid
    if LoadInteger(hs, h, SH_CastCheck_MANA_FIX_ABILITY) == id then
        set paid=RMinBJ(I2R(LoadInteger(hs, h, SH_CastCheck_MANA_FIX_COST)), LoadReal(hs, h, SH_CastCheck_MANA_FIX_BEFORE) - GetUnitState(c, UNIT_STATE_MANA))
        if paid > 0.01 then
            call s__GearSystems2___KS_AddMana_Start((c ) , (( paid )*1.0) , (( 0.03)*1.0)) // INLINED!!
        endif
    endif
    call ManaFix_ClearSnapshot(c)
endfunction
// SPELL_CAST comes before the native mana payment and cooldown: a rooted
// movement cast is cancelled here, so nothing is spent. The SPELL_EFFECT
// branch in CastHero_Conditions stays as a refunding fallback.
function RootCancel_OnCast takes nothing returns boolean
    local unit c= GetSpellAbilityUnit()
    if IsUnitType(c, UNIT_TYPE_HERO) and GetUnitAbilityLevel(c, 'BEer') > 0 and not IsUnitPaused(c) and not DisableMoveRoot(c , GetSpellAbilityId()) then
        call PauseUnit(c, true)
        call IssueImmediateOrder(c, "stop")
        call PauseUnit(c, false)
        if IntegerCdKey(c , SH_ICD_CANCEL_TOOLTIP , 3) then
            call DisplayTimedTextToPlayer(GetOwningPlayer(c), 0, 0, 0.01, "|c00FF0000Can't use this ability while rooted!|r")
        endif
    endif
    set c=null
    return false
endfunction
function SpellExtension takes unit c,integer id returns boolean
local integer check= 0
if GetUnitTypeId(c) == Kenjaku_ID and id == KenjakuG_ID then
set check=1
endif
if GetUnitTypeId(c) == Patriot_ID and id == PatriotE_ID then
set check=1
endif
// Alter Saber F is a toggle: must switch in base too, otherwise the On glow never goes off.
if id == AlterSaberF_ID or id == AlterSaberF_Active_ID then
set check=1
endif
if id == 'A0BZ' then
set check=1
endif
if id == 'A0FD' or id == 'A0G1' or id == 'A0G0' then
set check=1
endif
if GetUnitTypeId(c) == Inori_ID and id == InoriG_ID then
set check=1
endif
if GetUnitTypeId(c) == Takeshi_ID and id == TakeshiF_ID then
set check=1
endif
if GetUnitTypeId(c) == Rimuru_ID and id == RimuruG3_ID then
set check=1
endif
return check == 1
endfunction
function CastHero_Conditions takes nothing returns boolean
    local integer check= 0
    local unit c= GetSpellAbilityUnit()
    local unit td= GetSpellTargetUnit()
    local real x= GetSpellTargetX()
    local real y= GetSpellTargetY()
    local integer id= GetSpellAbilityId()
    local real rr= 0
    local real cdReduce= 0
