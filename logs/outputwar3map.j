                    set s__FrierenSpells__FrierenSpells_T2_a2[this]=s__FrierenSpells__FrierenSpells_T2_a2[this] + 4 * bj_DEGTORAD
                    call BlzSetSpecialEffectYaw(s__FrierenSpells__FrierenSpells_T2_e[this], s__FrierenSpells__FrierenSpells_T2_a2[this])
