        function s__ItemsSpells__ItemsSpells_SakuraSesshou_IsInvisible takes unit u returns boolean
            return GetUnitAbilityLevel(u, 'Apiv') > 0 or GetUnitAbilityLevel(u, 'A03W') > 0 or GetUnitAbilityLevel(u, 'A0HZ') > 0 or GetUnitAbilityLevel(u, 'Binv') > 0 or GetUnitAbilityLevel(u, 'BOwk') > 0 or GetUnitAbilityLevel(u, 'Bshm') > 0
        endfunction

        // Случайный враг в зоне; невидимые юниты в приоритете.
        function s__ItemsSpells__ItemsSpells_SakuraSesshou_Strike takes integer this returns nothing
            local unit u
            local unit pick= null
            local unit pickInvis= null
            local integer n= 0
            local integer nInvis= 0
            call GroupClear(s__ItemsSpells__ItemsSpells_SakuraSesshou_g[this])
            call GroupEnumUnitsInRange(s__ItemsSpells__ItemsSpells_SakuraSesshou_g[this], s__ItemsSpells__ItemsSpells_SakuraSesshou_x[this], s__ItemsSpells__ItemsSpells_SakuraSesshou_y[this], SakuraSesshou_Aoe, NoDecor_Cond)
            loop
                set u=FirstOfGroup(s__ItemsSpells__ItemsSpells_SakuraSesshou_g[this])
                exitwhen u == null
                if SpellBool(u) and IsUnitEnemy(u, GetOwningPlayer(s__ItemsSpells__ItemsSpells_SakuraSesshou_c[this])) then
                    if s__ItemsSpells__ItemsSpells_SakuraSesshou_IsInvisible(u) then
                        set nInvis=nInvis + 1
                        if GetRandomInt(1, nInvis) == 1 then
                            set pickInvis=u
                        endif
                    else
                        set n=n + 1
                        if GetRandomInt(1, n) == 1 then
                            set pick=u
                        endif
                    endif
                endif
                call GroupRemoveUnit(s__ItemsSpells__ItemsSpells_SakuraSesshou_g[this], u)
            endloop
            if pickInvis != null then
                set pick=pickInvis
            endif
            if pick != null then
                call DestroyEffect(EffectSpawn("war3mapImported\\wos_WTW-whitethunder-Zi.mdx" , GetUnitX(pick) , GetUnitY(pick) , GetRandomReal(0, 359) , 1 , 1 , 0))
                set GearDamageNextSource=('I03W') // INLINED!!
                call dmgmag(s__ItemsSpells__ItemsSpells_SakuraSesshou_c[this] , pick , s__ItemsSpells__ItemsSpells_SakuraSesshou_dmg[this] + s__ItemsSpells__ItemsSpells_SakuraSesshou_firstBonus[this])
            endif
            set s__ItemsSpells__ItemsSpells_SakuraSesshou_firstBonus[this]=0
            set u=null
            set pick=null
            set pickInvis=null
        endfunction

        function s__ItemsSpells__ItemsSpells_SakuraSesshou_Loop_SakuraSesshou takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__ItemsSpells__ItemsSpells_SakuraSesshou_MUI_Item16
                set this=s__ItemsSpells__ItemsSpells_SakuraSesshou_m_Item16[i]
                if s__ItemsSpells__ItemsSpells_SakuraSesshou_r[this] < SakuraSesshou_Duration and GetUnitTypeId(s__ItemsSpells__ItemsSpells_SakuraSesshou_c[this]) != 0 then
                    set s__ItemsSpells__ItemsSpells_SakuraSesshou_r[this]=I2R(R2I(( s__ItemsSpells__ItemsSpells_SakuraSesshou_r[this] + 0.03 ) * 1000.0 + 0.5)) / 1000.0
                    set s__ItemsSpells__ItemsSpells_SakuraSesshou_r2[this]=I2R(R2I(( s__ItemsSpells__ItemsSpells_SakuraSesshou_r2[this] + 0.03 ) * 1000.0 + 0.5)) / 1000.0
                    if s__ItemsSpells__ItemsSpells_SakuraSesshou_r2[this] >= SakuraSesshou_Interval then
                        set s__ItemsSpells__ItemsSpells_SakuraSesshou_r2[this]=s__ItemsSpells__ItemsSpells_SakuraSesshou_r2[this] - SakuraSesshou_Interval
                        call s__ItemsSpells__ItemsSpells_SakuraSesshou_Strike(this)
                    endif
                else
                    call DestroyEffect(s__ItemsSpells__ItemsSpells_SakuraSesshou_e[this])
                    call DestroyGroup(s__ItemsSpells__ItemsSpells_SakuraSesshou_g[this])
                    set s__ItemsSpells__ItemsSpells_SakuraSesshou_c[this]=null
                    set s__ItemsSpells__ItemsSpells_SakuraSesshou_e[this]=null
                    set s__ItemsSpells__ItemsSpells_SakuraSesshou_g[this]=null
                    call DestroyEffect(s__ItemsSpells__ItemsSpells_SakuraSesshou_area[this])
                    set s__ItemsSpells__ItemsSpells_SakuraSesshou_area[this]=null
                    set s__ItemsSpells__ItemsSpells_SakuraSesshou_m_Item16[i]=s__ItemsSpells__ItemsSpells_SakuraSesshou_m_Item16[s__ItemsSpells__ItemsSpells_SakuraSesshou_MUI_Item16]
                    set s__ItemsSpells__ItemsSpells_SakuraSesshou_MUI_Item16=s__ItemsSpells__ItemsSpells_SakuraSesshou_MUI_Item16 - 1
                    if s__ItemsSpells__ItemsSpells_SakuraSesshou_MUI_Item16 == - 1 then
                        call ItemsSpells__ItemsTick_Off(16)
                    endif
                    call s__ItemsSpells__ItemsSpells_SakuraSesshou_deallocate(this)
                    set i=i - 1
                endif
                set i=i + 1
            endloop
        endfunction

        function s__ItemsSpells__ItemsSpells_SakuraSesshou_SakuraSesshou_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__ItemsSpells__ItemsSpells_SakuraSesshou__allocate()
            set s__ItemsSpells__ItemsSpells_SakuraSesshou_MUI_Item16=s__ItemsSpells__ItemsSpells_SakuraSesshou_MUI_Item16 + 1
            set s__ItemsSpells__ItemsSpells_SakuraSesshou_m_Item16[s__ItemsSpells__ItemsSpells_SakuraSesshou_MUI_Item16]=this
            set s__ItemsSpells__ItemsSpells_SakuraSesshou_c[this]=NewC
            set s__ItemsSpells__ItemsSpells_SakuraSesshou_x[this]=NewX
            set s__ItemsSpells__ItemsSpells_SakuraSesshou_y[this]=NewY
            set s__ItemsSpells__ItemsSpells_SakuraSesshou_r[this]=0
            set s__ItemsSpells__ItemsSpells_SakuraSesshou_r2[this]=0
            set s__ItemsSpells__ItemsSpells_SakuraSesshou_dmg[this]=GetMainStatValue(s__ItemsSpells__ItemsSpells_SakuraSesshou_c[this] , true) * SakuraSesshou_Damage
            // Sacred Gear Booster: бонус только на первый тик, прок считается при касте (КД режет CastCheck).
            set s__ItemsSpells__ItemsSpells_SakuraSesshou_firstBonus[this]=SacredGearBooster(s__ItemsSpells__ItemsSpells_SakuraSesshou_c[this] , 0)
            set s__ItemsSpells__ItemsSpells_SakuraSesshou_g[this]=CreateGroup()
            set s__ItemsSpells__ItemsSpells_SakuraSesshou_e[this]=EffectSpawn("war3mapimported\\wos_file00001256.mdx" , s__ItemsSpells__ItemsSpells_SakuraSesshou_x[this] , s__ItemsSpells__ItemsSpells_SakuraSesshou_y[this] , GetRandomReal(0, 359) , 1 , 1 , 0)
            // Raiden R's circle is calibrated to 650 radius at scale 2.3.
            set s__ItemsSpells__ItemsSpells_SakuraSesshou_area[this]=EffectSpawn("war3mapImported\\wos_lightning circle.mdl" , s__ItemsSpells__ItemsSpells_SakuraSesshou_x[this] , s__ItemsSpells__ItemsSpells_SakuraSesshou_y[this] , 0 , 1 , 2.3 * 1.05 * SakuraSesshou_Aoe / 650.0 , 3) // +5%: the circle read slightly small
            if GetUnitTypeId(s__ItemsSpells__ItemsSpells_SakuraSesshou_c[this]) == Bambietta_ID and BlzGetUnitAbilityCooldownRemaining(s__ItemsSpells__ItemsSpells_SakuraSesshou_c[this], BambiettaG_ID) == 0 and GetHeroLevel(s__ItemsSpells__ItemsSpells_SakuraSesshou_c[this]) >= BambiettaG_Lvl_CD then
                call BambiettaG_Start(s__ItemsSpells__ItemsSpells_SakuraSesshou_c[this])
                call BambiettaG2_Start(s__ItemsSpells__ItemsSpells_SakuraSesshou_c[this] , s__ItemsSpells__ItemsSpells_SakuraSesshou_x[this] , s__ItemsSpells__ItemsSpells_SakuraSesshou_y[this])
            endif
            if s__ItemsSpells__ItemsSpells_SakuraSesshou_MUI_Item16 == 0 then
                call ItemsSpells__ItemsTick_On(16)
            endif
        endfunction

