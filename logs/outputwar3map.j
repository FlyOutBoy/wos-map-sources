        function s__AstaSpells__AstaSpells_W_Loop_AstaW takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__AstaSpells__AstaSpells_W_MUI_AstaW
                set this=s__AstaSpells__AstaSpells_W_m_AstaW[i]
                if SpellBoolCaster(s__AstaSpells__AstaSpells_W_c[this]) and s__AstaSpells__AstaSpells_W_r[this] <= s__AstaSpells__AstaSpells_W_rmax[this] then
                    set s__AstaSpells__AstaSpells_W_r[this]=I2R(R2I(( s__AstaSpells__AstaSpells_W_r[this] + 0.03 ) * 1000.0 + 0.5)) / 1000.0
                    call DebugUnit2(s__AstaSpells__AstaSpells_W_c[this])
                    set s__AstaSpells__AstaSpells_W_x[this]=GetUnitX(s__AstaSpells__AstaSpells_W_c[this])
                    set s__AstaSpells__AstaSpells_W_y[this]=GetUnitY(s__AstaSpells__AstaSpells_W_c[this])
                    if s__AstaSpells__AstaSpells_W_r[this] == 0.27 then
                        call SetUnitAnimationByIndex(s__AstaSpells__AstaSpells_W_c[this], 7)
                        call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_BY_Wood_Eff_Ord_DanGe_Wid_ChongFengQiLiu.mdl" , s__AstaSpells__AstaSpells_W_x[this] + 400 * Cos(s__AstaSpells__AstaSpells_W_a[this]) , s__AstaSpells__AstaSpells_W_y[this] + 400 * Sin(s__AstaSpells__AstaSpells_W_a[this]) , s__AstaSpells__AstaSpells_W_a[this] * bj_RADTODEG , 1.2 , 2.95 , 0 , 55 , 0 , 0 , 125))
                    endif
                    if s__AstaSpells__AstaSpells_W_r[this] == AstaW_CastTime then
                        call MakeSound("war3mapImported\\Hero_Asta_TW2")
                        set s__AstaSpells__AstaSpells_W_e[this]=EffectSpawn("war3mapImported\\wos_BDEF (55)black.mdl" , GetUnitX(s__AstaSpells__AstaSpells_W_c[this]) + 35 * Cos(s__AstaSpells__AstaSpells_W_a[this]) , GetUnitY(s__AstaSpells__AstaSpells_W_c[this]) + 35 * Sin(s__AstaSpells__AstaSpells_W_a[this]) , s__AstaSpells__AstaSpells_W_a[this] * bj_RADTODEG + 90 , 0.66 , 1.5 , 50)
                        call BlzSetSpecialEffectAlpha(s__AstaSpells__AstaSpells_W_e[this], 0)
                        call ColorEffDummy4(s__AstaSpells__AstaSpells_W_e[this] , 0 , 255 , 255 , 255 , 0.25)
                        call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_BY_Wood_Eff_Ord_DanGe_Dus_Kuosan_1_2_1.mdl" , s__AstaSpells__AstaSpells_W_x[this] + 200 * Cos(s__AstaSpells__AstaSpells_W_a[this]) , s__AstaSpells__AstaSpells_W_y[this] + 200 * Sin(s__AstaSpells__AstaSpells_W_a[this]) , s__AstaSpells__AstaSpells_W_a[this] * bj_RADTODEG , 1.25 , 2.55 , 0 , 55 , 0 , 0 , 125))
                    endif
                    if s__AstaSpells__AstaSpells_W_r[this] >= AstaW_CastTime then
                        call MoveUnit(s__AstaSpells__AstaSpells_W_c[this] , s__AstaSpells__AstaSpells_W_move[this] , s__AstaSpells__AstaSpells_W_a[this])
                        call BlzSetSpecialEffectPosition(s__AstaSpells__AstaSpells_W_e[this], GetUnitX(s__AstaSpells__AstaSpells_W_c[this]) + 35 * Cos(s__AstaSpells__AstaSpells_W_a[this]), GetUnitY(s__AstaSpells__AstaSpells_W_c[this]) + 35 * Sin(s__AstaSpells__AstaSpells_W_a[this]), 50)
                        call BlzSetUnitFacingEx(s__AstaSpells__AstaSpells_W_c[this], s__AstaSpells__AstaSpells_W_a[this] * bj_RADTODEG)
                        set s__AstaSpells__AstaSpells_W_r4[this]=s__AstaSpells__AstaSpells_W_r4[this] + s__AstaSpells__AstaSpells_W_move[this]
                        if s__AstaSpells__AstaSpells_W_r4[this] >= s__AstaSpells__AstaSpells_W_r6[this] then
                            set s__AstaSpells__AstaSpells_W_r[this]=9999.0
                        endif
                        call GroupClear(s__AstaSpells__AstaSpells_W_g[this])
                        call GroupEnumUnitsInRange(s__AstaSpells__AstaSpells_W_g[this], s__AstaSpells__AstaSpells_W_x[this], s__AstaSpells__AstaSpells_W_y[this], s__AstaSpells__AstaSpells_W_aoe[this], NoDecor_Cond)
                        loop
                            set s__AstaSpells__AstaSpells_W_u[this]=FirstOfGroup(s__AstaSpells__AstaSpells_W_g[this])
                            exitwhen s__AstaSpells__AstaSpells_W_u[this] == null
                            if IsUnitEnemy(s__AstaSpells__AstaSpells_W_u[this], GetOwningPlayer(s__AstaSpells__AstaSpells_W_c[this])) and SpellBool(s__AstaSpells__AstaSpells_W_u[this]) then
                                set s__AstaSpells__AstaSpells_W_k2[this]=s__AstaSpells__AstaSpells_W_k2[this] + 1
                                if s__AstaSpells__AstaSpells_W_k2[this] == 1 then
                                    call MakeSound("war3mapImported\\Hero_Kirito_Q2")
                                endif
                                if not IsUnitInGroup(s__AstaSpells__AstaSpells_W_u[this], s__AstaSpells__AstaSpells_W_g2[this]) then
                                    set GearDamageNextSource=('A0DM') // INLINED!!
                                    call dmgphys(s__AstaSpells__AstaSpells_W_c[this] , s__AstaSpells__AstaSpells_W_u[this] , s__AstaSpells__AstaSpells_W_dmg[this])
                                    call GroupAddUnit(s__AstaSpells__AstaSpells_W_g2[this], s__AstaSpells__AstaSpells_W_u[this])
                                    call StunUnit(s__AstaSpells__AstaSpells_W_c[this] , s__AstaSpells__AstaSpells_W_u[this] , AstaW_Stun)
                                    call MUE(s__AstaSpells__AstaSpells_W_u[this] , 400 , AstaW_PushDuration , GAngle(s__AstaSpells__AstaSpells_W_c[this] , s__AstaSpells__AstaSpells_W_u[this]))
                                    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", s__AstaSpells__AstaSpells_W_u[this], "chest"))
                                endif
                            endif
                            call GroupRemoveUnit(s__AstaSpells__AstaSpells_W_g[this], s__AstaSpells__AstaSpells_W_u[this])
                        endloop
                        if s__AstaSpells__AstaSpells_W_r2[this] > 0.0 then
                            set s__AstaSpells__AstaSpells_W_r2[this]=0.0
                            set s__AstaSpells__AstaSpells_W_x[this]=s__AstaSpells__AstaSpells_W_x[this] + 150 * Cos(s__AstaSpells__AstaSpells_W_a[this])
                            set s__AstaSpells__AstaSpells_W_y[this]=s__AstaSpells__AstaSpells_W_y[this] + 150 * Sin(s__AstaSpells__AstaSpells_W_a[this])
                            call DecorRemove(s__AstaSpells__AstaSpells_W_c[this] , s__AstaSpells__AstaSpells_W_x[this] , s__AstaSpells__AstaSpells_W_y[this] , s__AstaSpells__AstaSpells_W_aoe[this] , AstaW_DecorDamage)
                        else
                            set s__AstaSpells__AstaSpells_W_r2[this]=s__AstaSpells__AstaSpells_W_r2[this] + 0.03
                        endif
                        if s__AstaSpells__AstaSpells_W_r3[this] > 0.03 then
