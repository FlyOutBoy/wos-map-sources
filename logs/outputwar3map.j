                        call GroupEnumUnitsInRange(s__BrandishSpells__BrandishSpells_T_g[this], s__BrandishSpells__BrandishSpells_T_x[this], s__BrandishSpells__BrandishSpells_T_y[this], s__BrandishSpells__BrandishSpells_T_r8[this], NoDecor_Cond)
