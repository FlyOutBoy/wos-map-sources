                            set s__BambiettaSpells__BambiettaSpells_T_y[this]=GetUnitY(s__BambiettaSpells__BambiettaSpells_T_c[this])
                            if s__BambiettaSpells__BambiettaSpells_T_r3[this] > 0.27 then
                                set s__BambiettaSpells__BambiettaSpells_T_r3[this]=0
                                set s__BambiettaSpells__BambiettaSpells_T_check2[this]=0
                            else
                                set s__BambiettaSpells__BambiettaSpells_T_r3[this]=s__BambiettaSpells__BambiettaSpells_T_r3[this] + 0.03
                            endif
                            if s__BambiettaSpells__BambiettaSpells_T_r2[this] > 0.0 and s__BambiettaSpells__BambiettaSpells_T_check2[this] < 3 then
                                set s__BambiettaSpells__BambiettaSpells_T_r2[this]=0
                                set s__BambiettaSpells__BambiettaSpells_T_check2[this]=s__BambiettaSpells__BambiettaSpells_T_check2[this] + 1
                                if IntegerCdKey(s__BambiettaSpells__BambiettaSpells_T_c[this] , SH_ICD_SOUND_T_CD , 0.8) then
                                    call MakeSound("war3mapimported\\Hero_Bambietta_E3")
                                endif
                                set rr2=GetRandomReal(0, 359) * bj_DEGTORAD
                                set rr1=GetRandomReal(BambiettaTT_DamageAoe2 - 300, BambiettaTT_DamageAoe)
                                set x2=s__BambiettaSpells__BambiettaSpells_T_x[this] + rr1 * Cos(rr2)
                                set y2=s__BambiettaSpells__BambiettaSpells_T_y[this] + rr1 * Sin(rr2)
                                call s__BambiettaSpells__BambiettaSpells_T_BambiettaTT2_Start(s__BambiettaSpells__BambiettaSpells_T_c[this] , x2 , y2)
                            else
                                set s__BambiettaSpells__BambiettaSpells_T_r2[this]=s__BambiettaSpells__BambiettaSpells_T_r2[this] + 0.03
                            endif
                        endif
                    endif
                    if s__BambiettaSpells__BambiettaSpells_T_r[this] == s__BambiettaSpells__BambiettaSpells_T_rmax[this] - 0.3 then
                        call SetUnitAnimationByIndex(s__BambiettaSpells__BambiettaSpells_T_c[this], 4)
                    endif
                else
                    call SetUnitTimeScale(s__BambiettaSpells__BambiettaSpells_T_c[this], 1)
                    call DestroyGroup(s__BambiettaSpells__BambiettaSpells_T_g2[this])
                    call MouseOff(GetOwningPlayer(s__BambiettaSpells__BambiettaSpells_T_c[this]))
                    call DestroyEffect(s__BambiettaSpells__BambiettaSpells_T_e[this])
                    if BambiettaT2_IsInvul then
                        call StopSpellUnit(s__BambiettaSpells__BambiettaSpells_T_c[this])
                    else
                        call StopSpellUnit2(s__BambiettaSpells__BambiettaSpells_T_c[this])
                    endif
                    set s__BambiettaSpells__BambiettaSpells_T_g[this]=null
                    set s__BambiettaSpells__BambiettaSpells_T_g2[this]=null
                    set s__BambiettaSpells__BambiettaSpells_T_c[this]=null
                    set s__BambiettaSpells__BambiettaSpells_T_u[this]=null
                    set s__BambiettaSpells__BambiettaSpells_T_m_BambiettaTT[i]=s__BambiettaSpells__BambiettaSpells_T_m_BambiettaTT[s__BambiettaSpells__BambiettaSpells_T_MUI_BambiettaTT]
                    set s__BambiettaSpells__BambiettaSpells_T_MUI_BambiettaTT=s__BambiettaSpells__BambiettaSpells_T_MUI_BambiettaTT - 1
                    if s__BambiettaSpells__BambiettaSpells_T_MUI_BambiettaTT == - 1 then
                        call BambiettaSpells__BambiettaTimer03Release()
                    endif
                    call s__BambiettaSpells__BambiettaSpells_T_deallocate(this)
                    set i=i - 1
                endif
                set i=i + 1
            endloop
        endfunction

        function s__BambiettaSpells__BambiettaSpells_T_BambiettaTT_Start takes unit NewC returns nothing
            local integer this= s__BambiettaSpells__BambiettaSpells_T__allocate()
            set s__BambiettaSpells__BambiettaSpells_T_MUI_BambiettaTT=s__BambiettaSpells__BambiettaSpells_T_MUI_BambiettaTT + 1
            set s__BambiettaSpells__BambiettaSpells_T_m_BambiettaTT[s__BambiettaSpells__BambiettaSpells_T_MUI_BambiettaTT]=this
            set s__BambiettaSpells__BambiettaSpells_T_c[this]=NewC
            set s__BambiettaSpells__BambiettaSpells_T_x[this]=GetUnitX(s__BambiettaSpells__BambiettaSpells_T_c[this])
            set s__BambiettaSpells__BambiettaSpells_T_y[this]=GetUnitY(s__BambiettaSpells__BambiettaSpells_T_c[this])
            set s__BambiettaSpells__BambiettaSpells_T_r[this]=0
            set s__BambiettaSpells__BambiettaSpells_T_r2[this]=0
            set s__BambiettaSpells__BambiettaSpells_T_r3[this]=0
            set s__BambiettaSpells__BambiettaSpells_T_r5[this]=0
            set s__BambiettaSpells__BambiettaSpells_T_e[this]=null
            call StartSpellUnit2(s__BambiettaSpells__BambiettaSpells_T_c[this])
            set s__BambiettaSpells__BambiettaSpells_T_k[this]=0
            set s__BambiettaSpells__BambiettaSpells_T_u[this]=null
            set s__BambiettaSpells__BambiettaSpells_T_g[this]=null
            set s__BambiettaSpells__BambiettaSpells_T_g2[this]=CreateGroup()
            set s__BambiettaSpells__BambiettaSpells_T_u[this]=null
            set s__BambiettaSpells__BambiettaSpells_T_check2[this]=0
            set s__BambiettaSpells__BambiettaSpells_T_a[this]=GetUnitFacing(s__BambiettaSpells__BambiettaSpells_T_c[this]) * bj_DEGTORAD
            set s__BambiettaSpells__BambiettaSpells_T_rmax[this]=BambiettaTT_Duration
            set s__BambiettaSpells__BambiettaSpells_T_move[this]=40
            call BlzSetUnitFacingEx(s__BambiettaSpells__BambiettaSpells_T_c[this], s__BambiettaSpells__BambiettaSpells_T_a[this] * bj_RADTODEG)
            set s__BambiettaSpells__BambiettaSpells_T_aoe[this]=BambiettaTT_DamageAoe
            call SetUnitAnimationByIndex(s__BambiettaSpells__BambiettaSpells_T_c[this], 0)
            call SetUnitTimeScale(s__BambiettaSpells__BambiettaSpells_T_c[this], 1.45)
            set s__BambiettaSpells__BambiettaSpells_T_k[this]=GetRandomInt(1, 2)
            set s__BambiettaSpells__BambiettaSpells_T_x1[this]=s__BambiettaSpells__BambiettaSpells_T_x[this] + 500 * Cos(s__BambiettaSpells__BambiettaSpells_T_a[this])
            set s__BambiettaSpells__BambiettaSpells_T_y1[this]=s__BambiettaSpells__BambiettaSpells_T_y[this] + 500 * Sin(s__BambiettaSpells__BambiettaSpells_T_a[this])
            call SetMouseX(GetOwningPlayer(s__BambiettaSpells__BambiettaSpells_T_c[this]) , s__BambiettaSpells__BambiettaSpells_T_x1[this])
            call SetMouseY(GetOwningPlayer(s__BambiettaSpells__BambiettaSpells_T_c[this]) , s__BambiettaSpells__BambiettaSpells_T_y1[this])
            call MouseOn(GetOwningPlayer(s__BambiettaSpells__BambiettaSpells_T_c[this]))
            if s__BambiettaSpells__BambiettaSpells_T_k[this] == 1 then
                call MakeSound("war3mapimported\\Hero_Bambietta_TT")
            elseif s__BambiettaSpells__BambiettaSpells_T_k[this] == 2 then
                call MakeSound("war3mapimported\\Hero_Bambietta_TT3")
            endif
            if s__BambiettaSpells__BambiettaSpells_T_MUI_BambiettaTT == 0 then
                call BambiettaSpells__BambiettaTimer03Acquire()
            endif
        endfunction

