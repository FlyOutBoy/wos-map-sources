                            else
                                set s__AlucardSpells__AlucardSpells_R_r2[this]=s__AlucardSpells__AlucardSpells_R_r2[this] + 0.05
                            endif
                            if s__AlucardSpells__AlucardSpells_R_r3[this] > 0.25 and s__AlucardSpells__AlucardSpells_R_r[this] > 0.5 then
                                set s__AlucardSpells__AlucardSpells_R_r3[this]=0
                                call DestroyEffect(EffectSpawn("war3mapimported\\wos_Opdef17 (282).mdl" , s__AlucardSpells__AlucardSpells_R_x[this] , s__AlucardSpells__AlucardSpells_R_y[this] , GetRandomReal(0, 359) , 0.75 , 3.5 , 55))
                            else
                                set s__AlucardSpells__AlucardSpells_R_r3[this]=s__AlucardSpells__AlucardSpells_R_r3[this] + 0.05
                            endif
                        endif
