    function GojoSpells__InitGojoSpells takes nothing returns nothing
        set GojoSpells__GojoTimer03=CreateTimer()
        set GojoSpells__GojoTimer05=CreateTimer()
        set GojoSpells__GojoTimer03Callback=function GojoSpells__GojoTimer03Loop
        set GojoSpells__GojoTimer05Callback=function GojoSpells__GojoTimer05Loop
        // Checkpoint 27: the Six Eyes passive (former G) sits on the F button
        // (1:1). Button X is not an editable field in object-data JSON.
        call BlzSetAbilityPosX(GojoF_ID, 1)
        call BlzSetAbilityPosY(GojoF_ID, 1)
    endfunction

