                    else
                        if IsUnitPaused(s__FrierenSpells__FrierenSpells_T_c[this]) == false then
                            set s__FrierenSpells__FrierenSpells_T_r[this]=I2R(R2I(( s__FrierenSpells__FrierenSpells_T_r[this] + 0.03 ) * 1000.0 + 0.5)) / 1000.0
                        endif
