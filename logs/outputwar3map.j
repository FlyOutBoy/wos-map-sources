call ExecuteFunc("jasshelper__initstructs9697234")
call ExecuteFunc("TestKyorakuSounds__Init")
call ExecuteFunc("WOSTestMinimalRuntime__InitWOSTestMinimalRuntime")
call ExecuteFunc("GearSystems2___InitGearSystems2")
