                    set s__ItemsElementsFx_tx[this]=GetUnitX(s__ItemsElementsFx_c[this])
                    set s__ItemsElementsFx_ty[this]=GetUnitY(s__ItemsElementsFx_c[this])
                    set s__ItemsElementsFx_phase[this]=1
                    call BlzSetSpecialEffectYaw(s__ItemsElementsFx_e[this], Atan2(s__ItemsElementsFx_ty[this] - s__ItemsElementsFx_y[this] - s__ItemsElementsFx_next[this] * Sin(a - 0.35), s__ItemsElementsFx_tx[this] - s__ItemsElementsFx_x[this] - s__ItemsElementsFx_next[this] * Cos(a - 0.35)) + 0.5 * bj_PI)
                    call BlzSetSpecialEffectYaw(s__ItemsElementsFx_e2[this], Atan2(s__ItemsElementsFx_ty[this] - s__ItemsElementsFx_y[this] - s__ItemsElementsFx_next[this] * Sin(a), s__ItemsElementsFx_tx[this] - s__ItemsElementsFx_x[this] - s__ItemsElementsFx_next[this] * Cos(a)) + 0.5 * bj_PI)
                    call BlzSetSpecialEffectYaw(s__ItemsElementsFx_e3[this], Atan2(s__ItemsElementsFx_ty[this] - s__ItemsElementsFx_y[this] - s__ItemsElementsFx_next[this] * Sin(a + 0.35), s__ItemsElementsFx_tx[this] - s__ItemsElementsFx_x[this] - s__ItemsElementsFx_next[this] * Cos(a + 0.35)) + 0.5 * bj_PI)
                endif
