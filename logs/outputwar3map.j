                    set a=1.0 + 1.5 * d
                    if showVision then
                        call VisionTimed(GetOwningPlayer(s__ItemsElementsFx_c[this]) , s__ItemsElementsFx_x[this] , s__ItemsElementsFx_y[this] , RMaxBJ(750.0, ConstellationCoil_Width * a * 1.5) , 0.3)
                    endif
                    call BlzSetSpecialEffectScale(s__ItemsElementsFx_e[this], ConstellationCoil_ProjectileScale * a)
                    call BlzSetSpecialEffectScale(s__ItemsElementsFx_e2[this], 0.9 * a)
                    call BlzSetSpecialEffectAlpha(s__ItemsElementsFx_e[this], R2I(255.0 - 100.0 * d))
                    call BlzSetSpecialEffectAlpha(s__ItemsElementsFx_e2[this], R2I(255.0 - 100.0 * d))
                    call BlzSetSpecialEffectYaw(s__ItemsElementsFx_e[this], s__ItemsElementsFx_step[this] * 12.0)
                    set s__ItemsElementsFx_next[this]=s__ItemsElementsFx_next[this] - s__ItemsElementsFx_DT
                    if s__ItemsElementsFx_next[this] <= 0.0 and s__ItemsElementsFx_charges[this] < 4 then
