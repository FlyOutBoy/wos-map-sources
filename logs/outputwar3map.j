            set s__HarribelSpells___HarribelSpells_G_k2[this]=GetPlayerId(GetOwningPlayer(s__HarribelSpells___HarribelSpells_G_c[this]))
            if s__HarribelSpells___HarribelSpells_G_MUI_HarribelG == 0 then
                call HarribelSpells___HarribelTick10_On(0)
            endif
        endfunction


