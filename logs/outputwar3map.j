            call StartSpellUnit2(s__MahoragaSpells___MahoragaSpells_F_c[this])
            call SaveInteger(hs, GetHandleId(s__MahoragaSpells___MahoragaSpells_F_c[this]), KEY_SHIELD, 1) // shielded (Laxus T style), not invulnerable
            set s__MahoragaSpells___MahoragaSpells_F_g[this]=CreateGroup()
            set s__MahoragaSpells___MahoragaSpells_F_g2[this]=CreateGroup()
            set s__MahoragaSpells___MahoragaSpells_F_u[this]=null
            set s__MahoragaSpells___MahoragaSpells_F_a[this]=GAngle2(s__MahoragaSpells___MahoragaSpells_F_c[this] , s__MahoragaSpells___MahoragaSpells_F_x[this] , s__MahoragaSpells___MahoragaSpells_F_y[this]) // Angle Between points
            set s__MahoragaSpells___MahoragaSpells_F_check[this]=0
           // call DestroyEffect(EffectSpawn("war3mapimported\\wos_HakkeStart.mdx", GetUnitX(c), GetUnitY(c), GetRandomReal(0, 359), 0.3, 1.45, 7))
            set s__MahoragaSpells___MahoragaSpells_F_aoe[this]=MahoragaF_DamageAoe
            set s__MahoragaSpells___MahoragaSpells_F_dmg[this]=GetHeroAgi(s__MahoragaSpells___MahoragaSpells_F_c[this], true) * MahoragaF_DamageAgiBase
            set s__MahoragaSpells___MahoragaSpells_F_rmax[this]=3
            call SetUnitAnimationByIndex(s__MahoragaSpells___MahoragaSpells_F_c[this], 3)
            call SetUnitTimeScale(s__MahoragaSpells___MahoragaSpells_F_c[this], 0.5)
            call MakeSound("war3mapimported\\Hero_Mahoraga_F")
            if s__MahoragaSpells___MahoragaSpells_F_MUI_MahoragaF == 0 then
                call MahoragaSpells___MahoragaTick_On(8)
            endif
        endfunction



        function s__MahoragaSpells___MahoragaSpells_G_Loop_MahoragaG takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__MahoragaSpells___MahoragaSpells_G_MUI_MahoragaG
                set this=s__MahoragaSpells___MahoragaSpells_G_m_MahoragaG[i]
                if true then
                    if GetHeroLevel(s__MahoragaSpells___MahoragaSpells_G_c[this]) >= 25 then
                        if CheckCoordsInRect(gg_rct_Base , GetUnitX(s__MahoragaSpells___MahoragaSpells_G_c[this]) , GetUnitY(s__MahoragaSpells___MahoragaSpells_G_c[this])) or IsUnitType(s__MahoragaSpells___MahoragaSpells_G_c[this], UNIT_TYPE_DEAD) then
                            if s__MahoragaSpells___MahoragaSpells_G_d[this] != null then
                                    call SaveInteger(hs, GetHandleId(s__MahoragaSpells___MahoragaSpells_G_c[this]), MahoragaSpells___SH_STACK_5, 0)
                                call RemoveUnit(s__MahoragaSpells___MahoragaSpells_G_d[this])
                                call SetPlayerAbilityAvailable(GetOwningPlayer(s__MahoragaSpells___MahoragaSpells_G_c[this]), MahoragaW_ID, true)
                                call SetPlayerAbilityAvailable(GetOwningPlayer(s__MahoragaSpells___MahoragaSpells_G_c[this]), MahoragaW2_ID, false)
                                set s__MahoragaSpells___MahoragaSpells_G_d[this]=null
                            endif
                        else
                            set s__MahoragaSpells___MahoragaSpells_G_k[this]=0
                            set s__MahoragaSpells___MahoragaSpells_G_x[this]=GetUnitX(s__MahoragaSpells___MahoragaSpells_G_c[this])
                            set s__MahoragaSpells___MahoragaSpells_G_y[this]=GetUnitY(s__MahoragaSpells___MahoragaSpells_G_c[this])
                            call GroupEnumUnitsInRange(s__MahoragaSpells___MahoragaSpells_G_g[this], s__MahoragaSpells___MahoragaSpells_G_x[this], s__MahoragaSpells___MahoragaSpells_G_y[this], s__MahoragaSpells___MahoragaSpells_G_aoe[this], NoDecor_Cond)
                            loop
                                set s__MahoragaSpells___MahoragaSpells_G_u[this]=FirstOfGroup(s__MahoragaSpells___MahoragaSpells_G_g[this])
                                exitwhen s__MahoragaSpells___MahoragaSpells_G_u[this] == null
                                if SpellBool(s__MahoragaSpells___MahoragaSpells_G_u[this]) and IsUnitEnemy(s__MahoragaSpells___MahoragaSpells_G_u[this], GetOwningPlayer(s__MahoragaSpells___MahoragaSpells_G_c[this])) and ( GetUnitAbilityLevel(s__MahoragaSpells___MahoragaSpells_G_u[this], MahoragaT_Abi_ID3) > 0 or GetUnitAbilityLevel(s__MahoragaSpells___MahoragaSpells_G_u[this], MahoragaT_Abi_ID4) > 0 or GetUnitAbilityLevel(s__MahoragaSpells___MahoragaSpells_G_u[this], MahoragaT_Abi_ID5) > 0 or GetUnitAbilityLevel(s__MahoragaSpells___MahoragaSpells_G_u[this], MahoragaT_Abi_ID6) > 0 or GetUnitAbilityLevel(s__MahoragaSpells___MahoragaSpells_G_u[this], MahoragaT_Abi_ID7) > 0 or GetUnitAbilityLevel(s__MahoragaSpells___MahoragaSpells_G_u[this], MahoragaT_Abi_ID8) > 0 ) then
                                    set s__MahoragaSpells___MahoragaSpells_G_k[this]=1
                                endif
                                call GroupRemoveUnit(s__MahoragaSpells___MahoragaSpells_G_g[this], s__MahoragaSpells___MahoragaSpells_G_u[this])
                            endloop
                            set s__MahoragaSpells___MahoragaSpells_G_u[this]=null
                            if BlzGetUnitAbilityCooldownRemaining(s__MahoragaSpells___MahoragaSpells_G_c[this], MahoragaW2_ID) != 0 or s__MahoragaSpells___MahoragaSpells_G_d[this] == null then
                                    call SetPlayerAbilityAvailable(GetOwningPlayer(s__MahoragaSpells___MahoragaSpells_G_c[this]), MahoragaW_ID, true)
                                    call SetPlayerAbilityAvailable(GetOwningPlayer(s__MahoragaSpells___MahoragaSpells_G_c[this]), MahoragaW2_ID, false)
                                    else
                                    call SetPlayerAbilityAvailable(GetOwningPlayer(s__MahoragaSpells___MahoragaSpells_G_c[this]), MahoragaW_ID, false)
                                    call SetPlayerAbilityAvailable(GetOwningPlayer(s__MahoragaSpells___MahoragaSpells_G_c[this]), MahoragaW2_ID, true)
                            endif
                            if s__MahoragaSpells___MahoragaSpells_G_k[this] == 1 then
                                if s__MahoragaSpells___MahoragaSpells_G_d[this] == null then
                                    call UnitAddAbility(s__MahoragaSpells___MahoragaSpells_G_c[this], MahoragaW2_ID)
                                    call SaveInteger(hs, GetHandleId(s__MahoragaSpells___MahoragaSpells_G_c[this]), MahoragaSpells___SH_STACK_5, 1)
                                    set s__MahoragaSpells___MahoragaSpells_G_d[this]=CreateUnit(GetOwningPlayer(s__MahoragaSpells___MahoragaSpells_G_c[this]), MahoragaT_Unit_ID, GetRectCenterX(gg_rct_Caster), GetRectCenterY(gg_rct_Caster), 1)
                                endif
                            else
                                if s__MahoragaSpells___MahoragaSpells_G_d[this] != null then
                                    call SaveInteger(hs, GetHandleId(s__MahoragaSpells___MahoragaSpells_G_c[this]), MahoragaSpells___SH_STACK_5, 0)
                                    call RemoveUnit(s__MahoragaSpells___MahoragaSpells_G_d[this])
                                    set s__MahoragaSpells___MahoragaSpells_G_d[this]=null
                                endif
                            endif
                        endif
                    endif
                else
                    set s__MahoragaSpells___MahoragaSpells_G_c[this]=null
                    set s__MahoragaSpells___MahoragaSpells_G_g[this]=null
                    set s__MahoragaSpells___MahoragaSpells_G_u[this]=null
                    set s__MahoragaSpells___MahoragaSpells_G_m_MahoragaG[i]=s__MahoragaSpells___MahoragaSpells_G_m_MahoragaG[s__MahoragaSpells___MahoragaSpells_G_MUI_MahoragaG]
                    set s__MahoragaSpells___MahoragaSpells_G_MUI_MahoragaG=s__MahoragaSpells___MahoragaSpells_G_MUI_MahoragaG - 1
                    set i=i - 1 // revisit: the moved instance must not skip this tick
                    if s__MahoragaSpells___MahoragaSpells_G_MUI_MahoragaG == - 1 then
                        call MahoragaSpells___MahoragaTick10_Off(0)
                    endif
                    call s__MahoragaSpells___MahoragaSpells_G_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction

        function s__MahoragaSpells___MahoragaSpells_G_MahoragaG_Start takes unit NewC returns nothing
            local integer this= s__MahoragaSpells___MahoragaSpells_G__allocate()
            set s__MahoragaSpells___MahoragaSpells_G_MUI_MahoragaG=s__MahoragaSpells___MahoragaSpells_G_MUI_MahoragaG + 1
            set s__MahoragaSpells___MahoragaSpells_G_m_MahoragaG[s__MahoragaSpells___MahoragaSpells_G_MUI_MahoragaG]=this
            set s__MahoragaSpells___MahoragaSpells_G_c[this]=NewC
            set s__MahoragaSpells___MahoragaSpells_G_check[this]=1
            set s__MahoragaSpells___MahoragaSpells_G_k2[this]=GetPlayerId(GetOwningPlayer(s__MahoragaSpells___MahoragaSpells_G_c[this]))
            set s__MahoragaSpells___MahoragaSpells_G_r2[this]=0
            set s__MahoragaSpells___MahoragaSpells_G_r3[this]=0
            set s__MahoragaSpells___MahoragaSpells_G_g[this]=CreateGroup()
            set s__MahoragaSpells___MahoragaSpells_G_aoe[this]=MahoragaT_CondAoeFind
            set s__MahoragaSpells___MahoragaSpells_G_r[this]=0
            if s__MahoragaSpells___MahoragaSpells_G_MUI_MahoragaG == 0 then
                call MahoragaSpells___MahoragaTick10_On(0)
            endif
        endfunction


    //----------------------------Mahoraga-----------------------------------------------
      
     function BuffMahoragaWheel takes unit c,unit u,integer level returns nothing
            local integer i= GetPlayerId(GetOwningPlayer(c))
            if mahodummy1[i] == null or GetWidgetLife(mahodummy1[i]) < 1 then
                set mahodummy1[i]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'h0C9', GetRectCenterX(gg_rct_Caster), GetRectCenterY(gg_rct_Caster), 0)
                call UnitAddAbility(mahodummy1[i], 'A0D1')
            endif
            if level > 0 then
                if GetUnitAbilityLevel(mahodummy1[i], 'A0D1') == 0 then
                    call UnitAddAbility(mahodummy1[i], 'A0D1')
                endif
                call SetUnitAbilityLevel(mahodummy1[i], 'A0D1', level)
                call SetUnitFacing(mahodummy1[i], GAngle(mahodummy1[i] , u) * bj_RADTODEG)
                call IssueTargetOrder(mahodummy1[i], "curse", u)
            endif
        endfunction
