//================================ Crocodile E - Crescent Cutlass ========================================


        function s__CrocodileSpells__CrocodileE_Struct_CrocodileE_SetTimeScale takes integer this,real speed returns nothing
            set s__CrocodileSpells__CrocodileE_Struct_animationRate[this]=speed
            set s__CrocodileSpells__CrocodileE_Struct_slashRate[this]=speed
            call SetUnitTimeScale(s__CrocodileSpells__CrocodileE_Struct_c[this], speed)
            if s__CrocodileSpells__CrocodileE_Struct_e[this] != null then
                call BlzSetSpecialEffectTimeScale(s__CrocodileSpells__CrocodileE_Struct_e[this], speed)
            endif
            if s__CrocodileSpells__CrocodileE_Struct_e2[this] != null then
                call BlzSetSpecialEffectTimeScale(s__CrocodileSpells__CrocodileE_Struct_e2[this], speed)
            endif
            if s__CrocodileSpells__CrocodileE_Struct_e3[this] != null then
                call BlzSetSpecialEffectTimeScale(s__CrocodileSpells__CrocodileE_Struct_e3[this], speed)
            endif
        endfunction

        function s__CrocodileSpells__CrocodileE_Struct_CrocodileE_BreakSlash takes integer this returns nothing
            if s__CrocodileSpells__CrocodileE_Struct_e2[this] != null then
                call BlzSetSpecialEffectTimeScale(s__CrocodileSpells__CrocodileE_Struct_e2[this], 1.0)
                call BlzPlaySpecialEffect(s__CrocodileSpells__CrocodileE_Struct_e2[this], ANIM_TYPE_DEATH)
                call ColorEffDummy3Alpha((s__CrocodileSpells__CrocodileE_Struct_e2[this] ) , (( 0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.15)*1.0)) // INLINED!!
                // The fade helper owns destruction; only the caster keeps moving.
                set s__CrocodileSpells__CrocodileE_Struct_e2[this]=null
                set s__CrocodileSpells__CrocodileE_Struct_slashRate[this]=0.0
            endif
        endfunction

        function s__CrocodileSpells__CrocodileE_Struct_CrocodileE_Finish takes integer this returns nothing
            // Release the cast before sand/VFX helpers can execute other code.
            set s__CrocodileSpells__CrocodileE_Struct_active[this]=false
            call FlushChildHashtable(CrocodileSpells__CrocodileDecorHits, s__CrocodileSpells__CrocodileE_Struct_decorKey[this])
            if s__CrocodileSpells__CrocodileE_Struct_castPauseHeld[this] then
                set s__CrocodileSpells__CrocodileE_Struct_castPauseHeld[this]=false
                call StopSpellUnit2(s__CrocodileSpells__CrocodileE_Struct_c[this])
            endif
            if LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileE_Struct_c[this]), CrocodileSpells__CrocodileT_PhaseKey) == 0 then
                call SetUnitTimeScale(s__CrocodileSpells__CrocodileE_Struct_c[this], 1.0)
            endif
            call DestroyGroup(s__CrocodileSpells__CrocodileE_Struct_g[this])
            set s__CrocodileSpells__CrocodileE_Struct_g[this]=null
            if s__CrocodileSpells__CrocodileE_Struct_e[this] != null then
                call BlzSetSpecialEffectTimeScale(s__CrocodileSpells__CrocodileE_Struct_e[this], 1.0)
                call s__GearSystems2___KS_RemoveEffect_MyRemoveEff_Start((s__CrocodileSpells__CrocodileE_Struct_e[this] ) , (( 0.3)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
                set s__CrocodileSpells__CrocodileE_Struct_e[this]=null
            endif
            if s__CrocodileSpells__CrocodileE_Struct_e3[this] != null then
                call BlzSetSpecialEffectTimeScale(s__CrocodileSpells__CrocodileE_Struct_e3[this], 1.0)
                call s__GearSystems2___KS_RemoveEffect_MyRemoveEff_Start((s__CrocodileSpells__CrocodileE_Struct_e3[this] ) , (( 0.3)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
                set s__CrocodileSpells__CrocodileE_Struct_e3[this]=null
            endif
            call s__CrocodileSpells__CrocodileE_Struct_CrocodileE_BreakSlash(this)
            if not s__CrocodileSpells__CrocodileE_Struct_cancelDash[this] and SpellBoolCaster(s__CrocodileSpells__CrocodileE_Struct_c[this]) and not s__CrocodileSpells__CrocodileE_Struct_hitStarted[this] and s__CrocodileSpells__CrocodileE_Struct_distance[this] + 0.001 >= s__CrocodileSpells__CrocodileE_Struct_maxDistance[this] then
                call s__CrocodileSpells__CrocodileSand_Struct_CrocodileSand_Start(s__CrocodileSpells__CrocodileE_Struct_c[this] , GetUnitX(s__CrocodileSpells__CrocodileE_Struct_c[this]) + CrocodileE_HitOffset * s__CrocodileSpells__CrocodileE_Struct_dirX[this] , GetUnitY(s__CrocodileSpells__CrocodileE_Struct_c[this]) + CrocodileE_HitOffset * s__CrocodileSpells__CrocodileE_Struct_dirY[this] , CrocodileE_SandAoe , false)
            endif
        endfunction

        function s__CrocodileSpells__CrocodileE_Struct_CrocodileE_DamagePulse takes integer this returns nothing
            local unit u
            call GroupEnumUnitsInRange(s__CrocodileSpells__CrocodileE_Struct_g[this], s__CrocodileSpells__CrocodileE_Struct_hitX[this], s__CrocodileSpells__CrocodileE_Struct_hitY[this], s__CrocodileSpells__CrocodileE_Struct_radius[this], NoDecor_Cond)
            loop
                set u=FirstOfGroup(s__CrocodileSpells__CrocodileE_Struct_g[this])
                exitwhen u == null or s__CrocodileSpells__CrocodileE_Struct_cancelDash[this] or not SpellBoolCaster(s__CrocodileSpells__CrocodileE_Struct_c[this])
                call GroupRemoveUnit(s__CrocodileSpells__CrocodileE_Struct_g[this], u)
                if SpellBool(u) and IsUnitEnemy(u, GetOwningPlayer(s__CrocodileSpells__CrocodileE_Struct_c[this])) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) then
                    set GearDamageNextSource=('A0I9') // INLINED!!
                    call dmgphys(s__CrocodileSpells__CrocodileE_Struct_c[this] , u , s__CrocodileSpells__CrocodileE_Struct_pulseDamage[this])
                    call SlowUnit(s__CrocodileSpells__CrocodileE_Struct_c[this] , u , CrocodileE_Slow , 2)
                    call DestroyEffect(AddSpecialEffectTarget("Units\\Critters\\Albatross\\Albatross.mdl", u, "chest"))
                endif
            endloop
            set u=null
        endfunction


        function s__CrocodileSpells__CrocodileE_Struct_CrocodileE_TryContact takes integer this,real oldX,real oldY returns nothing
            local unit u
            local real dx= s__CrocodileSpells__CrocodileE_Struct_x[this] - oldX
            local real dy= s__CrocodileSpells__CrocodileE_Struct_y[this] - oldY
            local real lengthSq= dx * dx + dy * dy
            local real frontX= oldX + CrocodileE_HitOffset * s__CrocodileSpells__CrocodileE_Struct_dirX[this]
            local real frontY= oldY + CrocodileE_HitOffset * s__CrocodileSpells__CrocodileE_Struct_dirY[this]
            local real fraction
            local real bestFraction= 2.0
            local real targetX= 0.0
            local real targetY= 0.0
            local real nearX
            local real nearY
            local real targetDX
            local real targetDY
            local real unitX
            local real unitY
            local real radiusSq= s__CrocodileSpells__CrocodileE_Struct_radius[this] * s__CrocodileSpells__CrocodileE_Struct_radius[this]
            // Broad scan once, then test distance to the swept front circle.
            call GroupEnumUnitsInRange(s__CrocodileSpells__CrocodileE_Struct_g[this], frontX + dx / 2, frontY + dy / 2, s__CrocodileSpells__CrocodileE_Struct_radius[this] + SquareRoot(lengthSq) / 2, NoDecor_Cond)
            loop
                set u=FirstOfGroup(s__CrocodileSpells__CrocodileE_Struct_g[this])
                exitwhen u == null
                call GroupRemoveUnit(s__CrocodileSpells__CrocodileE_Struct_g[this], u)
                if SpellBool(u) and IsUnitEnemy(u, GetOwningPlayer(s__CrocodileSpells__CrocodileE_Struct_c[this])) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) then
                    set unitX=GetUnitX(u)
                    set unitY=GetUnitY(u)
                    if ( unitX - oldX ) * s__CrocodileSpells__CrocodileE_Struct_dirX[this] + ( unitY - oldY ) * s__CrocodileSpells__CrocodileE_Struct_dirY[this] >= 0.0 then
                        set fraction=0.0
                        set targetDX=unitX - frontX
                        set targetDY=unitY - frontY
                        if lengthSq > 0.001 and targetDX * targetDX + targetDY * targetDY > radiusSq then
                            set fraction=RMaxBJ(0.0, RMinBJ(1.0, ( targetDX * dx + targetDY * dy ) / lengthSq))
                        endif
                        set nearX=unitX - frontX - fraction * dx
                        set nearY=unitY - frontY - fraction * dy
                        if fraction < bestFraction and nearX * nearX + nearY * nearY <= radiusSq then
                            set bestFraction=fraction
                            set targetX=unitX
                            set targetY=unitY
                        endif
                    endif
                endif
            endloop
            if bestFraction <= 1.0 then
                set s__CrocodileSpells__CrocodileE_Struct_hitStarted[this]=true
                call MoveUnit(s__CrocodileSpells__CrocodileE_Struct_c[this] , SquareRoot(lengthSq) * ( bestFraction - 1.0 ) , s__CrocodileSpells__CrocodileE_Struct_a[this])
                set s__CrocodileSpells__CrocodileE_Struct_x[this]=GetUnitX(s__CrocodileSpells__CrocodileE_Struct_c[this])
                set s__CrocodileSpells__CrocodileE_Struct_y[this]=GetUnitY(s__CrocodileSpells__CrocodileE_Struct_c[this])
                if s__CrocodileSpells__CrocodileE_Struct_e2[this] != null then
                    call MoveEff(s__CrocodileSpells__CrocodileE_Struct_e2[this] , SR0((BlzGetLocalSpecialEffectX((s__CrocodileSpells__CrocodileE_Struct_e2[this]))) , (BlzGetLocalSpecialEffectY((s__CrocodileSpells__CrocodileE_Struct_e2[this]))) , s__CrocodileSpells__CrocodileE_Struct_x[this] + 100 * s__CrocodileSpells__CrocodileE_Struct_dirX[this] , s__CrocodileSpells__CrocodileE_Struct_y[this] + 100 * s__CrocodileSpells__CrocodileE_Struct_dirY[this]) , Atan2(s__CrocodileSpells__CrocodileE_Struct_y[this] + 100 * s__CrocodileSpells__CrocodileE_Struct_dirY[this] - (BlzGetLocalSpecialEffectY((s__CrocodileSpells__CrocodileE_Struct_e2[this]))), s__CrocodileSpells__CrocodileE_Struct_x[this] + 100 * s__CrocodileSpells__CrocodileE_Struct_dirX[this] - (BlzGetLocalSpecialEffectX((s__CrocodileSpells__CrocodileE_Struct_e2[this]))))) // INLINED!!
                endif
                set s__CrocodileSpells__CrocodileE_Struct_hitX[this]=s__CrocodileSpells__CrocodileE_Struct_x[this] + CrocodileE_HitOffset * s__CrocodileSpells__CrocodileE_Struct_dirX[this]
                set s__CrocodileSpells__CrocodileE_Struct_hitY[this]=s__CrocodileSpells__CrocodileE_Struct_y[this] + CrocodileE_HitOffset * s__CrocodileSpells__CrocodileE_Struct_dirY[this]
                set s__CrocodileSpells__CrocodileE_Struct_hitRemaining[this]=RMaxBJ(CrocodileSpells__CrocodilePeriod, CrocodileE_HitDelay)
                if s__CrocodileSpells__CrocodileE_Struct_elapsed[this] + 0.001 >= CrocodileE_HitSlowTime then
                    set s__CrocodileSpells__CrocodileE_Struct_hitSlowed[this]=true
                    call s__CrocodileSpells__CrocodileE_Struct_CrocodileE_SetTimeScale(this,CrocodileE_HitAnimationSpeed)
                endif
                call DestroyEffect(EffectSpawn("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl" , s__CrocodileSpells__CrocodileE_Struct_hitX[this] , s__CrocodileSpells__CrocodileE_Struct_hitY[this] , 0 , 1 , s__CrocodileSpells__CrocodileE_Struct_radius[this] / 150.0 , 0))
                // Contact deals damage immediately; animation progress never gates it.
                set s__CrocodileSpells__CrocodileE_Struct_hitTicks[this]=1
                call s__CrocodileSpells__CrocodileE_Struct_CrocodileE_DamagePulse(this)
                if s__CrocodileSpells__CrocodileE_Struct_hitTicks[this] >= s__CrocodileSpells__CrocodileE_Struct_hitMaxTicks[this] then
                    set s__CrocodileSpells__CrocodileE_Struct_hitRemaining[this]=0.0
                    call s__CrocodileSpells__CrocodileE_Struct_CrocodileE_SetTimeScale(this,1.0)
                    call s__CrocodileSpells__CrocodileE_Struct_CrocodileE_BreakSlash(this)
                endif
                call s__CrocodileSpells__CrocodileSand_Struct_CrocodileSand_Start(s__CrocodileSpells__CrocodileE_Struct_c[this] , targetX , targetY , CrocodileE_SandAoe , false)
            endif
            set u=null
        endfunction

        function s__CrocodileSpells__CrocodileE_Struct_Loop_CrocodileE takes nothing returns nothing
            local integer this
            local integer i= 0
            local integer count
            local integer capacity
            local real remaining
            local real step
            local real oldX
            local real oldY
            loop
                exitwhen i > s__CrocodileSpells__CrocodileE_Struct_MUI
                set this=s__CrocodileSpells__CrocodileE_Struct_m[i]
//---------------- E: three independent recharge clocks ----------------------
                // Check the bound before UI, movement and hit helpers. If a
                // previous tick aborted in one of them, the cast still unlocks.
                if s__CrocodileSpells__CrocodileE_Struct_active[this] then
                    set s__CrocodileSpells__CrocodileE_Struct_elapsed[this]=s__CrocodileSpells__CrocodileE_Struct_elapsed[this] + CrocodileSpells__CrocodilePeriod
                    if s__CrocodileSpells__CrocodileE_Struct_cancelDash[this] or s__CrocodileSpells__CrocodileE_Struct_elapsed[this] + 0.001 >= s__CrocodileSpells__CrocodileE_Struct_rmax[this] or not SpellBoolCaster(s__CrocodileSpells__CrocodileE_Struct_c[this]) or LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileE_Struct_c[this]), CrocodileSpells__CrocodileCore_DataKey) == 0 then
                        call s__CrocodileSpells__CrocodileE_Struct_CrocodileE_Finish(this)
                    endif
                endif
                set s__CrocodileSpells__CrocodileE_Struct_useCooldown[this]=RMaxBJ(0.0, s__CrocodileSpells__CrocodileE_Struct_useCooldown[this] - CrocodileSpells__CrocodilePeriod)
                set s__CrocodileSpells__CrocodileE_Struct_charge1[this]=RMaxBJ(0.0, s__CrocodileSpells__CrocodileE_Struct_charge1[this] - CrocodileSpells__CrocodilePeriod)
                set s__CrocodileSpells__CrocodileE_Struct_charge2[this]=RMaxBJ(0.0, s__CrocodileSpells__CrocodileE_Struct_charge2[this] - CrocodileSpells__CrocodilePeriod)
                set s__CrocodileSpells__CrocodileE_Struct_charge3[this]=RMaxBJ(0.0, s__CrocodileSpells__CrocodileE_Struct_charge3[this] - CrocodileSpells__CrocodilePeriod)
                set count=0
                set capacity=CrocodileSpells__CrocodileE_MaxCharges(s__CrocodileSpells__CrocodileE_Struct_c[this])
                set remaining=999999.0
                if capacity >= 1 and s__CrocodileSpells__CrocodileE_Struct_charge1[this] == 0.0 then
                    set count=count + 1
                elseif capacity >= 1 then
                    set remaining=RMinBJ(remaining, s__CrocodileSpells__CrocodileE_Struct_charge1[this])
                endif
                if capacity >= 2 and s__CrocodileSpells__CrocodileE_Struct_charge2[this] == 0.0 then
                    set count=count + 1
                elseif capacity >= 2 then
                    set remaining=RMinBJ(remaining, s__CrocodileSpells__CrocodileE_Struct_charge2[this])
                endif
                if capacity >= 3 and s__CrocodileSpells__CrocodileE_Struct_charge3[this] == 0.0 then
                    set count=count + 1
                elseif capacity >= 3 then
                    set remaining=RMinBJ(remaining, s__CrocodileSpells__CrocodileE_Struct_charge3[this])
                endif
                if count > 0 or capacity == 0 then
                    set remaining=0.0
                endif
                set remaining=RMaxBJ(remaining, s__CrocodileSpells__CrocodileE_Struct_useCooldown[this])
                if remaining <= 0.0 then
                    if BlzGetUnitAbilityCooldownRemaining(s__CrocodileSpells__CrocodileE_Struct_c[this], CrocodileE_ID) > 0.0 then
                        call BlzEndUnitAbilityCooldown(s__CrocodileSpells__CrocodileE_Struct_c[this], CrocodileE_ID)
                    endif
                elseif BlzGetUnitAbilityCooldownRemaining(s__CrocodileSpells__CrocodileE_Struct_c[this], CrocodileE_ID) < remaining then
                    call BlzStartUnitAbilityCooldown(s__CrocodileSpells__CrocodileE_Struct_c[this], CrocodileE_ID, remaining)
                endif
                if count != s__CrocodileSpells__CrocodileE_Struct_shownCharges[this] and LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileE_Struct_c[this]), CrocodileSpells__CrocodileCore_DataKey) != 0 then
                    set s__CrocodileSpells__CrocodileE_Struct_shownCharges[this]=count
                    call TasAbilityChargeBox_SetValue(s__CrocodileSpells__CrocodileE_Struct_c[this] , CrocodileE_ID , I2S(count))
                endif
//---------------- E dash and damage: variables belong to E only ------------
                if s__CrocodileSpells__CrocodileE_Struct_active[this] then
                    if not s__CrocodileSpells__CrocodileE_Struct_cancelDash[this] and SpellBoolCaster(s__CrocodileSpells__CrocodileE_Struct_c[this]) and LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileE_Struct_c[this]), CrocodileSpells__CrocodileCore_DataKey) != 0 then
                    if s__CrocodileSpells__CrocodileE_Struct_hitRemaining[this] > 0.0 then
                        if not s__CrocodileSpells__CrocodileE_Struct_hitSlowed[this] and s__CrocodileSpells__CrocodileE_Struct_elapsed[this] + 0.001 >= CrocodileE_HitSlowTime then
                            set s__CrocodileSpells__CrocodileE_Struct_hitSlowed[this]=true
                            call s__CrocodileSpells__CrocodileE_Struct_CrocodileE_SetTimeScale(this,CrocodileE_HitAnimationSpeed)
                        endif
                        // Freeze the movement clock while dealing exactly five pulses.
                        set s__CrocodileSpells__CrocodileE_Struct_hitRemaining[this]=RMaxBJ(0.0, RoundReal(s__CrocodileSpells__CrocodileE_Struct_hitRemaining[this] - CrocodileSpells__CrocodilePeriod , 3))
                        set s__CrocodileSpells__CrocodileE_Struct_hitPulse[this]=s__CrocodileSpells__CrocodileE_Struct_hitPulse[this] + CrocodileSpells__CrocodilePeriod
                        loop
                            exitwhen s__CrocodileSpells__CrocodileE_Struct_cancelDash[this] or not SpellBoolCaster(s__CrocodileSpells__CrocodileE_Struct_c[this]) or s__CrocodileSpells__CrocodileE_Struct_hitTicks[this] >= s__CrocodileSpells__CrocodileE_Struct_hitMaxTicks[this] or ( s__CrocodileSpells__CrocodileE_Struct_hitPulse[this] + 0.001 < s__CrocodileSpells__CrocodileE_Struct_hitInterval[this] and s__CrocodileSpells__CrocodileE_Struct_hitRemaining[this] > 0.0 )
                            set s__CrocodileSpells__CrocodileE_Struct_hitPulse[this]=s__CrocodileSpells__CrocodileE_Struct_hitPulse[this] - s__CrocodileSpells__CrocodileE_Struct_hitInterval[this]
                            set s__CrocodileSpells__CrocodileE_Struct_hitTicks[this]=s__CrocodileSpells__CrocodileE_Struct_hitTicks[this] + 1
                            call s__CrocodileSpells__CrocodileE_Struct_CrocodileE_DamagePulse(this)
                        endloop
                        if s__CrocodileSpells__CrocodileE_Struct_hitTicks[this] >= s__CrocodileSpells__CrocodileE_Struct_hitMaxTicks[this] then
                            set s__CrocodileSpells__CrocodileE_Struct_hitRemaining[this]=0.0
                            call s__CrocodileSpells__CrocodileE_Struct_CrocodileE_SetTimeScale(this,1.0)
                            call s__CrocodileSpells__CrocodileE_Struct_CrocodileE_BreakSlash(this)
                        endif
                    endif
                    if s__CrocodileSpells__CrocodileE_Struct_hitRemaining[this] <= 0.0 and not s__CrocodileSpells__CrocodileE_Struct_cancelDash[this] and SpellBoolCaster(s__CrocodileSpells__CrocodileE_Struct_c[this]) then
                    set s__CrocodileSpells__CrocodileE_Struct_r[this]=RoundReal(s__CrocodileSpells__CrocodileE_Struct_r[this] + CrocodileSpells__CrocodilePeriod , 3)
                    if s__CrocodileSpells__CrocodileE_Struct_r[this] >= s__CrocodileSpells__CrocodileE_Struct_moveDelay[this] and s__CrocodileSpells__CrocodileE_Struct_check[this] == 0 then
                    set s__CrocodileSpells__CrocodileE_Struct_animationRate[this]=0.4
                    set s__CrocodileSpells__CrocodileE_Struct_slashRate[this]=1.0
                    call SetUnitTimeScale(s__CrocodileSpells__CrocodileE_Struct_c[this], s__CrocodileSpells__CrocodileE_Struct_animationRate[this])
                    set s__CrocodileSpells__CrocodileE_Struct_check[this]=1
                    if s__CrocodileSpells__CrocodileE_Struct_e2[this] != null then
                        call BlzSetSpecialEffectTimeScale(s__CrocodileSpells__CrocodileE_Struct_e2[this], 1)
                    endif
                    endif
                    if s__CrocodileSpells__CrocodileE_Struct_r[this] > s__CrocodileSpells__CrocodileE_Struct_moveDelay[this] then
                        set s__CrocodileSpells__CrocodileE_Struct_x[this]=GetUnitX(s__CrocodileSpells__CrocodileE_Struct_c[this])
                        set s__CrocodileSpells__CrocodileE_Struct_y[this]=GetUnitY(s__CrocodileSpells__CrocodileE_Struct_c[this])
                        set oldX=s__CrocodileSpells__CrocodileE_Struct_x[this]
                        set oldY=s__CrocodileSpells__CrocodileE_Struct_y[this]
                        if s__CrocodileSpells__CrocodileE_Struct_hitRemaining[this] <= 0.0 and not s__CrocodileSpells__CrocodileE_Struct_movementStopped[this] then
                            set step=RMinBJ(s__CrocodileSpells__CrocodileE_Struct_moveStep[this], s__CrocodileSpells__CrocodileE_Struct_maxDistance[this] - s__CrocodileSpells__CrocodileE_Struct_distance[this])
                            if not IsTerrainPathable(s__CrocodileSpells__CrocodileE_Struct_x[this] + step * s__CrocodileSpells__CrocodileE_Struct_dirX[this], s__CrocodileSpells__CrocodileE_Struct_y[this] + step * s__CrocodileSpells__CrocodileE_Struct_dirY[this], PATHING_TYPE_WALKABILITY) then
                                call MoveUnit(s__CrocodileSpells__CrocodileE_Struct_c[this] , step , s__CrocodileSpells__CrocodileE_Struct_a[this])
                                if s__CrocodileSpells__CrocodileE_Struct_e2[this] != null then
                                    call MoveEff(s__CrocodileSpells__CrocodileE_Struct_e2[this] , SR0(oldX , oldY , GetUnitX(s__CrocodileSpells__CrocodileE_Struct_c[this]) , GetUnitY(s__CrocodileSpells__CrocodileE_Struct_c[this])) , s__CrocodileSpells__CrocodileE_Struct_a[this])
                                endif
                            endif
                            set s__CrocodileSpells__CrocodileE_Struct_x[this]=GetUnitX(s__CrocodileSpells__CrocodileE_Struct_c[this])
                            set s__CrocodileSpells__CrocodileE_Struct_y[this]=GetUnitY(s__CrocodileSpells__CrocodileE_Struct_c[this])
                            // MAIN can refuse MoveUnit at the arena boundary,
                            // as can terrain pathing. Do not wait for distance
                            // that this dash can no longer cover.
                            if step > 0.001 and SR0(s__CrocodileSpells__CrocodileE_Struct_x[this] , s__CrocodileSpells__CrocodileE_Struct_y[this] , oldX , oldY) <= 0.001 then
                                set s__CrocodileSpells__CrocodileE_Struct_movementStopped[this]=true
                            endif
                            if not s__CrocodileSpells__CrocodileE_Struct_hitStarted[this] then
                                call s__CrocodileSpells__CrocodileE_Struct_CrocodileE_TryContact(this,oldX , oldY)
                            endif
                            call DecorRemoveLine(s__CrocodileSpells__CrocodileE_Struct_c[this] , oldX + CrocodileE_HitOffset * s__CrocodileSpells__CrocodileE_Struct_dirX[this] , oldY + CrocodileE_HitOffset * s__CrocodileSpells__CrocodileE_Struct_dirY[this] , s__CrocodileSpells__CrocodileE_Struct_a[this] , SR0(s__CrocodileSpells__CrocodileE_Struct_x[this] , s__CrocodileSpells__CrocodileE_Struct_y[this] , oldX , oldY) , s__CrocodileSpells__CrocodileE_Struct_radius[this] , 20.0 , CrocodileSpells__CrocodileDecorHits , s__CrocodileSpells__CrocodileE_Struct_decorKey[this])
                            set s__CrocodileSpells__CrocodileE_Struct_distance[this]=s__CrocodileSpells__CrocodileE_Struct_distance[this] + SR0(s__CrocodileSpells__CrocodileE_Struct_x[this] , s__CrocodileSpells__CrocodileE_Struct_y[this] , oldX , oldY)
                        endif
                    endif
                    endif
                    endif
                    if s__CrocodileSpells__CrocodileE_Struct_cancelDash[this] or ( ( s__CrocodileSpells__CrocodileE_Struct_movementStopped[this] or s__CrocodileSpells__CrocodileE_Struct_distance[this] + 0.001 >= s__CrocodileSpells__CrocodileE_Struct_maxDistance[this] ) and s__CrocodileSpells__CrocodileE_Struct_hitRemaining[this] <= 0.0 ) or not SpellBoolCaster(s__CrocodileSpells__CrocodileE_Struct_c[this]) or LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileE_Struct_c[this]), CrocodileSpells__CrocodileCore_DataKey) == 0 then
                        call s__CrocodileSpells__CrocodileE_Struct_CrocodileE_Finish(this)
                    endif
                endif
                if LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileE_Struct_c[this]), CrocodileSpells__CrocodileCore_DataKey) == 0 then
                    call RemoveSavedInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileE_Struct_c[this]), CrocodileSpells__CrocodileE_DataKey)
                    call TasAbilityChargeBox_ClearValue(s__CrocodileSpells__CrocodileE_Struct_c[this] , CrocodileE_ID)
                    set s__CrocodileSpells__CrocodileE_Struct_c[this]=null
                    set s__CrocodileSpells__CrocodileE_Struct_m[i]=s__CrocodileSpells__CrocodileE_Struct_m[s__CrocodileSpells__CrocodileE_Struct_MUI]
                    set s__CrocodileSpells__CrocodileE_Struct_MUI=s__CrocodileSpells__CrocodileE_Struct_MUI - 1
                    call s__CrocodileSpells__CrocodileE_Struct_deallocate(this)
                    if s__CrocodileSpells__CrocodileE_Struct_MUI == - 1 then
                        call GearTimer03Release()
                    endif
                else
                    set i=i + 1
                endif
            endloop
        endfunction

        function s__CrocodileSpells__CrocodileE_Struct_CrocodileE_Register takes unit NewC returns nothing
            local integer this= s__CrocodileSpells__CrocodileE_Struct__allocate()
            set s__CrocodileSpells__CrocodileE_Struct_MUI=s__CrocodileSpells__CrocodileE_Struct_MUI + 1
            set s__CrocodileSpells__CrocodileE_Struct_m[s__CrocodileSpells__CrocodileE_Struct_MUI]=this
            if s__CrocodileSpells__CrocodileE_Struct_MUI == 0 then
                call GearTimer03Acquire()
            endif
            set s__CrocodileSpells__CrocodileE_Struct_c[this]=NewC
            set s__CrocodileSpells__CrocodileE_Struct_useCooldown[this]=0.0
            set s__CrocodileSpells__CrocodileE_Struct_charge1[this]=0.0
            set s__CrocodileSpells__CrocodileE_Struct_charge2[this]=0.0
            set s__CrocodileSpells__CrocodileE_Struct_charge3[this]=0.0
            set s__CrocodileSpells__CrocodileE_Struct_shownCharges[this]=CrocodileSpells__CrocodileE_MaxCharges(s__CrocodileSpells__CrocodileE_Struct_c[this])
            set s__CrocodileSpells__CrocodileE_Struct_castPauseHeld[this]=false
            set s__CrocodileSpells__CrocodileE_Struct_active[this]=false
            set s__CrocodileSpells__CrocodileE_Struct_cancelDash[this]=false
            set s__CrocodileSpells__CrocodileE_Struct_g[this]=null
            set s__CrocodileSpells__CrocodileE_Struct_e[this]=null
            call SaveInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileE_Struct_c[this]), CrocodileSpells__CrocodileE_DataKey, this)
            call TasAbilityChargeBox_SetValue(s__CrocodileSpells__CrocodileE_Struct_c[this] , CrocodileE_ID , I2S(s__CrocodileSpells__CrocodileE_Struct_shownCharges[this]))
        endfunction

        function s__CrocodileSpells__CrocodileE_Struct_CrocodileE_Begin takes unit NewC,real NewX,real NewY returns boolean
            local integer this= LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(NewC), CrocodileSpells__CrocodileE_DataKey)
            local integer capacity= CrocodileSpells__CrocodileE_MaxCharges(NewC)
            local real recharge= CrocodileSpells__CrocodileE_RechargeTime(NewC)
            if LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(NewC), CrocodileSpells__CrocodileCore_DataKey) == 0 or IsUnitIllusion(NewC) or not SpellBoolCaster(NewC) or LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(NewC), CrocodileSpells__CrocodileT_PhaseKey) != 0 then
                return false
            endif
            if this == 0 or s__CrocodileSpells__CrocodileE_Struct_active[this] or s__CrocodileSpells__CrocodileE_Struct_useCooldown[this] > 0.0 or CrocodileE_Duration <= 0.0 then
                return false
            endif
            if capacity >= 1 and s__CrocodileSpells__CrocodileE_Struct_charge1[this] == 0.0 then
                set s__CrocodileSpells__CrocodileE_Struct_charge1[this]=recharge
            elseif capacity >= 2 and s__CrocodileSpells__CrocodileE_Struct_charge2[this] == 0.0 then
                set s__CrocodileSpells__CrocodileE_Struct_charge2[this]=recharge
            elseif capacity >= 3 and s__CrocodileSpells__CrocodileE_Struct_charge3[this] == 0.0 then
                set s__CrocodileSpells__CrocodileE_Struct_charge3[this]=recharge
            else
                return false
            endif
            set s__CrocodileSpells__CrocodileE_Struct_useCooldown[this]=CrocodileE_UseCD
            call BlzStartUnitAbilityCooldown(s__CrocodileSpells__CrocodileE_Struct_c[this], CrocodileE_ID, s__CrocodileSpells__CrocodileE_Struct_useCooldown[this])
            set s__CrocodileSpells__CrocodileE_Struct_active[this]=true
            set s__CrocodileSpells__CrocodileE_Struct_cancelDash[this]=false
            set s__CrocodileSpells__CrocodileE_Struct_movementStopped[this]=false
            set s__CrocodileSpells__CrocodileE_Struct_decorKey[this]=CrocodileSpells__CrocodileDecor_NewKey()
            set s__CrocodileSpells__CrocodileE_Struct_x[this]=GetUnitX(s__CrocodileSpells__CrocodileE_Struct_c[this])
            set s__CrocodileSpells__CrocodileE_Struct_y[this]=GetUnitY(s__CrocodileSpells__CrocodileE_Struct_c[this])
            set s__CrocodileSpells__CrocodileE_Struct_a[this]=Atan2(NewY - s__CrocodileSpells__CrocodileE_Struct_y[this], NewX - s__CrocodileSpells__CrocodileE_Struct_x[this])
            set s__CrocodileSpells__CrocodileE_Struct_dirX[this]=Cos(s__CrocodileSpells__CrocodileE_Struct_a[this])
            set s__CrocodileSpells__CrocodileE_Struct_dirY[this]=Sin(s__CrocodileSpells__CrocodileE_Struct_a[this])
            set s__CrocodileSpells__CrocodileE_Struct_r[this]=0.0
            set s__CrocodileSpells__CrocodileE_Struct_check[this]=0
            set s__CrocodileSpells__CrocodileE_Struct_duration[this]=CrocodileE_Duration
            set s__CrocodileSpells__CrocodileE_Struct_moveDelay[this]=RMaxBJ(0.0, CrocodileE_MoveDelay)
            set s__CrocodileSpells__CrocodileE_Struct_distance[this]=0.0
            set s__CrocodileSpells__CrocodileE_Struct_maxDistance[this]=CrocodileE_Distance //RMinBJ(CrocodileE_Distance,SR3(c,NewX,NewY))
            set s__CrocodileSpells__CrocodileE_Struct_moveStep[this]=s__CrocodileSpells__CrocodileE_Struct_maxDistance[this] * CrocodileSpells__CrocodilePeriod / s__CrocodileSpells__CrocodileE_Struct_duration[this]
            set s__CrocodileSpells__CrocodileE_Struct_radius[this]=CrocodileE_Aoe
            set s__CrocodileSpells__CrocodileE_Struct_dmg[this]=GetHeroAgi(s__CrocodileSpells__CrocodileE_Struct_c[this], true) * ( CrocodileE_DamageAgiBase + CrocodileE_DamageAgiStep * ( GetUnitAbilityLevel(s__CrocodileSpells__CrocodileE_Struct_c[this], CrocodileE_ID) - 1 ) )
            set s__CrocodileSpells__CrocodileE_Struct_hitStarted[this]=false
            // Correct for a cast between shared timer ticks.
            set s__CrocodileSpells__CrocodileE_Struct_elapsed[this]=- TimerGetElapsed(GearTimer03)
            set s__CrocodileSpells__CrocodileE_Struct_animationRate[this]=5.5
            set s__CrocodileSpells__CrocodileE_Struct_slashRate[this]=0.0
            set s__CrocodileSpells__CrocodileE_Struct_hitSlowed[this]=false
            set s__CrocodileSpells__CrocodileE_Struct_hitRemaining[this]=0.0
            set s__CrocodileSpells__CrocodileE_Struct_hitPulse[this]=0.0
            set s__CrocodileSpells__CrocodileE_Struct_hitTicks[this]=0
            set s__CrocodileSpells__CrocodileE_Struct_hitMaxTicks[this]=IMaxBJ(1, CrocodileE_HitTicks)
            set s__CrocodileSpells__CrocodileE_Struct_rmax[this]=s__CrocodileSpells__CrocodileE_Struct_moveDelay[this] + s__CrocodileSpells__CrocodileE_Struct_duration[this] + RMaxBJ(CrocodileSpells__CrocodilePeriod, CrocodileE_HitDelay) + ( s__CrocodileSpells__CrocodileE_Struct_hitMaxTicks[this] + 2 ) * CrocodileSpells__CrocodilePeriod
            set s__CrocodileSpells__CrocodileE_Struct_pulseDamage[this]=s__CrocodileSpells__CrocodileE_Struct_dmg[this] / s__CrocodileSpells__CrocodileE_Struct_hitMaxTicks[this]
            set s__CrocodileSpells__CrocodileE_Struct_hitInterval[this]=RMaxBJ(CrocodileSpells__CrocodilePeriod, CrocodileE_HitDelay / IMaxBJ(1, s__CrocodileSpells__CrocodileE_Struct_hitMaxTicks[this] - 1))
            set s__CrocodileSpells__CrocodileE_Struct_g[this]=CreateGroup()
            set s__CrocodileSpells__CrocodileE_Struct_e[this]=null
            set s__CrocodileSpells__CrocodileE_Struct_e2[this]=null
            set s__CrocodileSpells__CrocodileE_Struct_e3[this]=null
            set s__CrocodileSpells__CrocodileE_Struct_castPauseHeld[this]=true
            call StartSpellUnit2(s__CrocodileSpells__CrocodileE_Struct_c[this])
//---------------- E effect --------------------------------------------------
            //set e = AddSpecialEffectTarget("war3mapImported\\wos_Death_Spell2.mdl",c,"hand right")
            set s__CrocodileSpells__CrocodileE_Struct_e[this]=AddSpecialEffectTarget("war3mapImported\\wos_[DoFT]CrocodileSandSekiro.mdl", s__CrocodileSpells__CrocodileE_Struct_c[this], "hand right")
            set s__CrocodileSpells__CrocodileE_Struct_e3[this]=AddSpecialEffectTarget("war3mapImported\\wos_[DoFT]CrocodileSanding2.mdl", s__CrocodileSpells__CrocodileE_Struct_c[this], "hand right")
       
            call SetUnitAnimationByIndex(s__CrocodileSpells__CrocodileE_Struct_c[this], CrocodileE_Animation)
            call SetUnitTimeScale(s__CrocodileSpells__CrocodileE_Struct_c[this], s__CrocodileSpells__CrocodileE_Struct_animationRate[this])
            set s__CrocodileSpells__CrocodileE_Struct_e2[this]=EffectSpawn3("war3mapImported\\wos_tx-084.mdl" , GetUnitX(s__CrocodileSpells__CrocodileE_Struct_c[this]) + 100 * s__CrocodileSpells__CrocodileE_Struct_dirX[this] , GetUnitY(s__CrocodileSpells__CrocodileE_Struct_c[this]) + 100 * s__CrocodileSpells__CrocodileE_Struct_dirY[this] , s__CrocodileSpells__CrocodileE_Struct_a[this] * bj_RADTODEG + 0 , 0.55 , CrocodileE_SlashScale + 0.24 , 175 , 0)
            call BlzSetSpecialEffectAlpha(s__CrocodileSpells__CrocodileE_Struct_e2[this], 0)
            call BlzSetSpecialEffectTimeScale(s__CrocodileSpells__CrocodileE_Struct_e2[this], 0)
            call ColorEffDummy4(s__CrocodileSpells__CrocodileE_Struct_e2[this] , 0 , 255 , 255 , 255 , 0.35)
            call MakeSound("war3mapImported\\Hero_Crocodile_E")
            if GetRandomInt(1, 2) == 1 then
            call MakeSound("war3mapImported\\Hero_Crocodile_E2")
            else
            call MakeSound("war3mapImported\\Hero_Crocodile_E3")
            endif
            return true
        endfunction



//================================ Crocodile R - Sables ========================================

    // Invulnerability: this spell contains a StartSpellUnit/Avul phase.


        function s__CrocodileSpells__CrocodileR_Struct_CrocodileR_Release takes integer this,unit u returns nothing
            local integer target= LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(u), CrocodileSpells__CrocodileR_TargetKey)
            local integer other
            if target == 0 or s__CrocodileSpells__CrocodileR_Target_owner[target] != this then
                return
            endif
            // Saved handles also cover units removed from Warcraft's native groups.
            if s__CrocodileSpells__CrocodileR_Target_previous[target] == 0 then
                set s__CrocodileSpells__CrocodileR_Struct_captured[this]=s__CrocodileSpells__CrocodileR_Target_next[target]
            else
                set other=s__CrocodileSpells__CrocodileR_Target_previous[target]
                set s__CrocodileSpells__CrocodileR_Target_next[other]=s__CrocodileSpells__CrocodileR_Target_next[target]
            endif
            if s__CrocodileSpells__CrocodileR_Target_next[target] != 0 then
                set other=s__CrocodileSpells__CrocodileR_Target_next[target]
                set s__CrocodileSpells__CrocodileR_Target_previous[other]=s__CrocodileSpells__CrocodileR_Target_previous[target]
            endif
            if GetUnitTypeId(u) != 0 then
                call s__GearSystems2___KS_UnitHeight_HeightSet_Start((u ) , (( 0.5 )*1.0) , (( 0)*1.0) , 0) // INLINED!!
            endif
            call RemoveSavedInteger(CrocodileSpells__CrocodileTable, GetHandleId(u), CrocodileSpells__CrocodileR_TargetKey)
            set s__CrocodileSpells__CrocodileR_Target_u[target]=null
            call s__CrocodileSpells__CrocodileR_Target_deallocate(target)
        endfunction

        function s__CrocodileSpells__CrocodileR_Struct_CrocodileR_ReleaseAll takes integer this returns nothing
            local integer target
            loop
                exitwhen s__CrocodileSpells__CrocodileR_Struct_captured[this] == 0
                set target=s__CrocodileSpells__CrocodileR_Struct_captured[this]
                call s__CrocodileSpells__CrocodileR_Struct_CrocodileR_Release(this,s__CrocodileSpells__CrocodileR_Target_u[target])
            endloop
        endfunction

        function s__CrocodileSpells__CrocodileR_Struct_CrocodileR_Death takes unit dead returns nothing
            local integer i= 0
            local integer this
            local integer target= LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(dead), CrocodileSpells__CrocodileR_TargetKey)
            if target != 0 then
                set this=s__CrocodileSpells__CrocodileR_Target_owner[target]
                call s__CrocodileSpells__CrocodileR_Struct_CrocodileR_Release(this,dead)
            endif
            loop
                exitwhen i > s__CrocodileSpells__CrocodileR_Struct_MUI
                set this=s__CrocodileSpells__CrocodileR_Struct_m[i]
                if s__CrocodileSpells__CrocodileR_Struct_c[this] == dead then
                    set s__CrocodileSpells__CrocodileR_Struct_endNow[this]=true
                    call s__CrocodileSpells__CrocodileR_Struct_CrocodileR_ReleaseAll(this)
                endif
                set i=i + 1
            endloop
        endfunction

        function s__CrocodileSpells__CrocodileR_Struct_Loop_CrocodileR takes nothing returns nothing
            local integer i= 0
            local integer next
            local integer target
            local integer other
            local integer this
            local unit u
            local real step
            local real angle
            local real sandSpacing
            local real trailOffset
            local real targetX
            local real targetY
            local integer j
            local integer pit
            local integer nearest
            local real dx
            local real dy
            local real distanceSq
            local real nearestSq
            local real sizeMultiplier
            loop
                exitwhen i > s__CrocodileSpells__CrocodileR_Struct_MUI
                set this=s__CrocodileSpells__CrocodileR_Struct_m[i]
                set s__CrocodileSpells__CrocodileR_Struct_r[this]=RoundReal(s__CrocodileSpells__CrocodileR_Struct_r[this] + CrocodileSpells__CrocodilePeriod , 3)
                if s__CrocodileSpells__CrocodileR_Struct_castPauseHeld[this] and ( s__CrocodileSpells__CrocodileR_Struct_r[this] + 0.001 >= CrocodileR_CastTime or s__CrocodileSpells__CrocodileR_Struct_endNow[this] or not SpellBoolCaster(s__CrocodileSpells__CrocodileR_Struct_c[this]) ) then
                    set s__CrocodileSpells__CrocodileR_Struct_castPauseHeld[this]=false
                    call StopSpellUnit(s__CrocodileSpells__CrocodileR_Struct_c[this])
                endif
                if not s__CrocodileSpells__CrocodileR_Struct_endNow[this] and SpellBoolCaster(s__CrocodileSpells__CrocodileR_Struct_c[this]) and LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileR_Struct_c[this]), CrocodileSpells__CrocodileCore_DataKey) != 0 then
                    set step=0.0
