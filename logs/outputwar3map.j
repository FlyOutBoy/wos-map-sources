                    endif
                    if s__PatriotSpells___PatriotSpells_T2_e5[this] != null then
                        call DestroyEffect(s__PatriotSpells___PatriotSpells_T2_e5[this])
                    endif
                    if s__PatriotSpells___PatriotSpells_T2_e6[this] != null then
                        call DestroyEffect(s__PatriotSpells___PatriotSpells_T2_e6[this])
                    endif
                    call MouseOff(GetOwningPlayer(s__PatriotSpells___PatriotSpells_T2_c[this]))
                    if s__PatriotSpells___PatriotSpells_T2_r[this] < PatriotT2_CastTime then
                        call StopSpellUnit(s__PatriotSpells___PatriotSpells_T2_c[this])
                    endif
                    if s__PatriotSpells___PatriotSpells_T2_g[this] != null then
                        call DestroyGroup(s__PatriotSpells___PatriotSpells_T2_g[this])
                    endif
                    set s__PatriotSpells___PatriotSpells_T2_c[this]=null
                    set s__PatriotSpells___PatriotSpells_T2_g[this]=null
                    set s__PatriotSpells___PatriotSpells_T2_e[this]=null
                    set s__PatriotSpells___PatriotSpells_T2_e2[this]=null
                    set s__PatriotSpells___PatriotSpells_T2_e3[this]=null
                    set s__PatriotSpells___PatriotSpells_T2_e4[this]=null
                    set s__PatriotSpells___PatriotSpells_T2_e5[this]=null
                    set s__PatriotSpells___PatriotSpells_T2_e6[this]=null
                    set u=null
                    set s__PatriotSpells___PatriotSpells_T2_m_PatriotT2[i]=s__PatriotSpells___PatriotSpells_T2_m_PatriotT2[s__PatriotSpells___PatriotSpells_T2_MUI_PatriotT2]
                    set s__PatriotSpells___PatriotSpells_T2_MUI_PatriotT2=s__PatriotSpells___PatriotSpells_T2_MUI_PatriotT2 - 1
                    call s__PatriotSpells___PatriotSpells_T2_deallocate(this)
                    set i=i - 1
                    if s__PatriotSpells___PatriotSpells_T2_MUI_PatriotT2 == - 1 then
                        call PatriotSpells___PatriotTimer03Release()
                    endif
                endif
                set i=i + 1
            endloop
            set u=null
        endfunction

        function s__PatriotSpells___PatriotSpells_T2_PatriotT2_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__PatriotSpells___PatriotSpells_T2__allocate()
            set s__PatriotSpells___PatriotSpells_T2_MUI_PatriotT2=s__PatriotSpells___PatriotSpells_T2_MUI_PatriotT2 + 1
            set s__PatriotSpells___PatriotSpells_T2_m_PatriotT2[s__PatriotSpells___PatriotSpells_T2_MUI_PatriotT2]=this
