                        endif
                        call SetUnitFacing(s__PatriotSpells___PatriotSpells_T2_c[this], GAngle2(s__PatriotSpells___PatriotSpells_T2_c[this] , s__PatriotSpells___PatriotSpells_T2_x[this] , s__PatriotSpells___PatriotSpells_T2_y[this]) * bj_RADTODEG)
                    endif

                    // Момент броска (1.50 сек)
                    if s__PatriotSpells___PatriotSpells_T2_r[this] == PatriotT2_CastTime then
                        call DestroyEffect(s__PatriotSpells___PatriotSpells_T2_e2[this])
                        set s__PatriotSpells___PatriotSpells_T2_e2[this]=null
                        call SetUnitTimeScale(s__PatriotSpells___PatriotSpells_T2_c[this], 2.0)
                        set s__PatriotSpells___PatriotSpells_T2_x[this]=(BlzGetLocalSpecialEffectX((s__PatriotSpells___PatriotSpells_T2_e3[this]))) // INLINED!!
                        set s__PatriotSpells___PatriotSpells_T2_y[this]=(BlzGetLocalSpecialEffectY((s__PatriotSpells___PatriotSpells_T2_e3[this]))) // INLINED!!
                        call MakeSound("war3mapimported\\Hero_Patriot_T2 4")
                        set s__PatriotSpells___PatriotSpells_T2_a[this]=GAngle2(s__PatriotSpells___PatriotSpells_T2_c[this] , s__PatriotSpells___PatriotSpells_T2_x[this] , s__PatriotSpells___PatriotSpells_T2_y[this])
