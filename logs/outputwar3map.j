            set s__CrocodileSpells__CrocodileR_Struct_nextComboEffect[this]=0.0
            set s__CrocodileSpells__CrocodileR_Struct_sandDistance[this]=0.0
            set s__CrocodileSpells__CrocodileR_Struct_radius[this]=CrocodileR_StartAoe
            set s__CrocodileSpells__CrocodileR_Struct_dmg[this]=GetHeroAgi(s__CrocodileSpells__CrocodileR_Struct_c[this], true) * ( CrocodileR_DamageAgi + ( CrocodileR_DamageStep * ( GetUnitAbilityLevel(s__CrocodileSpells__CrocodileR_Struct_c[this], CrocodileR_ID) - 1 ) ) )
            set s__CrocodileSpells__CrocodileR_Struct_g[this]=CreateGroup()
            set s__CrocodileSpells__CrocodileR_Struct_captured[this]=0
            set s__CrocodileSpells__CrocodileR_Struct_castPauseHeld[this]=true
            call StartSpellUnit(s__CrocodileSpells__CrocodileR_Struct_c[this])
            set s__CrocodileSpells__CrocodileR_Struct_endNow[this]=false
//---------------- R effect --------------------------------------------------
            set s__CrocodileSpells__CrocodileR_Struct_e[this]=EffectSpawn("war3mapImported\\wos_file00000867.mdl" , s__CrocodileSpells__CrocodileR_Struct_x[this] , s__CrocodileSpells__CrocodileR_Struct_y[this] , 0 , 1 , CrocodileR_StartScale , 0)
            set s__CrocodileSpells__CrocodileR_Struct_e2[this]=EffectSpawn("war3mapImported\\wos_file00000862.mdl" , s__CrocodileSpells__CrocodileR_Struct_x[this] , s__CrocodileSpells__CrocodileR_Struct_y[this] , 0 , 2 , CrocodileR_StartScale , 0)
            call SetUnitAnimationByIndex(s__CrocodileSpells__CrocodileR_Struct_c[this], CrocodileR_Animation)
            
            call MakeSound("war3mapImported\\Hero_Crocodile_R_2")
            call MakeSound("war3mapImported\\Hero_Crocodile_R2")
            call s__GearSystems2___KS_DelayedSound_NextSound_Start(("war3mapImported\\Hero_Crocodile_R6" ) , (( 0.8)*1.0)) // INLINED!!
            return true
        endfunction

//================================ Crocodile T - Ground Secco ========================================
    // Owned through one cast's linked lists; patches do not acquire timers or scan units.

        function s__CrocodileSpells__CrocodileT_Sand_CrocodileTSand_Create takes real NewX,real NewY,real NewScale,real NewGrowTime,real angle returns integer
            local integer this= s__CrocodileSpells__CrocodileT_Sand__allocate()
            set s__CrocodileSpells__CrocodileT_Sand_next[this]=0
            set s__CrocodileSpells__CrocodileT_Sand_growthNext[this]=0
            set s__CrocodileSpells__CrocodileT_Sand_x[this]=NewX
            set s__CrocodileSpells__CrocodileT_Sand_y[this]=NewY
            set s__CrocodileSpells__CrocodileT_Sand_radius[this]=NewScale * 150.0
            set s__CrocodileSpells__CrocodileT_Sand_targetScale[this]=s__CrocodileSpells__CrocodileT_Sand_radius[this] / 165.0 * CrocodileT_SandVisualScale
            set s__CrocodileSpells__CrocodileT_Sand_age[this]=0.0
            set s__CrocodileSpells__CrocodileT_Sand_growTime[this]=RMaxBJ(CrocodileSpells__CrocodilePeriod, NewGrowTime)
            set s__CrocodileSpells__CrocodileT_Sand_blastMarked[this]=false
            set s__CrocodileSpells__CrocodileT_Sand_fromT[this]=true
            // Same stationary sand model and visual radius as the passive trails.
            set s__CrocodileSpells__CrocodileT_Sand_e[this]=EffectSpawn("war3mapImported\\wos_ysjsm45.mdl" , s__CrocodileSpells__CrocodileT_Sand_x[this] , s__CrocodileSpells__CrocodileT_Sand_y[this] , angle , 0.5 , s__CrocodileSpells__CrocodileT_Sand_targetScale[this] * 0.1 , 0.0)
            call BlzSetSpecialEffectAlpha(s__CrocodileSpells__CrocodileT_Sand_e[this], CrocodileT_SandAlpha)
            return this
        endfunction

        function s__CrocodileSpells__CrocodileT_Sand_CrocodileTSand_Collect takes integer sand returns integer
            local integer this= s__CrocodileSpells__CrocodileT_Sand__allocate()
            set s__CrocodileSpells__CrocodileT_Sand_next[this]=0
            set s__CrocodileSpells__CrocodileT_Sand_growthNext[this]=0
            set s__CrocodileSpells__CrocodileT_Sand_x[this]=s__CrocodileSpells__CrocodileSand_Struct_x[sand]
            set s__CrocodileSpells__CrocodileT_Sand_y[this]=s__CrocodileSpells__CrocodileSand_Struct_y[sand]
            set s__CrocodileSpells__CrocodileT_Sand_radius[this]=s__CrocodileSpells__CrocodileSand_Struct_radius[sand]
            set s__CrocodileSpells__CrocodileT_Sand_targetScale[this]=s__CrocodileSpells__CrocodileT_Sand_radius[this] / 165.0
            set s__CrocodileSpells__CrocodileT_Sand_age[this]=0.0
            set s__CrocodileSpells__CrocodileT_Sand_growTime[this]=CrocodileSpells__CrocodilePeriod
            set s__CrocodileSpells__CrocodileT_Sand_blastMarked[this]=false
            set s__CrocodileSpells__CrocodileT_Sand_fromT[this]=false
            set s__CrocodileSpells__CrocodileT_Sand_e[this]=s__CrocodileSpells__CrocodileSand_Struct_e[sand]
            set s__CrocodileSpells__CrocodileSand_Struct_e[sand]=null
            set s__CrocodileSpells__CrocodileSand_Struct_endNow[sand]=true
            return this
        endfunction

        function s__CrocodileSpells__CrocodileT_Sand_CrocodileTSand_Release takes integer this,boolean instant returns nothing
    if instant then
        call BlzSetSpecialEffectScale(s__CrocodileSpells__CrocodileT_Sand_e[this], 0.0)
        call BlzSetSpecialEffectAlpha(s__CrocodileSpells__CrocodileT_Sand_e[this], 0)
        call BlzSetSpecialEffectZ(s__CrocodileSpells__CrocodileT_Sand_e[this], - 10000.0)
        call DestroyEffect(s__CrocodileSpells__CrocodileT_Sand_e[this])
    else
        call ColorEffDummy3Alpha((s__CrocodileSpells__CrocodileT_Sand_e[this] ) , (( 0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.45)*1.0)) // INLINED!!
    endif

    set s__CrocodileSpells__CrocodileT_Sand_e[this]=null
    call s__CrocodileSpells__CrocodileT_Sand_deallocate(this)
endfunction

    // One moving front per direction; no timers or unit enumeration per effect.

        function s__CrocodileSpells__CrocodileT_Wave_CrocodileTWave_Create takes real x,real y,real angle,real scale returns integer
            local integer this= s__CrocodileSpells__CrocodileT_Wave__allocate()
            set s__CrocodileSpells__CrocodileT_Wave_next[this]=0
            set s__CrocodileSpells__CrocodileT_Wave_a[this]=angle
            set s__CrocodileSpells__CrocodileT_Wave_distance[this]=0.0
            set s__CrocodileSpells__CrocodileT_Wave_e[this]=EffectSpawn("war3mapImported\\wos_[DoFT]CrocodileSanding3.mdl" , x , y , angle * bj_RADTODEG , 1.0 , scale * 0.1 , 0.0)
            call BlzSetSpecialEffectAlpha(s__CrocodileSpells__CrocodileT_Wave_e[this], CrocodileT_SandAlpha)
            return this
        endfunction

        function s__CrocodileSpells__CrocodileT_Wave_CrocodileTWave_Release takes integer this,boolean instant returns nothing
            if instant then
                call BlzSetSpecialEffectAlpha(s__CrocodileSpells__CrocodileT_Wave_e[this], 0)
                call DestroyEffect(s__CrocodileSpells__CrocodileT_Wave_e[this])
            else
                call ColorEffDummy3Alpha(s__CrocodileSpells__CrocodileT_Wave_e[this] , 0.0 , 255 , 255 , 255 , CrocodileT_SandAlpha , CrocodileT_WaveFadeTime)
            endif
            set s__CrocodileSpells__CrocodileT_Wave_e[this]=null
            call s__CrocodileSpells__CrocodileT_Wave_deallocate(this)
        endfunction


        function s__CrocodileSpells__CrocodileT_Struct_CrocodileT_Contains takes integer this,real px,real py returns boolean
            local integer patch= s__CrocodileSpells__CrocodileT_Struct_patchHead[this]
            local real dx
            local real dy
            loop
                exitwhen patch == 0
                set dx=px - s__CrocodileSpells__CrocodileT_Sand_x[patch]
                set dy=py - s__CrocodileSpells__CrocodileT_Sand_y[patch]
                if dx * dx + dy * dy <= s__CrocodileSpells__CrocodileT_Sand_radius[patch] * s__CrocodileSpells__CrocodileT_Sand_radius[patch] then
                    return true
                endif
                set patch=s__CrocodileSpells__CrocodileT_Sand_next[patch]
            endloop
            return false
        endfunction

        function s__CrocodileSpells__CrocodileT_Struct_CrocodileT_UpdateGrowth takes integer this,boolean finish returns nothing
            local integer patch= s__CrocodileSpells__CrocodileT_Struct_growthHead[this]
            local integer previous= 0
            local integer following
            loop
                exitwhen patch == 0
                set following=s__CrocodileSpells__CrocodileT_Sand_growthNext[patch]
                set s__CrocodileSpells__CrocodileT_Sand_age[patch]=s__CrocodileSpells__CrocodileT_Sand_age[patch] + CrocodileSpells__CrocodilePeriod
                if finish or s__CrocodileSpells__CrocodileT_Sand_age[patch] + 0.001 >= s__CrocodileSpells__CrocodileT_Sand_growTime[patch] then
                    call BlzSetSpecialEffectScale(s__CrocodileSpells__CrocodileT_Sand_e[patch], s__CrocodileSpells__CrocodileT_Sand_targetScale[patch])
                    if previous == 0 then
                        set s__CrocodileSpells__CrocodileT_Struct_growthHead[this]=following
                    else
                        set s__CrocodileSpells__CrocodileT_Sand_growthNext[previous]=following
                    endif
                    set s__CrocodileSpells__CrocodileT_Sand_growthNext[patch]=0
                else
                    call BlzSetSpecialEffectScale(s__CrocodileSpells__CrocodileT_Sand_e[patch], s__CrocodileSpells__CrocodileT_Sand_targetScale[patch] * ( 0.1 + 0.9 * s__CrocodileSpells__CrocodileT_Sand_age[patch] / s__CrocodileSpells__CrocodileT_Sand_growTime[patch] ))
                    set previous=patch
                endif
                set patch=following
            endloop
        endfunction

        function s__CrocodileSpells__CrocodileT_Struct_CrocodileT_AddPatch takes integer this,real px,real py,real scale,real angle returns nothing
            local integer patch= s__CrocodileSpells__CrocodileT_Struct_patchHead[this]
            local real dx
            local real dy
            if s__CrocodileSpells__CrocodileT_Struct_patchCount[this] >= IMaxBJ(1, CrocodileT_MaxPatches) then
                return
            endif
            loop
                exitwhen patch == 0
                set dx=px - s__CrocodileSpells__CrocodileT_Sand_x[patch]
                set dy=py - s__CrocodileSpells__CrocodileT_Sand_y[patch]
                if dx * dx + dy * dy < s__CrocodileSpells__CrocodileT_Struct_minDistanceSq[this] then
                    return
                endif
                set patch=s__CrocodileSpells__CrocodileT_Sand_next[patch]
            endloop
            set patch=s__CrocodileSpells__CrocodileT_Sand_CrocodileTSand_Create(px , py , scale , RMinBJ(s__CrocodileSpells__CrocodileT_Struct_growTime[this], RMaxBJ(CrocodileSpells__CrocodilePeriod, s__CrocodileSpells__CrocodileT_Struct_spreadTime[this] - s__CrocodileSpells__CrocodileT_Struct_r[this])) , angle)
            set s__CrocodileSpells__CrocodileT_Sand_next[patch]=s__CrocodileSpells__CrocodileT_Struct_patchHead[this]
            set s__CrocodileSpells__CrocodileT_Struct_patchHead[this]=patch
            set s__CrocodileSpells__CrocodileT_Sand_growthNext[patch]=s__CrocodileSpells__CrocodileT_Struct_growthHead[this]
            set s__CrocodileSpells__CrocodileT_Struct_growthHead[this]=patch
            set s__CrocodileSpells__CrocodileT_Struct_patchCount[this]=s__CrocodileSpells__CrocodileT_Struct_patchCount[this] + 1
            set s__CrocodileSpells__CrocodileT_Struct_maxReach[this]=RMaxBJ(s__CrocodileSpells__CrocodileT_Struct_maxReach[this], SR0(s__CrocodileSpells__CrocodileT_Struct_x[this] , s__CrocodileSpells__CrocodileT_Struct_y[this] , px , py) + s__CrocodileSpells__CrocodileT_Sand_radius[patch])
        endfunction

        function s__CrocodileSpells__CrocodileT_Struct_CrocodileT_CreateWaves takes integer this returns nothing
            local integer count= IMaxBJ(1, IMinBJ(IMaxBJ(1, CrocodileT_MaxWaves), R2I(2.0 * bj_PI * s__CrocodileSpells__CrocodileT_Struct_outerRadius[this] / RMaxBJ(1.0, CrocodileT_WaveSpacing)) + 1))
            local integer i= 0
            local integer wave
            loop
                exitwhen i >= count
                set wave=s__CrocodileSpells__CrocodileT_Wave_CrocodileTWave_Create(s__CrocodileSpells__CrocodileT_Struct_x[this] , s__CrocodileSpells__CrocodileT_Struct_y[this] , 2.0 * bj_PI * i / count , s__CrocodileSpells__CrocodileT_Struct_waveScaleMin[this])
                set s__CrocodileSpells__CrocodileT_Wave_next[wave]=s__CrocodileSpells__CrocodileT_Struct_waveHead[this]
                set s__CrocodileSpells__CrocodileT_Struct_waveHead[this]=wave
                set i=i + 1
            endloop
        endfunction

        function s__CrocodileSpells__CrocodileT_Struct_CrocodileT_MoveWaves takes integer this returns nothing
            local integer wave= s__CrocodileSpells__CrocodileT_Struct_waveHead[this]
            local real progress= RMinBJ(1.0, s__CrocodileSpells__CrocodileT_Struct_r[this] / s__CrocodileSpells__CrocodileT_Struct_spreadTime[this])
            local real distance= s__CrocodileSpells__CrocodileT_Struct_areaRadius[this] * progress
            local real scale= s__CrocodileSpells__CrocodileT_Struct_waveScaleMin[this] + ( s__CrocodileSpells__CrocodileT_Struct_waveScaleMax[this] - s__CrocodileSpells__CrocodileT_Struct_waveScaleMin[this] ) * progress
            loop
                exitwhen wave == 0
                call MoveEff(s__CrocodileSpells__CrocodileT_Wave_e[wave] , RMaxBJ(0.0, distance - s__CrocodileSpells__CrocodileT_Wave_distance[wave]) , s__CrocodileSpells__CrocodileT_Wave_a[wave])
                set s__CrocodileSpells__CrocodileT_Wave_distance[wave]=distance
                call BlzSetSpecialEffectScale(s__CrocodileSpells__CrocodileT_Wave_e[wave], scale * RMinBJ(1.0, 0.1 + 0.9 * s__CrocodileSpells__CrocodileT_Struct_r[this] / s__CrocodileSpells__CrocodileT_Struct_growTime[this]))
                set wave=s__CrocodileSpells__CrocodileT_Wave_next[wave]
            endloop
        endfunction

        function s__CrocodileSpells__CrocodileT_Struct_CrocodileT_ClearWaves takes integer this,boolean instant returns nothing
            local integer wave= s__CrocodileSpells__CrocodileT_Struct_waveHead[this]
            local integer following
            loop
                exitwhen wave == 0
                set following=s__CrocodileSpells__CrocodileT_Wave_next[wave]
                call s__CrocodileSpells__CrocodileT_Wave_CrocodileTWave_Release(wave,instant)
                set wave=following
            endloop
            set s__CrocodileSpells__CrocodileT_Struct_waveHead[this]=0
        endfunction

        function s__CrocodileSpells__CrocodileT_Struct_CrocodileT_Spread takes integer this returns nothing
            local integer spawned= 0
            local real due
            local real progress
            local real angle
            local real scale
            loop
                exitwhen s__CrocodileSpells__CrocodileT_Struct_nextRing[this] > s__CrocodileSpells__CrocodileT_Struct_outerRadius[this] + 0.001 or s__CrocodileSpells__CrocodileT_Struct_patchCount[this] >= IMaxBJ(1, CrocodileT_MaxPatches) or spawned >= IMaxBJ(1, CrocodileT_SpawnsPerTick)
                if s__CrocodileSpells__CrocodileT_Struct_ringPoint[this] == 0 then
                    set s__CrocodileSpells__CrocodileT_Struct_ringPoints[this]=IMaxBJ(1, R2I(2.0 * bj_PI * s__CrocodileSpells__CrocodileT_Struct_nextRing[this] / s__CrocodileSpells__CrocodileT_Struct_patchSpacing[this]) + 1)
                endif
                set progress=s__CrocodileSpells__CrocodileT_Struct_nextRing[this] / RMaxBJ(CrocodileSpells__CrocodilePeriod, s__CrocodileSpells__CrocodileT_Struct_outerRadius[this])

                set due=( ( s__CrocodileSpells__CrocodileT_Struct_nextRing[this] + CrocodileT_PatchBehindWave ) / RMaxBJ(1.0, s__CrocodileSpells__CrocodileT_Struct_areaRadius[this]) ) * s__CrocodileSpells__CrocodileT_Struct_spreadTime[this]
                set due=due + s__CrocodileSpells__CrocodileT_Struct_ringBuildTime[this] * s__CrocodileSpells__CrocodileT_Struct_ringPoint[this] / IMaxBJ(1, s__CrocodileSpells__CrocodileT_Struct_ringPoints[this] - 1)

                exitwhen s__CrocodileSpells__CrocodileT_Struct_r[this] + 0.001 < due
                set angle=2.0 * bj_PI * ( s__CrocodileSpells__CrocodileT_Struct_ringPoint[this] + 0.5 * ModuloInteger(s__CrocodileSpells__CrocodileT_Struct_ringIndex[this], 2) ) / s__CrocodileSpells__CrocodileT_Struct_ringPoints[this]
                set scale=s__CrocodileSpells__CrocodileT_Struct_minScale[this] + ( s__CrocodileSpells__CrocodileT_Struct_maxScale[this] - s__CrocodileSpells__CrocodileT_Struct_minScale[this] ) * progress
                call s__CrocodileSpells__CrocodileT_Struct_CrocodileT_AddPatch(this,s__CrocodileSpells__CrocodileT_Struct_x[this] + s__CrocodileSpells__CrocodileT_Struct_nextRing[this] * Cos(angle) , s__CrocodileSpells__CrocodileT_Struct_y[this] + s__CrocodileSpells__CrocodileT_Struct_nextRing[this] * Sin(angle) , scale , angle * bj_RADTODEG)
                set spawned=spawned + 1
                set s__CrocodileSpells__CrocodileT_Struct_ringPoint[this]=s__CrocodileSpells__CrocodileT_Struct_ringPoint[this] + 1
                if s__CrocodileSpells__CrocodileT_Struct_ringPoint[this] >= s__CrocodileSpells__CrocodileT_Struct_ringPoints[this] then
                    set s__CrocodileSpells__CrocodileT_Struct_ringPoint[this]=0
                    set s__CrocodileSpells__CrocodileT_Struct_ringIndex[this]=s__CrocodileSpells__CrocodileT_Struct_ringIndex[this] + 1
                    if s__CrocodileSpells__CrocodileT_Struct_nextRing[this] + 0.001 >= s__CrocodileSpells__CrocodileT_Struct_outerRadius[this] then
                        set s__CrocodileSpells__CrocodileT_Struct_nextRing[this]=s__CrocodileSpells__CrocodileT_Struct_outerRadius[this] + s__CrocodileSpells__CrocodileT_Struct_ringSpacing[this]
                    else
                        set s__CrocodileSpells__CrocodileT_Struct_nextRing[this]=RMinBJ(s__CrocodileSpells__CrocodileT_Struct_outerRadius[this], s__CrocodileSpells__CrocodileT_Struct_nextRing[this] + s__CrocodileSpells__CrocodileT_Struct_ringSpacing[this])
                    endif
                endif
            endloop
        endfunction

        // Any active Crocodile sand permits T2; explosion ownership stays per cast.
        function s__CrocodileSpells__CrocodileT_Struct_CrocodileT_IsOnSand takes unit NewC returns boolean
            local integer own= LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(NewC), CrocodileSpells__CrocodileT_DataKey)
            local integer this
            local integer i= 0
            local real px= GetUnitX(NewC)
            local real py= GetUnitY(NewC)
            if own != 0 and not s__CrocodileSpells__CrocodileT_Struct_endNow[own] and s__CrocodileSpells__CrocodileT_Struct_r[own] < s__CrocodileSpells__CrocodileT_Struct_endTime[own] and s__CrocodileSpells__CrocodileT_Struct_CrocodileT_Contains(own,px , py) then
                return true
            endif
            if s__CrocodileSpells__CrocodileSand_Struct_CrocodileSand_IsOnGround(NewC , null) then
                return true
            endif
            loop
                exitwhen i > s__CrocodileSpells__CrocodileT_Struct_MUI
                set this=s__CrocodileSpells__CrocodileT_Struct_m[i]
                if this != own and not s__CrocodileSpells__CrocodileT_Struct_endNow[this] and s__CrocodileSpells__CrocodileT_Struct_r[this] < s__CrocodileSpells__CrocodileT_Struct_endTime[this] and SpellBoolCaster(s__CrocodileSpells__CrocodileT_Struct_c[this]) and s__CrocodileSpells__CrocodileT_Struct_CrocodileT_Contains(this,px , py) then
                    return true
                endif
                set i=i + 1
            endloop
            return false
        endfunction

        function s__CrocodileSpells__CrocodileT_Struct_CrocodileT_PlaySounds takes integer this returns nothing
            if not s__CrocodileSpells__CrocodileT_Struct_sound2Played[this] and s__CrocodileSpells__CrocodileT_Struct_r[this] + 0.001 >= CrocodileT_Sound2Time then
                set s__CrocodileSpells__CrocodileT_Struct_sound2Played[this]=true
                call MakeSound("war3mapImported\\Hero_Crocodile_T_2")
            endif
            if s__CrocodileSpells__CrocodileT_Struct_r[this] + 0.001 >= s__CrocodileSpells__CrocodileT_Struct_nextSound3[this] then
                set s__CrocodileSpells__CrocodileT_Struct_nextSound3[this]=s__CrocodileSpells__CrocodileT_Struct_nextSound3[this] + RMaxBJ(CrocodileSpells__CrocodilePeriod, CrocodileT_Sound3Period)
                call MakeSound("war3mapImported\\Hero_Crocodile_T_3")
            endif
        endfunction

        function s__CrocodileSpells__CrocodileT_Struct_CrocodileT_ControlT2 takes nothing returns nothing
            local integer this= LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(GetExpiredTimer()), CrocodileSpells__CrocodileT_DataKey)
            local boolean available
            set s__CrocodileSpells__CrocodileT_Struct_controlTime[this]=RoundReal(s__CrocodileSpells__CrocodileT_Struct_controlTime[this] + RMaxBJ(0.01, CrocodileT2_CheckPeriod) , 3)
            if not SpellBoolCaster(s__CrocodileSpells__CrocodileT_Struct_c[this]) or LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileT_Struct_c[this]), CrocodileSpells__CrocodileCore_DataKey) == 0 then
                call sc__CrocodileSpells__CrocodileT_Struct_CrocodileT_Clear(this,true)
            elseif not s__CrocodileSpells__CrocodileT_Struct_t2Pending[this] and s__CrocodileSpells__CrocodileT_Struct_r[this] + 0.001 >= s__CrocodileSpells__CrocodileT_Struct_endTime[this] then
                call sc__CrocodileSpells__CrocodileT_Struct_CrocodileT_Clear(this,false)
            elseif not s__CrocodileSpells__CrocodileT_Struct_t2Pending[this] and s__CrocodileSpells__CrocodileT_Struct_controlTime[this] + 0.001 >= CrocodileT2_UnlockTime then
                if not s__CrocodileSpells__CrocodileT_Struct_t2Granted[this] then
                    set s__CrocodileSpells__CrocodileT_Struct_t2Granted[this]=true
                    if GetUnitAbilityLevel(s__CrocodileSpells__CrocodileT_Struct_c[this], CrocodileT2_ID) == 0 then
                        call UnitAddAbility(s__CrocodileSpells__CrocodileT_Struct_c[this], CrocodileT2_ID)
                        call UnitMakeAbilityPermanent(s__CrocodileSpells__CrocodileT_Struct_c[this], true, CrocodileT2_ID)
                    endif
                    call SetUnitAbilityLevel(s__CrocodileSpells__CrocodileT_Struct_c[this], CrocodileT2_ID, IMaxBJ(1, GetUnitAbilityLevel(s__CrocodileSpells__CrocodileT_Struct_c[this], CrocodileT_ID)))
                    call BlzEndUnitAbilityCooldown(s__CrocodileSpells__CrocodileT_Struct_c[this], CrocodileT2_ID)
                    call SetPlayerAbilityAvailable(GetOwningPlayer(s__CrocodileSpells__CrocodileT_Struct_c[this]), CrocodileT_ID, false)
                endif
                set available=s__CrocodileSpells__CrocodileT_Struct_CrocodileT_IsOnSand(s__CrocodileSpells__CrocodileT_Struct_c[this])
                if available != s__CrocodileSpells__CrocodileT_Struct_t2Available[this] then
                    set s__CrocodileSpells__CrocodileT_Struct_t2Available[this]=available
                    call SetPlayerAbilityAvailable(GetOwningPlayer(s__CrocodileSpells__CrocodileT_Struct_c[this]), CrocodileT2_ID, available)
                endif
            endif
        endfunction

        function s__CrocodileSpells__CrocodileT_Struct_CrocodileT_EndSpread takes integer this returns nothing
            if s__CrocodileSpells__CrocodileT_Struct_spreadComplete[this] then
                return
            endif
            set s__CrocodileSpells__CrocodileT_Struct_spreading[this]=false
            set s__CrocodileSpells__CrocodileT_Struct_spreadComplete[this]=true
            call s__CrocodileSpells__CrocodileT_Struct_CrocodileT_UpdateGrowth(this,true)
            call s__CrocodileSpells__CrocodileT_Struct_CrocodileT_ClearWaves(this,false)
        endfunction

        function s__CrocodileSpells__CrocodileT_Struct_CrocodileT_EndChannel takes integer this returns nothing
            if not s__CrocodileSpells__CrocodileT_Struct_channelActive[this] then
                return
            endif
            set s__CrocodileSpells__CrocodileT_Struct_channelActive[this]=false
            call SaveBoolean(hs, GetHandleId(s__CrocodileSpells__CrocodileT_Struct_c[this]), SH_CROCODILE_T_CHANNEL, false)
            if s__CrocodileSpells__CrocodileT_Struct_invulnerabilityHeld[this] then
                set s__CrocodileSpells__CrocodileT_Struct_invulnerabilityHeld[this]=false
                call UnitRemoveAbility(s__CrocodileSpells__CrocodileT_Struct_c[this], 'Avul')
            endif
            call s__CrocodileSpells__CrocodileT_Struct_CrocodileT_EndSpread(this)
            set s__CrocodileSpells__CrocodileT_Struct_endTime[this]=s__CrocodileSpells__CrocodileT_Struct_r[this] + s__CrocodileSpells__CrocodileT_Struct_windowTime[this]
            call RemoveSavedInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileT_Struct_c[this]), CrocodileSpells__CrocodileT_PhaseKey)
            // Asta E's generic active-cast marker; it is separate from CC immunity.
            call SaveInteger(hs, GetHandleId(s__CrocodileSpells__CrocodileT_Struct_c[this]), CrocodileSpells__SH_CAST_R, 0)
            call SaveInteger(hs, GetHandleId(s__CrocodileSpells__CrocodileT_Struct_c[this]), CrocodileSpells__SH_STOP_R, 0)
            call GearCCProtect(s__CrocodileSpells__CrocodileT_Struct_c[this] , false)
            if s__CrocodileSpells__CrocodileT_Struct_manaGroup[this] != null then
                call DestroyGroup(s__CrocodileSpells__CrocodileT_Struct_manaGroup[this])
                set s__CrocodileSpells__CrocodileT_Struct_manaGroup[this]=null
            endif
            call DestroyEffect(s__CrocodileSpells__CrocodileT_Struct_aura[this])
            set s__CrocodileSpells__CrocodileT_Struct_aura[this]=null
            call SetUnitTimeScale(s__CrocodileSpells__CrocodileT_Struct_c[this], 1.0)
            call SetUnitAnimation(s__CrocodileSpells__CrocodileT_Struct_c[this], "stand")
        endfunction

        function s__CrocodileSpells__CrocodileT_Struct_CrocodileT_DrainMana takes integer this returns nothing
            local unit u
            local real maxMana
            call GroupEnumUnitsInRange(s__CrocodileSpells__CrocodileT_Struct_manaGroup[this], s__CrocodileSpells__CrocodileT_Struct_x[this], s__CrocodileSpells__CrocodileT_Struct_y[this], s__CrocodileSpells__CrocodileT_Struct_maxReach[this], NoDecor_Cond)
            loop
                set u=FirstOfGroup(s__CrocodileSpells__CrocodileT_Struct_manaGroup[this])
                exitwhen u == null
                call GroupRemoveUnit(s__CrocodileSpells__CrocodileT_Struct_manaGroup[this], u)
                if SpellBool(u) and IsUnitEnemy(u, GetOwningPlayer(s__CrocodileSpells__CrocodileT_Struct_c[this])) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) and s__CrocodileSpells__CrocodileT_Struct_CrocodileT_Contains(this,GetUnitX(u) , GetUnitY(u)) then
                    call CrocodileSpells__Crocodile_ApplySharedMark(s__CrocodileSpells__CrocodileT_Struct_c[this] , u)
                    set maxMana=GetUnitState(u, UNIT_STATE_MAX_MANA)
                    if maxMana > 0.0 then
                        call SetMpCurrent(u , - CrocodileT_ManaDrain * maxMana)
                    endif
                endif
            endloop
            set u=null
        endfunction

        function s__CrocodileSpells__CrocodileT_Struct_CrocodileT_SlowGround takes integer this returns nothing
            local group g= CreateGroup()
            local unit u
            call GroupEnumUnitsInRange(g, s__CrocodileSpells__CrocodileT_Struct_x[this], s__CrocodileSpells__CrocodileT_Struct_y[this], s__CrocodileSpells__CrocodileT_Struct_maxReach[this], NoDecor_Cond)
            loop
                set u=FirstOfGroup(g)
                exitwhen u == null
                call GroupRemoveUnit(g, u)
                if SpellBool(u) and IsUnitEnemy(u, GetOwningPlayer(s__CrocodileSpells__CrocodileT_Struct_c[this])) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) and s__CrocodileSpells__CrocodileT_Struct_CrocodileT_Contains(this,GetUnitX(u) , GetUnitY(u)) then
                    call CrocodileSpells__CrocodileSand_SlowTarget(s__CrocodileSpells__CrocodileT_Struct_c[this] , u)
                endif
            endloop
            call DestroyGroup(g)
            set g=null
            set u=null
        endfunction

        function s__CrocodileSpells__CrocodileT_Struct_CrocodileT_Clear takes integer this,boolean instant returns nothing
            local integer patch= s__CrocodileSpells__CrocodileT_Struct_patchHead[this]
            local integer following
            local integer sand
            local real remaining= CrocodileSand_GroundDuration - RMaxBJ(0.0, s__CrocodileSpells__CrocodileT_Struct_r[this] - ( s__CrocodileSpells__CrocodileT_Struct_endTime[this] - s__CrocodileSpells__CrocodileT_Struct_windowTime[this] ))
            if s__CrocodileSpells__CrocodileT_Struct_endNow[this] then
                return
            endif
            call s__CrocodileSpells__CrocodileT_Struct_CrocodileT_EndChannel(this)
            set remaining=CrocodileSand_GroundDuration - RMaxBJ(0.0, s__CrocodileSpells__CrocodileT_Struct_r[this] - ( s__CrocodileSpells__CrocodileT_Struct_endTime[this] - s__CrocodileSpells__CrocodileT_Struct_windowTime[this] ))
            set s__CrocodileSpells__CrocodileT_Struct_endNow[this]=true
            if s__CrocodileSpells__CrocodileT_Struct_t2PauseHeld[this] then
                set s__CrocodileSpells__CrocodileT_Struct_t2PauseHeld[this]=false
                call StopSpellUnit2(s__CrocodileSpells__CrocodileT_Struct_c[this])
            endif
            call RemoveSavedInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileT_Struct_t2Timer[this]), CrocodileSpells__CrocodileT_DataKey)
            call PauseTimer(s__CrocodileSpells__CrocodileT_Struct_t2Timer[this])
            call DestroyTimer(s__CrocodileSpells__CrocodileT_Struct_t2Timer[this])
            set s__CrocodileSpells__CrocodileT_Struct_t2Timer[this]=null
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__CrocodileSpells__CrocodileT_Struct_c[this]), CrocodileT2_ID, false)
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__CrocodileSpells__CrocodileT_Struct_c[this]), CrocodileT_ID, true)
            call s__CrocodileSpells__CrocodileT_Struct_CrocodileT_ClearWaves(this,instant)
            call RemoveSavedInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileT_Struct_c[this]), CrocodileSpells__CrocodileT_DataKey)
            call RemoveSavedInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileT_Struct_c[this]), CrocodileSpells__CrocodileT_PhaseKey)
            if s__CrocodileSpells__CrocodileT_Struct_aura[this] != null then
                call DestroyEffect(s__CrocodileSpells__CrocodileT_Struct_aura[this])
                set s__CrocodileSpells__CrocodileT_Struct_aura[this]=null
            endif
            if s__CrocodileSpells__CrocodileT_Struct_spreading[this] or s__CrocodileSpells__CrocodileT_Struct_t2Pending[this] then
                call SetUnitTimeScale(s__CrocodileSpells__CrocodileT_Struct_c[this], 1.0)
                call SetUnitAnimation(s__CrocodileSpells__CrocodileT_Struct_c[this], "stand")
            endif
            loop
                exitwhen patch == 0
                set following=s__CrocodileSpells__CrocodileT_Sand_next[patch]
                if not instant and not s__CrocodileSpells__CrocodileT_Struct_t2Pending[this] and remaining > 0.0 then
                    // Transfer the existing effect to the shared sand clock; do not respawn it.
                    set sand=s__CrocodileSpells__CrocodileSand_Struct__allocate()
                    set s__CrocodileSpells__CrocodileSand_Struct_MUI=s__CrocodileSpells__CrocodileSand_Struct_MUI + 1
                    set s__CrocodileSpells__CrocodileSand_Struct_m[s__CrocodileSpells__CrocodileSand_Struct_MUI]=sand
                    if s__CrocodileSpells__CrocodileSand_Struct_MUI == 0 then
                        call GearTimer03Acquire()
                    endif
                    set s__CrocodileSpells__CrocodileSand_Struct_c[sand]=s__CrocodileSpells__CrocodileT_Struct_c[this]
                    set s__CrocodileSpells__CrocodileSand_Struct_x[sand]=s__CrocodileSpells__CrocodileT_Sand_x[patch]
                    set s__CrocodileSpells__CrocodileSand_Struct_y[sand]=s__CrocodileSpells__CrocodileT_Sand_y[patch]
                    set s__CrocodileSpells__CrocodileSand_Struct_radius[sand]=s__CrocodileSpells__CrocodileT_Sand_radius[patch]
                    set s__CrocodileSpells__CrocodileSand_Struct_r[sand]=0.0
                    set s__CrocodileSpells__CrocodileSand_Struct_rmax[sand]=remaining
                    set s__CrocodileSpells__CrocodileSand_Struct_pulse[sand]=0.0
                    set s__CrocodileSpells__CrocodileSand_Struct_endNow[sand]=false
                    set s__CrocodileSpells__CrocodileSand_Struct_largeVisual[sand]=s__CrocodileSpells__CrocodileT_Sand_radius[patch] >= CrocodileSand_LargeAoe
                    call s__CrocodileSpells__CrocodileSand_Struct_GridAdd(sand)
                    set s__CrocodileSpells__CrocodileSand_Struct_e[sand]=s__CrocodileSpells__CrocodileT_Sand_e[patch]
                    set s__CrocodileSpells__CrocodileT_Sand_e[patch]=null
                    call s__CrocodileSpells__CrocodileT_Sand_deallocate(patch)
                else
                    call s__CrocodileSpells__CrocodileT_Sand_CrocodileTSand_Release(patch,instant)
                endif
                set patch=following
            endloop
            if s__CrocodileSpells__CrocodileT_Struct_t2Pending[this] and not s__CrocodileSpells__CrocodileT_Struct_channelActive[this] then
                call SaveBoolean(hs, GetHandleId(s__CrocodileSpells__CrocodileT_Struct_c[this]), SH_CROCODILE_T_CHANNEL, false)
            endif
            set s__CrocodileSpells__CrocodileT_Struct_t2Pending[this]=false
            set s__CrocodileSpells__CrocodileT_Struct_patchHead[this]=0
            set s__CrocodileSpells__CrocodileT_Struct_growthHead[this]=0
            set s__CrocodileSpells__CrocodileT_Struct_patchCount[this]=0
        endfunction

        function s__CrocodileSpells__CrocodileT_Struct_CrocodileT_Finish takes unit NewC returns nothing
            local integer this= LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(NewC), CrocodileSpells__CrocodileT_DataKey)
            if this != 0 then
                call s__CrocodileSpells__CrocodileT_Struct_CrocodileT_Clear(this,true)
            endif
        endfunction

        function s__CrocodileSpells__CrocodileT_Struct_Loop_CrocodileT takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__CrocodileSpells__CrocodileT_Struct_MUI
                set this=s__CrocodileSpells__CrocodileT_Struct_m[i]
                if s__CrocodileSpells__CrocodileT_Struct_channelActive[this] then
                    call WOSUI___WUI_TestHeroProgress((s__CrocodileSpells__CrocodileT_Struct_c[this] ) , ( CrocodileT_ID ) , ( "Ground Secco" ) , (( CrocodileT_Duration - s__CrocodileSpells__CrocodileT_Struct_r[this] )*1.0) , (( CrocodileT_Duration )*1.0) , ( true) , "") // INLINED!!
                elseif not s__CrocodileSpells__CrocodileT_Struct_t2Pending[this] then
                    call WOSUI___WUI_TestHeroProgress((s__CrocodileSpells__CrocodileT_Struct_c[this] ) , ( CrocodileT_ID ) , ( "Ground Secco" ) , (( s__CrocodileSpells__CrocodileT_Struct_endTime[this] - s__CrocodileSpells__CrocodileT_Struct_r[this] )*1.0) , (( s__CrocodileSpells__CrocodileT_Struct_windowTime[this] )*1.0) , ( true) , "") // INLINED!!
                endif
                set s__CrocodileSpells__CrocodileT_Struct_r[this]=RoundReal(s__CrocodileSpells__CrocodileT_Struct_r[this] + CrocodileSpells__CrocodilePeriod , 3)
                if not s__CrocodileSpells__CrocodileT_Struct_endNow[this] then
                    if not SpellBoolCaster(s__CrocodileSpells__CrocodileT_Struct_c[this]) or LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileT_Struct_c[this]), CrocodileSpells__CrocodileCore_DataKey) == 0 then
                        call s__CrocodileSpells__CrocodileT_Struct_CrocodileT_Clear(this,true)
                    elseif s__CrocodileSpells__CrocodileT_Struct_t2Pending[this] then
                        set s__CrocodileSpells__CrocodileT_Struct_t2Time[this]=RoundReal(s__CrocodileSpells__CrocodileT_Struct_t2Time[this] + CrocodileSpells__CrocodilePeriod , 3)
                        if not s__CrocodileSpells__CrocodileT_Struct_animationApplied[this] and s__CrocodileSpells__CrocodileT_Struct_t2Time[this] >= CrocodileT_AnimationDelay then
                            set s__CrocodileSpells__CrocodileT_Struct_animationApplied[this]=true
                            call SetUnitTimeScale(s__CrocodileSpells__CrocodileT_Struct_c[this], CrocodileT_AnimationSpeed)
                            call SetUnitAnimationByIndex(s__CrocodileSpells__CrocodileT_Struct_c[this], CrocodileT_Animation)
                        endif
                    elseif s__CrocodileSpells__CrocodileT_Struct_channelActive[this] then
                        if not s__CrocodileSpells__CrocodileT_Struct_channelFinished[this] then
                            if not s__CrocodileSpells__CrocodileT_Struct_animationApplied[this] and s__CrocodileSpells__CrocodileT_Struct_r[this] >= CrocodileT_AnimationDelay then
                                set s__CrocodileSpells__CrocodileT_Struct_animationApplied[this]=true
                                call SetUnitTimeScale(s__CrocodileSpells__CrocodileT_Struct_c[this], CrocodileT_AnimationSpeed)
                                call SetUnitAnimationByIndex(s__CrocodileSpells__CrocodileT_Struct_c[this], CrocodileT_Animation)
                            endif
                            call s__CrocodileSpells__CrocodileT_Struct_CrocodileT_PlaySounds(this)
                            if s__CrocodileSpells__CrocodileT_Struct_spreading[this] then
                                call s__CrocodileSpells__CrocodileT_Struct_CrocodileT_MoveWaves(this)
                                call s__CrocodileSpells__CrocodileT_Struct_CrocodileT_UpdateGrowth(this,false)
                                call s__CrocodileSpells__CrocodileT_Struct_CrocodileT_Spread(this)
                                if s__CrocodileSpells__CrocodileT_Struct_r[this] + 0.001 >= s__CrocodileSpells__CrocodileT_Struct_spreadTime[this] then
                                    call s__CrocodileSpells__CrocodileT_Struct_CrocodileT_EndSpread(this)
                                endif
                            endif
                        endif
                        // SPELL_FINISH can arrive before the shared timer's
                        // final update. Keep the due fifth pulse on a full cast.
                        if not s__CrocodileSpells__CrocodileT_Struct_channelFinished[this] or s__CrocodileSpells__CrocodileT_Struct_r[this] + 0.001 >= CrocodileT_Duration then
                            set s__CrocodileSpells__CrocodileT_Struct_decorPulse[this]=s__CrocodileSpells__CrocodileT_Struct_decorPulse[this] + CrocodileSpells__CrocodilePeriod
                            if s__CrocodileSpells__CrocodileT_Struct_decorPulse[this] + 0.001 >= 0.5 then
                                set s__CrocodileSpells__CrocodileT_Struct_decorPulse[this]=s__CrocodileSpells__CrocodileT_Struct_decorPulse[this] - 0.5
                                call DecorRemove(s__CrocodileSpells__CrocodileT_Struct_c[this] , s__CrocodileSpells__CrocodileT_Struct_x[this] , s__CrocodileSpells__CrocodileT_Struct_y[this] , s__CrocodileSpells__CrocodileT_Struct_maxReach[this] , 100.0)
                            endif
                            set s__CrocodileSpells__CrocodileT_Struct_visionPulse[this]=s__CrocodileSpells__CrocodileT_Struct_visionPulse[this] + CrocodileSpells__CrocodilePeriod
                            if s__CrocodileSpells__CrocodileT_Struct_visionPulse[this] + 0.001 >= 1.0 then
                                set s__CrocodileSpells__CrocodileT_Struct_visionPulse[this]=s__CrocodileSpells__CrocodileT_Struct_visionPulse[this] - 1.0
                                call VisionTimed(GetOwningPlayer(s__CrocodileSpells__CrocodileT_Struct_c[this]) , s__CrocodileSpells__CrocodileT_Struct_x[this] , s__CrocodileSpells__CrocodileT_Struct_y[this] , s__CrocodileSpells__CrocodileT_Struct_maxReach[this] * 1.5 , 3.0)
                            endif
                            set s__CrocodileSpells__CrocodileT_Struct_manaPulse[this]=s__CrocodileSpells__CrocodileT_Struct_manaPulse[this] + CrocodileSpells__CrocodilePeriod
                            if s__CrocodileSpells__CrocodileT_Struct_manaPulse[this] + 0.001 >= CrocodileT_ManaDrainPeriod then
                                set s__CrocodileSpells__CrocodileT_Struct_manaPulse[this]=s__CrocodileSpells__CrocodileT_Struct_manaPulse[this] - RMaxBJ(CrocodileSpells__CrocodilePeriod, CrocodileT_ManaDrainPeriod)
                                call s__CrocodileSpells__CrocodileT_Struct_CrocodileT_DrainMana(this)
                            endif
                        endif
                        if s__CrocodileSpells__CrocodileT_Struct_channelFinished[this] or s__CrocodileSpells__CrocodileT_Struct_r[this] + 0.001 >= CrocodileT_Duration then
                            call s__CrocodileSpells__CrocodileT_Struct_CrocodileT_EndChannel(this)
                        endif
                    endif
                endif
                if not s__CrocodileSpells__CrocodileT_Struct_endNow[this] and not s__CrocodileSpells__CrocodileT_Struct_t2Pending[this] and s__CrocodileSpells__CrocodileT_Struct_r[this] < s__CrocodileSpells__CrocodileT_Struct_endTime[this] and s__CrocodileSpells__CrocodileT_Struct_patchHead[this] != 0 then
                    set s__CrocodileSpells__CrocodileT_Struct_sandSlowPulse[this]=s__CrocodileSpells__CrocodileT_Struct_sandSlowPulse[this] + CrocodileSpells__CrocodilePeriod
                    if s__CrocodileSpells__CrocodileT_Struct_sandSlowPulse[this] + 0.001 >= 0.5 then
                        set s__CrocodileSpells__CrocodileT_Struct_sandSlowPulse[this]=0.0
                        call s__CrocodileSpells__CrocodileT_Struct_CrocodileT_SlowGround(this)
                    endif
                endif
                if s__CrocodileSpells__CrocodileT_Struct_endNow[this] then
                    set s__CrocodileSpells__CrocodileT_Struct_c[this]=null
                    set s__CrocodileSpells__CrocodileT_Struct_m[i]=s__CrocodileSpells__CrocodileT_Struct_m[s__CrocodileSpells__CrocodileT_Struct_MUI]
                    set s__CrocodileSpells__CrocodileT_Struct_MUI=s__CrocodileSpells__CrocodileT_Struct_MUI - 1
                    call s__CrocodileSpells__CrocodileT_Struct_deallocate(this)
                    if s__CrocodileSpells__CrocodileT_Struct_MUI == - 1 then
                        call GearTimer03Release()
                    endif
                else
                    set i=i + 1
                endif
            endloop
        endfunction

        function s__CrocodileSpells__CrocodileT_Struct_CrocodileT_Begin takes unit NewC returns boolean
            local integer this
            local integer dash= LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(NewC), CrocodileSpells__CrocodileE_DataKey)
            if not SpellBoolCaster(NewC) or IsUnitIllusion(NewC) or LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(NewC), CrocodileSpells__CrocodileCore_DataKey) == 0 or LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(NewC), CrocodileSpells__CrocodileT_DataKey) != 0 then
                return false
            endif
            set this=s__CrocodileSpells__CrocodileT_Struct__allocate()
            set s__CrocodileSpells__CrocodileT_Struct_MUI=s__CrocodileSpells__CrocodileT_Struct_MUI + 1
            set s__CrocodileSpells__CrocodileT_Struct_m[s__CrocodileSpells__CrocodileT_Struct_MUI]=this
            if s__CrocodileSpells__CrocodileT_Struct_MUI == 0 then
                call GearTimer03Acquire()
            endif
            set s__CrocodileSpells__CrocodileT_Struct_c[this]=NewC
            set s__CrocodileSpells__CrocodileT_Struct_x[this]=GetUnitX(s__CrocodileSpells__CrocodileT_Struct_c[this])
            set s__CrocodileSpells__CrocodileT_Struct_y[this]=GetUnitY(s__CrocodileSpells__CrocodileT_Struct_c[this])
            set s__CrocodileSpells__CrocodileT_Struct_r[this]=- TimerGetElapsed(GearTimer03)
            set s__CrocodileSpells__CrocodileT_Struct_spreadTime[this]=RMaxBJ(CrocodileSpells__CrocodilePeriod, CrocodileT_SpreadTime)
            set s__CrocodileSpells__CrocodileT_Struct_nextSound3[this]=RMaxBJ(CrocodileSpells__CrocodilePeriod, CrocodileT_Sound3Period)
            set s__CrocodileSpells__CrocodileT_Struct_t2Time[this]=0.0
            set s__CrocodileSpells__CrocodileT_Struct_controlTime[this]=0.0
            set s__CrocodileSpells__CrocodileT_Struct_windowTime[this]=RMaxBJ(CrocodileSpells__CrocodilePeriod, RMinBJ(CrocodileT2_Window, CrocodileSand_GroundDuration))
            set s__CrocodileSpells__CrocodileT_Struct_endTime[this]=RMaxBJ(CrocodileSpells__CrocodilePeriod, CrocodileT_Duration) + s__CrocodileSpells__CrocodileT_Struct_windowTime[this]
            set s__CrocodileSpells__CrocodileT_Struct_areaRadius[this]=RMaxBJ(1.0, CrocodileT_MaxAoe)
            set s__CrocodileSpells__CrocodileT_Struct_minScale[this]=RMaxBJ(0.01, CrocodileT_ScaleMin)
            set s__CrocodileSpells__CrocodileT_Struct_maxScale[this]=RMaxBJ(s__CrocodileSpells__CrocodileT_Struct_minScale[this], CrocodileT_ScaleMax)
            set s__CrocodileSpells__CrocodileT_Struct_outerRadius[this]=RMaxBJ(0.0, s__CrocodileSpells__CrocodileT_Struct_areaRadius[this] - s__CrocodileSpells__CrocodileT_Struct_maxScale[this] * 150.0)
            set s__CrocodileSpells__CrocodileT_Struct_ringSpacing[this]=RMaxBJ(1.0, RMaxBJ(CrocodileT_MinDistance, CrocodileT_RingSpacing))
            set s__CrocodileSpells__CrocodileT_Struct_patchSpacing[this]=RMaxBJ(1.0, RMaxBJ(CrocodileT_MinDistance, CrocodileT_PatchSpacing))
            set s__CrocodileSpells__CrocodileT_Struct_minDistanceSq[this]=CrocodileT_MinDistance * CrocodileT_MinDistance
            set s__CrocodileSpells__CrocodileT_Struct_growTime[this]=RMinBJ(s__CrocodileSpells__CrocodileT_Struct_spreadTime[this] / 2.0, RMaxBJ(CrocodileSpells__CrocodilePeriod, CrocodileT_GrowTime))
            set s__CrocodileSpells__CrocodileT_Struct_ringBuildTime[this]=RMinBJ(s__CrocodileSpells__CrocodileT_Struct_spreadTime[this] / 4.0, RMaxBJ(CrocodileT_RingBuildTime, ( 2.0 * bj_PI * s__CrocodileSpells__CrocodileT_Struct_outerRadius[this] / s__CrocodileSpells__CrocodileT_Struct_patchSpacing[this] + 1.0 ) * CrocodileSpells__CrocodilePeriod / IMaxBJ(1, CrocodileT_SpawnsPerTick) + CrocodileSpells__CrocodilePeriod))
            set s__CrocodileSpells__CrocodileT_Struct_buildDeadline[this]=RMaxBJ(0.0, s__CrocodileSpells__CrocodileT_Struct_spreadTime[this] - s__CrocodileSpells__CrocodileT_Struct_ringBuildTime[this])
            set s__CrocodileSpells__CrocodileT_Struct_waveScaleMin[this]=RMaxBJ(0.01, CrocodileT_WaveScaleMin)
            set s__CrocodileSpells__CrocodileT_Struct_waveScaleMax[this]=RMaxBJ(s__CrocodileSpells__CrocodileT_Struct_waveScaleMin[this], CrocodileT_WaveScaleMax)
            set s__CrocodileSpells__CrocodileT_Struct_nextRing[this]=0.0
            set s__CrocodileSpells__CrocodileT_Struct_ringIndex[this]=0
            set s__CrocodileSpells__CrocodileT_Struct_ringPoint[this]=0
            set s__CrocodileSpells__CrocodileT_Struct_ringPoints[this]=1
            set s__CrocodileSpells__CrocodileT_Struct_patchHead[this]=0
            set s__CrocodileSpells__CrocodileT_Struct_growthHead[this]=0
            set s__CrocodileSpells__CrocodileT_Struct_patchCount[this]=0
            set s__CrocodileSpells__CrocodileT_Struct_waveHead[this]=0
            set s__CrocodileSpells__CrocodileT_Struct_maxReach[this]=0.0
            set s__CrocodileSpells__CrocodileT_Struct_spreading[this]=true
            set s__CrocodileSpells__CrocodileT_Struct_channelActive[this]=true
            call SaveBoolean(hs, GetHandleId(s__CrocodileSpells__CrocodileT_Struct_c[this]), SH_CROCODILE_T_CHANNEL, true)
            set s__CrocodileSpells__CrocodileT_Struct_invulnerabilityHeld[this]=false
            set s__CrocodileSpells__CrocodileT_Struct_spreadComplete[this]=false
            set s__CrocodileSpells__CrocodileT_Struct_manaPulse[this]=0.0
            set s__CrocodileSpells__CrocodileT_Struct_sandSlowPulse[this]=0.0
            set s__CrocodileSpells__CrocodileT_Struct_decorPulse[this]=0.0
            set s__CrocodileSpells__CrocodileT_Struct_visionPulse[this]=0.0
            call VisionTimed(GetOwningPlayer(s__CrocodileSpells__CrocodileT_Struct_c[this]) , s__CrocodileSpells__CrocodileT_Struct_x[this] , s__CrocodileSpells__CrocodileT_Struct_y[this] , s__CrocodileSpells__CrocodileT_Struct_minScale[this] * 150.0 * 1.5 , 3.0)
            set s__CrocodileSpells__CrocodileT_Struct_manaGroup[this]=CreateGroup()
            set s__CrocodileSpells__CrocodileT_Struct_animationApplied[this]=false
            set s__CrocodileSpells__CrocodileT_Struct_channelFinished[this]=false
            set s__CrocodileSpells__CrocodileT_Struct_sound2Played[this]=false
            set s__CrocodileSpells__CrocodileT_Struct_t2Pending[this]=false
            set s__CrocodileSpells__CrocodileT_Struct_t2PauseHeld[this]=false
            set s__CrocodileSpells__CrocodileT_Struct_t2Granted[this]=false
            set s__CrocodileSpells__CrocodileT_Struct_t2Available[this]=false
            set s__CrocodileSpells__CrocodileT_Struct_endNow[this]=false
            call SaveInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileT_Struct_c[this]), CrocodileSpells__CrocodileT_DataKey, this)
            call SaveInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileT_Struct_c[this]), CrocodileSpells__CrocodileT_PhaseKey, 1)
            call SaveInteger(hs, GetHandleId(s__CrocodileSpells__CrocodileT_Struct_c[this]), CrocodileSpells__SH_CAST_R, 1)
            call SaveInteger(hs, GetHandleId(s__CrocodileSpells__CrocodileT_Struct_c[this]), CrocodileSpells__SH_STOP_R, 0)
            call GearCCProtect(s__CrocodileSpells__CrocodileT_Struct_c[this] , true)
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__CrocodileSpells__CrocodileT_Struct_c[this]), CrocodileT2_ID, false)
            set s__CrocodileSpells__CrocodileT_Struct_t2Timer[this]=CreateTimer()
            call SaveInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileT_Struct_t2Timer[this]), CrocodileSpells__CrocodileT_DataKey, this)
            call TimerStart(s__CrocodileSpells__CrocodileT_Struct_t2Timer[this], RMaxBJ(0.01, CrocodileT2_CheckPeriod), true, function s__CrocodileSpells__CrocodileT_Struct_CrocodileT_ControlT2)
            if dash != 0 and s__CrocodileSpells__CrocodileE_Struct_active[dash] then
                set s__CrocodileSpells__CrocodileE_Struct_cancelDash[dash]=true
                call s__CrocodileSpells__CrocodileE_Struct_CrocodileE_Finish(dash)
            endif
            set s__CrocodileSpells__CrocodileT_Struct_aura[this]=AddSpecialEffectTarget("war3mapImported\\wos_AjeelAura2.mdl", s__CrocodileSpells__CrocodileT_Struct_c[this], "origin")
            call SetUnitTimeScale(s__CrocodileSpells__CrocodileT_Struct_c[this], 1.0)
            call MakeSound("war3mapImported\\Hero_Crocodile_T_1")
            call MakeSound("war3mapImported\\Hero_Crocodile_T_1")
            call s__CrocodileSpells__CrocodileT_Struct_CrocodileT_CreateWaves(this)
            call s__CrocodileSpells__CrocodileT_Struct_CrocodileT_Spread(this)
            return true
        endfunction

//================================ Crocodile T2 - Ground Death ========================================

        function s__CrocodileSpells__CrocodileT2_Struct_CrocodileT2_AddBlast takes real x,real y,real radius,real factor returns nothing
            set factor=RMinBJ(1.0, RMaxBJ(0.0, factor)) + 0.15
            set s__CrocodileSpells__CrocodileT2_Struct_blastX[s__CrocodileSpells__CrocodileT2_Struct_blastCount]=x
            set s__CrocodileSpells__CrocodileT2_Struct_blastY[s__CrocodileSpells__CrocodileT2_Struct_blastCount]=y
            set s__CrocodileSpells__CrocodileT2_Struct_blastRadius[s__CrocodileSpells__CrocodileT2_Struct_blastCount]=radius
            set s__CrocodileSpells__CrocodileT2_Struct_blastCount=s__CrocodileSpells__CrocodileT2_Struct_blastCount + 1
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_newdirtexnofire.mdl" , x , y , 0 , 1 , CrocodileT2_FireScaleMax * factor , 0))
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_SandPoff.mdl" , x , y , GetRandomReal(0, 359) , 2 , CrocodileT2_PoffScaleMax * factor , 0))
        endfunction

        function s__CrocodileSpells__CrocodileT2_Struct_CrocodileT2_CreateKrkRing takes real x,real y,real tRadius,real progress,integer blastPoints returns nothing
            local integer count= IMaxBJ(1, R2I(blastPoints * CrocodileT2_KrkCountMultiplier + 0.5))
            local integer j= 0
            local real distance= tRadius * CrocodileT2_BlastDistance + CrocodileT2_KrkOutwardOffset
            local real angleVariation= RMinBJ(RAbsBJ(CrocodileT2_KrkAngleVariation) * bj_DEGTORAD, bj_PI / count * 0.4)
            local real radialVariation= RMinBJ(RAbsBJ(CrocodileT2_KrkRadialVariation), RMaxBJ(0.0, distance) * 0.15)
            local real scale= CrocodileT2_KrkScaleMax * ( RMinBJ(1.0, RMaxBJ(0.0, progress)) + 0.15 )
            local real angle
            local real radius
            loop
                exitwhen j >= count
                set angle=2.0 * bj_PI * j / count + GetRandomReal(- angleVariation, angleVariation)
                set radius=RMaxBJ(1.0, distance + GetRandomReal(- radialVariation, radialVariation))
                call EffectSpawn2("krk (1889)2.mdl" , x + radius * Cos(angle) , y + radius * Sin(angle) , GetRandomReal(0, 359) , 1 , ( scale + GetRandomReal(0.05, 0.1) ) * GetRandomReal(1.0 - CrocodileT2_KrkScaleVariation, 1.0 + CrocodileT2_KrkScaleVariation) , 0 , 0.75)
                set j=j + 1
            endloop
        endfunction

        function s__CrocodileSpells__CrocodileT2_Struct_CrocodileT2_CreateBlasts takes integer ground returns nothing
            local integer seed= s__CrocodileSpells__CrocodileT_Struct_patchHead[ground]
            local integer patch
            local integer member
            local integer blastPoints
            local integer outerCount
            local real progress
            local integer count
            local integer j
            local real dx
            local real dy
            local real centerX
            local real centerY
            local real radius
            local real tRadius= 0.0
            local real angle
            local real mergeSq= RMaxBJ(0.0, CrocodileT2_MergeDistance) * RMaxBJ(0.0, CrocodileT2_MergeDistance)
            local boolean covered
            set s__CrocodileSpells__CrocodileT2_Struct_blastCount=0
            loop
                exitwhen seed == 0
                if s__CrocodileSpells__CrocodileT_Sand_fromT[seed] then
                    set s__CrocodileSpells__CrocodileT_Sand_blastMarked[seed]=true
                    set tRadius=RMaxBJ(tRadius, SR0(s__CrocodileSpells__CrocodileT_Struct_x[ground] , s__CrocodileSpells__CrocodileT_Struct_y[ground] , s__CrocodileSpells__CrocodileT_Sand_x[seed] , s__CrocodileSpells__CrocodileT_Sand_y[seed]) + s__CrocodileSpells__CrocodileT_Sand_radius[seed])
                endif
                set seed=s__CrocodileSpells__CrocodileT_Sand_next[seed]
            endloop
            if tRadius > 0.0 then
                set progress=RMinBJ(1.0, RMaxBJ(0.0, tRadius / RMaxBJ(1.0, CrocodileT_MaxAoe)))
                set blastPoints=IMinBJ(IMaxBJ(3, CrocodileT2_MaxMainBlasts), IMaxBJ(CrocodileT2_MinMainBlasts, R2I(CrocodileT2_MaxMainBlasts * progress + 0.999)))
                set outerCount=blastPoints
                set j=0
                loop
                    exitwhen j >= outerCount
                    set angle=2.0 * bj_PI * j / outerCount
                    call s__CrocodileSpells__CrocodileT2_Struct_CrocodileT2_AddBlast(s__CrocodileSpells__CrocodileT_Struct_x[ground] + tRadius * CrocodileT2_BlastDistance * Cos(angle) , s__CrocodileSpells__CrocodileT_Struct_y[ground] + tRadius * CrocodileT2_BlastDistance * Sin(angle) , tRadius * 0.7 , progress)
                    set j=j + 1
                endloop
                call s__CrocodileSpells__CrocodileT2_Struct_CrocodileT2_CreateKrkRing(s__CrocodileSpells__CrocodileT_Struct_x[ground] , s__CrocodileSpells__CrocodileT_Struct_y[ground] , tRadius , progress , blastPoints)
            endif
            set seed=s__CrocodileSpells__CrocodileT_Struct_patchHead[ground]
            loop
                exitwhen seed == 0
                if not s__CrocodileSpells__CrocodileT_Sand_blastMarked[seed] then
                    set covered=false
                    set j=0
                    loop
                        exitwhen j >= s__CrocodileSpells__CrocodileT2_Struct_blastCount or covered
                        set covered=SR0(s__CrocodileSpells__CrocodileT_Sand_x[seed] , s__CrocodileSpells__CrocodileT_Sand_y[seed] , s__CrocodileSpells__CrocodileT2_Struct_blastX[j] , s__CrocodileSpells__CrocodileT2_Struct_blastY[j]) + s__CrocodileSpells__CrocodileT_Sand_radius[seed] <= s__CrocodileSpells__CrocodileT2_Struct_blastRadius[j]
                        set j=j + 1
                    endloop
                    set s__CrocodileSpells__CrocodileT_Sand_blastMarked[seed]=true
                    if not covered then
                        set s__CrocodileSpells__CrocodileT2_Struct_cluster[0]=seed
                        set count=1
                        set centerX=s__CrocodileSpells__CrocodileT_Sand_x[seed]
                        set centerY=s__CrocodileSpells__CrocodileT_Sand_y[seed]
                        set patch=s__CrocodileSpells__CrocodileT_Struct_patchHead[ground]
                        loop
                            exitwhen patch == 0 or count >= IMaxBJ(1, IMinBJ(8192, CrocodileT2_MergeMaxPatches))
                            if not s__CrocodileSpells__CrocodileT_Sand_blastMarked[patch] then
                                set dx=s__CrocodileSpells__CrocodileT_Sand_x[patch] - s__CrocodileSpells__CrocodileT_Sand_x[seed]
                                set dy=s__CrocodileSpells__CrocodileT_Sand_y[patch] - s__CrocodileSpells__CrocodileT_Sand_y[seed]
                                if dx * dx + dy * dy <= mergeSq then
                                    set s__CrocodileSpells__CrocodileT_Sand_blastMarked[patch]=true
                                    set s__CrocodileSpells__CrocodileT2_Struct_cluster[count]=patch
                                    set count=count + 1
                                    set centerX=centerX + s__CrocodileSpells__CrocodileT_Sand_x[patch]
                                    set centerY=centerY + s__CrocodileSpells__CrocodileT_Sand_y[patch]
                                endif
                            endif
                            set patch=s__CrocodileSpells__CrocodileT_Sand_next[patch]
                        endloop
                        set centerX=centerX / count
                        set centerY=centerY / count
                        set radius=0.0
                        set j=0
                        loop
                            exitwhen j >= count
                            set member=s__CrocodileSpells__CrocodileT2_Struct_cluster[j]
                            set radius=RMaxBJ(radius, SR0(centerX , centerY , s__CrocodileSpells__CrocodileT_Sand_x[member] , s__CrocodileSpells__CrocodileT_Sand_y[member]) + s__CrocodileSpells__CrocodileT_Sand_radius[member])
                            set s__CrocodileSpells__CrocodileT2_Struct_cluster[j]=0
                            set j=j + 1
                        endloop
                        call s__CrocodileSpells__CrocodileT2_Struct_CrocodileT2_AddBlast(centerX , centerY , radius , radius / RMaxBJ(1.0, CrocodileT_MaxAoe))
                        call EffectSpawn2("war3mapimported\\wos_krk (1889)2.mdl" , centerX , centerY , GetRandomReal(0, 359) , 1 , CrocodileT2_KrkScaleMax * ( RMinBJ(1.0, RMaxBJ(0.0, radius / RMaxBJ(1.0, CrocodileT_MaxAoe))) + 0.15 ) + GetRandomReal(0.05, 0.1) , 0 , 0.75)
                    endif
                endif
                set seed=s__CrocodileSpells__CrocodileT_Sand_next[seed]
            endloop
        endfunction

        function s__CrocodileSpells__CrocodileT2_Struct_CrocodileT2_CollectSand takes integer ground returns nothing
            local integer sand
            local integer patch
            local integer i= 0
            loop
                exitwhen i > s__CrocodileSpells__CrocodileSand_Struct_MUI
                set sand=s__CrocodileSpells__CrocodileSand_Struct_m[i]
                if s__CrocodileSpells__CrocodileSand_Struct_c[sand] == s__CrocodileSpells__CrocodileT_Struct_c[ground] and not s__CrocodileSpells__CrocodileSand_Struct_endNow[sand] and s__CrocodileSpells__CrocodileSand_Struct_r[sand] < s__CrocodileSpells__CrocodileSand_Struct_rmax[sand] then
                    set patch=s__CrocodileSpells__CrocodileT_Sand_CrocodileTSand_Collect(sand)
                    set s__CrocodileSpells__CrocodileT_Sand_next[patch]=s__CrocodileSpells__CrocodileT_Struct_patchHead[ground]
                    set s__CrocodileSpells__CrocodileT_Struct_patchHead[ground]=patch
                    set s__CrocodileSpells__CrocodileT_Struct_patchCount[ground]=s__CrocodileSpells__CrocodileT_Struct_patchCount[ground] + 1
                    set s__CrocodileSpells__CrocodileT_Struct_maxReach[ground]=RMaxBJ(s__CrocodileSpells__CrocodileT_Struct_maxReach[ground], SR0(s__CrocodileSpells__CrocodileT_Struct_x[ground] , s__CrocodileSpells__CrocodileT_Struct_y[ground] , s__CrocodileSpells__CrocodileT_Sand_x[patch] , s__CrocodileSpells__CrocodileT_Sand_y[patch]) + s__CrocodileSpells__CrocodileT_Sand_radius[patch])
                endif
                set i=i + 1
            endloop
        endfunction

        function s__CrocodileSpells__CrocodileT2_Struct_CrocodileT2_Detonate takes integer ground returns nothing
            local unit c= s__CrocodileSpells__CrocodileT_Struct_c[ground]
            local group scan
            local integer patch
            local integer i
            local unit u
            call MakeSound("war3mapImported\\Hero_Crocodile_T2_2")
            call s__CrocodileSpells__CrocodileT2_Struct_CrocodileT2_CollectSand(ground)
            set patch=s__CrocodileSpells__CrocodileT_Struct_patchHead[ground]
            loop
                exitwhen patch == 0
                call VisionTimed(GetOwningPlayer(c) , s__CrocodileSpells__CrocodileT_Sand_x[patch] , s__CrocodileSpells__CrocodileT_Sand_y[patch] , s__CrocodileSpells__CrocodileT_Sand_radius[patch] * 1.5 , 3.0)
                set patch=s__CrocodileSpells__CrocodileT_Sand_next[patch]
            endloop
            set scan=CreateGroup()
            // One broad enumeration; exact original patch areas decide the damage.
            call GroupEnumUnitsInRange(scan, s__CrocodileSpells__CrocodileT_Struct_x[ground], s__CrocodileSpells__CrocodileT_Struct_y[ground], s__CrocodileSpells__CrocodileT_Struct_maxReach[ground], NoDecor_Cond)
            set i=BlzGroupGetSize(scan) - 1
            loop
                exitwhen i < 0
                set u=BlzGroupUnitAt(scan, i)
                if not SpellBool(u) or not IsUnitEnemy(u, GetOwningPlayer(c)) or IsUnitType(u, UNIT_TYPE_STRUCTURE) or not s__CrocodileSpells__CrocodileT_Struct_CrocodileT_Contains(ground,GetUnitX(u) , GetUnitY(u)) then
                    call GroupRemoveUnit(scan, u)
                endif
                set i=i - 1
            endloop
            call s__CrocodileSpells__CrocodileT2_Struct_CrocodileT2_CreateBlasts(ground)
            call s__CrocodileSpells__CrocodileT_Struct_CrocodileT_Clear(ground,false)
            // Detach the old cast before damage callbacks can kill or recast the hero.
            loop
                set u=FirstOfGroup(scan)
                exitwhen u == null
                call GroupRemoveUnit(scan, u)
                set GearDamageNextSource=('A0IC') // INLINED!!
                call CrocodileSpells__Crocodile_SpellDamage(c , u , GetHeroAgi(c, true) * CrocodileT2_DamageAgi , - 1)
                call CrocodileSpells__Crocodile_ApplySharedMark(c , u)
            endloop
            call DestroyGroup(scan)
            set scan=null
            set u=null
            set c=null
        endfunction

        function s__CrocodileSpells__CrocodileT2_Struct_CrocodileT2_Begin takes unit c returns boolean
            local integer ground= LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(c), CrocodileSpells__CrocodileT_DataKey)
            if ground == 0 or s__CrocodileSpells__CrocodileT_Struct_endNow[ground] or not s__CrocodileSpells__CrocodileT_Struct_t2Granted[ground] or s__CrocodileSpells__CrocodileT_Struct_t2Pending[ground] or s__CrocodileSpells__CrocodileT_Struct_r[ground] + 0.001 >= s__CrocodileSpells__CrocodileT_Struct_endTime[ground] or not SpellBoolCaster(c) or not s__CrocodileSpells__CrocodileT_Struct_CrocodileT_IsOnSand(c) then
                return false
            endif
            call s__CrocodileSpells__CrocodileT_Struct_CrocodileT_EndChannel(ground)
            set s__CrocodileSpells__CrocodileT_Struct_animationApplied[ground]=false
            set s__CrocodileSpells__CrocodileT_Struct_t2Pending[ground]=true
            call SaveBoolean(hs, GetHandleId(c), SH_CROCODILE_T_CHANNEL, true)
            set s__CrocodileSpells__CrocodileT_Struct_t2Time[ground]=- TimerGetElapsed(GearTimer03)
            set s__CrocodileSpells__CrocodileT_Struct_t2PauseHeld[ground]=true
            call SaveInteger(CrocodileSpells__CrocodileTable, GetHandleId(c), CrocodileSpells__CrocodileT_PhaseKey, 1)
            call StartSpellUnit2(c)
            set s__CrocodileSpells__CrocodileT_Struct_t2Available[ground]=false
            call SetPlayerAbilityAvailable(GetOwningPlayer(c), CrocodileT2_ID, false)
            call MakeSound("war3mapImported\\Hero_Crocodile_T2_1")
            return true
        endfunction

        function s__CrocodileSpells__CrocodileT2_Struct_Loop_CrocodileT2 takes nothing returns nothing
            local integer ground
            local integer i= 0
            loop
                exitwhen i > s__CrocodileSpells__CrocodileT_Struct_MUI
                set ground=s__CrocodileSpells__CrocodileT_Struct_m[i]
                if not s__CrocodileSpells__CrocodileT_Struct_endNow[ground] and s__CrocodileSpells__CrocodileT_Struct_t2Pending[ground] and s__CrocodileSpells__CrocodileT_Struct_t2Time[ground] + 0.001 >= CrocodileT2_Delay then
                    call s__CrocodileSpells__CrocodileT2_Struct_CrocodileT2_Detonate(ground)
                endif
                set i=i + 1
            endloop
        endfunction

//================================ Crocodile F projectile ========================================
        function s__CrocodileSpells__CrocodileF_Projectile_CrocodileF_HitSegment takes integer this,real segmentX,real segmentY,real angle,real length returns nothing
            local unit u
            local real projection
            local real px
            local real py
            call GroupEnumUnitsInRange(s__CrocodileSpells__CrocodileF_Projectile_g[this], segmentX + length * 0.5 * Cos(angle), segmentY + length * 0.5 * Sin(angle), s__CrocodileSpells__CrocodileF_Projectile_radius[this] + length * 0.5, NoDecor_Cond)
            loop
                set u=FirstOfGroup(s__CrocodileSpells__CrocodileF_Projectile_g[this])
                exitwhen u == null
                call GroupRemoveUnit(s__CrocodileSpells__CrocodileF_Projectile_g[this], u)
                set projection=RMaxBJ(0.0, RMinBJ(length, ( GetUnitX(u) - segmentX ) * Cos(angle) + ( GetUnitY(u) - segmentY ) * Sin(angle)))
                set px=segmentX + projection * Cos(angle)
                set py=segmentY + projection * Sin(angle)
                if SpellBool(u) and IsUnitEnemy(u, GetOwningPlayer(s__CrocodileSpells__CrocodileF_Projectile_c[this])) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) and not IsUnitInGroup(u, s__CrocodileSpells__CrocodileF_Projectile_g2[this]) and SR3(u , px , py) <= s__CrocodileSpells__CrocodileF_Projectile_radius[this] then
                    // A shared group covers all three blades: one 3x hit per enemy.
                    call GroupAddUnit(s__CrocodileSpells__CrocodileF_Projectile_g2[this], u)
                    set GearDamageNextSource=('A0ID') // INLINED!!
                    call dmgatk(s__CrocodileSpells__CrocodileF_Projectile_c[this] , u , s__CrocodileSpells__CrocodileF_Projectile_dmg[this])
                endif
            endloop
            set u=null
        endfunction

        function s__CrocodileSpells__CrocodileF_Projectile_CrocodileF_EnvironmentSegment takes integer this,real angle,real length returns nothing
            call VisionTimed(GetOwningPlayer(s__CrocodileSpells__CrocodileF_Projectile_c[this]) , s__CrocodileSpells__CrocodileF_Projectile_x[this] + ( s__CrocodileSpells__CrocodileF_Projectile_environmentDistance[this] + length * 0.5 ) * Cos(angle) , s__CrocodileSpells__CrocodileF_Projectile_y[this] + ( s__CrocodileSpells__CrocodileF_Projectile_environmentDistance[this] + length * 0.5 ) * Sin(angle) , s__CrocodileSpells__CrocodileF_Projectile_radius[this] * 1.5 , 2.0)
            call DecorRemoveLine(s__CrocodileSpells__CrocodileF_Projectile_c[this] , s__CrocodileSpells__CrocodileF_Projectile_x[this] + s__CrocodileSpells__CrocodileF_Projectile_environmentDistance[this] * Cos(angle) , s__CrocodileSpells__CrocodileF_Projectile_y[this] + s__CrocodileSpells__CrocodileF_Projectile_environmentDistance[this] * Sin(angle) , angle , length , s__CrocodileSpells__CrocodileF_Projectile_radius[this] , 50.0 , CrocodileSpells__CrocodileDecorHits , s__CrocodileSpells__CrocodileF_Projectile_decorKey[this])
        endfunction

        function s__CrocodileSpells__CrocodileF_Projectile_Loop_CrocodileF_Projectile takes nothing returns nothing
            local integer this
            local integer i= 0
            local real step
            local real section
            loop
                exitwhen i > s__CrocodileSpells__CrocodileF_Projectile_MUI
                set this=s__CrocodileSpells__CrocodileF_Projectile_m[i]
                if SpellBoolCaster(s__CrocodileSpells__CrocodileF_Projectile_c[this]) and LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileF_Projectile_c[this]), CrocodileSpells__CrocodileCore_DataKey) != 0 then
                    if s__CrocodileSpells__CrocodileF_Projectile_moveDelay[this] > 0.001 then
                        set s__CrocodileSpells__CrocodileF_Projectile_moveDelay[this]=RMaxBJ(0.0, s__CrocodileSpells__CrocodileF_Projectile_moveDelay[this] - CrocodileSpells__CrocodilePeriod)
                    else
                    set step=RMinBJ(CrocodileF_ProjectileSpeed * CrocodileSpells__CrocodilePeriod, s__CrocodileSpells__CrocodileF_Projectile_maxDistance[this] - s__CrocodileSpells__CrocodileF_Projectile_distance[this])
                    call s__CrocodileSpells__CrocodileF_Projectile_CrocodileF_HitSegment(this,s__CrocodileSpells__CrocodileF_Projectile_x[this] + s__CrocodileSpells__CrocodileF_Projectile_distance[this] * Cos(s__CrocodileSpells__CrocodileF_Projectile_a[this]) , s__CrocodileSpells__CrocodileF_Projectile_y[this] + s__CrocodileSpells__CrocodileF_Projectile_distance[this] * Sin(s__CrocodileSpells__CrocodileF_Projectile_a[this]) , s__CrocodileSpells__CrocodileF_Projectile_a[this] , step)
                    call s__CrocodileSpells__CrocodileF_Projectile_CrocodileF_HitSegment(this,s__CrocodileSpells__CrocodileF_Projectile_x[this] + s__CrocodileSpells__CrocodileF_Projectile_distance[this] * Cos(s__CrocodileSpells__CrocodileF_Projectile_a[this] + s__CrocodileSpells__CrocodileF_Projectile_spread[this]) , s__CrocodileSpells__CrocodileF_Projectile_y[this] + s__CrocodileSpells__CrocodileF_Projectile_distance[this] * Sin(s__CrocodileSpells__CrocodileF_Projectile_a[this] + s__CrocodileSpells__CrocodileF_Projectile_spread[this]) , s__CrocodileSpells__CrocodileF_Projectile_a[this] + s__CrocodileSpells__CrocodileF_Projectile_spread[this] , step)
                    call s__CrocodileSpells__CrocodileF_Projectile_CrocodileF_HitSegment(this,s__CrocodileSpells__CrocodileF_Projectile_x[this] + s__CrocodileSpells__CrocodileF_Projectile_distance[this] * Cos(s__CrocodileSpells__CrocodileF_Projectile_a[this] - s__CrocodileSpells__CrocodileF_Projectile_spread[this]) , s__CrocodileSpells__CrocodileF_Projectile_y[this] + s__CrocodileSpells__CrocodileF_Projectile_distance[this] * Sin(s__CrocodileSpells__CrocodileF_Projectile_a[this] - s__CrocodileSpells__CrocodileF_Projectile_spread[this]) , s__CrocodileSpells__CrocodileF_Projectile_a[this] - s__CrocodileSpells__CrocodileF_Projectile_spread[this] , step)
                    set s__CrocodileSpells__CrocodileF_Projectile_distance[this]=s__CrocodileSpells__CrocodileF_Projectile_distance[this] + step
                    loop
                        exitwhen s__CrocodileSpells__CrocodileF_Projectile_environmentDistance[this] >= s__CrocodileSpells__CrocodileF_Projectile_distance[this] or ( s__CrocodileSpells__CrocodileF_Projectile_distance[this] - s__CrocodileSpells__CrocodileF_Projectile_environmentDistance[this] + 0.001 < s__CrocodileSpells__CrocodileF_Projectile_radius[this] and s__CrocodileSpells__CrocodileF_Projectile_distance[this] + 0.001 < s__CrocodileSpells__CrocodileF_Projectile_maxDistance[this] )
                        set section=RMinBJ(s__CrocodileSpells__CrocodileF_Projectile_radius[this], s__CrocodileSpells__CrocodileF_Projectile_distance[this] - s__CrocodileSpells__CrocodileF_Projectile_environmentDistance[this])
                        call s__CrocodileSpells__CrocodileF_Projectile_CrocodileF_EnvironmentSegment(this,s__CrocodileSpells__CrocodileF_Projectile_a[this] , section)
                        call s__CrocodileSpells__CrocodileF_Projectile_CrocodileF_EnvironmentSegment(this,s__CrocodileSpells__CrocodileF_Projectile_a[this] + s__CrocodileSpells__CrocodileF_Projectile_spread[this] , section)
                        call s__CrocodileSpells__CrocodileF_Projectile_CrocodileF_EnvironmentSegment(this,s__CrocodileSpells__CrocodileF_Projectile_a[this] - s__CrocodileSpells__CrocodileF_Projectile_spread[this] , section)
                        set s__CrocodileSpells__CrocodileF_Projectile_environmentDistance[this]=s__CrocodileSpells__CrocodileF_Projectile_environmentDistance[this] + section
                    endloop
                    call MoveEff(s__CrocodileSpells__CrocodileF_Projectile_e[this] , step , s__CrocodileSpells__CrocodileF_Projectile_a[this])
                    call MoveEff(s__CrocodileSpells__CrocodileF_Projectile_e2[this] , step , s__CrocodileSpells__CrocodileF_Projectile_a[this] + s__CrocodileSpells__CrocodileF_Projectile_spread[this])
                    call MoveEff(s__CrocodileSpells__CrocodileF_Projectile_e3[this] , step , s__CrocodileSpells__CrocodileF_Projectile_a[this] - s__CrocodileSpells__CrocodileF_Projectile_spread[this])
                    loop
                        exitwhen s__CrocodileSpells__CrocodileF_Projectile_nextSand[this] > s__CrocodileSpells__CrocodileF_Projectile_distance[this] + 0.001
                        call s__CrocodileSpells__CrocodileSand_Struct_CrocodileSand_Start(s__CrocodileSpells__CrocodileF_Projectile_c[this] , s__CrocodileSpells__CrocodileF_Projectile_x[this] + s__CrocodileSpells__CrocodileF_Projectile_nextSand[this] * Cos(s__CrocodileSpells__CrocodileF_Projectile_a[this]) , s__CrocodileSpells__CrocodileF_Projectile_y[this] + s__CrocodileSpells__CrocodileF_Projectile_nextSand[this] * Sin(s__CrocodileSpells__CrocodileF_Projectile_a[this]) , CrocodileSand_Radius , false)
                        call s__CrocodileSpells__CrocodileSand_Struct_CrocodileSand_Start(s__CrocodileSpells__CrocodileF_Projectile_c[this] , s__CrocodileSpells__CrocodileF_Projectile_x[this] + s__CrocodileSpells__CrocodileF_Projectile_nextSand[this] * Cos(s__CrocodileSpells__CrocodileF_Projectile_a[this] + s__CrocodileSpells__CrocodileF_Projectile_spread[this]) , s__CrocodileSpells__CrocodileF_Projectile_y[this] + s__CrocodileSpells__CrocodileF_Projectile_nextSand[this] * Sin(s__CrocodileSpells__CrocodileF_Projectile_a[this] + s__CrocodileSpells__CrocodileF_Projectile_spread[this]) , CrocodileSand_Radius , false)
                        call s__CrocodileSpells__CrocodileSand_Struct_CrocodileSand_Start(s__CrocodileSpells__CrocodileF_Projectile_c[this] , s__CrocodileSpells__CrocodileF_Projectile_x[this] + s__CrocodileSpells__CrocodileF_Projectile_nextSand[this] * Cos(s__CrocodileSpells__CrocodileF_Projectile_a[this] - s__CrocodileSpells__CrocodileF_Projectile_spread[this]) , s__CrocodileSpells__CrocodileF_Projectile_y[this] + s__CrocodileSpells__CrocodileF_Projectile_nextSand[this] * Sin(s__CrocodileSpells__CrocodileF_Projectile_a[this] - s__CrocodileSpells__CrocodileF_Projectile_spread[this]) , CrocodileSand_Radius , false)
                        set s__CrocodileSpells__CrocodileF_Projectile_nextSand[this]=s__CrocodileSpells__CrocodileF_Projectile_nextSand[this] + s__CrocodileSpells__CrocodileF_Projectile_sandSpacing[this]
                    endloop
                    if s__CrocodileSpells__CrocodileF_Projectile_r2[this] > 0.06 then
                    set s__CrocodileSpells__CrocodileF_Projectile_r2[this]=0
                    call DestroyEffect(EffectSpawn("war3mapImported\\wos_SandExplosion.mdl" , s__CrocodileSpells__CrocodileF_Projectile_x[this] + s__CrocodileSpells__CrocodileF_Projectile_nextSand[this] * Cos(s__CrocodileSpells__CrocodileF_Projectile_a[this]) , s__CrocodileSpells__CrocodileF_Projectile_y[this] + s__CrocodileSpells__CrocodileF_Projectile_nextSand[this] * Sin(s__CrocodileSpells__CrocodileF_Projectile_a[this]) , 0 , 2.5 , 3 , 115))
                    //call DestroyEffect(EffectSpawn("war3mapImported\\wos_SandPoff.mdl",x+nextSand*Cos(a),y+nextSand*Sin(a),0,1,2,1))
                    call DestroyEffect(EffectSpawn("war3mapImported\\wos_SandExplosion.mdl" , s__CrocodileSpells__CrocodileF_Projectile_x[this] + s__CrocodileSpells__CrocodileF_Projectile_nextSand[this] * Cos(s__CrocodileSpells__CrocodileF_Projectile_a[this] + s__CrocodileSpells__CrocodileF_Projectile_spread[this]) , s__CrocodileSpells__CrocodileF_Projectile_y[this] + s__CrocodileSpells__CrocodileF_Projectile_nextSand[this] * Sin(s__CrocodileSpells__CrocodileF_Projectile_a[this] + s__CrocodileSpells__CrocodileF_Projectile_spread[this]) , 0 , 2.5 , 3 , 115))
                    //call DestroyEffect(EffectSpawn("war3mapImported\\wos_SandPoff.mdl",x+nextSand*Cos(a+spread),y+nextSand*Sin(a+spread),0,1,2,1))
                    call DestroyEffect(EffectSpawn("war3mapImported\\wos_SandExplosion.mdl" , s__CrocodileSpells__CrocodileF_Projectile_x[this] + s__CrocodileSpells__CrocodileF_Projectile_nextSand[this] * Cos(s__CrocodileSpells__CrocodileF_Projectile_a[this] - s__CrocodileSpells__CrocodileF_Projectile_spread[this]) , s__CrocodileSpells__CrocodileF_Projectile_y[this] + s__CrocodileSpells__CrocodileF_Projectile_nextSand[this] * Sin(s__CrocodileSpells__CrocodileF_Projectile_a[this] - s__CrocodileSpells__CrocodileF_Projectile_spread[this]) , 0 , 2.5 , 3 , 115))
                    //call DestroyEffect(EffectSpawn("war3mapImported\\wos_SandPoff.mdl",x+nextSand*Cos(a-spread),y+nextSand*Sin(a-spread),0,1,2,1))
                    else
                    set s__CrocodileSpells__CrocodileF_Projectile_r2[this]=s__CrocodileSpells__CrocodileF_Projectile_r2[this] + 0.03
                    endif
                    endif
                endif
                if s__CrocodileSpells__CrocodileF_Projectile_distance[this] >= s__CrocodileSpells__CrocodileF_Projectile_maxDistance[this] or not SpellBoolCaster(s__CrocodileSpells__CrocodileF_Projectile_c[this]) or LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileF_Projectile_c[this]), CrocodileSpells__CrocodileCore_DataKey) == 0 then
                    call FlushChildHashtable(CrocodileSpells__CrocodileDecorHits, s__CrocodileSpells__CrocodileF_Projectile_decorKey[this])
                    call ColorEffDummy3Alpha((s__CrocodileSpells__CrocodileF_Projectile_e[this] ) , (( 0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.45)*1.0)) // INLINED!!
                    call ColorEffDummy3Alpha((s__CrocodileSpells__CrocodileF_Projectile_e2[this] ) , (( 0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.45)*1.0)) // INLINED!!
                    call ColorEffDummy3Alpha((s__CrocodileSpells__CrocodileF_Projectile_e3[this] ) , (( 0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.45)*1.0)) // INLINED!!
                    call DestroyGroup(s__CrocodileSpells__CrocodileF_Projectile_g[this])
                    call DestroyGroup(s__CrocodileSpells__CrocodileF_Projectile_g2[this])
                    set s__CrocodileSpells__CrocodileF_Projectile_c[this]=null
                    set s__CrocodileSpells__CrocodileF_Projectile_e[this]=null
                    set s__CrocodileSpells__CrocodileF_Projectile_e2[this]=null
                    set s__CrocodileSpells__CrocodileF_Projectile_e3[this]=null
                    set s__CrocodileSpells__CrocodileF_Projectile_g[this]=null
                    set s__CrocodileSpells__CrocodileF_Projectile_g2[this]=null
                    set s__CrocodileSpells__CrocodileF_Projectile_m[i]=s__CrocodileSpells__CrocodileF_Projectile_m[s__CrocodileSpells__CrocodileF_Projectile_MUI]
                    set s__CrocodileSpells__CrocodileF_Projectile_MUI=s__CrocodileSpells__CrocodileF_Projectile_MUI - 1
                    call s__CrocodileSpells__CrocodileF_Projectile_deallocate(this)
                    if s__CrocodileSpells__CrocodileF_Projectile_MUI == - 1 then
                        call GearTimer03Release()
                    endif
                else
                    set i=i + 1
                endif
            endloop
        endfunction

        function s__CrocodileSpells__CrocodileF_Projectile_CrocodileF_Projectile_Start takes unit NewC,unit target returns nothing
            local integer this= s__CrocodileSpells__CrocodileF_Projectile__allocate()
            set s__CrocodileSpells__CrocodileF_Projectile_MUI=s__CrocodileSpells__CrocodileF_Projectile_MUI + 1
            set s__CrocodileSpells__CrocodileF_Projectile_m[s__CrocodileSpells__CrocodileF_Projectile_MUI]=this
            if s__CrocodileSpells__CrocodileF_Projectile_MUI == 0 then
                call GearTimer03Acquire()
            endif
            set s__CrocodileSpells__CrocodileF_Projectile_c[this]=NewC
            set s__CrocodileSpells__CrocodileF_Projectile_x[this]=GetUnitX(s__CrocodileSpells__CrocodileF_Projectile_c[this])
            set s__CrocodileSpells__CrocodileF_Projectile_y[this]=GetUnitY(s__CrocodileSpells__CrocodileF_Projectile_c[this])
            set s__CrocodileSpells__CrocodileF_Projectile_a[this]=Atan2(GetUnitY(target) - s__CrocodileSpells__CrocodileF_Projectile_y[this], GetUnitX(target) - s__CrocodileSpells__CrocodileF_Projectile_x[this])
            if SR3(target , s__CrocodileSpells__CrocodileF_Projectile_x[this] , s__CrocodileSpells__CrocodileF_Projectile_y[this]) < 1.0 then
                set s__CrocodileSpells__CrocodileF_Projectile_a[this]=GetUnitFacing(s__CrocodileSpells__CrocodileF_Projectile_c[this]) * bj_DEGTORAD
            endif
            set s__CrocodileSpells__CrocodileF_Projectile_x[this]=s__CrocodileSpells__CrocodileF_Projectile_x[this] + 200 * Cos(s__CrocodileSpells__CrocodileF_Projectile_a[this])
            set s__CrocodileSpells__CrocodileF_Projectile_y[this]=s__CrocodileSpells__CrocodileF_Projectile_y[this] + 200 * Sin(s__CrocodileSpells__CrocodileF_Projectile_a[this])
            set s__CrocodileSpells__CrocodileF_Projectile_distance[this]=0.0
            set s__CrocodileSpells__CrocodileF_Projectile_moveDelay[this]=RMaxBJ(0.0, CrocodileF_BladeMoveDelay) + TimerGetElapsed(GearTimer03)
            set s__CrocodileSpells__CrocodileF_Projectile_r2[this]=0.0
            set s__CrocodileSpells__CrocodileF_Projectile_dmg[this]=GetHeroAgi(s__CrocodileSpells__CrocodileF_Projectile_c[this], true) * CrocodileF_DamageAgi * 3.0
            set s__CrocodileSpells__CrocodileF_Projectile_spread[this]=CrocodileF_SpreadAngle * bj_DEGTORAD
            // The side rays pass D*sin(15 degrees) away from the aimed target.
            set s__CrocodileSpells__CrocodileF_Projectile_radius[this]=RMaxBJ(CrocodileF_ProjectileAoe, SR3(target , s__CrocodileSpells__CrocodileF_Projectile_x[this] , s__CrocodileSpells__CrocodileF_Projectile_y[this]) * RAbsBJ(Sin(s__CrocodileSpells__CrocodileF_Projectile_spread[this])) + CrocodileF_TargetPadding)
            set s__CrocodileSpells__CrocodileF_Projectile_maxDistance[this]=CrocodileF_ProjectileRange
            set s__CrocodileSpells__CrocodileF_Projectile_sandSpacing[this]=RMaxBJ(CrocodileSand_MinDistance, CrocodileF_SandSpacing)
            set s__CrocodileSpells__CrocodileF_Projectile_nextSand[this]=s__CrocodileSpells__CrocodileF_Projectile_sandSpacing[this]
            set s__CrocodileSpells__CrocodileF_Projectile_environmentDistance[this]=0.0
            set s__CrocodileSpells__CrocodileF_Projectile_decorKey[this]=CrocodileSpells__CrocodileDecor_NewKey()
            call VisionTimed(GetOwningPlayer(s__CrocodileSpells__CrocodileF_Projectile_c[this]) , s__CrocodileSpells__CrocodileF_Projectile_x[this] , s__CrocodileSpells__CrocodileF_Projectile_y[this] , s__CrocodileSpells__CrocodileF_Projectile_radius[this] * 1.5 , 2.0)
            set s__CrocodileSpells__CrocodileF_Projectile_g[this]=CreateGroup()
            set s__CrocodileSpells__CrocodileF_Projectile_g2[this]=CreateGroup()
            call MakeSound("war3mapImported\\Hero_Crocodile_F4")
            set s__CrocodileSpells__CrocodileF_Projectile_e[this]=EffectSpawn("war3mapImported\\wos_[DoFT]CrocodileWeapon.mdl" , s__CrocodileSpells__CrocodileF_Projectile_x[this] , s__CrocodileSpells__CrocodileF_Projectile_y[this] , s__CrocodileSpells__CrocodileF_Projectile_a[this] * bj_RADTODEG , CrocodileF_BladeAnimationSpeed , CrocodileF_BladeScale , CrocodileF_BladeHeight)
            set s__CrocodileSpells__CrocodileF_Projectile_e2[this]=EffectSpawn("war3mapImported\\wos_[DoFT]CrocodileWeapon.mdl" , s__CrocodileSpells__CrocodileF_Projectile_x[this] , s__CrocodileSpells__CrocodileF_Projectile_y[this] , ( s__CrocodileSpells__CrocodileF_Projectile_a[this] + s__CrocodileSpells__CrocodileF_Projectile_spread[this] ) * bj_RADTODEG , CrocodileF_BladeAnimationSpeed , CrocodileF_BladeScale , CrocodileF_BladeHeight)
            set s__CrocodileSpells__CrocodileF_Projectile_e3[this]=EffectSpawn("war3mapImported\\wos_[DoFT]CrocodileWeapon.mdl" , s__CrocodileSpells__CrocodileF_Projectile_x[this] , s__CrocodileSpells__CrocodileF_Projectile_y[this] , ( s__CrocodileSpells__CrocodileF_Projectile_a[this] - s__CrocodileSpells__CrocodileF_Projectile_spread[this] ) * bj_RADTODEG , CrocodileF_BladeAnimationSpeed , CrocodileF_BladeScale , CrocodileF_BladeHeight)
            call s__CrocodileSpells__CrocodileSand_Struct_CrocodileSand_Start(s__CrocodileSpells__CrocodileF_Projectile_c[this] , s__CrocodileSpells__CrocodileF_Projectile_x[this] , s__CrocodileSpells__CrocodileF_Projectile_y[this] , CrocodileSand_Radius , false)
        endfunction

    function s__CrocodileSpells__CrocodileF_Single_CrocodileF_Single_Start takes unit c,unit target returns nothing
        local real x= GetUnitX(target)
        local real y= GetUnitY(target)
        local real a= GetRandomReal(0.0, 2.0 * bj_PI)

        local real sx= x + CrocodileF_SingleOffset * Cos(a)
        local real sy= y + CrocodileF_SingleOffset * Sin(a)
        local real face= Atan2(y - sy, x - sx) * bj_RADTODEG + 180

        call ColorEffDummy3Alpha((EffectSpawn3("war3mapImported\\wos_[DoFT]Crocodile nits.mdl" , sx , sy , face , 1 , CrocodileF_SingleScale , CrocodileF_EffectHeight , - 45) ) , (( 0.3 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.3)*1.0)) // INLINED!!

        call DestroyEffect(EffectSpawn("war3mapImported\\wos_SandExplosion.mdl" , x , y , 0 , 1 , 3 , 115))
        call DestroyEffect(EffectSpawn("war3mapImported\\wos_SandPoff.mdl" , x , y , 0 , 1 , 2 , 1))
        call DestroyEffect(EffectSpawn("war3mapImported\\wos_newdirtexnofire.mdl" , x , y , 0 , 1 , 2 , 1))
        call DestroyEffect(AddSpecialEffectTarget("war3mapimported\\wos_A_[doft]hero_skeletonking_n2s_e_star.mdx", target, "chest"))
        call VisionTimed(GetOwningPlayer(c) , x , y , CrocodileF_ProjectileAoe * 1.5 , 2.0)
        call DecorRemove(c , x , y , CrocodileF_ProjectileAoe , 20.0)
        call MakeSound("war3mapImported\\Hero_Crocodile_F5")

        if SpellBool(target) and IsUnitEnemy(target, GetOwningPlayer(c)) and not IsUnitType(target, UNIT_TYPE_STRUCTURE) then
            set GearDamageNextSource=('A0ID') // INLINED!!
            call dmgatk(c , target , GetHeroAgi(c, true) * CrocodileF_DamageAgi)
        endif
    endfunction
//================================ Crocodile F - La Spada ========================================

        function s__CrocodileSpells__CrocodileF_Struct_CrocodileF_SetEnhanced takes integer this,boolean enabled returns nothing
            local ability a
            local real current
            if enabled == s__CrocodileSpells__CrocodileF_Struct_enhanced[this] then
                return
            endif
            set s__CrocodileSpells__CrocodileF_Struct_enhanced[this]=enabled
            if enabled then
                // Native item bonus follows WoS's ability-based stat modifiers.
                set s__CrocodileSpells__CrocodileF_Struct_ownsAS[this]=GetUnitAbilityLevel(s__CrocodileSpells__CrocodileF_Struct_c[this], 'AIsx') == 0
                if s__CrocodileSpells__CrocodileF_Struct_ownsAS[this] then
                    call UnitAddAbility(s__CrocodileSpells__CrocodileF_Struct_c[this], 'AIsx')
                endif
                set a=BlzGetUnitAbility(s__CrocodileSpells__CrocodileF_Struct_c[this], 'AIsx')
                set s__CrocodileSpells__CrocodileF_Struct_savedAS[this]=BlzGetAbilityRealLevelField(a, ABILITY_RLF_ATTACK_SPEED_INCREASE_ISX1, 0)
                if s__CrocodileSpells__CrocodileF_Struct_ownsAS[this] then
                    set current=CrocodileF_AttackSpeed
                else
                    set current=s__CrocodileSpells__CrocodileF_Struct_savedAS[this] + CrocodileF_AttackSpeed
                endif
                call BlzSetAbilityRealLevelField(a, ABILITY_RLF_ATTACK_SPEED_INCREASE_ISX1, 0, current)
                call CrocodileSpells__CrocodileBonus_Refresh(s__CrocodileSpells__CrocodileF_Struct_c[this] , 'AIsx')
                set s__CrocodileSpells__CrocodileF_Struct_attack1Enabled[this]=BlzGetUnitWeaponBooleanField(s__CrocodileSpells__CrocodileF_Struct_c[this], UNIT_WEAPON_BF_ATTACKS_ENABLED, 0)
                set s__CrocodileSpells__CrocodileF_Struct_attack2Enabled[this]=BlzGetUnitWeaponBooleanField(s__CrocodileSpells__CrocodileF_Struct_c[this], UNIT_WEAPON_BF_ATTACKS_ENABLED, 1)
                // F uses only Attack 1; save its melee range before enhancing it.
                set s__CrocodileSpells__CrocodileF_Struct_savedRange[this]=BlzGetUnitWeaponRealField(s__CrocodileSpells__CrocodileF_Struct_c[this], UNIT_WEAPON_RF_ATTACK_RANGE, 0)
                call BlzSetUnitWeaponBooleanField(s__CrocodileSpells__CrocodileF_Struct_c[this], UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, true)
                call BlzSetUnitWeaponBooleanField(s__CrocodileSpells__CrocodileF_Struct_c[this], UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, false)
                call SetUnitRange(s__CrocodileSpells__CrocodileF_Struct_c[this] , CrocodileF_Range)

                // BACKUP PREVIOUS F: both attacks enabled, fixed Weapon 2 range.
                // call BlzSetUnitWeaponBooleanField(c, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, true)
                // call BlzSetUnitWeaponBooleanField(c, UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, true)

                // BACKUP OLD F WEAPON SWITCH:
                // call BlzSetUnitWeaponBooleanField(c, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, false)
                // call BlzSetUnitWeaponBooleanField(c, UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, true)
            else
                set a=BlzGetUnitAbility(s__CrocodileSpells__CrocodileF_Struct_c[this], 'AIsx')
                set current=BlzGetAbilityRealLevelField(a, ABILITY_RLF_ATTACK_SPEED_INCREASE_ISX1, 0)
                if s__CrocodileSpells__CrocodileF_Struct_ownsAS[this] and RAbsBJ(current - CrocodileF_AttackSpeed) < 0.001 then
                    call UnitRemoveAbility(s__CrocodileSpells__CrocodileF_Struct_c[this], 'AIsx')
                else
                    if s__CrocodileSpells__CrocodileF_Struct_ownsAS[this] then
                        set current=current - CrocodileF_AttackSpeed + s__CrocodileSpells__CrocodileF_Struct_savedAS[this]
                    else
                        set current=current - CrocodileF_AttackSpeed
                    endif
                    call BlzSetAbilityRealLevelField(a, ABILITY_RLF_ATTACK_SPEED_INCREASE_ISX1, 0, current)
                    call CrocodileSpells__CrocodileBonus_Refresh(s__CrocodileSpells__CrocodileF_Struct_c[this] , 'AIsx')
                endif
                call BlzSetUnitWeaponBooleanField(s__CrocodileSpells__CrocodileF_Struct_c[this], UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, s__CrocodileSpells__CrocodileF_Struct_attack1Enabled[this])
                call BlzSetUnitWeaponBooleanField(s__CrocodileSpells__CrocodileF_Struct_c[this], UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, s__CrocodileSpells__CrocodileF_Struct_attack2Enabled[this])
                call SetUnitRange(s__CrocodileSpells__CrocodileF_Struct_c[this] , s__CrocodileSpells__CrocodileF_Struct_savedRange[this])
            endif
            set a=null
        endfunction

        function s__CrocodileSpells__CrocodileF_Struct_CrocodileF_ReleaseCaster takes integer this returns nothing
            if s__CrocodileSpells__CrocodileF_Struct_castPauseHeld[this] then
                set s__CrocodileSpells__CrocodileF_Struct_castPauseHeld[this]=false
                call StopSpellUnit2(s__CrocodileSpells__CrocodileF_Struct_c[this])
            endif
            if s__CrocodileSpells__CrocodileF_Struct_ownsAttackBlock[this] then
                call UnitRemoveAbility(s__CrocodileSpells__CrocodileF_Struct_c[this], 'Abun')
                set s__CrocodileSpells__CrocodileF_Struct_ownsAttackBlock[this]=false
            endif
            set s__CrocodileSpells__CrocodileF_Struct_pendingTarget[this]=null
            set s__CrocodileSpells__CrocodileF_Struct_pendingStacks[this]=0
            set s__CrocodileSpells__CrocodileF_Struct_releaseDelay[this]=0.0
        endfunction

        function s__CrocodileSpells__CrocodileF_Struct_CrocodileF_Begin takes unit NewC,unit target returns boolean
            local integer this= LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(NewC), CrocodileSpells__CrocodileF_DataKey)
            if this == 0 or LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(NewC), CrocodileSpells__CrocodileCore_DataKey) == 0 or IsUnitIllusion(NewC) or not SpellBoolCaster(NewC) or IsUnitPaused(NewC) or not IsUnitEnemy(target, GetOwningPlayer(NewC)) or not SpellBool(target) or IsUnitType(target, UNIT_TYPE_STRUCTURE) then
                return false
            endif
            if s__CrocodileSpells__CrocodileF_Struct_ownsAttackBlock[this] or s__CrocodileSpells__CrocodileF_Struct_stacks[this] <= 0 or GetUnitAbilityLevel(s__CrocodileSpells__CrocodileF_Struct_c[this], CrocodileF_ID) == 0 or s__CrocodileSpells__CrocodileF_Struct_cooldown[this] > TimerGetElapsed(GearTimer03) or GetUnitAbilityLevel(s__CrocodileSpells__CrocodileF_Struct_c[this], 'Abun') > 0 or CrocodileF_ProjectileSpeed <= 0.0 or CrocodileF_ProjectileRange <= 0.0 then
                return false
            endif
            // Elapsed clock fraction prevents a proc just before a tick shortening the CD.
            set s__CrocodileSpells__CrocodileF_Struct_cooldown[this]=CrocodileF_InternalCD + TimerGetElapsed(GearTimer03)
            call BlzStartUnitAbilityCooldown(s__CrocodileSpells__CrocodileF_Struct_c[this], CrocodileF_ID, CrocodileF_InternalCD)
            set s__CrocodileSpells__CrocodileF_Struct_ownsAttackBlock[this]=true
            set s__CrocodileSpells__CrocodileF_Struct_pendingTarget[this]=target
            set s__CrocodileSpells__CrocodileF_Struct_pendingStacks[this]=1
            if s__CrocodileSpells__CrocodileF_Struct_stacks[this] >= 3 then
                set s__CrocodileSpells__CrocodileF_Struct_pendingStacks[this]=3
            endif
            set s__CrocodileSpells__CrocodileF_Struct_stacks[this]=s__CrocodileSpells__CrocodileF_Struct_stacks[this] - s__CrocodileSpells__CrocodileF_Struct_pendingStacks[this]
            call TasAbilityChargeBox_SetValue(s__CrocodileSpells__CrocodileF_Struct_c[this] , CrocodileF_ID , I2S(s__CrocodileSpells__CrocodileF_Struct_stacks[this]))
            call s__CrocodileSpells__CrocodileF_Struct_CrocodileF_SetEnhanced(this,false)
            call UnitAddAbility(s__CrocodileSpells__CrocodileF_Struct_c[this], 'Abun')
            set s__CrocodileSpells__CrocodileF_Struct_castPauseHeld[this]=s__CrocodileSpells__CrocodileF_Struct_pendingStacks[this] == 3
            if s__CrocodileSpells__CrocodileF_Struct_castPauseHeld[this] then
                call StartSpellUnit2(s__CrocodileSpells__CrocodileF_Struct_c[this])
            call MakeSound("war3mapImported\\Hero_Crocodile_F2")
            else
                call IssueImmediateOrder(s__CrocodileSpells__CrocodileF_Struct_c[this], "stop")
            endif
            call MakeSound("war3mapImported\\Hero_Crocodile_F3")
            call SetUnitAnimationByIndex(s__CrocodileSpells__CrocodileF_Struct_c[this], CrocodileF_Animation)
            call SetUnitTimeScale(s__CrocodileSpells__CrocodileF_Struct_c[this], CrocodileF_AnimationSpeed)
            set s__CrocodileSpells__CrocodileF_Struct_releaseDelay[this]=RMaxBJ(0.0, CrocodileF_ReleaseDelay) + TimerGetElapsed(GearTimer03)
            
            // Hold Abun through the windup; leave normal attacks during cooldown.
            return true
        endfunction

        function s__CrocodileSpells__CrocodileF_Struct_CrocodileF_Attack takes unit NewC,unit target,real amount returns real
            local integer this= LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(NewC), CrocodileSpells__CrocodileF_DataKey)
            // F starts at ATTACKED, before the native projectile or damage point.
            if this != 0 and s__CrocodileSpells__CrocodileF_Struct_ownsAttackBlock[this] and not s__CrocodileSpells__CrocodileF_Struct_applyingOwnAttack[this] then
                return 0.0
            endif
            return amount
        endfunction

        function s__CrocodileSpells__CrocodileF_Struct_Loop_CrocodileF takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__CrocodileSpells__CrocodileF_Struct_MUI
                set this=s__CrocodileSpells__CrocodileF_Struct_m[i]
                set s__CrocodileSpells__CrocodileF_Struct_cooldown[this]=RMaxBJ(0.0, s__CrocodileSpells__CrocodileF_Struct_cooldown[this] - CrocodileSpells__CrocodilePeriod)
                if s__CrocodileSpells__CrocodileF_Struct_ownsAttackBlock[this] then
                    set s__CrocodileSpells__CrocodileF_Struct_releaseDelay[this]=RMaxBJ(0.0, s__CrocodileSpells__CrocodileF_Struct_releaseDelay[this] - CrocodileSpells__CrocodilePeriod)
                    if SpellBoolCaster(s__CrocodileSpells__CrocodileF_Struct_c[this]) and not IsUnitIllusion(s__CrocodileSpells__CrocodileF_Struct_c[this]) and GetUnitAbilityLevel(s__CrocodileSpells__CrocodileF_Struct_c[this], CrocodileF_ID) > 0 and LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileF_Struct_c[this]), CrocodileSpells__CrocodileCore_DataKey) != 0 and GetUnitTypeId(s__CrocodileSpells__CrocodileF_Struct_pendingTarget[this]) != 0 and SpellBool(s__CrocodileSpells__CrocodileF_Struct_pendingTarget[this]) and IsUnitEnemy(s__CrocodileSpells__CrocodileF_Struct_pendingTarget[this], GetOwningPlayer(s__CrocodileSpells__CrocodileF_Struct_c[this])) then
                        if s__CrocodileSpells__CrocodileF_Struct_releaseDelay[this] <= 0.001 then
                            if s__CrocodileSpells__CrocodileF_Struct_pendingStacks[this] == 3 then
                                call s__CrocodileSpells__CrocodileF_Projectile_CrocodileF_Projectile_Start(s__CrocodileSpells__CrocodileF_Struct_c[this] , s__CrocodileSpells__CrocodileF_Struct_pendingTarget[this])
                            else
                                set s__CrocodileSpells__CrocodileF_Struct_applyingOwnAttack[this]=true
                                call s__CrocodileSpells__CrocodileF_Single_CrocodileF_Single_Start(s__CrocodileSpells__CrocodileF_Struct_c[this] , s__CrocodileSpells__CrocodileF_Struct_pendingTarget[this])
                                set s__CrocodileSpells__CrocodileF_Struct_applyingOwnAttack[this]=false
                            endif
                            if LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileF_Struct_c[this]), CrocodileSpells__CrocodileT_PhaseKey) == 0 then
                                call SetUnitTimeScale(s__CrocodileSpells__CrocodileF_Struct_c[this], 1.0)
                            endif
                            call s__CrocodileSpells__CrocodileF_Struct_CrocodileF_ReleaseCaster(this)
                        endif
                    else
                        if LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileF_Struct_c[this]), CrocodileSpells__CrocodileT_PhaseKey) == 0 then
                            call SetUnitTimeScale(s__CrocodileSpells__CrocodileF_Struct_c[this], 1.0)
                        endif
                        call s__CrocodileSpells__CrocodileF_Struct_CrocodileF_ReleaseCaster(this)
                    endif
                endif
                if not SpellBoolCaster(s__CrocodileSpells__CrocodileF_Struct_c[this]) or IsUnitIllusion(s__CrocodileSpells__CrocodileF_Struct_c[this]) or GetUnitAbilityLevel(s__CrocodileSpells__CrocodileF_Struct_c[this], CrocodileF_ID) == 0 or LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileF_Struct_c[this]), CrocodileSpells__CrocodileCore_DataKey) == 0 then
                    if s__CrocodileSpells__CrocodileF_Struct_stacks[this] != 0 then
                        set s__CrocodileSpells__CrocodileF_Struct_stacks[this]=0
                        call TasAbilityChargeBox_SetValue(s__CrocodileSpells__CrocodileF_Struct_c[this] , CrocodileF_ID , "0")
                    endif
                    call s__CrocodileSpells__CrocodileF_Struct_CrocodileF_SetEnhanced(this,false)
                else
                    call s__CrocodileSpells__CrocodileF_Struct_CrocodileF_SetEnhanced(this,s__CrocodileSpells__CrocodileF_Struct_stacks[this] > 0 and s__CrocodileSpells__CrocodileF_Struct_cooldown[this] <= 0.0 and not s__CrocodileSpells__CrocodileF_Struct_ownsAttackBlock[this])
                endif
                if LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileF_Struct_c[this]), CrocodileSpells__CrocodileCore_DataKey) == 0 then
                    call RemoveSavedInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileF_Struct_c[this]), CrocodileSpells__CrocodileF_DataKey)
                    call TasAbilityChargeBox_ClearValue(s__CrocodileSpells__CrocodileF_Struct_c[this] , CrocodileF_ID)
                    set s__CrocodileSpells__CrocodileF_Struct_c[this]=null
                    set s__CrocodileSpells__CrocodileF_Struct_m[i]=s__CrocodileSpells__CrocodileF_Struct_m[s__CrocodileSpells__CrocodileF_Struct_MUI]
                    set s__CrocodileSpells__CrocodileF_Struct_MUI=s__CrocodileSpells__CrocodileF_Struct_MUI - 1
                    call s__CrocodileSpells__CrocodileF_Struct_deallocate(this)
                    if s__CrocodileSpells__CrocodileF_Struct_MUI == - 1 then
                        call GearTimer03Release()
                    endif
                else
                    set i=i + 1
                endif
            endloop
        endfunction

        function s__CrocodileSpells__CrocodileF_Struct_CrocodileF_Register takes unit NewC returns nothing
            local integer this= s__CrocodileSpells__CrocodileF_Struct__allocate()
            set s__CrocodileSpells__CrocodileF_Struct_MUI=s__CrocodileSpells__CrocodileF_Struct_MUI + 1
            set s__CrocodileSpells__CrocodileF_Struct_m[s__CrocodileSpells__CrocodileF_Struct_MUI]=this
            if s__CrocodileSpells__CrocodileF_Struct_MUI == 0 then
                call GearTimer03Acquire()
            endif
            set s__CrocodileSpells__CrocodileF_Struct_c[this]=NewC
            set s__CrocodileSpells__CrocodileF_Struct_stacks[this]=0
            set s__CrocodileSpells__CrocodileF_Struct_enhanced[this]=false
            set s__CrocodileSpells__CrocodileF_Struct_ownsAS[this]=false
            set s__CrocodileSpells__CrocodileF_Struct_cooldown[this]=0.0
            set s__CrocodileSpells__CrocodileF_Struct_ownsAttackBlock[this]=false
            set s__CrocodileSpells__CrocodileF_Struct_applyingOwnAttack[this]=false
            set s__CrocodileSpells__CrocodileF_Struct_castPauseHeld[this]=false
            set s__CrocodileSpells__CrocodileF_Struct_pendingTarget[this]=null
            set s__CrocodileSpells__CrocodileF_Struct_pendingStacks[this]=0
            set s__CrocodileSpells__CrocodileF_Struct_releaseDelay[this]=0.0
            call SaveInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileF_Struct_c[this]), CrocodileSpells__CrocodileF_DataKey, this)
            call TasAbilityChargeBox_SetValue(s__CrocodileSpells__CrocodileF_Struct_c[this] , CrocodileF_ID , "0")
        endfunction



//================================ Crocodile G - Suna Suna no Mi ========================================
    function Crocodile_IsOnSand takes unit c returns boolean
        return s__CrocodileSpells__CrocodileT_Struct_CrocodileT_IsOnSand(c)
    endfunction

    function CrocodileT_IsChanneling takes unit c returns boolean
        local integer ground= LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(c), CrocodileSpells__CrocodileT_DataKey)
        // The T2 cast (until detonation) keeps the same resistance as the T channel.
        return ground != 0 and ( s__CrocodileSpells__CrocodileT_Struct_channelActive[ground] or s__CrocodileSpells__CrocodileT_Struct_t2Pending[ground] ) and not s__CrocodileSpells__CrocodileT_Struct_endNow[ground] and SpellBoolCaster(c) and not IsUnitIllusion(c)
    endfunction


        function s__CrocodileSpells__CrocodileG_Struct_CrocodileG_SandSpeed takes integer this,boolean enabled returns nothing
            set s__CrocodileSpells__CrocodileG_Struct_onSand[this]=enabled
            if enabled and CrocodileG_SandMS_Ability_ID != 0 and CrocodileG_SandMS_Buff_ID != 0 then
                call BuffUnit01(s__CrocodileSpells__CrocodileG_Struct_c[this] , s__CrocodileSpells__CrocodileG_Struct_c[this] , CrocodileG_SandMS_Ability_ID , "bloodlust" , 1)
            elseif CrocodileG_SandMS_Buff_ID != 0 then
                call UnitRemoveAbility(s__CrocodileSpells__CrocodileG_Struct_c[this], CrocodileG_SandMS_Buff_ID)
            endif
        endfunction

        function s__CrocodileSpells__CrocodileG_Struct_Loop_CrocodileG takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__CrocodileSpells__CrocodileG_Struct_MUI
                set this=s__CrocodileSpells__CrocodileG_Struct_m[i]
                set s__CrocodileSpells__CrocodileG_Struct_sandBuffPulse[this]=s__CrocodileSpells__CrocodileG_Struct_sandBuffPulse[this] + CrocodileSpells__CrocodilePeriod
                if s__CrocodileSpells__CrocodileG_Struct_sandBuffPulse[this] + 0.001 >= CrocodileG_SandMS_RefreshPeriod then
                    set s__CrocodileSpells__CrocodileG_Struct_sandBuffPulse[this]=s__CrocodileSpells__CrocodileG_Struct_sandBuffPulse[this] - RMaxBJ(CrocodileSpells__CrocodilePeriod, CrocodileG_SandMS_RefreshPeriod)
                    call s__CrocodileSpells__CrocodileG_Struct_CrocodileG_SandSpeed(this,LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileG_Struct_c[this]), CrocodileSpells__CrocodileCore_DataKey) != 0 and SpellBoolCaster(s__CrocodileSpells__CrocodileG_Struct_c[this]) and not IsUnitIllusion(s__CrocodileSpells__CrocodileG_Struct_c[this]) and GetUnitAbilityLevel(s__CrocodileSpells__CrocodileG_Struct_c[this], CrocodileG_ID) > 0 and (s__CrocodileSpells__CrocodileT_Struct_CrocodileT_IsOnSand((s__CrocodileSpells__CrocodileG_Struct_c[this])))) // INLINED!!
                endif
                if not SpellBoolCaster(s__CrocodileSpells__CrocodileG_Struct_c[this]) or IsUnitIllusion(s__CrocodileSpells__CrocodileG_Struct_c[this]) or GetUnitAbilityLevel(s__CrocodileSpells__CrocodileG_Struct_c[this], CrocodileG_ID) == 0 then
                    call UnitRemoveAbility(s__CrocodileSpells__CrocodileG_Struct_c[this], CrocodileG_SandMS_Buff_ID)
                endif
                if LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileG_Struct_c[this]), CrocodileSpells__CrocodileCore_DataKey) == 0 then
                    call UnitRemoveAbility(s__CrocodileSpells__CrocodileG_Struct_c[this], CrocodileG_SandMS_Buff_ID)
                    call RemoveSavedInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileG_Struct_c[this]), CrocodileSpells__CrocodileG_DataKey)
                    set s__CrocodileSpells__CrocodileG_Struct_c[this]=null
                    set s__CrocodileSpells__CrocodileG_Struct_m[i]=s__CrocodileSpells__CrocodileG_Struct_m[s__CrocodileSpells__CrocodileG_Struct_MUI]
                    set s__CrocodileSpells__CrocodileG_Struct_MUI=s__CrocodileSpells__CrocodileG_Struct_MUI - 1
                    call s__CrocodileSpells__CrocodileG_Struct_deallocate(this)
                    if s__CrocodileSpells__CrocodileG_Struct_MUI == - 1 then
                        call GearTimer03Release()
                    endif
                else
                    set i=i + 1
                endif
            endloop
        endfunction

        function s__CrocodileSpells__CrocodileG_Struct_CrocodileG_Register takes unit NewC returns nothing
            local integer this= s__CrocodileSpells__CrocodileG_Struct__allocate()
            set s__CrocodileSpells__CrocodileG_Struct_MUI=s__CrocodileSpells__CrocodileG_Struct_MUI + 1
            set s__CrocodileSpells__CrocodileG_Struct_m[s__CrocodileSpells__CrocodileG_Struct_MUI]=this
            if s__CrocodileSpells__CrocodileG_Struct_MUI == 0 then
                call GearTimer03Acquire()
            endif
            set s__CrocodileSpells__CrocodileG_Struct_c[this]=NewC
            set s__CrocodileSpells__CrocodileG_Struct_onSand[this]=false
            set s__CrocodileSpells__CrocodileG_Struct_sandBuffPulse[this]=0.0
            call SaveInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileG_Struct_c[this]), CrocodileSpells__CrocodileG_DataKey, this)
        endfunction



//================================ Crocodile Registration / shared events ========================================


        function s__CrocodileSpells__CrocodileCore_Struct_Loop_Crocodile takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__CrocodileSpells__CrocodileCore_Struct_MUI
                set this=s__CrocodileSpells__CrocodileCore_Struct_m[i]
                if GetUnitTypeId(s__CrocodileSpells__CrocodileCore_Struct_c[this]) != s__CrocodileSpells__CrocodileCore_Struct_savedType[this] or IsUnitIllusion(s__CrocodileSpells__CrocodileCore_Struct_c[this]) then
                    call sc__CrocodileSpells__CrocodileCore_Struct_CrocodileCore_Death(s__CrocodileSpells__CrocodileCore_Struct_c[this])
                    call RemoveSavedInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileCore_Struct_c[this]), CrocodileSpells__CrocodileCore_DataKey)
                    set s__CrocodileSpells__CrocodileCore_Struct_c[this]=null
                    set s__CrocodileSpells__CrocodileCore_Struct_m[i]=s__CrocodileSpells__CrocodileCore_Struct_m[s__CrocodileSpells__CrocodileCore_Struct_MUI]
                    set s__CrocodileSpells__CrocodileCore_Struct_MUI=s__CrocodileSpells__CrocodileCore_Struct_MUI - 1
                    call s__CrocodileSpells__CrocodileCore_Struct_deallocate(this)
                    if s__CrocodileSpells__CrocodileCore_Struct_MUI == - 1 then
                        call GearTimer03Release()
                    endif
                else
                    set i=i + 1
                endif
            endloop
            call s__CrocodileSpells__CrocodileQ_Struct_Loop_CrocodileQ()
            call s__CrocodileSpells__CrocodileQ_ExplosionDecor_Loop_CrocodileQExplosionDecor()
            call s__CrocodileSpells__CrocodileW_Struct_Loop_CrocodileW()
            call s__CrocodileSpells__CrocodileE_Struct_Loop_CrocodileE()
            call s__CrocodileSpells__CrocodileR_Struct_Loop_CrocodileR()
            call s__CrocodileSpells__CrocodileT_Struct_Loop_CrocodileT()
            call s__CrocodileSpells__CrocodileT2_Struct_Loop_CrocodileT2()
            call s__CrocodileSpells__CrocodileSand_Struct_Loop_CrocodileSand()
            call s__CrocodileSpells__CrocodileSand_Debuff_Loop_CrocodileSandDebuff()
            call s__CrocodileSpells__CrocodileF_Struct_Loop_CrocodileF()
            call s__CrocodileSpells__CrocodileF_Projectile_Loop_CrocodileF_Projectile()
            call s__CrocodileSpells__CrocodileG_Struct_Loop_CrocodileG()
        endfunction

        function s__CrocodileSpells__CrocodileCore_Struct_Register_Crocodile takes unit NewC returns nothing
            local integer this
            if NewC == null or GetUnitTypeId(NewC) != Crocodile_ID or not IsUnitType(NewC, UNIT_TYPE_HERO) or IsUnitIllusion(NewC) or LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(NewC), CrocodileSpells__CrocodileCore_DataKey) != 0 then
                return
            endif
            set this=s__CrocodileSpells__CrocodileCore_Struct__allocate()
            set s__CrocodileSpells__CrocodileCore_Struct_MUI=s__CrocodileSpells__CrocodileCore_Struct_MUI + 1
            set s__CrocodileSpells__CrocodileCore_Struct_m[s__CrocodileSpells__CrocodileCore_Struct_MUI]=this
            if s__CrocodileSpells__CrocodileCore_Struct_MUI == 0 then
                call GearTimer03Acquire()
            endif
            set s__CrocodileSpells__CrocodileCore_Struct_c[this]=NewC
            set s__CrocodileSpells__CrocodileCore_Struct_savedType[this]=GetUnitTypeId(s__CrocodileSpells__CrocodileCore_Struct_c[this])
            call SaveInteger(CrocodileSpells__CrocodileTable, GetHandleId(s__CrocodileSpells__CrocodileCore_Struct_c[this]), CrocodileSpells__CrocodileCore_DataKey, this)
            call UnitRemoveAbility(s__CrocodileSpells__CrocodileCore_Struct_c[this], CrocodileT2_ID)
            call s__CrocodileSpells__CrocodileE_Struct_CrocodileE_Register(s__CrocodileSpells__CrocodileCore_Struct_c[this])
            call s__CrocodileSpells__CrocodileF_Struct_CrocodileF_Register(s__CrocodileSpells__CrocodileCore_Struct_c[this])
            call s__CrocodileSpells__CrocodileG_Struct_CrocodileG_Register(s__CrocodileSpells__CrocodileCore_Struct_c[this])
        endfunction

        function s__CrocodileSpells__CrocodileCore_Struct_CrocodileCore_Death takes unit c returns nothing
            local integer dash= LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(c), CrocodileSpells__CrocodileE_DataKey)
            local integer attack= LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(c), CrocodileSpells__CrocodileF_DataKey)
            local integer passive= LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(c), CrocodileSpells__CrocodileG_DataKey)
            call s__CrocodileSpells__CrocodileR_Struct_CrocodileR_Death(c)
            if LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(c), CrocodileSpells__CrocodileCore_DataKey) != 0 then
                call s__CrocodileSpells__CrocodileT_Struct_CrocodileT_Finish(c)
                if dash != 0 then
                    set s__CrocodileSpells__CrocodileE_Struct_cancelDash[dash]=true

                endif
                if attack != 0 then
                    set s__CrocodileSpells__CrocodileF_Struct_stacks[attack]=0
                    set s__CrocodileSpells__CrocodileF_Struct_cooldown[attack]=0.0
                    call BlzEndUnitAbilityCooldown(c, CrocodileF_ID)
                    call s__CrocodileSpells__CrocodileF_Struct_CrocodileF_ReleaseCaster(attack)
                    call TasAbilityChargeBox_SetValue(c , CrocodileF_ID , "0")
                    call s__CrocodileSpells__CrocodileF_Struct_CrocodileF_SetEnhanced(attack,false)
                endif
                if passive != 0 then
                    call s__CrocodileSpells__CrocodileG_Struct_CrocodileG_SandSpeed(passive,false)
                    call UnitRemoveAbility(c, CrocodileG_SandMS_Buff_ID)
                endif
            endif
            set c=null
        endfunction

        function s__CrocodileSpells__CrocodileCore_Struct_Crocodile_Summon takes nothing returns nothing
            local unit source= GetSummoningUnit()
            local unit clone= GetSummonedUnit()
            local integer attack= LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(source), CrocodileSpells__CrocodileF_DataKey)
            local integer passive= LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(source), CrocodileSpells__CrocodileG_DataKey)
            local ability a
            if LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(source), CrocodileSpells__CrocodileCore_DataKey) != 0 and IsUnitIllusion(clone) then
                if attack != 0 and s__CrocodileSpells__CrocodileF_Struct_enhanced[attack] then
                    call BlzSetUnitWeaponBooleanField(clone, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, s__CrocodileSpells__CrocodileF_Struct_attack1Enabled[attack])
                    call BlzSetUnitWeaponBooleanField(clone, UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, s__CrocodileSpells__CrocodileF_Struct_attack2Enabled[attack])
                    if GetUnitAbilityLevel(clone, 'AIsx') > 0 then
                        if s__CrocodileSpells__CrocodileF_Struct_ownsAS[attack] then
                            call UnitRemoveAbility(clone, 'AIsx')
                        else
                            set a=BlzGetUnitAbility(clone, 'AIsx')
                            call BlzSetAbilityRealLevelField(a, ABILITY_RLF_ATTACK_SPEED_INCREASE_ISX1, 0, s__CrocodileSpells__CrocodileF_Struct_savedAS[attack])
                            call CrocodileSpells__CrocodileBonus_Refresh(clone , 'AIsx')
                        endif
                    endif
                endif
                call UnitRemoveAbility(clone, CrocodileG_SandMS_Buff_ID)
                call UnitRemoveAbility(clone, CrocodileT2_ID)
            endif
            set a=null
            set source=null
            set clone=null
        endfunction

        function s__CrocodileSpells__CrocodileCore_Struct_CrocodileCore_Damage takes unit c,unit td,real amount,integer kind,integer phase returns real
            // Compatibility wrapper. MAIN DmgSys exclusively owns G damage and mana depletion.
            return amount
        endfunction



    // MAIN LvlUpCheck registers real heroes once after granting permanent F/G.
    function Crocodile_Register takes unit c returns nothing
        call s__CrocodileSpells__CrocodileCore_Struct_Register_Crocodile(c)
    endfunction

    function Crocodile_IsRegistered takes unit c returns boolean
        return LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(c), CrocodileSpells__CrocodileCore_DataKey) != 0 and not IsUnitIllusion(c)
    endfunction


    function CrocodileSpells__Crocodile_Listener03 takes nothing returns boolean
        call s__CrocodileSpells__CrocodileCore_Struct_Loop_Crocodile()
        return false
    endfunction

    function Crocodile_InitializeHero takes unit c returns nothing
        if c == null or GetUnitTypeId(c) != Crocodile_ID or not IsUnitType(c, UNIT_TYPE_HERO) or IsUnitIllusion(c) then
            return
        endif
        if not CrocodileSpells__Crocodile_ListenerOn then
            set CrocodileSpells__Crocodile_ListenerOn=true
            call TriggerAddCondition(GearTimer03Listeners, Condition(function CrocodileSpells__Crocodile_Listener03))
        endif
        if GetUnitAbilityLevel(c, CrocodileF_ID) == 0 then
            call UnitAddAbility(c, CrocodileF_ID)
        endif
        call UnitMakeAbilityPermanent(c, true, CrocodileF_ID)
        if GetUnitAbilityLevel(c, CrocodileG_ID) == 0 then
            call UnitAddAbility(c, CrocodileG_ID)
        endif
        call UnitMakeAbilityPermanent(c, true, CrocodileG_ID)
        if not Crocodile_IsRegistered(c) then
            call s__CrocodileSpells__CrocodileCore_Struct_Register_Crocodile((c)) // INLINED!!
        endif
    endfunction

    function CrocodileQ_Start takes unit c,real x,real y returns boolean
        return s__CrocodileSpells__CrocodileQ_Struct_CrocodileQ_Begin(c , x , y)
    endfunction

    function CrocodileW_Start takes unit c,real x,real y returns boolean
        return s__CrocodileSpells__CrocodileW_Struct_CrocodileW_Begin(c , x , y)
    endfunction

    function CrocodileE_Start takes unit c,real x,real y returns boolean
        return s__CrocodileSpells__CrocodileE_Struct_CrocodileE_Begin(c , x , y)
    endfunction

    function CrocodileR_Start takes unit c,real x,real y returns boolean
        return s__CrocodileSpells__CrocodileR_Struct_CrocodileR_Begin(c , x , y)
    endfunction

    function CrocodileT_Start takes unit c returns boolean
        return s__CrocodileSpells__CrocodileT_Struct_CrocodileT_Begin(c)
    endfunction

    function CrocodileT2_Start takes unit c returns boolean
        return s__CrocodileSpells__CrocodileT2_Struct_CrocodileT2_Begin(c)
    endfunction

    function CrocodileF_AddStack takes unit c returns nothing
        local integer attack= LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(c), CrocodileSpells__CrocodileF_DataKey)
        if Crocodile_IsRegistered(c) and SpellBoolCaster(c) and attack != 0 and GetUnitAbilityLevel(c, CrocodileF_ID) > 0 and GetHeroLevel(c) >= CrocodileF_MinHeroLevel then
            set s__CrocodileSpells__CrocodileF_Struct_stacks[attack]=IMinBJ(CrocodileF_MaxStacks, s__CrocodileSpells__CrocodileF_Struct_stacks[attack] + 1)
            call TasAbilityChargeBox_SetValue(c , CrocodileF_ID , I2S(s__CrocodileSpells__CrocodileF_Struct_stacks[attack]))
            call s__CrocodileSpells__CrocodileF_Struct_CrocodileF_SetEnhanced(attack,s__CrocodileSpells__CrocodileF_Struct_cooldown[attack] <= TimerGetElapsed(GearTimer03) and not s__CrocodileSpells__CrocodileF_Struct_ownsAttackBlock[attack])
        endif
    endfunction

    function Crocodile_Attack takes unit c,unit td,real dmg returns real
        return s__CrocodileSpells__CrocodileF_Struct_CrocodileF_Attack(c , td , dmg)
    endfunction

    function Crocodile_Damage takes unit c,unit td,real amount,integer kind,integer phase returns real
        return s__CrocodileSpells__CrocodileCore_Struct_CrocodileCore_Damage(c , td , amount , kind , phase)
    endfunction

    function Crocodile_Death takes unit c returns nothing
        call s__CrocodileSpells__CrocodileCore_Struct_CrocodileCore_Death(c)
    endfunction

    function CrocodileSpells__CrocodileF_OnAttack takes nothing returns nothing
        call s__CrocodileSpells__CrocodileF_Struct_CrocodileF_Begin(GetAttacker() , GetTriggerUnit())
    endfunction

    function CrocodileSpells__CrocodileT_OnFinish takes nothing returns nothing
        local integer ground= LoadInteger(CrocodileSpells__CrocodileTable, GetHandleId(GetTriggerUnit()), CrocodileSpells__CrocodileT_DataKey)
        if GetSpellAbilityId() == CrocodileT_ID and ground != 0 and s__CrocodileSpells__CrocodileT_Struct_channelActive[ground] and not s__CrocodileSpells__CrocodileT_Struct_endNow[ground] then
            set s__CrocodileSpells__CrocodileT_Struct_channelFinished[ground]=true
        endif
    endfunction

    function CrocodileSpells__InitCrocodileSpells takes nothing returns nothing
        local trigger summon= CreateTrigger()
        local trigger attackStart= CreateTrigger()
        local trigger finish= CreateTrigger()
        set CrocodileSpells__CrocodileW_QContact=CreateTrigger()
        call TriggerAddCondition(CrocodileSpells__CrocodileW_QContact, Condition(function CrocodileSpells__CrocodileW_ReceiveQ))
        call TriggerRegisterAnyUnitEventBJ(summon, EVENT_PLAYER_UNIT_SUMMON)
        call TriggerAddAction(summon, function s__CrocodileSpells__CrocodileCore_Struct_Crocodile_Summon)
        call TriggerRegisterAnyUnitEventBJ(attackStart, EVENT_PLAYER_UNIT_ATTACKED)
        call TriggerAddAction(attackStart, function CrocodileSpells__CrocodileF_OnAttack)
        call TriggerRegisterAnyUnitEventBJ(finish, EVENT_PLAYER_UNIT_SPELL_FINISH)
        call TriggerRegisterAnyUnitEventBJ(finish, EVENT_PLAYER_UNIT_SPELL_ENDCAST)
        call TriggerAddAction(finish, function CrocodileSpells__CrocodileT_OnFinish)
        set summon=null
        set attackStart=null
        set finish=null
    endfunction

