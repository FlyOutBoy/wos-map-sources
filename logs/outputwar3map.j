    //===========================================================================
    // Централизованный менеджер таймера
    //===========================================================================
    function AkainuSpells__AkainuTimer03Acquire takes nothing returns nothing
        set AkainuSpells__AkainuTimer03Users=AkainuSpells__AkainuTimer03Users + 1
        if AkainuSpells__AkainuTimer03Users == 1 then
            call TimerStart(AkainuSpells__AkainuTimer03, 0.03, true, AkainuSpells__AkainuTimer03Callback)
        endif
    endfunction

    function AkainuSpells__AkainuTimer03Release takes nothing returns nothing
        set AkainuSpells__AkainuTimer03Users=AkainuSpells__AkainuTimer03Users - 1
        if AkainuSpells__AkainuTimer03Users <= 0 then
            set AkainuSpells__AkainuTimer03Users=0
            call PauseTimer(AkainuSpells__AkainuTimer03)
        endif
    endfunction

    //===========================================================================
    // Прок пассивной способности F (Lv. 35)
    //===========================================================================
    // An attached model can keep rendering its death animation on a paused corpse.
    // Hide the magma hand before destroying its handle, on every exit path.
    function AkainuSpells__Akainu_ClearHandEffect takes effect hand returns nothing
        if hand != null then
            call BlzSetSpecialEffectAlpha(hand, 0)
            call BlzSetSpecialEffectScale(hand, 0.00)
            call BlzSetSpecialEffectTimeScale(hand, 1.00)
            call DestroyEffect(hand)
        endif
    endfunction

    function AkainuF_Start takes unit c,unit td returns nothing
        if BlzGetUnitAbilityCooldownRemaining(c, AkainuF_ID) == 0 then
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_GZ_jntxn (11)_R1-200.mdl" , GetUnitX(td) , GetUnitY(td) , 1 , 1 , 2 , 1))
            set GearDamageNextSource=('A070') // INLINED!!
            call s__GearSystems2___KS_DelayedDamage_NextDmg_Start((c ) , ( td ) , (( AkainuF_Damage * GetHeroAgi(c, true) )*1.0) , ( 1 ) , (( 0.03)*1.0)) // INLINED!!
            call PassiveCD_Start(c , AkainuF_ID , AkainuF_CD)
        endif
    endfunction

