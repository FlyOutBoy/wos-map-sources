    function BazzBSpells__BazzBTimer03Acquire takes nothing returns nothing
        set BazzBSpells__BazzBTimer03Users=BazzBSpells__BazzBTimer03Users + 1
        if BazzBSpells__BazzBTimer03Users == 1 then
