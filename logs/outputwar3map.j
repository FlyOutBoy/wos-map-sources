                            call DestroyEffect(EffectSpawn("war3mapimported\\wos_cf2.mdl" , GetUnitX(s__AinzSpells__AinzW_KS_d[this]) + 1 * Cos(s__AinzSpells__AinzW_KS_a[this]) , GetUnitY(s__AinzSpells__AinzW_KS_d[this]) + 1 * Sin(s__AinzSpells__AinzW_KS_a[this]) , GetRandomReal(0, 359) , 1 , 1.25 , 0))
                            call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_BY_Wood_Eff_Ord_DanGe_Wid_ChongFengQiLiu.mdl" , GetUnitX(s__AinzSpells__AinzW_KS_d[this]) + 350 * Cos(s__AinzSpells__AinzW_KS_a[this]) , GetUnitY(s__AinzSpells__AinzW_KS_d[this]) + 350 * Sin(s__AinzSpells__AinzW_KS_a[this]) , s__AinzSpells__AinzW_KS_a[this] * bj_RADTODEG , 1.5 , 1.95 , 0 , 255 , 255 , 255 , 125))
                        endif
                        if s__AinzSpells__AinzW_KS_r3[this] >= 0.12 then
                            set s__AinzSpells__AinzW_KS_r3[this]=0
                            call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_tx-ha_nitu.mdl" , GetUnitX(s__AinzSpells__AinzW_KS_d[this]) + 1 * Cos(s__AinzSpells__AinzW_KS_a[this]) , GetUnitY(s__AinzSpells__AinzW_KS_d[this]) + 1 * Sin(s__AinzSpells__AinzW_KS_a[this]) , s__AinzSpells__AinzW_KS_a[this] * bj_RADTODEG , 3 , 2.25 , 1 , 255 , 255 , 255 , 125))
                            call DestroyEffect(EffectSpawn("war3mapimported\\wos_1baozha_90.mdl" , GetUnitX(s__AinzSpells__AinzW_KS_d[this]) + 1 * Cos(s__AinzSpells__AinzW_KS_a[this]) , GetUnitY(s__AinzSpells__AinzW_KS_d[this]) + 1 * Sin(s__AinzSpells__AinzW_KS_a[this]) , GetRandomReal(0, 359) , 1 , 1.25 , 0))
                        endif
                        set s__AinzSpells__AinzW_KS_distance[this]=s__AinzSpells__AinzW_KS_distance[this] + AinzW_KnightSpeed
                        call GroupClear(s__AinzSpells__AinzW_KS_g[this])
