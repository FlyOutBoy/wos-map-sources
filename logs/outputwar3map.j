        function s__BarraganSpells__HeroSpells_T_BarraganT2_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__BarraganSpells__HeroSpells_T__allocate()
            set s__BarraganSpells__HeroSpells_T_MUI_BarraganT2=s__BarraganSpells__HeroSpells_T_MUI_BarraganT2 + 1
            set s__BarraganSpells__HeroSpells_T_m_BarraganT2[s__BarraganSpells__HeroSpells_T_MUI_BarraganT2]=this
            set s__BarraganSpells__HeroSpells_T_c[this]=NewC
            set s__BarraganSpells__HeroSpells_T_x[this]=NewX
            set s__BarraganSpells__HeroSpells_T_y[this]=NewY
            set s__BarraganSpells__HeroSpells_T_r[this]=0
            set s__BarraganSpells__HeroSpells_T_r2[this]=0
            set s__BarraganSpells__HeroSpells_T_scale[this]=1.2
            call StartSpellUnit(s__BarraganSpells__HeroSpells_T_c[this])
            set s__BarraganSpells__HeroSpells_T_g[this]=CreateGroup()
            set s__BarraganSpells__HeroSpells_T_g2[this]=CreateGroup()
            set s__BarraganSpells__HeroSpells_T_u[this]=null
            set s__BarraganSpells__HeroSpells_T_a[this]=GAngle2(s__BarraganSpells__HeroSpells_T_c[this] , s__BarraganSpells__HeroSpells_T_x[this] , s__BarraganSpells__HeroSpells_T_y[this]) // Angle Between points
            set s__BarraganSpells__HeroSpells_T_check[this]=0
            set s__BarraganSpells__HeroSpells_T_r7[this]=0
            set s__BarraganSpells__HeroSpells_T_k2[this]=0
            set s__BarraganSpells__HeroSpells_T_aoe[this]=BarraganT2_DamageAoe
            set s__BarraganSpells__HeroSpells_T_dmg[this]=GetHeroInt(s__BarraganSpells__HeroSpells_T_c[this], true) * BarraganT2_DamageIntBase
            set s__BarraganSpells__HeroSpells_T_move[this]=100
            set s__BarraganSpells__HeroSpells_T_e2[this]=AddSpecialEffectTarget("war3mapimported\\wos_m3 (704).mdx", s__BarraganSpells__HeroSpells_T_c[this], "weapon")
            set s__BarraganSpells__HeroSpells_T_k2[this]=1
            set s__BarraganSpells__HeroSpells_T_r5[this]=0.81 // delay before axe throw
            set s__BarraganSpells__HeroSpells_T_rmax[this]=2.01 + s__BarraganSpells__HeroSpells_T_r5[this] // max distance formula rmax / 0.03 * move, current 4000
            call SetUnitTimeScale(s__BarraganSpells__HeroSpells_T_c[this], 0.3645)
            call SetUnitAnimationByIndex(s__BarraganSpells__HeroSpells_T_c[this], 10)
            call MakeSound("war3mapimported\\Hero_Barragan_ET2 1")
            if s__BarraganSpells__HeroSpells_T_MUI_BarraganT2 == 0 then
                call BarraganSpells__BarraganTick_On(4)
            endif
        endfunction


   
