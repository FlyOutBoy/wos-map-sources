// BEGIN IMPORT OF C:\Users\Gear\Desktop\WOS\VS WOS\_build\test-sources\Systems\CastAItems.j
function ItemSwapApply takes nothing returns nothing
local unit c
local integer slot
loop
    exitwhen ItemSwapCount == 0
    set ItemSwapCount=ItemSwapCount - 1
    set c=ItemSwapUnit[ItemSwapCount]
    set ItemSwapUnit[ItemSwapCount]=null
    if c != null and GetUnitTypeId(c) != 0 then
        set slot=IsItemInInventory3(c , ItemSwapFrom[ItemSwapCount])
        if slot >= 0 then
            call RemoveItem(UnitItemInSlot(c, slot))
            call UnitAddItemToSlotById(c, ItemSwapTo[ItemSwapCount], slot)
        endif
    endif
endloop
set c=null
endfunction
function ItemSwapLater takes unit c,integer fromId,integer toId returns nothing
local integer i= 0
loop
    exitwhen i >= ItemSwapCount
    if ItemSwapUnit[i] == c and ItemSwapFrom[i] == fromId then
        return
    endif
    set i=i + 1
endloop
set ItemSwapUnit[ItemSwapCount]=c
set ItemSwapFrom[ItemSwapCount]=fromId
set ItemSwapTo[ItemSwapCount]=toId
set ItemSwapCount=ItemSwapCount + 1
if ItemSwapCount == 1 then
    if ItemSwapClock == null then
        set ItemSwapClock=CreateTimer()
    endif
    call TimerStart(ItemSwapClock, 0.0, false, function ItemSwapApply)
endif
endfunction
function FixCloneModel takes nothing returns nothing
local timer t= GetExpiredTimer()
local integer h= GetHandleId(t)
local unit c= LoadUnitHandle(hs, h, 0)
call FixModel(c)
call PauseTimer(t)
call FlushChildHashtable(hs, h)
set c=null
set t=null
endfunction
function BuffUnitOnce takes unit c,unit u,integer id,integer level,string order returns nothing
            local integer i= GetPlayerId(GetOwningPlayer(c))
            if castitem1[i] == null or GetWidgetLife(castitem1[i]) < 1 then
                set castitem1[i]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'h0C9', GetRectCenterX(gg_rct_Caster), GetRectCenterY(gg_rct_Caster), 0)
                call UnitAddAbility(castitem1[i], id)
            endif
            if level > 0 then
                call SetUnitAbilityLevel(castitem1[i], 'A06F', level)
                call SetUnitFacing(castitem1[i], GAngle(castitem1[i] , u) * bj_RADTODEG)
                call IssueTargetOrder(castitem1[i], order, u)
            endif
        endfunction
// Short shared vision for every real item cast, before item-specific dispatch.
// Reveals terrain to the caster's side without detecting invisible units.
function ItemActiveVision takes unit c,unit td,real x,real y,ability ab returns nothing
    local real radius= RMaxBJ(750.0, 1.5 * BlzGetAbilityRealLevelField(ab, ABILITY_RLF_AREA_OF_EFFECT, IMaxBJ(0, GetUnitAbilityLevel(c, GetSpellAbilityId()) - 1)))
    // The instant foundation has zero native area; the ally heal still has one.
    if GetSpellAbilityId() == 'A10D' then
        set radius=RMaxBJ(radius, HashiramaCells_AllyAoe * 1.5)
    endif
    if td != null then
        set x=GetUnitX(td)
        set y=GetUnitY(td)
    elseif x == 0.0 and y == 0.0 and BlzGetAbilityIntegerLevelField(ab, ABILITY_ILF_TARGET_TYPE, 0) < 2 then
        set x=GetUnitX(c)
        set y=GetUnitY(c)
    endif
    call VisionTimed(GetOwningPlayer(c) , x , y , radius , 2.0)
endfunction
function ItemsCast takes unit c,unit td,real x,real y,integer id returns nothing
