function Rimuru3R_Start takes unit c,real x,real y returns nothing
    call s__RimuruSpells___Rimuru3R_KS_Rimuru3R_Start(c , x , y)
endfunction
function Rimuru3T_Start takes unit c,real x,real y returns nothing
    call s__RimuruSpells___Rimuru3T_KS_Rimuru3T_Start(c , x , y)
    call GetMainStatValue(c , false)
endfunction
function Rimuru3F_Start takes unit c returns nothing
    call SaveInteger(hs, GetHandleId(c), RimuruSpells___SH_DODGE_Q, 0)
    call RimuruSpells___RimuruTrackDodges(c , RimuruF3_ID , RimuruF3_Buff_ID)
    call BuffUnit1(c , c , 10)
    if GetRandomInt(1, 2) == 1 then
        call MakeSound("war3mapimported\\Hero_Rimuru3_F")
    else
        call MakeSound("war3mapimported\\Hero_Rimuru3_F2")
    endif
    call s__GearSystems2___KS_FlushBuff_Start((GetHandleId(c) ) , ( RimuruSpells___SH_DODGE_Q ) , ( 0 ) , ( c ) , ( RimuruF3_Buff_ID)) // INLINED!!
endfunction
function Rimuru3G_Start takes unit c,real x,real y returns nothing
    local integer abilityId= RimuruG3_IntBonus_ID
    call UnitAddAbility(c, abilityId)
    call s__GearSystems2___KS_RemoveEffect_MyRemoveEff_Start((AddSpecialEffectTarget("war3mapImported\\wos_BDEF (2313).mdx", c, "origin") ) , (( RimuruG3_BonusDuration)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
    call s__GearSystems2___KS_RemoveEffect_MyRemoveEff_Start((AddSpecialEffectTarget("war3mapImported\\wos_blackwhiteaura_3.mdx", c, "origin") ) , (( RimuruG3_BonusDuration)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
    call s__GearSystems2___KS_RemoveAbility_RemoveAbility_Start((c ) , (( RimuruG3_BonusDuration )*1.0) , ( abilityId ) , ( 1)) // INLINED!!
    call WUI_HeroDuration(c , RimuruG3_ID , "Demon Lord Haki" , RimuruG3_BonusDuration , abilityId , "" , c)
    // G is replaced by Black Flame (3G2, copy of 2R) for the Haki duration.
    call s__GearSystems2___KS_SpellTimer_SpellTimer_Timer_Start((c ) , (( RimuruG3_BonusDuration )*1.0) , ( RimuruG3_2_ID ) , ( RimuruG3_ID) , 0) // INLINED!!
    call SetUnitAbilityLevel(c, RimuruG3_2_ID, 1)
endfunction

