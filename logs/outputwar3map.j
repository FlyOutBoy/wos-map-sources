        function s__AstaSpells__AstaSpells_E_AstaE_Start takes unit NewC returns nothing
            local integer this= s__AstaSpells__AstaSpells_E__allocate()
            local integer level= GetUnitAbilityLevel(NewC, AstaE_ID)
            if level < 1 then
                set level=1
            endif
            set s__AstaSpells__AstaSpells_E_MUI_AstaE=s__AstaSpells__AstaSpells_E_MUI_AstaE + 1
            set s__AstaSpells__AstaSpells_E_m_AstaE[s__AstaSpells__AstaSpells_E_MUI_AstaE]=this
            set s__AstaSpells__AstaSpells_E_c[this]=NewC
            set s__AstaSpells__AstaSpells_E_x[this]=GetUnitX(s__AstaSpells__AstaSpells_E_c[this])
            set s__AstaSpells__AstaSpells_E_y[this]=GetUnitY(s__AstaSpells__AstaSpells_E_c[this])
            set s__AstaSpells__AstaSpells_E_r[this]=0.0
            set s__AstaSpells__AstaSpells_E_r2[this]=0.0
            set s__AstaSpells__AstaSpells_E_r5[this]=0.0
            set s__AstaSpells__AstaSpells_E_r6[this]=30.0
            call StartSpellUnit2(s__AstaSpells__AstaSpells_E_c[this])
            set s__AstaSpells__AstaSpells_E_k[this]=0
            set s__AstaSpells__AstaSpells_E_u[this]=null
            set s__AstaSpells__AstaSpells_E_g[this]=CreateGroup()
            set s__AstaSpells__AstaSpells_E_g2[this]=CreateGroup()
            set s__AstaSpells__AstaSpells_E_check2[this]=0
            set s__AstaSpells__AstaSpells_E_a[this]=GetUnitFacing(s__AstaSpells__AstaSpells_E_c[this]) * bj_DEGTORAD
            set s__AstaSpells__AstaSpells_E_rmax[this]=AstaE_Duration
            set s__AstaSpells__AstaSpells_E_move[this]=8.0
            call SaveInteger(hs, GetHandleId(s__AstaSpells__AstaSpells_E_c[this]), AstaSpells__SH_ASTA_E, 1)
            if GetHeroLevel(s__AstaSpells__AstaSpells_E_c[this]) >= 35 then
                set s__AstaSpells__AstaSpells_E_move[this]=12.0
                set s__AstaSpells__AstaSpells_E_r6[this]=s__AstaSpells__AstaSpells_E_r6[this] * ( 1.0 + ( AstaE_35_bonuspeed / 100.0 ) )
            endif
            call SaveInteger(hs, GetHandleId(s__AstaSpells__AstaSpells_E_c[this]), AstaSpells__SH_CAST_R, 1)
            call BlzSetUnitFacingEx(s__AstaSpells__AstaSpells_E_c[this], s__AstaSpells__AstaSpells_E_a[this] * bj_RADTODEG)
            set s__AstaSpells__AstaSpells_E_aoe[this]=AstaE_DamageAoe
            set s__AstaSpells__AstaSpells_E_dmg[this]=GetHeroAgi(s__AstaSpells__AstaSpells_E_c[this], true) * ( AstaE_DamageAgiBase + AstaE_DamageAgiStep * ( level - 1 ) )
            call SetUnitAnimationByIndex(s__AstaSpells__AstaSpells_E_c[this], 9)
            call SetUnitTimeScale(s__AstaSpells__AstaSpells_E_c[this], 1.45)
            call SetMouseX(GetOwningPlayer(s__AstaSpells__AstaSpells_E_c[this]) , s__AstaSpells__AstaSpells_E_x[this] + 500 * Cos(s__AstaSpells__AstaSpells_E_a[this]))
            call SetMouseY(GetOwningPlayer(s__AstaSpells__AstaSpells_E_c[this]) , s__AstaSpells__AstaSpells_E_y[this] + 500 * Sin(s__AstaSpells__AstaSpells_E_a[this]))
            call MouseOn(GetOwningPlayer(s__AstaSpells__AstaSpells_E_c[this]))
            set s__AstaSpells__AstaSpells_E_scale[this]=1.0
            set s__AstaSpells__AstaSpells_E_k3[this]=0
            if GetUnitAbilityLevel(s__AstaSpells__AstaSpells_E_c[this], AstaSword2_ID) > 0 then
                set s__AstaSpells__AstaSpells_E_k3[this]=1
                set s__AstaSpells__AstaSpells_E_dmg[this]=GetHeroAgi(s__AstaSpells__AstaSpells_E_c[this], true) * ( AstaE_DamageAgiBase + AstaE_DamageAgiStep * level )
                set s__AstaSpells__AstaSpells_E_scale[this]=( 1.0 + ( ( AstaTE_AoeBonus - 5.0 ) / 100.0 ) )
                set s__AstaSpells__AstaSpells_E_aoe[this]=s__AstaSpells__AstaSpells_E_aoe[this] * ( 1.0 + ( AstaTE_AoeBonus / 100.0 ) )
            endif
            set s__AstaSpells__AstaSpells_E_dmg[this]=s__AstaSpells__AstaSpells_E_dmg[this] + AstaE_DamageStatic
            set s__AstaSpells__AstaSpells_E_e[this]=EffectSpawn("war3mapimported\\wos_Windwalk Black.mdx" , s__AstaSpells__AstaSpells_E_x[this] , s__AstaSpells__AstaSpells_E_y[this] , 1 , 1 , 3 * s__AstaSpells__AstaSpells_E_scale[this] , 0)
            set s__AstaSpells__AstaSpells_E_e2[this]=EffectSpawn("war3mapimported\\wos_Windwalk blood.mdx" , s__AstaSpells__AstaSpells_E_x[this] , s__AstaSpells__AstaSpells_E_y[this] , 1 , 1 , 2 * s__AstaSpells__AstaSpells_E_scale[this] , 0)
            call MakeSound("war3mapimported\\Hero_Asta_E")
            if s__AstaSpells__AstaSpells_E_MUI_AstaE == 0 then
                call AstaSpells__AstaTimer03Acquire()
            endif
        endfunction

