                        call s__FrierenSpells__FrierenSpells_T2_Burst(this,s__FrierenSpells__FrierenSpells_T2_dmg2[this] * 0.25 , s__FrierenSpells__FrierenSpells_T2_aoe[this] + 400 , ( s__FrierenSpells__FrierenSpells_T2_aoe[this] + 400 ) * 1.25)
