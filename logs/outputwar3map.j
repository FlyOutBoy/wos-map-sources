                endif
                return false
            endif
            // ---- marks
            if not ItemsSpells__ElemAlive(s__ItemsElementsFx_u[this]) then
                return true
            endif
            if s__ItemsElementsFx_kind[this] == s__ItemsElementsFx_VERDICT then
                set dx=GetUnitX(s__ItemsElementsFx_u[this]) - s__ItemsElementsFx_x[this]
                set dy=GetUnitY(s__ItemsElementsFx_u[this]) - s__ItemsElementsFx_y[this]
                if dx * dx + dy * dy > ThunderVerdict_Leash * ThunderVerdict_Leash then
                    call ItemsSpells__ElemFx("war3mapimported\\wos_WTW-whitethunder-Zi.mdx" , GetUnitX(s__ItemsElementsFx_u[this]) , GetUnitY(s__ItemsElementsFx_u[this]) , 1.0)
                    call ItemsSpells__ElemHit(s__ItemsElementsFx_c[this] , s__ItemsElementsFx_u[this] , ThunderVerdict_ID , s__ItemsElementsFx_dmg2[this] , true , 0)
                    call SlowUnit(s__ItemsElementsFx_c[this] , s__ItemsElementsFx_u[this] , 25 , 1)
                    return true
                endif
            elseif s__ItemsElementsFx_kind[this] == s__ItemsElementsFx_VOLT then
                if not ItemsSpells__ElemAlive(s__ItemsElementsFx_c[this]) then
                    return true
                endif
                set s__ItemsElementsFx_next[this]=s__ItemsElementsFx_next[this] - s__ItemsElementsFx_DT
                if s__ItemsElementsFx_next[this] <= 0.0001 then
                    set s__ItemsElementsFx_next[this]=s__ItemsElementsFx_next[this] + 1.0
                    call s__ItemsElementsFx_ThreadPulse(this)
                endif
                if s__ItemsElementsFx_ln[this] != null then
                    call MoveLightningEx(s__ItemsElementsFx_ln[this], true, GetUnitX(s__ItemsElementsFx_c[this]), GetUnitY(s__ItemsElementsFx_c[this]), 60, GetUnitX(s__ItemsElementsFx_u[this]), GetUnitY(s__ItemsElementsFx_u[this]), 60)
                endif
            elseif s__ItemsElementsFx_kind[this] == s__ItemsElementsFx_COIL then
                if not ItemsSpells__ElemAlive(s__ItemsElementsFx_u2[this]) then
                    return true
                endif
                set dx=GetUnitX(s__ItemsElementsFx_u[this]) - GetUnitX(s__ItemsElementsFx_u2[this])
                set dy=GetUnitY(s__ItemsElementsFx_u[this]) - GetUnitY(s__ItemsElementsFx_u2[this])
                if dx * dx + dy * dy > ConstellationCoil_Break * ConstellationCoil_Break then
                    call ItemsSpells__ElemHit(s__ItemsElementsFx_c[this] , s__ItemsElementsFx_u[this] , ConstellationCoil_ID , s__ItemsElementsFx_dmg2[this] , true , 0)
                    call ItemsSpells__ElemHit(s__ItemsElementsFx_c[this] , s__ItemsElementsFx_u2[this] , ConstellationCoil_ID , s__ItemsElementsFx_dmg2[this] , true , 0)
                    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\Bolt\\BoltImpact.mdl", s__ItemsElementsFx_u[this], "chest"))
                    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\Bolt\\BoltImpact.mdl", s__ItemsElementsFx_u2[this], "chest"))
                    return true
                endif
                call MoveLightningEx(s__ItemsElementsFx_ln[this], true, GetUnitX(s__ItemsElementsFx_u[this]), GetUnitY(s__ItemsElementsFx_u[this]), 60, GetUnitX(s__ItemsElementsFx_u2[this]), GetUnitY(s__ItemsElementsFx_u2[this]), 60)
            elseif s__ItemsElementsFx_kind[this] == s__ItemsElementsFx_SIREN then
                set s__ItemsElementsFx_next[this]=s__ItemsElementsFx_next[this] - s__ItemsElementsFx_DT
                if s__ItemsElementsFx_next[this] <= 0.0001 then
                    set s__ItemsElementsFx_next[this]=s__ItemsElementsFx_next[this] + 0.25
                    set take=RMinBJ(s__ItemsElementsFx_dmg2[this], GetUnitState(s__ItemsElementsFx_u[this], UNIT_STATE_MANA))
                    if take > 0.0 then
                        call SetMpCurrentQuiet(s__ItemsElementsFx_u[this] , - take)
                        call SetMpCurrentQuiet(s__ItemsElementsFx_c[this] , take * SirenTear_Return / 100.0)
                    endif
                endif
            endif
            set v=null
            set a1=null
            set b1=null
            return s__ItemsElementsFx_left[this] <= 0.0
        endfunction

        function s__ItemsElementsFx_Tick takes nothing returns nothing
            local integer i= 0
            local integer this
            loop
                exitwhen i >= s__ItemsElementsFx_count
                set this=s__ItemsElementsFx_list[i]
                set ItemsSpells__ElemBambCur=this
                if s__ItemsElementsFx_bambE[this] != null and s__ItemsElementsFx_e[this] != null then
                    // Visual only: the Bambietta missile rides on the item projectile.
                    call BlzSetSpecialEffectPosition(s__ItemsElementsFx_bambE[this], BlzGetLocalSpecialEffectX(s__ItemsElementsFx_e[this]), BlzGetLocalSpecialEffectY(s__ItemsElementsFx_e[this]), BlzGetLocalSpecialEffectZ(s__ItemsElementsFx_e[this]))
                endif
                if s__ItemsElementsFx_update(this) then
                    set ItemsSpells__ElemBambCur=0
                    set s__ItemsElementsFx_count=s__ItemsElementsFx_count - 1
                    set s__ItemsElementsFx_list[i]=s__ItemsElementsFx_list[s__ItemsElementsFx_count]
                    call s__ItemsElementsFx_finish(this)
                else
                    set ItemsSpells__ElemBambCur=0
                    set i=i + 1
                endif
            endloop
            if s__ItemsElementsFx_count == 0 then
                call PauseTimer(s__ItemsElementsFx_clock)
            endif
        endfunction

        function s__ItemsElementsFx_onInit takes nothing returns nothing
            set s__ItemsElementsFx_tickCode=function s__ItemsElementsFx_Tick
        endfunction

    // Bambietta G (same rule as the old item actives): spend the passive at cast,
    // the projectile carries her missile, G2 explodes on the first enemy hit.
    function ItemsSpells__ElemBambArm takes integer fx returns nothing
        local unit c= s__ItemsElementsFx_c[fx]
        local string model= "war3mapimported\\wos_3yifu_2.mdx"
        if GetUnitTypeId(c) == Bambietta_ID and BlzGetUnitAbilityCooldownRemaining(c, BambiettaG_ID) == 0 and GetHeroLevel(c) >= BambiettaG_Lvl_CD then
            call BambiettaG_Start(c)
            set ItemsSpells__ElemBambArmed[fx]=true
            if s__ItemsElementsFx_e[fx] != null then
                if LoadInteger(hs, GetHandleId(GetOwningPlayer(c)), ItemsSpells__SH_MORPH_T) > 0 then
                    set model="war3mapimported\\wos_3yifu_2red.mdx"
                endif
                set s__ItemsElementsFx_bambE[fx]=EffectSpawn(model , GetUnitX(c) , GetUnitY(c) , GetUnitFacing(c) , 1 , 1 , 100)
            endif
        endif
        set c=null
    endfunction

    // ---------------------------------------------------------------- casts
    function ItemsElements_Cast takes unit c,unit td,real x,real y,integer id returns nothing
        local integer fx
        local real life
        local real cost
        local real a
        local real d
        if id == BloodPactRingEvolved_Abi_ID then
            call GearManaFloorStart(c , BloodPactRingEvolved_Duration , BloodPactRingEvolved_ManaFloor / 100.0)
            call s__GearSystems2___KS_RemoveEffect_MyRemoveEff_Start((AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIma\\AImaTarget.mdl", c, "origin") ) , (( BloodPactRingEvolved_Duration)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
            return
        endif
        if id == BloodPactRing_Abi_ID then
            set life=GetWidgetLife(c)
            set cost=RMinBJ(BloodPactRing_Cost, life - 1.0)
            if cost > 0.0 then
                call SetWidgetLife(c, life - cost)
                call SetMpCurrent(c , BloodPactRing_Mana)
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DeathPact\\DeathPactTarget.mdl", c, "origin"))
            endif
            return
        endif
        // ---- single target: a projectile carries the first damage (Booster added once there)
        if id == Emberbreaker_Abi_ID or id == LeviathanGrasp_Abi_ID or id == ThunderVerdict_Abi_ID or id == CinderFang_Abi_ID or id == VoltThread_Abi_ID or id == PhoenixSeal_Abi_ID or id == SirenTear_Abi_ID then
            if not ItemsSpells__ElemValid(c , td) then
                return
            endif
            if id == Emberbreaker_Abi_ID then
                set fx=s__ItemsElementsFx_Missile(Emberbreaker_ID , c , GetUnitX(c) , GetUnitY(c) , td , 1400 , "war3mapImported\\wos_summon3missle.mdl" , SacredGearBooster(c , Emberbreaker_Impact * (I2R(GetHeroStr((c), true))))) // INLINED!!
            elseif id == LeviathanGrasp_Abi_ID then
                set fx=s__ItemsElementsFx_Missile(LeviathanGrasp_ID , c , GetUnitX(c) , GetUnitY(c) , td , 1300 , "war3mapimported\\wos_EF_AZ_Leviathan_G1.mdl" , SacredGearBooster(c , LeviathanGrasp_Impact * (I2R(GetHeroStr((c), true))))) // INLINED!!
            elseif id == ThunderVerdict_Abi_ID then
                set fx=s__ItemsElementsFx_Add(s__ItemsElementsFx_STRIKES , ThunderVerdict_ID , c , td , 2.0)
                set s__ItemsElementsFx_dmg[fx]=SacredGearBooster(c , ThunderVerdict_Damage * (I2R(GetHeroStr((c), true)))) / 3.0 // INLINED!!
                set s__ItemsElementsFx_next[fx]=0.10
            elseif id == CinderFang_Abi_ID then
                set fx=s__ItemsElementsFx_Missile(CinderFang_ID , c , GetUnitX(c) , GetUnitY(c) , td , 2400 , "war3mapImported\\wos_Windwalk Fire2.mdl" , SacredGearBooster(c , CinderFang_Impact * (I2R(GetHeroAgi((c), true))))) // INLINED!!
            elseif id == VoltThread_Abi_ID then
                set fx=s__ItemsElementsFx_Missile(VoltThread_ID , c , GetUnitX(c) , GetUnitY(c) , td , 2000 , "war3mapImported\\wos_obr08 (166).mdx" , SacredGearBooster(c , VoltThread_Damage * (I2R(GetHeroAgi((c), true))))) // INLINED!!
            elseif id == PhoenixSeal_Abi_ID then
                set fx=s__ItemsElementsFx_Add(s__ItemsElementsFx_SEALCAST , PhoenixSeal_ID , c , td , 1.85)
                set s__ItemsElementsFx_dmg[fx]=SacredGearBooster(c , PhoenixSeal_Impact * (I2R(GetHeroInt((c), true)))) // INLINED!!
                set s__ItemsElementsFx_next[fx]=0.30
                set s__ItemsElementsFx_step[fx]=0.08
                set s__ItemsElementsFx_e[fx]=EffectSpawn("war3mapImported\\wos_tx-jian-za.mdl" , GetUnitX(td) , GetUnitY(td) , GetUnitFacing(c) , 0.08 , 0.5 , 1500)
                set s__ItemsElementsFx_dmg2[fx]=BlzGetLocalSpecialEffectZ(s__ItemsElementsFx_e[fx]) - 1500.0
            else
                set fx=s__ItemsElementsFx_Missile(SirenTear_ID , c , GetUnitX(c) , GetUnitY(c) , td , 2200 , "Abilities\\Weapons\\SeaElementalMissile\\SeaElementalMissile.mdl" , SacredGearBooster(c , SirenTear_Damage * (I2R(GetHeroInt((c), true))))) // INLINED!!
            endif
            call ItemsSpells__ElemBambArm(fx)
            return
        endif
        // ---- area: delayed blasts, pulses, sweeps
        if id == LeviathanAnchor_Abi_ID then
            set fx=s__ItemsElementsFx_Add(s__ItemsElementsFx_ANCHOR , LeviathanAnchor_ID , c , null , 2.0)
            set s__ItemsElementsFx_dmg[fx]=SacredGearBooster(c , LeviathanAnchor_Damage * (I2R(GetHeroStr((c), true)))) / 3.0 // INLINED!!
            call MoveLocation(ItemsSpells__AnchorGround, x, y)
            set s__ItemsElementsFx_dmg2[fx]=GetLocationZ(ItemsSpells__AnchorGround)
            set s__ItemsElementsFx_e[fx]=AddSpecialEffect("war3mapImported\\wos_EF_AZ_Leviathan_G2.mdx", x, y)
            call BlzSetSpecialEffectScale(s__ItemsElementsFx_e[fx], 0.9)
            call BlzSetSpecialEffectPosition(s__ItemsElementsFx_e[fx], x, y, s__ItemsElementsFx_dmg2[fx] + 2050.0)
            call BlzSetSpecialEffectPitch(s__ItemsElementsFx_e[fx], - bj_PI)
            set s__ItemsElementsFx_next[fx]=0.6
            set s__ItemsElementsFx_tx[fx]=x
            set s__ItemsElementsFx_ty[fx]=y
            set a=Atan2(y - GetUnitY(c), x - GetUnitX(c))
            set s__ItemsElementsFx_vx[fx]=Cos(a)
            set s__ItemsElementsFx_vy[fx]=Sin(a)
            set s__ItemsElementsFx_g2[fx]=CreateGroup()
            // Original G2 water emitter stays attached to the mesh during all motion.
        elseif id == ThunderBastion_Abi_ID then
            set fx=s__ItemsElementsFx_Add(s__ItemsElementsFx_STORM , ThunderBastion_ID , c , null , 1.6)
            set s__ItemsElementsFx_dmg[fx]=SacredGearBooster(c , ThunderBastion_Damage * (I2R(GetHeroStr((c), true)))) / 4.0 // INLINED!!
            set s__ItemsElementsFx_step[fx]=0.4
            set s__ItemsElementsFx_next[fx]=0.2
            set s__ItemsElementsFx_g[fx]=CreateGroup()
            set s__ItemsElementsFx_e[fx]=AddSpecialEffect("Abilities\\Spells\\Human\\ManaFlare\\ManaFlareTarget.mdl", x, y)
            call BlzSetSpecialEffectScale(s__ItemsElementsFx_e[fx], 1.25)
        elseif id == CrimsonScripture_Abi_ID then
            set fx=s__ItemsElementsFx_Add(s__ItemsElementsFx_RUNE , CrimsonScripture_ID , c , null , 1.8)
            set s__ItemsElementsFx_dmg[fx]=SacredGearBooster(c , CrimsonScripture_Damage * (I2R(GetHeroInt((c), true)))) // INLINED!!
            set s__ItemsElementsFx_dmg2[fx]=CrimsonScripture_Ground * (I2R(GetHeroInt((c), true))) / 6.0 // INLINED!!
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_BY_Wood_Effect_OnePiece_AiSi_DaYanJieYanDi_2.mdl" , x , y , GetRandomReal(0, 359) , 0.5 * 0.44 / 0.6 , 1.995 , 1))
        elseif id == ConstellationCoil_Abi_ID then
            set a=Atan2(y - GetUnitY(c), x - GetUnitX(c))
            set fx=s__ItemsElementsFx_Add(s__ItemsElementsFx_COILSHOT , ConstellationCoil_ID , c , null , 2.0)
            set s__ItemsElementsFx_dmg[fx]=SacredGearBooster(c , ConstellationCoil_Damage * (I2R(GetHeroInt((c), true)))) // INLINED!!
            set s__ItemsElementsFx_next[fx]=ConstellationCoil_Range
            set s__ItemsElementsFx_vx[fx]=Cos(a)
            set s__ItemsElementsFx_vy[fx]=Sin(a)
            set s__ItemsElementsFx_g[fx]=CreateGroup()
            set x=GetUnitX(c)
            set y=GetUnitY(c)
            set s__ItemsElementsFx_e[fx]=EffectSpawn(ConstellationCoil_ProjectileModel , x , y , a * bj_RADTODEG , 1 , ConstellationCoil_ProjectileScale , 100)
            set s__ItemsElementsFx_e2[fx]=EffectSpawn("war3mapimported\\wos_krk (1849)6.mdl" , x , y , a * bj_RADTODEG , 1 , 0.9 , 100)
        elseif id == AshenCrossfire_Abi_ID or id == MirrorTide_Abi_ID then
            set a=Atan2(y - GetUnitY(c), x - GetUnitX(c))
            set d=SquareRoot(( x - GetUnitX(c) ) * ( x - GetUnitX(c) ) + ( y - GetUnitY(c) ) * ( y - GetUnitY(c) ))
            if id == AshenCrossfire_Abi_ID then
                set fx=s__ItemsElementsFx_Add(s__ItemsElementsFx_ASHEN , AshenCrossfire_ID , c , null , 4.0)
                set s__ItemsElementsFx_dmg[fx]=SacredGearBooster(c , AshenCrossfire_Damage * (I2R(GetHeroAgi((c), true)))) // INLINED!!
                set s__ItemsElementsFx_dmg2[fx]=AshenCrossfire_Return * (I2R(GetHeroAgi((c), true))) // INLINED!!
                set s__ItemsElementsFx_next[fx]=AshenCrossfire_Range
                set s__ItemsElementsFx_g2[fx]=CreateGroup()
                set s__ItemsElementsFx_trail1[fx]=EffectSpawn("war3mapImported\\wos_Windwalk Fire2.mdl" , GetUnitX(c) , GetUnitY(c) , a * bj_RADTODEG , 1 , 1 , AshenCrossfire_TrailHeight)
                set s__ItemsElementsFx_trail2[fx]=EffectSpawn("war3mapImported\\wos_Windwalk Fire2.mdl" , GetUnitX(c) , GetUnitY(c) , a * bj_RADTODEG , 1 , 1 , AshenCrossfire_TrailHeight)
                set s__ItemsElementsFx_trail3[fx]=EffectSpawn("war3mapImported\\wos_Windwalk Fire2.mdl" , GetUnitX(c) , GetUnitY(c) , a * bj_RADTODEG , 1 , 1 , AshenCrossfire_TrailHeight)
                set s__ItemsElementsFx_e[fx]=EffectSpawn3(AshenCrossfire_ProjectileModel , GetUnitX(c) , GetUnitY(c) , ( a - 0.35 ) * bj_RADTODEG + 90 , 1 , AshenCrossfire_ProjectileScale , AshenCrossfire_ProjectileHeight , - 90)
                set s__ItemsElementsFx_e2[fx]=EffectSpawn3(AshenCrossfire_ProjectileModel , GetUnitX(c) , GetUnitY(c) , ( a ) * bj_RADTODEG + 90 , 1 , AshenCrossfire_ProjectileScale , AshenCrossfire_ProjectileHeight , - 90)
                set s__ItemsElementsFx_e3[fx]=EffectSpawn3(AshenCrossfire_ProjectileModel , GetUnitX(c) , GetUnitY(c) , ( a + 0.35 ) * bj_RADTODEG + 90 , 1 , AshenCrossfire_ProjectileScale , AshenCrossfire_ProjectileHeight , - 90)
            else
                set fx=s__ItemsElementsFx_Add(s__ItemsElementsFx_WAVE , MirrorTide_ID , c , null , 4.0)
                set s__ItemsElementsFx_dmg[fx]=SacredGearBooster(c , MirrorTide_Damage * (I2R(GetHeroAgi((c), true)))) // INLINED!!
                set s__ItemsElementsFx_next[fx]=MirrorTide_Range
                set s__ItemsElementsFx_tx[fx]=GetUnitX(c) + Cos(a) * s__ItemsElementsFx_next[fx]
                set s__ItemsElementsFx_ty[fx]=GetUnitY(c) + Sin(a) * s__ItemsElementsFx_next[fx]
                set s__ItemsElementsFx_e[fx]=EffectSpawn(MirrorTide_ProjectileModel , GetUnitX(c) , GetUnitY(c) , a * bj_RADTODEG , 1 , MirrorTide_ProjectileScale , 0)
            endif
            set s__ItemsElementsFx_vx[fx]=Cos(a)
            set s__ItemsElementsFx_vy[fx]=Sin(a)
            set s__ItemsElementsFx_g[fx]=CreateGroup()
            set x=GetUnitX(c)
            set y=GetUnitY(c)
        else
            return
        endif
        set s__ItemsElementsFx_x[fx]=x
        set s__ItemsElementsFx_y[fx]=y
        call ItemsSpells__ElemBambArm(fx)
    endfunction

    // ---------------------------------------------------------------- reactions
    // Applied damage (DmgSys). Follow-ups are spell damage, so they never re-enter the attack
    // branches; enemy -> owner reactions need td == owner and spend their mark / charge first.
    function ItemsElements_OnDamage takes unit c,unit td,real dmg,boolean isAttack,integer sourceId returns nothing
        local integer fx
        local unit v
        local unit near= null
        local real best= 99999999.0
        local real d
        local real now
        local integer baseId
        if s__ItemsElementsFx_count == 0 or dmg <= 0.0 or c == null or td == null then
            return
        endif
        set now=TimerGetElapsed(HealRegenClock)
        set baseId=DamageSourceBase(sourceId)
        // Spend retaliation before applying its damage, so it cannot recurse.
        set fx=s__ItemsElementsFx_Find(s__ItemsElementsFx_EMBER , td , c)
        if fx != 0 and s__ItemsElementsFx_HasMark(fx) then
            set s__ItemsElementsFx_left[fx]=0.0
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl", c, "chest"))
            call ItemsSpells__ElemHit(td , c , Emberbreaker_ID , s__ItemsElementsFx_dmg2[fx] , true , 0)
        endif
        set fx=s__ItemsElementsFx_Find(s__ItemsElementsFx_BASTION , td , null)
        if fx != 0 and s__ItemsElementsFx_HasMark(fx) and s__ItemsElementsFx_charges[fx] > 0 and IsUnitEnemy(c, GetOwningPlayer(td)) and SpellBool(c) and now >= s__ItemsElementsFx_step[fx] then
            set s__ItemsElementsFx_step[fx]=now + 0.8
            set s__ItemsElementsFx_charges[fx]=s__ItemsElementsFx_charges[fx] - 1
            if s__ItemsElementsFx_charges[fx] == 0 then
                set s__ItemsElementsFx_left[fx]=0.0
            endif
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\Bolt\\BoltImpact.mdl", c, "chest"))
            call ItemsSpells__ElemHit(td , c , ThunderBastion_ID , s__ItemsElementsFx_dmg2[fx] , true , 0)
            call SlowUnit(td , c , 20 , 1)
        endif
        set fx=s__ItemsElementsFx_Find(s__ItemsElementsFx_MIRROR , null , td)
        if dmg > 100.0 and fx != 0 and s__ItemsElementsFx_HasMark(fx) and s__ItemsElementsFx_charges[fx] > 0 and now >= s__ItemsElementsFx_step[fx] then
            set best=0.0
            call GroupEnumUnitsInRange(s__ItemsElementsFx_g[fx], GetUnitX(td), GetUnitY(td), 800.0, NoDecor_Cond)
            loop
                set v=FirstOfGroup(s__ItemsElementsFx_g[fx])
                exitwhen v == null
                call GroupRemoveUnit(s__ItemsElementsFx_g[fx], v)
                if v != td and ItemsSpells__ElemValid(s__ItemsElementsFx_c[fx] , v) then
                    set best=best + 1.0
                    if GetRandomInt(1, R2I(best)) == 1 then
                        set near=v
                    endif
                endif
            endloop
            if near != null then
                set s__ItemsElementsFx_charges[fx]=s__ItemsElementsFx_charges[fx] - 1
                set s__ItemsElementsFx_step[fx]=now + 0.1
                call s__ItemsElementsFx_Missile(MirrorTide_ID , s__ItemsElementsFx_c[fx] , GetUnitX(td) , GetUnitY(td) , near , 1600 , "Abilities\\Weapons\\WaterElementalMissile\\WaterElementalMissile.mdl" , s__ItemsElementsFx_dmg2[fx])
            endif
        endif
        // Only attacks and hero abilities feed offensive marks. Item/element follow-ups do not.
        if not ItemDamageCanProc(sourceId) or ( baseId >= 'I000' and baseId <= 'Izzz' ) then
            return
        endif
        set fx=s__ItemsElementsFx_Find(s__ItemsElementsFx_CINDER , c , td)
        if fx != 0 and s__ItemsElementsFx_HasMark(fx) and s__ItemsElementsFx_charges[fx] > 0 then
            set s__ItemsElementsFx_charges[fx]=0
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl", td, "chest"))
            call ItemsSpells__ElemHit(c , td , CinderFang_ID , s__ItemsElementsFx_dmg2[fx] , false , 0)
        endif
        if isAttack then
            set fx=s__ItemsElementsFx_Find(s__ItemsElementsFx_VOLT , c , td)
            if fx != 0 and s__ItemsElementsFx_HasMark(fx) and s__ItemsElementsFx_phase[fx] == 0 and now >= s__ItemsElementsFx_step[fx] + 0.4 then
                set s__ItemsElementsFx_step[fx]=now
                set s__ItemsElementsFx_charges[fx]=s__ItemsElementsFx_charges[fx] + 1
                if s__ItemsElementsFx_charges[fx] >= 3 then
                    set s__ItemsElementsFx_phase[fx]=1
                    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl", td, "origin"))
                    call ItemsSpells__ElemHit(c , td , VoltThread_ID , s__ItemsElementsFx_dmg2[fx] , true , 0)
                    call SlowUnit(c , td , 20 , 1)
                endif
            endif
        endif
        set v=null
        set near=null
    endfunction

    // A hero ability cast by a Phoenix Seal target (CastCheck, real casts only).
    function ItemsElements_OnHeroCast takes unit u returns nothing
        local integer i= 0
        local integer fx
        loop
            exitwhen i >= s__ItemsElementsFx_count
            set fx=s__ItemsElementsFx_list[i]
            if s__ItemsElementsFx_kind[fx] == s__ItemsElementsFx_PHOENIX and s__ItemsElementsFx_u[fx] == u and s__ItemsElementsFx_HasMark(fx) then
                set s__ItemsElementsFx_left[fx]=0.0
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl", u, "chest"))
                call ItemsSpells__ElemHit(s__ItemsElementsFx_c[fx] , u , PhoenixSeal_ID , s__ItemsElementsFx_dmg2[fx] , true , 0)
            endif
            set i=i + 1
        endloop
    endfunction


//library ItemsSpells ends
//library KenjakuSpells:

    function KenjakuSpells___KenjakuTick10_On takes integer k returns nothing
        if not KenjakuSpells___KenjakuTick10_Active[k] then
            set KenjakuSpells___KenjakuTick10_Active[k]=true
            set KenjakuSpells___KenjakuTick10_Users=KenjakuSpells___KenjakuTick10_Users + 1
            if KenjakuSpells___KenjakuTick10_Users == 1 then
                call TimerStart(KenjakuSpells___KenjakuTick10_Timer, 0.1, true, KenjakuSpells___KenjakuTick10_Callback)
            endif
        endif
    endfunction

    function KenjakuSpells___KenjakuTick10_Off takes integer k returns nothing
        if KenjakuSpells___KenjakuTick10_Active[k] then
            set KenjakuSpells___KenjakuTick10_Active[k]=false
            set KenjakuSpells___KenjakuTick10_Users=KenjakuSpells___KenjakuTick10_Users - 1
            if KenjakuSpells___KenjakuTick10_Users <= 0 then
                set KenjakuSpells___KenjakuTick10_Users=0
                call PauseTimer(KenjakuSpells___KenjakuTick10_Timer)
            endif
        endif
    endfunction


    function KenjakuSpells___KenjakuTick05_On takes integer k returns nothing
        if not KenjakuSpells___KenjakuTick05_Active[k] then
            set KenjakuSpells___KenjakuTick05_Active[k]=true
            set KenjakuSpells___KenjakuTick05_Users=KenjakuSpells___KenjakuTick05_Users + 1
            if KenjakuSpells___KenjakuTick05_Users == 1 then
