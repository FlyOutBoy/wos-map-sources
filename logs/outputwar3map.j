                        call VisionTimed(GetOwningPlayer(s__MilimSpells___MilimT2KS_c[this]) , s__MilimSpells___MilimT2KS_x[this] + 2400 * Cos(s__MilimSpells___MilimT2KS_a[this]) , s__MilimSpells___MilimT2KS_y[this] + 2400 * Sin(s__MilimSpells___MilimT2KS_a[this]) , 1200 , 4)

