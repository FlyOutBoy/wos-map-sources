            if DarkShikiSpells__DarkShikiTick_Active[2] then
                call s__DarkShikiSpells__DarkShikiE_KS_Loop_DarkShikiE()
            endif
            if DarkShikiSpells__DarkShikiTick_Active[3] then
                call s__DarkShikiSpells__DarkShikiR_KS_Loop_DarkShikiR()
            endif
            if DarkShikiSpells__DarkShikiTick_Active[4] then
                call s__DarkShikiSpells__DarkShikiT_KS_Loop_DarkShikiT()
            endif
            if DarkShikiSpells__DarkShikiTick_Active[5] then
                call s__DarkShikiSpells__DarkShikiG_KS_Loop_DarkShikiG()
            endif
        endfunction

