            loop
                exitwhen i > s__StarrkSpells___StarrkSpells_E_MUI_StarrkE
                set this=s__StarrkSpells___StarrkSpells_E_m_StarrkE[i]
                if SpellBoolCaster(s__StarrkSpells___StarrkSpells_E_c[this]) and s__StarrkSpells___StarrkSpells_E_r[this] <= s__StarrkSpells___StarrkSpells_E_rmax[this] and CheckCoordsInRect(gg_rct_Base , GetUnitX(s__StarrkSpells___StarrkSpells_E_c[this]) , GetUnitY(s__StarrkSpells___StarrkSpells_E_c[this])) == false then
                    if s__StarrkSpells___StarrkSpells_E_check[this] == 0 or ( s__StarrkSpells___StarrkSpells_E_check[this] == 1 and IsUnitPaused(s__StarrkSpells___StarrkSpells_E_c[this]) == false and GetUnitAbilityLevel(s__StarrkSpells___StarrkSpells_E_c[this], 'Avul') == 0 and LoadInteger(hs, GetHandleId(s__StarrkSpells___StarrkSpells_E_c[this]), StarrkSpells___SH_STARRK_T_ACTION) == 0 ) then
                        set s__StarrkSpells___StarrkSpells_E_r[this]=s__StarrkSpells___StarrkSpells_E_r[this] + 0.05
                    endif
                    set s__StarrkSpells___StarrkSpells_E_r[this]=RoundReal(s__StarrkSpells___StarrkSpells_E_r[this] , 3)
                    if s__StarrkSpells___StarrkSpells_E_check[this] == 0 then
                        if s__StarrkSpells___StarrkSpells_E_r[this] == 0.05 then
                            call ColorEffDummy3Alpha((s__StarrkSpells___StarrkSpells_E_e2[this] ) , (( 0 )*1.0) , ( 255 ) , ( 255 ) , ( 255 ) , 255 , (( 0.5)*1.0)) // INLINED!!
                            call MakeSound("war3mapimported\\Hero_Starrk_T3")
                            call EffectSpawn2("war3mapimported\\wos_kenpachiaura.mdx" , s__StarrkSpells___StarrkSpells_E_x[this] , s__StarrkSpells___StarrkSpells_E_y[this] , 0 , 1 , 1.55 , 0 , s__StarrkSpells___StarrkSpells_E_rmax[this] - 2.4)
                        endif
                        if s__StarrkSpells___StarrkSpells_E_r[this] >= 0 then
                            if s__StarrkSpells___StarrkSpells_E_r2[this] > 0.2 then
                                set s__StarrkSpells___StarrkSpells_E_r2[this]=0
                                call DecorRemove(s__StarrkSpells___StarrkSpells_E_c[this] , s__StarrkSpells___StarrkSpells_E_x[this] , s__StarrkSpells___StarrkSpells_E_y[this] , 650 , 20)
                                call DestroyEffect(EffectSpawn("war3mapimported\\wos_OPm (431232).mdl" , s__StarrkSpells___StarrkSpells_E_x[this] , s__StarrkSpells___StarrkSpells_E_y[this] , GetRandomReal(0, 359) , 1.5 , 2.15 , 35))
                                call DestroyEffect(EffectSpawn("war3mapimported\\wos_blue--zhendi31_3_x2.mdl" , s__StarrkSpells___StarrkSpells_E_x[this] , s__StarrkSpells___StarrkSpells_E_y[this] , GetRandomReal(0, 359) , 1 , 1 , 1))
                            else
                                set s__StarrkSpells___StarrkSpells_E_r2[this]=s__StarrkSpells___StarrkSpells_E_r2[this] + 0.05
                            endif
                            if s__StarrkSpells___StarrkSpells_E_r3[this] > 0.3 then
                                set s__StarrkSpells___StarrkSpells_E_r3[this]=0
                                call DestroyEffect(EffectSpawnColor("war3mapimported\\wos_by_wood_effect_order_dange_yueyun_2withoutblue2.mdl" , s__StarrkSpells___StarrkSpells_E_x[this] , s__StarrkSpells___StarrkSpells_E_y[this] , GetRandomReal(0, 359) , 2.35 , 1.5 , 1 , 255 , 255 , 255 , 55))
                            else
                                set s__StarrkSpells___StarrkSpells_E_r3[this]=s__StarrkSpells___StarrkSpells_E_r3[this] + 0.05
                            endif
                        endif
                        if s__StarrkSpells___StarrkSpells_E_r[this] == s__StarrkSpells___StarrkSpells_E_rmax[this] then
                            call MakeSound("war3mapimported\\Hero_Starrk_E5")
                            call s__GearSystems2___KS_DelayedSound_NextSound_Start(("war3mapimported\\Hero_Starrk_EQ2" ) , (( 0.3)*1.0)) // INLINED!!
                            call SaveInteger(hs, GetHandleId(s__StarrkSpells___StarrkSpells_E_c[this]), StarrkSpells___SH_BAN_SOUND_Q, 1)
                            call s__GearSystems2___KS_Flush_Start((GetHandleId(s__StarrkSpells___StarrkSpells_E_c[this]) ) , ( StarrkSpells___SH_BAN_SOUND_Q ) , ( 0 ) , (( 3)*1.0)) // INLINED!!
                            set s__StarrkSpells___StarrkSpells_E_k[this]=0
                            loop
                                exitwhen s__StarrkSpells___StarrkSpells_E_k[this] > 3
                                call DestroyEffect(EffectSpawnColor("war3mapimported\\wos_dustwave222.mdx" , s__StarrkSpells___StarrkSpells_E_x[this] , s__StarrkSpells___StarrkSpells_E_y[this] , GetRandomReal(0, 359) , 0.85 , 2.35 + s__StarrkSpells___StarrkSpells_E_k[this] * 0.65 , 0 , 0 , 125 , 255 , 90))
                                set s__StarrkSpells___StarrkSpells_E_k[this]=s__StarrkSpells___StarrkSpells_E_k[this] + 1
                            endloop
                            call SetUnitTimeScale(s__StarrkSpells___StarrkSpells_E_c[this], 1)
                            //call DestroyEffect(EffectSpawn("war3mapimported\\wos_es69.mdx", x, y, GetRandomReal(0, 359), 2.15, 4.5, 1))
                            call DestroyEffect(EffectSpawn("war3mapimported\\wos_by_wood_effect_order_dange_yueyun_2withoutblue2.mdx" , s__StarrkSpells___StarrkSpells_E_x[this] , s__StarrkSpells___StarrkSpells_E_y[this] , GetRandomReal(0, 359) , 0.65 , 1.85 , 1))
                            call StopSpellUnit2(s__StarrkSpells___StarrkSpells_E_c[this])
                            call BlzSetUnitSkin(s__StarrkSpells___StarrkSpells_E_c[this], Starrk_Morph_ID)
