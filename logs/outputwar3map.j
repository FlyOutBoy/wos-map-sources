// Shared timer scheduler
function GearCCProtected takes unit u returns boolean
    return LoadInteger(hs, GetHandleId(u), GearSystems2___SH_CC_PROTECTION_OWNERS) > 0
endfunction

function GearCCProtect takes unit u,boolean add returns nothing
    local integer hid= GetHandleId(u)
    local integer count= LoadInteger(hs, hid, GearSystems2___SH_CC_PROTECTION_OWNERS)
    if add then
        set count=count + 1
    else
        set count=IMaxBJ(0, count - 1)
    endif
    call SaveInteger(hs, hid, GearSystems2___SH_CC_PROTECTION_OWNERS, count)
endfunction

function GearSpellAddListener takes code callback returns triggeraction
    set GearSpellHasListeners=true
    return TriggerAddAction(GearSpellListeners, callback)
endfunction

function GearSpellDispatch takes nothing returns boolean
    local boolean previous= GearSpellHandled
    local boolean handled
    if not GearSpellHasListeners then
        return false
    endif
    set GearSpellHandled=false
    call TriggerExecute(GearSpellListeners)
    set handled=GearSpellHandled
    set GearSpellHandled=previous
    return handled
endfunction

// Reflected/nested damage must not overwrite the context of its caller.
// Phase 1 is pure: it runs for both shield preview and final damage.
function GearDamageAddListener takes code callback returns triggeraction
    set GearDamageHasListeners=true
    return TriggerAddAction(GearDamageListeners, callback)
endfunction

function GearDamageRun takes unit c,unit td,real amount,integer kind,integer phase returns real
    local unit oldSource
    local unit oldTarget
    local real oldAmount
    local integer oldType
    local integer oldPhase
    local real result
    if not GearDamageHasListeners then
        return amount
    endif
    set oldSource=GearDamageSource
    set oldTarget=GearDamageTarget
    set oldAmount=GearDamageAmount
    set oldType=GearDamageType
    set oldPhase=GearDamagePhase
    set GearDamageSource=c
    set GearDamageTarget=td
    set GearDamageAmount=amount
    set GearDamageType=kind
    set GearDamagePhase=phase
    call TriggerExecute(GearDamageListeners)
    set result=GearDamageAmount
    set GearDamageSource=oldSource
    set GearDamageTarget=oldTarget
    set GearDamageAmount=oldAmount
    set GearDamageType=oldType
    set GearDamagePhase=oldPhase
    set oldSource=null
    set oldTarget=null
    return result
endfunction

function GearTimer03Acquire takes nothing returns nothing
    set GearTimer03Users=GearTimer03Users + 1
    if GearTimer03Users == 1 then
        call TimerStart(GearTimer03, 0.03, true, GearTimer03Callback)
    endif
endfunction

function GearTimer03Release takes nothing returns nothing
    set GearTimer03Users=GearTimer03Users - 1
    if GearTimer03Users <= 0 then
        set GearTimer03Users=0
        call PauseTimer(GearTimer03)
    endif
endfunction

function GearTimer05Acquire takes nothing returns nothing
    set GearTimer05Users=GearTimer05Users + 1
    if GearTimer05Users == 1 then
        call TimerStart(GearTimer05, 0.05, true, GearTimer05Callback)
    endif
endfunction

function GearTimer05Release takes nothing returns nothing
    set GearTimer05Users=GearTimer05Users - 1
    if GearTimer05Users <= 0 then
        set GearTimer05Users=0
        call PauseTimer(GearTimer05)
    endif
endfunction

function GearTimer10Acquire takes nothing returns nothing
    set GearTimer10Users=GearTimer10Users + 1
    if GearTimer10Users == 1 then
        call TimerStart(GearTimer10, 0.10, true, GearTimer10Callback)
    endif
endfunction

function GearTimer10Release takes nothing returns nothing
    set GearTimer10Users=GearTimer10Users - 1
    if GearTimer10Users <= 0 then
        set GearTimer10Users=0
        call PauseTimer(GearTimer10)
    endif
endfunction
function GearSystems2___GearManaFloorTick takes nothing returns boolean
    local integer i= GearSystems2___GearManaFloorCount - 1
    local integer h
    local unit u
    loop
        exitwhen i < 0
        set u=GearSystems2___GearManaFloorUnit[i]
        set h=GetHandleId(u)
        if GetUnitTypeId(u) == 0 or GetWidgetLife(u) <= 0.405 or GearSystems2___GearManaFloorRound[i] != CurrentRound or LoadReal(hs, h, GearSystems2___SH_MANA_FLOOR_END) <= TimerGetElapsed(HealRegenClock) then
            call RemoveSavedReal(hs, h, GearSystems2___SH_MANA_FLOOR_END)
            call RemoveSavedReal(hs, h, GearSystems2___SH_MANA_FLOOR_FRACTION)
            set GearSystems2___GearManaFloorCount=GearSystems2___GearManaFloorCount - 1
            set GearSystems2___GearManaFloorUnit[i]=GearSystems2___GearManaFloorUnit[GearSystems2___GearManaFloorCount]
            set GearSystems2___GearManaFloorRound[i]=GearSystems2___GearManaFloorRound[GearSystems2___GearManaFloorCount]
            set GearSystems2___GearManaFloorUnit[GearSystems2___GearManaFloorCount]=null
            if GearSystems2___GearManaFloorCount == 0 then
                call GearTimer03Release()
            endif
        else
            call GearManaFloorApply(u)
        endif
        set i=i - 1
    endloop
    set u=null
    return false
endfunction

function GearManaFloorStart takes unit u,real duration,real fraction returns nothing
    local integer i= 0
    local integer h= GetHandleId(u)
    loop
        exitwhen i >= GearSystems2___GearManaFloorCount or GearSystems2___GearManaFloorUnit[i] == u
        set i=i + 1
    endloop
    call SaveReal(hs, h, GearSystems2___SH_MANA_FLOOR_END, TimerGetElapsed(HealRegenClock) + duration)
    call SaveReal(hs, h, GearSystems2___SH_MANA_FLOOR_FRACTION, fraction)
    if i == GearSystems2___GearManaFloorCount then
        set GearSystems2___GearManaFloorUnit[i]=u
        set GearSystems2___GearManaFloorCount=GearSystems2___GearManaFloorCount + 1
        if not GearSystems2___GearManaFloorListenerOn then
            set GearSystems2___GearManaFloorListenerOn=true
            call TriggerAddCondition(GearTimer03Listeners, Condition(function GearSystems2___GearManaFloorTick))
        endif
        if GearSystems2___GearManaFloorCount == 1 then
            call GearTimer03Acquire()
        endif
    endif
    set GearSystems2___GearManaFloorRound[i]=CurrentRound
    call GearManaFloorApply(u)
endfunction

    // Pending instance per (id, child_id): a repeat with the same value is redundant
    // (the first one to fire sets it; the rest cancel on their next tick).

    function s__GearSystems2___KS_Flush_Loop takes nothing returns nothing
        local integer this
        local integer i= 0
        loop
            exitwhen i > s__GearSystems2___KS_Flush_MUI
            set this=s__GearSystems2___KS_Flush_m[i]
            if s__GearSystems2___KS_Flush_r[this] < s__GearSystems2___KS_Flush_rmax[this] then
                set s__GearSystems2___KS_Flush_r[this]=I2R(R2I(( s__GearSystems2___KS_Flush_r[this] + 0.03 ) * 1000.0 + 0.5)) / 1000.0 // = RoundReal(r + 0.03, 3), r >= 0; no call per instance tick
                if LoadInteger(hs, s__GearSystems2___KS_Flush_id[this], s__GearSystems2___KS_Flush_child_id[this]) == s__GearSystems2___KS_Flush_value[this] then
                    set s__GearSystems2___KS_Flush_r[this]=9999
                endif
            else
                if s__GearSystems2___KS_Flush_r[this] != 9999 then
                    call SaveInteger(hs, s__GearSystems2___KS_Flush_id[this], s__GearSystems2___KS_Flush_child_id[this], s__GearSystems2___KS_Flush_value[this])
                endif
                if LoadInteger(s__GearSystems2___KS_Flush_pending, s__GearSystems2___KS_Flush_id[this], s__GearSystems2___KS_Flush_child_id[this]) == this then
                    call RemoveSavedInteger(s__GearSystems2___KS_Flush_pending, s__GearSystems2___KS_Flush_id[this], s__GearSystems2___KS_Flush_child_id[this])
                endif
                set s__GearSystems2___KS_Flush_m[i]=s__GearSystems2___KS_Flush_m[s__GearSystems2___KS_Flush_MUI]
                set s__GearSystems2___KS_Flush_MUI=s__GearSystems2___KS_Flush_MUI - 1
                set i=i - 1 // revisit: the moved instance must not skip this tick
                if s__GearSystems2___KS_Flush_MUI == - 1 then
                    call GearTimer03Release()
                endif
                call s__GearSystems2___KS_Flush_deallocate(this)
            endif
            set i=i + 1
        endloop
    endfunction

    function s__GearSystems2___KS_Flush_Start takes integer NewId,integer NewChild_Id,integer NewValue,real NewRmax returns nothing
        local integer this= LoadInteger(s__GearSystems2___KS_Flush_pending, NewId, NewChild_Id)
        if this != 0 and s__GearSystems2___KS_Flush_value[this] == NewValue and s__GearSystems2___KS_Flush_r[this] != 9999 then
            // Same reset already pending: only an earlier deadline matters.
            if s__GearSystems2___KS_Flush_rmax[this] - s__GearSystems2___KS_Flush_r[this] > NewRmax then
                set s__GearSystems2___KS_Flush_r[this]=0
                set s__GearSystems2___KS_Flush_rmax[this]=NewRmax
            endif
            return
        endif
        set this=s__GearSystems2___KS_Flush__allocate()
        call SaveInteger(s__GearSystems2___KS_Flush_pending, NewId, NewChild_Id, this)
        set s__GearSystems2___KS_Flush_MUI=s__GearSystems2___KS_Flush_MUI + 1
        set s__GearSystems2___KS_Flush_m[s__GearSystems2___KS_Flush_MUI]=this
        set s__GearSystems2___KS_Flush_r[this]=0
        set s__GearSystems2___KS_Flush_rmax[this]=NewRmax
        set s__GearSystems2___KS_Flush_id[this]=NewId
        set s__GearSystems2___KS_Flush_child_id[this]=NewChild_Id
        set s__GearSystems2___KS_Flush_value[this]=NewValue
        if s__GearSystems2___KS_Flush_MUI == 0 then
            call GearTimer03Acquire()
        endif
    endfunction

//===========================================================================
// KS_FlushBuff РІР‚вЂќ РЎвЂћР В»Р В°РЎв‚¬ Р С—Р С• Р Р…Р В°Р В»Р С‘РЎвЂЎР С‘РЎР‹ Р В±Р В°РЎвЂћР В°/Р В°Р В±Р С‘Р В»Р С”Р С‘ (Р В±РЎвЂ№Р В»Р С•: MyFlushI_Start c check!=0)
// Р ВРЎРѓР С—Р С•Р В»РЎРЉР В·РЎС“Р ВµР СРЎвЂ№Р Вµ Р С—Р ВµРЎР‚Р ВµР СР ВµР Р…Р Р…РЎвЂ№Р Вµ: c, check, id, child_id, value, r, b
//===========================================================================
    // Identical pending (id, child_id, value, unit, buff) instances fire on the same tick: keep one.

    function s__GearSystems2___KS_FlushBuff_Loop takes nothing returns nothing
        local integer this
        local integer i= 0
        loop
            exitwhen i > s__GearSystems2___KS_FlushBuff_MUI
            set this=s__GearSystems2___KS_FlushBuff_m[i]
            set s__GearSystems2___KS_FlushBuff_b[this]=GetUnitAbilityLevel(s__GearSystems2___KS_FlushBuff_c[this], s__GearSystems2___KS_FlushBuff_check[this]) > 0
            if s__GearSystems2___KS_FlushBuff_b[this] then
                set s__GearSystems2___KS_FlushBuff_r[this]=I2R(R2I(( s__GearSystems2___KS_FlushBuff_r[this] + 0.03 ) * 1000.0 + 0.5)) / 1000.0 // = RoundReal(r + 0.03, 3), r >= 0; no call per instance tick
                if LoadInteger(hs, s__GearSystems2___KS_FlushBuff_id[this], s__GearSystems2___KS_FlushBuff_child_id[this]) == s__GearSystems2___KS_FlushBuff_value[this] then
                    set s__GearSystems2___KS_FlushBuff_r[this]=9999
                endif
            else
                if s__GearSystems2___KS_FlushBuff_r[this] != 9999 then
                    call SaveInteger(hs, s__GearSystems2___KS_FlushBuff_id[this], s__GearSystems2___KS_FlushBuff_child_id[this], s__GearSystems2___KS_FlushBuff_value[this])
                endif
                if s__GearSystems2___KS_FlushBuff_check[this] == RimuruQ2_Buff_ID then
                    call MakeSound("war3mapimported\\Hero_Rimuru2_Q3")
                endif
                if LoadInteger(s__GearSystems2___KS_FlushBuff_pending, s__GearSystems2___KS_FlushBuff_id[this], s__GearSystems2___KS_FlushBuff_child_id[this]) == this then
                    call RemoveSavedInteger(s__GearSystems2___KS_FlushBuff_pending, s__GearSystems2___KS_FlushBuff_id[this], s__GearSystems2___KS_FlushBuff_child_id[this])
                endif
                set s__GearSystems2___KS_FlushBuff_c[this]=null
                set s__GearSystems2___KS_FlushBuff_m[i]=s__GearSystems2___KS_FlushBuff_m[s__GearSystems2___KS_FlushBuff_MUI]
                set s__GearSystems2___KS_FlushBuff_MUI=s__GearSystems2___KS_FlushBuff_MUI - 1
                set i=i - 1 // revisit: the moved instance must not skip this tick
                if s__GearSystems2___KS_FlushBuff_MUI == - 1 then
                    call GearTimer03Release()
                endif
                call s__GearSystems2___KS_FlushBuff_deallocate(this)
            endif
            set i=i + 1
        endloop
    endfunction

    function s__GearSystems2___KS_FlushBuff_Start takes integer NewId,integer NewChild_Id,integer NewValue,unit NewC,integer NewAbiId returns nothing
        local integer this= LoadInteger(s__GearSystems2___KS_FlushBuff_pending, NewId, NewChild_Id)
        if this != 0 and s__GearSystems2___KS_FlushBuff_value[this] == NewValue and s__GearSystems2___KS_FlushBuff_c[this] == NewC and s__GearSystems2___KS_FlushBuff_check[this] == NewAbiId and s__GearSystems2___KS_FlushBuff_r[this] != 9999 then
            return
        endif
        set this=s__GearSystems2___KS_FlushBuff__allocate()
        call SaveInteger(s__GearSystems2___KS_FlushBuff_pending, NewId, NewChild_Id, this)
        set s__GearSystems2___KS_FlushBuff_MUI=s__GearSystems2___KS_FlushBuff_MUI + 1
        set s__GearSystems2___KS_FlushBuff_m[s__GearSystems2___KS_FlushBuff_MUI]=this
        set s__GearSystems2___KS_FlushBuff_r[this]=0
        set s__GearSystems2___KS_FlushBuff_c[this]=NewC
        set s__GearSystems2___KS_FlushBuff_id[this]=NewId
        set s__GearSystems2___KS_FlushBuff_child_id[this]=NewChild_Id
        set s__GearSystems2___KS_FlushBuff_value[this]=NewValue
        set s__GearSystems2___KS_FlushBuff_check[this]=NewAbiId
        if s__GearSystems2___KS_FlushBuff_MUI == 0 then
            call GearTimer03Acquire()
        endif
    endfunction

