    function TomiokaPass_Start takes unit c returns nothing
        local integer i= LoadInteger(hs, GetHandleId(c), TomiokaSpells___SH_TOMIOKA_ADD_DMG)
        if GetHeroLevel(c) >= 0 then
        if LoadInteger(hs, GetHandleId(c), TomiokaSpells___SH_TOMIOKA_ADD_DMG) > 0 and LoadInteger(hs, GetHandleId(c), TomiokaSpells___SH_TOMIOKA_ADD_DMG) < 9999 then
            call SaveInteger(hs, GetHandleId(c), TomiokaSpells___SH_TOMIOKA_ADD_DMG, i + 1)
        endif
        if LoadInteger(hs, GetHandleId(c), TomiokaSpells___SH_TOMIOKA_G_CD) == 0 then
            call SaveInteger(hs, GetHandleId(c), TomiokaSpells___SH_TOMIOKA_G_CD, 1)
            call s__TomiokaSpells___TomiokaG_KS_TomiokaG_Start(c)
        endif
        endif
    endfunction
    function TomiokaQ_Start takes unit c,unit td returns nothing
        call TomiokaPass_Start(c)
        call s__TomiokaSpells___TomiokaQ_KS_TomiokaQ_Start(c , td)
        if GetHeroLevel(c) >= 0 then
        call SaveInteger(hs, GetHandleId(c), TomiokaSpells___SH_SKILL_Q, 1)
        call s__GearSystems2___KS_Flush_Start((GetHandleId(c) ) , ( TomiokaSpells___SH_SKILL_Q ) , ( 0 ) , (( 3)*1.0)) // INLINED!!
        endif
    endfunction
    function TomiokaW_Start takes unit c,real x,real y returns nothing
        call TomiokaPass_Start(c)
        call s__TomiokaSpells___TomiokaW_KS_TomiokaW_Start(c , x , y)
        if GetHeroLevel(c) >= 0 then
        call SaveInteger(hs, GetHandleId(c), TomiokaSpells___SH_SKILL_W, 1)
        call s__GearSystems2___KS_Flush_Start((GetHandleId(c) ) , ( TomiokaSpells___SH_SKILL_W ) , ( 0 ) , (( 3)*1.0)) // INLINED!!
        endif
    endfunction
    function TomiokaE_Start takes unit c,unit td returns nothing
        call TomiokaPass_Start(c)
        call s__TomiokaSpells___TomiokaE_KS_TomiokaE_Start(c , td)
    endfunction
