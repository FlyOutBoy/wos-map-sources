                            call AAUniversalTooltips_UpdateHeroTooltips(s__AlucardSpells__AlucardSpells_R_c[this]) // range preview/tooltip follow the new state
                            set s__AlucardSpells__AlucardSpells_R_r[this]=0
                            set s__AlucardSpells__AlucardSpells_R_rmax[this]=AlucardR_DurationBase + ( AlucardR_DurationStep * ( GetUnitAbilityLevel(s__AlucardSpells__AlucardSpells_R_c[this], AlucardR_ID) - 1 ) ) + 0.2
                            set s__AlucardSpells__AlucardSpells_R_r5[this]=GetUnitState(s__AlucardSpells__AlucardSpells_R_c[this], UNIT_STATE_LIFE) / GetUnitState(s__AlucardSpells__AlucardSpells_R_c[this], UNIT_STATE_MAX_LIFE)
                           // call BlzSetUnitRealField(c, UNIT_RF_HIT_POINTS_REGENERATION_RATE, BlzGetUnitRealField(c, UNIT_RF_HIT_POINTS_REGENERATION_RATE) + (AlucardR_HpRegenAddBase + (AlucardR_HpRegenAddStep * (GetUnitAbilityLevel(c, AlucardR_ID) - 1))))
                          //  call BlzSetUnitMaxHP(c, BlzGetUnitMaxHP(c) + (AlucardR_HpAddBase + AlucardR_HpAddStep * (GetUnitAbilityLevel(c, AlucardR_ID) - 1)))
                          //  call UnitAddAbility(c,AlucardR_Stat_AS_ID)
                           // call UnitMakeAbilityPermanent(c,true,AlucardR_Stat_AS_ID)
                            //call UnitAddAbility(c,AlucardR_Stat_MS_ID)
                            //call UnitMakeAbilityPermanent(c,true,AlucardR_Stat_MS_ID)
                          //  call SetUnitState(c, UNIT_STATE_LIFE, GetUnitState(c, UNIT_STATE_MAX_LIFE) * r5)
                            call BlzSetAbilityIcon(AlucardQ_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Alucard_RQ.blp")
                            //call SetPlayerAbilityAvailable(GetOwningPlayer(c), AlucardW_ID, false)
                            call UnitAddAbility(s__AlucardSpells__AlucardSpells_R_c[this], AlucardW2_ID)
                            call SetUnitAbilityLevel(s__AlucardSpells__AlucardSpells_R_c[this], AlucardW2_ID, GetUnitAbilityLevel(s__AlucardSpells__AlucardSpells_R_c[this], AlucardR_ID))
                            //call BlzStartUnitAbilityCooldown(c, AlucardW2_ID, BlzGetUnitAbilityCooldownRemaining(c, AlucardW_ID))
                            call BlzSetAbilityIcon(AlucardE_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Alucard_RE.blp")
                            call SetPlayerAbilityAvailable(GetOwningPlayer(s__AlucardSpells__AlucardSpells_R_c[this]), AlucardR_ID, false)
                            if GetUnitAbilityLevel(s__AlucardSpells__AlucardSpells_R_c[this], AlucardT_ID) > 0 then
                            call SetPlayerAbilityAvailable(GetOwningPlayer(s__AlucardSpells__AlucardSpells_R_c[this]), AlucardT_ID, false)
                            call UnitAddAbility(s__AlucardSpells__AlucardSpells_R_c[this], AlucardT2_ID)
                            call SetUnitAbilityLevel(s__AlucardSpells__AlucardSpells_R_c[this], AlucardT2_ID, GetUnitAbilityLevel(s__AlucardSpells__AlucardSpells_R_c[this], AlucardT_ID))
                            call BlzStartUnitAbilityCooldown(s__AlucardSpells__AlucardSpells_R_c[this], AlucardT2_ID, BlzGetUnitAbilityCooldownRemaining(s__AlucardSpells__AlucardSpells_R_c[this], AlucardT_ID))
                            endif
                            call SaveInteger(hs, GetHandleId(s__AlucardSpells__AlucardSpells_R_c[this]), AlucardSpells__SH_RESET_SFX, 1)
                            set s__AlucardSpells__AlucardSpells_R_check[this]=1
                            
                        endif
                    elseif s__AlucardSpells__AlucardSpells_R_check[this] == 1 then
                        
                        if s__AlucardSpells__AlucardSpells_R_rmax[this] - s__AlucardSpells__AlucardSpells_R_r[this] >= 0 then
                            call WOSUI___WUI_TestHeroProgress((s__AlucardSpells__AlucardSpells_R_c[this] ) , ( AlucardR_ID ) , ( "Limit Release [Level 1]" ) , (( s__AlucardSpells__AlucardSpells_R_rmax[this] - s__AlucardSpells__AlucardSpells_R_r[this] )*1.0) , (( s__AlucardSpells__AlucardSpells_R_rmax[this] )*1.0) , ( true) , "") // INLINED!!
                        endif
                    endif
                else
                    if s__AlucardSpells__AlucardSpells_R_check[this] == 0 then
                        call StopSpellUnit2(s__AlucardSpells__AlucardSpells_R_c[this])
                    endif
                                    call WOSUI___WUI_TestHeroProgress((s__AlucardSpells__AlucardSpells_R_c[this] ) , ( AlucardR_ID ) , ( "Limit Release [Level 1]" ) , (( 0.00 )*1.0) , (( 0.00 )*1.0) , ( true) , "") // INLINED!!
                                call SaveInteger(hs, GetHandleId(GetOwningPlayer(s__AlucardSpells__AlucardSpells_R_c[this])), SH_Alucard_ALUCARDQ_ID, 0)
            
                  //  call BlzSetUnitRealField(c, UNIT_RF_HIT_POINTS_REGENERATION_RATE, BlzGetUnitRealField(c, UNIT_RF_HIT_POINTS_REGENERATION_RATE) -( AlucardR_HpRegenAddBase + (AlucardR_HpRegenAddStep * (GetUnitAbilityLevel(c, AlucardR_ID) - 1))))
