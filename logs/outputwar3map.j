    function TsunaSpells___TsunaTick10_On takes integer k returns nothing
        if not TsunaSpells___TsunaTick10_Active[k] then
            set TsunaSpells___TsunaTick10_Active[k]=true
            set TsunaSpells___TsunaTick10_Users=TsunaSpells___TsunaTick10_Users + 1
            if TsunaSpells___TsunaTick10_Users == 1 then
                call TimerStart(TsunaSpells___TsunaTick10_Timer, 0.1, true, TsunaSpells___TsunaTick10_Callback)
            endif
        endif
    endfunction

    function TsunaSpells___TsunaTick10_Off takes integer k returns nothing
        if TsunaSpells___TsunaTick10_Active[k] then
            set TsunaSpells___TsunaTick10_Active[k]=false
            set TsunaSpells___TsunaTick10_Users=TsunaSpells___TsunaTick10_Users - 1
            if TsunaSpells___TsunaTick10_Users <= 0 then
                set TsunaSpells___TsunaTick10_Users=0
                call PauseTimer(TsunaSpells___TsunaTick10_Timer)
            endif
        endif
    endfunction


