//library RaidenSpells:

    function RaidenSpells___RaidenTick05_On takes integer k returns nothing
        if not RaidenSpells___RaidenTick05_Active[k] then
            set RaidenSpells___RaidenTick05_Active[k]=true
            set RaidenSpells___RaidenTick05_Users=RaidenSpells___RaidenTick05_Users + 1
            if RaidenSpells___RaidenTick05_Users == 1 then
                call TimerStart(RaidenSpells___RaidenTick05_Timer, 0.05, true, RaidenSpells___RaidenTick05_Callback)
            endif
        endif
    endfunction

    function RaidenSpells___RaidenTick05_Off takes integer k returns nothing
        if RaidenSpells___RaidenTick05_Active[k] then
            set RaidenSpells___RaidenTick05_Active[k]=false
            set RaidenSpells___RaidenTick05_Users=RaidenSpells___RaidenTick05_Users - 1
            if RaidenSpells___RaidenTick05_Users <= 0 then
                set RaidenSpells___RaidenTick05_Users=0
                call PauseTimer(RaidenSpells___RaidenTick05_Timer)
            endif
        endif
    endfunction


    function RaidenSpells___RaidenTick_On takes integer k returns nothing
        if not RaidenSpells___RaidenTick_Active[k] then
            set RaidenSpells___RaidenTick_Active[k]=true
            set RaidenSpells___RaidenTick_Users=RaidenSpells___RaidenTick_Users + 1
            if RaidenSpells___RaidenTick_Users == 1 then
                call TimerStart(RaidenSpells___RaidenTick_Timer, 0.03, true, RaidenSpells___RaidenTick_Callback)
            endif
        endif
    endfunction

    function RaidenSpells___RaidenTick_Off takes integer k returns nothing
        if RaidenSpells___RaidenTick_Active[k] then
            set RaidenSpells___RaidenTick_Active[k]=false
            set RaidenSpells___RaidenTick_Users=RaidenSpells___RaidenTick_Users - 1
            if RaidenSpells___RaidenTick_Users <= 0 then
                set RaidenSpells___RaidenTick_Users=0
                call PauseTimer(RaidenSpells___RaidenTick_Timer)
            endif
        endif
    endfunction


    function RaidenAtk_Start takes unit c,unit td returns nothing
        local real x= GetUnitX(td)
        local real y= GetUnitY(td)
        local real a= GetRandomReal(0, 359)
        local integer atk_trigger= RaidenG_CountAtkToTrigger
        local boolean b= LoadInteger(hs, GetHandleId(c), RaidenSpells___SH_Q_ABI) > 0
        local integer lvl= 1
        local real dmg= GetHeroAgi(c, true) * RaidenG_AgiDMG
        local integer atk= LoadInteger(hs, GetHandleId(c), RaidenSpells___SH_ATK_COUNT) + 1

        if GetHeroLevel(c) >= 35 then
            set lvl=4
        elseif GetHeroLevel(c) >= 25 then
            set lvl=3
        elseif GetHeroLevel(c) >= 12 then
            set lvl=2
        endif

        if LoadInteger(hs, GetHandleId(c), RaidenSpells___SH_RAIDEN_W_ATK) == 1 then
            set atk_trigger=2
        endif

        if atk >= atk_trigger then
            if Raiden_F_Dummy == null then
                set Raiden_F_Dummy=CreateUnit(GetOwningPlayer(c), Raiden_FDummy_ID, GetRectCenterX(gg_rct_Caster), GetRectCenterY(gg_rct_Caster), 1)
            endif
            if not b then
