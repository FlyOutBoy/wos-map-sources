    function ErzaTSpells__ErzaTTick05_On takes integer k returns nothing
        if not ErzaTSpells__ErzaTTick05_Active[k] then
            set ErzaTSpells__ErzaTTick05_Active[k]=true
            set ErzaTSpells__ErzaTTick05_Users=ErzaTSpells__ErzaTTick05_Users + 1
            if ErzaTSpells__ErzaTTick05_Users == 1 then
                call TimerStart(ErzaTSpells__ErzaTTick05_Timer, 0.05, true, ErzaTSpells__ErzaTTick05_Callback)
            endif
        endif
    endfunction

    function ErzaTSpells__ErzaTTick05_Off takes integer k returns nothing
        if ErzaTSpells__ErzaTTick05_Active[k] then
            set ErzaTSpells__ErzaTTick05_Active[k]=false
            set ErzaTSpells__ErzaTTick05_Users=ErzaTSpells__ErzaTTick05_Users - 1
            if ErzaTSpells__ErzaTTick05_Users <= 0 then
                set ErzaTSpells__ErzaTTick05_Users=0
                call PauseTimer(ErzaTSpells__ErzaTTick05_Timer)
            endif
        endif
    endfunction


    function ErzaTSpells__ErzaTTick_On takes integer k returns nothing
        if not ErzaTSpells__ErzaTTick_Active[k] then
            set ErzaTSpells__ErzaTTick_Active[k]=true
