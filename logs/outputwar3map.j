                        endif

                        set s__MilimSpells___MilimT2KS_x1[this]=s__MilimSpells___MilimT2KS_x[this] + ( 150.00 + s__MilimSpells___MilimT2KS_beamFxMove[this] ) * Cos(s__MilimSpells___MilimT2KS_a[this])
                        set s__MilimSpells___MilimT2KS_y1[this]=s__MilimSpells___MilimT2KS_y[this] + ( 150.00 + s__MilimSpells___MilimT2KS_beamFxMove[this] ) * Sin(s__MilimSpells___MilimT2KS_a[this])
                       
                        call ColorEffDummy3Alpha((EffectSpawnColor("war3mapimported\\wos_ulqashar.mdx" , s__MilimSpells___MilimT2KS_x1[this] , s__MilimSpells___MilimT2KS_y1[this] , s__MilimSpells___MilimT2KS_a[this] * bj_RADTODEG , 1.00 , s__MilimSpells___MilimT2KS_beamFxScale[this] , 180.00 + s__MilimSpells___MilimT2KS_r[this] * 80.00 , 25 , 125 , 255 , 65) ) , (( beamEffectLife )*1.0) , ( 25 ) , ( 125 ) , ( 255 ) , 255 , (( 0.3)*1.0)) // INLINED!!
                      //  call EffectSpawnColor2("war3mapimported\\wos_ulqashar.mdx", x1, y1, a * bj_RADTODEG, 1.00, beamFxScale * 0.70, 180.00 + r * 80.00, beamEffectLife, 225, 225, 225, 205)
                        set s__MilimSpells___MilimT2KS_beamFxScale[this]=s__MilimSpells___MilimT2KS_beamFxScale[this] + 0.005
