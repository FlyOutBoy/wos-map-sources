    set gg_trg_LvlUpCheck=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_LvlUpCheck, EVENT_PLAYER_HERO_LEVEL)
    call TriggerAddAction(gg_trg_LvlUpCheck, function Trig_LvlUpCheck_Actions)
endfunction


