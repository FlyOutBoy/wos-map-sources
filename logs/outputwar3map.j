                call BlzFrameClearAllPoints(s__GearSystems2___KS_BuffTimer_frame0_pas2[s__GearSystems2___KS_BuffTimer_k2[this]])
                call BlzFrameClearAllPoints(s__GearSystems2___KS_BuffTimer_frame0_pas3[s__GearSystems2___KS_BuffTimer_k2[this]])
                call BlzFrameSetAllPoints(s__GearSystems2___KS_BuffTimer_frame0_pas2[s__GearSystems2___KS_BuffTimer_k2[this]], s__GearSystems2___KS_BuffTimer_frame0_pas1[s__GearSystems2___KS_BuffTimer_k2[this]])
                call BlzFrameSetAllPoints(s__GearSystems2___KS_BuffTimer_frame0_pas3[s__GearSystems2___KS_BuffTimer_k2[this]], s__GearSystems2___KS_BuffTimer_frame0_pas1[s__GearSystems2___KS_BuffTimer_k2[this]])
                call BlzFrameSetSize(s__GearSystems2___KS_BuffTimer_frame0_pas1[s__GearSystems2___KS_BuffTimer_k2[this]], 0.0264, 0.0264)
                call WUI_SimpleBorder(s__GearSystems2___KS_BuffTimer_frame0_pas1[s__GearSystems2___KS_BuffTimer_k2[this]])
                set s__GearSystems2___KS_BuffTimer_frame0_pas4[s__GearSystems2___KS_BuffTimer_k2[this]]=BlzCreateFrameByType("TEXT", "MyPlayerName", (null), "", 0) // INLINED!!
                //call BlzFrameSetPoint(frame0_pas4[k2], FRAMEPOINT_TOP, frame0_pas1[k2], FRAMEPOINT_BOTTOM, 0, -0.005)
                //call BlzFrameSetPoint(frame0_pas4[k2], FRAMEPOINT_BOTTOMLEFT,frame0_pas1[k2],FRAMEPOINT_BOTTOMLEFT, tmp_x-0.0265, tmp_y-0.335)
                
                call BlzFrameSetScale(s__GearSystems2___KS_BuffTimer_frame0_pas4[s__GearSystems2___KS_BuffTimer_k2[this]], 0.66)
                call BlzFrameSetSize(s__GearSystems2___KS_BuffTimer_frame0_pas4[s__GearSystems2___KS_BuffTimer_k2[this]], 0.025, 0.010)
                call BlzFrameSetTextAlignment(s__GearSystems2___KS_BuffTimer_frame0_pas4[s__GearSystems2___KS_BuffTimer_k2[this]], TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
                 call BlzFrameSetVisible(s__GearSystems2___KS_BuffTimer_frame0_pas4[s__GearSystems2___KS_BuffTimer_k2[this]], false)
                if GetLocalPlayer() == Player(s__GearSystems2___KS_BuffTimer_k[this]) then
                    call BlzFrameSetVisible(s__GearSystems2___KS_BuffTimer_frame0_pas4[s__GearSystems2___KS_BuffTimer_k2[this]], true)
                    endif
                else
                 if GetLocalPlayer() == Player(s__GearSystems2___KS_BuffTimer_k[this]) then
                    call BlzFrameSetVisible(s__GearSystems2___KS_BuffTimer_frame0_pas1[s__GearSystems2___KS_BuffTimer_k2[this]], true)
                    call BlzFrameSetVisible(s__GearSystems2___KS_BuffTimer_frame0_pas4[s__GearSystems2___KS_BuffTimer_k2[this]], true)
                    endif
                endif
                call WUI_FrameSetMinMaxValue(s__GearSystems2___KS_BuffTimer_frame0_pas3[s__GearSystems2___KS_BuffTimer_k2[this]] , 0 , s__GearSystems2___KS_BuffTimer_rmax[this])
                call WUI_FrameSetValue(s__GearSystems2___KS_BuffTimer_frame0_pas2[s__GearSystems2___KS_BuffTimer_k2[this]] , 100)
                call WUI_FrameSetValue(s__GearSystems2___KS_BuffTimer_frame0_pas3[s__GearSystems2___KS_BuffTimer_k2[this]] , 0)
                call BlzFrameSetText(s__GearSystems2___KS_BuffTimer_frame0_pas4[s__GearSystems2___KS_BuffTimer_k2[this]], R2SW(s__GearSystems2___KS_BuffTimer_rmax[this], 0, 1))
                call BlzFrameSetTexture(s__GearSystems2___KS_BuffTimer_frame0_pas2[s__GearSystems2___KS_BuffTimer_k2[this]], "ReplaceableTextures\\CommandButtons\\" + s__GearSystems2___KS_BuffTimer_s[this] + ".blp", 0, false)
                call BlzFrameSetTexture(s__GearSystems2___KS_BuffTimer_frame0_pas3[s__GearSystems2___KS_BuffTimer_k2[this]], "ReplaceableTextures\\CommandButtonsDisabled\\DIS" + s__GearSystems2___KS_BuffTimer_s[this] + ".blp", 0, false)
                
                    call BlzFrameSetEnable(s__GearSystems2___KS_BuffTimer_frame0_pas1[s__GearSystems2___KS_BuffTimer_k2[this]], false)
                    call BlzFrameSetEnable(s__GearSystems2___KS_BuffTimer_frame0_pas2[s__GearSystems2___KS_BuffTimer_k2[this]], false)
                    call BlzFrameSetEnable(s__GearSystems2___KS_BuffTimer_frame0_pas3[s__GearSystems2___KS_BuffTimer_k2[this]], false)
                    call BlzFrameSetEnable(s__GearSystems2___KS_BuffTimer_frame0_pas4[s__GearSystems2___KS_BuffTimer_k2[this]], false)
                // A restarted slot is already registered and placed; the 0.10 s
                // dock tick handles the rest, so only a new icon relayouts at once.
                if not reused then
                    call WUI_RegisterBuff(s__GearSystems2___KS_BuffTimer_frame0_pas1[s__GearSystems2___KS_BuffTimer_k2[this]] , s__GearSystems2___KS_BuffTimer_frame0_pas4[s__GearSystems2___KS_BuffTimer_k2[this]] , s__GearSystems2___KS_BuffTimer_k[this] , "GearBuff:" + I2S(s__GearSystems2___KS_BuffTimer_k2[this]))
                    call WUI_RefreshDocks()
