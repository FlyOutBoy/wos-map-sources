function InitTrig_ARUP takes nothing returns nothing
local integer i= 0
local trigger trg2= CreateTrigger()
    loop
    exitwhen i == 12
    call TriggerRegisterPlayerEvent(trg2, Player(i), EVENT_PLAYER_ARROW_UP_DOWN)
    set i=i + 1
    endloop
    call TriggerAddAction(trg2, function Trig_ArUP_ACT)
    set trg2=null
endfunction


