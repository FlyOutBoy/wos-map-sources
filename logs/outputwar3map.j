            return LoadInteger(hs, GetHandleId(whichUnit), RimuruSpells___SH_RIMURU_G_ORB_COUNT)
        endfunction

        function s__RimuruSpells___RimuruG_KS_Loop_RimuruG takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__RimuruSpells___RimuruG_KS_MUI_RimuruG
                set this=s__RimuruSpells___RimuruG_KS_m_RimuruG[i]
                if SpellBoolCaster(s__RimuruSpells___RimuruG_KS_c[this]) and s__RimuruSpells___RimuruG_KS_r[this] <= s__RimuruSpells___RimuruG_KS_rmax[this] then
                    // В этой структуре нет сравнений r на точное равенство.
                    // Не вызываем RoundReal для каждого шара 33 раза в секунду.
                    set s__RimuruSpells___RimuruG_KS_r[this]=s__RimuruSpells___RimuruG_KS_r[this] + 0.03
                    if s__RimuruSpells___RimuruG_KS_check[this] == 0 then
                        if s__RimuruSpells___RimuruG_KS_r[this] <= s__RimuruSpells___RimuruG_KS_r3[this] then
                            set s__RimuruSpells___RimuruG_KS_r4[this]=s__RimuruSpells___RimuruG_KS_r4[this] + s__RimuruSpells___RimuruG_KS_move[this]
                            call MoveEff(s__RimuruSpells___RimuruG_KS_e[this] , s__RimuruSpells___RimuruG_KS_move[this] , s__RimuruSpells___RimuruG_KS_a[this])
                            call BlzSetSpecialEffectHeight(s__RimuruSpells___RimuruG_KS_e[this], Parabola(s__RimuruSpells___RimuruG_KS_r5[this] , s__RimuruSpells___RimuruG_KS_sr[this] , s__RimuruSpells___RimuruG_KS_r4[this]))
                        endif
                        if s__RimuruSpells___RimuruG_KS_r[this] >= s__RimuruSpells___RimuruG_KS_r3[this] then
                            set s__RimuruSpells___RimuruG_KS_check[this]=1
                            set s__RimuruSpells___RimuruG_KS_check2[this]=0
                            set s__RimuruSpells___RimuruG_KS_r[this]=0
                        endif
                    elseif s__RimuruSpells___RimuruG_KS_check[this] == 1 then
                        // Лежащему шару достаточно проверять героя раз в 0.09 сек.
                        set s__RimuruSpells___RimuruG_KS_check2[this]=s__RimuruSpells___RimuruG_KS_check2[this] + 1
                        if s__RimuruSpells___RimuruG_KS_check2[this] >= 3 then
                            set s__RimuruSpells___RimuruG_KS_check2[this]=0
                            set s__RimuruSpells___RimuruG_KS_x[this]=GetUnitX(s__RimuruSpells___RimuruG_KS_c[this])
                            set s__RimuruSpells___RimuruG_KS_y[this]=GetUnitY(s__RimuruSpells___RimuruG_KS_c[this])
                            set s__RimuruSpells___RimuruG_KS_sr[this]=SR5(s__RimuruSpells___RimuruG_KS_e[this] , s__RimuruSpells___RimuruG_KS_x[this] , s__RimuruSpells___RimuruG_KS_y[this])
                            set s__RimuruSpells___RimuruG_KS_r6[this]=RimuruG_ConsumeRange
                            if LoadInteger(hs, GetHandleId(s__RimuruSpells___RimuruG_KS_c[this]), RimuruSpells___SH_RIMURU_EVOL_2) == 1 then
                                set s__RimuruSpells___RimuruG_KS_r6[this]=9999
                            endif
                            if s__RimuruSpells___RimuruG_KS_sr[this] < s__RimuruSpells___RimuruG_KS_r6[this] then
                                set s__RimuruSpells___RimuruG_KS_r[this]=0
                                set s__RimuruSpells___RimuruG_KS_check[this]=2
                                set s__RimuruSpells___RimuruG_KS_move[this]=30
                            endif
                        endif
                    elseif s__RimuruSpells___RimuruG_KS_check[this] == 2 then
                        set s__RimuruSpells___RimuruG_KS_x[this]=GetUnitX(s__RimuruSpells___RimuruG_KS_c[this])
                        set s__RimuruSpells___RimuruG_KS_y[this]=GetUnitY(s__RimuruSpells___RimuruG_KS_c[this])
                        set s__RimuruSpells___RimuruG_KS_a[this]=GAngle5(s__RimuruSpells___RimuruG_KS_e[this] , s__RimuruSpells___RimuruG_KS_x[this] , s__RimuruSpells___RimuruG_KS_y[this])
                        if SR5(s__RimuruSpells___RimuruG_KS_e[this] , s__RimuruSpells___RimuruG_KS_x[this] , s__RimuruSpells___RimuruG_KS_y[this]) < 50 then
                            call SetHpCurrent2Quiet(s__RimuruSpells___RimuruG_KS_c[this] , s__RimuruSpells___RimuruG_KS_c[this] , s__RimuruSpells___RimuruG_KS_dmg[this])
                            set s__RimuruSpells___RimuruG_KS_r[this]=9999
                            call BlzSetSpecialEffectPosition(s__RimuruSpells___RimuruG_KS_e[this], s__RimuruSpells___RimuruG_KS_x[this], s__RimuruSpells___RimuruG_KS_y[this], 0)
                          //  call DestroyEffect(AddSpecialEffectTarget("war3mapimported\\wos_az_lifebloom.mdx", c, "origin"))
                            call s__GearSystems2___KS_MoveEffectToUnit_MoveEffectToUnit_Start((EffectSpawn("war3mapImported\\wos_effect_lv131.mdl" , GetUnitX(s__RimuruSpells___RimuruG_KS_c[this]) , GetUnitY(s__RimuruSpells___RimuruG_KS_c[this]) , 1 , 1 , 1 , 40) ) , (( 0.6 )*1.0) , (( 40 )*1.0) , ( s__RimuruSpells___RimuruG_KS_c[this]) , 0 , 1 , null) // INLINED!!
                        else
                            call MoveEff2(s__RimuruSpells___RimuruG_KS_e[this] , s__RimuruSpells___RimuruG_KS_move[this] , s__RimuruSpells___RimuruG_KS_a[this])
                        endif
                    endif
                else
                    set s__RimuruSpells___RimuruG_KS_x[this]=(BlzGetLocalSpecialEffectX((s__RimuruSpells___RimuruG_KS_e[this]))) // INLINED!!
                    set s__RimuruSpells___RimuruG_KS_y[this]=(BlzGetLocalSpecialEffectY((s__RimuruSpells___RimuruG_KS_e[this]))) // INLINED!!
                    call EffectSpawn2("war3mapImported\\wos_Bubbles2_small.mdx" , s__RimuruSpells___RimuruG_KS_x[this] , s__RimuruSpells___RimuruG_KS_y[this] , GetRandomReal(0, 359) , 1 , 3 , 10 , 0.15)
                    call DestroyEffect(s__RimuruSpells___RimuruG_KS_e[this])
                    set s__RimuruSpells___RimuruG_KS_check2[this]=LoadInteger(hs, GetHandleId(s__RimuruSpells___RimuruG_KS_c[this]), RimuruSpells___SH_RIMURU_G_ORB_COUNT) - 1
                    if s__RimuruSpells___RimuruG_KS_check2[this] < 0 then
                        set s__RimuruSpells___RimuruG_KS_check2[this]=0
                    endif
                    call SaveInteger(hs, GetHandleId(s__RimuruSpells___RimuruG_KS_c[this]), RimuruSpells___SH_RIMURU_G_ORB_COUNT, s__RimuruSpells___RimuruG_KS_check2[this])
                    set s__RimuruSpells___RimuruG_KS_c[this]=null
                    set s__RimuruSpells___RimuruG_KS_e[this]=null
                    set s__RimuruSpells___RimuruG_KS_m_RimuruG[i]=s__RimuruSpells___RimuruG_KS_m_RimuruG[s__RimuruSpells___RimuruG_KS_MUI_RimuruG]
                    set s__RimuruSpells___RimuruG_KS_MUI_RimuruG=s__RimuruSpells___RimuruG_KS_MUI_RimuruG - 1
                    if s__RimuruSpells___RimuruG_KS_MUI_RimuruG == - 1 then
                        call RimuruSpells___RimuruTimer03Release()
