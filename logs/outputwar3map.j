        function s__AlucardSpells__AlucardTick_Loop_Loop takes nothing returns nothing
            if AlucardSpells__AlucardTick_Active[0] then
                call s__AlucardSpells__AlucardSpells_Utility_Loop_AlucardPas()
            endif
            if AlucardSpells__AlucardTick_Active[1] then
                call s__AlucardSpells__AlucardSpells_W_Loop_AlucardW2()
            endif
            if AlucardSpells__AlucardTick_Active[2] then
                call s__AlucardSpells__AlucardSpells_E_Loop_AlucardE()
            endif
            if AlucardSpells__AlucardTick_Active[3] then
                call s__AlucardSpells__AlucardSpells_T_Loop_AlucardT2()
            endif
            if AlucardSpells__AlucardTick_Active[4] then
                call s__AlucardSpells__AlucardSpells_Q_Loop_AlucardQ()
            endif
            if AlucardSpells__AlucardTick_Active[5] then
                call s__AlucardSpells__AlucardSpells_Q_Loop_AlucardQ2()
            endif
        endfunction

        function s__AlucardSpells__AlucardTick_Loop_onInit takes nothing returns nothing
            set AlucardSpells__AlucardTick_Callback=function s__AlucardSpells__AlucardTick_Loop_Loop
        endfunction


