                    call s__GearSystems2___KS_MoveEffectToUnit_MoveEffectToUnit_Start((s__AstaSpells__AstaSpells_E_e[this] ) , (( 2 )*1.0) , (( 50 )*1.0) , ( s__AstaSpells__AstaSpells_E_c[this]) , 0 , 1 , null) // INLINED!!
