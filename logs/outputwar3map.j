                call s__ItemsElementsFx_Burn(s__ItemsElementsFx_src[this] , s__ItemsElementsFx_c[this] , s__ItemsElementsFx_u[this] , Emberbreaker_Burn * (I2R(GetHeroStr((s__ItemsElementsFx_c[this]), true))) , 8 , 0.5 , true) // INLINED!!
                set m=s__ItemsElementsFx_Mark(s__ItemsElementsFx_EMBER , s__ItemsElementsFx_src[this] , s__ItemsElementsFx_c[this] , s__ItemsElementsFx_u[this] , 3.0 , "Abilities\\Spells\\Other\\Incinerate\\IncinerateBuff.mdl")
