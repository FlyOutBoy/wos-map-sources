            set s__DarkShikiSpells__DarkShikiG_KS_dmg[this]=GetHeroAgi(s__DarkShikiSpells__DarkShikiG_KS_c[this], true) * DarkShikiG_DamageAgiBase
            set s__DarkShikiSpells__DarkShikiG_KS_r2[this]=0
            set s__DarkShikiSpells__DarkShikiG_KS_aoe[this]=DarkShikiG_DamageAoe
            call StartSpellUnit(s__DarkShikiSpells__DarkShikiG_KS_c[this])
