                            call FixAura(s__StarrkSpells___StarrkSpells_E_c[this])
                            call UnitAddAbility(s__StarrkSpells___StarrkSpells_E_c[this], StarrkE_Atk_ID)
                            call SetUnitAbilityLevel(s__StarrkSpells___StarrkSpells_E_c[this], StarrkE_Atk_ID, GetUnitAbilityLevel(s__StarrkSpells___StarrkSpells_E_c[this], StarrkE_ID))
                            //call UnitAddAbility(c, StarrkE_AS_ID)
                           // call SetUnitAbilityLevel(c,StarrkE_AS_ID,GetUnitAbilityLevel(c,StarrkE_ID))
                            call SetPlayerAbilityAvailable(GetOwningPlayer(s__StarrkSpells___StarrkSpells_E_c[this]), StarrkE_ID, false)
                            if GetUnitAbilityLevel(s__StarrkSpells___StarrkSpells_E_c[this], StarrkR_ID) > 0 then
                                call UnitAddAbility(s__StarrkSpells___StarrkSpells_E_c[this], StarrkR2_ID)
                                call SetPlayerAbilityAvailable(GetOwningPlayer(s__StarrkSpells___StarrkSpells_E_c[this]), StarrkR2_ID, true)
                                call SetPlayerAbilityAvailable(GetOwningPlayer(s__StarrkSpells___StarrkSpells_E_c[this]), StarrkR_ID, false)
                                call SetUnitAbilityLevel(s__StarrkSpells___StarrkSpells_E_c[this], StarrkR2_ID, GetUnitAbilityLevel(s__StarrkSpells___StarrkSpells_E_c[this], StarrkR_ID))

                                    call BlzStartUnitAbilityCooldown(s__StarrkSpells___StarrkSpells_E_c[this], StarrkR2_ID, BlzGetUnitAbilityCooldownRemaining(s__StarrkSpells___StarrkSpells_E_c[this], StarrkR_ID))
                                if GetHeroLevel(s__StarrkSpells___StarrkSpells_E_c[this]) >= 35 then
                                call ReduceCooldown(s__StarrkSpells___StarrkSpells_E_c[this] , StarrkR2_ID , StarrkE_ReduceR_CD)
                                endif
                            endif
                            call AddSpellLevel(s__StarrkSpells___StarrkSpells_E_c[this] , 'A01C' , GetUnitAbilityLevel(s__StarrkSpells___StarrkSpells_E_c[this], StarrkE_ID) * 2 , true)
                            call BlzSetUnitWeaponIntegerField(s__StarrkSpells___StarrkSpells_E_c[this], UNIT_WEAPON_IF_ATTACK_ATTACK_TYPE, 0, 4) // 4 - mag, 5 - chaos, 6 - hero
                            call SetPlayerAbilityAvailable(GetOwningPlayer(s__StarrkSpells___StarrkSpells_E_c[this]), StarrkE2_ID, true)
                            call UnitAddAbility(s__StarrkSpells___StarrkSpells_E_c[this], StarrkE2_ID)
                            call SetUnitAbilityLevel(s__StarrkSpells___StarrkSpells_E_c[this], StarrkE2_ID, GetUnitAbilityLevel(s__StarrkSpells___StarrkSpells_E_c[this], StarrkE_ID))
                            call UnitMakeAbilityPermanent(s__StarrkSpells___StarrkSpells_E_c[this], true, StarrkE_Atk_ID)
                           // call UnitMakeAbilityPermanent(c, true, StarrkE_AS_ID)
                            call SaveInteger(hs, GetHandleId(GetOwningPlayer(s__StarrkSpells___StarrkSpells_E_c[this])), StarrkSpells___SH_MORPH_E, 1)
                            call AAUniversalTooltips_UpdateHeroTooltips(s__StarrkSpells___StarrkSpells_E_c[this]) // range preview/tooltip follow the new state
                            set s__StarrkSpells___StarrkSpells_E_r[this]=0
                            if GetHeroLevel(s__StarrkSpells___StarrkSpells_E_c[this]) >= 35 then
                                call AddHpRegen(s__StarrkSpells___StarrkSpells_E_c[this] , 20 , true)
                            endif
                            set s__StarrkSpells___StarrkSpells_E_rmax[this]=StarrkE_DurationBase + ( StarrkE_DurationStep * ( GetUnitAbilityLevel(s__StarrkSpells___StarrkSpells_E_c[this], StarrkE_ID) - 1 ) ) + 0.2
                            set s__StarrkSpells___StarrkSpells_E_d[this]=CreateUnit(Player(s__StarrkSpells___StarrkSpells_E_k2[this]), StarrkE_IdDummy, 1, 1, 1)
                            set s__StarrkSpells___StarrkSpells_E_r2[this]=9999
