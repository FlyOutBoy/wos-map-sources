    // ================= Anime items (2026-10-27 / 10-28): effects, casts, hooks =================

    // Enemy debuff: a curse copy cast by a far dummy of the caster's owner (range 99999).
    function ItemsAnime_Curse takes unit c,unit u,integer abil returns nothing
        local unit d= CreateUnit(GetOwningPlayer(c), 'h0C9', GetRectCenterX(gg_rct_Caster), GetRectCenterY(gg_rct_Caster), 0)
        call UnitAddAbility(d, abil)
        call IssueTargetOrder(d, "curse", u)
        call s__GearSystems2___KS_RemoveUnit_MyRemoveUnit_Start((d ) , (( 0.5)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
        set d=null
    endfunction

    function ItemsSpells__IsFairyTailHero takes unit u returns boolean
        local integer id= GetUnitTypeId(u)
        return id == Natsu_ID or id == Erza_ID or id == Laxus_ID
    endfunction

    // HP restoration bonus of Fairy Tail Emblem Evolved (added to GetHealAmp).
    function ItemsAnime_HealAmp takes unit u returns real
        if HasCachedItem(u , FairyTailEvolved_ID) > 0 and ItemsSpells__IsFairyTailHero(u) then
            return FairyTailEvolved_HeroHealAmp / 100.0
        endif
        return 0.0
    endfunction


        function s__ItemsSpells__ItemsAnimeEffect_Find takes integer kind,unit u returns integer
            local integer i= 0
            loop
                exitwhen i >= s__ItemsSpells__ItemsAnimeEffect_count
                if s__ItemsSpells__ItemsAnimeEffect_kind[s__ItemsSpells__ItemsAnimeEffect_list[i]] == kind and s__ItemsSpells__ItemsAnimeEffect_u[s__ItemsSpells__ItemsAnimeEffect_list[i]] == u then
                    return s__ItemsSpells__ItemsAnimeEffect_list[i]
                endif
                set i=i + 1
            endloop
            return 0
        endfunction

        function s__ItemsSpells__ItemsAnimeEffect_Finish takes integer this,integer index returns nothing
            if s__ItemsSpells__ItemsAnimeEffect_kind[this] == s__ItemsSpells__ItemsAnimeEffect_KIND_SPEAR then
                call SaveReal(hs, GetHandleId(s__ItemsSpells__ItemsAnimeEffect_u[this]), SH_INVERTED_SPEAR_END, 0.0)
                call UnitRemoveAbility(s__ItemsSpells__ItemsAnimeEffect_u[this], InvertedSpear_Buff_ID)
            elseif s__ItemsSpells__ItemsAnimeEffect_kind[this] == s__ItemsSpells__ItemsAnimeEffect_KIND_SUKUNA then
                call UnitRemoveAbility(s__ItemsSpells__ItemsAnimeEffect_u[this], SukunaFinger_Buff_ID)
            elseif s__ItemsSpells__ItemsAnimeEffect_kind[this] == s__ItemsSpells__ItemsAnimeEffect_KIND_SEAL then
                call UnitRemoveAbility(s__ItemsSpells__ItemsAnimeEffect_u[this], FiveElementsSeal_Buff_ID)
                call UnitRemoveAbility(s__ItemsSpells__ItemsAnimeEffect_u[this], FiveElementsSeal_LockBuff_ID)
            elseif s__ItemsSpells__ItemsAnimeEffect_kind[this] == s__ItemsSpells__ItemsAnimeEffect_KIND_COFFIN then
                call UnitRemoveAbility(s__ItemsSpells__ItemsAnimeEffect_u[this], 'Avul')
                call UnitRemoveAbility(s__ItemsSpells__ItemsAnimeEffect_u[this], IceCoffin_Buff_ID)
                if s__ItemsSpells__ItemsAnimeEffect_armed[this] then
                    set s__ItemsSpells__ItemsAnimeEffect_armed[this]=false
                    call GearStopSpellPause(s__ItemsSpells__ItemsAnimeEffect_u[this] , true)
                endif
                call IssueImmediateOrder(s__ItemsSpells__ItemsAnimeEffect_u[this], "stop")
            elseif s__ItemsSpells__ItemsAnimeEffect_kind[this] == s__ItemsSpells__ItemsAnimeEffect_KIND_WILL then
                if LoadReal(hs, GetHandleId(s__ItemsSpells__ItemsAnimeEffect_u[this]), SH_WILL_OF_D_END) == s__ItemsSpells__ItemsAnimeEffect_returnAt[this] then
                    call SaveReal(hs, GetHandleId(s__ItemsSpells__ItemsAnimeEffect_u[this]), SH_WILL_OF_D_END, 0.0)
                endif
                call UnitRemoveAbility(s__ItemsSpells__ItemsAnimeEffect_u[this], WillOfD_Buff_ID)
            elseif s__ItemsSpells__ItemsAnimeEffect_kind[this] == s__ItemsSpells__ItemsAnimeEffect_KIND_RETURN then
                call UnitRemoveAbility(s__ItemsSpells__ItemsAnimeEffect_u[this], ReturnByDeath_Buff_ID)
            endif
            if s__ItemsSpells__ItemsAnimeEffect_e[this] != null then
                call DestroyEffect(s__ItemsSpells__ItemsAnimeEffect_e[this])
            endif
            if s__ItemsSpells__ItemsAnimeEffect_e2[this] != null then
                call DestroyEffect(s__ItemsSpells__ItemsAnimeEffect_e2[this])
            endif
            set s__ItemsSpells__ItemsAnimeEffect_e[this]=null
            set s__ItemsSpells__ItemsAnimeEffect_e2[this]=null
            set s__ItemsSpells__ItemsAnimeEffect_c[this]=null
            set s__ItemsSpells__ItemsAnimeEffect_u[this]=null
            set s__ItemsSpells__ItemsAnimeEffect_count=s__ItemsSpells__ItemsAnimeEffect_count - 1
            set s__ItemsSpells__ItemsAnimeEffect_list[index]=s__ItemsSpells__ItemsAnimeEffect_list[s__ItemsSpells__ItemsAnimeEffect_count]
            if s__ItemsSpells__ItemsAnimeEffect_count == 0 then
                call PauseTimer(s__ItemsSpells__ItemsAnimeEffect_clock)
            endif
            call s__ItemsSpells__ItemsAnimeEffect_deallocate(this)
        endfunction

        function s__ItemsSpells__ItemsAnimeEffect_Tick takes nothing returns nothing
            local integer i= s__ItemsSpells__ItemsAnimeEffect_count - 1
            local integer this
            loop
                exitwhen i < 0
                set this=s__ItemsSpells__ItemsAnimeEffect_list[i]
                set s__ItemsSpells__ItemsAnimeEffect_left[this]=s__ItemsSpells__ItemsAnimeEffect_left[this] - 0.10
                set s__ItemsSpells__ItemsAnimeEffect_step[this]=s__ItemsSpells__ItemsAnimeEffect_step[this] + 0.10
                if GetUnitTypeId(s__ItemsSpells__ItemsAnimeEffect_u[this]) == 0 or IsUnitType(s__ItemsSpells__ItemsAnimeEffect_u[this], UNIT_TYPE_DEAD) then
                    call s__ItemsSpells__ItemsAnimeEffect_Finish(this,i)
                elseif s__ItemsSpells__ItemsAnimeEffect_kind[this] == s__ItemsSpells__ItemsAnimeEffect_KIND_WILL then
                    if TimerGetElapsed(HealRegenClock) >= s__ItemsSpells__ItemsAnimeEffect_returnAt[this] or LoadReal(hs, GetHandleId(s__ItemsSpells__ItemsAnimeEffect_u[this]), SH_WILL_OF_D_END) != s__ItemsSpells__ItemsAnimeEffect_returnAt[this] or ( s__ItemsSpells__ItemsAnimeEffect_step[this] >= 0.20 and GetUnitAbilityLevel(s__ItemsSpells__ItemsAnimeEffect_u[this], WillOfD_Buff_ID) == 0 ) then
                        call s__ItemsSpells__ItemsAnimeEffect_Finish(this,i)
                    endif
                elseif s__ItemsSpells__ItemsAnimeEffect_kind[this] == s__ItemsSpells__ItemsAnimeEffect_KIND_SPEAR then
                    if TimerGetElapsed(HealRegenClock) >= s__ItemsSpells__ItemsAnimeEffect_returnAt[this] then
                        call s__ItemsSpells__ItemsAnimeEffect_Finish(this,i)
                    elseif GetUnitAbilityLevel(s__ItemsSpells__ItemsAnimeEffect_u[this], InvertedSpear_Buff_ID) == 0 then
                        call ItemsAnime_Curse(s__ItemsSpells__ItemsAnimeEffect_c[this] , s__ItemsSpells__ItemsAnimeEffect_u[this] , InvertedSpear_Curse_ID)
                    endif
                elseif s__ItemsSpells__ItemsAnimeEffect_kind[this] == s__ItemsSpells__ItemsAnimeEffect_KIND_SUKUNA then
                    if s__ItemsSpells__ItemsAnimeEffect_left[this] <= 0.0 then
                        call s__ItemsSpells__ItemsAnimeEffect_Finish(this,i)
                    else
                        // Not in DebuffClear; a dispel (e.g. Bunshin Scroll) only hides it until the next tick.
                        if GetUnitAbilityLevel(s__ItemsSpells__ItemsAnimeEffect_u[this], SukunaFinger_Buff_ID) == 0 then
                            call ItemsAnime_Curse(s__ItemsSpells__ItemsAnimeEffect_c[this] , s__ItemsSpells__ItemsAnimeEffect_u[this] , SukunaFinger_Curse_ID)
                        endif
                        if s__ItemsSpells__ItemsAnimeEffect_step[this] >= 0.95 then
                            set s__ItemsSpells__ItemsAnimeEffect_step[this]=0.0
                            call SlowUnit(s__ItemsSpells__ItemsAnimeEffect_c[this] , s__ItemsSpells__ItemsAnimeEffect_u[this] , SukunaFinger_Slow , 1)
                        endif
                    endif
                elseif s__ItemsSpells__ItemsAnimeEffect_kind[this] == s__ItemsSpells__ItemsAnimeEffect_KIND_SEAL then
                    if s__ItemsSpells__ItemsAnimeEffect_left[this] <= 0.0 then
                        call s__ItemsSpells__ItemsAnimeEffect_Finish(this,i)
                    else
                        // The mana seal cannot be dispelled: a dispel only hides it until this tick.
                        if GetUnitAbilityLevel(s__ItemsSpells__ItemsAnimeEffect_u[this], FiveElementsSeal_Buff_ID) == 0 then
                            call ItemsAnime_Curse(s__ItemsSpells__ItemsAnimeEffect_c[this] , s__ItemsSpells__ItemsAnimeEffect_u[this] , FiveElementsSeal_Curse_ID)
                        endif
                        if s__ItemsSpells__ItemsAnimeEffect_armed[this] and s__ItemsSpells__ItemsAnimeEffect_step[this] >= 0.3 and GetUnitAbilityLevel(s__ItemsSpells__ItemsAnimeEffect_u[this], FiveElementsSeal_LockBuff_ID) == 0 then
                            // The lock was removed: it snaps shut once.
                            set s__ItemsSpells__ItemsAnimeEffect_armed[this]=false
                            call SilenceUnit(s__ItemsSpells__ItemsAnimeEffect_c[this] , s__ItemsSpells__ItemsAnimeEffect_u[this] , FiveElementsSeal_Silence)
                        endif
                    endif
                elseif s__ItemsSpells__ItemsAnimeEffect_kind[this] == s__ItemsSpells__ItemsAnimeEffect_KIND_COFFIN then
                    if s__ItemsSpells__ItemsAnimeEffect_left[this] > 0.0 and GetUnitAbilityLevel(s__ItemsSpells__ItemsAnimeEffect_u[this], 'Avul') == 0 then
                        call UnitAddAbility(s__ItemsSpells__ItemsAnimeEffect_u[this], 'Avul') // a spell ending its own pause may have taken it
                    endif
                    if s__ItemsSpells__ItemsAnimeEffect_left[this] <= 0.0 or s__ItemsSpells__ItemsAnimeEffect_round[this] != CurrentRound then
                        call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl", GetUnitX(s__ItemsSpells__ItemsAnimeEffect_u[this]), GetUnitY(s__ItemsSpells__ItemsAnimeEffect_u[this])))
                        call s__ItemsSpells__ItemsAnimeEffect_Finish(this,i)
                    endif
                elseif s__ItemsSpells__ItemsAnimeEffect_kind[this] == s__ItemsSpells__ItemsAnimeEffect_KIND_RETURN then
                    // A positive-buff dispel permanently cancels this pending return.
                    if s__ItemsSpells__ItemsAnimeEffect_round[this] != CurrentRound or GetUnitAbilityLevel(s__ItemsSpells__ItemsAnimeEffect_u[this], ReturnByDeath_Buff_ID) == 0 then
                        call s__ItemsSpells__ItemsAnimeEffect_Finish(this,i)
                    elseif TimerGetElapsed(HealRegenClock) >= s__ItemsSpells__ItemsAnimeEffect_returnAt[this] then
                        call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl", GetUnitX(s__ItemsSpells__ItemsAnimeEffect_u[this]), GetUnitY(s__ItemsSpells__ItemsAnimeEffect_u[this])))
                        call PosUnit(s__ItemsSpells__ItemsAnimeEffect_u[this] , s__ItemsSpells__ItemsAnimeEffect_x[this] , s__ItemsSpells__ItemsAnimeEffect_y[this])
                        call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl", s__ItemsSpells__ItemsAnimeEffect_x[this], s__ItemsSpells__ItemsAnimeEffect_y[this]))
                        call MakeSound("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget")
                        call s__ItemsSpells__ItemsAnimeEffect_Finish(this,i)
                    endif
                endif
                set i=i - 1
            endloop
        endfunction

        function s__ItemsSpells__ItemsAnimeEffect_Add takes integer kind,unit c,unit u,real duration returns integer
            local integer this= s__ItemsSpells__ItemsAnimeEffect__allocate()
            set s__ItemsSpells__ItemsAnimeEffect_kind[this]=kind
            set s__ItemsSpells__ItemsAnimeEffect_c[this]=c
            set s__ItemsSpells__ItemsAnimeEffect_u[this]=u
            set s__ItemsSpells__ItemsAnimeEffect_left[this]=duration
            set s__ItemsSpells__ItemsAnimeEffect_step[this]=0.0
            set s__ItemsSpells__ItemsAnimeEffect_e[this]=null
            set s__ItemsSpells__ItemsAnimeEffect_e2[this]=null
            set s__ItemsSpells__ItemsAnimeEffect_armed[this]=false
            set s__ItemsSpells__ItemsAnimeEffect_list[s__ItemsSpells__ItemsAnimeEffect_count]=this
            set s__ItemsSpells__ItemsAnimeEffect_count=s__ItemsSpells__ItemsAnimeEffect_count + 1
            if s__ItemsSpells__ItemsAnimeEffect_count == 1 then
                call TimerStart(s__ItemsSpells__ItemsAnimeEffect_clock, 0.10, true, function s__ItemsSpells__ItemsAnimeEffect_Tick)
            endif
            return this
        endfunction

        // Seal: a hero ability cast while the lock is on silences once; the mana seal stays.
        function s__ItemsSpells__ItemsAnimeEffect_OnHeroCast takes unit u returns nothing
            local integer i= 0
            loop
                exitwhen i >= s__ItemsSpells__ItemsAnimeEffect_count
                if s__ItemsSpells__ItemsAnimeEffect_kind[s__ItemsSpells__ItemsAnimeEffect_list[i]] == s__ItemsSpells__ItemsAnimeEffect_KIND_SEAL and s__ItemsSpells__ItemsAnimeEffect_u[s__ItemsSpells__ItemsAnimeEffect_list[i]] == u and s__ItemsSpells__ItemsAnimeEffect_armed[s__ItemsSpells__ItemsAnimeEffect_list[i]] then
                    set s__ItemsSpells__ItemsAnimeEffect_armed[s__ItemsSpells__ItemsAnimeEffect_list[i]]=false
                    call UnitRemoveAbility(u, FiveElementsSeal_LockBuff_ID)
                    call SilenceUnit(s__ItemsSpells__ItemsAnimeEffect_c[s__ItemsSpells__ItemsAnimeEffect_list[i]] , u , FiveElementsSeal_Silence)
                    return
                endif
                set i=i + 1
            endloop
        endfunction

    function ItemsSpells__SukunaStart takes unit c,unit td returns nothing
        local integer fx
        if td == null or not SpellBool(td) or not IsUnitEnemy(td, GetOwningPlayer(c)) or DebuffImmune_Start(td , 1) == 0 then
            return
        endif
        set fx=s__ItemsSpells__ItemsAnimeEffect_Find(s__ItemsSpells__ItemsAnimeEffect_KIND_SUKUNA , td)
        if fx == 0 then
            set fx=s__ItemsSpells__ItemsAnimeEffect_Add(s__ItemsSpells__ItemsAnimeEffect_KIND_SUKUNA , c , td , SukunaFinger_Duration)
        else
            set s__ItemsSpells__ItemsAnimeEffect_c[fx]=c
            set s__ItemsSpells__ItemsAnimeEffect_left[fx]=SukunaFinger_Duration
        endif
        call ItemsAnime_Curse(c , td , SukunaFinger_Curse_ID)
        call SlowUnit(c , td , SukunaFinger_Slow , 1)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DeathCoil\\DeathCoilSpecialArt.mdl", td, "chest"))
    endfunction

    function ItemsSpells__SealStart takes unit c,unit td returns nothing
        local integer fx
        if td == null or not SpellBoolCaster(td) or not IsUnitEnemy(td, GetOwningPlayer(c)) or DebuffImmune_Start(td , 1) == 0 then
            return
        endif
        set fx=s__ItemsSpells__ItemsAnimeEffect_Find(s__ItemsSpells__ItemsAnimeEffect_KIND_SEAL , td)
        if fx == 0 then
            set fx=s__ItemsSpells__ItemsAnimeEffect_Add(s__ItemsSpells__ItemsAnimeEffect_KIND_SEAL , c , td , FiveElementsSeal_Duration)
        else
            set s__ItemsSpells__ItemsAnimeEffect_c[fx]=c
            set s__ItemsSpells__ItemsAnimeEffect_left[fx]=FiveElementsSeal_Duration
            set s__ItemsSpells__ItemsAnimeEffect_step[fx]=0.0
        endif
        set s__ItemsSpells__ItemsAnimeEffect_armed[fx]=true
        call ItemsAnime_Curse(c , td , FiveElementsSeal_Curse_ID)
        call ItemsAnime_Curse(c , td , FiveElementsSeal_LockCurse_ID)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\ManaFlare\\ManaFlareBoltImpact.mdl", td, "chest"))
    endfunction

    function ItemsSpells__KairosekiStart takes unit c,unit td returns nothing
        if td == null or not SpellBool(td) or not IsUnitEnemy(td, GetOwningPlayer(c)) then
            return
        endif
        // Every positive buff (incl. buff-backed shields); hero states without a buff stay.
        call UnitRemoveBuffs(td, true, false)
        // Cancel immediately, including the dummy's brief buff-application window.
        call SaveReal(hs, GetHandleId(td), SH_WILL_OF_D_END, 0.0)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl", td, "origin"))
        if DebuffImmune_Start(td , 1) == 1 then
            call ItemsAnime_Curse(c , td , Kairoseki_Curse_ID)
        endif
    endfunction

    function InvertedSpear_Start takes unit c,unit td returns nothing
        local integer fx
        if td == null or not SpellBool(td) or not IsUnitEnemy(td, GetOwningPlayer(c)) then
            return
        endif
        if DebuffImmune_Start(td , 1) == 1 then
            set fx=s__ItemsSpells__ItemsAnimeEffect_Find(s__ItemsSpells__ItemsAnimeEffect_KIND_SPEAR , td)
            if fx == 0 then
                set fx=s__ItemsSpells__ItemsAnimeEffect_Add(s__ItemsSpells__ItemsAnimeEffect_KIND_SPEAR , c , td , InvertedSpear_Duration)
            else
                set s__ItemsSpells__ItemsAnimeEffect_c[fx]=c
                set s__ItemsSpells__ItemsAnimeEffect_left[fx]=InvertedSpear_Duration
            endif
            set s__ItemsSpells__ItemsAnimeEffect_returnAt[fx]=TimerGetElapsed(HealRegenClock) + InvertedSpear_Duration
            call SaveReal(hs, GetHandleId(td), SH_INVERTED_SPEAR_END, s__ItemsSpells__ItemsAnimeEffect_returnAt[fx])
            call ItemsAnime_Curse(c , td , InvertedSpear_Curse_ID)
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl", td, "origin"))
        endif
    endfunction

    function ItemsSpells__CoffinStart takes unit c returns nothing
        local integer fx
        if s__ItemsSpells__ItemsAnimeEffect_Find(s__ItemsSpells__ItemsAnimeEffect_KIND_COFFIN , c) != 0 then
            return
        endif
        set fx=s__ItemsSpells__ItemsAnimeEffect_Add(s__ItemsSpells__ItemsAnimeEffect_KIND_COFFIN , c , c , IceCoffin_Duration)
        set s__ItemsSpells__ItemsAnimeEffect_armed[fx]=true
        set s__ItemsSpells__ItemsAnimeEffect_round[fx]=CurrentRound
        call GearPauseSpellStart(c , true)
        call UnitAddAbility(c, 'Avul')
        call BuffUnit01(c , c , IceCoffin_BuffAbi_ID , "innerfire" , 1)
        set s__ItemsSpells__ItemsAnimeEffect_e[fx]=AddSpecialEffectTarget("war3mapImported\\wos_icecoffin.mdx", c, "origin")
        call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl", GetUnitX(c), GetUnitY(c)))
    endfunction

    function ItemsSpells__ReturnStart takes unit c returns nothing
        local integer fx= s__ItemsSpells__ItemsAnimeEffect_Find(s__ItemsSpells__ItemsAnimeEffect_KIND_RETURN , c)
        if fx != 0 then
            // Recast: the new position replaces the old one.
            call BlzSetSpecialEffectTimeScale(s__ItemsSpells__ItemsAnimeEffect_e[fx], 2)
            call DestroyEffect(s__ItemsSpells__ItemsAnimeEffect_e[fx])
            call DestroyEffect(s__ItemsSpells__ItemsAnimeEffect_e2[fx])
            set s__ItemsSpells__ItemsAnimeEffect_left[fx]=ReturnByDeath_Delay
        else
            set fx=s__ItemsSpells__ItemsAnimeEffect_Add(s__ItemsSpells__ItemsAnimeEffect_KIND_RETURN , c , c , ReturnByDeath_Delay)
        endif
        call BuffUnit01(c , c , ReturnByDeath_BuffAbi_ID , "innerfire" , 1)
        set s__ItemsSpells__ItemsAnimeEffect_returnAt[fx]=TimerGetElapsed(HealRegenClock) + ReturnByDeath_Delay
        set s__ItemsSpells__ItemsAnimeEffect_x[fx]=GetUnitX(c)
        set s__ItemsSpells__ItemsAnimeEffect_y[fx]=GetUnitY(c)
        set s__ItemsSpells__ItemsAnimeEffect_round[fx]=CurrentRound
        set s__ItemsSpells__ItemsAnimeEffect_e[fx]=EffectSpawn("war3mapImported\\wos_hmr-guanghuan.mdl" , s__ItemsSpells__ItemsAnimeEffect_x[fx] , s__ItemsSpells__ItemsAnimeEffect_y[fx] , 1 , 1 , 2.2 , 8)
        set s__ItemsSpells__ItemsAnimeEffect_e2[fx]=AddSpecialEffectTarget("war3mapImported\\wos_watchaura4.mdl", c, "origin")
        call s__GearSystems2___KS_BuffTimer_MyBuffTime_Start((c ) , ( ReturnByDeath_Buff_ID ) , (( ReturnByDeath_Delay )*1.0) , ( "BTNItem_ReturnByDeath" ) , ( false ) , - 1 , 0 , 0 , ( ReturnByDeath_FrameSlot)) // INLINED!!
    endfunction

    // Item actives (CastAItems.ItemsCast).
    function ItemsAnime_Cast takes unit c,unit td,real x,real y,integer id returns nothing
        if id == SukunaFinger_Abi_ID then
            call ItemsSpells__SukunaStart(c , td)
        elseif id == FiveElementsSeal_Abi_ID then
            call ItemsSpells__SealStart(c , td)
        elseif id == Kairoseki_Abi_ID then
            call ItemsSpells__KairosekiStart(c , td)
        elseif id == InvertedSpear_Abi_ID then
            call InvertedSpear_Start(c , td)
        elseif id == Tekkai_Abi_ID then
            call BuffUnit01(c , c , Tekkai_BuffAbi_ID , "innerfire" , 1)
            call s__GearSystems2___KS_RemoveEffect_MyRemoveEff_Start((AddSpecialEffectTarget("Abilities\\Spells\\Human\\Defend\\DefendCaster.mdl", c, "origin") ) , (( 4.0)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
        elseif id == IceCoffin_Abi_ID then
            call ItemsSpells__CoffinStart(c)
        elseif id == ReturnByDeath_Abi_ID then
            call ItemsSpells__ReturnStart(c)
        elseif id == YataMirrorEvolved_Abi_ID then
            call BuffUnit01(c , c , YataMirrorEvolved_BuffAbi_ID , "innerfire" , 1)
            call s__GearSystems2___KS_RemoveEffect_MyRemoveEff_Start((AddSpecialEffectTarget("Abilities\\Spells\\Human\\ManaShield\\ManaShieldCaster.mdl", c, "origin") ) , (( 4.0)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
        elseif id == PhilosopherEvolved_Abi_ID then
            call BuffUnit01(c , c , PhilosopherEvolved_BuffAbi_ID , "innerfire" , 1)
            call s__GearSystems2___KS_RemoveEffect_MyRemoveEff_Start((AddSpecialEffectTarget("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl", c, "origin") ) , (( 3.0)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
        endif
    endfunction

    // Ice Coffin from an item hotkey while stunned or paused (the native button is disabled then).
    function ItemsSpells__CanUseOnlyByKey takes unit u returns boolean
        return IsUnitPaused(u) or GetUnitAbilityLevel(u, 'BPSE') > 0 or GetUnitAbilityLevel(u, 'BSTN') > 0
    endfunction

    function ItemsAnime_ItemKey takes integer pid,integer slot returns nothing
        local unit u
        local item it
        if pid < 0 or pid >= 10 or slot < 0 or slot > 5 then
            return
        endif
        set u=Hero[pid]
        if u != null and not IsUnitType(u, UNIT_TYPE_DEAD) and ItemsSpells__CanUseOnlyByKey(u) then
            set it=UnitItemInSlot(u, slot)
            if GetItemTypeId(it) == IceCoffin_ID and BlzGetUnitAbilityCooldownRemaining(u, IceCoffin_Abi_ID) == 0.0 then
                call BlzStartUnitAbilityCooldown(u, IceCoffin_Abi_ID, BlzGetUnitAbilityCooldown(u, IceCoffin_Abi_ID, 0))
                call ItemsSpells__CoffinStart(u)
            endif
            set it=null
        endif
        set u=null
    endfunction

    function ItemsSpells__OnItemKeyHook takes nothing returns boolean
        call ItemsAnime_ItemKey(WUI_ItemKeyPlayer , WUI_ItemKeySlot)
        return false
    endfunction

    // Stock inventory keys (Numpad 7 8 / 4 5 / 1 2) for players without custom item hotkeys.
    function ItemsSpells__OnNumpadKey takes nothing returns boolean
        local oskeytype key= BlzGetTriggerPlayerKey()
        local integer slot= - 1
        if key == OSKEY_NUMPAD7 then
            set slot=0
        elseif key == OSKEY_NUMPAD8 then
            set slot=1
        elseif key == OSKEY_NUMPAD4 then
            set slot=2
        elseif key == OSKEY_NUMPAD5 then
            set slot=3
        elseif key == OSKEY_NUMPAD1 then
            set slot=4
        elseif key == OSKEY_NUMPAD2 then
            set slot=5
        endif
        call ItemsAnime_ItemKey(GetPlayerId(GetTriggerPlayer()) , slot)
        set key=null
        return false
    endfunction

    function ItemsSpells__CoffinDigitKey takes integer digit returns oskeytype
        if digit == 1 then
            return OSKEY_1
        elseif digit == 2 then
            return OSKEY_2
        elseif digit == 3 then
            return OSKEY_3
        elseif digit == 4 then
            return OSKEY_4
        elseif digit == 5 then
            return OSKEY_5
        elseif digit == 6 then
            return OSKEY_6
        endif
        return null
    endfunction

    // Key that fires Ice Coffin for pid (null: none; the slot digit is skipped when another key uses it).
    function ItemsAnime_CoffinKey takes integer pid returns oskeytype
        if WUI_CoffinKey[pid] != null then
            return WUI_CoffinKey[pid]
        elseif ItemsAnime_CoffinDigit[pid] > 0 and WUI_CoffinKeyConflict(pid , ItemsSpells__CoffinDigitKey(ItemsAnime_CoffinDigit[pid]) , I2S(ItemsAnime_CoffinDigit[pid])) == "" then
            return ItemsSpells__CoffinDigitKey(ItemsAnime_CoffinDigit[pid])
        endif
        return null
    endfunction

    function ItemsAnime_CoffinKeyLabel takes integer pid returns string
        if WUI_CoffinKey[pid] != null then
            return WUI_CoffinKeyName[pid]
        elseif ItemsAnime_CoffinKey(pid) != null then
            return I2S(ItemsAnime_CoffinDigit[pid])
        endif
        return "-"
    endfunction

    // Synced key: Ice Coffin from its own hotkey. Stunned/paused: scripted cast (ItemsAnime_ItemKey);
    // otherwise the native item use. Needs the item in the inventory and its cooldown ready.
    function ItemsSpells__OnCoffinKey takes nothing returns boolean
        local integer pid= GetPlayerId(GetTriggerPlayer())
        local integer slot= 0
        local unit u
        local item it
        if WUI_IsCoffinCapturing(pid) or not (false) or pid < 0 or pid >= 10 then // INLINED!!
            return false
        endif
        if BlzGetTriggerPlayerKey() != ItemsAnime_CoffinKey(pid) then
            return false
        endif
        set u=Hero[pid]
        if u == null or IsUnitType(u, UNIT_TYPE_DEAD) or BlzGetUnitAbilityCooldownRemaining(u, IceCoffin_Abi_ID) > 0.0 then
            set u=null
            return false
        endif
        loop
            exitwhen slot > 5
            set it=UnitItemInSlot(u, slot)
            if GetItemTypeId(it) == IceCoffin_ID then
                if ItemsSpells__CanUseOnlyByKey(u) then
                    call ItemsAnime_ItemKey(pid , slot)
                else
                    call UnitUseItem(u, it)
                endif
                exitwhen true
            endif
            set slot=slot + 1
        endloop
        set it=null
        set u=null
        return false
    endfunction

    // Default key = the digit of the slot the item landed in when picked up / bought.
    function ItemsSpells__OnCoffinPickup takes nothing returns boolean
        local unit u= GetTriggerUnit()
        local item it= GetManipulatedItem()
        local integer pid= GetPlayerId(GetOwningPlayer(u))
        local integer slot= 0
        if GetItemTypeId(it) == IceCoffin_ID and pid >= 0 and pid < 10 and u == Hero[pid] then
            loop
                exitwhen slot > 5
                if UnitItemInSlot(u, slot) == it then
                    set ItemsAnime_CoffinDigit[pid]=slot + 1
                    call WUI_RegisterCoffinKey(pid , ItemsSpells__CoffinDigitKey(slot + 1))
                    exitwhen true
                endif
                set slot=slot + 1
            endloop
        endif
        set it=null
        set u=null
        return false
    endfunction

    function ItemsSpells__OnCoffinChange takes nothing returns nothing
        call WUI_BeginCoffinCapture(GetTriggerPlayer())
        call WUI_ResetClickedButtonFocus()
    endfunction

    // -coffin <key> | -coffin default | -coffin
    function ItemsSpells__OnCoffinChat takes nothing returns nothing
        local player p= GetTriggerPlayer()
        local string arg= GetEventPlayerChatString()
        if SubString(arg, 0, 7) != "-coffin" then
            set p=null
            return
        endif
        set arg=StringCase(SubString(arg, 7, StringLength(arg)), true)
        loop
            exitwhen SubString(arg, 0, 1) != " "
            set arg=SubString(arg, 1, StringLength(arg))
        endloop
        loop
            exitwhen StringLength(arg) == 0 or SubString(arg, StringLength(arg) - 1, StringLength(arg)) != " "
            set arg=SubString(arg, 0, StringLength(arg) - 1)
        endloop
        if arg == "" then
            call DisplayTimedTextToPlayer(p, 0, 0, 6.00, WUI_GOLD + "Ice Coffin hotkey: " + ItemsAnime_CoffinKeyLabel(GetPlayerId(p)) + "|r|n" + WUI_TEXT + "-coffin <key> sets it (letter, digit, F1-F9), -coffin default = number of its slot. Or click CHANGE on the item.|r")
        elseif arg == "DEFAULT" or arg == "RESET" then
            call WUI_SetCoffinKey(p , "" , true)
        else
            call WUI_SetCoffinKey(p , arg , true)
        endif
        set p=null
    endfunction

    // Shared 0.25 s clock, frame work local only: key badge in the corner of the Ice Coffin item
    // and CHANGE on its lower edge, for the own hero while it is the displayed unit.
    function ItemsSpells__CoffinBadges takes nothing returns nothing
        local integer pid= GetPlayerId(GetLocalPlayer())
        local unit u= null
        local integer slot= 0
        local string label= null
        local string want
        if ItemsAnime_CoffinChange[0] == null then
            return
        endif
        if pid >= 0 and pid < 10 then
            set u=Hero[pid]

                if TasAbilityChargeBox_Unit[pid] != u then
                    set u=null
                endif

        endif
        loop
            exitwhen slot > 5
            set want=""
            if u != null and GetItemTypeId(UnitItemInSlot(u, slot)) == IceCoffin_ID and WUI_RangeNativeItemVisible(slot) then
                if label == null then
                    set label=ItemsAnime_CoffinKeyLabel(pid)
                endif
                set want=label
                if WUI_SlotKeyLabel(pid , 7 + slot) != "" then
                    // The custom item-slot key badge owns the top-right corner.
                    set want=label + "<"
                endif
            endif
            if want != ItemsAnime_CoffinShown[slot] then
                set ItemsAnime_CoffinShown[slot]=want
                call BlzFrameSetVisible(ItemsAnime_CoffinChange[slot], want != "")
                call BlzFrameSetVisible(ItemsAnime_CoffinHit[slot], want != "")
                if ItemsAnime_CoffinBox[slot] != null then
                    if want != "" then
                        call BlzFrameSetText(ItemsAnime_CoffinText[slot], WUI_GOLD + label + "|r")
                        call BlzFrameClearAllPoints(ItemsAnime_CoffinIcon[slot])
                        call BlzFrameClearAllPoints(ItemsAnime_CoffinText[slot])
                        if want == label then
                            call BlzFrameSetPoint(ItemsAnime_CoffinIcon[slot], FRAMEPOINT_TOPRIGHT, ItemsAnime_CoffinButton[slot], FRAMEPOINT_TOPRIGHT, 0.001, 0.001)
                            call BlzFrameSetPoint(ItemsAnime_CoffinText[slot], FRAMEPOINT_TOPRIGHT, ItemsAnime_CoffinButton[slot], FRAMEPOINT_TOPRIGHT, 0.001, 0.001)
                        else
                            call BlzFrameSetPoint(ItemsAnime_CoffinIcon[slot], FRAMEPOINT_TOPLEFT, ItemsAnime_CoffinButton[slot], FRAMEPOINT_TOPLEFT, - 0.001, 0.001)
                            call BlzFrameSetPoint(ItemsAnime_CoffinText[slot], FRAMEPOINT_TOPLEFT, ItemsAnime_CoffinButton[slot], FRAMEPOINT_TOPLEFT, - 0.001, 0.001)
                        endif
                    endif
                    call BlzFrameSetVisible(ItemsAnime_CoffinBox[slot], want != "")
                endif
            endif
            set slot=slot + 1
        endloop
        set u=null
    endfunction

    // Synchronous, once the HUD exists: 6 badges (charge-box look) on the item buttons + 6 CHANGE buttons.
    function ItemsSpells__CoffinFrames takes nothing returns nothing
        local integer slot= 0
        local framehandle back
        local framehandle text
        local real size= 0.0135
        local real font= 0.009

            set size=TasAbilityChargeBox_BOX_SIZE
            set font=TasAbilityChargeBox_FONT_SIZE

        set ItemsAnime_CoffinClick=CreateTrigger()
        call TriggerAddAction(ItemsAnime_CoffinClick, function ItemsSpells__OnCoffinChange)
        loop
            exitwhen slot > 5
            set ItemsAnime_CoffinButton[slot]=BlzGetOriginFrame(ORIGIN_FRAME_ITEM_BUTTON, slot)
            if (false) and ItemsAnime_CoffinButton[slot] != null then // INLINED!!
                set ItemsAnime_CoffinBox[slot]=BlzCreateSimpleFrame("TasAbilityChargeBox", ItemsAnime_CoffinButton[slot], 40 + slot)
                // Badge-sized, not SetAllPoints: never taken for the item cooldown sprite.
                call BlzFrameClearAllPoints(ItemsAnime_CoffinBox[slot])
                call BlzFrameSetPoint(ItemsAnime_CoffinBox[slot], FRAMEPOINT_TOPRIGHT, ItemsAnime_CoffinButton[slot], FRAMEPOINT_TOPRIGHT, 0.001, 0.001)
                call BlzFrameSetSize(ItemsAnime_CoffinBox[slot], size, size)
                call WUI_RegisterChargeBox(ItemsAnime_CoffinBox[slot])
                set ItemsAnime_CoffinText[slot]=BlzGetFrameByName("TasAbilityChargeBoxText", 40 + slot)
                set ItemsAnime_CoffinIcon[slot]=BlzGetFrameByName("TasAbilityChargeBoxTexture", 40 + slot)
                call BlzFrameClearAllPoints(ItemsAnime_CoffinIcon[slot])
                call BlzFrameSetPoint(ItemsAnime_CoffinIcon[slot], FRAMEPOINT_TOPRIGHT, ItemsAnime_CoffinButton[slot], FRAMEPOINT_TOPRIGHT, 0.001, 0.001)
                call BlzFrameSetSize(ItemsAnime_CoffinIcon[slot], size, size)
                call BlzFrameSetTexture(ItemsAnime_CoffinIcon[slot], "UI\\WOS\\button.tga", 0, true)
                call BlzFrameClearAllPoints(ItemsAnime_CoffinText[slot])
                call BlzFrameSetPoint(ItemsAnime_CoffinText[slot], FRAMEPOINT_TOPRIGHT, ItemsAnime_CoffinButton[slot], FRAMEPOINT_TOPRIGHT, 0.001, 0.001)
                call BlzFrameSetSize(ItemsAnime_CoffinText[slot], size, size)
                call BlzFrameSetFont(ItemsAnime_CoffinText[slot], "Fonts/FRIZQT__.TTF", font, 0)
                call BlzFrameSetVisible(ItemsAnime_CoffinBox[slot], false)
            endif
            // CHANGE under the cell, in the gap between the item rows (below the screen-bottom row too).
            set ItemsAnime_CoffinHit[slot]=BlzCreateSimpleFrame("WOSQBHUDRemove", (null), 9320 + slot) // INLINED!!
            call WUI_PlaceShift(ItemsAnime_CoffinHit[slot] , WUI_ITEM_X + I2R(ModuloInteger(slot, 3) - 1) * WUI_ITEM_STEP_X , WUI_ITEM_Y - I2R(slot / 3) * WUI_ITEM_STEP_Y - WUI_ITEM_SIZE * 0.5 - 0.0058 , 0.0260 , 0.0062)
            call BlzFrameSetLevel(ItemsAnime_CoffinHit[slot], 55)
            call BlzTriggerRegisterFrameEvent(ItemsAnime_CoffinClick, ItemsAnime_CoffinHit[slot], FRAMEEVENT_CONTROL_CLICK)
            call BlzFrameSetVisible(ItemsAnime_CoffinHit[slot], false)
            set ItemsAnime_CoffinChange[slot]=BlzCreateFrameByType("BUTTON", "WOSCoffinChange", (null), "", slot) // INLINED!!
            call WUI_PlaceShift(ItemsAnime_CoffinChange[slot] , WUI_ITEM_X + I2R(ModuloInteger(slot, 3) - 1) * WUI_ITEM_STEP_X , WUI_ITEM_Y - I2R(slot / 3) * WUI_ITEM_STEP_Y - WUI_ITEM_SIZE * 0.5 - 0.0058 , 0.0260 , 0.0062)
            call BlzFrameSetLevel(ItemsAnime_CoffinChange[slot], 46)
            set back=BlzCreateFrameByType("BACKDROP", "WOSCoffinChangeBack", ItemsAnime_CoffinChange[slot], "", slot)
            call BlzFrameSetAllPoints(back, ItemsAnime_CoffinChange[slot])
            call BlzFrameSetTexture(back, WUI_FILL_NORMAL, 0, true)
            call BlzFrameSetAlpha(back, 225)
            call BlzFrameSetEnable(back, false)
            set text=BlzCreateFrameByType("TEXT", "WOSCoffinChangeText", ItemsAnime_CoffinChange[slot], "", slot)
            call BlzFrameSetAllPoints(text, ItemsAnime_CoffinChange[slot])
            call BlzFrameSetTextAlignment(text, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
            call BlzFrameSetScale(text, 0.55)
            call BlzFrameSetText(text, "|cffe8e8e8CHANGE|r")
            call BlzFrameSetEnable(text, false)
            call WUI_Tooltip(ItemsAnime_CoffinChange[slot] , "|cffd5b876ICE COFFIN HOTKEY|r|nClick, then press a letter, digit or F1-F9.|nBackspace: number of its slot, Esc: keep.|nChat: -coffin <key> / -coffin default.|nWorks while stunned or paused; Save Keys keeps it.")
            // The face only draws: input goes to the SIMPLEBUTTON below it.
            call BlzFrameSetEnable(ItemsAnime_CoffinChange[slot], false)
            call BlzFrameSetVisible(ItemsAnime_CoffinChange[slot], false)
            set ItemsAnime_CoffinShown[slot]="?"
            set slot=slot + 1
        endloop
        set ItemsAnime_CoffinBadgeClock=CreateTimer()
        call TimerStart(ItemsAnime_CoffinBadgeClock, 0.25, true, function ItemsSpells__CoffinBadges)
        set back=null
        set text=null
    endfunction

    function ItemsAnime_OnHeroCast takes unit c returns nothing
        call s__ItemsSpells__ItemsAnimeEffect_OnHeroCast(c)
    endfunction

    // Applied damage (DmgSys, before phase 3 listeners).
    function ItemsAnime_FinalDamage takes unit c,unit td,real dmg,integer typedmg,boolean isAttack returns real
        local integer fx
        local integer h
        local real now
        local real life
        if dmg <= 0.0 then
            return dmg
        endif
        if s__ItemsSpells__ItemsAnimeEffect_Find(s__ItemsSpells__ItemsAnimeEffect_KIND_COFFIN , td) != 0 then
            return 0.0
        endif
        if c != null and GetUnitAbilityLevel(c, Kairoseki_Buff_ID) > 0 then
            set dmg=dmg * ( 1.0 - Kairoseki_DamageReduce / 100.0 )
        endif
        // Tekkai: every basic attack, whatever its damage type (magic attacks, Starrk's Cero).
        if ( typedmg == 0 or isAttack ) and GetUnitAbilityLevel(td, Tekkai_Buff_ID) > 0 then
            set dmg=ApplyFullDamageShield(c , td , dmg , dmg , typedmg , DAMAGE_SHIELD_TYPE_ALL)
        endif
        if dmg > 0.0 and HasCachedItem(td , NaofumiShieldEvolved_ID) > 0 then
            if LoadInteger(hs, GetHandleId(td), SH_ItemsAnime_NAOFUMI_SHIELD) == 1 then
                set dmg=RMaxBJ(0.0, dmg - NaofumiShieldEvolved_BlockActive)
            else
                set dmg=RMaxBJ(0.0, dmg - NaofumiShieldEvolved_Block)
            endif
        endif
        // Wrath / Lust Sin pierce Will of D.: neither trigger it nor respect its protection.
        if dmg > 0.0 and HasCachedItem(td , WillOfD_ID) > 0 and IsUnitType(td, UNIT_TYPE_HERO) and not IsUnitIllusion(td) and not SinPiercesSurvival(c) then
            set h=GetHandleId(td)
            set now=TimerGetElapsed(HealRegenClock)
            set life=GetWidgetLife(td)
            if now < LoadReal(hs, h, SH_WILL_OF_D_END) then
                // Allow only the initial native dummy application window; a dispel never rearms it.
                if GetUnitAbilityLevel(td, WillOfD_Buff_ID) > 0 or now < LoadReal(hs, h, SH_WILL_OF_D_END) - WillOfD_Duration + 0.20 then
                    set dmg=RMinBJ(dmg, RMaxBJ(0.0, life - 1.0))
                else
                    call SaveReal(hs, h, SH_WILL_OF_D_END, 0.0)
                endif
            elseif dmg >= life - 1.0 and BlzGetUnitAbilityCooldownRemaining(td, WillOfD_CD_ID) == 0.0 then
                call SaveReal(hs, h, SH_WILL_OF_D_END, now + WillOfD_Duration)
                call BlzStartUnitAbilityCooldown(td, WillOfD_CD_ID, WillOfD_CD)
                call BuffUnit01(td , td , WillOfD_BuffAbi_ID , "innerfire" , 1)
                set fx=s__ItemsSpells__ItemsAnimeEffect_Add(s__ItemsSpells__ItemsAnimeEffect_KIND_WILL , td , td , WillOfD_Duration)
                set s__ItemsSpells__ItemsAnimeEffect_returnAt[fx]=now + WillOfD_Duration
                set s__ItemsSpells__ItemsAnimeEffect_e[fx]=AddSpecialEffectTarget("Abilities\\Spells\\Human\\DivineShield\\DivineShieldTarget.mdl", td, "origin")
                set dmg=RMaxBJ(0.0, life - 1.0)
            endif
        endif
        return dmg
    endfunction

    // Basic attack that hit an enemy (DmgSys).
    function ItemsAnime_OnAttack takes unit c,unit td returns nothing
        if c != null and td != null and not IsUnitIllusion(c) and not IsUnitIllusion(td) and IsUnitEnemy(td, GetOwningPlayer(c)) and GetUnitAbilityLevel(td, Tekkai_Buff_ID) == 0 and HasCachedItem(c , Samehada_ID) > 0 then
            call SetMpCurrentQuiet(c , GetUnitState(c, UNIT_STATE_MAX_MANA) * Samehada_ManaRestore / 100.0)
            call SetMpCurrent(td , - GetUnitState(td, UNIT_STATE_MAX_MANA) * Samehada_ManaDrain / 100.0)
        endif
    endfunction

    // Will of D.: one cooldown reset at the end of every round.
    function ItemsAnime_RoundEnd takes nothing returns nothing
        local integer i= 0
        loop
            exitwhen i >= 10
            if Hero[i] != null and HasCachedItem(Hero[i] , WillOfD_ID) > 0 then
                call BlzEndUnitAbilityCooldown(Hero[i], WillOfD_CD_ID)
                call SaveReal(hs, GetHandleId(Hero[i]), SH_WILL_OF_D_END, 0.0)
            endif
            set i=i + 1
        endloop
    endfunction

    function ItemsSpells__ItemsAnime_Init takes nothing returns nothing
        local integer pid= 0
        local trigger t
        local trigger chat
        set WUI_ItemKeyHook=CreateTrigger()
        call TriggerAddCondition(WUI_ItemKeyHook, Condition(function ItemsSpells__OnItemKeyHook))
        set ItemsAnime_NumpadKeys=CreateTrigger()
        loop
            exitwhen pid >= 10
            call BlzTriggerRegisterPlayerKeyEvent(ItemsAnime_NumpadKeys, Player(pid), OSKEY_NUMPAD7, 0, true)
            call BlzTriggerRegisterPlayerKeyEvent(ItemsAnime_NumpadKeys, Player(pid), OSKEY_NUMPAD8, 0, true)
            call BlzTriggerRegisterPlayerKeyEvent(ItemsAnime_NumpadKeys, Player(pid), OSKEY_NUMPAD4, 0, true)
            call BlzTriggerRegisterPlayerKeyEvent(ItemsAnime_NumpadKeys, Player(pid), OSKEY_NUMPAD5, 0, true)
            call BlzTriggerRegisterPlayerKeyEvent(ItemsAnime_NumpadKeys, Player(pid), OSKEY_NUMPAD1, 0, true)
            call BlzTriggerRegisterPlayerKeyEvent(ItemsAnime_NumpadKeys, Player(pid), OSKEY_NUMPAD2, 0, true)
            set pid=pid + 1
        endloop
        call TriggerAddCondition(ItemsAnime_NumpadKeys, Condition(function ItemsSpells__OnNumpadKey))
        call TriggerAddCondition(WUI_CoffinKeyTrigger, Condition(function ItemsSpells__OnCoffinKey))
        set t=CreateTrigger()
        call TriggerAddCondition(t, Condition(function ItemsSpells__OnCoffinPickup))
        set chat=CreateTrigger()
        call TriggerAddAction(chat, function ItemsSpells__OnCoffinChat)
        set pid=0
        loop
            exitwhen pid >= 10
            call TriggerRegisterPlayerUnitEvent(t, Player(pid), EVENT_PLAYER_UNIT_PICKUP_ITEM, null)
            call TriggerRegisterPlayerChatEvent(chat, Player(pid), "-coffin", false)
            set pid=pid + 1
        endloop
        call WUI_OnReady(function ItemsSpells__CoffinFrames)
        set t=null
        set chat=null
    endfunction

    // ================= Elemental actives (2026-10-28b): casts, marks, reactions =================
    // Hooks: CastAItems (ItemsElements_Cast), DmgSys (ItemsElements_OnDamage), CastCheck
    // (ItemsElements_OnHeroCast). Sacred Gear Booster is added once per cast to its first damage.
    // BEGIN ELEMENTAL MARK OBJECTS (tools/stage_elemental_marks.py)
    function ItemsSpells__ElemMarkObject takes integer kind,boolean isAbility returns integer
        if kind == 20 then
            if isAbility then
                return 'A156'
            endif
            return 'B069'
        endif
        if kind == 21 then
            if isAbility then
                return 'A157'
            endif
            return 'B06A'
        endif
        if kind == 22 then
            if isAbility then
                return 'A158'
            endif
            return 'B06B'
        endif
        if kind == 23 then
            if isAbility then
                return 'A159'
            endif
            return 'B06C'
        endif
        if kind == 24 then
            if isAbility then
                return 'A15A'
            endif
            return 'B06D'
        endif
        if kind == 25 then
            if isAbility then
                return 'A15B'
            endif
            return 'B06E'
        endif
        if kind == 26 then
            if isAbility then
                return 'A15C'
            endif
            return 'B06F'
        endif
        if kind == 27 then
            if isAbility then
                return 'A15D'
            endif
            return 'B070'
        endif
        if kind == 28 then
            if isAbility then
                return 'A15E'
            endif
            return 'B071'
        endif
        if kind == 29 then
            if isAbility then
                return 'A15F'
            endif
            return 'B072'
        endif
        if kind == 30 then
            if isAbility then
                return 'A160'
            endif
            return 'B073'
        endif
        return 0
    endfunction
    // END ELEMENTAL MARK OBJECTS

    function ItemsSpells__ElemStr takes unit c returns real
        return I2R(GetHeroStr(c, true))
    endfunction

    function ItemsSpells__ElemAgi takes unit c returns real
        return I2R(GetHeroAgi(c, true))
    endfunction

    function ItemsSpells__ElemInt takes unit c returns real
        return I2R(GetHeroInt(c, true))
    endfunction

    function ItemsSpells__ElemValid takes unit c,unit u returns boolean
        return u != null and GetUnitTypeId(u) != 0 and SpellBool(u) and IsUnitEnemy(u, GetOwningPlayer(c))
    endfunction

    function ItemsSpells__ElemAlive takes unit u returns boolean
        return u != null and GetUnitTypeId(u) != 0 and not IsUnitType(u, UNIT_TYPE_DEAD)
    endfunction


    // One damage instance credited to the item, then its element. Returns the HP actually lost.
    function ItemsSpells__ElemHit takes unit c,unit u,integer itemId,real dmg,boolean magic,integer element returns real
        local real life
        if ItemsSpells__ElemBambCur != 0 and ItemsSpells__ElemBambArmed[ItemsSpells__ElemBambCur] then
            // Consumed before damage so nested hits from reactions don't fire it twice.
            set ItemsSpells__ElemBambArmed[ItemsSpells__ElemBambCur]=false
            call BambiettaG2_Start(c , GetUnitX(u) , GetUnitY(u))
        endif
        call DecorRemove(c , GetUnitX(u) , GetUnitY(u) , 150.0 , ItemActive_DecorDamage)
        set life=GetWidgetLife(u)
        set GearDamageNextSource=(itemId) // INLINED!!
        if magic then
            call dmgmag(c , u , dmg)
        else
            call dmgphys(c , u , dmg)
        endif
        if element > 0 then
            set GearDamageNextSource=(itemId) // INLINED!!
            call ErzaPassive(c , u , element)
        endif
        return RMaxBJ(0.0, life - GetWidgetLife(u))
    endfunction

    function ItemsSpells__ElemFx takes string model,real x,real y,real scale returns nothing
        call DestroyEffect(EffectSpawn(model , x , y , GetRandomReal(0, 359) , 1 , scale , 0))
    endfunction

    // Distance to the finite thread segment, including a radius around its endpoints.
    function ItemsSpells__ElemNearSegment takes real px,real py,real ax,real ay,real bx,real by,real radius returns boolean
        local real dx= bx - ax
        local real dy= by - ay
        local real length2= dx * dx + dy * dy
        local real t= 0.0
        if length2 > 0.0 then
            set t=RMaxBJ(0.0, RMinBJ(1.0, ( ( px - ax ) * dx + ( py - ay ) * dy ) / length2))
        endif
        set dx=px - ax - t * dx
        set dy=py - ay - t * dy
        return dx * dx + dy * dy <= radius * radius
    endfunction

    // One smooth displacement step; walkable ground inside the playable map only.
    function ItemsSpells__ElemStep takes unit u,real dx,real dy returns boolean
        local real nx= GetUnitX(u) + dx
        local real ny= GetUnitY(u) + dy
        if IsUnitType(u, UNIT_TYPE_STRUCTURE) or IsTerrainPathable(nx, ny, PATHING_TYPE_WALKABILITY) then
            return false
        endif
        if nx <= GetRectMinX(bj_mapInitialPlayableArea) or nx >= GetRectMaxX(bj_mapInitialPlayableArea) or ny <= GetRectMinY(bj_mapInitialPlayableArea) or ny >= GetRectMaxY(bj_mapInitialPlayableArea) then
            return false
        endif
        call SetUnitX(u, nx)
        call SetUnitY(u, ny)
        return true
    endfunction

        // movers / damage carriers
        // marks
        // Bambietta G: armed at cast, fires G2 on the first hit; bambE rides on .e.


        function s__ItemsElementsFx_HasMark takes integer this returns boolean
            return s__ItemsElementsFx_left[this] > 0.0 and s__ItemsElementsFx_buffId[this] != 0 and GetUnitAbilityLevel(s__ItemsElementsFx_u[this], s__ItemsElementsFx_buffId[this]) > 0
        endfunction

        function s__ItemsElementsFx_finish takes integer this returns nothing
            local integer i= 0
            local boolean another= false
            if s__ItemsElementsFx_kind[this] == s__ItemsElementsFx_DISARM and s__ItemsElementsFx_u[this] != null and GetUnitTypeId(s__ItemsElementsFx_u[this]) != 0 then
                call BlzUnitDisableAbility(s__ItemsElementsFx_u[this], 'Aatk', false, false)
            endif
            if s__ItemsElementsFx_buffId[this] != 0 and s__ItemsElementsFx_u[this] != null then
                loop
                    exitwhen i >= s__ItemsElementsFx_count
                    if s__ItemsElementsFx_list[i] != this and s__ItemsElementsFx_u[s__ItemsElementsFx_list[i]] == s__ItemsElementsFx_u[this] and s__ItemsElementsFx_buffId[s__ItemsElementsFx_list[i]] == s__ItemsElementsFx_buffId[this] and s__ItemsElementsFx_left[s__ItemsElementsFx_list[i]] > 0.0 then
                        set another=true
                    endif
                    set i=i + 1
                endloop
                if not another then
                    call UnitRemoveAbility(s__ItemsElementsFx_u[this], s__ItemsElementsFx_buffId[this])
                endif
            endif
            if s__ItemsElementsFx_u[this] != null and GetUnitTypeId(s__ItemsElementsFx_u[this]) != 0 then
                if s__ItemsElementsFx_hpOffset[this] != 0.0 then
                    call BlzSetUnitRealField(s__ItemsElementsFx_u[this], UNIT_RF_HIT_POINTS_REGENERATION_RATE, BlzGetUnitRealField(s__ItemsElementsFx_u[this], UNIT_RF_HIT_POINTS_REGENERATION_RATE) + s__ItemsElementsFx_hpOffset[this])
                endif
                if s__ItemsElementsFx_mpOffset[this] != 0.0 then
                    call BlzSetUnitRealField(s__ItemsElementsFx_u[this], UNIT_RF_MANA_REGENERATION, BlzGetUnitRealField(s__ItemsElementsFx_u[this], UNIT_RF_MANA_REGENERATION) + s__ItemsElementsFx_mpOffset[this])
                endif
            endif
            if s__ItemsElementsFx_e[this] != null then
                call DestroyEffect(s__ItemsElementsFx_e[this])
            endif
            if s__ItemsElementsFx_e2[this] != null then
                call DestroyEffect(s__ItemsElementsFx_e2[this])
            endif
            if s__ItemsElementsFx_e3[this] != null then
                call DestroyEffect(s__ItemsElementsFx_e3[this])
            endif
            if s__ItemsElementsFx_trail1[this] != null then
                call DestroyEffect(s__ItemsElementsFx_trail1[this])
            endif
            if s__ItemsElementsFx_trail2[this] != null then
                call DestroyEffect(s__ItemsElementsFx_trail2[this])
            endif
            if s__ItemsElementsFx_trail3[this] != null then
                call DestroyEffect(s__ItemsElementsFx_trail3[this])
            endif
            set s__ItemsElementsFx_trail1[this]=null
            set s__ItemsElementsFx_trail2[this]=null
            set s__ItemsElementsFx_trail3[this]=null
            if s__ItemsElementsFx_bambE[this] != null then
                call DestroyEffect(s__ItemsElementsFx_bambE[this])
                set s__ItemsElementsFx_bambE[this]=null
            endif
            set ItemsSpells__ElemBambArmed[this]=false
            if s__ItemsElementsFx_ln[this] != null then
                call DestroyLightning(s__ItemsElementsFx_ln[this])
            endif
            if s__ItemsElementsFx_g[this] != null then
                call DestroyGroup(s__ItemsElementsFx_g[this])
            endif
            if s__ItemsElementsFx_g2[this] != null then
                call DestroyGroup(s__ItemsElementsFx_g2[this])
            endif
            set s__ItemsElementsFx_e[this]=null
            set s__ItemsElementsFx_e2[this]=null
            set s__ItemsElementsFx_e3[this]=null
            set s__ItemsElementsFx_ln[this]=null
            set s__ItemsElementsFx_g[this]=null
            set s__ItemsElementsFx_g2[this]=null
            set s__ItemsElementsFx_c[this]=null
            set s__ItemsElementsFx_u[this]=null
            set s__ItemsElementsFx_u2[this]=null
            call s__ItemsElementsFx_deallocate(this)
        endfunction

        function s__ItemsElementsFx_Add takes integer kind,integer src,unit c,unit u,real duration returns integer
            local integer this= s__ItemsElementsFx__allocate()
            set s__ItemsElementsFx_kind[this]=kind
            set s__ItemsElementsFx_src[this]=src
            set s__ItemsElementsFx_phase[this]=0
            set s__ItemsElementsFx_charges[this]=0
            set s__ItemsElementsFx_c[this]=c
            set s__ItemsElementsFx_u[this]=u
            set s__ItemsElementsFx_u2[this]=null
            set s__ItemsElementsFx_left[this]=duration
            set s__ItemsElementsFx_x[this]=0.0
            set s__ItemsElementsFx_y[this]=0.0
            set s__ItemsElementsFx_tx[this]=0.0
            set s__ItemsElementsFx_ty[this]=0.0
            set s__ItemsElementsFx_vx[this]=0.0
            set s__ItemsElementsFx_vy[this]=0.0
            set s__ItemsElementsFx_dmg[this]=0.0
            set s__ItemsElementsFx_dmg2[this]=0.0
            set s__ItemsElementsFx_step[this]=0.0
            set s__ItemsElementsFx_next[this]=0.0
            set s__ItemsElementsFx_g[this]=null
            set s__ItemsElementsFx_g2[this]=null
            set s__ItemsElementsFx_e[this]=null
            set s__ItemsElementsFx_e2[this]=null
            set s__ItemsElementsFx_e3[this]=null
            set s__ItemsElementsFx_trail1[this]=null
            set s__ItemsElementsFx_trail2[this]=null
            set s__ItemsElementsFx_trail3[this]=null
            set s__ItemsElementsFx_bambE[this]=null
            set ItemsSpells__ElemBambArmed[this]=false
            set s__ItemsElementsFx_ln[this]=null
            set s__ItemsElementsFx_buffId[this]=0
            set s__ItemsElementsFx_buffWait[this]=0.12
            set s__ItemsElementsFx_hpOffset[this]=0.0
            set s__ItemsElementsFx_mpOffset[this]=0.0
            set s__ItemsElementsFx_list[s__ItemsElementsFx_count]=this
            set s__ItemsElementsFx_count=s__ItemsElementsFx_count + 1
            if s__ItemsElementsFx_count == 1 then
                call TimerStart(s__ItemsElementsFx_clock, s__ItemsElementsFx_DT, true, s__ItemsElementsFx_tickCode)
            endif
            return this
        endfunction

        function s__ItemsElementsFx_Find takes integer kind,unit c,unit u returns integer
            local integer i= 0
            loop
                exitwhen i >= s__ItemsElementsFx_count
                if s__ItemsElementsFx_kind[s__ItemsElementsFx_list[i]] == kind and s__ItemsElementsFx_left[s__ItemsElementsFx_list[i]] > 0.0 and ( c == null or s__ItemsElementsFx_c[s__ItemsElementsFx_list[i]] == c ) and ( u == null or s__ItemsElementsFx_u[s__ItemsElementsFx_list[i]] == u ) then
                    return s__ItemsElementsFx_list[i]
                endif
                set i=i + 1
            endloop
            return 0
        endfunction

        // A repeat cast refreshes the mark on the same target instead of stacking a second one.
        function s__ItemsElementsFx_Mark takes integer kind,integer src,unit c,unit u,real duration,string model returns integer
            local integer this
            if kind == s__ItemsElementsFx_CINDER then
                set this=s__ItemsElementsFx_Find(kind , null , u)
            else
                set this=s__ItemsElementsFx_Find(kind , c , u)
            endif
            if this == 0 then
                set this=s__ItemsElementsFx_Add(kind , src , c , u , duration)
                if model != "" then
                    set s__ItemsElementsFx_e[this]=AddSpecialEffectTarget(model, u, "overhead")
                endif
            else
                set s__ItemsElementsFx_left[this]=duration
                set s__ItemsElementsFx_charges[this]=0
            endif
            set s__ItemsElementsFx_c[this]=c
            set s__ItemsElementsFx_buffId[this]=ItemsSpells__ElemMarkObject(kind , false)
            set s__ItemsElementsFx_buffWait[this]=0.12
            if s__ItemsElementsFx_buffId[this] != 0 then
                if kind == s__ItemsElementsFx_BASTION then
                    call BuffUnit01(c , u , ItemsSpells__ElemMarkObject(kind , true) , "innerfire" , R2I(duration * 2.0 + 1.0))
                else
                    call BuffUnit01(c , u , ItemsSpells__ElemMarkObject(kind , true) , "curse" , R2I(duration * 2.0 + 1.0))
                endif
            endif
            return this
        endfunction

        // Smooth push / pull of u over `time`.
        function s__ItemsElementsFx_Push takes unit c,unit u,real angle,real dist,real time returns nothing
            local integer this
            local integer ticks= IMaxBJ(1, R2I(time / s__ItemsElementsFx_DT + 0.5))
            if dist <= 0.0 or not ItemsSpells__ElemAlive(u) then
                return
            endif
            set this=s__ItemsElementsFx_Add(s__ItemsElementsFx_MOVE , 0 , c , u , time + s__ItemsElementsFx_DT)
            set s__ItemsElementsFx_charges[this]=ticks
            set s__ItemsElementsFx_vx[this]=dist / I2R(ticks) * Cos(angle)
            set s__ItemsElementsFx_vy[this]=dist / I2R(ticks) * Sin(angle)
        endfunction

        function s__ItemsElementsFx_Burn takes integer src,unit c,unit u,real total,integer pulses,real interval,boolean magic returns integer
            local integer this= s__ItemsElementsFx_Add(s__ItemsElementsFx_DOT , src , c , u , I2R(pulses) * interval + 0.1)
            set s__ItemsElementsFx_charges[this]=pulses
            set s__ItemsElementsFx_dmg[this]=total / I2R(pulses)
            set s__ItemsElementsFx_step[this]=interval
            set s__ItemsElementsFx_next[this]=interval
            set s__ItemsElementsFx_phase[this]=IntegerTertiaryOp(magic, 1, 0)
            if src == Emberbreaker_ID then
                set s__ItemsElementsFx_buffId[this]=ItemsSpells__ElemMarkObject(29 , false)
                call BuffUnit01(c , u , ItemsSpells__ElemMarkObject(29 , true) , "curse" , R2I(I2R(pulses) * interval * 2.0 + 1.0))
            elseif src == PhoenixSeal_ID then
                set s__ItemsElementsFx_buffId[this]=ItemsSpells__ElemMarkObject(30 , false)
                call BuffUnit01(c , u , ItemsSpells__ElemMarkObject(30 , true) , "curse" , R2I(I2R(pulses) * interval * 2.0 + 1.0))
            endif
            return this
        endfunction

        function s__ItemsElementsFx_Missile takes integer src,unit c,real fromX,real fromY,unit u,real speed,string model,real dmg returns integer
            local integer this= s__ItemsElementsFx_Add(s__ItemsElementsFx_PROJ , src , c , u , 4.0)
            set s__ItemsElementsFx_x[this]=fromX
            set s__ItemsElementsFx_y[this]=fromY
            set s__ItemsElementsFx_vx[this]=speed * s__ItemsElementsFx_DT
            set s__ItemsElementsFx_dmg[this]=dmg
            set s__ItemsElementsFx_e[this]=EffectSpawn(model , fromX , fromY , Atan2(GetUnitY(u) - fromY, GetUnitX(u) - fromX) * bj_RADTODEG , 1 , 1.0 , 70)
            if src == Emberbreaker_ID then
                call BlzSetSpecialEffectScale(s__ItemsElementsFx_e[this], 2.0)
                call BlzSetSpecialEffectZ(s__ItemsElementsFx_e[this], BlzGetLocalSpecialEffectZ(s__ItemsElementsFx_e[this]) + 100.0)
            elseif src == VoltThread_ID then
                call BlzSetSpecialEffectZ(s__ItemsElementsFx_e[this], BlzGetLocalSpecialEffectZ(s__ItemsElementsFx_e[this]) + 80.0) // 70 + 80 = 150
            elseif src == CinderFang_ID then
                call BlzSetSpecialEffectZ(s__ItemsElementsFx_e[this], BlzGetLocalSpecialEffectZ(s__ItemsElementsFx_e[this]) + 150.0)
            elseif src == MirrorTide_ID then
                call BlzSetSpecialEffectScale(s__ItemsElementsFx_e[this], 2.0)
            elseif src == SirenTear_ID then
                call BlzSetSpecialEffectScale(s__ItemsElementsFx_e[this], 2.0)
            endif
            return this
        endfunction

        // Damage pulse on enemies in range; heroes hit are remembered in .g (Bastion charges, Coil chain).
        function s__ItemsElementsFx_Pulse takes integer this,real radius,real dmg,boolean magic,integer element,integer slow returns nothing
            local unit v
            call VisionTimed(GetOwningPlayer(s__ItemsElementsFx_c[this]) , s__ItemsElementsFx_x[this] , s__ItemsElementsFx_y[this] , RMaxBJ(750.0, radius * 1.5) , 0.6)
            call DecorRemove(s__ItemsElementsFx_c[this] , s__ItemsElementsFx_x[this] , s__ItemsElementsFx_y[this] , radius , ItemActive_DecorDamage)
            call GroupEnumUnitsInRange(ItemsElements_Group, s__ItemsElementsFx_x[this], s__ItemsElementsFx_y[this], radius, NoDecor_Cond)
            loop
                set v=FirstOfGroup(ItemsElements_Group)
                exitwhen v == null
                call GroupRemoveUnit(ItemsElements_Group, v)
                if ItemsSpells__ElemValid(s__ItemsElementsFx_c[this] , v) then
                    if s__ItemsElementsFx_kind[this] == s__ItemsElementsFx_ANCHOR and not IsUnitInGroup(v, s__ItemsElementsFx_g2[this]) then
                        call GroupAddUnit(s__ItemsElementsFx_g2[this], v)
                        call sc__ItemsElementsFx_Disarm(s__ItemsElementsFx_c[this] , v)
                    endif
                    call ItemsSpells__ElemHit(s__ItemsElementsFx_c[this] , v , s__ItemsElementsFx_src[this] , dmg , magic , element)
                    if slow > 0 then
                        call SlowUnit(s__ItemsElementsFx_c[this] , v , slow , 1)
                    endif
                    if s__ItemsElementsFx_g[this] != null and IsUnitType(v, UNIT_TYPE_HERO) and not IsUnitIllusion(v) then
                        call GroupAddUnit(s__ItemsElementsFx_g[this], v)
                    endif
                endif
            endloop
        endfunction

        // Drag enemies in range towards (x, y); `spin` adds a sideways (spiral) component.
        function s__ItemsElementsFx_Drag takes integer this,real radius,real inward,real spin returns nothing
            local unit v
            local real a
            local real d
            local real m
            call GroupEnumUnitsInRange(ItemsElements_Group, s__ItemsElementsFx_x[this], s__ItemsElementsFx_y[this], radius, NoDecor_Cond)
            loop
                set v=FirstOfGroup(ItemsElements_Group)
                exitwhen v == null
                call GroupRemoveUnit(ItemsElements_Group, v)
                if ItemsSpells__ElemValid(s__ItemsElementsFx_c[this] , v) then
                    set a=Atan2(s__ItemsElementsFx_y[this] - GetUnitY(v), s__ItemsElementsFx_x[this] - GetUnitX(v))
                    set d=SquareRoot(( s__ItemsElementsFx_x[this] - GetUnitX(v) ) * ( s__ItemsElementsFx_x[this] - GetUnitX(v) ) + ( s__ItemsElementsFx_y[this] - GetUnitY(v) ) * ( s__ItemsElementsFx_y[this] - GetUnitY(v) ))
                    set m=RMinBJ(inward * s__ItemsElementsFx_DT, RMaxBJ(0.0, d - 60.0))
                    call ItemsSpells__ElemStep(v , m * Cos(a) + spin * s__ItemsElementsFx_DT * Cos(a + bj_PI * 0.5) , m * Sin(a) + spin * s__ItemsElementsFx_DT * Sin(a + bj_PI * 0.5))
                endif
            endloop
        endfunction

        // A shuriken / wave at (px, py) hits enemies not yet in `hit` (and not in `skip`).
        function s__ItemsElementsFx_Sweep takes integer this,real px,real py,real radius,group hit,group skip,real dmg,boolean magic,integer element,real push,integer slow returns nothing
            local unit v
            call DecorRemove(s__ItemsElementsFx_c[this] , px , py , radius , ItemActive_DecorDamage)
            call GroupEnumUnitsInRange(ItemsElements_Group, px, py, radius, NoDecor_Cond)
            loop
                set v=FirstOfGroup(ItemsElements_Group)
                exitwhen v == null
                call GroupRemoveUnit(ItemsElements_Group, v)
                if ItemsSpells__ElemValid(s__ItemsElementsFx_c[this] , v) and not IsUnitInGroup(v, hit) and ( skip == null or not IsUnitInGroup(v, skip) ) then
                    call GroupAddUnit(hit, v)
                    call ItemsSpells__ElemHit(s__ItemsElementsFx_c[this] , v , s__ItemsElementsFx_src[this] , dmg , magic , element)
                    if s__ItemsElementsFx_kind[this] == s__ItemsElementsFx_WAVE then
                        call sc__ItemsElementsFx_MirrorMark(s__ItemsElementsFx_c[this] , v)
                    elseif s__ItemsElementsFx_kind[this] == s__ItemsElementsFx_COILSHOT and s__ItemsElementsFx_phase[this] == 0 and s__ItemsElementsFx_u[this] == null then
                        set s__ItemsElementsFx_u[this]=v
                        set s__ItemsElementsFx_ty[this]=- s__ItemsElementsFx_DT
                    endif
                    if slow > 0 then
                        call SlowUnit(s__ItemsElementsFx_c[this] , v , slow , ConstellationCoil_SlowDuration)
                    endif
                    if push > 0.0 then
                        call s__ItemsElementsFx_Push(s__ItemsElementsFx_c[this] , v , Atan2(s__ItemsElementsFx_vy[this], s__ItemsElementsFx_vx[this]) , push , 0.3)
                    endif
                endif
            endloop
        endfunction

        function s__ItemsElementsFx_Disarm takes unit c,unit u returns nothing
            local integer m= s__ItemsElementsFx_Find(s__ItemsElementsFx_DISARM , null , u)
            if m == 0 then
                set m=s__ItemsElementsFx_Add(s__ItemsElementsFx_DISARM , LeviathanAnchor_ID , c , u , 2.0)
                call BlzUnitDisableAbility(u, 'Aatk', true, false)
            else
                set s__ItemsElementsFx_left[m]=2.0
            endif
        endfunction

        function s__ItemsElementsFx_DragCaught takes integer this,real px,real py returns nothing
            local unit v
            local real a
            local real d
            call GroupEnumUnitsInRange(ItemsElements_Group, px, py, 10000.0, NoDecor_Cond)
            loop
                set v=FirstOfGroup(ItemsElements_Group)
                exitwhen v == null
                call GroupRemoveUnit(ItemsElements_Group, v)
                if IsUnitInGroup(v, s__ItemsElementsFx_g[this]) and ItemsSpells__ElemValid(s__ItemsElementsFx_c[this] , v) then
                    set a=Atan2(py - GetUnitY(v), px - GetUnitX(v))
                    set d=SquareRoot(( px - GetUnitX(v) ) * ( px - GetUnitX(v) ) + ( py - GetUnitY(v) ) * ( py - GetUnitY(v) ))
                    set d=RMinBJ(ConstellationCoil_Speed * s__ItemsElementsFx_DT, RMaxBJ(0.0, d - 60.0))
                    call ItemsSpells__ElemStep(v , d * Cos(a) , d * Sin(a))
                endif
            endloop
            set v=null
        endfunction

        function s__ItemsElementsFx_MirrorMark takes unit c,unit u returns nothing
            local integer m= s__ItemsElementsFx_Mark(s__ItemsElementsFx_MIRROR , MirrorTide_ID , c , u , 4.0 , "")
            if s__ItemsElementsFx_g[m] == null then
                set s__ItemsElementsFx_g[m]=CreateGroup()
            endif
            set s__ItemsElementsFx_charges[m]=4
            set s__ItemsElementsFx_step[m]=0.0
            set s__ItemsElementsFx_dmg2[m]=MirrorTide_Reflect * (I2R(GetHeroAgi((c), true))) // INLINED!!
        endfunction

        function s__ItemsElementsFx_ThreadPulse takes integer this returns nothing
            local real ax= GetUnitX(s__ItemsElementsFx_c[this])
            local real ay= GetUnitY(s__ItemsElementsFx_c[this])
            local real bx= GetUnitX(s__ItemsElementsFx_u[this])
            local real by= GetUnitY(s__ItemsElementsFx_u[this])
            local real dx= bx - ax
            local real dy= by - ay
            local unit v
            if ItemsSpells__ElemValid(s__ItemsElementsFx_c[this] , s__ItemsElementsFx_u[this]) then
                call ItemsSpells__ElemHit(s__ItemsElementsFx_c[this] , s__ItemsElementsFx_u[this] , s__ItemsElementsFx_src[this] , s__ItemsElementsFx_tx[this] , true , 0)
            endif
            call GroupEnumUnitsInRange(s__ItemsElementsFx_g[this], ( ax + bx ) * 0.5, ( ay + by ) * 0.5, SquareRoot(dx * dx + dy * dy) * 0.5 + VoltThread_LineRadius, NoDecor_Cond)
            loop
                set v=FirstOfGroup(s__ItemsElementsFx_g[this])
                exitwhen v == null
                call GroupRemoveUnit(s__ItemsElementsFx_g[this], v)
                if v != s__ItemsElementsFx_u[this] and ItemsSpells__ElemValid(s__ItemsElementsFx_c[this] , v) and ItemsSpells__ElemNearSegment(GetUnitX(v) , GetUnitY(v) , ax , ay , bx , by , VoltThread_LineRadius) then
                    call ItemsSpells__ElemHit(s__ItemsElementsFx_c[this] , v , s__ItemsElementsFx_src[this] , s__ItemsElementsFx_dmg[this] , true , 0)
                endif
            endloop
            set v=null
        endfunction

