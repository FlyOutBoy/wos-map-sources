                                call BlzSetSpecialEffectTimeScale(s___ErzaTSpells__Erza5Q_KS_ee[s__ErzaTSpells__Erza5Q_KS_ee[this]+s__ErzaTSpells__Erza5Q_KS_k[this]], 0.4)
