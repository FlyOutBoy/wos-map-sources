                    if s__PatriotSpells___PatriotSpells_T2_r[this] > PatriotT2_CastTime and s__PatriotSpells___PatriotSpells_T2_r[this] <= 1.95 then
                        call MoveEff(s__PatriotSpells___PatriotSpells_T2_e[this] , s__PatriotSpells___PatriotSpells_T2_r6[this] , s__PatriotSpells___PatriotSpells_T2_a[this])
                        call BlzSetSpecialEffectHeight(s__PatriotSpells___PatriotSpells_T2_e[this], BlzGetLocalSpecialEffectZ(s__PatriotSpells___PatriotSpells_T2_e[this]) + s__PatriotSpells___PatriotSpells_T2_r5[this])
                        call MoveEff(s__PatriotSpells___PatriotSpells_T2_e2[this] , s__PatriotSpells___PatriotSpells_T2_r6[this] , s__PatriotSpells___PatriotSpells_T2_a[this])
                        call BlzSetSpecialEffectHeight(s__PatriotSpells___PatriotSpells_T2_e2[this], BlzGetLocalSpecialEffectZ(s__PatriotSpells___PatriotSpells_T2_e2[this]) + s__PatriotSpells___PatriotSpells_T2_r5[this])
                        call MoveEff(s__PatriotSpells___PatriotSpells_T2_e4[this] , s__PatriotSpells___PatriotSpells_T2_r6[this] , s__PatriotSpells___PatriotSpells_T2_a[this])
                        call BlzSetSpecialEffectHeight(s__PatriotSpells___PatriotSpells_T2_e4[this], BlzGetLocalSpecialEffectZ(s__PatriotSpells___PatriotSpells_T2_e4[this]) + s__PatriotSpells___PatriotSpells_T2_r5[this])
                        call MoveEff(s__PatriotSpells___PatriotSpells_T2_e5[this] , s__PatriotSpells___PatriotSpells_T2_r6[this] , s__PatriotSpells___PatriotSpells_T2_a[this])
                        call BlzSetSpecialEffectHeight(s__PatriotSpells___PatriotSpells_T2_e5[this], BlzGetLocalSpecialEffectZ(s__PatriotSpells___PatriotSpells_T2_e[this]))
                        call MoveEff(s__PatriotSpells___PatriotSpells_T2_e6[this] , s__PatriotSpells___PatriotSpells_T2_r6[this] , s__PatriotSpells___PatriotSpells_T2_a[this])
                        call BlzSetSpecialEffectHeight(s__PatriotSpells___PatriotSpells_T2_e6[this], BlzGetLocalSpecialEffectZ(s__PatriotSpells___PatriotSpells_T2_e[this]))

                        if s__PatriotSpells___PatriotSpells_T2_r2[this] > 0.03 then
