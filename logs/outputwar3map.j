    endif
    // Sacred Gear Booster: прок во время каста предмета (не способности героя) — КД этого предмета -N сек.
    if check == 0 and SacredGearBooster_Proc then
    call s__GearSystems2___KS_Cooldown_CD_Start((c ) , (( 0.03 )*1.0) , ( id ) , (( RMaxBJ(0.01, rr - SacredGearBooster_ItemCDReduce))*1.0)) // INLINED!!
    endif

        if check == 1 then
