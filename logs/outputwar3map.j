    // G: 1 заряд (PassiveCD) по умолчанию, 2 заряда с 25 уровня, 3 заряда в T.
    function BambiettaG_SyncStacks takes unit c returns nothing
        local integer maxStacks= 0
        if LoadInteger(hs, GetHandleId(GetOwningPlayer(c)), BambiettaSpells__SH_MORPH_T) > 0 then
            set maxStacks=BambiettaG_StacksT
        elseif GetHeroLevel(c) >= BambiettaG_Lvl_Stacks then
            set maxStacks=BambiettaG_Stacks25
        endif
        if maxStacks > 0 and (s__KS_SpellStacks_GetMaxStackCount((c))) != maxStacks then // INLINED!!
            if (LoadInteger(hs, GetHandleId(((c))), GearSystems2___SH_STACK_COUNT)) > maxStacks then // INLINED!!
                call SaveInteger(hs, GetHandleId(c), BambiettaSpells__SH_STACK_COUNT, maxStacks)
            endif
            call s__KS_SpellStacks_MyAddSpellStacks_Start((c ) , BambiettaG_ID , BambiettaG_ID , ( maxStacks ) , (( BambiettaG_CD)*1.0)) // INLINED!!
        endif
    endfunction

