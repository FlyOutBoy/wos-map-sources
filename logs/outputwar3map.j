        endif
        loop
            exitwhen k > 3
            if LoadUnitHandle(hs, GetHandleId(c), GearKey(GEAR_KEY_DUMMY , "dummy" , k)) == d then
                call SaveUnitHandle(hs, GetHandleId(c), GearKey(GEAR_KEY_DUMMY , "dummy" , k), null)
            endif
            set k=k + 1
        endloop
        call PauseUnit(d, true)
        call ColorDummy3(d , 0 , 255 , 255 , 255 , 0.4)
    endfunction

