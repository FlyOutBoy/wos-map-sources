    function AlucardSpells__AlucardTick05_On takes integer k returns nothing
        if not AlucardSpells__AlucardTick05_Active[k] then
            set AlucardSpells__AlucardTick05_Active[k]=true
            set AlucardSpells__AlucardTick05_Users=AlucardSpells__AlucardTick05_Users + 1
            if AlucardSpells__AlucardTick05_Users == 1 then
                call TimerStart(AlucardSpells__AlucardTick05_Timer, 0.05, true, AlucardSpells__AlucardTick05_Callback)
            endif
        endif
    endfunction

    function AlucardSpells__AlucardTick05_Off takes integer k returns nothing
        if AlucardSpells__AlucardTick05_Active[k] then
            set AlucardSpells__AlucardTick05_Active[k]=false
            set AlucardSpells__AlucardTick05_Users=AlucardSpells__AlucardTick05_Users - 1
            if AlucardSpells__AlucardTick05_Users <= 0 then
                set AlucardSpells__AlucardTick05_Users=0
                call PauseTimer(AlucardSpells__AlucardTick05_Timer)
            endif
        endif
    endfunction


    function AlucardSpells__AlucardTick_On takes integer k returns nothing
        if not AlucardSpells__AlucardTick_Active[k] then
            set AlucardSpells__AlucardTick_Active[k]=true
            set AlucardSpells__AlucardTick_Users=AlucardSpells__AlucardTick_Users + 1
            if AlucardSpells__AlucardTick_Users == 1 then
                call TimerStart(AlucardSpells__AlucardTick_Timer, 0.03, true, AlucardSpells__AlucardTick_Callback)
            endif
        endif
    endfunction

    function AlucardSpells__AlucardTick_Off takes integer k returns nothing
        if AlucardSpells__AlucardTick_Active[k] then
            set AlucardSpells__AlucardTick_Active[k]=false
            set AlucardSpells__AlucardTick_Users=AlucardSpells__AlucardTick_Users - 1
            if AlucardSpells__AlucardTick_Users <= 0 then
                set AlucardSpells__AlucardTick_Users=0
                call PauseTimer(AlucardSpells__AlucardTick_Timer)
            endif
        endif
    endfunction


    // Взводит снижение КД на текущий каст (одно срабатывание на каст).
    function AlucardSpells__AlucardT_ArmCDR takes unit c,integer baseAbil returns nothing
        call SaveInteger(hs, GetHandleId(c), AlucardSpells__SH_ALUCARD_T_CDR + baseAbil, 1)
    endfunction

    // Вызывается из DmgSys: урон от способности Алукарда по цели с меткой T.
    function AlucardT_MarkedHit takes unit c,integer damageSourceId returns nothing
        local integer baseAbil= 0
        local real cd
        if damageSourceId == AlucardQ_ID or damageSourceId == AlucardQ2_ID then
            set baseAbil=AlucardQ_ID
        elseif damageSourceId == AlucardW_ID or damageSourceId == AlucardW2_ID then
            set baseAbil=AlucardW_ID
        elseif damageSourceId == AlucardE_ID then
            set baseAbil=AlucardE_ID
        endif
        if baseAbil == 0 or LoadInteger(hs, GetHandleId(c), AlucardSpells__SH_ALUCARD_T_CDR + damageSourceId) == 0 then
            return
        endif
        set cd=BlzGetUnitAbilityCooldownRemaining(c, baseAbil)
        if cd > 0 then
            call SaveInteger(hs, GetHandleId(c), AlucardSpells__SH_ALUCARD_T_CDR + damageSourceId, 0)
            call ReduceCooldown(c , baseAbil , cd * AlucardT_CDReduce / 100)
        endif
    endfunction

        function s__AlucardSpells__AlucardSpells_Utility_Loop_AlucardPas takes nothing returns nothing
            local integer this
            local integer i= 0
            local integer h
            local integer sh
            loop
                exitwhen i > s__AlucardSpells__AlucardSpells_Utility_MUI_AlucardPas
                set this=s__AlucardSpells__AlucardSpells_Utility_m_AlucardPas[i]
                if SpellBoolCaster(s__AlucardSpells__AlucardSpells_Utility_c[this]) and SpellBoolCaster(s__AlucardSpells__AlucardSpells_Utility_td[this]) and s__AlucardSpells__AlucardSpells_Utility_r[this] < s__AlucardSpells__AlucardSpells_Utility_rmax[this] and CheckCoordsInRect(gg_rct_Base , GetUnitX(s__AlucardSpells__AlucardSpells_Utility_td[this]) , GetUnitY(s__AlucardSpells__AlucardSpells_Utility_td[this])) == false then
                    set s__AlucardSpells__AlucardSpells_Utility_r[this]=s__AlucardSpells__AlucardSpells_Utility_r[this] + 0.03
                    set s__AlucardSpells__AlucardSpells_Utility_r[this]=RoundReal(s__AlucardSpells__AlucardSpells_Utility_r[this] , 3)
                    set s__AlucardSpells__AlucardSpells_Utility_x[this]=GetUnitX(s__AlucardSpells__AlucardSpells_Utility_td[this])
                    set s__AlucardSpells__AlucardSpells_Utility_y[this]=GetUnitY(s__AlucardSpells__AlucardSpells_Utility_td[this])
                    set s__AlucardSpells__AlucardSpells_Utility_a[this]=GAngle(s__AlucardSpells__AlucardSpells_Utility_c[this] , s__AlucardSpells__AlucardSpells_Utility_td[this]) * bj_RADTODEG
                    set s__AlucardSpells__AlucardSpells_Utility_a2[this]=( GetUnitFacing(s__AlucardSpells__AlucardSpells_Utility_c[this]) - s__AlucardSpells__AlucardSpells_Utility_a[this] )
                    if s__AlucardSpells__AlucardSpells_Utility_a2[this] < 0 then
                        set s__AlucardSpells__AlucardSpells_Utility_a2[this]=- s__AlucardSpells__AlucardSpells_Utility_a2[this]
                    endif
                    if s__AlucardSpells__AlucardSpells_Utility_a2[this] > 180.0 then
                        set s__AlucardSpells__AlucardSpells_Utility_a2[this]=360.0 - s__AlucardSpells__AlucardSpells_Utility_a2[this]
                    endif
                    if s__AlucardSpells__AlucardSpells_Utility_a2[this] <= AlucardF_MSBonusAngleCap then
                        if GetUnitAbilityLevel(s__AlucardSpells__AlucardSpells_Utility_c[this], AlucardF_AdditionalMoveSpeed_ID) == 0 then
                            call UnitAddAbility(s__AlucardSpells__AlucardSpells_Utility_c[this], AlucardF_AdditionalMoveSpeed_ID)
                            call AddSpellLevel(s__AlucardSpells__AlucardSpells_Utility_c[this] , 'A01C' , 10 , true)
                        endif
                    else
                        if GetUnitAbilityLevel(s__AlucardSpells__AlucardSpells_Utility_c[this], AlucardF_AdditionalMoveSpeed_ID) > 0 then
                            call AddSpellLevel(s__AlucardSpells__AlucardSpells_Utility_c[this] , 'A01C' , 10 , false)
                            call UnitRemoveAbility(s__AlucardSpells__AlucardSpells_Utility_c[this], AlucardF_AdditionalMoveSpeed_ID)
                        endif
                    endif
                    if SR0(s__AlucardSpells__AlucardSpells_Utility_x[this] , s__AlucardSpells__AlucardSpells_Utility_y[this] , s__AlucardSpells__AlucardSpells_Utility_x1[this] , s__AlucardSpells__AlucardSpells_Utility_y1[this]) > AlucardF_VisionAoe / 6 then
                        set s__AlucardSpells__AlucardSpells_Utility_x1[this]=s__AlucardSpells__AlucardSpells_Utility_x[this]
                        set s__AlucardSpells__AlucardSpells_Utility_y1[this]=s__AlucardSpells__AlucardSpells_Utility_y[this]
                        call DestroyFogModifier(s__AlucardSpells__AlucardSpells_Utility_fg[this])
                        set s__AlucardSpells__AlucardSpells_Utility_fg[this]=null
                        set s__AlucardSpells__AlucardSpells_Utility_fg[this]=CreateFogModifierRadius(GetOwningPlayer(s__AlucardSpells__AlucardSpells_Utility_c[this]), FOG_OF_WAR_VISIBLE, s__AlucardSpells__AlucardSpells_Utility_x[this], s__AlucardSpells__AlucardSpells_Utility_y[this], AlucardF_VisionAoe, false, false)
                        call FogModifierStart(s__AlucardSpells__AlucardSpells_Utility_fg[this])
                    endif
                    call EffVision(s__AlucardSpells__AlucardSpells_Utility_e[this] , s__AlucardSpells__AlucardSpells_Utility_td[this])
                    call BlzSetSpecialEffectPosition(s__AlucardSpells__AlucardSpells_Utility_e[this], s__AlucardSpells__AlucardSpells_Utility_x[this], s__AlucardSpells__AlucardSpells_Utility_y[this], GetUnitFlyHeight(s__AlucardSpells__AlucardSpells_Utility_td[this]) + 195)
                    call FogModifierStart(s__AlucardSpells__AlucardSpells_Utility_fg[this])
                else
                    call SaveInteger(hs, GetHandleId(s__AlucardSpells__AlucardSpells_Utility_td[this]), AlucardSpells__SH_ALUCARD_PAS, 0)
                        if GetUnitAbilityLevel(s__AlucardSpells__AlucardSpells_Utility_c[this], AlucardF_AdditionalMoveSpeed_ID) > 0 then
                            call AddSpellLevel(s__AlucardSpells__AlucardSpells_Utility_c[this] , 'A01C' , 10 , false)
                            call UnitRemoveAbility(s__AlucardSpells__AlucardSpells_Utility_c[this], AlucardF_AdditionalMoveSpeed_ID)
                        endif
                        call PassiveCD_Start(s__AlucardSpells__AlucardSpells_Utility_c[this] , AlucardF_ID , 10)
                    call DestroyEffect(s__AlucardSpells__AlucardSpells_Utility_e[this])
                    call DestroyFogModifier(s__AlucardSpells__AlucardSpells_Utility_fg[this])
                    call s__GearSystems2___KS_Flush_Start((GetHandleId(s__AlucardSpells__AlucardSpells_Utility_c[this]) ) , ( AlucardSpells__SH_ALUCARD_PAS_VISION ) , ( 0 ) , (( AlucardF_Cooldown)*1.0)) // INLINED!!
                    set s__AlucardSpells__AlucardSpells_Utility_c[this]=null
                    set s__AlucardSpells__AlucardSpells_Utility_td[this]=null
                    set s__AlucardSpells__AlucardSpells_Utility_fg[this]=null
                    set s__AlucardSpells__AlucardSpells_Utility_e[this]=null
                    set s__AlucardSpells__AlucardSpells_Utility_e2[this]=null
                    set s__AlucardSpells__AlucardSpells_Utility_m_AlucardPas[i]=s__AlucardSpells__AlucardSpells_Utility_m_AlucardPas[s__AlucardSpells__AlucardSpells_Utility_MUI_AlucardPas]
                    set s__AlucardSpells__AlucardSpells_Utility_MUI_AlucardPas=s__AlucardSpells__AlucardSpells_Utility_MUI_AlucardPas - 1
                    set i=i - 1 // revisit: the moved instance must not skip this tick
                    if s__AlucardSpells__AlucardSpells_Utility_MUI_AlucardPas == - 1 then
                        call AlucardSpells__AlucardTick_Off(0)
                    endif
                    call s__AlucardSpells__AlucardSpells_Utility_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction

        function s__AlucardSpells__AlucardSpells_Utility_AlucardPas_Start takes unit NewC,unit NewTd returns nothing
            local integer this= s__AlucardSpells__AlucardSpells_Utility__allocate()
            set s__AlucardSpells__AlucardSpells_Utility_MUI_AlucardPas=s__AlucardSpells__AlucardSpells_Utility_MUI_AlucardPas + 1
            set s__AlucardSpells__AlucardSpells_Utility_m_AlucardPas[s__AlucardSpells__AlucardSpells_Utility_MUI_AlucardPas]=this
            set s__AlucardSpells__AlucardSpells_Utility_c[this]=NewC
            set s__AlucardSpells__AlucardSpells_Utility_td[this]=NewTd
            set s__AlucardSpells__AlucardSpells_Utility_x[this]=GetUnitX(s__AlucardSpells__AlucardSpells_Utility_td[this])
            set s__AlucardSpells__AlucardSpells_Utility_y[this]=GetUnitY(s__AlucardSpells__AlucardSpells_Utility_td[this])
            set s__AlucardSpells__AlucardSpells_Utility_x1[this]=s__AlucardSpells__AlucardSpells_Utility_x[this]
