            if AlucardSpells__AlucardTick05_Active[0] then
                call s__AlucardSpells__AlucardSpells_Utility_Loop_AlucardPas2()
            endif
            if AlucardSpells__AlucardTick05_Active[1] then
                call s__AlucardSpells__AlucardSpells_W_Loop_AlucardW()
            endif
            if AlucardSpells__AlucardTick05_Active[2] then
                call s__AlucardSpells__AlucardSpells_R_Loop_AlucardR()
            endif
            if AlucardSpells__AlucardTick05_Active[3] then
                call s__AlucardSpells__AlucardSpells_T_Loop_AlucardT()
            endif
        endfunction

        function s__AlucardSpells__AlucardTick05_Loop_onInit takes nothing returns nothing
