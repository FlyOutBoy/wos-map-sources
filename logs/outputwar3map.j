        set s__RimuruSpells___Rimuru3R_KS_rmax[this]=1.8
        set s__RimuruSpells___Rimuru3R_KS_e2[this]=EffectSpawn("war3mapImported\\wos_blackwhiteaura_3.mdl" , GetUnitX(s__RimuruSpells___Rimuru3R_KS_c[this]) , GetUnitY(s__RimuruSpells___Rimuru3R_KS_c[this]) , s__RimuruSpells___Rimuru3R_KS_a[this] * bj_RADTODEG , 1.5 , 1 , 1)
        set s__RimuruSpells___Rimuru3R_KS_aoe[this]=RimuruR3_DamageAoe
        call SaveInteger(hs, GetHandleId(s__RimuruSpells___Rimuru3R_KS_c[this]), RimuruSpells___SH_RIMURU_R3_INVUL, 1)
        if LoadInteger(hs, GetHandleId(s__RimuruSpells___Rimuru3R_KS_c[this]), RimuruSpells___SH_RIM_MAIN_STAT) == 0 then
        set s__RimuruSpells___Rimuru3R_KS_dmg[this]=GetHeroInt(s__RimuruSpells___Rimuru3R_KS_c[this], true) * ( RimuruR3_DamageIntBase )
        else
