    call SaveInteger(hs, GetHandleId(c), RimuruSpells___SH_DODGE_Q, 0)
    call RimuruSpells___RimuruTrackDodges(c , RimuruQ2_ID , RimuruQ2_Buff_ID)
    call BuffUnit1(c , c , 9)
    call MakeSound("war3mapimported\\Hero_Rimuru2_Q")
    call s__GearSystems2___KS_DelayedSound_NextSound_Start(("war3mapimported\\Hero_Rimuru2_Q2" ) , (( 1.5)*1.0)) // INLINED!!
    call s__GearSystems2___KS_FlushBuff_Start((GetHandleId(c) ) , ( RimuruSpells___SH_DODGE_Q ) , ( 0 ) , ( c ) , ( RimuruQ2_Buff_ID)) // INLINED!!
