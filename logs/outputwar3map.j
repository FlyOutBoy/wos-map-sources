        function s__BrandishSpells__BrandishSpells_T_BrandishT_Start takes unit NewC returns nothing
            local integer this= s__BrandishSpells__BrandishSpells_T__allocate()
            set s__BrandishSpells__BrandishSpells_T_MUI_BrandishT=s__BrandishSpells__BrandishSpells_T_MUI_BrandishT + 1
            set s__BrandishSpells__BrandishSpells_T_m_BrandishT[s__BrandishSpells__BrandishSpells_T_MUI_BrandishT]=this
            set s__BrandishSpells__BrandishSpells_T_c[this]=NewC
            set s__BrandishSpells__BrandishSpells_T_r[this]=0.0
            set s__BrandishSpells__BrandishSpells_T_x[this]=GetUnitX(s__BrandishSpells__BrandishSpells_T_c[this])
            set s__BrandishSpells__BrandishSpells_T_y[this]=GetUnitY(s__BrandishSpells__BrandishSpells_T_c[this])
            set s__BrandishSpells__BrandishSpells_T_g[this]=CreateGroup()
            set s__BrandishSpells__BrandishSpells_T_g2[this]=CreateGroup()
            set s__BrandishSpells__BrandishSpells_T_dmg[this]=GetHeroInt(s__BrandishSpells__BrandishSpells_T_c[this], true) * BrandishT_DamageIntBase
            set s__BrandishSpells__BrandishSpells_T_dmg2[this]=GetHeroInt(s__BrandishSpells__BrandishSpells_T_c[this], true) * BrandishT_DamageIntBase2
            set s__BrandishSpells__BrandishSpells_T_r2[this]=0.0
            set s__BrandishSpells__BrandishSpells_T_check2[this]=0
            set s__BrandishSpells__BrandishSpells_T_r4[this]=BrandishT_CastTime + BrandishT_Duration
            set s__BrandishSpells__BrandishSpells_T_rmax[this]=s__BrandishSpells__BrandishSpells_T_r4[this] + 0.50
            if GetHeroLevel(s__BrandishSpells__BrandishSpells_T_c[this]) >= 35 then
                set s__BrandishSpells__BrandishSpells_T_check2[this]=1
                set s__BrandishSpells__BrandishSpells_T_r4[this]=BrandishT_CastTime + BrandishT_Lv35Duration
                set s__BrandishSpells__BrandishSpells_T_rmax[this]=s__BrandishSpells__BrandishSpells_T_r4[this] + 0.50
            endif
            set s__BrandishSpells__BrandishSpells_T_scale[this]=s__BrandishSpells_Utility_GetTotalScale(s__BrandishSpells__BrandishSpells_T_c[this])
            call SaveReal(BrandishSpells__hs, GetHandleId(s__BrandishSpells__BrandishSpells_T_c[this]), BrandishSpells__SH_TMULT, BrandishT_ScaleIncrease / 100.0)
            set s__BrandishSpells__BrandishSpells_T_scale2[this]=s__BrandishSpells_Utility_GetTotalScale(s__BrandishSpells__BrandishSpells_T_c[this])
            call ScaleDummy(s__BrandishSpells__BrandishSpells_T_c[this] , 0.75 , s__BrandishSpells__BrandishSpells_T_scale[this] , s__BrandishSpells__BrandishSpells_T_scale2[this])
            set s__BrandishSpells__BrandishSpells_T_aoe[this]=BrandishT_DamageAoe
            if GetUnitAbilityLevel(s__BrandishSpells__BrandishSpells_T_c[this], BrandishF_Buff_ID) > 0 then
                set s__BrandishSpells__BrandishSpells_T_r8[this]=s__BrandishSpells__BrandishSpells_T_aoe[this] * ( 1.0 + ( BrandishF_DamageOutputIncrease / 100.0 ) )
            else
                set s__BrandishSpells__BrandishSpells_T_r8[this]=s__BrandishSpells__BrandishSpells_T_aoe[this]
            endif
            call StartSpellUnit(s__BrandishSpells__BrandishSpells_T_c[this])
            set s__BrandishSpells__BrandishSpells_T_a[this]=GetUnitFacing(s__BrandishSpells__BrandishSpells_T_c[this]) * bj_DEGTORAD
            call MakeSound("war3mapimported\\Hero_Brandish_T1")
            call MakeSound("war3mapimported\\Hero_Brandish_T3")
            call VisionTimed(GetOwningPlayer(s__BrandishSpells__BrandishSpells_T_c[this]) , GetUnitX(s__BrandishSpells__BrandishSpells_T_c[this]) , GetUnitY(s__BrandishSpells__BrandishSpells_T_c[this]) , 1800.0 , 4.0)
            call SaveInteger(BrandishSpells__hs, GetHandleId(s__BrandishSpells__BrandishSpells_T_c[this]), BrandishSpells__SH_T, 1)
            call SetUnitFacingTimed(s__BrandishSpells__BrandishSpells_T_c[this], s__BrandishSpells__BrandishSpells_T_a[this] * bj_RADTODEG, 0.0)
            call SetUnitTimeScale(s__BrandishSpells__BrandishSpells_T_c[this], 2.0 * 0.70 / 0.90)
            if s__BrandishSpells__BrandishSpells_T_MUI_BrandishT == 0 then
                call BrandishSpells__BrandishTimer05Acquire()
            endif
        endfunction

