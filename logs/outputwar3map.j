                set s__GearSystems2___KS_BuffTimer_r[this]=0
                set s__GearSystems2___KS_BuffTimer_drawn[this]=0
            if not reused and s__GearSystems2___KS_BuffTimer_MUI_28 == 0 then
                call GearTimer10Acquire()
            endif
        endfunction



        function s__GearSystems2___KS_BuffEffect_Loop_MyBuffEff takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__GearSystems2___KS_BuffEffect_MUI_29
                set this=s__GearSystems2___KS_BuffEffect_m_29[i]
                if s__GearSystems2___KS_BuffEffect_r[this] < s__GearSystems2___KS_BuffEffect_rmax[this] and GetUnitAbilityLevel(s__GearSystems2___KS_BuffEffect_c[this], s__GearSystems2___KS_BuffEffect_id[this]) > 0 then
                    set s__GearSystems2___KS_BuffEffect_r[this]=I2R(R2I(( s__GearSystems2___KS_BuffEffect_r[this] + 0.1 ) * 1000.0 + 0.5)) / 1000.0
                    else
                    call DestroyEffect(s__GearSystems2___KS_BuffEffect_e[this])
                    set s__GearSystems2___KS_BuffEffect_e[this]=null
                    set s__GearSystems2___KS_BuffEffect_c[this]=null
                    set s__GearSystems2___KS_BuffEffect_m_29[i]=s__GearSystems2___KS_BuffEffect_m_29[s__GearSystems2___KS_BuffEffect_MUI_29]
                    set s__GearSystems2___KS_BuffEffect_MUI_29=s__GearSystems2___KS_BuffEffect_MUI_29 - 1
                    if s__GearSystems2___KS_BuffEffect_MUI_29 == - 1 then
                        call GearTimer10Release()
                    endif
                    call s__GearSystems2___KS_BuffEffect_deallocate(this)
                    set i=i - 1
                endif
                set i=i + 1
            endloop
        endfunction

        function s__GearSystems2___KS_BuffEffect_MyBuffEff_Start takes unit NewC,integer NewId,effect NewE returns nothing
            local integer this= s__GearSystems2___KS_BuffEffect__allocate()
            local real tmp_x= 0
            local real tmp_y= 0
            set s__GearSystems2___KS_BuffEffect_MUI_29=s__GearSystems2___KS_BuffEffect_MUI_29 + 1
            set s__GearSystems2___KS_BuffEffect_m_29[s__GearSystems2___KS_BuffEffect_MUI_29]=this
            set s__GearSystems2___KS_BuffEffect_c[this]=NewC
            set s__GearSystems2___KS_BuffEffect_id[this]=NewId
            set s__GearSystems2___KS_BuffEffect_e[this]=NewE
            set s__GearSystems2___KS_BuffEffect_rmax[this]=125
            set s__GearSystems2___KS_BuffEffect_k2[this]=GetPlayerId(GetOwningPlayer(s__GearSystems2___KS_BuffEffect_c[this]))
                set s__GearSystems2___KS_BuffEffect_r[this]=0
            if s__GearSystems2___KS_BuffEffect_MUI_29 == 0 then
                call GearTimer10Acquire()
            endif
        endfunction



        function s__GearSystems2___KS_FlushInteger_Loop_MyFlushIntegerC takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__GearSystems2___KS_FlushInteger_MUI_30
                set this=s__GearSystems2___KS_FlushInteger_m_30[i]
                if s__GearSystems2___KS_FlushInteger_r[this] < s__GearSystems2___KS_FlushInteger_rmax[this] then
                    if s__GearSystems2___KS_FlushInteger_b[this] == true then
                    set s__GearSystems2___KS_FlushInteger_r[this]=I2R(R2I(( s__GearSystems2___KS_FlushInteger_r[this] + 0.03 ) * 1000.0 + 0.5)) / 1000.0
                    elseif IsUnitPaused(s__GearSystems2___KS_FlushInteger_c[this]) == false then
                    set s__GearSystems2___KS_FlushInteger_r[this]=I2R(R2I(( s__GearSystems2___KS_FlushInteger_r[this] + 0.03 ) * 1000.0 + 0.5)) / 1000.0
                    endif
                    if LoadInteger(hs, s__GearSystems2___KS_FlushInteger_id[this], s__GearSystems2___KS_FlushInteger_child_id[this]) == s__GearSystems2___KS_FlushInteger_value[this] then
                        set s__GearSystems2___KS_FlushInteger_r[this]=9999
                    endif
                else
                    if s__GearSystems2___KS_FlushInteger_r[this] != 9999 then
                        call SaveInteger(hs, s__GearSystems2___KS_FlushInteger_id[this], s__GearSystems2___KS_FlushInteger_child_id[this], s__GearSystems2___KS_FlushInteger_value[this])
                    endif
                    set s__GearSystems2___KS_FlushInteger_c[this]=null
                    set s__GearSystems2___KS_FlushInteger_m_30[i]=s__GearSystems2___KS_FlushInteger_m_30[s__GearSystems2___KS_FlushInteger_MUI_30]
                    set s__GearSystems2___KS_FlushInteger_MUI_30=s__GearSystems2___KS_FlushInteger_MUI_30 - 1
                    if s__GearSystems2___KS_FlushInteger_MUI_30 == - 1 then
                        call GearTimer03Release()
                    endif
                    call s__GearSystems2___KS_FlushInteger_deallocate(this)
                    set i=i - 1
                endif
                set i=i + 1
            endloop
        endfunction

        function s__GearSystems2___KS_FlushInteger_MyFlushIC_Start takes unit NewC,integer NewChild_Id,integer NewValue,real NewRmax,boolean CountInPause returns nothing
            local integer this= s__GearSystems2___KS_FlushInteger__allocate()
            set s__GearSystems2___KS_FlushInteger_MUI_30=s__GearSystems2___KS_FlushInteger_MUI_30 + 1
            set s__GearSystems2___KS_FlushInteger_m_30[s__GearSystems2___KS_FlushInteger_MUI_30]=this
            set s__GearSystems2___KS_FlushInteger_r[this]=0
            set s__GearSystems2___KS_FlushInteger_c[this]=NewC
            set s__GearSystems2___KS_FlushInteger_b[this]=CountInPause
            set s__GearSystems2___KS_FlushInteger_rmax[this]=NewRmax
            set s__GearSystems2___KS_FlushInteger_id[this]=GetHandleId(s__GearSystems2___KS_FlushInteger_c[this])
            set s__GearSystems2___KS_FlushInteger_child_id[this]=NewChild_Id
            set s__GearSystems2___KS_FlushInteger_value[this]=NewValue
            if s__GearSystems2___KS_FlushInteger_MUI_30 == 0 then
                call GearTimer03Acquire()
            endif
        endfunction


    
// Фрагмент для замены KS_ItemStacks/KS_SpellStacks внутри GearSystems.
// В заголовок GearSystems добавьте: requires TasAbilityChargeBox


        function s__GearSystems2___KS_ItemStacks_Loop_AddStacks takes nothing returns nothing
            local integer this
            local integer i= 0
            local integer itemSlot
            local item stackItem
            loop
                exitwhen i > s__GearSystems2___KS_ItemStacks_MUI_31
                set this=s__GearSystems2___KS_ItemStacks_m_31[i]
                if s__GearSystems2___KS_ItemStacks_r[this] < s__GearSystems2___KS_ItemStacks_rmax[this] then
                    set s__GearSystems2___KS_ItemStacks_r[this]=I2R(R2I(( s__GearSystems2___KS_ItemStacks_r[this] + 0.05 ) * 1000.0 + 0.5)) / 1000.0
                else
                    // За время таймера предмет могли выбросить или передать.
                    set itemSlot=- 1
                    set stackItem=null
                    if s__GearSystems2___KS_ItemStacks_c[this] != null then
                        set itemSlot=IsItemInInventory3(s__GearSystems2___KS_ItemStacks_c[this] , s__GearSystems2___KS_ItemStacks_id[this])
                    endif
                    if itemSlot >= 0 then
                        set stackItem=UnitItemInSlot(s__GearSystems2___KS_ItemStacks_c[this], itemSlot)
                        if stackItem != null then
                            if s__GearSystems2___KS_ItemStacks_b[this] == true then
                                call SetItemCharges(stackItem, GetItemCharges(stackItem) + s__GearSystems2___KS_ItemStacks_check[this])
                            else
                                call SetItemCharges(stackItem, GetItemCharges(stackItem) - s__GearSystems2___KS_ItemStacks_check[this])
                            endif
                            if s__GearSystems2___KS_ItemStacks_id[this] == 'I01W' and GetItemCharges(stackItem) > 0 then
                                call BlzEndUnitAbilityCooldown(s__GearSystems2___KS_ItemStacks_c[this], 'A07O')
                            endif
                        endif
                    endif
                    set stackItem=null
                    set s__GearSystems2___KS_ItemStacks_c[this]=null
                    set s__GearSystems2___KS_ItemStacks_m_31[i]=s__GearSystems2___KS_ItemStacks_m_31[s__GearSystems2___KS_ItemStacks_MUI_31]
                    set s__GearSystems2___KS_ItemStacks_MUI_31=s__GearSystems2___KS_ItemStacks_MUI_31 - 1
                    if s__GearSystems2___KS_ItemStacks_MUI_31 == - 1 then
                        call GearTimer05Release()
                    endif
                    call s__GearSystems2___KS_ItemStacks_deallocate(this)
                    set i=i - 1
                endif
                set i=i + 1
            endloop
        endfunction

        function s__GearSystems2___KS_ItemStacks_MyAddStacks_Start takes unit NewC,integer NewItem_Id,integer NewStackAmount,real NewRmax,boolean AddOrRemove returns nothing
            local integer this= s__GearSystems2___KS_ItemStacks__allocate()
            set s__GearSystems2___KS_ItemStacks_MUI_31=s__GearSystems2___KS_ItemStacks_MUI_31 + 1
            set s__GearSystems2___KS_ItemStacks_m_31[s__GearSystems2___KS_ItemStacks_MUI_31]=this
            set s__GearSystems2___KS_ItemStacks_r[this]=0
            set s__GearSystems2___KS_ItemStacks_c[this]=NewC
            set s__GearSystems2___KS_ItemStacks_b[this]=AddOrRemove
            set s__GearSystems2___KS_ItemStacks_rmax[this]=NewRmax
            set s__GearSystems2___KS_ItemStacks_id[this]=NewItem_Id
            set s__GearSystems2___KS_ItemStacks_check[this]=NewStackAmount
            if s__GearSystems2___KS_ItemStacks_MUI_31 == 0 then
                call GearTimer05Acquire()
            endif
        endfunction

    

        // Минимальная пауза между применениями, пока у способности еще есть заряды.
        // Меняется в одном месте для всех экземпляров KS_SpellStacks.


        // Поля оставлены ради совместимости со старыми сохранениями структуры.
        // Визуал теперь полностью рисует TasAbilityChargeBox.

        function s__KS_SpellStacks_FindByUnit takes unit whichUnit returns integer
            local integer i= 0
            local integer data
            loop
                exitwhen i > s__KS_SpellStacks_lastInstance
                set data=s__KS_SpellStacks_instances[i]
                if s__KS_SpellStacks_c[data] == whichUnit then
                    return data
                endif
                set i=i + 1
            endloop
            return 0
        endfunction

        function s__KS_SpellStacks_GetSlotByXY takes integer x,integer y returns integer
            return y * 4 + x
        endfunction

        function s__KS_SpellStacks_CreateStackFrame takes integer this returns nothing
            // TasAbilityChargeBox сам создаёт и привязывает нужные фреймы.
        endfunction
        function s__KS_SpellStacks_RefreshStackFrameVisibility takes integer this,integer stackNum returns nothing
            if s__KS_SpellStacks_frameSuppressed[this] or stackNum <= 0 then
                call FlushChildHashtable(TasAbilityChargeBox_Hash, GetHandleId((s__KS_SpellStacks_c[this]))) // INLINED!!
            endif
        endfunction

        function s__KS_SpellStacks_DestroyStackFrame takes integer this returns nothing
            call FlushChildHashtable(TasAbilityChargeBox_Hash, GetHandleId((s__KS_SpellStacks_c[this]))) // INLINED!!
            if s__KS_SpellStacks_frameAbilityId[this] != 0 and s__KS_SpellStacks_c[this] != null then
                call BlzUnitDisableAbility(s__KS_SpellStacks_c[this], s__KS_SpellStacks_frameAbilityId[this], false, false)
            endif
            set s__KS_SpellStacks_frameIcon[this]=null
            set s__KS_SpellStacks_frameRoot[this]=null
        endfunction

        // The public signature stays unit + stack count. It finds that hero's
        // own structure instance and never touches another hero's frames.
        function s__KS_SpellStacks_UpdateStackFrame takes unit cu,integer stackNum returns nothing
            local integer data= s__KS_SpellStacks_FindByUnit(cu)
            local integer hid= GetHandleId(cu)

            if data == 0 then
                return
            endif

            if stackNum <= 0 then
                set stackNum=0
                call SaveInteger(hs, hid, GearSystems2___SH_STACK_COUNT, 0)
                call FlushChildHashtable(TasAbilityChargeBox_Hash, GetHandleId((cu))) // INLINED!!
                if s__KS_SpellStacks_frameAbilityId[data] != 0 then
                    // Нулевой счётчик скрываем, но саму кнопку не выключаем.
                    // Доступность способности регулирует её настоящий cooldown.
                    call BlzUnitDisableAbility(cu, s__KS_SpellStacks_frameAbilityId[data], false, false)
                endif
            else
                if stackNum > s__KS_SpellStacks_maxStacks[data] then
                    set stackNum=s__KS_SpellStacks_maxStacks[data]
                    call SaveInteger(hs, hid, GearSystems2___SH_STACK_COUNT, stackNum)
                endif
                if s__KS_SpellStacks_frameAbilityId[data] != 0 then
                    call BlzUnitDisableAbility(cu, s__KS_SpellStacks_frameAbilityId[data], false, false)
                endif
            endif
            if s__KS_SpellStacks_frameSuppressed[data] then
                call FlushChildHashtable(TasAbilityChargeBox_Hash, GetHandleId((cu))) // INLINED!!
            elseif s__KS_SpellStacks_frameAbilityId[data] != 0 and stackNum > 0 then
                call TasAbilityChargeBox_SetValue(cu , s__KS_SpellStacks_frameAbilityId[data] , I2S(stackNum))
            endif
            // Clear удаляет запись, а Update сразу скрывает сам FrameBox.
            // При первом положительном стаке эта же перерисовка возвращает окно.
            call TasAbilityChargeBox_Update()
        endfunction

        function s__KS_SpellStacks_RemoveAt takes integer index returns nothing
            local integer data= s__KS_SpellStacks_instances[index]

            call s__KS_SpellStacks_DestroyStackFrame(data)
            call SaveInteger(hs, GetHandleId(s__KS_SpellStacks_c[data]), GearSystems2___SH_STACK_COUNT, 0)
            set s__KS_SpellStacks_c[data]=null

            set s__KS_SpellStacks_instances[index]=s__KS_SpellStacks_instances[s__KS_SpellStacks_lastInstance]
            set s__KS_SpellStacks_lastInstance=s__KS_SpellStacks_lastInstance - 1
            if s__KS_SpellStacks_lastInstance == - 1 then
                call GearTimer05Release()
            endif
            call s__KS_SpellStacks_deallocate(data)
        endfunction

        function s__KS_SpellStacks_Loop_AddSpellStacks takes nothing returns nothing
            local integer this
            local integer i= 0
            local integer curStack

            loop
                exitwhen i > s__KS_SpellStacks_lastInstance
                set this=s__KS_SpellStacks_instances[i]

                if GetUnitTypeId(s__KS_SpellStacks_c[this]) == 0 or LoadInteger(hs, GetHandleId(s__KS_SpellStacks_c[this]), GearSystems2___SH_MORPH_END) == 1 then
                    call s__KS_SpellStacks_RemoveAt(i)
                    set i=i - 1
                else
                    set curStack=LoadInteger(hs, GetHandleId(s__KS_SpellStacks_c[this]), GearSystems2___SH_STACK_COUNT)

                    if not s__KS_SpellStacks_regenEnabled[this] then
                        set s__KS_SpellStacks_r[this]=0.00
                    elseif curStack == 0 and s__KS_SpellStacks_frameAbilityId[this] != 0 and BlzGetUnitAbilityCooldownRemaining(s__KS_SpellStacks_c[this], s__KS_SpellStacks_frameAbilityId[this]) <= 0.00 then
                        // Если движок не запустил cooldown, не оставляем героя
                        // навсегда с нулевым счётчиком: сразу возвращаем 1 заряд.
                        set s__KS_SpellStacks_r[this]=0.00
                        set curStack=1
                        call SaveInteger(hs, GetHandleId(s__KS_SpellStacks_c[this]), GearSystems2___SH_STACK_COUNT, curStack)
                        call s__KS_SpellStacks_UpdateStackFrame(s__KS_SpellStacks_c[this] , curStack)
                    elseif curStack < s__KS_SpellStacks_maxStacks[this] then
                        if s__KS_SpellStacks_instantRecharge[this] then
                            set s__KS_SpellStacks_r[this]=0.00
                            set curStack=s__KS_SpellStacks_maxStacks[this]
                            call SaveInteger(hs, GetHandleId(s__KS_SpellStacks_c[this]), GearSystems2___SH_STACK_COUNT, curStack)
                            call s__KS_SpellStacks_UpdateStackFrame(s__KS_SpellStacks_c[this] , curStack)
                        else
                            set s__KS_SpellStacks_r[this]=I2R(R2I(( s__KS_SpellStacks_r[this] + 0.05 ) * 1000.0 + 0.5)) / 1000.0
                            if s__KS_SpellStacks_r[this] >= s__KS_SpellStacks_rmax[this] then
                                set s__KS_SpellStacks_r[this]=s__KS_SpellStacks_r[this] - s__KS_SpellStacks_rmax[this]
                                set curStack=curStack + 1
                                call SaveInteger(hs, GetHandleId(s__KS_SpellStacks_c[this]), GearSystems2___SH_STACK_COUNT, curStack)
                                if s__KS_SpellStacks_cooldownAbilityId[this] != 0 then
                                    call BlzStartUnitAbilityCooldown(s__KS_SpellStacks_c[this], s__KS_SpellStacks_cooldownAbilityId[this], 0.2)
                                endif
                                // Снимаем ожидание восстановления только когда
                                // появился первый заряд. Если заряд уже был,
                                // не прерываем 0.25 между применениями.
                                if curStack == 1 and s__KS_SpellStacks_frameAbilityId[this] != 0 then
                                    call BlzEndUnitAbilityCooldown(s__KS_SpellStacks_c[this], s__KS_SpellStacks_frameAbilityId[this])
                                endif
                                call s__KS_SpellStacks_UpdateStackFrame(s__KS_SpellStacks_c[this] , curStack)
                            endif
                        endif
                    else
                        set s__KS_SpellStacks_r[this]=0.00
                        if curStack != s__KS_SpellStacks_maxStacks[this] then
                            set curStack=s__KS_SpellStacks_maxStacks[this]
                            call SaveInteger(hs, GetHandleId(s__KS_SpellStacks_c[this]), GearSystems2___SH_STACK_COUNT, curStack)
                        endif
                    endif

                    // This also switches UI correctly when the player selects
                    // another hero whose stack icon occupies the same slot.
                    call s__KS_SpellStacks_RefreshStackFrameVisibility(this,curStack)
                endif

                set i=i + 1
            endloop
        endfunction

        // frameAbilityId: ability whose command-card button receives the icon.
        // cooldownAbilityId: ability refreshed on charge gain; pass 0 if unused.
        function s__KS_SpellStacks_MyAddSpellStacks_Start takes unit NewC,integer NewFrameAbilityId,integer NewCooldownAbilityId,integer NewMaxStacks,real NewRmax returns nothing
            local integer this= s__KS_SpellStacks_FindByUnit(NewC)
            local integer curStack
            local integer oldAbilityId

            // Reconfigure an existing tracker instead of creating a duplicate.
            if this != 0 then
                set oldAbilityId=s__KS_SpellStacks_frameAbilityId[this]
                if oldAbilityId != 0 and oldAbilityId != NewFrameAbilityId then
                    call BlzUnitDisableAbility(s__KS_SpellStacks_c[this], oldAbilityId, false, false)
                endif
                set s__KS_SpellStacks_frameAbilityId[this]=NewFrameAbilityId
                set s__KS_SpellStacks_cooldownAbilityId[this]=NewCooldownAbilityId
                set s__KS_SpellStacks_maxStacks[this]=NewMaxStacks
                if s__KS_SpellStacks_maxStacks[this] < 1 then
                    set s__KS_SpellStacks_maxStacks[this]=1
                endif
                set s__KS_SpellStacks_rmax[this]=NewRmax
                set s__KS_SpellStacks_instantRecharge[this]=s__KS_SpellStacks_rmax[this] <= 0.00
                if s__KS_SpellStacks_rmax[this] < 0.05 then
                    set s__KS_SpellStacks_rmax[this]=0.05
                endif
                if s__KS_SpellStacks_r[this] > s__KS_SpellStacks_rmax[this] then
                    set s__KS_SpellStacks_r[this]=s__KS_SpellStacks_rmax[this]
                endif
                set s__KS_SpellStacks_regenEnabled[this]=true
                set s__KS_SpellStacks_frameSuppressed[this]=false
                call s__KS_SpellStacks_DestroyStackFrame(this)
                set curStack=LoadInteger(hs, GetHandleId(s__KS_SpellStacks_c[this]), GearSystems2___SH_STACK_COUNT)
                if s__KS_SpellStacks_instantRecharge[this] and curStack < s__KS_SpellStacks_maxStacks[this] then
                    set curStack=s__KS_SpellStacks_maxStacks[this]
                    call SaveInteger(hs, GetHandleId(s__KS_SpellStacks_c[this]), GearSystems2___SH_STACK_COUNT, curStack)
                endif
                call s__KS_SpellStacks_UpdateStackFrame(s__KS_SpellStacks_c[this] , curStack)
                call SaveInteger(hs, GetHandleId(s__KS_SpellStacks_c[this]), GearSystems2___SH_MORPH_END, 0)
                return
            endif

            set this=s__KS_SpellStacks__allocate()
            set s__KS_SpellStacks_c[this]=NewC
            set s__KS_SpellStacks_r[this]=0.00
            set s__KS_SpellStacks_rmax[this]=NewRmax
            set s__KS_SpellStacks_instantRecharge[this]=s__KS_SpellStacks_rmax[this] <= 0.00
            if s__KS_SpellStacks_rmax[this] < 0.05 then
                set s__KS_SpellStacks_rmax[this]=0.05
            endif
            set s__KS_SpellStacks_maxStacks[this]=NewMaxStacks
            if s__KS_SpellStacks_maxStacks[this] < 1 then
                set s__KS_SpellStacks_maxStacks[this]=1
            endif
            set s__KS_SpellStacks_frameAbilityId[this]=NewFrameAbilityId
            set s__KS_SpellStacks_cooldownAbilityId[this]=NewCooldownAbilityId
            set s__KS_SpellStacks_regenEnabled[this]=true
            set s__KS_SpellStacks_frameSuppressed[this]=false
            set s__KS_SpellStacks_frameRoot[this]=null
            set s__KS_SpellStacks_frameIcon[this]=null

            set s__KS_SpellStacks_lastInstance=s__KS_SpellStacks_lastInstance + 1
            set s__KS_SpellStacks_instances[s__KS_SpellStacks_lastInstance]=this

            call SaveInteger(hs, GetHandleId(s__KS_SpellStacks_c[this]), GearSystems2___SH_MORPH_END, 0)
            set curStack=LoadInteger(hs, GetHandleId(s__KS_SpellStacks_c[this]), GearSystems2___SH_STACK_COUNT)
            // Новая система зарядов начинает работу заполненной.
            if curStack <= 0 then
                set curStack=s__KS_SpellStacks_maxStacks[this]
                call SaveInteger(hs, GetHandleId(s__KS_SpellStacks_c[this]), GearSystems2___SH_STACK_COUNT, curStack)
            elseif curStack > s__KS_SpellStacks_maxStacks[this] then
                set curStack=s__KS_SpellStacks_maxStacks[this]
                call SaveInteger(hs, GetHandleId(s__KS_SpellStacks_c[this]), GearSystems2___SH_STACK_COUNT, curStack)
            endif
            call s__KS_SpellStacks_UpdateStackFrame(s__KS_SpellStacks_c[this] , curStack)

            if s__KS_SpellStacks_lastInstance == 0 then
                call GearTimer05Acquire()
            endif
        endfunction

        function s__KS_SpellStacks_DelayedCooldownResetCallback takes nothing returns nothing
            local timer resetTimer= GetExpiredTimer()
            local integer timerId= GetHandleId(resetTimer)
            local unit resetUnit= LoadUnitHandle(hs, timerId, GearSystems2___SH_KS_SPELLSTACKS_RESETUNIT)
            local integer abilityId= LoadInteger(hs, timerId, GearSystems2___SH_KS_SPELLSTACKS_RESETABILITY)
            local real cooldown= LoadReal(hs, timerId, GearSystems2___SH_KS_SPELLSTACKS_RESETCOOLDOWN)

            // Движок назначает cooldown после spell-event, поэтому меняем его с задержкой.
            if resetUnit != null and GetUnitTypeId(resetUnit) != 0 and abilityId != 0 then
                if LoadInteger(hs, GetHandleId(resetUnit), GearSystems2___SH_STACK_COUNT) > 0 then
                    // cooldown > 0 означает паузу между двумя оставшимися зарядами.
                    // cooldown == 0 используется при выдаче/полном сбросе зарядов.
                    if cooldown > 0.00 then
                        call BlzStartUnitAbilityCooldown(resetUnit, abilityId, cooldown)
                    else
                        call BlzEndUnitAbilityCooldown(resetUnit, abilityId)
                    endif
                else
                    if cooldown < s__KS_SpellStacks_STACK_USE_COOLDOWN then
                        set cooldown=s__KS_SpellStacks_STACK_USE_COOLDOWN
                    endif
                    call BlzStartUnitAbilityCooldown(resetUnit, abilityId, cooldown)
                endif
            endif

            call FlushChildHashtable(hs, timerId)
            call PauseTimer(resetTimer)
            call DestroyTimer(resetTimer)
            set resetUnit=null
            set resetTimer=null
        endfunction

        function s__KS_SpellStacks_ScheduleCooldownReset takes unit cu,integer abilityId,real cooldown returns nothing
            local timer resetTimer= CreateTimer()
            local integer timerId= GetHandleId(resetTimer)

            call SaveUnitHandle(hs, timerId, GearSystems2___SH_KS_SPELLSTACKS_RESETUNIT, cu)
            call SaveInteger(hs, timerId, GearSystems2___SH_KS_SPELLSTACKS_RESETABILITY, abilityId)
            call SaveReal(hs, timerId, GearSystems2___SH_KS_SPELLSTACKS_RESETCOOLDOWN, cooldown)
            call TimerStart(resetTimer, 0.03, false, function s__KS_SpellStacks_DelayedCooldownResetCallback)
            set resetTimer=null
        endfunction

        function s__KS_SpellStacks_MyRemoveStack takes unit cu returns nothing
            local integer data= s__KS_SpellStacks_FindByUnit(cu)
            local integer hid= GetHandleId(cu)
            local integer curStack= LoadInteger(hs, hid, GearSystems2___SH_STACK_COUNT)

            if data == 0 or curStack <= 0 then
                return
            endif

            set curStack=curStack - 1
            if s__KS_SpellStacks_instantRecharge[data] then
                set curStack=curStack + 1
                set s__KS_SpellStacks_r[data]=0.00
            endif
            call SaveInteger(hs, hid, GearSystems2___SH_STACK_COUNT, curStack)
            call s__KS_SpellStacks_UpdateStackFrame(cu , curStack)

            // Пока остались заряды, ставим короткую общую паузу между применениями.
            // На нуле показываем остаток до ближайшего восстановленного заряда.
            if s__KS_SpellStacks_frameAbilityId[data] != 0 then
                if curStack > 0 then
                    call s__KS_SpellStacks_ScheduleCooldownReset(cu , s__KS_SpellStacks_frameAbilityId[data] , s__KS_SpellStacks_STACK_USE_COOLDOWN)
                else
                    call s__KS_SpellStacks_ScheduleCooldownReset(cu , s__KS_SpellStacks_frameAbilityId[data] , s__KS_SpellStacks_rmax[data] - s__KS_SpellStacks_r[data])
                endif
            endif
        endfunction

        function s__KS_SpellStacks_GetStackCount takes unit cu returns integer
            return LoadInteger(hs, GetHandleId(cu), GearSystems2___SH_STACK_COUNT)
        endfunction

        function s__KS_SpellStacks_GetMaxStackCount takes unit cu returns integer
            local integer data= s__KS_SpellStacks_FindByUnit(cu)
            if data == 0 then
                return 0
            endif
            return s__KS_SpellStacks_maxStacks[data]
        endfunction

        // Sets the current amount and clamps it to 0..maxStacks.
        function s__KS_SpellStacks_SetStackCount takes unit cu,integer newAmount returns nothing
            local integer data= s__KS_SpellStacks_FindByUnit(cu)
            local integer hid= GetHandleId(cu)
            local integer oldAmount= LoadInteger(hs, hid, GearSystems2___SH_STACK_COUNT)

            if data == 0 then
                return
            endif
            if newAmount < 0 then
                set newAmount=0
            elseif newAmount > s__KS_SpellStacks_maxStacks[data] then
                set newAmount=s__KS_SpellStacks_maxStacks[data]
            endif

            call SaveInteger(hs, hid, GearSystems2___SH_STACK_COUNT, newAmount)
            call s__KS_SpellStacks_UpdateStackFrame(cu , newAmount)

            // Первый выданный заряд снимает ожидание восстановления. Добавление
            // зарядов поверх уже имеющихся не прерывает паузу между применениями.
            if oldAmount <= 0 and newAmount > 0 and s__KS_SpellStacks_frameAbilityId[data] != 0 then
                call s__KS_SpellStacks_ScheduleCooldownReset(cu , s__KS_SpellStacks_frameAbilityId[data] , 0.00)
            endif
        endfunction

        function s__KS_SpellStacks_AddStacks takes unit cu,integer amount returns nothing
            call s__KS_SpellStacks_SetStackCount(cu , (LoadInteger(hs, GetHandleId((cu)), GearSystems2___SH_STACK_COUNT)) + amount) // INLINED!!
        endfunction

        // Меняет время восстановления, не сбрасывая уже накопленный прогресс.
        function s__KS_SpellStacks_SetRechargeTime takes unit cu,real newRechargeTime returns nothing
            local integer data= s__KS_SpellStacks_FindByUnit(cu)
            if data == 0 then
                return
            endif
            set s__KS_SpellStacks_instantRecharge[data]=newRechargeTime <= 0.00
            if newRechargeTime < 0.05 then
                set newRechargeTime=0.05
            endif
            set s__KS_SpellStacks_rmax[data]=newRechargeTime
            if s__KS_SpellStacks_r[data] > s__KS_SpellStacks_rmax[data] then
                set s__KS_SpellStacks_r[data]=s__KS_SpellStacks_rmax[data]
            endif
            if s__KS_SpellStacks_instantRecharge[data] then
                call s__KS_SpellStacks_SetStackCount(cu , s__KS_SpellStacks_maxStacks[data])
            endif
        endfunction

        // grantDifference=true immediately grants every newly added max charge.
        // false only increases capacity; new charges then regenerate normally.
        function s__KS_SpellStacks_SetMaxStackCount takes unit cu,integer newMaximum,boolean grantDifference returns nothing
            local integer data= s__KS_SpellStacks_FindByUnit(cu)
            local integer oldMaximum
            local integer newAmount

            if data == 0 then
                return
            endif
            if newMaximum < 1 then
                set newMaximum=1
            endif

            set oldMaximum=s__KS_SpellStacks_maxStacks[data]
            set newAmount=(LoadInteger(hs, GetHandleId((cu)), GearSystems2___SH_STACK_COUNT)) // INLINED!!
            set s__KS_SpellStacks_maxStacks[data]=newMaximum

            if newAmount > newMaximum then
                set newAmount=newMaximum
            elseif grantDifference and newMaximum > oldMaximum then
                set newAmount=newAmount + newMaximum - oldMaximum
            endif

            call s__KS_SpellStacks_SetStackCount(cu , newAmount)
        endfunction

        function s__KS_SpellStacks_ChangeMaxStackCount takes unit cu,integer amount,boolean grantDifference returns nothing
            local integer data= s__KS_SpellStacks_FindByUnit(cu)
            if data == 0 then
                return
            endif
            call s__KS_SpellStacks_SetMaxStackCount(cu , s__KS_SpellStacks_maxStacks[data] + amount , grantDifference)
        endfunction

        function s__KS_SpellStacks_ClearStacks takes unit cu returns nothing
            call s__KS_SpellStacks_SetStackCount(cu , 0)
        endfunction

        function s__KS_SpellStacks_RestoreAllStacks takes unit cu returns nothing
            local integer data= s__KS_SpellStacks_FindByUnit(cu)
            if data == 0 then
                return
            endif

            set s__KS_SpellStacks_r[data]=0.00
            call s__KS_SpellStacks_SetStackCount(cu , s__KS_SpellStacks_maxStacks[data])

            // Для Escape полный сброс всегда должен сразу разрешать применение,
            // в том числе если до вызова уже оставался хотя бы один заряд.
            if s__KS_SpellStacks_maxStacks[data] > 0 and s__KS_SpellStacks_frameAbilityId[data] != 0 then
                call s__KS_SpellStacks_ScheduleCooldownReset(cu , s__KS_SpellStacks_frameAbilityId[data] , 0.00)
            endif
        endfunction

        // Stops regeneration. clearCurrent=true also removes existing charges.
        function s__KS_SpellStacks_PauseStacks takes unit cu,boolean clearCurrent returns nothing
    local integer data= s__KS_SpellStacks_FindByUnit(cu)
    local integer curStack
    if data == 0 then
        return
    endif
    set s__KS_SpellStacks_regenEnabled[data]=false
    set s__KS_SpellStacks_frameSuppressed[data]=true
    // Убирает накопленный прогресс текущего восстановления, как и раньше.
    set s__KS_SpellStacks_r[data]=0.00
    if clearCurrent then
        call s__KS_SpellStacks_SetStackCount(cu , 0)
    else
        set curStack=LoadInteger(hs, GetHandleId(cu), GearSystems2___SH_STACK_COUNT)
        call s__KS_SpellStacks_RefreshStackFrameVisibility(data,curStack)
    endif
endfunction

        // Starts regeneration again. restoreFull=true immediately fills charges.
       function s__KS_SpellStacks_ResumeStacks takes unit cu,boolean restoreFull returns nothing
    local integer data= s__KS_SpellStacks_FindByUnit(cu)
    local integer curStack
    if data == 0 then
        return
    endif
    set s__KS_SpellStacks_regenEnabled[data]=true
    set s__KS_SpellStacks_frameSuppressed[data]=false
    set s__KS_SpellStacks_r[data]=0.00
    if restoreFull then
        call s__KS_SpellStacks_SetStackCount(cu , s__KS_SpellStacks_maxStacks[data])
    else
        set curStack=LoadInteger(hs, GetHandleId(cu), GearSystems2___SH_STACK_COUNT)
        call s__KS_SpellStacks_UpdateStackFrame(cu , curStack)
    endif
endfunction

        function s__KS_SpellStacks_Stop takes unit cu returns nothing
            local integer i= 0
            local integer data
            loop
                exitwhen i > s__KS_SpellStacks_lastInstance
                set data=s__KS_SpellStacks_instances[i]
                if s__KS_SpellStacks_c[data] == cu then
                    call s__KS_SpellStacks_RemoveAt(i)
                    return
                endif
                set i=i + 1
            endloop
        endfunction

    // Backward-compatible Bambietta wrapper. Hero-specific IDs stay outside
    // KS_SpellStacks, so the structure itself remains reusable.
    function MySpellStacks takes unit c,integer stack_amount,real rechargeTime returns nothing
        call s__KS_SpellStacks_MyAddSpellStacks_Start(c , BambiettaG_ID , BambiettaG_ID , stack_amount , rechargeTime)
    endfunction

    // Generic entry point for every other hero.
    function MySpellStacksForAbility takes unit c,integer frameAbilityId,integer cooldownAbilityId,integer stack_amount,real rechargeTime returns nothing
        call s__KS_SpellStacks_MyAddSpellStacks_Start(c , frameAbilityId , cooldownAbilityId , stack_amount , rechargeTime)
    endfunction

    function MyRemoveStack takes unit c returns nothing
        call s__KS_SpellStacks_MyRemoveStack(c)
    endfunction

    // -------------------------------------------------------------------------
    // Simple public API. Use these functions from any hero/spell library.
    // -------------------------------------------------------------------------
    function SpellStacksStart takes unit c,integer abilityId,integer cooldownId,integer maximum,real rechargeTime returns nothing
        call s__KS_SpellStacks_MyAddSpellStacks_Start(c , abilityId , cooldownId , maximum , rechargeTime)
    endfunction

    function SpellStacksGet takes unit c returns integer
        return (LoadInteger(hs, GetHandleId((c)), GearSystems2___SH_STACK_COUNT)) // INLINED!!
    endfunction

    function SpellStacksGetMax takes unit c returns integer
        return s__KS_SpellStacks_GetMaxStackCount(c)
    endfunction

    function SpellStacksSet takes unit c,integer amount returns nothing
        call s__KS_SpellStacks_SetStackCount(c , amount)
    endfunction

    function SpellStacksAdd takes unit c,integer amount returns nothing
        call s__KS_SpellStacks_AddStacks(c , amount)
    endfunction

    function SpellStacksSetRechargeTime takes unit c,real rechargeTime returns nothing
        call s__KS_SpellStacks_SetRechargeTime(c , rechargeTime)
    endfunction

    // Use this after a successful cast. Returns false when no charge is available.
    function SpellStacksTryUse takes unit c returns boolean
        if s__KS_SpellStacks_GetMaxStackCount(c) <= 0 or (LoadInteger(hs, GetHandleId((c)), GearSystems2___SH_STACK_COUNT)) <= 0 then // INLINED!!
            return false
        endif
        call s__KS_SpellStacks_MyRemoveStack(c)
        return true
    endfunction

    function SpellStacksSetMax takes unit c,integer maximum,boolean grantDifference returns nothing
        call s__KS_SpellStacks_SetMaxStackCount(c , maximum , grantDifference)
    endfunction

    function SpellStacksChangeMax takes unit c,integer amount,boolean grantDifference returns nothing
        call s__KS_SpellStacks_ChangeMaxStackCount(c , amount , grantDifference)
    endfunction

    function SpellStacksIncreaseMax takes unit c returns nothing
        call s__KS_SpellStacks_ChangeMaxStackCount(c , 1 , true)
    endfunction

    function SpellStacksDecreaseMax takes unit c returns nothing
        call s__KS_SpellStacks_ChangeMaxStackCount(c , - 1 , false)
    endfunction

    // Clears current charges, but normal regeneration continues.
    function SpellStacksClear takes unit c returns nothing
        call s__KS_SpellStacks_SetStackCount((c) , 0) // INLINED!!
    endfunction

    function SpellStacksFill takes unit c returns nothing
        call s__KS_SpellStacks_RestoreAllStacks(c)
    endfunction

    // Вызывать из Escape: восстанавливает максимум зарядов, обнуляет прогресс
    // текущего восстановления и снимает оставшийся cooldown способности.
    function SpellStacksResetForEscape takes unit c returns nothing
        call s__KS_SpellStacks_RestoreAllStacks(c)
    endfunction

    // clearCurrent=true also removes every current charge.
    function SpellStacksPause takes unit c,boolean clearCurrent returns nothing
        call s__KS_SpellStacks_PauseStacks(c , clearCurrent)
    endfunction

    // restoreFull=true immediately restores every charge.
    function SpellStacksResume takes unit c,boolean restoreFull returns nothing
        call s__KS_SpellStacks_ResumeStacks(c , restoreFull)
    endfunction

    function SpellStacksStop takes unit c returns nothing
        call s__KS_SpellStacks_Stop(c)
    endfunction
    function SpellStacksHideAndPause takes unit c returns nothing
    call s__KS_SpellStacks_PauseStacks(c , false)
endfunction
function SpellStacksShowAndResume takes unit c returns nothing
    call s__KS_SpellStacks_ResumeStacks(c , false)
endfunction

function GetStackCount takes unit c returns integer
    return LoadInteger(hs, GetHandleId(c), GearSystems2___SH_STACK_COUNT)
endfunction


    function MyItemStacks takes unit c,integer item_id,integer stack_amount,real r,boolean add_or_remove returns nothing
        call s__GearSystems2___KS_ItemStacks_MyAddStacks_Start(c , item_id , stack_amount , r , add_or_remove)
    endfunction
    // Wrath Sin / Lust Sin also pierce survival effects (Will of D., Patriot's revive).
    function SinPiercesSurvival takes unit c returns boolean
        return c != null and ( HasCachedItem(c , 'I02E') > 0 or GetUnitAbilityLevel(c, 'A07O') > 0 )
    endfunction
    function LustSin takes unit c,unit td,real triggerDmg,real shieldDmg returns real
    local real pierce= 0.0
    local boolean useLastSin= false
    local integer itemSlot= - 1
    local integer charges= 0
    local item lastSinItem= null

    if c == null or shieldDmg <= 0.0 then
        return 0.0
    endif

    // Бонус Фрирен
    if GetUnitTypeId(c) == Frieren_ID or GetUnitTypeId(c) == FrierenTR_unitid then
        set pierce=pierce + FrierenTF_PierceShield
    endif

    // Частичное пробивание B01R; отдельные shieldPen-ветки обходятся полностью.
    if GetUnitAbilityLevel(c, 'B01R') > 0 then
        set pierce=pierce + WrathSin_IgnoreAmountAdd
    endif
    if LoadInteger(hs, GetHandleId(c), GearSystems2___SH_TOJI_Q3) > 0 then
        set pierce=pierce + 100.0
    endif
    
    // Полное пробивание от эффекта Toji на цели.
    if td != null and GetUnitAbilityLevel(td, TojiT_ShieldPierceBuff_ID) > 0 then
        set pierce=pierce + 100.0
    endif

    // Постоянное частичное пробивание от предметов.
    
    if shieldDmg > 1 and HasCachedItem(c , 'I02E') > 0 then
        set pierce=pierce + WrathSin_IgnoreAmount
        else
        if shieldDmg > 1 and HasCachedItem(c , 'I02D') > 0 then
        set pierce=pierce + EnvySin_IgnoreAmount
    endif
    endif

    // Каждый полный щит вызывает функцию отдельно и расходует один заряд.
    // Если постоянные эффекты уже дают 100%, заряд Last Sin не тратится.
    if pierce < 100.0 and triggerDmg >= LustSin_MinDmg and GetUnitAbilityLevel(c, 'A07O') > 0 and BlzGetUnitAbilityCooldownRemaining(c, 'A07O') == 0.0 then
        set itemSlot=IsItemInInventory3(c , 'I01W')
        if itemSlot >= 0 then
            set lastSinItem=UnitItemInSlot(c, itemSlot)
            if lastSinItem != null then
                set charges=GetItemCharges(lastSinItem)
                set useLastSin=charges > 0
            endif
        else
            // Вариант способности без предмета использует обычный cooldown.
            set useLastSin=true
        endif

        if useLastSin then
            set pierce=pierce + LustSin_IgnoreAmount
            if lastSinItem != null then
                set charges=charges - 1
                call SetItemCharges(lastSinItem, charges)
                call s__GearSystems2___KS_ItemStacks_MyAddStacks_Start((c ) , ( 'I01W' ) , ( 1 ) , (( LustSin_CD )*1.0) , ( true)) // INLINED!!
                if charges == 0 then
                    call BlzStartUnitAbilityCooldown(c, 'A07O', LustSin_CD)
                endif
            else
                call BlzStartUnitAbilityCooldown(c, 'A07O', LustSin_CD)
            endif

            if td != null then
                call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\wos_firefly-rq-sfx-5.mdl", td, "chest"))
                call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\wos_0706Red.mdl", td, "chest"))
            endif
        endif
    endif

    // Общий лимит игнорирования щита
    if pierce > 100.0 then
        set pierce=100.0
    endif

    set lastSinItem=null
    // Процент считается от урона, поступившего в конкретный щит. Для ранних
    // щитов обычные резисты применятся ниже по цепочке, для поздних уже учтены.
    return shieldDmg * pierce / 100.0
endfunction
    // Stats panel preview of LustSin: same sources, but no minimum damage, no
    // charge / cooldown use and no effects; partial piercing is counted.
    function GetShieldPiercePreview takes unit c returns real
    local real pierce= 0.0
    local integer itemSlot
    if c == null then
        return 0.0
    endif
    if GetUnitTypeId(c) == Frieren_ID or GetUnitTypeId(c) == FrierenTR_unitid then
        set pierce=pierce + FrierenTF_PierceShield
    endif
    if GetUnitAbilityLevel(c, 'B01R') > 0 then
        set pierce=pierce + WrathSin_IgnoreAmountAdd
    endif
    if LoadInteger(hs, GetHandleId(c), GearSystems2___SH_TOJI_Q3) > 0 then
        set pierce=pierce + 100.0
    endif
    if HasCachedItem(c , 'I02E') > 0 then
        set pierce=pierce + WrathSin_IgnoreAmount
    elseif HasCachedItem(c , 'I02D') > 0 then
        set pierce=pierce + EnvySin_IgnoreAmount
    endif
    if pierce < 100.0 and GetUnitAbilityLevel(c, 'A07O') > 0 and BlzGetUnitAbilityCooldownRemaining(c, 'A07O') == 0.0 then
        set itemSlot=IsItemInInventory3(c , 'I01W')
        if itemSlot < 0 or GetItemCharges(UnitItemInSlot(c, itemSlot)) > 0 then
            set pierce=pierce + LustSin_IgnoreAmount
        endif
    endif
    if pierce > 100.0 then
        set pierce=100.0
    endif
    return pierce
    endfunction

function DamageShieldAllowsType takes integer typedmg,integer allowedType returns boolean
    if allowedType == DAMAGE_SHIELD_TYPE_ALL then
        return true
    endif
    if allowedType == DAMAGE_SHIELD_TYPE_NON_MAGIC then
        return typedmg == DAMAGE_SHIELD_TYPE_ATTACK or typedmg == DAMAGE_SHIELD_TYPE_PHYSICAL
    endif
    return typedmg == allowedType
endfunction

// Единая точка полного щита. Каждый отдельный вызов считается отдельным
// щитом: Last Sin расходует по одному заряду, а постоянные эффекты работают
// на каждом вызове без зарядов. Неподходящий тип урона щит не активирует.
function ApplyFullDamageShield takes unit c,unit td,real dmg,real triggerDmg,integer typedmg,integer allowedType returns real
    if not DamageShieldAllowsType(typedmg , allowedType) then
        return dmg
    endif
    return LustSin(c , td , triggerDmg , dmg)
endfunction

