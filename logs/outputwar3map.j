function TakeshiE2_Start takes unit c,unit td returns nothing
    call CurseUnit(c , td , 3)
    call MakeSound("war3mapimported\\Hero_Takeshi_FE")
    call s__GearSystems2___KS_DelayedSound_NextSound_Start(("war3mapimported\\Hero_Takeshi_FE2" ) , (( 0.75)*1.0)) // INLINED!!
    call s__GearSystems2___KS_DelayedSound_NextSound_Start(("war3mapimported\\Hero_Takeshi_FE3" ) , (( 1.12)*1.0)) // INLINED!!
    call s__GearSystems2___KS_BuffTimer_MyBuffTime_Start((td ) , ( TakeshiE2_Buff_ID ) , (( TakeshiE2_Duration )*1.0) , ( "BTNHero_Takeshi_E2" ) , ( true ) , ( GetPlayerId(GetOwningPlayer(c))) , 0 , 0 , 0) // INLINED!!
endfunction
function TakeshiE2_Act takes unit c,unit td returns nothing
    local real a= GAngle(c , td)
    local integer i= GetRandomInt(1, 2)
    local real r1= GetRandomReal(80, 180)
    local real r2= 0
    if i == 1 then
        set r2=- 90
    else
        set r2=90
    endif
    call BlinkEff(c)
    call BlinkEff2(c)
    call MoveUnit(c , r1 , a + r2 * bj_DEGTORAD)
    call BlinkEff(c)
endfunction
