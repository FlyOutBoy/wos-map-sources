                        call DecorRemove(s__PatriotSpells___PatriotSpells_T2_c[this] , s__PatriotSpells___PatriotSpells_T2_x[this] , s__PatriotSpells___PatriotSpells_T2_y[this] , s__PatriotSpells___PatriotSpells_T2_aoe[this] , PatriotT2_DecorDamage)
