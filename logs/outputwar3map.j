            set s__PatriotSpells___PatriotSpells_T2_y1[this]=GetUnitY(s__PatriotSpells___PatriotSpells_T2_c[this])
            set s__PatriotSpells___PatriotSpells_T2_aoe[this]=PatriotT2_DamageAoe
            set s__PatriotSpells___PatriotSpells_T2_a[this]=GAngle2(s__PatriotSpells___PatriotSpells_T2_c[this] , s__PatriotSpells___PatriotSpells_T2_x[this] , s__PatriotSpells___PatriotSpells_T2_y[this])
            set s__PatriotSpells___PatriotSpells_T2_g[this]=CreateGroup()

            call StartSpellUnit(s__PatriotSpells___PatriotSpells_T2_c[this])
            call MakeSound("war3mapimported\\Hero_Patriot_T2 1")
            call MakeSound("war3mapimported\\Hero_Patriot_T2 2")
            set s__PatriotSpells___PatriotSpells_T2_dmg[this]=GetHeroAgi(s__PatriotSpells___PatriotSpells_T2_c[this], true) * PatriotT2_DamageAgiBase
            set s__PatriotSpells___PatriotSpells_T2_move[this]=112.5
            set s__PatriotSpells___PatriotSpells_T2_fly[this]=2400.0
            call MouseOn(GetOwningPlayer(s__PatriotSpells___PatriotSpells_T2_c[this]))
            set MouseX[GetPlayerId(GetOwningPlayer(s__PatriotSpells___PatriotSpells_T2_c[this]))]=s__PatriotSpells___PatriotSpells_T2_x[this]
            set MouseY[GetPlayerId(GetOwningPlayer(s__PatriotSpells___PatriotSpells_T2_c[this]))]=s__PatriotSpells___PatriotSpells_T2_y[this]
            set s__PatriotSpells___PatriotSpells_T2_scale[this]=6.0 * 1.2
            set s__PatriotSpells___PatriotSpells_T2_scale2[this]=PatriotT2_Range
            set s__PatriotSpells___PatriotSpells_T2_r5[this]=0.30
