                                        set s__ErzaTSpells__Erza5Q_KS_r5[this]=GAngle5(s___ErzaTSpells__Erza5Q_KS_ee[s__ErzaTSpells__Erza5Q_KS_ee[this]+s__ErzaTSpells__Erza5Q_KS_k[this]] , s__ErzaTSpells__Erza5Q_KS_x[this] , s__ErzaTSpells__Erza5Q_KS_y[this])
                                        call BlzSetSpecialEffectYaw(s___ErzaTSpells__Erza5Q_KS_ee[s__ErzaTSpells__Erza5Q_KS_ee[this]+s__ErzaTSpells__Erza5Q_KS_k[this]], s__ErzaTSpells__Erza5Q_KS_r5[this])
