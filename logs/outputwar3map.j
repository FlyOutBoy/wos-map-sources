        function s__OkarunSpells___OkarunTick_Loop_Loop takes nothing returns nothing
            if OkarunSpells___OkarunTick_Active[0] then
                call s__OkarunSpells___OkarunQ_KS_Loop_OkarunQ()
            endif
            if OkarunSpells___OkarunTick_Active[1] then
                call s__OkarunSpells___OkarunW_KS_Loop_OkarunW()
            endif
            if OkarunSpells___OkarunTick_Active[2] then
                call s__OkarunSpells___OkarunE_KS_Loop_OkarunE()
            endif
            if OkarunSpells___OkarunTick_Active[3] then
                call s__OkarunSpells___OkarunR_KS_Loop_OkarunR()
            endif
            if OkarunSpells___OkarunTick_Active[4] then
                call s__OkarunSpells___OkarunTBuff_KS_Loop_OkarunTBuff()
            endif
            if OkarunSpells___OkarunTick_Active[5] then
                call s__OkarunSpells___OkarunT_KS_Loop_OkarunT()
            endif
            if OkarunSpells___OkarunTick_Active[6] then
                call s__OkarunSpells___OkarunF_KS_Loop_OkarunF()
            endif
        endfunction

        function s__OkarunSpells___OkarunTick_Loop_onInit takes nothing returns nothing
            set OkarunSpells___OkarunTick_Callback=function s__OkarunSpells___OkarunTick_Loop_Loop
        endfunction


//library OkarunSpells ends
//library PatriotSpells:

    // ===========================================================================
    // Order Tracking & Animation Restore Module
    // ===========================================================================
    function PatriotSpells___OnPatriotPointOrder takes nothing returns boolean
        local unit u= GetOrderedUnit()
        local integer ord= GetIssuedOrderId()
        if GetUnitTypeId(u) == Patriot_ID then
            if ord == 851971 or ord == 851986 or ord == 851990 then
                call SaveInteger(hs, GetHandleId(u), PatriotSpells___SH_ORD_MODE, 1)
                call SaveInteger(hs, GetHandleId(u), PatriotSpells___SH_ORD_ID, ord)
                call SaveReal(hs, GetHandleId(u), PatriotSpells___SH_ORD_X, GetOrderPointX())
                call SaveReal(hs, GetHandleId(u), PatriotSpells___SH_ORD_Y, GetOrderPointY())
            endif
        endif
        set u=null
        return false
    endfunction

    function PatriotSpells___OnPatriotTargetOrder takes nothing returns boolean
        local unit u= GetOrderedUnit()
        local integer ord= GetIssuedOrderId()
        if GetUnitTypeId(u) == Patriot_ID then
            if ord == 851971 or ord == 851983 then
                call SaveInteger(hs, GetHandleId(u), PatriotSpells___SH_ORD_MODE, 2)
                call SaveInteger(hs, GetHandleId(u), PatriotSpells___SH_ORD_ID, ord)
                call SaveUnitHandle(hs, GetHandleId(u), PatriotSpells___SH_ORD_TARGET, GetOrderTargetUnit())
            endif
        endif
        set u=null
        return false
    endfunction

    function PatriotSpells___OnPatriotImmediateOrder takes nothing returns boolean
        local unit u= GetOrderedUnit()
        local integer ord= GetIssuedOrderId()
        if GetUnitTypeId(u) == Patriot_ID then
            if ord == 851972 or ord == 851993 then
                call SaveInteger(hs, GetHandleId(u), PatriotSpells___SH_ORD_MODE, 0)
            endif
        endif
        set u=null
        return false
    endfunction

    function Patriot_RestoreOrder takes unit c,integer animIndex returns nothing
        local integer mode= LoadInteger(hs, GetHandleId(c), PatriotSpells___SH_ORD_MODE)
        local real ox
        local real oy
        local real dx
        local real dy
        local integer oid
        local unit tu

        if mode == 1 then
            set ox=LoadReal(hs, GetHandleId(c), PatriotSpells___SH_ORD_X)
            set oy=LoadReal(hs, GetHandleId(c), PatriotSpells___SH_ORD_Y)
            set dx=ox - GetUnitX(c)
            set dy=oy - GetUnitY(c)
            if ( dx * dx + dy * dy ) > 5625.0 then
                set oid=LoadInteger(hs, GetHandleId(c), PatriotSpells___SH_ORD_ID)
                call IssuePointOrderById(c, oid, ox, oy)
                return
            endif
        elseif mode == 2 then
            set tu=LoadUnitHandle(hs, GetHandleId(c), PatriotSpells___SH_ORD_TARGET)
            if tu != null and GetWidgetLife(tu) > 0.405 then
                set oid=LoadInteger(hs, GetHandleId(c), PatriotSpells___SH_ORD_ID)
                call IssueTargetOrderById(c, oid, tu)
                set tu=null
                return
            endif
            set tu=null
        endif

        call SetUnitAnimationByIndex(c, animIndex)
        call s__GearSystems2___KS_RemoveUnit_MyRemoveUnit_Start((c ) , (( 0.03 )*1.0) , 2 , - 1 , ( animIndex) , "") // INLINED!!
    endfunction

        function s__PatriotSpells___PatriotOrderInit_onInit takes nothing returns nothing
            local trigger tPoint= CreateTrigger()
            local trigger tTarget= CreateTrigger()
            local trigger tImmediate= CreateTrigger()
            local integer i= 0
            loop
                exitwhen i >= 16
                call TriggerRegisterPlayerUnitEvent(tPoint, Player(i), EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER, null)
                call TriggerRegisterPlayerUnitEvent(tTarget, Player(i), EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER, null)
                call TriggerRegisterPlayerUnitEvent(tImmediate, Player(i), EVENT_PLAYER_UNIT_ISSUED_ORDER, null)
                set i=i + 1
            endloop
            call TriggerAddCondition(tPoint, Condition(function PatriotSpells___OnPatriotPointOrder))
            call TriggerAddCondition(tTarget, Condition(function PatriotSpells___OnPatriotTargetOrder))
            call TriggerAddCondition(tImmediate, Condition(function PatriotSpells___OnPatriotImmediateOrder))
            set tPoint=null
            set tTarget=null
            set tImmediate=null
        endfunction

    // ===========================================================================
    // Timer Management
    // ===========================================================================
    function PatriotSpells___PatriotTimer03Acquire takes nothing returns nothing
        set PatriotSpells___PatriotTimer03Users=PatriotSpells___PatriotTimer03Users + 1
        if PatriotSpells___PatriotTimer03Users == 1 then
            call TimerStart(PatriotSpells___PatriotTimer03, 0.03, true, PatriotSpells___PatriotTimer03Callback)
        endif
    endfunction

    function PatriotSpells___PatriotTimer03Release takes nothing returns nothing
        set PatriotSpells___PatriotTimer03Users=PatriotSpells___PatriotTimer03Users - 1
        if PatriotSpells___PatriotTimer03Users <= 0 then
            set PatriotSpells___PatriotTimer03Users=0
            call PauseTimer(PatriotSpells___PatriotTimer03)
        endif
    endfunction

    // ===========================================================================
    // Core Helpers
    // ===========================================================================
    // Keep the logical stance, native ability set and presentation in one transition.
    // Reapplying attack stance for Perseverance must not stack its movement bonus
    // or copy the inactive defensive ultimate's stale cooldown over the active one.
    function PatriotSpells___Patriot_SetStance takes unit c,boolean attack returns nothing
        local boolean wasAttack= LoadInteger(hs, GetHandleId(c), PatriotSpells___SH_PATRIOT_E) == 1
        local real cooldown

        if attack then
            call UnitAddAbility(c, PatriotF2_ID)
            if GetUnitAbilityLevel(c, PatriotT_ID) > 0 then
                call UnitAddAbility(c, PatriotT2_ID)
                if not wasAttack then
                    set cooldown=BlzGetUnitAbilityCooldownRemaining(c, PatriotT_ID)
                    call BlzStartUnitAbilityCooldown(c, PatriotT2_ID, cooldown)
                endif
            endif
            if not wasAttack then
                call AddSpellLevel(c , 'A01C' , 10 , true)
            endif
            call SaveInteger(hs, GetHandleId(c), PatriotSpells___SH_PATRIOT_E, 1)
            call BlzSetAbilityIcon(PatriotE_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Patriot_E2.blp")
            if LoadInteger(hs, GetHandleId(c), PatriotSpells___SH_PATRIOT_EE) == 1 then
                call AAUniversalTooltips_SetUnitForm(c , 2)
            else
                call AAUniversalTooltips_SetUnitForm(c , 1)
            endif
        else
            if wasAttack then
                if GetUnitAbilityLevel(c, PatriotT_ID) > 0 and GetUnitAbilityLevel(c, PatriotT2_ID) > 0 then
                    set cooldown=BlzGetUnitAbilityCooldownRemaining(c, PatriotT2_ID)
                    call BlzStartUnitAbilityCooldown(c, PatriotT_ID, cooldown)
                endif
                call AddSpellLevel(c , 'A01C' , 10 , false)
            endif
            call SaveInteger(hs, GetHandleId(c), PatriotSpells___SH_PATRIOT_E, 0)
            call BlzSetAbilityIcon(PatriotE_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Patriot_E.blp")
            call AAUniversalTooltips_SetUnitForm(c , 0)
        endif
        call SetPlayerAbilityAvailable(GetOwningPlayer(c), PatriotF_ID, not attack)
        call SetPlayerAbilityAvailable(GetOwningPlayer(c), PatriotT_ID, not attack)
        call SetPlayerAbilityAvailable(GetOwningPlayer(c), PatriotF2_ID, attack)
        call SetPlayerAbilityAvailable(GetOwningPlayer(c), PatriotT2_ID, attack)
        call AddUnitAnimationProperties(c, "alternate", attack)
    endfunction

    function PatriotPas takes unit c,unit td returns nothing
        local real x
        local real y
        if ( c == null or td == null ) or ( GetWidgetLife(td) <= 0.405 ) or ( BlzGetUnitAbilityCooldownRemaining(c, PatriotG_ID) > 0.1 ) then
            return
        endif
        set x=GetUnitX(td)
        set y=GetUnitY(td)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", td, "chest"))
        call s__GearSystems2___KS_MoveEffectToUnit_MoveEffectToUnit_Start((EffectSpawn("war3mapImported\\wos_Satsu-WWSFX-1.mdx" , x , y , 0.0 , 1.25 , 2.0 , 75.0) ) , (( 0.76 )*1.0) , (( 75.0 )*1.0) , ( td) , 0 , 1 , null) // INLINED!!
        set GearDamageNextSource=('A0EF') // INLINED!!
        call s__GearSystems2___KS_DelayedDamage_NextDmg_Start((c ) , ( td ) , (( PatriotG_DamageAgiBase * GetHeroAgi(c, true) )*1.0) , ( 0 ) , (( 0.10)*1.0)) // INLINED!!
        if LoadInteger(hs, GetHandleId(c), PatriotSpells___SH_PATRIOT_E) == 1 then
        if PatriotG_CD_Atk > 0 then
            call BlzStartUnitAbilityCooldown(c, PatriotG_ID, PatriotG_CD_Atk)
            endif
        else
            call BlzStartUnitAbilityCooldown(c, PatriotG_ID, PatriotG_CD_Def)
        endif
    endfunction

    function BuffUnitPat takes unit c,unit u,integer level returns nothing
        local integer i= GetPlayerId(GetOwningPlayer(c))
        if patdummy1[i] == null or GetWidgetLife(patdummy1[i]) < 1.0 then
            set patdummy1[i]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'h0C9', GetRectCenterX(gg_rct_Caster), GetRectCenterY(gg_rct_Caster), 0.0)
            call UnitAddAbility(patdummy1[i], 'A0EG')
        endif
        if level > 0 then
            if GetUnitAbilityLevel(patdummy1[i], 'A0EG') == 0 then
                call UnitAddAbility(patdummy1[i], 'A0EG')
            endif
            call SetUnitAbilityLevel(patdummy1[i], 'A0EG', level)
            call SetUnitFacing(patdummy1[i], GAngle(patdummy1[i] , u) * bj_RADTODEG)
            call IssueTargetOrder(patdummy1[i], "innerfire", u)
        endif
    endfunction

    // ===========================================================================
    // Abilities MUI Implementation
    // ===========================================================================


        function s__PatriotSpells___PatriotSpells_Q_Loop_PatriotQ takes nothing returns nothing
            local integer i= 0
            local integer this
            local unit u= null
            local real x1
            local real y1
            local real x2
            local real y2
            local real x3
            local real y3
            local real arenaAngle
            local boolean remove

            loop
                exitwhen i > s__PatriotSpells___PatriotSpells_Q_MUI_PatriotQ
                set this=s__PatriotSpells___PatriotSpells_Q_m_PatriotQ[i]
                set remove=false

                if s__PatriotSpells___PatriotSpells_Q_c[this] == null or GetUnitTypeId(s__PatriotSpells___PatriotSpells_Q_c[this]) == 0 or not SpellBoolCaster(s__PatriotSpells___PatriotSpells_Q_c[this]) or s__PatriotSpells___PatriotSpells_Q_r[this] > s__PatriotSpells___PatriotSpells_Q_rmax[this] then
                    set remove=true
                else
                    set s__PatriotSpells___PatriotSpells_Q_r[this]=I2R(R2I(( s__PatriotSpells___PatriotSpells_Q_r[this] + 0.03 ) * 1000.0 + 0.5)) / 1000.0
                    if s__PatriotSpells___PatriotSpells_Q_r[this] < PatriotQ_CastTime then
                        call DebugUnit2(s__PatriotSpells___PatriotSpells_Q_c[this])
                    endif

                    if s__PatriotSpells___PatriotSpells_Q_r[this] == PatriotQ_CastTime then
                        call MakeSound("war3mapimported\\Hero_Patriot_Q2")
                        set s__PatriotSpells___PatriotSpells_Q_e[this]=EffectSpawn4("war3mapImported\\wos_PatriotsSpear.mdx" , GetUnitX(s__PatriotSpells___PatriotSpells_Q_c[this]) + 150.0 * Cos(s__PatriotSpells___PatriotSpells_Q_a[this]) , GetUnitY(s__PatriotSpells___PatriotSpells_Q_c[this]) + 150.0 * Sin(s__PatriotSpells___PatriotSpells_Q_a[this]) , s__PatriotSpells___PatriotSpells_Q_a[this] * bj_RADTODEG , 0.65 , 1.0 , 155.0 , - 20.0)
                        set s__PatriotSpells___PatriotSpells_Q_e3[this]=EffectSpawn("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl" , GetUnitX(s__PatriotSpells___PatriotSpells_Q_c[this]) + 250.0 * Cos(s__PatriotSpells___PatriotSpells_Q_a[this]) , GetUnitY(s__PatriotSpells___PatriotSpells_Q_c[this]) + 250.0 * Sin(s__PatriotSpells___PatriotSpells_Q_a[this]) , s__PatriotSpells___PatriotSpells_Q_a[this] * bj_RADTODEG , 0.65 , 1.0 , 135.0)
                        call MoveEff(s__PatriotSpells___PatriotSpells_Q_e3[this] , 10.0 , s__PatriotSpells___PatriotSpells_Q_a[this])
                        set s__PatriotSpells___PatriotSpells_Q_k3[this]=0
                        call StopSpellUnit2(s__PatriotSpells___PatriotSpells_Q_c[this])
