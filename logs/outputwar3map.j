        endif
        if GetUnitAbilityLevel(c, ErzaG2_ID) > 0 then
            call SetPlayerAbilityAvailable(GetOwningPlayer(c), ErzaG2_ID, false)
        else
            call SetPlayerAbilityAvailable(GetOwningPlayer(c), ErzaG_ID, false)
        endif
    endfunction

