        function s__BrandishSpells_Utility_BuffUnitBran takes unit c,unit u,integer level returns nothing
            local integer i= GetPlayerId(GetOwningPlayer(c))
            if BrandishSpells__branddummy1[i] == null or GetWidgetLife(BrandishSpells__branddummy1[i]) < 1.0 then
                set BrandishSpells__branddummy1[i]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'h0C9', GetRectCenterX(gg_rct_Caster), GetRectCenterY(gg_rct_Caster), 0.0)
                call UnitAddAbility(BrandishSpells__branddummy1[i], 'A0EN')
            endif
            if level > 0 then
                if GetUnitAbilityLevel(BrandishSpells__branddummy1[i], 'A0EN') == 0 then
                    call UnitAddAbility(BrandishSpells__branddummy1[i], 'A0EN')
                endif
                call SetUnitAbilityLevel(BrandishSpells__branddummy1[i], 'A0EN', level)
                call SetUnitFacing(BrandishSpells__branddummy1[i], GAngle(BrandishSpells__branddummy1[i] , u) * bj_RADTODEG)
                call IssueTargetOrder(BrandishSpells__branddummy1[i], "innerfire", u)
            endif
        endfunction

        function s__BrandishSpells_Utility_BuffUnitBran2 takes unit c,unit u,integer level,boolean isenemy returns nothing
            local integer i= GetPlayerId(GetOwningPlayer(c))
            if BrandishSpells__branddummy2[i] == null or GetWidgetLife(BrandishSpells__branddummy2[i]) < 1.0 then
                set BrandishSpells__branddummy2[i]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'h0C9', GetRectCenterX(gg_rct_Caster), GetRectCenterY(gg_rct_Caster), 0.0)
                call UnitAddAbility(BrandishSpells__branddummy2[i], 'A0EO')
                call UnitAddAbility(BrandishSpells__branddummy2[i], 'A0EP')
            endif
            if level > 0 then
                if GetUnitAbilityLevel(BrandishSpells__branddummy2[i], 'A0EO') == 0 then
                    call UnitAddAbility(BrandishSpells__branddummy2[i], 'A0EO')
                endif
                if GetUnitAbilityLevel(BrandishSpells__branddummy2[i], 'A0EP') == 0 then
                    call UnitAddAbility(BrandishSpells__branddummy2[i], 'A0EP')
                endif
                call SetUnitAbilityLevel(BrandishSpells__branddummy2[i], 'A0EP', level)
                call SetUnitAbilityLevel(BrandishSpells__branddummy2[i], 'A0EO', level)
                call SetUnitFacing(BrandishSpells__branddummy2[i], GAngle(BrandishSpells__branddummy2[i] , u) * bj_RADTODEG)
                if isenemy then
                    call IssueTargetOrder(BrandishSpells__branddummy2[i], "curse", u)
                else
                    call IssueTargetOrder(BrandishSpells__branddummy2[i], "innerfire", u)
                endif
            endif
        endfunction

        function s__BrandishSpells_Utility_GetTotalScale takes unit u returns real
            local real tm= LoadReal(BrandishSpells__hs, GetHandleId(u), BrandishSpells__SH_TMULT)
            local real fm= LoadReal(BrandishSpells__hs, GetHandleId(u), BrandishSpells__SH_FMULT)
            if tm == 0.0 then
                set tm=1.0
            endif
            if fm == 0.0 then
                set fm=1.0
            endif
            return tm * fm
        endfunction

    //===========================================================================
    // Q - Sand Wave
    //===========================================================================
    // Invulnerability: this spell contains a StartSpellUnit/Avul phase.


        function s__BrandishSpells__BrandishSpells_Q_Loop_BrandishQ takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__BrandishSpells__BrandishSpells_Q_MUI_BrandishQ
                set this=s__BrandishSpells__BrandishSpells_Q_m_BrandishQ[i]
                if SpellBoolCaster(s__BrandishSpells__BrandishSpells_Q_c[this]) and s__BrandishSpells__BrandishSpells_Q_r[this] <= s__BrandishSpells__BrandishSpells_Q_rmax[this] then
                    set s__BrandishSpells__BrandishSpells_Q_r[this]=I2R(R2I(( s__BrandishSpells__BrandishSpells_Q_r[this] + 0.03 ) * 1000.0 + 0.5)) / 1000.0
                    if s__BrandishSpells__BrandishSpells_Q_check[this] == 0 then
                        call DebugUnit(s__BrandishSpells__BrandishSpells_Q_c[this])
                        if s__BrandishSpells__BrandishSpells_Q_r[this] == 0.33 then
                            call SetUnitTimeScale(s__BrandishSpells__BrandishSpells_Q_c[this], 0.0)
                            if GetUnitAbilityLevel(s__BrandishSpells__BrandishSpells_Q_c[this], BrandishF_Buff_ID) == 1 then
                                set s__BrandishSpells__BrandishSpells_Q_r5[this]=260.0
                                set s__BrandishSpells__BrandishSpells_Q_e2[this]=EffectSpawn2("war3mapImported\\wos_BranQCast2.mdl" , GetUnitX(s__BrandishSpells__BrandishSpells_Q_c[this]) + s__BrandishSpells__BrandishSpells_Q_r5[this] * Cos(s__BrandishSpells__BrandishSpells_Q_a[this]) , GetUnitY(s__BrandishSpells__BrandishSpells_Q_c[this]) + s__BrandishSpells__BrandishSpells_Q_r5[this] * Sin(s__BrandishSpells__BrandishSpells_Q_a[this]) , s__BrandishSpells__BrandishSpells_Q_a[this] * bj_RADTODEG , 3.0 , 0.01 , 135.0 , 1.52)
                                call ScaleEffDummy(s__BrandishSpells__BrandishSpells_Q_e2[this] , 0.21 , 0.01 , 0.65)
                            else
                                set s__BrandishSpells__BrandishSpells_Q_r5[this]=190.0
                                set s__BrandishSpells__BrandishSpells_Q_e2[this]=EffectSpawn2("war3mapImported\\wos_BranQCast2.mdl" , GetUnitX(s__BrandishSpells__BrandishSpells_Q_c[this]) + s__BrandishSpells__BrandishSpells_Q_r5[this] * Cos(s__BrandishSpells__BrandishSpells_Q_a[this]) , GetUnitY(s__BrandishSpells__BrandishSpells_Q_c[this]) + s__BrandishSpells__BrandishSpells_Q_r5[this] * Sin(s__BrandishSpells__BrandishSpells_Q_a[this]) , s__BrandishSpells__BrandishSpells_Q_a[this] * bj_RADTODEG , 3.0 , 0.01 , 65.0 , 1.52)
                                call ScaleEffDummy(s__BrandishSpells__BrandishSpells_Q_e2[this] , 0.21 , 0.01 , 0.50)
                            endif
                        endif
                        if s__BrandishSpells__BrandishSpells_Q_r[this] > 0.33 then
                            if s__BrandishSpells__BrandishSpells_Q_r2[this] > 0.09 then
                                set s__BrandishSpells__BrandishSpells_Q_r2[this]=0.0
                                call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_T_dustgaraa2.mdx" , GetUnitX(s__BrandishSpells__BrandishSpells_Q_c[this]) + s__BrandishSpells__BrandishSpells_Q_r5[this] * Cos(s__BrandishSpells__BrandishSpells_Q_a[this]) , GetUnitY(s__BrandishSpells__BrandishSpells_Q_c[this]) + s__BrandishSpells__BrandishSpells_Q_r5[this] * Sin(s__BrandishSpells__BrandishSpells_Q_a[this]) , GetRandomReal(0, 359) , 0.8 , 0.8 , 0.0 , 255 , 255 , 200 , 100))
                                call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_T_dustgaraa2.mdx" , GetUnitX(s__BrandishSpells__BrandishSpells_Q_c[this]) + s__BrandishSpells__BrandishSpells_Q_r5[this] * Cos(s__BrandishSpells__BrandishSpells_Q_a[this]) , GetUnitY(s__BrandishSpells__BrandishSpells_Q_c[this]) + s__BrandishSpells__BrandishSpells_Q_r5[this] * Sin(s__BrandishSpells__BrandishSpells_Q_a[this]) , GetRandomReal(0, 359) , 0.8 , 1.2 , 0.0 , 255 , 255 , 200 , 100))
                                call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_T_dustgaraa2.mdx" , GetUnitX(s__BrandishSpells__BrandishSpells_Q_c[this]) + s__BrandishSpells__BrandishSpells_Q_r5[this] * Cos(s__BrandishSpells__BrandishSpells_Q_a[this]) , GetUnitY(s__BrandishSpells__BrandishSpells_Q_c[this]) + s__BrandishSpells__BrandishSpells_Q_r5[this] * Sin(s__BrandishSpells__BrandishSpells_Q_a[this]) , GetRandomReal(0, 359) , 0.8 , 1.6 , 0.0 , 255 , 255 , 200 , 100))
                            else
                                set s__BrandishSpells__BrandishSpells_Q_r2[this]=s__BrandishSpells__BrandishSpells_Q_r2[this] + 0.03
                            endif
