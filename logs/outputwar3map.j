                call s__GearSystems2___KS_Flush_Start((i ) , ( ErzaBase__SH_SOUND_CD6 ) , ( 0 ) , (( 0.1)*1.0)) // INLINED!!
                call MakeSound("war3mapImported\\Hero_Erza7_Enter")
