            set s__OkarunSpells___OkarunR_KS_r5[this]=OkarunR_DamageSpeedBonusBase + OkarunR_DamageSpeedBonusStep * ( GetUnitAbilityLevel(s__OkarunSpells___OkarunR_KS_c[this], OkarunR_ID) - 1 )
            set s__OkarunSpells___OkarunR_KS_a[this]=GAngle2(s__OkarunSpells___OkarunR_KS_c[this] , s__OkarunSpells___OkarunR_KS_x[this] , s__OkarunSpells___OkarunR_KS_y[this]) // Angle Between points
            set s__OkarunSpells___OkarunR_KS_dmg[this]=GetHeroInt(s__OkarunSpells___OkarunR_KS_c[this], true) * ( OkarunR_DamageIntBase + ( OkarunR_DamageIntStep * ( GetUnitAbilityLevel(s__OkarunSpells___OkarunR_KS_c[this], OkarunR_ID) - 1 ) ) )
            set s__OkarunSpells___OkarunR_KS_dmg[this]=s__OkarunSpells___OkarunR_KS_dmg[this] + ( LoadReal(hs, GetHandleId(s__OkarunSpells___OkarunR_KS_c[this]), OkarunSpells___SH_CURRENT_SPEED1) * ( s__OkarunSpells___OkarunR_KS_r5[this] / 100 ) )
