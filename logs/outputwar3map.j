                    set s__GearSystems2___KS_SpellTimer_m_6[i]=s__GearSystems2___KS_SpellTimer_m_6[s__GearSystems2___KS_SpellTimer_MUI_6]
                    set s__GearSystems2___KS_SpellTimer_MUI_6=s__GearSystems2___KS_SpellTimer_MUI_6 - 1
