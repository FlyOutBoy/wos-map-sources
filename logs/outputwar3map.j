        function s__ErzaRSpells__Erza4Q_KS_ErzaQ_Start takes unit NewC,unit NewTd returns nothing
            local integer this= s__ErzaRSpells__Erza4Q_KS__allocate()
            set s__ErzaRSpells__Erza4Q_KS_MUI_ErzaQ=s__ErzaRSpells__Erza4Q_KS_MUI_ErzaQ + 1
            set s__ErzaRSpells__Erza4Q_KS_m_ErzaQ[s__ErzaRSpells__Erza4Q_KS_MUI_ErzaQ]=this
            set s__ErzaRSpells__Erza4Q_KS_c[this]=NewC
            set s__ErzaRSpells__Erza4Q_KS_td[this]=NewTd
            set s__ErzaRSpells__Erza4Q_KS_x[this]=GetUnitX(s__ErzaRSpells__Erza4Q_KS_td[this])
            set s__ErzaRSpells__Erza4Q_KS_y[this]=GetUnitY(s__ErzaRSpells__Erza4Q_KS_td[this])
            set s__ErzaRSpells__Erza4Q_KS_r[this]=0
            set s__ErzaRSpells__Erza4Q_KS_check[this]=0
            set s__ErzaRSpells__Erza4Q_KS_r2[this]=0
            call StartSpellUnit2(s__ErzaRSpells__Erza4Q_KS_c[this])
            set s__ErzaRSpells__Erza4Q_KS_g[this]=CreateGroup()
            set s__ErzaRSpells__Erza4Q_KS_u[this]=null
            set s__ErzaRSpells__Erza4Q_KS_a[this]=GAngle2(s__ErzaRSpells__Erza4Q_KS_c[this] , s__ErzaRSpells__Erza4Q_KS_x[this] , s__ErzaRSpells__Erza4Q_KS_y[this]) // Angle Between points
            call SetUnitFacing(s__ErzaRSpells__Erza4Q_KS_c[this], s__ErzaRSpells__Erza4Q_KS_a[this] * bj_RADTODEG)
            set s__ErzaRSpells__Erza4Q_KS_aoe[this]=Erza4Q_DamageAoe
            set s__ErzaRSpells__Erza4Q_KS_dmg[this]=Erza4Q_Damage2StaticBase + ( Erza4Q_Damage2StaticStep * ( GetUnitAbilityLevel(s__ErzaRSpells__Erza4Q_KS_c[this], Erza4Q_ID) - 1 ) )
            set s__ErzaRSpells__Erza4Q_KS_dmg[this]=s__ErzaRSpells__Erza4Q_KS_dmg[this] + GetHeroAgi(s__ErzaRSpells__Erza4Q_KS_c[this], true) * ( Erza4Q_DamageAgiBase + ( Erza4Q_DamageAgiStep * ( GetUnitAbilityLevel(s__ErzaRSpells__Erza4Q_KS_c[this], Erza4Q_ID) - 1 ) ) )
            set s__ErzaRSpells__Erza4Q_KS_rmax[this]=0.75
            set s__ErzaRSpells__Erza4Q_KS_move[this]=90
            set s__ErzaRSpells__Erza4Q_KS_check2[this]=0
            if LoadInteger(hs, GetHandleId(s__ErzaRSpells__Erza4Q_KS_c[this]), ErzaRSpells__SH_TYPE_SWORD) > 0 then
                set s__ErzaRSpells__Erza4Q_KS_dmg[this]=s__ErzaRSpells__Erza4Q_KS_dmg[this] + ( s__ErzaRSpells__Erza4Q_KS_dmg[this] * LoadReal(hs, GetHandleId(s__ErzaRSpells__Erza4Q_KS_c[this]), ErzaRSpells__SH_ADD_SPELL_DMG_ERZA4_F) )
                set s__ErzaRSpells__Erza4Q_KS_check2[this]=LoadInteger(hs, GetHandleId(s__ErzaRSpells__Erza4Q_KS_c[this]), ErzaRSpells__SH_TYPE_SWORD) // 0 - no sword, 1 - fire, 3 - lightning, 2 - water, 5 - fire and lightning, 4 - fire and water, 6 - water and lightning, 7 - natsu and gray
            endif
            call SetUnitTimeScale(s__ErzaRSpells__Erza4Q_KS_c[this], 2.15)
            call SetUnitAnimationByIndex(s__ErzaRSpells__Erza4Q_KS_c[this], 17)
            set s__ErzaRSpells__Erza4Q_KS_k[this]=GetRandomInt(1, 3)
            if s__ErzaRSpells__Erza4Q_KS_k[this] == 1 then
                call MakeSound("war3mapImported\\Hero_Erza4_Q")
            elseif s__ErzaRSpells__Erza4Q_KS_k[this] == 2 then
                call MakeSound("war3mapImported\\Hero_Erza4_Q2")
            elseif s__ErzaRSpells__Erza4Q_KS_k[this] == 3 then
                call MakeSound("war3mapImported\\Hero_Erza4_Q3")
            endif
            if s__ErzaRSpells__Erza4Q_KS_MUI_ErzaQ == 0 then
                call ErzaRSpells__ErzaRTick_On(0)
            endif
        endfunction

