    // Scripted crystal shots (visual only; the hidden native missile deals the damage).

        function s__InoriSpells___InoriShot_KS_Remove takes integer i returns nothing
            if s__InoriSpells___InoriShot_KS_fx[i] != null then
                call DestroyEffect(s__InoriSpells___InoriShot_KS_fx[i])
            endif
            set s__InoriSpells___InoriShot_KS_count=s__InoriSpells___InoriShot_KS_count - 1
            set s__InoriSpells___InoriShot_KS_src[i]=s__InoriSpells___InoriShot_KS_src[s__InoriSpells___InoriShot_KS_count]
            set s__InoriSpells___InoriShot_KS_dst[i]=s__InoriSpells___InoriShot_KS_dst[s__InoriSpells___InoriShot_KS_count]
            set s__InoriSpells___InoriShot_KS_fx[i]=s__InoriSpells___InoriShot_KS_fx[s__InoriSpells___InoriShot_KS_count]
            set s__InoriSpells___InoriShot_KS_wait[i]=s__InoriSpells___InoriShot_KS_wait[s__InoriSpells___InoriShot_KS_count]
            set s__InoriSpells___InoriShot_KS_px[i]=s__InoriSpells___InoriShot_KS_px[s__InoriSpells___InoriShot_KS_count]
            set s__InoriSpells___InoriShot_KS_py[i]=s__InoriSpells___InoriShot_KS_py[s__InoriSpells___InoriShot_KS_count]
            set s__InoriSpells___InoriShot_KS_src[s__InoriSpells___InoriShot_KS_count]=null
            set s__InoriSpells___InoriShot_KS_dst[s__InoriSpells___InoriShot_KS_count]=null
            set s__InoriSpells___InoriShot_KS_fx[s__InoriSpells___InoriShot_KS_count]=null
        endfunction

        function s__InoriSpells___InoriShot_KS_Loop takes nothing returns nothing
            local integer i= 0
            local real a
            local real dx
            local real dy
            local real step= InoriAtk_Speed * 0.03
            loop
                exitwhen i >= s__InoriSpells___InoriShot_KS_count
                if s__InoriSpells___InoriShot_KS_dst[i] == null or GetUnitTypeId(s__InoriSpells___InoriShot_KS_dst[i]) == 0 or IsUnitType(s__InoriSpells___InoriShot_KS_dst[i], UNIT_TYPE_DEAD) or s__InoriSpells___InoriShot_KS_src[i] == null then
                    call s__InoriSpells___InoriShot_KS_Remove(i)
                elseif s__InoriSpells___InoriShot_KS_fx[i] == null then
                    set s__InoriSpells___InoriShot_KS_wait[i]=s__InoriSpells___InoriShot_KS_wait[i] - 0.03
                    if s__InoriSpells___InoriShot_KS_wait[i] <= 0.0 then
                        set a=Atan2(GetUnitY(s__InoriSpells___InoriShot_KS_dst[i]) - GetUnitY(s__InoriSpells___InoriShot_KS_src[i]), GetUnitX(s__InoriSpells___InoriShot_KS_dst[i]) - GetUnitX(s__InoriSpells___InoriShot_KS_src[i]))
                        set s__InoriSpells___InoriShot_KS_px[i]=GetUnitX(s__InoriSpells___InoriShot_KS_src[i]) + 40.0 * Cos(a)
                        set s__InoriSpells___InoriShot_KS_py[i]=GetUnitY(s__InoriSpells___InoriShot_KS_src[i]) + 40.0 * Sin(a)
                        // The crystals of the model grow along -Z: pitch -90 lays them along the yaw.
                        set s__InoriSpells___InoriShot_KS_fx[i]=EffectSpawn3(InoriAtk_Crystal , s__InoriSpells___InoriShot_KS_px[i] , s__InoriSpells___InoriShot_KS_py[i] , a * bj_RADTODEG , 1.5 , InoriAtk_CrystalScale , 50 , - 90)
                    endif
                    set i=i + 1
                else
                    set dx=GetUnitX(s__InoriSpells___InoriShot_KS_dst[i]) - s__InoriSpells___InoriShot_KS_px[i]
                    set dy=GetUnitY(s__InoriSpells___InoriShot_KS_dst[i]) - s__InoriSpells___InoriShot_KS_py[i]
                    if dx * dx + dy * dy <= step * step then
                        call s__InoriSpells___InoriShot_KS_Remove(i)
                    else
                        set a=Atan2(dy, dx)
                        set s__InoriSpells___InoriShot_KS_px[i]=s__InoriSpells___InoriShot_KS_px[i] + step * Cos(a)
                        set s__InoriSpells___InoriShot_KS_py[i]=s__InoriSpells___InoriShot_KS_py[i] + step * Sin(a)
                        call BlzSetSpecialEffectX(s__InoriSpells___InoriShot_KS_fx[i], s__InoriSpells___InoriShot_KS_px[i])
                        call BlzSetSpecialEffectY(s__InoriSpells___InoriShot_KS_fx[i], s__InoriSpells___InoriShot_KS_py[i])
                        call BlzSetSpecialEffectYaw(s__InoriSpells___InoriShot_KS_fx[i], a)
                        set i=i + 1
                    endif
                endif
            endloop
            if s__InoriSpells___InoriShot_KS_count == 0 then
                call InoriSpells___InoriTick_Off(8)
            endif
        endfunction

        function s__InoriSpells___InoriShot_KS_OnAttacked takes nothing returns boolean
            local unit c= GetAttacker()
            if GetUnitTypeId(c) == Inori_ID and s__InoriSpells___InoriShot_KS_count < 64 and InoriCrystalMode(c) then
                set s__InoriSpells___InoriShot_KS_src[s__InoriSpells___InoriShot_KS_count]=c
                set s__InoriSpells___InoriShot_KS_dst[s__InoriSpells___InoriShot_KS_count]=GetTriggerUnit()
                set s__InoriSpells___InoriShot_KS_fx[s__InoriSpells___InoriShot_KS_count]=null
                set s__InoriSpells___InoriShot_KS_wait[s__InoriSpells___InoriShot_KS_count]=InoriAtk_LaunchDelay
                set s__InoriSpells___InoriShot_KS_count=s__InoriSpells___InoriShot_KS_count + 1
                call InoriSpells___InoriTick_On(8)
            endif
            set c=null
            return false
        endfunction

        function s__InoriSpells___InoriShot_KS_onInit takes nothing returns nothing
            local trigger t= CreateTrigger()
            call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_ATTACKED)
            call TriggerAddCondition(t, Condition(function s__InoriSpells___InoriShot_KS_OnAttacked))
            set t=null
        endfunction

        function s__InoriSpells___InoriTick_Loop_Loop takes nothing returns nothing
            if InoriSpells___InoriTick_Active[0] then
                call s__InoriSpells___InoriQ_KS_Loop_InoriQ()
            endif
            if InoriSpells___InoriTick_Active[1] then
                call s__InoriSpells___InoriQ2_KS_Loop_InoriQ2()
            endif
            if InoriSpells___InoriTick_Active[2] then
                call s__InoriSpells___InoriW_KS_Loop_InoriW()
            endif
            if InoriSpells___InoriTick_Active[3] then
                call s__InoriSpells___InoriW2_KS_Loop_InoriW2()
            endif
            if InoriSpells___InoriTick_Active[4] then
                call s__InoriSpells___InoriR_KS_Loop_InoriR()
            endif
            if InoriSpells___InoriTick_Active[5] then
                call s__InoriSpells___InoriR2_KS_Loop_InoriR2()
            endif
            if InoriSpells___InoriTick_Active[6] then
                call s__InoriSpells___InoriT_KS_Loop_InoriT()
            endif
            if InoriSpells___InoriTick_Active[7] then
                call s__InoriSpells___InoriT2_KS_Loop_InoriT2()
            endif
            if InoriSpells___InoriTick_Active[8] then
                call s__InoriSpells___InoriShot_KS_Loop()
            endif
        endfunction

        function s__InoriSpells___InoriTick_Loop_onInit takes nothing returns nothing
            set InoriSpells___InoriTick_Callback=function s__InoriSpells___InoriTick_Loop_Loop
        endfunction


        function s__InoriSpells___InoriTick10_Loop_Loop takes nothing returns nothing
            if InoriSpells___InoriTick10_Active[0] then
                call s__InoriSpells___InoriE_KS_Loop_InoriE()
            endif
            if InoriSpells___InoriTick10_Active[1] then
                call s__InoriSpells___InoriF_KS_Loop_InoriF()
            endif
        endfunction

        function s__InoriSpells___InoriTick10_Loop_onInit takes nothing returns nothing
            set InoriSpells___InoriTick10_Callback=function s__InoriSpells___InoriTick10_Loop_Loop
        endfunction


