        function s__GearSystems2___KS_DamageOverTime_Loop_DmgPTime takes nothing returns nothing
    local integer this
    local integer i= 0
    loop
        exitwhen i > s__GearSystems2___KS_DamageOverTime_MUI_5
        set this=s__GearSystems2___KS_DamageOverTime_m_5[i]
        if s__GearSystems2___KS_DamageOverTime_r[this] < s__GearSystems2___KS_DamageOverTime_rmax[this] and GetWidgetLife(s__GearSystems2___KS_DamageOverTime_td[this]) > 0.405 then
            set s__GearSystems2___KS_DamageOverTime_r3[this]=I2R(R2I(( s__GearSystems2___KS_DamageOverTime_r3[this] + 0.05 ) * 1000.0 + 0.5)) / 1000.0
            if s__GearSystems2___KS_DamageOverTime_r3[this] >= s__GearSystems2___KS_DamageOverTime_r2[this] - 0.001 then // small epsilon avoids float comparison miss
                set s__GearSystems2___KS_DamageOverTime_r3[this]=0
                set s__GearSystems2___KS_DamageOverTime_r[this]=s__GearSystems2___KS_DamageOverTime_r[this] + 1 // count ticks as integer
                if s__GearSystems2___KS_DamageOverTime_k[this] == 0 then
                if s__GearSystems2___KS_DamageOverTime_s[this] == "murasume" then
                    set MurasameTrigger=true
                    if GetUnitAbilityLevel(s__GearSystems2___KS_DamageOverTime_td[this], 'B005') > 0 then
                    set s__GearSystems2___KS_DamageOverTime_r[this]=999
                    set s__GearSystems2___KS_DamageOverTime_dmg[this]=0
                    endif
                    endif
                    set GearDamageNextSource=(s__GearSystems2___KS_DamageOverTime_damageSource[this]) // INLINED!!
                    call dmgphys(s__GearSystems2___KS_DamageOverTime_c[this] , s__GearSystems2___KS_DamageOverTime_td[this] , s__GearSystems2___KS_DamageOverTime_dmg[this])
                if s__GearSystems2___KS_DamageOverTime_s[this] == "murasume" then
                    set MurasameTrigger=false
                    endif
