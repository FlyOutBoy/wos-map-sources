    // Cambio Forma retains the complete W stance; its W3 button stays available.
    function TsunaSpells___TsunaCambio_RefreshW takes unit c returns nothing
        if GetUnitAbilityLevel(c, TsunaW_Buff_ID) == 0 then
            call BuffUnit1(c , c , 4)
            call s__GearSystems2___KS_BuffEffect_MyBuffEff_Start((c ) , ( TsunaW_Buff_ID ) , ( AddSpecialEffectTarget("war3mapImported\\wos_icefile00002579.mdl", c, "hand right"))) // INLINED!!
            call s__GearSystems2___KS_BuffEffect_MyBuffEff_Start((c ) , ( TsunaW_Buff_ID ) , ( AddSpecialEffectTarget("war3mapImported\\wos_icefile00002579.mdl", c, "hand left"))) // INLINED!!
        endif
    endfunction
    function TsunaCambio_OnAttack takes unit c,unit td returns nothing
        local real dmg
        if LoadInteger(hs, GetHandleId(c), TsunaSpells___SH_TSUNA_CAMBIO) == 1 and GetUnitAbilityLevel(c, TsunaW_Buff_ID) == 0 then
            set dmg=GetHeroAgi(c, true) * ( TsunaW_DamageAgiBase + TsunaW_DamageAgiStep * ( GetUnitAbilityLevel(c, TsunaW_ID) - 1 ) )
            set dmg=dmg + TsunaW_Damage2StaticBase + TsunaW_Damage2StaticStep * ( GetUnitAbilityLevel(c, TsunaW_ID) - 1 )
            call RootUnit(c , td , TsunaW_Root)
            set GearDamageNextSource=('A083') // INLINED!!
            call s__GearSystems2___KS_DelayedDamage_NextDmg_Start((c ) , ( td ) , (( dmg )*1.0) , ( 0 ) , (( 0.05)*1.0)) // INLINED!!
            call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\wos_file00003436.mdl", td, "chest"))
            call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\wos_az_nevermoreice_x.mdl", td, "origin"))
        endif
    endfunction

