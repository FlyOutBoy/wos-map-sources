                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_1mt_shui1.mdl" , GetUnitX(s__TakeshiSpells___TakeshiSpells_G_c[this]) + 0 * Cos(s__TakeshiSpells___TakeshiSpells_G_a[this]) , GetUnitY(s__TakeshiSpells___TakeshiSpells_G_c[this]) + 0 * Sin(s__TakeshiSpells___TakeshiSpells_G_a[this]) , s__TakeshiSpells___TakeshiSpells_G_a[this] * bj_RADTODEG , 1 , 2.25 , 150))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_2-[tx]-03-03jianta (3)_1.mdl" , s__TakeshiSpells___TakeshiSpells_G_x[this] , s__TakeshiSpells___TakeshiSpells_G_y[this] , 1 , 2 , 1 , 1))
                        set GearDamageNextSource=('A099') // INLINED!!
                        call dmgphys(s__TakeshiSpells___TakeshiSpells_G_c[this] , s__TakeshiSpells___TakeshiSpells_G_td[this] , s__TakeshiSpells___TakeshiSpells_G_dmg[this])
                        set GearDamageNextSource=('A099') // INLINED!!
                        call ErzaPassive(s__TakeshiSpells___TakeshiSpells_G_c[this] , s__TakeshiSpells___TakeshiSpells_G_td[this] , 2)
                        call RootUnit(s__TakeshiSpells___TakeshiSpells_G_c[this] , s__TakeshiSpells___TakeshiSpells_G_td[this] , TakeshiGF_Root)
                        call MakeSound("war3mapimported\\Hero_Takeshi_GR2")
                        set s__TakeshiSpells___TakeshiSpells_G_r[this]=9999
                    endif
                endif
            else
                call StopSpellUnit2(s__TakeshiSpells___TakeshiSpells_G_td[this])
                call StopSpellUnit2(s__TakeshiSpells___TakeshiSpells_G_c[this])
                call DestroyEffect(s__TakeshiSpells___TakeshiSpells_G_e[this])
                set s__TakeshiSpells___TakeshiSpells_G_c[this]=null
                set s__TakeshiSpells___TakeshiSpells_G_td[this]=null
                set s__TakeshiSpells___TakeshiSpells_G_e[this]=null
                set s__TakeshiSpells___TakeshiSpells_G_m_TakeshiGF[i]=s__TakeshiSpells___TakeshiSpells_G_m_TakeshiGF[s__TakeshiSpells___TakeshiSpells_G_MUI_TakeshiGF]
                set s__TakeshiSpells___TakeshiSpells_G_MUI_TakeshiGF=s__TakeshiSpells___TakeshiSpells_G_MUI_TakeshiGF - 1
                set i=i - 1 // revisit: the moved instance must not skip this tick
                if s__TakeshiSpells___TakeshiSpells_G_MUI_TakeshiGF == - 1 then
                    call TakeshiSpells___TakeshiTick_Off(15)
                endif
                call s__TakeshiSpells___TakeshiSpells_G_deallocate(this)
            endif
            set i=i + 1
        endloop
    endfunction

    function s__TakeshiSpells___TakeshiSpells_G_TakeshiGF_Start takes unit NewC,unit NewTd returns nothing
        local integer this= s__TakeshiSpells___TakeshiSpells_G__allocate()
        set s__TakeshiSpells___TakeshiSpells_G_MUI_TakeshiGF=s__TakeshiSpells___TakeshiSpells_G_MUI_TakeshiGF + 1
        set s__TakeshiSpells___TakeshiSpells_G_m_TakeshiGF[s__TakeshiSpells___TakeshiSpells_G_MUI_TakeshiGF]=this
        set s__TakeshiSpells___TakeshiSpells_G_c[this]=NewC
        set s__TakeshiSpells___TakeshiSpells_G_td[this]=NewTd
        set s__TakeshiSpells___TakeshiSpells_G_r[this]=0
        set s__TakeshiSpells___TakeshiSpells_G_r2[this]=0
        set s__TakeshiSpells___TakeshiSpells_G_move[this]=70
        set s__TakeshiSpells___TakeshiSpells_G_r5[this]=0
        set s__TakeshiSpells___TakeshiSpells_G_check[this]=0
        call StartSpellUnit2(s__TakeshiSpells___TakeshiSpells_G_c[this])
        set s__TakeshiSpells___TakeshiSpells_G_a[this]=GAngle(s__TakeshiSpells___TakeshiSpells_G_c[this] , s__TakeshiSpells___TakeshiSpells_G_td[this]) // Angle Between points
        set s__TakeshiSpells___TakeshiSpells_G_dmg[this]=GetHeroAgi(s__TakeshiSpells___TakeshiSpells_G_c[this], true) * TakeshiGF_DamageAgiBase
        if GetUnitAbilityLevel(s__TakeshiSpells___TakeshiSpells_G_c[this], TakeshiT_Buff_ID) > 0 then
            set s__TakeshiSpells___TakeshiSpells_G_dmg[this]=s__TakeshiSpells___TakeshiSpells_G_dmg[this] + GetHeroAgi(s__TakeshiSpells___TakeshiSpells_G_c[this], true) * TakeshiT_AddDmg
        endif
        set s__TakeshiSpells___TakeshiSpells_G_rmax[this]=1.5
        call SetUnitAnimationByIndex(s__TakeshiSpells___TakeshiSpells_G_c[this], 16)
        call SetUnitTimeScale(s__TakeshiSpells___TakeshiSpells_G_c[this], 1.95)
        set s__TakeshiSpells___TakeshiSpells_G_e[this]=AddSpecialEffectTarget("war3mapImported\\wos_Windwalk Blue Soul.mdx", s__TakeshiSpells___TakeshiSpells_G_c[this], "hand right")
        call MakeSound("war3mapimported\\Hero_Takeshi_GF")
        if s__TakeshiSpells___TakeshiSpells_G_MUI_TakeshiGF == 0 then
            call TakeshiSpells___TakeshiTick_On(15)
        endif
    endfunction


