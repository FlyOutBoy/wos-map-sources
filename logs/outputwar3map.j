            call BlzStartUnitAbilityCooldown(s__KiritoSpells___KiritoSpells_G_c[this], KiritoG_ID, s__KiritoSpells___KiritoSpells_G_r2[this])
        endfunction

        // Hero level 35: each own ability cast brings the next G heal closer.
        function s__KiritoSpells___KiritoSpells_G_KiritoG_CastReduce takes unit NewC returns nothing
            local integer this= LoadInteger(hs, GetHandleId(NewC), KiritoSpells___SH_KIRITO_G)
            if this == 0 or s__KiritoSpells___KiritoSpells_G_c[this] != NewC or GetHeroLevel(NewC) < 35 then
                return
            endif
            set s__KiritoSpells___KiritoSpells_G_r2[this]=RMaxBJ(s__KiritoSpells___KiritoSpells_G_PERIOD, s__KiritoSpells___KiritoSpells_G_r2[this] - KiritoG_CastReduce35)
            call BlzStartUnitAbilityCooldown(s__KiritoSpells___KiritoSpells_G_c[this], KiritoG_ID, s__KiritoSpells___KiritoSpells_G_r2[this])
        endfunction


