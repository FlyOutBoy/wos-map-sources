            elseif s__ItemsElementsFx_kind[this] == s__ItemsElementsFx_COILSHOT then
                if s__ItemsElementsFx_phase[this] == 0 then
                    set s__ItemsElementsFx_step[this]=RMinBJ(s__ItemsElementsFx_next[this], s__ItemsElementsFx_step[this] + ConstellationCoil_Speed * s__ItemsElementsFx_DT)
                    set px=s__ItemsElementsFx_x[this] + s__ItemsElementsFx_vx[this] * s__ItemsElementsFx_step[this]
                    set py=s__ItemsElementsFx_y[this] + s__ItemsElementsFx_vy[this] * s__ItemsElementsFx_step[this]
                    call BlzSetSpecialEffectX(s__ItemsElementsFx_e[this], px)
                    call BlzSetSpecialEffectY(s__ItemsElementsFx_e[this], py)
                    call BlzSetSpecialEffectX(s__ItemsElementsFx_e2[this], px)
                    call BlzSetSpecialEffectY(s__ItemsElementsFx_e2[this], py)
                    call s__ItemsElementsFx_Sweep(this,px , py , ConstellationCoil_Width , s__ItemsElementsFx_g[this] , null , s__ItemsElementsFx_dmg[this] , true , 3 , 0.0 , ConstellationCoil_Slow)
                    call s__ItemsElementsFx_DragCaught(this,px , py)
                    if s__ItemsElementsFx_u[this] != null then
                        set s__ItemsElementsFx_ty[this]=s__ItemsElementsFx_ty[this] + s__ItemsElementsFx_DT
                    endif
                    if showVision then
                        call VisionTimed(GetOwningPlayer(s__ItemsElementsFx_c[this]) , px , py , RMaxBJ(750.0, ConstellationCoil_Width * 1.5) , 0.3)
                    endif
                    if s__ItemsElementsFx_step[this] >= s__ItemsElementsFx_next[this] or ( s__ItemsElementsFx_u[this] != null and s__ItemsElementsFx_ty[this] + 0.000001 >= 0.3 ) then
                        set s__ItemsElementsFx_phase[this]=1
                        set s__ItemsElementsFx_x[this]=px
                        set s__ItemsElementsFx_y[this]=py
                        set s__ItemsElementsFx_left[this]=2.0
                        set s__ItemsElementsFx_step[this]=0.0
                        set s__ItemsElementsFx_next[this]=0.5
                    endif
                else
