                else
                    call s__ItemsElementsFx_Sweep(this,px , py , 110 , s__ItemsElementsFx_g2[this] , null , s__ItemsElementsFx_dmg2[this] , false , 1 , 0.0 , 0)
                endif
                set px=s__ItemsElementsFx_x[this] + s__ItemsElementsFx_step[this] * Cos(a + 0.35)
                set py=s__ItemsElementsFx_y[this] + s__ItemsElementsFx_step[this] * Sin(a + 0.35)
                if s__ItemsElementsFx_phase[this] == 1 then
                    set px=px + ( s__ItemsElementsFx_tx[this] - s__ItemsElementsFx_x[this] ) * ( 1.0 - s__ItemsElementsFx_step[this] / s__ItemsElementsFx_next[this] )
                    set py=py + ( s__ItemsElementsFx_ty[this] - s__ItemsElementsFx_y[this] ) * ( 1.0 - s__ItemsElementsFx_step[this] / s__ItemsElementsFx_next[this] )
                endif
