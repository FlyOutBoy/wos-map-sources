                        call s__AstaSpells__AstaSpells_Q_AstaQ3_Start(s__AstaSpells__AstaSpells_Q_c[this] , s__AstaSpells__AstaSpells_Q_x[this] , s__AstaSpells__AstaSpells_Q_y[this] , 1)
