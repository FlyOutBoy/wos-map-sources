        function s__AlucardSpells__AlucardSpells_Q_AlucardQ2_Start takes unit NewC,unit NewTd returns nothing
            local integer this= s__AlucardSpells__AlucardSpells_Q__allocate()
            set s__AlucardSpells__AlucardSpells_Q_MUI_AlucardQ=s__AlucardSpells__AlucardSpells_Q_MUI_AlucardQ + 1
            set s__AlucardSpells__AlucardSpells_Q_m_AlucardQ[s__AlucardSpells__AlucardSpells_Q_MUI_AlucardQ]=this
            set s__AlucardSpells__AlucardSpells_Q_c[this]=NewC
            set s__AlucardSpells__AlucardSpells_Q_src[this]=AlucardQ_ID
            if LoadInteger(hs, GetHandleId(GetOwningPlayer(s__AlucardSpells__AlucardSpells_Q_c[this])), AlucardSpells__SH_MORPH_R) == 1 then
                set s__AlucardSpells__AlucardSpells_Q_src[this]=DamageSourceVariant(AlucardQ_ID , 1 , "RQ")
            endif
            set s__AlucardSpells__AlucardSpells_Q_td[this]=NewTd
            set s__AlucardSpells__AlucardSpells_Q_r[this]=0
            set s__AlucardSpells__AlucardSpells_Q_r2[this]=0
            set s__AlucardSpells__AlucardSpells_Q_move[this]=0
            set s__AlucardSpells__AlucardSpells_Q_r6[this]=0
