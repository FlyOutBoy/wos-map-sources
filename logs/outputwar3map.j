        call s__HarribelSpells___HarribelSpells_G_HarribelG_Start(c)
    endfunction
     function HarribelG2_Start takes unit c,real dmg returns nothing
        local group g= CreateGroup()
        local unit u
        local real x= GetUnitX(c)
        local real y= GetUnitY(c)
        local real aoe= 3500
        local real r
        call GroupClear(g)
        call GroupEnumUnitsInRange(g, x, y, aoe, null)
        loop
            set u=FirstOfGroup(g)
            exitwhen u == null
            if IsUnitAlly(u, GetOwningPlayer(c)) and GetWidgetLife(u) > 1 and IsUnitIllusion(u) == false and GetUnitTypeId(u) == Harribel_ID and GetHeroLevel(u) >= 12 then
            set r=LoadReal(hs, GetHandleId(u), HarribelSpells___SH_DMG_COUNT)
            call SaveReal(hs, GetHandleId(u), HarribelSpells___SH_DMG_COUNT, r + ( dmg * 0.1 ))
            endif
            call GroupRemoveUnit(g, u)
        endloop
        call DestroyGroup(g)
        set g=null
        set u=null
    endfunction
    function HarribelPas takes unit c returns nothing
        local real heal
        local real r
        local real lvl= GetHeroLevel(c)
        if lvl >= 35 then
        set r=Harribel_Pas_RestoreHp3 / 100
        elseif lvl >= 25 then
        set r=Harribel_Pas_RestoreHp2 / 100
        elseif lvl >= 12 then
        set r=Harribel_Pas_RestoreHp1 / 100
        endif
        if GetHeroLevel(c) >= 12 and IsUnitType(c, UNIT_TYPE_DEAD) then
        set heal=r * GetUnitState(c, UNIT_STATE_MAX_LIFE)
        call SetHpCurrent2Quiet(c , c , heal)
        call s__GearSystems2___KS_MoveEffectToUnit_MoveEffectToUnit_Start((EffectSpawn("war3mapImported\\wos_effect_lv131.mdl" , GetUnitX(c) , GetUnitY(c) , 1 , 1 , 1 , 40) ) , (( 0.6 )*1.0) , (( 40 )*1.0) , ( c) , 0 , 1 , null) // INLINED!!
        call MakeSound("war3mapImported\\Hero_Harribel_G2")
       endif
    endfunction  

        function s__HarribelSpells___HarribelTick_Loop_Loop takes nothing returns nothing
            if HarribelSpells___HarribelTick_Active[0] then
                call s__HarribelSpells___HarribelSpells_Q_Loop_HarribelQ()
            endif
            if HarribelSpells___HarribelTick_Active[1] then
                call s__HarribelSpells___HarribelSpells_W_Loop_HarribelW()
            endif
            if HarribelSpells___HarribelTick_Active[2] then
                call s__HarribelSpells___HarribelSpells_R_Loop_HarribelR()
            endif
            if HarribelSpells___HarribelTick_Active[3] then
                call s__HarribelSpells___HarribelSpells_R_Loop_HarribelR3()
            endif
            if HarribelSpells___HarribelTick_Active[4] then
                call s__HarribelSpells___HarribelSpells_T_Loop_HarribelT()
            endif
        endfunction

        function s__HarribelSpells___HarribelTick_Loop_onInit takes nothing returns nothing
            set HarribelSpells___HarribelTick_Callback=function s__HarribelSpells___HarribelTick_Loop_Loop
        endfunction


