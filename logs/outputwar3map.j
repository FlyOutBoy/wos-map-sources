                    set s__TsunaSpells___TsunaG3KS_g[this]=null
                    set s__TsunaSpells___TsunaG3KS_u[this]=null
                    set s__TsunaSpells___TsunaG3KS_m_TsunaG3[i]=s__TsunaSpells___TsunaG3KS_m_TsunaG3[s__TsunaSpells___TsunaG3KS_MUI_TsunaG3]
                    set s__TsunaSpells___TsunaG3KS_MUI_TsunaG3=s__TsunaSpells___TsunaG3KS_MUI_TsunaG3 - 1
                    set i=i - 1 // revisit: the moved instance must not skip this tick
                    if s__TsunaSpells___TsunaG3KS_MUI_TsunaG3 == - 1 then
                        call TsunaSpells___TsunaTick_Off(9)
                    endif
                    call s__TsunaSpells___TsunaG3KS_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction
        function s__TsunaSpells___TsunaG3KS_TsunaG3_Start takes unit NewC returns nothing
            local integer this= s__TsunaSpells___TsunaG3KS__allocate()
            set s__TsunaSpells___TsunaG3KS_MUI_TsunaG3=s__TsunaSpells___TsunaG3KS_MUI_TsunaG3 + 1
            set s__TsunaSpells___TsunaG3KS_m_TsunaG3[s__TsunaSpells___TsunaG3KS_MUI_TsunaG3]=this
            set s__TsunaSpells___TsunaG3KS_c[this]=NewC
            set s__TsunaSpells___TsunaG3KS_r[this]=0
            set s__TsunaSpells___TsunaG3KS_u[this]=null
            set s__TsunaSpells___TsunaG3KS_check2[this]=0
            set s__TsunaSpells___TsunaG3KS_g[this]=CreateGroup()
            set s__TsunaSpells___TsunaG3KS_aoe[this]=TsunaG3_DamageAoe
            call SaveInteger(hs, GetHandleId(s__TsunaSpells___TsunaG3KS_c[this]), TsunaSpells___SH_MODE_DEF, 1)
            set s__TsunaSpells___TsunaG3KS_e[this]=AddSpecialEffectTarget("war3mapImported\\wos_sawada_def01.mdl", s__TsunaSpells___TsunaG3KS_c[this], "chest")
            set s__TsunaSpells___TsunaG3KS_rmax[this]=TsunaG3_Duration
            call MakeSound("war3mapimported\\Hero_Tsuna_GG")
            call s__GearSystems2___KS_BuffTimer_MyBuffTime_Start((s__TsunaSpells___TsunaG3KS_c[this] ) , ( TsunaG3_Buff_ID ) , (( s__TsunaSpells___TsunaG3KS_rmax[this] )*1.0) , ( "BTNHero_Tsuna_TG" ) , ( true ) , - 1 , 0 , 0 , ( 1)) // INLINED!!
            if s__TsunaSpells___TsunaG3KS_MUI_TsunaG3 == 0 then
                call TsunaSpells___TsunaTick_On(9)
            endif
        endfunction

    function TsunaDodge takes unit c,unit td returns nothing
        local real cd= 0
        call s__GearSystems2___KS_MoveEffectToUnit_MoveEffectToUnit_Start((EffectSpawn("war3mapImported\\wos_az_wsy_gather3.mdl" , GetUnitX(c) , GetUnitY(c) , 1 , 1 , 2 , 90) ) , (( TsunaF_DodgeDuration )*1.0) , (( 90 )*1.0) , ( c) , 0 , 1 , null) // INLINED!!
        call MakeSound("war3mapimported\\Hero_Tsuna_F")
        if GetHeroLevel(c) >= 35 then
            set cd=TsunaF_CD35
        elseif GetHeroLevel(c) >= 25 then
            set cd=TsunaF_CD25
        else
            set cd=TsunaF_CD12
        endif
        if IsUnitPaused(c) == false then
            call MUE(c , TsunaF_DodgeDistance , TsunaF_DodgeDuration , GAngle(c , td) + GetRandomReal(- 30, 30) * bj_DEGTORAD)
        endif
        call PassiveCD_Start(c , TsunaF_ID , cd)
    endfunction
