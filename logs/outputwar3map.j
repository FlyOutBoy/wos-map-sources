    call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\wos_a (396).mdl", c, "origin"))
    call DecorRemove(c , GetUnitX(c) , GetUnitY(c) , 650 , 50)
    endif
    
    endif
    elseif b == false then
    // Rooted: by SPELL_EFFECT the engine has already started the native CD and
