                set s__ErzaRSpells__Erza4F_KS_e[this]=AddSpecialEffectTarget("war3mapImported\\wos_obr08 (166).mdx", s__ErzaRSpells__Erza4F_KS_c[this], "hand right")
                set s__ErzaRSpells__Erza4F_KS_e2[this]=AddSpecialEffectTarget("war3mapimported\\wos_laz (167).mdx", s__ErzaRSpells__Erza4F_KS_c[this], "hand left")
                set s__ErzaRSpells__Erza4F_KS_r5[this]=Erza4F_AddErzaSpellDamage_2Element
                set s__ErzaRSpells__Erza4F_KS_check[this]=Erza4F_AttackDamageAdd_2Element
                set s__ErzaRSpells__Erza4F_KS_check2[this]=6
            elseif s__ErzaRSpells__Erza4F_KS_k2[this] == 1 and s__ErzaRSpells__Erza4F_KS_k3[this] == 0 then // fire sword
