// Displayed/total regen: heal amplifiers (Ainz F, Shun Shun Rikka) also boost passive regen.
function GetHpRegen takes unit c returns real
 if GetUnitAbilityLevel(c, CinderFang_Buff_ID) > 0 then
  return 0.00
 endif
// Scripted restores (Elixir, HPS items, lifesteal, hero heals) are already amplified.
return GetHpRegenBase(c) * RMaxBJ(0.00, GetHealMultiplier(c)) + (HealRegenRate((c) , SH_REGEN_HP_SUM , SH_REGEN_HP_START , SH_REGEN_HP_SHOWN)) // amps and all heal cuts (Grail, Inori T, Kirito T, Rimuru Q...) // INLINED!!
endfunction
function GetMpRegenNative takes unit c returns real
 return BlzGetUnitRealField(c, UNIT_RF_MANA_REGENERATION) + GetHeroInt(c, true) * int_mpregen
endfunction
function GetMpRegenBase takes unit c returns real
 if GetUnitAbilityLevel(c, ChogurtEvolved_AuraBuff_ID) > 0 then // Chogurt Evolved aura (added by HealAmp_Apply)
  return GetMpRegenNative(c) + ChogurtEvolved_AuraMpRegen
 endif
 return GetMpRegenNative(c)
endfunction
function GetMpRegen takes unit c returns real
 if GetUnitAbilityLevel(c, CinderFang_Buff_ID) > 0 then
  return 0.00
 endif
 if GetUnitAbilityLevel(c, FiveElementsSeal_Buff_ID) > 0 then // Five Elements Seal: no mana regeneration
  return 0.00
 endif
 return GetMpRegenBase(c) * ( 1.00 + GetManaAmp(c) ) + (HealRegenRate((c) , SH_REGEN_MP_SUM , SH_REGEN_MP_START , SH_REGEN_MP_SHOWN)) // INLINED!!
endfunction


function GearSystems__HealAmp_Apply takes unit u returns nothing
    local real amp
    local real r
    if u == null or GetWidgetLife(u) <= 0.405 then
        return
    endif
    if GetUnitAbilityLevel(u, CinderFang_Buff_ID) > 0 then
        return
    endif
    // Net multiplier on passive regen: amplifiers minus Hell Blaze stacks.
    set amp=GetHealMultiplierNoBlock(u) - 1.00 // BlockRegen cuts are applied by BlockRegen itself
    if amp != 0.00 and GetUnitState(u, UNIT_STATE_LIFE) < GetUnitState(u, UNIT_STATE_MAX_LIFE) then
        set r=GetHpRegenBase(u) * RMaxBJ(- 1.00, amp) * GearSystems__HEAL_AMP_PERIOD
        if r > 0.00 then
            call SetUnitState(u, UNIT_STATE_LIFE, GetUnitState(u, UNIT_STATE_LIFE) + r)
        elseif r < 0.00 then
            call SetUnitState(u, UNIT_STATE_LIFE, RMaxBJ(1.00, GetUnitState(u, UNIT_STATE_LIFE) + r))
        endif
    endif
    if GetUnitAbilityLevel(u, FiveElementsSeal_Buff_ID) > 0 then
        // Five Elements Seal: cancel the native mana regeneration of this period.
        set r=GetMpRegenNative(u) * GearSystems__HEAL_AMP_PERIOD
        if r > 0.00 then
            call SetUnitState(u, UNIT_STATE_MANA, RMaxBJ(0.00, GetUnitState(u, UNIT_STATE_MANA) - r))
        endif
        return
    endif
    set amp=GetManaAmp(u)
    // Amplified part of the regeneration plus the scripted Chogurt Evolved aura.
    set r=GetMpRegenBase(u) * RMaxBJ(0.00, amp) * GearSystems__HEAL_AMP_PERIOD
    if GetUnitAbilityLevel(u, ChogurtEvolved_AuraBuff_ID) > 0 then
        set r=r + ChogurtEvolved_AuraMpRegen * GearSystems__HEAL_AMP_PERIOD
    endif
    if r > 0.00 and GetUnitState(u, UNIT_STATE_MANA) < GetUnitState(u, UNIT_STATE_MAX_MANA) then
        call SetUnitState(u, UNIT_STATE_MANA, GetUnitState(u, UNIT_STATE_MANA) + r)
    endif
endfunction

function GearSystems__HealAmp_Tick takes nothing returns nothing
    local integer i= 0
    loop
        exitwhen i >= 10
        call GearSystems__HealAmp_Apply(Hero[i])
        set i=i + 1
    endloop
    if TestMode then
        call GearSystems__HealAmp_Apply(TestUnit)
        call GearSystems__HealAmp_Apply(TestAllyUnit)
    endif
endfunction

function HealAmp_StartClock takes nothing returns nothing
    call TimerStart(GearSystems__HealAmp_Timer, GearSystems__HEAL_AMP_PERIOD, true, function GearSystems__HealAmp_Tick)
endfunction
function GetAS takes unit c returns real
local real base= BlzGetUnitWeaponRealField(c, UNIT_WEAPON_RF_ATTACK_BASE_COOLDOWN, 0)
local real ias= GetHeroAgi(c, true) * agi_as
if GetUnitAbilityLevel(c, 'A0BY') > 0 then
set ias=ias + ( 0.05 * GetUnitAbilityLevel(c, 'A0BY') )
endif
if ias > 4.0 then
    set ias=4.0
endif
return base / ( 1.0 + ias )
endfunction
