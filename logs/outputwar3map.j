                        call DecorRemove(s__TakeshiSpells___TakeshiSpells_Q_c[this] , s__TakeshiSpells___TakeshiSpells_Q_x[this] , s__TakeshiSpells___TakeshiSpells_Q_y[this] , s__TakeshiSpells___TakeshiSpells_Q_aoe[this] , 25)
                        call MakeSound("war3mapimported\\Hero_Takeshi_Q3")
                        set s__TakeshiSpells___TakeshiSpells_Q_e2[this]=EffectSpawn("war3mapImported\\wos_water dash.mdl" , GetUnitX(s__TakeshiSpells___TakeshiSpells_Q_c[this]) - 165 * Cos(s__TakeshiSpells___TakeshiSpells_Q_a[this]) , GetUnitY(s__TakeshiSpells___TakeshiSpells_Q_c[this]) - 165 * Sin(s__TakeshiSpells___TakeshiSpells_Q_a[this]) , s__TakeshiSpells___TakeshiSpells_Q_a[this] * bj_RADTODEG , 1 , 1.65 , 0)
                        set s__TakeshiSpells___TakeshiSpells_Q_r5[this]=0
