                    call AinzSpells__AinzFinishSwap(s__AinzSpells__AinzW_KS_c[this] , AinzW2_ID)
                    if s__AinzSpells__AinzW_KS_d[this] != null and GetUnitState(s__AinzSpells__AinzW_KS_d[this], UNIT_STATE_LIFE) > 0.405 then
                        call KillUnit(s__AinzSpells__AinzW_KS_d[this])
                        call EffectSpawn2("war3mapImported\\wos_raidenei-4.mdl" , GetUnitX(s__AinzSpells__AinzW_KS_d[this]) , GetUnitY(s__AinzSpells__AinzW_KS_d[this]) , s__AinzSpells__AinzW_KS_a[this] * bj_RADTODEG , 2 , 1.5 , 0 , 0.3)
