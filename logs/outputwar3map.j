                set m=s__ItemsElementsFx_Mark(s__ItemsElementsFx_PHOENIX , s__ItemsElementsFx_src[this] , s__ItemsElementsFx_c[this] , s__ItemsElementsFx_u[this] , 3.0 , "Abilities\\Spells\\Other\\SoulBurn\\SoulBurnbuff.mdl")
