                        set s__TakeshiSpells___TakeshiSpells_Q_y2[this]=LoadReal(hs, GetHandleId(s__TakeshiSpells___TakeshiSpells_Q_c[this]), TakeshiSpells___SH_T_Y)
                        if SR0(GetUnitX(s__TakeshiSpells___TakeshiSpells_Q_c[this]) + s__TakeshiSpells___TakeshiSpells_Q_move[this] * Cos(s__TakeshiSpells___TakeshiSpells_Q_a[this]) , GetUnitY(s__TakeshiSpells___TakeshiSpells_Q_c[this]) + s__TakeshiSpells___TakeshiSpells_Q_move[this] * Sin(s__TakeshiSpells___TakeshiSpells_Q_a[this]) , s__TakeshiSpells___TakeshiSpells_Q_x2[this] , s__TakeshiSpells___TakeshiSpells_Q_y2[this]) < TakeshiT_DamageAoe - 220 then
