        function s__NeuvilletteSpells___NeuvilletteSpells_T_NeuvilletteT_Start takes unit NewC returns nothing
            local integer this
            local real a
            local integer waves

            if NewC == null or GetUnitTypeId(NewC) == 0 or GetWidgetLife(NewC) <= 0.405 then
                return
            endif

            set this=s__NeuvilletteSpells___NeuvilletteSpells_T__allocate()
            set s__NeuvilletteSpells___NeuvilletteSpells_T_MUI_NeuvilletteT=s__NeuvilletteSpells___NeuvilletteSpells_T_MUI_NeuvilletteT + 1
            set s__NeuvilletteSpells___NeuvilletteSpells_T_m_NeuvilletteT[s__NeuvilletteSpells___NeuvilletteSpells_T_MUI_NeuvilletteT]=this
            set s__NeuvilletteSpells___NeuvilletteSpells_T_c[this]=NewC
            set s__NeuvilletteSpells___NeuvilletteSpells_T_x[this]=GetUnitX(s__NeuvilletteSpells___NeuvilletteSpells_T_c[this])
            set s__NeuvilletteSpells___NeuvilletteSpells_T_y[this]=GetUnitY(s__NeuvilletteSpells___NeuvilletteSpells_T_c[this])
            set s__NeuvilletteSpells___NeuvilletteSpells_T_r[this]=0.0
            set s__NeuvilletteSpells___NeuvilletteSpells_T_r2[this]=0.15
            set s__NeuvilletteSpells___NeuvilletteSpells_T_r5[this]=0.0
            set s__NeuvilletteSpells___NeuvilletteSpells_T_pillarsSpawned[this]=0

            // Автоматический расчет длительности поддержания под количество волн спавна
            set waves=( NeuvilletteT_PillarsCount + 1 ) / 2
            set s__NeuvilletteSpells___NeuvilletteSpells_T_rmax[this]=0.70 + ( I2R(waves) * 0.15 ) + 0.15

            set s__NeuvilletteSpells___NeuvilletteSpells_T_aoe[this]=NeuvilletteT_DamageAoe
            set s__NeuvilletteSpells___NeuvilletteSpells_T_dmg[this]=GetHeroInt(s__NeuvilletteSpells___NeuvilletteSpells_T_c[this], true) * NeuvilletteT_DamageIntBase
            set s__NeuvilletteSpells___NeuvilletteSpells_T_g[this]=CreateGroup()
            set a=GAngle2(s__NeuvilletteSpells___NeuvilletteSpells_T_c[this] , s__NeuvilletteSpells___NeuvilletteSpells_T_x[this] , s__NeuvilletteSpells___NeuvilletteSpells_T_y[this])

            if NeuvilletteT_IsInvul then
                call StartSpellUnit(s__NeuvilletteSpells___NeuvilletteSpells_T_c[this])
            else
                call StartSpellUnit2(s__NeuvilletteSpells___NeuvilletteSpells_T_c[this])
            endif

            call SetUnitAnimationByIndex(s__NeuvilletteSpells___NeuvilletteSpells_T_c[this], 0)
            call SetUnitTimeScale(s__NeuvilletteSpells___NeuvilletteSpells_T_c[this], 0.50)
            call VisionTimed(GetOwningPlayer(s__NeuvilletteSpells___NeuvilletteSpells_T_c[this]) , s__NeuvilletteSpells___NeuvilletteSpells_T_x[this] , s__NeuvilletteSpells___NeuvilletteSpells_T_y[this] , s__NeuvilletteSpells___NeuvilletteSpells_T_aoe[this] + 800.0 , 4.0)

            if LoadInteger(hs, GetHandleId(GetOwningPlayer(s__NeuvilletteSpells___NeuvilletteSpells_T_c[this])), NeuvilletteSpells___SH_NEVI_SOUND) == 1 then
                call MakeSound("war3mapImported\\Hero_Neuvillette2_T")
            else
                call MakeSound("war3mapimported\\Hero_Neuvillette_T")
            endif
            call MakeSound("war3mapimported\\Hero_Neuvillette_T3")

            set s__NeuvilletteSpells___NeuvilletteSpells_T_e[this]=EffectSpawn("war3mapImported\\wos_hakkestart.mdl" , s__NeuvilletteSpells___NeuvilletteSpells_T_x[this] , s__NeuvilletteSpells___NeuvilletteSpells_T_y[this] , a * bj_RADTODEG + 180.0 , 1.0 , 2.0 , 4.0)
            call s__GearSystems2___KS_RemoveEffect_MyRemoveEff_Start((s__NeuvilletteSpells___NeuvilletteSpells_T_e[this] ) , (( 0.25 )*1.0) , 1 , (( 0)*1.0) , - 1 , "") // INLINED!!
            set s__NeuvilletteSpells___NeuvilletteSpells_T_e2[this]=EffectSpawn("war3mapImported\\wos_water_sign.mdl" , s__NeuvilletteSpells___NeuvilletteSpells_T_x[this] , s__NeuvilletteSpells___NeuvilletteSpells_T_y[this] , s__NeuvilletteSpells___NeuvilletteSpells_T_r5[this] * bj_RADTODEG + 180.0 , 0.2 , 0.6 , 1385.0)
            call ScaleEffDummy(s__NeuvilletteSpells___NeuvilletteSpells_T_e2[this] , 0.3 , 0.01 , 3.0)
            call ColorEffDummy4(s__NeuvilletteSpells___NeuvilletteSpells_T_e2[this] , 0 , 255 , 255 , 255 , 0.15)
            set s__NeuvilletteSpells___NeuvilletteSpells_T_e3[this]=AddSpecialEffectTarget("war3mapImported\\wos_aurapartblue.mdl", s__NeuvilletteSpells___NeuvilletteSpells_T_c[this], "origin")

            if s__NeuvilletteSpells___NeuvilletteSpells_T_MUI_NeuvilletteT == 0 then
                call NeuvilletteSpells___NeuvilletteTimer03Acquire()
            endif
        endfunction


