                    call DestroyGroup(s__FrierenSpells__FrierenSpells_T_g[this])
                    set s__FrierenSpells__FrierenSpells_T_c[this]=null
                    set s__FrierenSpells__FrierenSpells_T_e[this]=null
                    set s__FrierenSpells__FrierenSpells_T_g[this]=null
                    set s__FrierenSpells__FrierenSpells_T_e2[this]=null
                    set s__FrierenSpells__FrierenSpells_T_m_FrierenT[i]=s__FrierenSpells__FrierenSpells_T_m_FrierenT[s__FrierenSpells__FrierenSpells_T_MUI_FrierenT]
