                                call VisionTimed(GetOwningPlayer(s__PatriotSpells___PatriotSpells_R_c[this]) , s__PatriotSpells___PatriotSpells_R_x1[this] , s__PatriotSpells___PatriotSpells_R_y1[this] , 1000.0 , 2.0)
                                call GroupEnumUnitsInRange(s__PatriotSpells___PatriotSpells_R_g[this], s__PatriotSpells___PatriotSpells_R_x1[this], s__PatriotSpells___PatriotSpells_R_y1[this], s__PatriotSpells___PatriotSpells_R_aoe[this], NoDecor_Cond)
                                loop
