        set s__RimuruSpells___Rimuru3R_KS_r[this]=0
        set s__RimuruSpells___Rimuru3R_KS_r5[this]=0
        set s__RimuruSpells___Rimuru3R_KS_r2[this]=1
        set s__RimuruSpells___Rimuru3R_KS_r3[this]=1
        set s__RimuruSpells___Rimuru3R_KS_g[this]=CreateGroup()
        set s__RimuruSpells___Rimuru3R_KS_g2[this]=CreateGroup()
        call StartSpellUnit(s__RimuruSpells___Rimuru3R_KS_c[this])
