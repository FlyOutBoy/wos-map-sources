        function s__FrierenSpells__FrierenSpells_T2_BeginMerge takes integer this returns nothing
            local integer primary= this
            local integer secondary= s__FrierenSpells__FrierenSpells_T2_partner[this]
            local real mx= ( s__FrierenSpells__FrierenSpells_T2_x[this] + s__FrierenSpells__FrierenSpells_T2_x[s__FrierenSpells__FrierenSpells_T2_partner[this]] ) * 0.5
            local real my= ( s__FrierenSpells__FrierenSpells_T2_y[this] + s__FrierenSpells__FrierenSpells_T2_y[s__FrierenSpells__FrierenSpells_T2_partner[this]] ) * 0.5
            if s__FrierenSpells__FrierenSpells_T2_c[this] != s__FrierenSpells__FrierenSpells_T2_owner[this] then
                set primary=s__FrierenSpells__FrierenSpells_T2_partner[this]
                set secondary=this
            endif
