            if LoadInteger(hs, GetHandleId(GetOwningPlayer(s__AlucardSpells__AlucardSpells_E_c[this])), AlucardSpells__SH_MORPH_R) == 1 then
                set s__AlucardSpells__AlucardSpells_E_src[this]=DamageSourceVariant(AlucardE_ID , 1 , "RE")
            endif
            set s__AlucardSpells__AlucardSpells_E_x[this]=NewX
            set s__AlucardSpells__AlucardSpells_E_y[this]=NewY
            set s__AlucardSpells__AlucardSpells_E_r[this]=0
            set s__AlucardSpells__AlucardSpells_E_check[this]=0
            set s__AlucardSpells__AlucardSpells_E_k2[this]=0
            set s__AlucardSpells__AlucardSpells_E_k[this]=0
            set s__AlucardSpells__AlucardSpells_E_r5[this]=0
            set s__AlucardSpells__AlucardSpells_E_g[this]=CreateGroup()
            set s__AlucardSpells__AlucardSpells_E_g2[this]=CreateGroup()
            set s__AlucardSpells__AlucardSpells_E_aoe[this]=AlucardE_DamageAoe
            set s__AlucardSpells__AlucardSpells_E_a[this]=GAngle2(s__AlucardSpells__AlucardSpells_E_c[this] , s__AlucardSpells__AlucardSpells_E_x[this] , s__AlucardSpells__AlucardSpells_E_y[this]) // Angle Between points
            set s__AlucardSpells__AlucardSpells_E_x1[this]=GetUnitX(s__AlucardSpells__AlucardSpells_E_c[this]) + 400 * Cos(s__AlucardSpells__AlucardSpells_E_a[this])
            set s__AlucardSpells__AlucardSpells_E_y1[this]=GetUnitX(s__AlucardSpells__AlucardSpells_E_c[this]) + 400 * Sin(s__AlucardSpells__AlucardSpells_E_a[this])
            set s__AlucardSpells__AlucardSpells_E_dmg[this]=GetHeroAgi(s__AlucardSpells__AlucardSpells_E_c[this], true) * ( AlucardE_DamageAgiBase + ( AlucardE_DamageAgiStep * ( GetUnitAbilityLevel(s__AlucardSpells__AlucardSpells_E_c[this], AlucardE_ID) - 1 ) ) )
            set s__AlucardSpells__AlucardSpells_E_rmax[this]=2
            set s__AlucardSpells__AlucardSpells_E_r7[this]=AlucardE_RangeBase + ( AlucardE_RangeStep * ( GetUnitAbilityLevel(s__AlucardSpells__AlucardSpells_E_c[this], AlucardE_ID) - 1 ) )
            call SetUnitFacing(s__AlucardSpells__AlucardSpells_E_c[this], s__AlucardSpells__AlucardSpells_E_a[this] * bj_RADTODEG)
            set s__AlucardSpells__AlucardSpells_E_scale[this]=0.75
            if LoadInteger(hs, GetHandleId(GetOwningPlayer(s__AlucardSpells__AlucardSpells_E_c[this])), AlucardSpells__SH_MORPH_R) == 1 then
                set s__AlucardSpells__AlucardSpells_E_rmax[this]=1.65
                set s__AlucardSpells__AlucardSpells_E_move[this]=5
                call StartSpellUnit2(s__AlucardSpells__AlucardSpells_E_c[this])
                set s__AlucardSpells__AlucardSpells_E_k2[this]=0
                set s__AlucardSpells__AlucardSpells_E_scale[this]=1
                set s__AlucardSpells__AlucardSpells_E_dmg[this]=s__AlucardSpells__AlucardSpells_E_dmg[this] + AlucardRE_DamageAgiIncrease * GetHeroAgi(s__AlucardSpells__AlucardSpells_E_c[this], true)
                set s__AlucardSpells__AlucardSpells_E_scale2[this]=0.3
                set s__AlucardSpells__AlucardSpells_E_e[this]=EffectSpawn("war3mapImported\\wos_[By XeSHTeG]Dog Alucard.mdl" , GetUnitX(s__AlucardSpells__AlucardSpells_E_c[this]) + 100 * Cos(s__AlucardSpells__AlucardSpells_E_a[this]) , GetUnitY(s__AlucardSpells__AlucardSpells_E_c[this]) + 100 * Sin(s__AlucardSpells__AlucardSpells_E_a[this]) , s__AlucardSpells__AlucardSpells_E_a[this] * bj_RADTODEG , 1 , s__AlucardSpells__AlucardSpells_E_scale[this] , 105 * 1.45)
                call ColorEffDummy4(s__AlucardSpells__AlucardSpells_E_e[this] , 0 , 255 , 255 , 255 , 0.5)
                set s__AlucardSpells__AlucardSpells_E_r4[this]=999
                set s__AlucardSpells__AlucardSpells_E_check[this]=1
                set s__AlucardSpells__AlucardSpells_E_r7[this]=s__AlucardSpells__AlucardSpells_E_r7[this] - 350
                call SetUnitAnimationByIndex(s__AlucardSpells__AlucardSpells_E_c[this], 0)
                call SetUnitTimeScale(s__AlucardSpells__AlucardSpells_E_c[this], 1.45)
                call MakeSound("war3mapimported\\Hero_Alucard_RE")
                call MakeSound("war3mapimported\\Hero_Alucard_RE2")
            else
                set s__AlucardSpells__AlucardSpells_E_move[this]=100
                set s__AlucardSpells__AlucardSpells_E_r5[this]=150
                call SetUnitAnimationByIndex(s__AlucardSpells__AlucardSpells_E_c[this], 9)
                call SetUnitTimeScale(s__AlucardSpells__AlucardSpells_E_c[this], 1)
                call StartSpellUnit2(s__AlucardSpells__AlucardSpells_E_c[this])
                call MakeSound("war3mapimported\\Hero_Alucard_E")
                call MakeSound("war3mapimported\\Hero_Alucard_E2")
                set s__AlucardSpells__AlucardSpells_E_e[this]=EffectSpawn("war3mapImported\\wos_[By XeSHTeG]Alucard Dog.mdl" , GetUnitX(s__AlucardSpells__AlucardSpells_E_c[this]) + 150 * Cos(s__AlucardSpells__AlucardSpells_E_a[this]) , GetUnitY(s__AlucardSpells__AlucardSpells_E_c[this]) + 150 * Sin(s__AlucardSpells__AlucardSpells_E_a[this]) , s__AlucardSpells__AlucardSpells_E_a[this] * bj_RADTODEG , 2.5 , 2.375 , 0)
                call ColorEffDummy4(s__AlucardSpells__AlucardSpells_E_e[this] , 0 , 255 , 255 , 255 , 0.6)
                set s__AlucardSpells__AlucardSpells_E_e2[this]=null // Gear_auralanceblack023123.mdl is not imported
            endif
            if s__AlucardSpells__AlucardSpells_E_MUI_AlucardE == 0 then
                call AlucardSpells__AlucardTick_On(2)
            endif
        endfunction



        function s__AlucardSpells__AlucardSpells_R_Loop_AlucardR takes nothing returns nothing
            local integer this
            local real tmp_y= 0
            local integer i= 0
            loop
                exitwhen i > s__AlucardSpells__AlucardSpells_R_MUI_AlucardR
                set this=s__AlucardSpells__AlucardSpells_R_m_AlucardR[i]
                if SpellBoolCaster(s__AlucardSpells__AlucardSpells_R_c[this]) and s__AlucardSpells__AlucardSpells_R_r[this] <= s__AlucardSpells__AlucardSpells_R_rmax[this] and CheckCoordsInRect(gg_rct_Base , GetUnitX(s__AlucardSpells__AlucardSpells_R_c[this]) , GetUnitY(s__AlucardSpells__AlucardSpells_R_c[this])) == false then
                    if s__AlucardSpells__AlucardSpells_R_check[this] == 0 or ( s__AlucardSpells__AlucardSpells_R_check[this] == 1 and IsUnitPaused(s__AlucardSpells__AlucardSpells_R_c[this]) == false and GetUnitAbilityLevel(s__AlucardSpells__AlucardSpells_R_c[this], 'Avul') == 0 ) then
                        set s__AlucardSpells__AlucardSpells_R_r[this]=s__AlucardSpells__AlucardSpells_R_r[this] + 0.05
                    endif
                    set s__AlucardSpells__AlucardSpells_R_r[this]=RoundReal(s__AlucardSpells__AlucardSpells_R_r[this] , 3)
                    if s__AlucardSpells__AlucardSpells_R_check[this] == 0 then
                        if s__AlucardSpells__AlucardSpells_R_r[this] < 1.05 then
                            call SetUnitState(s__AlucardSpells__AlucardSpells_R_c[this], UNIT_STATE_LIFE, GetUnitState(s__AlucardSpells__AlucardSpells_R_c[this], UNIT_STATE_LIFE) - s__AlucardSpells__AlucardSpells_R_r5[this])
                        endif
