                    call s__RimuruSpells___RimuruG_KS_deallocate(this)
                set i=i - 1
                endif
                set i=i + 1
            endloop
        endfunction
        function s__RimuruSpells___RimuruG_KS_RimuruG_Start takes unit NewC,real NewHp,real NewRmax returns nothing
            local integer this
            if s__RimuruSpells___RimuruG_KS_CountActive(NewC) >= RimuruG_MaxActiveOrbs then
                set this=s__RimuruSpells___RimuruG_KS_FindActive(NewC)
                if this != 0 then
                    set s__RimuruSpells___RimuruG_KS_dmg[this]=s__RimuruSpells___RimuruG_KS_dmg[this] + NewHp
                    // После последнего попадания накопление живёт ещё полный срок.
                    if s__RimuruSpells___RimuruG_KS_rmax[this] < s__RimuruSpells___RimuruG_KS_r[this] + NewRmax then
                        set s__RimuruSpells___RimuruG_KS_rmax[this]=s__RimuruSpells___RimuruG_KS_r[this] + NewRmax
                    endif
                    return
                endif
                // Самовосстановление счётчика, если внешняя система удалила эффект/instance.
                call SaveInteger(hs, GetHandleId(NewC), RimuruSpells___SH_RIMURU_G_ORB_COUNT, 0)
            endif
            set this=s__RimuruSpells___RimuruG_KS__allocate()
            set s__RimuruSpells___RimuruG_KS_MUI_RimuruG=s__RimuruSpells___RimuruG_KS_MUI_RimuruG + 1
            set s__RimuruSpells___RimuruG_KS_m_RimuruG[s__RimuruSpells___RimuruG_KS_MUI_RimuruG]=this
            set s__RimuruSpells___RimuruG_KS_c[this]=NewC
            call SaveInteger(hs, GetHandleId(s__RimuruSpells___RimuruG_KS_c[this]), RimuruSpells___SH_RIMURU_G_ORB_COUNT, s__RimuruSpells___RimuruG_KS_CountActive(s__RimuruSpells___RimuruG_KS_c[this]) + 1)
            set s__RimuruSpells___RimuruG_KS_r[this]=0
            set s__RimuruSpells___RimuruG_KS_dmg[this]=NewHp
            set s__RimuruSpells___RimuruG_KS_rmax[this]=NewRmax
            set s__RimuruSpells___RimuruG_KS_check2[this]=R2I(GetRandomReal(0.51, 0.9) / 0.03 + 0.5)
            set s__RimuruSpells___RimuruG_KS_r3[this]=s__RimuruSpells___RimuruG_KS_check2[this] * 0.03
            set s__RimuruSpells___RimuruG_KS_r4[this]=0
            set s__RimuruSpells___RimuruG_KS_a[this]=GetRandomReal(0, 359) * bj_DEGTORAD
            set s__RimuruSpells___RimuruG_KS_sr[this]=GetRandomReal(RimuruG_OrbMinRange, RimuruG_OrbMaxRange)
            set s__RimuruSpells___RimuruG_KS_r5[this]=GetRandomReal(RimuruG_OrbMinHeight, RimuruG_OrbMaxHeight)
            set s__RimuruSpells___RimuruG_KS_check[this]=0
            set s__RimuruSpells___RimuruG_KS_move[this]=s__RimuruSpells___RimuruG_KS_sr[this] / s__RimuruSpells___RimuruG_KS_check2[this]
            set s__RimuruSpells___RimuruG_KS_x[this]=GetUnitX(s__RimuruSpells___RimuruG_KS_c[this])
            set s__RimuruSpells___RimuruG_KS_y[this]=GetUnitY(s__RimuruSpells___RimuruG_KS_c[this])
            set s__RimuruSpells___RimuruG_KS_e[this]=EffectSpawnColor("war3mapImported\\wos_[skillm]orbwaterx2.mdl" , s__RimuruSpells___RimuruG_KS_x[this] , s__RimuruSpells___RimuruG_KS_y[this] , GetRandomReal(0, 359) , 2.5 , 1.75 , 10 , 255 , 255 , 255 , 100)
            if s__RimuruSpells___RimuruG_KS_MUI_RimuruG == 0 then
                call RimuruSpells___RimuruTimer03Acquire()
            endif
        endfunction

    // Invulnerability: this spell contains a StartSpellUnit/Avul phase.
        function s__RimuruSpells___Rimuru2Q_KS_Loop_Rimuru2Q takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__RimuruSpells___Rimuru2Q_KS_MUI_Rimuru2Q
                set this=s__RimuruSpells___Rimuru2Q_KS_m_Rimuru2Q[i]
