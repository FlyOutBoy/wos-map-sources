        function s__FrierenSpells__FrierenRSearch_Loop takes nothing returns nothing
            local integer this
            local integer i= 0
            local unit u
            local unit illusion
            local boolean finished
            loop
                exitwhen i > s__FrierenSpells__FrierenRSearch_count
                set this=s__FrierenSpells__FrierenRSearch_instances[i]
                set s__FrierenSpells__FrierenRSearch_r[this]=I2R(R2I(( s__FrierenSpells__FrierenRSearch_r[this] + 0.03 ) * 1000.0 + 0.5)) / 1000.0
                set illusion=null
                set finished=s__FrierenSpells__FrierenRSearch_generation[this] != LoadInteger(hs, GetHandleId(s__FrierenSpells__FrierenRSearch_c[this]), FrierenSpells__SH_FRIEREN_R_SEARCH_GENERATION)

                // Ищем возле текущей позиции героя: новая иллюзия появляется рядом с ним,
                // а x/y являются точкой, куда найденный клон будет перенесён.
                if not finished then
                    call GroupClear(s__FrierenSpells__FrierenRSearch_g[this])
                    call GroupEnumUnitsInRange(s__FrierenSpells__FrierenRSearch_g[this], GetUnitX(s__FrierenSpells__FrierenRSearch_c[this]), GetUnitY(s__FrierenSpells__FrierenRSearch_c[this]), 800.00, null)
                    loop
                        set u=FirstOfGroup(s__FrierenSpells__FrierenRSearch_g[this])
                        exitwhen u == null
                        call GroupRemoveUnit(s__FrierenSpells__FrierenRSearch_g[this], u)
                        if GetOwningPlayer(u) == GetOwningPlayer(s__FrierenSpells__FrierenRSearch_c[this]) and IsUnitIllusion(u) and GetUnitTypeId(u) == GetUnitTypeId(s__FrierenSpells__FrierenRSearch_c[this]) and not IsUnitInGroup(u, s__FrierenSpells__FrierenRSearch_existing[this]) then
                            set illusion=u
                            exitwhen true
                        endif
                    endloop
                endif

                if illusion != null then
                    call SaveUnitHandle(hs, GetHandleId(s__FrierenSpells__FrierenRSearch_c[this]), FrierenSpells__SH_FRIEREN_R_ILLUSION, illusion)
                    call SetUnitUserData(illusion, 25)
                    // Illusions do not copy the script movement speed (base speed and A01C
                    // "Hero MS Base" levels from items) - match Frieren so the clone keeps up.
                    call SetUnitMoveSpeed(illusion, GetUnitMoveSpeed(s__FrierenSpells__FrierenRSearch_c[this]))
                    if GetUnitAbilityLevel(illusion, 'A01C') == 0 then
                        call UnitAddAbility(illusion, 'A01C')
                    endif
                    call SetUnitAbilityLevel(illusion, 'A01C', GetUnitAbilityLevel(s__FrierenSpells__FrierenRSearch_c[this], 'A01C'))
                    call SaveInteger(hs, GetHandleId(illusion), FrierenSpells__SH_FRIEREN_R_OWNER, GetHandleId(s__FrierenSpells__FrierenRSearch_c[this]))
                    call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\wos_ade (blue).mdx", illusion, "origin"))
                    call BlinkEff(illusion)
                    call PosUnit(illusion , s__FrierenSpells__FrierenRSearch_x[this] , s__FrierenSpells__FrierenRSearch_y[this])
                    call BlinkEff(illusion)
                    call WUI_HeroDuration(s__FrierenSpells__FrierenRSearch_c[this] , FrierenR_ID , "Summon Golem" , s__FrierenSpells__FrierenRSearch_cloneDuration[this] , 0 , "" , illusion)
                    set finished=true
                elseif s__FrierenSpells__FrierenRSearch_r[this] >= FrierenR_CloneSearchDuration then
                    set finished=true
                endif

                if finished then
                    call DestroyGroup(s__FrierenSpells__FrierenRSearch_g[this])
                    call DestroyGroup(s__FrierenSpells__FrierenRSearch_existing[this])
                    set s__FrierenSpells__FrierenRSearch_g[this]=null
                    set s__FrierenSpells__FrierenRSearch_existing[this]=null
                    set s__FrierenSpells__FrierenRSearch_c[this]=null
                    set s__FrierenSpells__FrierenRSearch_instances[i]=s__FrierenSpells__FrierenRSearch_instances[s__FrierenSpells__FrierenRSearch_count]
                    set s__FrierenSpells__FrierenRSearch_instances[s__FrierenSpells__FrierenRSearch_count]=0
                    set s__FrierenSpells__FrierenRSearch_count=s__FrierenSpells__FrierenRSearch_count - 1
                    if s__FrierenSpells__FrierenRSearch_count == - 1 then
                        call FrierenSpells__FrierenTimer03Release()
                    endif
                    call s__FrierenSpells__FrierenRSearch_deallocate(this)
                    set i=i - 1
                endif
                set i=i + 1
            endloop
            set u=null
            set illusion=null
        endfunction

        function s__FrierenSpells__FrierenRSearch_Start takes unit caster,real targetX,real targetY returns nothing
            local integer this= s__FrierenSpells__FrierenRSearch__allocate()
            local unit d
            local unit u
            local group cleanup= CreateGroup()
            local integer nextGeneration= LoadInteger(hs, GetHandleId(caster), FrierenSpells__SH_FRIEREN_R_SEARCH_GENERATION) + 1

            // Новый каст отменяет незавершённый поиск предыдущего каста этого героя.
            call SaveInteger(hs, GetHandleId(caster), FrierenSpells__SH_FRIEREN_R_SEARCH_GENERATION, nextGeneration)

            // Удаляем все старые иллюзии Фрирен этого игрока, включая те,
            // которые прежний короткий поиск не успел сохранить или пометить.
            call GroupEnumUnitsInRect(cleanup, bj_mapInitialPlayableArea, null)
            loop
                set u=FirstOfGroup(cleanup)
                exitwhen u == null
                call GroupRemoveUnit(cleanup, u)
                if GetOwningPlayer(u) == GetOwningPlayer(caster) and IsUnitIllusion(u) and GetUnitTypeId(u) == GetUnitTypeId(caster) and GetUnitUserData(u) == 25 then
                    call RemoveSavedInteger(hs, GetHandleId(u), FrierenSpells__SH_FRIEREN_R_OWNER)
                    call RemoveUnit(u)
                endif
            endloop
            call RemoveSavedHandle(hs, GetHandleId(caster), FrierenSpells__SH_FRIEREN_R_ILLUSION)

            // Запоминаем все юниты, существовавшие до создания клона R.
            // Поэтому иллюзия от предмета не сможет стать результатом этого поиска.
            set s__FrierenSpells__FrierenRSearch_existing[this]=CreateGroup()
            call GroupEnumUnitsInRect(s__FrierenSpells__FrierenRSearch_existing[this], bj_mapInitialPlayableArea, null)
            call DestroyGroup(cleanup)

            set s__FrierenSpells__FrierenRSearch_count=s__FrierenSpells__FrierenRSearch_count + 1
            set s__FrierenSpells__FrierenRSearch_instances[s__FrierenSpells__FrierenRSearch_count]=this
            set s__FrierenSpells__FrierenRSearch_c[this]=caster
            set s__FrierenSpells__FrierenRSearch_r[this]=0
            set s__FrierenSpells__FrierenRSearch_x[this]=targetX
            set s__FrierenSpells__FrierenRSearch_y[this]=targetY
            set s__FrierenSpells__FrierenRSearch_generation[this]=nextGeneration
            set s__FrierenSpells__FrierenRSearch_g[this]=CreateGroup()

            set d=CreateUnit(GetOwningPlayer(s__FrierenSpells__FrierenRSearch_c[this]), 'h0C9', GetUnitX(s__FrierenSpells__FrierenRSearch_c[this]), GetUnitY(s__FrierenSpells__FrierenRSearch_c[this]), 0)
            call UnitAddAbility(d, FrierenR_SpellID)
            call SetUnitAbilityLevel(d, FrierenR_SpellID, GetUnitAbilityLevel(s__FrierenSpells__FrierenRSearch_c[this], FrierenR_ID))
            set s__FrierenSpells__FrierenRSearch_cloneDuration[this]=BlzGetAbilityRealLevelField(BlzGetUnitAbility(d, FrierenR_SpellID), ABILITY_RLF_DURATION_NORMAL, GetUnitAbilityLevel(d, FrierenR_SpellID) - 1)
            call IssueTargetOrderById(d, 852274, s__FrierenSpells__FrierenRSearch_c[this])
            call s__GearSystems2___KS_RemoveUnit_MyRemoveUnit_Start((d ) , (( 0.1)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
            call GearSoundPlay(("war3mapimported\\Hero_Frieren_R" ) + ".mp3" , 127 , true , ( GetOwningPlayer(s__FrierenSpells__FrierenRSearch_c[this]))) // INLINED!!
            call GearSoundPlay(("war3mapimported\\Hero_Frieren_R2" ) + ".mp3" , 127 , true , ( GetOwningPlayer(s__FrierenSpells__FrierenRSearch_c[this]))) // INLINED!!

            if s__FrierenSpells__FrierenRSearch_count == 0 then
                call FrierenSpells__FrierenTimer03Acquire()
            endif
            set d=null
            set u=null
            set cleanup=null
        endfunction

