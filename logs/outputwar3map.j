        function s__BrandishSpells__BrandishSpells_F_Loop_BrandishF takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__BrandishSpells__BrandishSpells_F_MUI_BrandishF
                set this=s__BrandishSpells__BrandishSpells_F_m_BrandishF[i]
                if GetUnitAbilityLevel(s__BrandishSpells__BrandishSpells_F_td[this], s__BrandishSpells__BrandishSpells_F_check2[this]) > 0 and SpellBoolCaster(s__BrandishSpells__BrandishSpells_F_c[this]) and s__BrandishSpells__BrandishSpells_F_r[this] < s__BrandishSpells__BrandishSpells_F_rmax[this] and not CheckCoordsInRect(gg_rct_Base , GetUnitX(s__BrandishSpells__BrandishSpells_F_c[this]) , GetUnitY(s__BrandishSpells__BrandishSpells_F_c[this])) then
                    if not IsUnitPaused(s__BrandishSpells__BrandishSpells_F_td[this]) then
                        set s__BrandishSpells__BrandishSpells_F_r[this]=I2R(R2I(( s__BrandishSpells__BrandishSpells_F_r[this] + 0.05 ) * 1000.0 + 0.5)) / 1000.0
                    endif
                else
                    set s__BrandishSpells__BrandishSpells_F_scale2[this]=s__BrandishSpells_Utility_GetTotalScale(s__BrandishSpells__BrandishSpells_F_td[this])
                    call SaveReal(BrandishSpells__hs, GetHandleId(s__BrandishSpells__BrandishSpells_F_td[this]), BrandishSpells__SH_FMULT, 1.0)
                    set s__BrandishSpells__BrandishSpells_F_scale[this]=s__BrandishSpells_Utility_GetTotalScale(s__BrandishSpells__BrandishSpells_F_td[this])
                    call ScaleDummy(s__BrandishSpells__BrandishSpells_F_td[this] , 0.50 , s__BrandishSpells__BrandishSpells_F_scale2[this] , s__BrandishSpells__BrandishSpells_F_scale[this])
                    if s__BrandishSpells__BrandishSpells_F_check[this] == 0 then
                        call SaveInteger(BrandishSpells__hs, GetHandleId(s__BrandishSpells__BrandishSpells_F_td[this]), BrandishSpells__SH_BRANDISH_G_ENEMY, 0)
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_brandi_red_increase.mdl" , GetUnitX(s__BrandishSpells__BrandishSpells_F_td[this]) , GetUnitY(s__BrandishSpells__BrandishSpells_F_td[this]) , 0.0 , 1.25 , 2.20 , 0.0))
                    else
                        call SaveInteger(BrandishSpells__hs, GetHandleId(s__BrandishSpells__BrandishSpells_F_td[this]), BrandishSpells__SH_BRANDISH_G_ALLY, 0)
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_brandi_green_decrease.mdl" , GetUnitX(s__BrandishSpells__BrandishSpells_F_td[this]) , GetUnitY(s__BrandishSpells__BrandishSpells_F_td[this]) , 0.0 , 1.25 , 2.00 , 0.0))
                    endif
                    call MakeSound("war3mapimported\\Hero_Brandish_G3")
                    set s__BrandishSpells__BrandishSpells_F_c[this]=null
                    set s__BrandishSpells__BrandishSpells_F_td[this]=null
                    set s__BrandishSpells__BrandishSpells_F_m_BrandishF[i]=s__BrandishSpells__BrandishSpells_F_m_BrandishF[s__BrandishSpells__BrandishSpells_F_MUI_BrandishF]
                    set s__BrandishSpells__BrandishSpells_F_MUI_BrandishF=s__BrandishSpells__BrandishSpells_F_MUI_BrandishF - 1
                    call s__BrandishSpells__BrandishSpells_F_deallocate(this)
                    set i=i - 1
                    if s__BrandishSpells__BrandishSpells_F_MUI_BrandishF == - 1 then
                        call BrandishSpells__BrandishTimer05Release()
                    endif
                endif
                set i=i + 1
            endloop
        endfunction

        function s__BrandishSpells__BrandishSpells_F_BrandishF_Start takes unit NewC,unit NewTd returns nothing
            local integer this= s__BrandishSpells__BrandishSpells_F__allocate()
