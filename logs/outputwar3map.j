    function StarrkSpells___StarrkTick05_On takes integer k returns nothing
        if not StarrkSpells___StarrkTick05_Active[k] then
            set StarrkSpells___StarrkTick05_Active[k]=true
            set StarrkSpells___StarrkTick05_Users=StarrkSpells___StarrkTick05_Users + 1
            if StarrkSpells___StarrkTick05_Users == 1 then
                call TimerStart(StarrkSpells___StarrkTick05_Timer, 0.05, true, StarrkSpells___StarrkTick05_Callback)
            endif
        endif
    endfunction

    function StarrkSpells___StarrkTick05_Off takes integer k returns nothing
        if StarrkSpells___StarrkTick05_Active[k] then
            set StarrkSpells___StarrkTick05_Active[k]=false
            set StarrkSpells___StarrkTick05_Users=StarrkSpells___StarrkTick05_Users - 1
            if StarrkSpells___StarrkTick05_Users <= 0 then
                set StarrkSpells___StarrkTick05_Users=0
                call PauseTimer(StarrkSpells___StarrkTick05_Timer)
            endif
        endif
    endfunction


    function StarrkSpells___StarrkTick_On takes integer k returns nothing
        if not StarrkSpells___StarrkTick_Active[k] then
            set StarrkSpells___StarrkTick_Active[k]=true
            set StarrkSpells___StarrkTick_Users=StarrkSpells___StarrkTick_Users + 1
            if StarrkSpells___StarrkTick_Users == 1 then
                call TimerStart(StarrkSpells___StarrkTick_Timer, 0.03, true, StarrkSpells___StarrkTick_Callback)
            endif
        endif
    endfunction

    function StarrkSpells___StarrkTick_Off takes integer k returns nothing
        if StarrkSpells___StarrkTick_Active[k] then
            set StarrkSpells___StarrkTick_Active[k]=false
            set StarrkSpells___StarrkTick_Users=StarrkSpells___StarrkTick_Users - 1
            if StarrkSpells___StarrkTick_Users <= 0 then
                set StarrkSpells___StarrkTick_Users=0
                call PauseTimer(StarrkSpells___StarrkTick_Timer)
            endif
        endif
    endfunction


    function StarrkSpells___StarrkWolfDropTrail takes unit wolf returns nothing
        local integer h= GetHandleId(wolf)
        local effect e= LoadEffectHandle(hs, h, StarrkSpells___SH_STARRK_WOLF_TRAIL)
        if e != null then
            call DestroyEffect(e)
            call RemoveSavedHandle(hs, h, StarrkSpells___SH_STARRK_WOLF_TRAIL)
        endif
        set e=null
    endfunction

    function StarrkSpells___StarrkWolfOnDeath takes nothing returns boolean
        if GetUnitTypeId(GetTriggerUnit()) == StarrkWolf_ID then
            call StarrkSpells___StarrkWolfDropTrail(GetTriggerUnit())
        endif
        return false
    endfunction

    function StarrkSpells___StarrkWolfTrail takes unit wolf returns nothing
        if StarrkSpells___StarrkWolfDeathTrigger == null then
            set StarrkSpells___StarrkWolfDeathTrigger=CreateTrigger()
            call TriggerRegisterAnyUnitEventBJ(StarrkSpells___StarrkWolfDeathTrigger, EVENT_PLAYER_UNIT_DEATH)
            call TriggerAddCondition(StarrkSpells___StarrkWolfDeathTrigger, Condition(function StarrkSpells___StarrkWolfOnDeath))
        endif
        call StarrkSpells___StarrkWolfDropTrail(wolf)
        call SaveEffectHandle(hs, GetHandleId(wolf), StarrkSpells___SH_STARRK_WOLF_TRAIL, AddSpecialEffectTarget("war3mapimported\\wos_by_wood_k_huoyantuowei3.mdx", wolf, "chest"))
    endfunction

    // Fade out and remove a wolf together with its trail.
    function StarrkSpells___StarrkWolfFade takes unit wolf,real time returns nothing
        call StarrkSpells___StarrkWolfDropTrail(wolf)
        call ColorDummy3(wolf , 0 , 255 , 255 , 255 , time)
    endfunction


