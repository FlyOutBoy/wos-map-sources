// ==================== Altair TEST arena ====================
// One of every copyable decor for Factor Mimic, light decor in the Fate Reconstruction
// realm and "-train", which drives a round-end train (random skin) across the arena.
// Scales repeat the object-data averages (CreateDestructable ignores them).
function AltairTest_Decor takes integer id,real x,real y,real scale returns nothing
    call CreateDestructable(id, x, y, GetRandomReal(0.0, 359.0), scale, 0)
endfunction

function AltairTest_CreateArena takes nothing returns nothing
    local real minX= GetRectMinX(gg_rct_AltairRealm)
    local real minY= GetRectMinY(gg_rct_AltairRealm)
    local real maxX= GetRectMaxX(gg_rct_AltairRealm)
    local real maxY= GetRectMaxY(gg_rct_AltairRealm)
    local real position= 0.0
    // Light objects (y -800).
    call AltairTest_Decor('B001' , - 2600.0 , - 800.0 , 3.2)
    call AltairTest_Decor('B002' , - 2370.0 , - 800.0 , 3.2)
    call AltairTest_Decor('B003' , - 2140.0 , - 800.0 , 1.25)
    call AltairTest_Decor('B004' , - 1910.0 , - 800.0 , 1.25)
    call AltairTest_Decor('B006' , - 1680.0 , - 800.0 , 2.0)
    call AltairTest_Decor('B008' , - 1450.0 , - 800.0 , 0.8)
    call AltairTest_Decor('B00G' , - 1220.0 , - 800.0 , 3.2)
    call AltairTest_Decor('B00H' , - 990.0 , - 800.0 , 3.2)
    call AltairTest_Decor('B00O' , - 760.0 , - 800.0 , 2.0)
    call AltairTest_Decor('B00P' , - 530.0 , - 800.0 , 2.0)
    call AltairTest_Decor('B00S' , - 300.0 , - 800.0 , 1.0)
    call AltairTest_Decor('B00T' , - 70.0 , - 800.0 , 1.5)
    call AltairTest_Decor('B00U' , 160.0 , - 800.0 , 0.5)
    call AltairTest_Decor('B00V' , 390.0 , - 800.0 , 0.8)
    call AltairTest_Decor('B00X' , 620.0 , - 800.0 , 1.25)
    call AltairTest_Decor('B00Y' , 850.0 , - 800.0 , 1.25)
    call AltairTest_Decor('B00Z' , 1080.0 , - 800.0 , 1.0)
    call AltairTest_Decor('B010' , 1310.0 , - 800.0 , 0.95)
    call AltairTest_Decor('B011' , 1540.0 , - 800.0 , 1.25)
    call AltairTest_Decor('B012' , 1770.0 , - 800.0 , 1.1)
    call AltairTest_Decor('B013' , 2000.0 , - 800.0 , 1.5)
    call AltairTest_Decor('B019' , 2230.0 , - 800.0 , 0.55)
    call AltairTest_Decor('B01A' , 2460.0 , - 800.0 , 0.55)
    // Medium objects (y -1350).
    call AltairTest_Decor('B000' , - 2400.0 , - 1350.0 , 3.0)
    call AltairTest_Decor('B007' , - 1800.0 , - 1350.0 , 3.0)
    call AltairTest_Decor('B009' , - 1200.0 , - 1350.0 , 3.0)
    call AltairTest_Decor('B00F' , - 600.0 , - 1350.0 , 3.0)
    call AltairTest_Decor('B00A' , 0.0 , - 1350.0 , 0.85)
    call AltairTest_Decor('B00I' , 600.0 , - 1350.0 , 3.0)
    call AltairTest_Decor('B00Q' , 1200.0 , - 1350.0 , 2.4)
    call AltairTest_Decor('B00R' , 1800.0 , - 1350.0 , 0.75)
    call AltairTest_Decor('B00W' , 2400.0 , - 1350.0 , 2.0)
    // Heavy objects (y -2000 and -2900), east of the realm.
    call AltairTest_Decor('B005' , - 1400.0 , - 2000.0 , 1.25)
    call AltairTest_Decor('B00B' , - 700.0 , - 2000.0 , 1.25)
    call AltairTest_Decor('B00C' , 0.0 , - 2000.0 , 1.25)
    call AltairTest_Decor('B00D' , 700.0 , - 2000.0 , 1.5)
    call AltairTest_Decor('B00E' , 1400.0 , - 2000.0 , 1.5)
    call AltairTest_Decor('B014' , 2100.0 , - 2000.0 , 1.5)
    call AltairTest_Decor('B015' , 2800.0 , - 2000.0 , 1.0)
    call AltairTest_Decor('B00J' , - 1400.0 , - 2900.0 , 5.0)
    call AltairTest_Decor('B00K' , - 600.0 , - 2900.0 , 5.0)
    call AltairTest_Decor('B00L' , 200.0 , - 2900.0 , 4.5)
    call AltairTest_Decor('B00M' , 1000.0 , - 2900.0 , 9.0)
    call AltairTest_Decor('B00N' , 1800.0 , - 2900.0 , 4.5)
    call AltairTest_Decor('B01B' , 2600.0 , - 2900.0 , 4.5)
    // Realm: trees along the border, flowers inside.
    loop
        exitwhen position > maxX - minX
        call AltairTest_Decor('B007' , minX + position , minY , 3.0)
        call AltairTest_Decor('B009' , minX + position , maxY , 3.0)
        set position=position + 224.0
    endloop
    set position=224.0
    loop
        exitwhen position >= maxY - minY
        call AltairTest_Decor('B000' , minX , minY + position , 3.0)
        call AltairTest_Decor('B00F' , maxX , minY + position , 3.0)
        set position=position + 224.0
    endloop
    call AltairTest_Decor('B011' , minX + 300.0 , minY + 300.0 , 1.25)
    call AltairTest_Decor('B012' , maxX - 300.0 , minY + 300.0 , 1.1)
    call AltairTest_Decor('B011' , minX + 300.0 , maxY - 300.0 , 1.25)
    call AltairTest_Decor('B012' , maxX - 300.0 , maxY - 300.0 , 1.1)
endfunction

// Slot 0: Metro (its model faces backwards, as in RoundEnd), slot 1: Thomas.
function AltairTest_ParkTrain takes integer slot returns nothing
    local real x= - 2000.0 + 1400.0 * slot
    local real y= 1100.0
    if slot == 0 then
        set AltairTestParked[slot]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'h00G', x, y, 180.0)
    else
        set AltairTestParked[slot]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'h02N', x, y, 0.0)
    endif
    set AltairTestParkedBlocker[slot]=CreateDestructable('B017', x, y, 0.0, 0.01, 0)
    set AltairTestParkedRespawn[slot]=0.0
endfunction

function AltairTest_ParkedLoop takes nothing returns nothing
    local integer slot= 0
    loop
        exitwhen slot > 1
        if AltairTestParked[slot] != null and GetDestructableLife(AltairTestParkedBlocker[slot]) <= 0.405 then
            // Copied by Factor Mimic: the original derails like the round-end train.
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_by_wood_effect_yuzhiboyou_unusual_fenshendabaopo_2.mdl" , GetUnitX(AltairTestParked[slot]) , GetUnitY(AltairTestParked[slot]) , GetRandomReal(0.0, 359.0) , 1.0 , 2.0 , 1.0))
            call RemoveUnit(AltairTestParked[slot])
            call RemoveDestructable(AltairTestParkedBlocker[slot])
            set AltairTestParked[slot]=null
            set AltairTestParkedBlocker[slot]=null
            set AltairTestParkedRespawn[slot]=5.0
        elseif AltairTestParked[slot] == null then
            set AltairTestParkedRespawn[slot]=AltairTestParkedRespawn[slot] - 0.25
            if AltairTestParkedRespawn[slot] <= 0.0 then
                call AltairTest_ParkTrain(slot)
            endif
        endif
        set slot=slot + 1
    endloop
endfunction

function AltairTest_TrainStop takes nothing returns nothing
    call PauseTimer(AltairTestTrainTimer)
    call RemoveUnit(AltairTestTrain)
    call RemoveDestructable(AltairTestTrainBlocker)
    set AltairTestTrain=null
    set AltairTestTrainBlocker=null
endfunction

// Same contract as RoundEnd: the invisible B017 follows the train; destroying it derails the train.
function AltairTest_TrainLoop takes nothing returns nothing
    local real x
    local real y
    if AltairTestTrain == null then
        call PauseTimer(AltairTestTrainTimer)
        return
    endif
    set x=GetUnitX(AltairTestTrain)
    set y=GetUnitY(AltairTestTrain)
    if GetDestructableLife(AltairTestTrainBlocker) <= 0.405 then
        call DestroyEffect(EffectSpawn("war3mapImported\\wos_by_wood_effect_yuzhiboyou_unusual_fenshendabaopo_2.mdl" , x , y , GetRandomReal(0.0, 359.0) , 1.0 , 2.0 , 1.0))
        call AltairTest_TrainStop()
        return
    endif
    set AltairTestTrainSpeed=RMinBJ(45.0, AltairTestTrainSpeed + 0.5)
    set x=x + AltairTestTrainSpeed
    if x > 3100.0 then
        call AltairTest_TrainStop()
        return
    endif
    call SetUnitX(AltairTestTrain, x)
    call RemoveDestructable(AltairTestTrainBlocker)
    set AltairTestTrainBlocker=CreateDestructable('B017', x, y, 0.0, 0.01, 0)
endfunction

function AltairTest_TrainCommand takes nothing returns nothing
    if AltairTestTrain != null then
        return
    endif
    // The Metro model faces backwards (RoundEnd adds 180 degrees); Thomas does not.
    if GetRandomInt(1, 2) == 1 then
        set AltairTestTrain=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'h00G', - 3000.0, 700.0, 180.0)
        call DisplayTextToPlayer(Player(0), 0.0, 0.0, "Test train: Metro")
    else
        set AltairTestTrain=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'h02N', - 3000.0, 700.0, 0.0)
        call DisplayTextToPlayer(Player(0), 0.0, 0.0, "Test train: Thomas")
    endif
    call SetUnitTimeScale(AltairTestTrain, 2.0)
    set AltairTestTrainSpeed=1.0
    set AltairTestTrainBlocker=CreateDestructable('B017', - 3000.0, 700.0, 0.0, 0.01, 0)
    call TimerStart(AltairTestTrainTimer, 0.03, true, function AltairTest_TrainLoop)
endfunction
