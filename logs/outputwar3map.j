                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_ljq_jn_lsfgxs02.mdl" , s__LaxusSpells___LaxusE_KS_x[this] , s__LaxusSpells___LaxusE_KS_y[this] , GetRandomReal(0.0, 359.0) , 4.0 , 0.65 , 1.0))
                        else
