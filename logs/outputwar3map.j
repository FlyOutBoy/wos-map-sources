                    set s__FrierenSpells__FrierenSpells_T2_r[this]=I2R(R2I(( s__FrierenSpells__FrierenSpells_T2_r[this] + 0.03 ) * 1000.0 + 0.5)) / 1000.0
                    if s__FrierenSpells__FrierenSpells_T2_r[this] >= FrierenT2_CastTime then
                        set s__FrierenSpells__FrierenSpells_T2_r2[this]=I2R(R2I(( s__FrierenSpells__FrierenSpells_T2_r2[this] + 0.03 ) * 1000.0 + 0.5)) / 1000.0
                        set s__FrierenSpells__FrierenSpells_T2_r3[this]=I2R(R2I(( s__FrierenSpells__FrierenSpells_T2_r3[this] + 0.03 ) * 1000.0 + 0.5)) / 1000.0
