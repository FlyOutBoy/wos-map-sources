        function s__PatriotSpells___PatriotSpells_R_PatriotR_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__PatriotSpells___PatriotSpells_R__allocate()
            local real xxx
            local real yyy
            local real maxRange
            local integer level= GetUnitAbilityLevel(NewC, PatriotR_ID)
            if level < 1 then
                set level=1
            endif

            set s__PatriotSpells___PatriotSpells_R_MUI_PatriotR=s__PatriotSpells___PatriotSpells_R_MUI_PatriotR + 1
            set s__PatriotSpells___PatriotSpells_R_m_PatriotR[s__PatriotSpells___PatriotSpells_R_MUI_PatriotR]=this
            set s__PatriotSpells___PatriotSpells_R_c[this]=NewC
            set s__PatriotSpells___PatriotSpells_R_r[this]=0.0
            set s__PatriotSpells___PatriotSpells_R_r2[this]=10.0
            set s__PatriotSpells___PatriotSpells_R_r3[this]=10.0
            set s__PatriotSpells___PatriotSpells_R_check[this]=0
            call SaveInteger(hs, GetHandleId(s__PatriotSpells___PatriotSpells_R_c[this]), PatriotSpells___SH_R_ACT, 0)
            set s__PatriotSpells___PatriotSpells_R_r5[this]=0.0
            set maxRange=PatriotR_RangeBase + ( PatriotR_RangeStep * ( level - 1 ) )
            set s__PatriotSpells___PatriotSpells_R_r7[this]=maxRange
            set s__PatriotSpells___PatriotSpells_R_move[this]=40.0
            set s__PatriotSpells___PatriotSpells_R_aoe[this]=PatriotR_DamageAoe
            set s__PatriotSpells___PatriotSpells_R_g[this]=CreateGroup()
            set s__PatriotSpells___PatriotSpells_R_g2[this]=CreateGroup()
            set s__PatriotSpells___PatriotSpells_R_dmg[this]=GetHeroAgi(s__PatriotSpells___PatriotSpells_R_c[this], true) * ( PatriotR_DamageAgiBase + ( PatriotR_DamageAgiStep * ( level - 1 ) ) )
            set s__PatriotSpells___PatriotSpells_R_dmg2[this]=GetHeroAgi(s__PatriotSpells___PatriotSpells_R_c[this], true) * ( PatriotR2_DamageAgiBase + ( PatriotR2_DamageAgiStep * ( level - 1 ) ) )
            set s__PatriotSpells___PatriotSpells_R_rmax[this]=3.0

            if LoadInteger(hs, GetHandleId(s__PatriotSpells___PatriotSpells_R_c[this]), PatriotSpells___SH_PATRIOT_E) == 1 then
                // Стойка Сокрушения: спавн СТРОГО в точке клика курсора
                set xxx=NewX
                set yyy=NewY
                // Направление марша: от точки клика прямо навстречу Патриоту
                set s__PatriotSpells___PatriotSpells_R_a[this]=GAngle4(NewX , NewY , GetUnitX(s__PatriotSpells___PatriotSpells_R_c[this]) , GetUnitY(s__PatriotSpells___PatriotSpells_R_c[this]))
            else
                // Маршевая стойка: спавн перед Патриотом и марш вперед от него
                set s__PatriotSpells___PatriotSpells_R_a[this]=GAngle2(s__PatriotSpells___PatriotSpells_R_c[this] , NewX , NewY)
                set xxx=GetUnitX(s__PatriotSpells___PatriotSpells_R_c[this]) + 100.0 * Cos(s__PatriotSpells___PatriotSpells_R_a[this])
                set yyy=GetUnitY(s__PatriotSpells___PatriotSpells_R_c[this]) + 100.0 * Sin(s__PatriotSpells___PatriotSpells_R_a[this])
            endif

            set s__PatriotSpells___PatriotSpells_R_k[this]=0
            loop
                exitwhen s__PatriotSpells___PatriotSpells_R_k[this] == 3
                set s__PatriotSpells___PatriotSpells_R_x1[this]=xxx + ( - 125.0 + 125.0 * s__PatriotSpells___PatriotSpells_R_k[this] ) * Cos(s__PatriotSpells___PatriotSpells_R_a[this] - 90.0 * bj_DEGTORAD)
                set s__PatriotSpells___PatriotSpells_R_y1[this]=yyy + ( - 125.0 + 125.0 * s__PatriotSpells___PatriotSpells_R_k[this] ) * Sin(s__PatriotSpells___PatriotSpells_R_a[this] - 90.0 * bj_DEGTORAD)
                set s___PatriotSpells___PatriotSpells_R_ee[s__PatriotSpells___PatriotSpells_R_ee[this]+s__PatriotSpells___PatriotSpells_R_k[this]]=EffectSpawn("war3mapimported\\wos_PatriotSoldier01.mdx" , s__PatriotSpells___PatriotSpells_R_x1[this] , s__PatriotSpells___PatriotSpells_R_y1[this] , s__PatriotSpells___PatriotSpells_R_a[this] * bj_RADTODEG , 0.5 , 1.0 , 0.0)
                call ColorEffDummy4(s___PatriotSpells___PatriotSpells_R_ee[s__PatriotSpells___PatriotSpells_R_ee[this]+s__PatriotSpells___PatriotSpells_R_k[this]] , 0.0 , 255 , 255 , 255 , 0.30)
                call BlzPlaySpecialEffect(s___PatriotSpells___PatriotSpells_R_ee[s__PatriotSpells___PatriotSpells_R_ee[this]+s__PatriotSpells___PatriotSpells_R_k[this]], ANIM_TYPE_ATTACK)
                call s__GearSystems2___KS_RemoveEffect_MyRemoveEff_Start((s___PatriotSpells___PatriotSpells_R_ee[s__PatriotSpells___PatriotSpells_R_ee[this]+s__PatriotSpells___PatriotSpells_R_k[this]] ) , (( 0.60 )*1.0) , 1 , (( 0)*1.0) , - 1 , "") // INLINED!!
                set s___PatriotSpells___PatriotSpells_R_ee[s__PatriotSpells___PatriotSpells_R_ee[this]+s__PatriotSpells___PatriotSpells_R_k[this] + 4]=EffectSpawn("war3mapimported\\wos_Windwalk Black.mdx" , s__PatriotSpells___PatriotSpells_R_x1[this] , s__PatriotSpells___PatriotSpells_R_y1[this] , s__PatriotSpells___PatriotSpells_R_a[this] * bj_RADTODEG , 1.0 , 1.0 , 0.0)
                set s__PatriotSpells___PatriotSpells_R_k[this]=s__PatriotSpells___PatriotSpells_R_k[this] + 1
            endloop
            set s__PatriotSpells___PatriotSpells_R_x1[this]=xxx
            set s__PatriotSpells___PatriotSpells_R_y1[this]=yyy

            call MakeSound("war3mapImported\\Hero_Patriot_R2")
            if GetRandomInt(1, 2) == 1 then
                call MakeSound("war3mapImported\\Hero_Patriot_R")
            else
                call MakeSound("war3mapImported\\Hero_Patriot_R3")
            endif

            if s__PatriotSpells___PatriotSpells_R_MUI_PatriotR == 0 then
                call PatriotSpells___PatriotTimer03Acquire()
            endif
        endfunction

        // Duration meter (WOSHeroMeter window above the minimap, like Toji R), one per player.


        function s__PatriotSpells___PatriotSpells_T_Loop_PatriotT takes nothing returns nothing
            local integer i= 0
