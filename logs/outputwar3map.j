        function s__StarrkSpells___StarrkSpells_R_Loop_StarrkR takes nothing returns nothing
            local integer this
            local integer i= 0
            local real targetA= 0
            local real diff= 0
            local real ra1= GetRandomReal(0, 365)
            local real dk= GetRandomReal(0.4, 0.85)
            loop
                exitwhen i > s__StarrkSpells___StarrkSpells_R_MUI_StarrkR
                set this=s__StarrkSpells___StarrkSpells_R_m_StarrkR[i]
                if SpellBoolCaster(s__StarrkSpells___StarrkSpells_R_c[this]) and s__StarrkSpells___StarrkSpells_R_r[this] < s__StarrkSpells___StarrkSpells_R_rmax[this] and LoadInteger(hs, GetHandleId(s__StarrkSpells___StarrkSpells_R_c[this]), StarrkSpells___SH_STOP_R) == 0 then
                    set s__StarrkSpells___StarrkSpells_R_r[this]=I2R(R2I(( s__StarrkSpells___StarrkSpells_R_r[this] + 0.03 ) * 1000.0 + 0.5)) / 1000.0
                    set s__StarrkSpells___StarrkSpells_R_r[this]=RoundReal(s__StarrkSpells___StarrkSpells_R_r[this] , 3)
                    if s__StarrkSpells___StarrkSpells_R_r[this] < 1.26 then
                     //   call DebugUnit(c)
                    else
                        call DebugUnit2(s__StarrkSpells___StarrkSpells_R_c[this])
                    endif
                    if s__StarrkSpells___StarrkSpells_R_r[this] == 0.39 then
                        call SetUnitTimeScale(s__StarrkSpells___StarrkSpells_R_c[this], 0)
                    endif
                    if s__StarrkSpells___StarrkSpells_R_r[this] == 0.03 then
                        call MakeSound("war3mapimported\\Hero_Starrk_R2_3")
                    endif
                    if s__StarrkSpells___StarrkSpells_R_r[this] == StarrkR2_StunAppearTime + 1.32 and GetHeroLevel(s__StarrkSpells___StarrkSpells_R_c[this]) >= 35 then
                        //call MakeSound("war3mapimported\\Hero_Starrk_R3")
                        set s__StarrkSpells___StarrkSpells_R_k3[this]=1
                    endif
                    // Stratified cross-section: one pair per tick, random position inside each band.
                    if s__StarrkSpells___StarrkSpells_R_r[this] > 0.0 and s__StarrkSpells___StarrkSpells_R_r[this] < StarrkR2_CastTime then
                        set ra1=465.0 * ( ModuloInteger(R2I(s__StarrkSpells___StarrkSpells_R_r[this] / 0.03 + 0.5) - 1, 7) + GetRandomReal(0.0, 1.0) ) / 7.0
                        set dk=GetRandomReal(0.3, 0.45)
                        call EffectSpawn2("war3mapimported\\wos_xtyball2.mdl" , ( GetUnitX(s__StarrkSpells___StarrkSpells_R_c[this]) + 155 * Cos(s__StarrkSpells___StarrkSpells_R_a[this]) ) + ra1 * Cos(s__StarrkSpells___StarrkSpells_R_a[this] + 90 * bj_DEGTORAD) , ( GetUnitY(s__StarrkSpells___StarrkSpells_R_c[this]) + 155 * Sin(s__StarrkSpells___StarrkSpells_R_a[this]) ) + ra1 * Sin(s__StarrkSpells___StarrkSpells_R_a[this] + 90 * bj_DEGTORAD) , 0 , 1.15 , dk , GetRandomReal(40, 405) , StarrkR2_CastTime - s__StarrkSpells___StarrkSpells_R_r[this])
                        call EffectSpawn2("war3mapimported\\wos_xtyball2.mdl" , ( GetUnitX(s__StarrkSpells___StarrkSpells_R_c[this]) + 155 * Cos(s__StarrkSpells___StarrkSpells_R_a[this]) ) + ra1 * Cos(s__StarrkSpells___StarrkSpells_R_a[this] - 90 * bj_DEGTORAD) , ( GetUnitY(s__StarrkSpells___StarrkSpells_R_c[this]) + 155 * Sin(s__StarrkSpells___StarrkSpells_R_a[this]) ) + ra1 * Sin(s__StarrkSpells___StarrkSpells_R_a[this] - 90 * bj_DEGTORAD) , 0 , 1.15 , dk , GetRandomReal(40, 405) , StarrkR2_CastTime - s__StarrkSpells___StarrkSpells_R_r[this])
                    endif
                    if s__StarrkSpells___StarrkSpells_R_r[this] == 0.03 then
                    //call UnitRemoveAbility(c,'Avul')
                    set s__StarrkSpells___StarrkSpells_R_r2[this]=10
                        call SaveInteger(hs, GetHandleId(s__StarrkSpells___StarrkSpells_R_c[this]), StarrkSpells___SH_CAST_R, 1)
                        call MouseOn(GetOwningPlayer(s__StarrkSpells___StarrkSpells_R_c[this]))
                        set MouseX[GetPlayerId(GetOwningPlayer(s__StarrkSpells___StarrkSpells_R_c[this]))]=s__StarrkSpells___StarrkSpells_R_x[this]
                        set MouseY[GetPlayerId(GetOwningPlayer(s__StarrkSpells___StarrkSpells_R_c[this]))]=s__StarrkSpells___StarrkSpells_R_y[this]
                    endif
                    if s__StarrkSpells___StarrkSpells_R_r[this] == StarrkR2_CastTime then
                        set s__StarrkSpells___StarrkSpells_R_r2[this]=10
                        set s__StarrkSpells___StarrkSpells_R_r3[this]=10
                    endif
                    if s__StarrkSpells___StarrkSpells_R_r[this] >= StarrkR2_CastTime then
                        set targetA=GAngle2(s__StarrkSpells___StarrkSpells_R_c[this] , GetMouseX(GetOwningPlayer(s__StarrkSpells___StarrkSpells_R_c[this])) , GetMouseY(GetOwningPlayer(s__StarrkSpells___StarrkSpells_R_c[this])))
                        set diff=targetA - s__StarrkSpells___StarrkSpells_R_a[this]
                        if diff > bj_PI then
                            set diff=diff - 2 * bj_PI
                        elseif diff < - bj_PI then
                            set diff=diff + 2 * bj_PI
                        endif
// Clamp rotation speed to max per tick (0.087 rad = ~5 degrees)
                        if diff > 0.12 then
                            set diff=0.087
                        elseif diff < - 0.087 then
                            set diff=- 0.087
                        endif
                        set s__StarrkSpells___StarrkSpells_R_a[this]=s__StarrkSpells___StarrkSpells_R_a[this] + diff
                        call BlzSetUnitFacingEx(s__StarrkSpells___StarrkSpells_R_c[this], s__StarrkSpells___StarrkSpells_R_a[this] * bj_RADTODEG)
                        if s__StarrkSpells___StarrkSpells_R_r3[this] > 0.03 then
                            set s__StarrkSpells___StarrkSpells_R_r3[this]=0
                            call s__StarrkSpells___StarrkSpells_R_StarrkR2_Start(s__StarrkSpells___StarrkSpells_R_c[this] , GetUnitX(s__StarrkSpells___StarrkSpells_R_c[this]) + 100 * Cos(s__StarrkSpells___StarrkSpells_R_a[this]) , GetUnitY(s__StarrkSpells___StarrkSpells_R_c[this]) + 100 * Sin(s__StarrkSpells___StarrkSpells_R_a[this]) , s__StarrkSpells___StarrkSpells_R_check[this] , s__StarrkSpells___StarrkSpells_R_k3[this])
                            call s__StarrkSpells___StarrkSpells_R_StarrkR2_Start(s__StarrkSpells___StarrkSpells_R_c[this] , GetUnitX(s__StarrkSpells___StarrkSpells_R_c[this]) + 100 * Cos(s__StarrkSpells___StarrkSpells_R_a[this]) , GetUnitY(s__StarrkSpells___StarrkSpells_R_c[this]) + 100 * Sin(s__StarrkSpells___StarrkSpells_R_a[this]) , s__StarrkSpells___StarrkSpells_R_check[this] , s__StarrkSpells___StarrkSpells_R_k3[this])
                            if s__StarrkSpells___StarrkSpells_R_r[this] >= StarrkR2_StunAppearTime then
                              //  call StarrkR2_Start(c, GetUnitX(c) + 100 * Cos(a), GetUnitY(c) + 100 * Sin(a), check, k3)
                            endif
                            set s__StarrkSpells___StarrkSpells_R_check[this]=s__StarrkSpells___StarrkSpells_R_check[this] + 1
                            if s__StarrkSpells___StarrkSpells_R_check[this] == 2 then
                                set s__StarrkSpells___StarrkSpells_R_check[this]=0
                            endif
                        else
                            set s__StarrkSpells___StarrkSpells_R_r3[this]=s__StarrkSpells___StarrkSpells_R_r3[this] + 0.02
                        endif
                        if s__StarrkSpells___StarrkSpells_R_r2[this] > 0.3 then
                            set s__StarrkSpells___StarrkSpells_R_r2[this]=0
                            set s__StarrkSpells___StarrkSpells_R_k[this]=1
                            call VisionTimed(GetOwningPlayer(s__StarrkSpells___StarrkSpells_R_c[this]) , GetUnitX(s__StarrkSpells___StarrkSpells_R_c[this]) + ( 700 ) * Cos(s__StarrkSpells___StarrkSpells_R_a[this]) , GetUnitY(s__StarrkSpells___StarrkSpells_R_c[this]) + ( 700 * s__StarrkSpells___StarrkSpells_R_k[this] ) * Sin(s__StarrkSpells___StarrkSpells_R_a[this]) , s__StarrkSpells___StarrkSpells_R_aoe[this] * 1.6 , 2)
                            call VisionTimed(GetOwningPlayer(s__StarrkSpells___StarrkSpells_R_c[this]) , GetUnitX(s__StarrkSpells___StarrkSpells_R_c[this]) + ( 1400 ) * Cos(s__StarrkSpells___StarrkSpells_R_a[this]) , GetUnitY(s__StarrkSpells___StarrkSpells_R_c[this]) + ( 1400 ) * Sin(s__StarrkSpells___StarrkSpells_R_a[this]) , s__StarrkSpells___StarrkSpells_R_aoe[this] * 1.6 , 2)
                            call VisionTimed(GetOwningPlayer(s__StarrkSpells___StarrkSpells_R_c[this]) , GetUnitX(s__StarrkSpells___StarrkSpells_R_c[this]) + ( 2100 ) * Cos(s__StarrkSpells___StarrkSpells_R_a[this]) , GetUnitY(s__StarrkSpells___StarrkSpells_R_c[this]) + ( 2100 ) * Sin(s__StarrkSpells___StarrkSpells_R_a[this]) , s__StarrkSpells___StarrkSpells_R_aoe[this] * 1.6 , 2)
                            call VisionTimed(GetOwningPlayer(s__StarrkSpells___StarrkSpells_R_c[this]) , GetUnitX(s__StarrkSpells___StarrkSpells_R_c[this]) + ( 2600 ) * Cos(s__StarrkSpells___StarrkSpells_R_a[this]) , GetUnitY(s__StarrkSpells___StarrkSpells_R_c[this]) + ( 2600 ) * Sin(s__StarrkSpells___StarrkSpells_R_a[this]) , s__StarrkSpells___StarrkSpells_R_aoe[this] * 1.6 , 2)
                            call GroupClear(s__StarrkSpells___StarrkSpells_R_g2[this])
                            set s__StarrkSpells___StarrkSpells_R_check2[this]=s__StarrkSpells___StarrkSpells_R_check2[this] + 1
                           // call BJDebugMsg(I2S(check2))
                            loop
                                exitwhen s__StarrkSpells___StarrkSpells_R_k[this] == 7
                                call GroupClear(s__StarrkSpells___StarrkSpells_R_g[this])
                                call DecorRemove(s__StarrkSpells___StarrkSpells_R_c[this] , GetUnitX(s__StarrkSpells___StarrkSpells_R_c[this]) + ( 340 * s__StarrkSpells___StarrkSpells_R_k[this] ) * Cos(s__StarrkSpells___StarrkSpells_R_a[this]) , GetUnitY(s__StarrkSpells___StarrkSpells_R_c[this]) + ( 340 * s__StarrkSpells___StarrkSpells_R_k[this] ) * Sin(s__StarrkSpells___StarrkSpells_R_a[this]) , s__StarrkSpells___StarrkSpells_R_aoe[this] , 50)
                                call GroupEnumUnitsInRange(s__StarrkSpells___StarrkSpells_R_g[this], GetUnitX(s__StarrkSpells___StarrkSpells_R_c[this]) + ( 340 * s__StarrkSpells___StarrkSpells_R_k[this] ) * Cos(s__StarrkSpells___StarrkSpells_R_a[this]), GetUnitY(s__StarrkSpells___StarrkSpells_R_c[this]) + ( 340 * s__StarrkSpells___StarrkSpells_R_k[this] ) * Sin(s__StarrkSpells___StarrkSpells_R_a[this]), s__StarrkSpells___StarrkSpells_R_aoe[this], NoDecor_Cond)
                                loop
                                    set s__StarrkSpells___StarrkSpells_R_u[this]=FirstOfGroup(s__StarrkSpells___StarrkSpells_R_g[this])
                                    exitwhen s__StarrkSpells___StarrkSpells_R_u[this] == null
                                    if SpellBool(s__StarrkSpells___StarrkSpells_R_u[this]) and IsUnitEnemy(s__StarrkSpells___StarrkSpells_R_u[this], GetOwningPlayer(s__StarrkSpells___StarrkSpells_R_c[this])) and IsUnitInGroup(s__StarrkSpells___StarrkSpells_R_u[this], s__StarrkSpells___StarrkSpells_R_g2[this]) == false then
                                        set GearDamageNextSource=('A0BP') // INLINED!!
                                        call dmgmag(s__StarrkSpells___StarrkSpells_R_c[this] , s__StarrkSpells___StarrkSpells_R_u[this] , s__StarrkSpells___StarrkSpells_R_dmg[this])
                                        if s__StarrkSpells___StarrkSpells_R_r[this] >= StarrkR2_StunAppearTime and GetHeroLevel(s__StarrkSpells___StarrkSpells_R_c[this]) >= 35 then
                                            call StunUnit(s__StarrkSpells___StarrkSpells_R_c[this] , s__StarrkSpells___StarrkSpells_R_u[this] , StarrkR2_Stun)
                                        endif
                                        //call MUE(u, 60, 0.3, a)
                                        call SlowUnit(s__StarrkSpells___StarrkSpells_R_c[this] , s__StarrkSpells___StarrkSpells_R_u[this] , StarrkR2_Slow , StarrkR2_SlowDuration)
                                        call GroupAddUnit(s__StarrkSpells___StarrkSpells_R_g2[this], s__StarrkSpells___StarrkSpells_R_u[this])
                                    endif
                                    call GroupRemoveUnit(s__StarrkSpells___StarrkSpells_R_g[this], s__StarrkSpells___StarrkSpells_R_u[this])
                                endloop
                                set s__StarrkSpells___StarrkSpells_R_u[this]=null
                                set s__StarrkSpells___StarrkSpells_R_k[this]=s__StarrkSpells___StarrkSpells_R_k[this] + 1
                            endloop
                        else
                            set s__StarrkSpells___StarrkSpells_R_r2[this]=s__StarrkSpells___StarrkSpells_R_r2[this] + 0.03
                        endif
                    endif
                else
                    call StopSpellUnit2(s__StarrkSpells___StarrkSpells_R_c[this])
                    call MouseOff(GetOwningPlayer(s__StarrkSpells___StarrkSpells_R_c[this]))
                    call DestroyEffect(s__StarrkSpells___StarrkSpells_R_e[this])
                    call SaveInteger(hs, GetHandleId(s__StarrkSpells___StarrkSpells_R_c[this]), StarrkSpells___SH_STOP_R, 0)
                    call SaveInteger(hs, GetHandleId(s__StarrkSpells___StarrkSpells_R_c[this]), StarrkSpells___SH_CAST_R, 0)
                    call SaveInteger(hs, GetHandleId(s__StarrkSpells___StarrkSpells_R_c[this]), StarrkSpells___SH_POVOROT, 0)
                    if s__StarrkSpells___StarrkSpells_R_r[this] < s__StarrkSpells___StarrkSpells_R_r7[this] then
                        call UnitRemoveAbility(s__StarrkSpells___StarrkSpells_R_c[this], 'Avul')
                    endif
                    call SetUnitTimeScale(s__StarrkSpells___StarrkSpells_R_c[this], 1)
                    call DestroyGroup(s__StarrkSpells___StarrkSpells_R_g[this])
                    call DestroyGroup(s__StarrkSpells___StarrkSpells_R_g2[this])
                    set s__StarrkSpells___StarrkSpells_R_g[this]=null
                    set s__StarrkSpells___StarrkSpells_R_g2[this]=null
                    set s__StarrkSpells___StarrkSpells_R_e[this]=null
                    set s__StarrkSpells___StarrkSpells_R_c[this]=null
                    set s__StarrkSpells___StarrkSpells_R_m_StarrkR[i]=s__StarrkSpells___StarrkSpells_R_m_StarrkR[s__StarrkSpells___StarrkSpells_R_MUI_StarrkR]
                    set s__StarrkSpells___StarrkSpells_R_MUI_StarrkR=s__StarrkSpells___StarrkSpells_R_MUI_StarrkR - 1
                    set i=i - 1 // revisit: the moved instance must not skip this tick
                    if s__StarrkSpells___StarrkSpells_R_MUI_StarrkR == - 1 then
                        call StarrkSpells___StarrkTick_Off(5)
                    endif
                    call s__StarrkSpells___StarrkSpells_R_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction

        function s__StarrkSpells___StarrkSpells_R_StarrkR_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__StarrkSpells___StarrkSpells_R__allocate()
            local integer kkk= 0
            set s__StarrkSpells___StarrkSpells_R_MUI_StarrkR=s__StarrkSpells___StarrkSpells_R_MUI_StarrkR + 1
            set s__StarrkSpells___StarrkSpells_R_m_StarrkR[s__StarrkSpells___StarrkSpells_R_MUI_StarrkR]=this
            set s__StarrkSpells___StarrkSpells_R_c[this]=NewC
            set s__StarrkSpells___StarrkSpells_R_r[this]=0
            set s__StarrkSpells___StarrkSpells_R_x[this]=NewX
            set s__StarrkSpells___StarrkSpells_R_y[this]=NewY
            set s__StarrkSpells___StarrkSpells_R_check[this]=0
            set s__StarrkSpells___StarrkSpells_R_k2[this]=GetPlayerId(GetOwningPlayer(s__StarrkSpells___StarrkSpells_R_c[this]))
            set s__StarrkSpells___StarrkSpells_R_g[this]=CreateGroup()
            set s__StarrkSpells___StarrkSpells_R_k3[this]=0
            set s__StarrkSpells___StarrkSpells_R_check2[this]=0
            set s__StarrkSpells___StarrkSpells_R_r4[this]=10
            set s__StarrkSpells___StarrkSpells_R_g2[this]=CreateGroup()
            set kkk=( GetUnitAbilityLevel(s__StarrkSpells___StarrkSpells_R_c[this], StarrkR_ID) - 1 )
            if kkk > 2 then
            //    set kkk = 2
            endif
            set s__StarrkSpells___StarrkSpells_R_dmg[this]=GetHeroAgi(s__StarrkSpells___StarrkSpells_R_c[this], true) * ( StarrkR2_DamageAgiBase + ( StarrkR2_DamageAgiStep * ( GetUnitAbilityLevel(s__StarrkSpells___StarrkSpells_R_c[this], StarrkR_ID) - 1 ) ) )
            //call BJDebugMsg(R2S(dmg))
            set s__StarrkSpells___StarrkSpells_R_dmg[this]=s__StarrkSpells___StarrkSpells_R_dmg[this] / 3
            //call BJDebugMsg(R2S(dmg))
            set s__StarrkSpells___StarrkSpells_R_r2[this]=10
            set s__StarrkSpells___StarrkSpells_R_aoe[this]=StarrkR2_DamageAoe
            call StartSpellUnit2(s__StarrkSpells___StarrkSpells_R_c[this])
            call SaveInteger(hs, GetHandleId(Player(s__StarrkSpells___StarrkSpells_R_k2[this])), StarrkSpells___SH_R_START, 1)
            set s__StarrkSpells___StarrkSpells_R_a[this]=GAngle2(s__StarrkSpells___StarrkSpells_R_c[this] , s__StarrkSpells___StarrkSpells_R_x[this] , s__StarrkSpells___StarrkSpells_R_y[this]) // Angle Between points
            call MakeSound("war3mapimported\\Hero_Starrk_R1")
            call VisionTimed(GetOwningPlayer(s__StarrkSpells___StarrkSpells_R_c[this]) , GetUnitX(s__StarrkSpells___StarrkSpells_R_c[this]) , GetUnitY(s__StarrkSpells___StarrkSpells_R_c[this]) , 1800 , 4)
            set s__StarrkSpells___StarrkSpells_R_rmax[this]=3 + StarrkR2_CastTime
            set s__StarrkSpells___StarrkSpells_R_r7[this]=StarrkR2_InvulPerLvlAdd * ( GetUnitAbilityLevel(s__StarrkSpells___StarrkSpells_R_c[this], StarrkR_ID) - 1 )
            set s__StarrkSpells___StarrkSpells_R_check2[this]=0
            set s__StarrkSpells___StarrkSpells_R_e[this]=AddSpecialEffectTarget("war3mapimported\\wos_aurapartblue.mdx", s__StarrkSpells___StarrkSpells_R_c[this], "origin")
            call BlzSetUnitFacingEx(s__StarrkSpells___StarrkSpells_R_c[this], s__StarrkSpells___StarrkSpells_R_a[this] * bj_RADTODEG)
            call SetUnitTimeScale(s__StarrkSpells___StarrkSpells_R_c[this], 1)
            call SetUnitAnimationByIndex(s__StarrkSpells___StarrkSpells_R_c[this], 2)
            if s__StarrkSpells___StarrkSpells_R_MUI_StarrkR == 0 then
                call StarrkSpells___StarrkTick_On(5)
            endif
        endfunction


    // Invulnerability: this spell contains a StartSpellUnit/Avul phase.

        function s__StarrkSpells___StarrkSpells_T_Loop_StarrkT2 takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__StarrkSpells___StarrkSpells_T_MUI_StarrkT2
                set this=s__StarrkSpells___StarrkSpells_T_m_StarrkT2[i]
                set s__StarrkSpells___StarrkSpells_T_b[this]=SpellBoolCaster(s__StarrkSpells___StarrkSpells_T_c[this]) and s__StarrkSpells___StarrkSpells_T_r[this] <= s__StarrkSpells___StarrkSpells_T_rmax[this] and SR2(s__StarrkSpells___StarrkSpells_T_d[this] , s__StarrkSpells___StarrkSpells_T_td[this]) > 110
                if s__StarrkSpells___StarrkSpells_T_check[this] == 1 then
                    // TT/TR wolf was already launched: it must finish even if T is cancelled.
                    set s__StarrkSpells___StarrkSpells_T_b[this]=s__StarrkSpells___StarrkSpells_T_r[this] <= s__StarrkSpells___StarrkSpells_T_rmax[this] and SR3(s__StarrkSpells___StarrkSpells_T_d[this] , s__StarrkSpells___StarrkSpells_T_x[this] , s__StarrkSpells___StarrkSpells_T_y[this]) > 110
                    if s__StarrkSpells___StarrkSpells_T_check2[this] == 1 then
                        set s__StarrkSpells___StarrkSpells_T_b[this]=s__StarrkSpells___StarrkSpells_T_r[this] <= s__StarrkSpells___StarrkSpells_T_rmax[this]
                    endif
                endif
                if s__StarrkSpells___StarrkSpells_T_b[this] then
                    set s__StarrkSpells___StarrkSpells_T_r[this]=I2R(R2I(( s__StarrkSpells___StarrkSpells_T_r[this] + 0.03 ) * 1000.0 + 0.5)) / 1000.0
                    set s__StarrkSpells___StarrkSpells_T_r[this]=RoundReal(s__StarrkSpells___StarrkSpells_T_r[this] , 3)
                    if s__StarrkSpells___StarrkSpells_T_check[this] == 0 then
                        set s__StarrkSpells___StarrkSpells_T_a[this]=GAngle(s__StarrkSpells___StarrkSpells_T_d[this] , s__StarrkSpells___StarrkSpells_T_td[this])
                    else
                        set s__StarrkSpells___StarrkSpells_T_a[this]=GAngle2(s__StarrkSpells___StarrkSpells_T_d[this] , s__StarrkSpells___StarrkSpells_T_x[this] , s__StarrkSpells___StarrkSpells_T_y[this])
                    endif
                    call MoveUnit2(s__StarrkSpells___StarrkSpells_T_d[this] , s__StarrkSpells___StarrkSpells_T_move[this] , s__StarrkSpells___StarrkSpells_T_a[this])
                    set s__StarrkSpells___StarrkSpells_T_r3[this]=s__StarrkSpells___StarrkSpells_T_r3[this] + s__StarrkSpells___StarrkSpells_T_move[this]
                    if s__StarrkSpells___StarrkSpells_T_check2[this] == 1 then
                        call SetFly(s__StarrkSpells___StarrkSpells_T_d[this] , Parabola(s__StarrkSpells___StarrkSpells_T_fly[this] , s__StarrkSpells___StarrkSpells_T_sr[this] , s__StarrkSpells___StarrkSpells_T_r3[this]))
                    endif
                    call BlzSetUnitFacingEx(s__StarrkSpells___StarrkSpells_T_d[this], s__StarrkSpells___StarrkSpells_T_a[this] * bj_RADTODEG)
                    if s__StarrkSpells___StarrkSpells_T_r2[this] > 0.03 and s__StarrkSpells___StarrkSpells_T_check2[this] == 0 then
                        set s__StarrkSpells___StarrkSpells_T_r2[this]=0
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_BY_Wood_Effect_Kula_2_YiYingCun0.mdl" , GetUnitX(s__StarrkSpells___StarrkSpells_T_d[this]) + 100 * Cos(s__StarrkSpells___StarrkSpells_T_a[this]) , GetUnitY(s__StarrkSpells___StarrkSpells_T_d[this]) + 100 * Sin(s__StarrkSpells___StarrkSpells_T_a[this]) , s__StarrkSpells___StarrkSpells_T_a[this] * bj_RADTODEG , 0.75 , 1.5 , GetUnitFlyHeight(s__StarrkSpells___StarrkSpells_T_d[this]) + 50))
                        call VisionTimed(GetOwningPlayer(s__StarrkSpells___StarrkSpells_T_c[this]) , GetUnitX(s__StarrkSpells___StarrkSpells_T_d[this]) , GetUnitY(s__StarrkSpells___StarrkSpells_T_d[this]) , 800 , 2)
                    else
                        set s__StarrkSpells___StarrkSpells_T_r2[this]=s__StarrkSpells___StarrkSpells_T_r2[this] + 0.03
