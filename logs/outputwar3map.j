    function NatsuSpells___NatsuTick05_On takes integer k returns nothing
        if not NatsuSpells___NatsuTick05_Active[k] then
            set NatsuSpells___NatsuTick05_Active[k]=true
            set NatsuSpells___NatsuTick05_Users=NatsuSpells___NatsuTick05_Users + 1
            if NatsuSpells___NatsuTick05_Users == 1 then
                call TimerStart(NatsuSpells___NatsuTick05_Timer, 0.05, true, NatsuSpells___NatsuTick05_Callback)
            endif
        endif
    endfunction

    function NatsuSpells___NatsuTick05_Off takes integer k returns nothing
        if NatsuSpells___NatsuTick05_Active[k] then
            set NatsuSpells___NatsuTick05_Active[k]=false
            set NatsuSpells___NatsuTick05_Users=NatsuSpells___NatsuTick05_Users - 1
            if NatsuSpells___NatsuTick05_Users <= 0 then
                set NatsuSpells___NatsuTick05_Users=0
                call PauseTimer(NatsuSpells___NatsuTick05_Timer)
            endif
        endif
    endfunction


