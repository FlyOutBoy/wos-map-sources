    function KiritoSpells___KiritoTick05_On takes integer k returns nothing
        if not KiritoSpells___KiritoTick05_Active[k] then
            set KiritoSpells___KiritoTick05_Active[k]=true
            set KiritoSpells___KiritoTick05_Users=KiritoSpells___KiritoTick05_Users + 1
            if KiritoSpells___KiritoTick05_Users == 1 then
                call TimerStart(KiritoSpells___KiritoTick05_Timer, 0.05, true, KiritoSpells___KiritoTick05_Callback)
            endif
        endif
    endfunction

    function KiritoSpells___KiritoTick05_Off takes integer k returns nothing
        if KiritoSpells___KiritoTick05_Active[k] then
            set KiritoSpells___KiritoTick05_Active[k]=false
            set KiritoSpells___KiritoTick05_Users=KiritoSpells___KiritoTick05_Users - 1
            if KiritoSpells___KiritoTick05_Users <= 0 then
                set KiritoSpells___KiritoTick05_Users=0
                call PauseTimer(KiritoSpells___KiritoTick05_Timer)
            endif
        endif
    endfunction


    function KiritoSpells___KiritoTick_On takes integer k returns nothing
        if not KiritoSpells___KiritoTick_Active[k] then
            set KiritoSpells___KiritoTick_Active[k]=true
            set KiritoSpells___KiritoTick_Users=KiritoSpells___KiritoTick_Users + 1
            if KiritoSpells___KiritoTick_Users == 1 then
                call TimerStart(KiritoSpells___KiritoTick_Timer, 0.03, true, KiritoSpells___KiritoTick_Callback)
            endif
        endif
    endfunction

    function KiritoSpells___KiritoTick_Off takes integer k returns nothing
        if KiritoSpells___KiritoTick_Active[k] then
            set KiritoSpells___KiritoTick_Active[k]=false
            set KiritoSpells___KiritoTick_Users=KiritoSpells___KiritoTick_Users - 1
            if KiritoSpells___KiritoTick_Users <= 0 then
                set KiritoSpells___KiritoTick_Users=0
                call PauseTimer(KiritoSpells___KiritoTick_Timer)
            endif
        endif
    endfunction


    function KiritoSpells___KiritoCloneAuraDrop takes unit dummy returns nothing
        local effect e= LoadEffectHandle(hs, GetHandleId(dummy), KiritoSpells___SH_KIRITO_CLONE_AURA)
        if e != null then
            call DestroyEffect(e)
            call RemoveSavedHandle(hs, GetHandleId(dummy), KiritoSpells___SH_KIRITO_CLONE_AURA)
        endif
        set e=null
    endfunction


        function s__KiritoSpells___KiritoSpells_Q_Loop_KiritoQ takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__KiritoSpells___KiritoSpells_Q_MUI_KiritoQ
                set this=s__KiritoSpells___KiritoSpells_Q_m_KiritoQ[i]
                if SpellBoolCaster(s__KiritoSpells___KiritoSpells_Q_c[this]) and s__KiritoSpells___KiritoSpells_Q_r[this] <= s__KiritoSpells___KiritoSpells_Q_rmax[this] then
                    set s__KiritoSpells___KiritoSpells_Q_r[this]=I2R(R2I(( s__KiritoSpells___KiritoSpells_Q_r[this] + 0.03 ) * 1000.0 + 0.5)) / 1000.0
