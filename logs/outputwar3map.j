function RimuruG_Start takes unit c,real dmg returns nothing
local real hp= 0
    local real hp1= dmg * ( RimuruG_Restore1 / 100 )
    local real hp2= dmg * ( RimuruG_Restore2 / 100 )
    local real hp3= dmg * ( RimuruG_Restore3 / 100 )
    set hp=hp1
    if LoadInteger(hs, GetHandleId(c), RimuruSpells___SH_RIMURU_EVOL_1) == 1 then
    set hp=hp2
    endif
    if LoadInteger(hs, GetHandleId(c), RimuruSpells___SH_RIMURU_EVOL_2) == 1 then
    set hp=hp3
    endif
    call s__RimuruSpells___RimuruG_KS_RimuruG_Start(c , hp , RimuruG_OrbLifeTime)
endfunction
