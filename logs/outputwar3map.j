    function RimuruSpells___RimuruDodgeProgressTick takes nothing returns nothing
        local integer pid= 0
        local unit c
        local integer remaining
        local boolean active
        if RimuruSpells___RimuruDodgeCount == 0 then
            return
        endif
        loop
            exitwhen pid >= 10
            set c=RimuruSpells___RimuruDodgeHero[pid]
            if c != null then
                set active=GetUnitAbilityLevel(c, RimuruSpells___RimuruDodgeBuff[pid]) > 0
                if active then
                    set RimuruSpells___RimuruDodgeSeen[pid]=true
                endif
                set RimuruSpells___RimuruDodgeGrace[pid]=RimuruSpells___RimuruDodgeGrace[pid] + 0.03
                if Hero[pid] != c or GetWidgetLife(c) <= 0.405 or ( not active and ( RimuruSpells___RimuruDodgeSeen[pid] or RimuruSpells___RimuruDodgeGrace[pid] > 0.30 ) ) then
                    call WOSUI___WUI_TestHeroProgress((c ) , ( RimuruSpells___RimuruDodgeAbility[pid] ) , ( "Dodges remaining" ) , (( 0.00 )*1.0) , (( 0.00 )*1.0) , ( true) , "") // INLINED!!
                    set RimuruSpells___RimuruDodgeHero[pid]=null
                    set RimuruSpells___RimuruDodgeCount=RimuruSpells___RimuruDodgeCount - 1
                    if RimuruSpells___RimuruDodgeCount == 0 then
                        call GearTimer03Release()
                    endif
                elseif active then
                    set remaining=IMaxBJ(0, RimuruQ2_NumberofDodges - LoadInteger(hs, GetHandleId(c), RimuruSpells___SH_DODGE_Q))
                    call WOSUI___WUI_TestHeroProgress((c ) , ( RimuruSpells___RimuruDodgeAbility[pid] ) , ( "Dodges remaining" ) , (( I2R(remaining) )*1.0) , (( I2R(RimuruQ2_NumberofDodges) )*1.0) , ( false) , "") // INLINED!!
                endif
            endif
            set pid=pid + 1
        endloop
        set c=null
    endfunction

    function RimuruSpells___Rimuru_Listener03 takes nothing returns boolean
        call RimuruSpells___RimuruDodgeProgressTick()
        return false
    endfunction

    function RimuruSpells___RimuruTrackDodges takes unit c,integer abilityId,integer buffId returns nothing
        local integer pid= GetPlayerId(GetOwningPlayer(c))
        if pid >= 10 or Hero[pid] != c then
            return
        endif
        if RimuruSpells___RimuruDodgeHero[pid] == null then
            if RimuruSpells___RimuruDodgeCount == 0 then
                call GearTimer03Acquire()
            endif
            if not RimuruSpells___RimuruDodgeListenerOn then
                set RimuruSpells___RimuruDodgeListenerOn=true
                call TriggerAddCondition(GearTimer03Listeners, Condition(function RimuruSpells___Rimuru_Listener03))
            endif
            set RimuruSpells___RimuruDodgeCount=RimuruSpells___RimuruDodgeCount + 1
        endif
        set RimuruSpells___RimuruDodgeHero[pid]=c
        set RimuruSpells___RimuruDodgeAbility[pid]=abilityId
        set RimuruSpells___RimuruDodgeBuff[pid]=buffId
        set RimuruSpells___RimuruDodgeSeen[pid]=false
        set RimuruSpells___RimuruDodgeGrace[pid]=0.00
    endfunction

    function RimuruSpells___InitRimuruSpells takes nothing returns nothing
        set RimuruSpells___RimuruTimer03=CreateTimer()
        set RimuruSpells___RimuruTimer10=CreateTimer()
        set RimuruSpells___RimuruTimer03Callback=function RimuruSpells___RimuruTimer03Loop
        set RimuruSpells___RimuruTimer10Callback=function RimuruSpells___RimuruTimer10Loop
    endfunction

