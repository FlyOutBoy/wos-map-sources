                    call DestroyEffect(s__FrierenSpells__FrierenSpells_T_e[this])
                    call DestroyEffect(s__FrierenSpells__FrierenSpells_T_e2[this])
                    // Clone expiry must not change the real hero's player-wide spell slots.
                    if s__FrierenSpells__FrierenSpells_T_b[this] then
