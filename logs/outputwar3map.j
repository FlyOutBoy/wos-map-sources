                set s__StarrkSpells___StarrkSpells_W_scale[this]=1
                set s__StarrkSpells___StarrkSpells_W_scale2[this]=0.25
                set s__StarrkSpells___StarrkSpells_W_move[this]=70
            elseif LoadInteger(hs, GetHandleId(s__StarrkSpells___StarrkSpells_W_c[this]), StarrkSpells___SH_STARK_T) == 0 then
                set s__StarrkSpells___StarrkSpells_W_r4[this]=999
                set s__StarrkSpells___StarrkSpells_W_check[this]=1
                set s__StarrkSpells___StarrkSpells_W_rmax[this]=4
                set s__StarrkSpells___StarrkSpells_W_aoe[this]=StarrkEW_DamageAoe
