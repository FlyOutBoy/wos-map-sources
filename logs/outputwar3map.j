                    set s__ItemsElementsFx_next[this]=s__ItemsElementsFx_next[this] + 0.2
                    set s__ItemsElementsFx_charges[this]=s__ItemsElementsFx_charges[this] + 1
                    call s__ItemsElementsFx_Pulse(this,CrimsonScripture_Aoe , s__ItemsElementsFx_dmg2[this] , true , 0 , 0)
