                    call UnitRemoveAbility(s__AlucardSpells__AlucardSpells_R_c[this], AlterSaberR_Regen1)
                    call UnitRemoveAbility(s__AlucardSpells__AlucardSpells_R_c[this], AlterSaberR_Regen2)
                    call UnitRemoveAbility(s__AlucardSpells__AlucardSpells_R_c[this], AlterSaberR_Regen3)
                    call UnitRemoveAbility(s__AlucardSpells__AlucardSpells_R_c[this], AlterSaberR_Regen4)
