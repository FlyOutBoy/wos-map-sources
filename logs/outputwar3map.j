    function AlterSaberW_PasTrigger takes unit c,unit td returns nothing
    local real a
    local real dmg2
    local real x= GetUnitX(td)
    local real y= GetUnitY(td)
    local real time
if LoadInteger(hs, GetHandleId(c), AlterSaberSpells__SH_SABER_W) > 0 then
set a=GAngle(c , td)
set dmg2=GetHeroAgi(c, true) * ( AlterSaberG_DamageAgiBase + ( AlterSaberG_DamageAgiStep * ( GetLevelPas3Check(c) - 1 ) ) )
set dmg2=dmg2 + AlterSaberG_Damage2StaticBase + ( AlterSaberG_Damage2StaticStep * ( ( GetLevelPas3Check(c) - 1 ) ) )
call s__GearSystems2___KS_MoveEffectToUnit_MoveEffectToUnit_Start((EffectSpawn("war3mapImported\\wos_FireFlyW-SFX-1red.mdl" , x , y , a * bj_RADTODEG , 1 , 1.25 , 0) ) , (( 1 )*1.0) , (( 0 )*1.0) , ( td) , 0 , 1 , null) // INLINED!!
call s__GearSystems2___KS_MoveEffectToUnit_MoveEffectToUnit_Start((EffectSpawn("war3mapImported\\wos_Satsu-WWSFX-1.mdx" , x , y , a * bj_RADTODEG , 1.25 , 2. , 75) ) , (( 0.76 )*1.0) , (( 75 )*1.0) , ( td) , 0 , 1 , null) // INLINED!!
call s__GearSystems2___KS_MoveEffectToUnit_MoveEffectToUnit_Start((EffectSpawn("war3mapImported\\wos_Satsu-Hit-red.mdx" , x , y , a * bj_RADTODEG , 1.25 , 2.45 , 145) ) , (( 0.76 )*1.0) , (( 145 )*1.0) , ( td) , 0 , 1 , null) // INLINED!!
call s__GearSystems2___KS_MoveEffectToUnit_MoveEffectToUnit_Start((EffectSpawn("war3mapImported\\wos_mei-wsfx-2.mdl" , x , y , a * bj_RADTODEG , 1. , 2.45 , 135) ) , (( 0.76 )*1.0) , (( 135 )*1.0) , ( td) , 0 , 1 , null) // INLINED!!
call s__GearSystems2___KS_MoveEffectToUnit_MoveEffectToUnit_Start((EffectSpawn("war3mapImported\\wos_bloodex-special-23" , x , y , a * bj_RADTODEG , 2. , 2.45 , 135) ) , (( 2 )*1.0) , (( 135 )*1.0) , ( td) , 0 , 1 , null) // INLINED!!
call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_wfile00009065.mdl" , GetUnitX(td) , GetUnitY(td) , a * bj_RADTODEG , 0.65 , 1.75 , 1 , 255 , 255 , 255 , 255))
call MakeSound("war3mapimported\\Hero_AlterSaber_W3")
set GearDamageNextSource=('A02F') // INLINED!!
call s__GearSystems2___KS_DelayedDamage_NextDmg_Start((c ) , ( td ) , (( dmg2 )*1.0) , ( 0 ) , (( 0.06)*1.0)) // INLINED!!
call SaveInteger(hs, GetHandleId(c), AlterSaberSpells__SH_SABER_W, 0)
call SaveInteger(hs, GetHandleId(c), AlterSaberSpells__SH_SABER_W_CD, 1)
set time=AlterSaberG_CD_Base - ( ( GetLevelPas3Check(c) - 1 ) * AlterSaberG_CD_Step )
 call PassiveCD_Start(c , AlterSaberG_ID , time)
call s__GearSystems2___KS_Flush_Start((GetHandleId(c) ) , ( AlterSaberSpells__SH_SABER_W_CD ) , ( 0 ) , (( time)*1.0)) // INLINED!!
endif
    endfunction
