    function GojoT2_Start takes unit c returns nothing
        local integer id= LoadInteger(hs, GetHandleId(c), GojoSpells__SH_T_CUR1)
        local integer id2= LoadInteger(hs, GetHandleId(c), GojoSpells__SH_T_CUR2)
        call GojoPas_Start(c , GojoT2_ID)
        if id == 0 then
            call SaveInteger(hs, GetHandleId(c), GojoSpells__SH_T_CUR1, 1)
            call s__GojoSpells__GojoSpells_T_GojoT2_Start(c)
            call MakeSound("war3mapImported\\Hero_Gojo_T8")
            call MakeSound("war3mapImported\\Hero_Gojo_T1")
        elseif id2 == 0 then
            call SaveInteger(hs, GetHandleId(c), GojoSpells__SH_T_CUR2, 1)
        endif
    endfunction

