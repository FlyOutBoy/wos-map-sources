                    set s__DarkShikiSpells__DarkShikiG_KS_m_DarkShikiG[i]=s__DarkShikiSpells__DarkShikiG_KS_m_DarkShikiG[s__DarkShikiSpells__DarkShikiG_KS_MUI_DarkShikiG]
                    set s__DarkShikiSpells__DarkShikiG_KS_MUI_DarkShikiG=s__DarkShikiSpells__DarkShikiG_KS_MUI_DarkShikiG - 1
                    set i=i - 1 // revisit: the moved instance must not skip this tick
                    if s__DarkShikiSpells__DarkShikiG_KS_MUI_DarkShikiG == - 1 then
                        call DarkShikiSpells__DarkShikiTick_Off(5)
                    endif
                    call s__DarkShikiSpells__DarkShikiG_KS_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction
        function s__DarkShikiSpells__DarkShikiG_KS_DarkShikiG_Start takes unit NewC returns nothing
            local integer this= s__DarkShikiSpells__DarkShikiG_KS__allocate()
