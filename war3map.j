                            call EffectSpawn2("war3mapimported\\wos_xtyball2.mdl" , ( GetUnitX(s__StarrkSpells___StarrkSpells_R_c[this]) + 155 * Cos(s__StarrkSpells___StarrkSpells_R_a[this]) ) + ra1 * Cos(s__StarrkSpells___StarrkSpells_R_a[this] + 90 * bj_DEGTORAD) , ( GetUnitY(s__StarrkSpells___StarrkSpells_R_c[this]) + 155 * Sin(s__StarrkSpells___StarrkSpells_R_a[this]) ) + ra1 * Sin(s__StarrkSpells___StarrkSpells_R_a[this] + 90 * bj_DEGTORAD) , 0 , 1.15 , dk , GetRandomReal(40, 405) , 0.3 - s__StarrkSpells___StarrkSpells_R_r[this])
                            call EffectSpawn2("war3mapimported\\wos_xtyball2.mdl" , ( GetUnitX(s__StarrkSpells___StarrkSpells_R_c[this]) + 155 * Cos(s__StarrkSpells___StarrkSpells_R_a[this]) ) + ra1 * Cos(s__StarrkSpells___StarrkSpells_R_a[this] - 90 * bj_DEGTORAD) , ( GetUnitY(s__StarrkSpells___StarrkSpells_R_c[this]) + 155 * Sin(s__StarrkSpells___StarrkSpells_R_a[this]) ) + ra1 * Sin(s__StarrkSpells___StarrkSpells_R_a[this] - 90 * bj_DEGTORAD) , 0 , 1.15 , dk , GetRandomReal(40, 405) , 0.3 - s__StarrkSpells___StarrkSpells_R_r[this])
                        else
