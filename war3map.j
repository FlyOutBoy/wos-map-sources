                    if GetUnitCurrentOrder(s__GearSystems2__KS_SpellTimer_c[this]) == OrderId(BlzGetAbilityStringLevelField(BlzGetUnitAbility(s__GearSystems2__KS_SpellTimer_c[this], s__GearSystems2__KS_SpellTimer_k1[this]), ABILITY_SLF_BASE_ORDER_ID_NCL6, GetUnitAbilityLevel(s__GearSystems2__KS_SpellTimer_c[this], s__GearSystems2__KS_SpellTimer_k1[this]) - 1)) then
