                                call DebuffClear(s__AstaSpells___AstaSpells_F_u[this])
                            endif
                            if s__AstaSpells___AstaSpells_F_c[this] != s__AstaSpells___AstaSpells_F_u[this] and SpellBool(s__AstaSpells___AstaSpells_F_u[this]) and IsUnitEnemy(s__AstaSpells___AstaSpells_F_u[this], GetOwningPlayer(s__AstaSpells___AstaSpells_F_c[this])) then
                                set s__AstaSpells___AstaSpells_F_r5[this]=( GetUnitState(s__AstaSpells___AstaSpells_F_u[this], UNIT_STATE_MAX_MANA) * ( AstaF_ManaSteal / 100.0 ) ) / 4.0
                                if s__AstaSpells___AstaSpells_F_r5[this] > 0.0 then
                                    call SetMpCurrent(s__AstaSpells___AstaSpells_F_c[this] , s__AstaSpells___AstaSpells_F_r5[this])
                                    call SetMpCurrent(s__AstaSpells___AstaSpells_F_u[this] , - s__AstaSpells___AstaSpells_F_r5[this])
                                endif
