                    call UnitAddAbility(s__HarribelSpells___HarribelSpells_G_c[this], 'A0AZ')
                    call SaveInteger(hs, GetHandleId(s__HarribelSpells___HarribelSpells_G_c[this]), StringHash("hari g 1"), 1)
