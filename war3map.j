        function s__KenjakuSpells__KenjakuQ_KS_KenjakuQ_Start takes unit NewC returns nothing
            local integer this= s__KenjakuSpells__KenjakuQ_KS__allocate()
            set s__KenjakuSpells__KenjakuQ_KS_MUI_KenjakuQ=s__KenjakuSpells__KenjakuQ_KS_MUI_KenjakuQ + 1
