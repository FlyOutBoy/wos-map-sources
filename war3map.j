//library WosCareerStats:


function WosCareerStats___WCS_CategoryName takes integer category returns string
    if category == 1 then
        return "GACHA"
    elseif category == 2 then
        return "BLEACH"
    elseif category == 3 then
        return "FAIRY TAIL"
    elseif category == 4 then
        return "ONE PIECE"
    elseif category == 5 then
        return "JUJUTSU KAISEN"
    endif
    return "OTHER"
endfunction

function WosCareerStats___WCS_CategoryTexture takes integer category returns string
    if category == 1 then
        return "Pick\\Pick_Gacha.blp"
    elseif category == 2 then
        return "Pick\\Pick_Bleach.blp"
    elseif category == 3 then
        return "Pick\\Pick_FairyTail.blp"
    elseif category == 4 then
        return "Pick\\Pick_OnePiece.blp"
    elseif category == 5 then
        return "Pick\\Pick_JujutsuKaisen.blp"
    endif
    return "Pick\\Pick_Other.blp"
endfunction

function WosCareerStats___WCS_Percent takes integer wins,integer games returns string
    if games <= 0 then
        return "N/A"
    endif
    return I2S(wins * 100 / games) + "%"
endfunction

function WosCareerStats___WCS_Decimal100 takes integer value returns string
    local integer whole= value / 100
    local integer fraction= ModuloInteger(value, 100)
    if fraction < 0 then
        set fraction=- fraction
    endif
    if fraction < 10 then
        return I2S(whole) + ".0" + I2S(fraction)
    endif
    return I2S(whole) + "." + I2S(fraction)
endfunction

function WosCareerStats___WCS_CreateText takes framehandle parent,real x,real y,real width,real height,real scale,textaligntype horizontal,string value,integer context returns framehandle
    local framehandle result= BlzCreateFrameByType("TEXT", "WcsText", parent, "", context)
    call BlzFrameSetAbsPoint(result, FRAMEPOINT_CENTER, x, y)
    call BlzFrameSetSize(result, width, height)
    call BlzFrameSetTextAlignment(result, TEXT_JUSTIFY_MIDDLE, horizontal)
    call BlzFrameSetScale(result, scale)
    call BlzFrameSetText(result, value)
    return result
endfunction

function WosCareerStats___WCS_CreateBackdrop takes framehandle parent,real x,real y,real width,real height,integer alpha,integer context returns framehandle
    local framehandle result= BlzCreateFrameByType("BACKDROP", "WcsBackdrop", parent, "", context)
    call BlzFrameSetAbsPoint(result, FRAMEPOINT_CENTER, x, y)
    call BlzFrameSetSize(result, width, height)
    call BlzFrameSetTexture(result, WosCareerStats___WCS_TEX_BLACK, 0, true)
    call BlzFrameSetAlpha(result, alpha)
    return result
endfunction

function WosCareerStats___WCS_CreateIconButton takes framehandle parent,real x,real y,real size,integer context returns framehandle
    local framehandle result= BlzCreateFrameByType("BUTTON", "WcsIconButton", parent, "ScoreScreenTabButtonTemplate", context)
    call BlzFrameSetAbsPoint(result, FRAMEPOINT_CENTER, x, y)
    call BlzFrameSetSize(result, size, size)
    return result
endfunction

function WosCareerStats___WCS_CreateIcon takes framehandle buttonFrame,string texture,integer context returns framehandle
    local framehandle result= BlzCreateFrameByType("BACKDROP", "WcsIcon", buttonFrame, "", context)
    call BlzFrameSetAllPoints(result, buttonFrame)
    call BlzFrameSetTexture(result, texture, 0, true)
    return result
endfunction

function WosCareerStats___WCS_CreateTextButton takes framehandle parent,real x,real y,real width,real height,string value,integer context returns framehandle
    local framehandle buttonFrame= BlzCreateFrame("ScriptDialogButton", parent, 0, context)
    call BlzFrameSetAbsPoint(buttonFrame, FRAMEPOINT_CENTER, x, y)
    call BlzFrameSetSize(buttonFrame, width, height)
    call BlzFrameSetText(buttonFrame, value)
    call BlzFrameSetScale(buttonFrame, 0.80)
    return buttonFrame
endfunction

function WosCareerStats___WCS_GetLiveHeroId takes integer category,integer slot returns integer
    if category == 1 then
        return Hero_ID0[slot]
    elseif category == 2 then
        return Hero_ID1[slot]
    elseif category == 3 then
        return Hero_ID2[slot]
    elseif category == 4 then
        return Hero_ID3[slot]
    elseif category == 5 then
        return Hero_ID4[slot]
    elseif category == 6 then
        return Hero_ID5[slot]
    endif
    return 0
endfunction

function WosCareerStats___WCS_GetHeroId takes integer category,integer slot returns integer
    if category < 1 or category > WosCareerStats___WCS_CATEGORY_COUNT or slot < 0 or slot >= WosCareerStats___WCS_HERO_SLOT_COUNT then
        return 0
    endif
    if WosCareerStats___WCS_CatalogReady then
        return WosCareerStats___WCS_CatalogHeroId[( category - 1 ) * WosCareerStats___WCS_HERO_SLOT_COUNT + slot]
    endif
    return WosCareerStats___WCS_GetLiveHeroId(category , slot)
endfunction

function WosCareerStats___WCS_CaptureHeroCatalog takes nothing returns boolean
    local integer category= 1
    local integer slot
    local integer heroId
    local integer heroCount= 0
    local boolean alreadyMutated= false
    if WosCareerStats___WCS_CatalogReady then
        return true
    endif

    // Hero IDs are filled by MyHeroIdInit about one second after map start.
    // Never freeze an empty or already modified (12) pick pool.
    loop
        exitwhen category > WosCareerStats___WCS_CATEGORY_COUNT
        set slot=0
        loop
            exitwhen slot >= WosCareerStats___WCS_HERO_SLOT_COUNT
            set heroId=WosCareerStats___WCS_GetLiveHeroId(category , slot)
            if heroId == 12 then
                set alreadyMutated=true
            elseif heroId != 0 then
                set heroCount=heroCount + 1
            endif
            set slot=slot + 1
        endloop
        set category=category + 1
    endloop
    if heroCount == 0 or alreadyMutated then
        return false
    endif

    set category=1
    loop
        exitwhen category > WosCareerStats___WCS_CATEGORY_COUNT
        set slot=0
        loop
            exitwhen slot >= WosCareerStats___WCS_HERO_SLOT_COUNT
            set WosCareerStats___WCS_CatalogHeroId[( category - 1 ) * WosCareerStats___WCS_HERO_SLOT_COUNT + slot]=WosCareerStats___WCS_GetLiveHeroId(category , slot)
            set slot=slot + 1
        endloop
        set category=category + 1
    endloop
    set WosCareerStats___WCS_CatalogReady=true
    return true
endfunction

function WosCareerStats___WCS_CatalogTick takes nothing returns nothing
    local timer catalogTimer= GetExpiredTimer()
    if WosCareerStats___WCS_CaptureHeroCatalog() then
        call PauseTimer(catalogTimer)
        call DestroyTimer(catalogTimer)
        set WosCareerStats___WCS_CatalogTimer=null
    endif
    set catalogTimer=null
endfunction

function WosCareerStats___WCS_FindHeroCategory takes integer heroId returns integer
    local integer category= 1
    local integer slot
    if heroId == 0 or heroId == 12 then
        return 0
    endif
    loop
        exitwhen category > WosCareerStats___WCS_CATEGORY_COUNT
        set slot=0
        loop
            exitwhen slot >= WosCareerStats___WCS_HERO_SLOT_COUNT
            if WosCareerStats___WCS_GetHeroId(category , slot) == heroId then
                return category
            endif
            set slot=slot + 1
        endloop
        set category=category + 1
    endloop
    return 0
endfunction

function WosCareerStats___WCS_GetExtraHeroId takes player viewer,integer rank,integer excludedHeroId returns integer
    local integer recordRank= 1
    local integer found= 0
    local integer heroId
    loop
        set heroId=SaveSystem_GetRecordedHeroId(viewer , recordRank)
        exitwhen heroId == 0
        if heroId != 12 and heroId != excludedHeroId and WosCareerStats___WCS_FindHeroCategory(heroId) == 0 then
            set found=found + 1
            if found == rank then
                return heroId
            endif
        endif
        set recordRank=recordRank + 1
    endloop
    return 0
endfunction

function WosCareerStats___WCS_CreateTooltip takes framehandle owner,real width,real height,integer context returns framehandle
    local framehandle tooltip= BlzCreateFrameByType("BACKDROP", "WcsTooltip", BlzGetOriginFrame(ORIGIN_FRAME_GAME_UI, 0), "", context)
    local framehandle label= BlzCreateFrameByType("TEXT", "WcsTooltipText", tooltip, "", context)
    call BlzFrameSetPoint(tooltip, FRAMEPOINT_BOTTOM, owner, FRAMEPOINT_TOP, 0.0, 0.002)
    call BlzFrameSetSize(tooltip, width, height)
    call BlzFrameSetTexture(tooltip, WosCareerStats___WCS_TEX_BLACK, 0, true)
    call BlzFrameSetAlpha(tooltip, 225)
    call BlzFrameSetLevel(tooltip, 90)
    call BlzFrameSetAllPoints(label, tooltip)
    call BlzFrameSetTextAlignment(label, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
    call BlzFrameSetScale(label, 0.85)
    call BlzFrameSetText(label, "")
    call BlzFrameSetVisible(tooltip, false)
    call BlzFrameSetTooltip(owner, tooltip)
    set WosCareerStats___WCS_LastCreatedTooltip=tooltip
    set tooltip=null
    return label
endfunction

function WosCareerStats___WCS_HideTooltips takes integer pid returns nothing
    local integer index= 0
    if pid < 0 or pid >= WosCareerStats___WCS_PLAYER_COUNT or GetLocalPlayer() != Player(pid) then
        return
    endif
    loop
        exitwhen index >= WosCareerStats___WCS_CATEGORY_COUNT
        if WosCareerStats___WCS_CategoryTooltip[index] != null then
            call BlzFrameSetVisible(WosCareerStats___WCS_CategoryTooltip[index], false)
        endif
        set index=index + 1
    endloop
    set index=0
    loop
        exitwhen index >= WosCareerStats___WCS_HERO_SLOT_COUNT
        if WosCareerStats___WCS_HeroTooltip[index] != null then
            call BlzFrameSetVisible(WosCareerStats___WCS_HeroTooltip[index], false)
        endif
        set index=index + 1
    endloop
    set index=0
    loop
        exitwhen index >= WosCareerStats___WCS_LAST_ITEM_COUNT
        if WosCareerStats___WCS_LastItemTooltip[index] != null then
            call BlzFrameSetVisible(WosCareerStats___WCS_LastItemTooltip[index], false)
        endif
        set index=index + 1
    endloop
    set index=0
    loop
        exitwhen index >= WosCareerStats___WCS_BEST_ITEM_COUNT
        if WosCareerStats___WCS_BestItemTooltip[index] != null then
            call BlzFrameSetVisible(WosCareerStats___WCS_BestItemTooltip[index], false)
        endif
        set index=index + 1
    endloop
    set index=0
    loop
        exitwhen index >= WosCareerStats___WCS_RELATION_ROW_COUNT * WosCareerStats___WCS_RELATION_SLOT_COUNT
        if WosCareerStats___WCS_RelationTooltip[index] != null then
            call BlzFrameSetVisible(WosCareerStats___WCS_RelationTooltip[index], false)
        endif
        set index=index + 1
    endloop
endfunction

function WosCareerStats___WCS_SetPage takes integer pid,integer page returns nothing
    if pid < 0 or pid >= WosCareerStats___WCS_PLAYER_COUNT or GetLocalPlayer() != Player(pid) then
        return
    endif
    if page < 0 or page > 2 then
        set page=0
    endif
    set WosCareerStats___WCS_Page[pid]=page
    call WosCareerStats___WCS_HideTooltips(pid)
    call BlzFrameSetVisible(WosCareerStats___WCS_HomePage, page == 0)
    call BlzFrameSetVisible(WosCareerStats___WCS_HeroesPage, page == 1)
    call BlzFrameSetVisible(WosCareerStats___WCS_DetailPage, page == 2)
endfunction

function WosCareerStats___WCS_UpdateHome takes integer pid returns nothing
    local player viewer=null
    local integer games= SaveSystem_GetGamesPlayed(viewer)
    local integer wins= SaveSystem_GetGamesWon(viewer)
    local integer heroId= 0
    local integer heroGames
    local integer heroWins
    if pid < 0 or pid >= WosCareerStats___WCS_PLAYER_COUNT or GetLocalPlayer() != Player(pid) then
        return
    endif
   set viewer=Player(pid)
    if Hero[pid] != null then
        set heroId=GetUnitTypeId(Hero[pid])
    endif
    call BlzFrameSetText(WosCareerStats___WCS_HomeOverall, "|cffffd36bYOUR CAREER|r\n\nGames  |cffffffff" + I2S(games) + "|r\nWins  |cff76d7a8" + I2S(wins) + "|r\nLosses  |cffff7777" + I2S(games - wins) + "|r\nWin rate  |cffffffff" + WosCareerStats___WCS_Percent(wins , games) + "|r")
    if heroId == 0 then
        call BlzFrameSetText(WosCareerStats___WCS_HomeHero, "|cffffd36bSELECTED HERO|r\n|cff9aa7b4No hero selected yet.|r")
    else
        set heroGames=SaveSystem_GetHeroGames(viewer , heroId)
        set heroWins=SaveSystem_GetHeroWins(viewer , heroId)
        call BlzFrameSetText(WosCareerStats___WCS_HomeHero, "|cffffd36bSELECTED HERO|r\n\n|cffffffff" + GetObjectName(heroId) + "|r\nGames  " + I2S(heroGames) + "\nWins  " + I2S(heroWins) + "\nLosses  " + I2S(heroGames - heroWins) + "\nWin rate  |cffffffff" + WosCareerStats___WCS_Percent(heroWins , heroGames) + "|r")
    endif
    set viewer=null
endfunction

function WosCareerStats___WCS_UpdateHeroes takes integer pid returns nothing
    local player viewer= null
    local integer slot= 0
    local integer heroId
    local integer currentHeroId= 0
    local integer extraRank= 1
    local integer games
    local integer wins
    local boolean currentExtraPlaced= false
    if pid < 0 or pid >= WosCareerStats___WCS_PLAYER_COUNT or GetLocalPlayer() != Player(pid) then
        return
    endif
   set viewer=Player(pid)
    if Hero[pid] != null then
        set currentHeroId=GetUnitTypeId(Hero[pid])
    endif
    call BlzFrameSetText(WosCareerStats___WCS_Title, "|cffffd36bHEROES / " + WosCareerStats___WCS_CategoryName(WosCareerStats___WCS_Category[pid]) + "|r")
    loop
        exitwhen slot >= WosCareerStats___WCS_HERO_SLOT_COUNT
        set heroId=WosCareerStats___WCS_GetHeroId(WosCareerStats___WCS_Category[pid] , slot)
        if heroId == 12 then
            set heroId=0
        endif
        // Герои, которых нет в статических Hero_ID0..5, не теряются:
        // текущий и сохранённые профили занимают свободные ячейки OTHER.
        if WosCareerStats___WCS_Category[pid] == 6 and heroId == 0 then
            if currentHeroId != 0 and WosCareerStats___WCS_FindHeroCategory(currentHeroId) == 0 and not currentExtraPlaced then
                set heroId=currentHeroId
                set currentExtraPlaced=true
            else
                set heroId=WosCareerStats___WCS_GetExtraHeroId(viewer , extraRank , currentHeroId)
                set extraRank=extraRank + 1
            endif
        endif
        set WosCareerStats___WCS_VisibleHeroId[slot]=heroId
        if heroId == 0 then
            call BlzFrameSetVisible(WosCareerStats___WCS_HeroButton[slot], false)
            call BlzFrameSetVisible(WosCareerStats___WCS_HeroName[slot], false)
            call BlzFrameSetText(WosCareerStats___WCS_HeroName[slot], "")
            call BlzFrameSetText(WosCareerStats___WCS_HeroTooltipText[slot], "")
        else
            set games=SaveSystem_GetHeroGames(viewer , heroId)
            set wins=SaveSystem_GetHeroWins(viewer , heroId)
            call BlzFrameSetVisible(WosCareerStats___WCS_HeroButton[slot], true)
            call BlzFrameSetVisible(WosCareerStats___WCS_HeroName[slot], true)
            call BlzFrameSetTexture(WosCareerStats___WCS_HeroIcon[slot], BlzGetAbilityIcon(heroId), 0, false)
            call BlzFrameSetText(WosCareerStats___WCS_HeroName[slot], GetObjectName(heroId))
            call BlzFrameSetText(WosCareerStats___WCS_HeroTooltipText[slot], "|cffffd36b" + GetObjectName(heroId) + "|r\nGames: " + I2S(games) + "   Wins: " + I2S(wins) + "\nWin rate: " + WosCareerStats___WCS_Percent(wins , games) + "\n|cff9aa7b4Click for details.|r")
        endif
        set slot=slot + 1
    endloop
    set viewer=null
endfunction

function WosCareerStats___WCS_ItemDescription takes integer itemId returns string
    local string tooltip= BlzGetAbilityTooltip(itemId, 0)
    local string description= BlzGetAbilityExtendedTooltip(itemId, 0)
    if tooltip == "" and description == "" then
        return "|cff9aa7b4No object description available.|r"
    endif
    if tooltip == "" then
        return description
    endif
    if description == "" or description == tooltip then
        return tooltip
    endif
    set description=tooltip + "\n" + description
    return description
endfunction

// Item descriptions vary a lot in length. Estimate wrapped line count at the
// tooltip's fixed readable width and resize only the local frame backdrop.
function WosCareerStats___WCS_ItemTooltipHeight takes string value returns real
    local integer length= StringLength(value)
    local integer index= 0
    local integer column= 0
    local integer lines= 1
    local real height
    loop
        exitwhen index >= length
        if SubString(value, index, index + 1) == "\n" then
            set lines=lines + 1
            set column=0
        else
            set column=column + 1
            if column >= 43 then
                set lines=lines + 1
                set column=0
            endif
        endif
        set index=index + 1
    endloop
    set height=0.018 + I2R(lines) * 0.0072
    if height < 0.058 then
        set height=0.058
    elseif height > 0.190 then
        set height=0.190
    endif
    return height
endfunction

function WosCareerStats___WCS_UpdateLastItem takes integer slot,integer heroId,player viewer returns nothing
    local integer itemId= SaveSystem_GetLastBuildItemId(viewer , heroId , slot)
    local integer finalGames
    local integer finalWins
    local integer usedGames
    local integer usedWins
    local string tooltipText
    if viewer == null or GetLocalPlayer() != viewer then
        return
    endif
    if itemId == 0 then
        call BlzFrameSetVisible(WosCareerStats___WCS_LastItemButton[slot], false)
        call BlzFrameSetText(WosCareerStats___WCS_LastItemText[slot], "|cff777777- |r")
        return
    endif
    set finalGames=(SaveSystem_GetItemValue((viewer ) , ( heroId ) , ( itemId) , 0)) // INLINED!!
    set finalWins=(SaveSystem_GetItemValue((viewer ) , ( heroId ) , ( itemId) , 1)) // INLINED!!
    set usedGames=(SaveSystem_GetItemValue((viewer ) , ( heroId ) , ( itemId) , 2)) // INLINED!!
    set usedWins=(SaveSystem_GetItemValue((viewer ) , ( heroId ) , ( itemId) , 3)) // INLINED!!
    call BlzFrameSetVisible(WosCareerStats___WCS_LastItemButton[slot], true)
    call BlzFrameSetTexture(WosCareerStats___WCS_LastItemIcon[slot], BlzGetAbilityIcon(itemId), 0, false)
    call BlzFrameSetText(WosCareerStats___WCS_LastItemText[slot], I2S(slot + 1))
    set tooltipText="|cffffd36b" + GetObjectName(itemId) + "|r\nLast match slot " + I2S(slot + 1) + "\nFinal build: " + I2S(finalWins) + "/" + I2S(finalGames) + " (" + WosCareerStats___WCS_Percent(finalWins , finalGames) + ")\nUsed: " + I2S(usedWins) + "/" + I2S(usedGames) + " (" + WosCareerStats___WCS_Percent(usedWins , usedGames) + ")\n\n" + WosCareerStats___WCS_ItemDescription(itemId)
    call BlzFrameSetSize(WosCareerStats___WCS_LastItemTooltip[slot], 0.205, WosCareerStats___WCS_ItemTooltipHeight(tooltipText))
    call BlzFrameSetText(WosCareerStats___WCS_LastItemTooltipText[slot], tooltipText)
endfunction

function WosCareerStats___WCS_UpdateBestItem takes integer slot,integer heroId,player viewer returns nothing
    local integer itemId= SaveSystem_GetBestItemId(viewer , heroId , slot + 1)
    local integer finalGames
    local integer finalWins
    local integer usedGames
    local integer usedWins
    local string tooltipText
    if viewer == null or GetLocalPlayer() != viewer then
        return
    endif
    if itemId == 0 then
        call BlzFrameSetVisible(WosCareerStats___WCS_BestItemButton[slot], false)
        call BlzFrameSetText(WosCareerStats___WCS_BestItemText[slot], "")
        return
    endif
    set finalGames=(SaveSystem_GetItemValue((viewer ) , ( heroId ) , ( itemId) , 0)) // INLINED!!
    set finalWins=(SaveSystem_GetItemValue((viewer ) , ( heroId ) , ( itemId) , 1)) // INLINED!!
    set usedGames=(SaveSystem_GetItemValue((viewer ) , ( heroId ) , ( itemId) , 2)) // INLINED!!
    set usedWins=(SaveSystem_GetItemValue((viewer ) , ( heroId ) , ( itemId) , 3)) // INLINED!!
    call BlzFrameSetVisible(WosCareerStats___WCS_BestItemButton[slot], true)
    call BlzFrameSetTexture(WosCareerStats___WCS_BestItemIcon[slot], BlzGetAbilityIcon(itemId), 0, false)
    call BlzFrameSetText(WosCareerStats___WCS_BestItemText[slot], WosCareerStats___WCS_Percent(finalWins , finalGames) + "\n" + I2S(finalGames) + "g")
    set tooltipText="|cffffd36b" + GetObjectName(itemId) + "|r\nWin rate: " + WosCareerStats___WCS_Percent(finalWins , finalGames) + "\nFinal build: " + I2S(finalWins) + "/" + I2S(finalGames) + "\nPopularity: " + I2S(usedGames) + " games\nUsed wins: " + I2S(usedWins) + "/" + I2S(usedGames) + " (" + WosCareerStats___WCS_Percent(usedWins , usedGames) + ")\n\n" + WosCareerStats___WCS_ItemDescription(itemId)
    call BlzFrameSetSize(WosCareerStats___WCS_BestItemTooltip[slot], 0.205, WosCareerStats___WCS_ItemTooltipHeight(tooltipText))
    call BlzFrameSetText(WosCareerStats___WCS_BestItemTooltipText[slot], tooltipText)
endfunction

function WosCareerStats___WCS_RelationName takes integer relationType returns string
    if relationType == 0 then
        return "GOOD AGAINST"
    elseif relationType == 1 then
        return "BAD AGAINST"
    elseif relationType == 2 then
        return "GOOD WITH"
    endif
    return "BAD WITH"
endfunction

function WosCareerStats___WCS_UpdateRelations takes integer heroId,player viewer returns nothing
    local integer relationType= 0
    local integer slot
    local integer index
    local integer otherHeroId
    local integer games
    local integer wins
    if viewer == null or GetLocalPlayer() != viewer then
        return
    endif
    loop
        exitwhen relationType >= WosCareerStats___WCS_RELATION_ROW_COUNT
        set slot=0
        loop
            exitwhen slot >= WosCareerStats___WCS_RELATION_SLOT_COUNT
            set index=relationType * WosCareerStats___WCS_RELATION_SLOT_COUNT + slot
            set otherHeroId=SaveSystem_GetBestRelationHeroId(viewer , heroId , relationType , slot + 1)
            if otherHeroId == 0 then
                call BlzFrameSetVisible(WosCareerStats___WCS_RelationButton[index], false)
                call BlzFrameSetText(WosCareerStats___WCS_RelationTooltipText[index], "")
            else
                set games=SaveSystem_GetRelationGames(viewer , heroId , otherHeroId , relationType)
                set wins=SaveSystem_GetRelationWins(viewer , heroId , otherHeroId , relationType)
                call BlzFrameSetVisible(WosCareerStats___WCS_RelationButton[index], true)
                call BlzFrameSetTexture(WosCareerStats___WCS_RelationIcon[index], BlzGetAbilityIcon(otherHeroId), 0, false)
                call BlzFrameSetText(WosCareerStats___WCS_RelationTooltipText[index], "|cffffd36b" + GetObjectName(otherHeroId) + "|r\n" + WosCareerStats___WCS_RelationName(relationType) + "\nGames: " + I2S(games) + "   Wins: " + I2S(wins) + "   Losses: " + I2S(games - wins))
            endif
            set slot=slot + 1
        endloop
        set relationType=relationType + 1
    endloop
endfunction

function WosCareerStats___WCS_UpdateDetail takes integer pid returns nothing
    local player viewer= Player(pid)
    local integer heroId= WosCareerStats___WCS_DetailHeroId[pid]
    local integer games= SaveSystem_GetHeroGames(viewer , heroId)
    local integer wins= SaveSystem_GetHeroWins(viewer , heroId)
    local integer roundWins= (SaveSystem_GetHeroExtraValue((viewer ) , ( heroId) , 0)) // INLINED!!
    local integer roundLosses= (SaveSystem_GetHeroExtraValue((viewer ) , ( heroId) , 1)) // INLINED!!
    local integer combatGames= (SaveSystem_GetHeroExtraValue((viewer ) , ( heroId) , 2)) // INLINED!!
    local integer kills= (SaveSystem_GetHeroExtraValue((viewer ) , ( heroId) , 3)) // INLINED!!
    local integer deaths= (SaveSystem_GetHeroExtraValue((viewer ) , ( heroId) , 4)) // INLINED!!
    local integer averageKills= 0
    local integer averageDeaths= 0
    local integer slot= 0
    if pid < 0 or pid >= WosCareerStats___WCS_PLAYER_COUNT or GetLocalPlayer() != Player(pid) then
        set viewer=null
        return
    endif
    if heroId == 0 then
        call WosCareerStats___WCS_SetPage(pid , 1)
        set viewer=null
        return
    endif
    if combatGames > 0 then
        set averageKills=kills * 100 / combatGames
        set averageDeaths=deaths * 100 / combatGames
    endif
    call BlzFrameSetText(WosCareerStats___WCS_Title, "|cffffd36bHERO DETAILS|r")
    call BlzFrameSetTexture(WosCareerStats___WCS_DetailHeroIcon, BlzGetAbilityIcon(heroId), 0, false)
    call BlzFrameSetText(WosCareerStats___WCS_DetailHeroName, "|cffffd36b" + GetObjectName(heroId) + "|r")
    call BlzFrameSetText(WosCareerStats___WCS_DetailPersonal, "|cffffd36bMATCHES|r\n\n|cffffffffGames  " + I2S(games) + "\nWins  " + I2S(wins) + "\nLosses  " + I2S(games - wins) + "|r\n|cffffd36b" + WosCareerStats___WCS_Percent(wins , games) + "|r")
    call BlzFrameSetText(WosCareerStats___WCS_DetailRounds, "|cffffd36bROUNDS|r\n\n|cffffffffWon  " + I2S(roundWins) + "\nLost  " + I2S(roundLosses) + "|r\n|cffffd36b" + WosCareerStats___WCS_Percent(roundWins , roundWins + roundLosses) + "|r")
    if combatGames > 0 then
        call BlzFrameSetText(WosCareerStats___WCS_DetailAverage, "|cffffd36bAVERAGES|r\n\n|cffffffffKills  " + WosCareerStats___WCS_Decimal100(averageKills) + "\nDeaths  " + WosCareerStats___WCS_Decimal100(averageDeaths) + "\nGames  " + I2S(combatGames) + "|r")
        call BlzFrameSetText(WosCareerStats___WCS_DetailBest, "|cffffd36bBEST|r\n\n|cffffffffKills  " + I2S((SaveSystem_GetHeroExtraValue((viewer ) , ( heroId) , 5))) + "\nLow D.  " + I2S((SaveSystem_GetHeroExtraValue((viewer ) , ( heroId) , 6))) + "\nK/D  " + WosCareerStats___WCS_Decimal100((SaveSystem_GetHeroExtraValue((viewer ) , ( heroId) , 7))) + "|r") // INLINED!!
    else
        call BlzFrameSetText(WosCareerStats___WCS_DetailAverage, "|cffffd36bAVERAGES|r\n\n|cff9aa7b4No data|r")
        call BlzFrameSetText(WosCareerStats___WCS_DetailBest, "|cffffd36bBEST|r\n\n|cff9aa7b4No data|r")
    endif
    call WosCareerStats___WCS_UpdateRelations(heroId , viewer)
    loop
        exitwhen slot >= WosCareerStats___WCS_LAST_ITEM_COUNT
        call WosCareerStats___WCS_UpdateLastItem(slot , heroId , viewer)
        set slot=slot + 1
    endloop
    set slot=0
    loop
        exitwhen slot >= WosCareerStats___WCS_BEST_ITEM_COUNT
        call WosCareerStats___WCS_UpdateBestItem(slot , heroId , viewer)
        set slot=slot + 1
    endloop
    set viewer=null
endfunction

function WosCareerStats___WCS_UpdateForPlayer takes integer pid returns nothing
    if pid < 0 or pid >= WosCareerStats___WCS_PLAYER_COUNT or GetLocalPlayer() != Player(pid) then
        return
    endif
    if WosCareerStats___WCS_Page[pid] == 0 then
        call BlzFrameSetText(WosCareerStats___WCS_Title, "|cffffd36bWOS2 CAREER STATISTICS|r")
        call WosCareerStats___WCS_UpdateHome(pid)
    elseif WosCareerStats___WCS_Page[pid] == 1 then
        call WosCareerStats___WCS_UpdateHeroes(pid)
    else
        call WosCareerStats___WCS_UpdateDetail(pid)
    endif
endfunction

function WosCareerStats___WCS_SetOpen takes player viewer,boolean open returns nothing
    local integer pid
    if viewer == null or GetLocalPlayer() != viewer then
        return
    endif
    set pid=GetPlayerId(viewer)
    if pid < 0 or pid >= WosCareerStats___WCS_PLAYER_COUNT then
        return
    endif
    set WosCareerStats___WCS_IsOpen[pid]=open
    if open then
        // Only this client's cumulative profile is read. The loader has no sync
        // native and never exposes its values to gameplay or other players.
        call SaveSystem_LoadLocalPlayer(pid)
        // Keep the last local page. Every frame mutation below is protected by
        // the direct GetLocalPlayer owner check above.
        call WosCareerStats___WCS_SetPage(pid , WosCareerStats___WCS_Page[pid])
        call WosCareerStats___WCS_UpdateForPlayer(pid)
        call BlzFrameSetVisible(WosCareerStats___WCS_Main, true)
    else
        call WosCareerStats___WCS_HideTooltips(pid)
        call BlzFrameSetVisible(WosCareerStats___WCS_Main, false)
    endif
endfunction

function WosCareerStats___WCS_ResetClickedFrame takes nothing returns nothing
    if GetLocalPlayer() == GetTriggerPlayer() then
        call BlzFrameSetEnable(BlzGetTriggerFrame(), false)
        call BlzFrameSetEnable(BlzGetTriggerFrame(), true)
    endif
endfunction

function WosCareerStats___WCS_OnOpen takes nothing returns nothing
    local player viewer= GetTriggerPlayer()
    if GetLocalPlayer() != GetTriggerPlayer() then
        set viewer=null
        return
    endif
    call WosCareerStats___WCS_ResetClickedFrame()
    call WosCareerStats___WCS_SetOpen(viewer , true)
    set viewer=null
endfunction

function WosCareerStats___WCS_OnClose takes nothing returns nothing
    local player viewer= null
    if GetLocalPlayer() != GetTriggerPlayer() then
        return
    endif
    set viewer=GetTriggerPlayer()
    call WosCareerStats___WCS_ResetClickedFrame()
    call WosCareerStats___WCS_SetOpen(viewer , false)
    set viewer=null
endfunction

function WosCareerStats___WCS_OnHome takes nothing returns nothing
    local player viewer= null
    local integer pid= 0
    if GetLocalPlayer() != GetTriggerPlayer() then
        return
    endif
    set viewer=GetTriggerPlayer()
set pid=GetPlayerId(viewer)
    call WosCareerStats___WCS_ResetClickedFrame()
    if pid >= 0 and pid < WosCareerStats___WCS_PLAYER_COUNT then
        call WosCareerStats___WCS_SetPage(pid , 0)
        call WosCareerStats___WCS_UpdateForPlayer(pid)
    endif
    set viewer=null
endfunction

function WosCareerStats___WCS_OnHeroes takes nothing returns nothing
    local player viewer= null
    local integer pid= 0
    local integer heroId= 0
    local integer category
    if GetLocalPlayer() != GetTriggerPlayer() then
        return
    endif
    set viewer=GetTriggerPlayer()
set pid=GetPlayerId(viewer)
    call WosCareerStats___WCS_ResetClickedFrame()
    if pid >= 0 and pid < WosCareerStats___WCS_PLAYER_COUNT then
        if Hero[pid] != null then
            set heroId=GetUnitTypeId(Hero[pid])
            set category=WosCareerStats___WCS_FindHeroCategory(heroId)
            if category > 0 then
                set WosCareerStats___WCS_Category[pid]=category
            else
                set WosCareerStats___WCS_Category[pid]=6
            endif
        endif
        call WosCareerStats___WCS_SetPage(pid , 1)
        call WosCareerStats___WCS_UpdateForPlayer(pid)
    endif
    set viewer=null
endfunction

function WosCareerStats___WCS_OnCategory takes nothing returns nothing
    local player viewer= null
    local integer pid
    local framehandle clicked= null
    local integer category= 1
    if GetLocalPlayer() != GetTriggerPlayer() then
        return
    endif
    set clicked=BlzGetTriggerFrame()
        set viewer=GetTriggerPlayer()
       set pid=GetPlayerId(viewer)
    call WosCareerStats___WCS_ResetClickedFrame()
    if pid >= 0 and pid < WosCareerStats___WCS_PLAYER_COUNT then
        loop
            exitwhen category > WosCareerStats___WCS_CATEGORY_COUNT
            if clicked == WosCareerStats___WCS_CategoryButton[category - 1] then
                set WosCareerStats___WCS_Category[pid]=category
                call WosCareerStats___WCS_SetPage(pid , 1)
                call WosCareerStats___WCS_UpdateForPlayer(pid)
                set category=WosCareerStats___WCS_CATEGORY_COUNT + 1
            else
                set category=category + 1
            endif
        endloop
    endif
    set clicked=null
    set viewer=null
endfunction

function WosCareerStats___WCS_OnHero takes nothing returns nothing
    local player viewer= null
    local integer pid
    local framehandle clicked= null
    local integer slot= 0
    if GetLocalPlayer() != GetTriggerPlayer() then
        return
    endif
        set clicked=BlzGetTriggerFrame()
        set viewer=GetTriggerPlayer()
       set pid=GetPlayerId(viewer)
    call WosCareerStats___WCS_ResetClickedFrame()
    if pid >= 0 and pid < WosCareerStats___WCS_PLAYER_COUNT then
        loop
            exitwhen slot >= WosCareerStats___WCS_HERO_SLOT_COUNT
            if clicked == WosCareerStats___WCS_HeroButton[slot] and WosCareerStats___WCS_VisibleHeroId[slot] != 0 then
                set WosCareerStats___WCS_DetailHeroId[pid]=WosCareerStats___WCS_VisibleHeroId[slot]
                call WosCareerStats___WCS_SetPage(pid , 2)
                call WosCareerStats___WCS_UpdateForPlayer(pid)
                set slot=WosCareerStats___WCS_HERO_SLOT_COUNT
            else
                set slot=slot + 1
            endif
        endloop
    endif
    set clicked=null
    set viewer=null
endfunction

function WosCareerStats___WCS_OnHotkey takes nothing returns nothing
    local player viewer= GetTriggerPlayer()
    local integer pid= GetPlayerId(viewer)
    // The key event itself is local; this handler changes UI state only.
    if GetLocalPlayer() != GetTriggerPlayer() then
        set viewer=null
        return
    endif
    if pid >= 0 and pid < WosCareerStats___WCS_PLAYER_COUNT then
        call WosCareerStats___WCS_SetOpen(viewer , not WosCareerStats___WCS_IsOpen[pid])
    endif
    set viewer=null
endfunction

function WosCareerStats___WCS_CreateHomePage takes nothing returns nothing
    call WosCareerStats___WCS_CreateBackdrop(WosCareerStats___WCS_HomePage , 0.315 , 0.310 , 0.140 , 0.170 , 125 , 8300)
    call WosCareerStats___WCS_CreateBackdrop(WosCareerStats___WCS_HomePage , 0.475 , 0.310 , 0.155 , 0.170 , 125 , 8301)
    set WosCareerStats___WCS_HomeOverall=WosCareerStats___WCS_CreateText(WosCareerStats___WCS_HomePage , 0.315 , 0.310 , 0.133 , 0.162 , 0.90 , TEXT_JUSTIFY_CENTER , "" , 8310)
    set WosCareerStats___WCS_HomeHero=WosCareerStats___WCS_CreateText(WosCareerStats___WCS_HomePage , 0.475 , 0.310 , 0.148 , 0.162 , 0.86 , TEXT_JUSTIFY_CENTER , "" , 8311)
endfunction

function WosCareerStats___WCS_CreateHeroesPage takes nothing returns nothing
    local integer category= 0
    local integer slot= 0
    local integer row
    local integer column
    local real x
    local real y
    local framehandle tooltipText
    loop
        exitwhen category >= WosCareerStats___WCS_CATEGORY_COUNT
        set x=0.264
        set y=0.390 - I2R(category) * 0.036
        set WosCareerStats___WCS_CategoryButton[category]=WosCareerStats___WCS_CreateIconButton(WosCareerStats___WCS_HeroesPage , x , y , 0.025 , 8400 + category)
        call BlzFrameSetSize(WosCareerStats___WCS_CategoryButton[category], 0.055, 0.027)
        set WosCareerStats___WCS_CategoryIcon[category]=WosCareerStats___WCS_CreateIcon(WosCareerStats___WCS_CategoryButton[category] , WosCareerStats___WCS_CategoryTexture(category + 1) , 8410 + category)
        set tooltipText=WosCareerStats___WCS_CreateTooltip(WosCareerStats___WCS_CategoryButton[category] , 0.130 , 0.026 , 8420 + category)
        set WosCareerStats___WCS_CategoryTooltip[category]=WosCareerStats___WCS_LastCreatedTooltip
        call BlzFrameSetText(tooltipText, "|cffffffff" + WosCareerStats___WCS_CategoryName(category + 1) + "|r")
        call BlzTriggerRegisterFrameEvent(WosCareerStats___WCS_CategoryTrigger, WosCareerStats___WCS_CategoryButton[category], FRAMEEVENT_CONTROL_CLICK)
        set category=category + 1
    endloop
    loop
        exitwhen slot >= WosCareerStats___WCS_HERO_SLOT_COUNT
        set row=slot / WosCareerStats___WCS_HERO_COLUMN_COUNT
        set column=ModuloInteger(slot, WosCareerStats___WCS_HERO_COLUMN_COUNT)
        set x=0.306 + I2R(column) * 0.047
        set y=0.390 - I2R(row) * 0.043
        set WosCareerStats___WCS_HeroButton[slot]=WosCareerStats___WCS_CreateIconButton(WosCareerStats___WCS_HeroesPage , x , y + 0.004 , 0.028 , 9100 + slot)
        set WosCareerStats___WCS_HeroIcon[slot]=WosCareerStats___WCS_CreateIcon(WosCareerStats___WCS_HeroButton[slot] , WosCareerStats___WCS_TEX_EMPTY , 9200 + slot)
        set WosCareerStats___WCS_HeroName[slot]=WosCareerStats___WCS_CreateText(WosCareerStats___WCS_HeroesPage , x , y - 0.016 , 0.045 , 0.011 , 0.56 , TEXT_JUSTIFY_CENTER , "" , 9300 + slot)
        set WosCareerStats___WCS_HeroTooltipText[slot]=WosCareerStats___WCS_CreateTooltip(WosCareerStats___WCS_HeroButton[slot] , 0.160 , 0.055 , 9400 + slot)
        set WosCareerStats___WCS_HeroTooltip[slot]=WosCareerStats___WCS_LastCreatedTooltip
        call BlzTriggerRegisterFrameEvent(WosCareerStats___WCS_HeroTrigger, WosCareerStats___WCS_HeroButton[slot], FRAMEEVENT_CONTROL_CLICK)
        set slot=slot + 1
    endloop
    set tooltipText=null
endfunction

function WosCareerStats___WCS_CreateDetailPage takes nothing returns nothing
    local integer relationType= 0
    local integer slot= 0
    local integer index
    local real x
    local real y
    local framehandle tooltipText
    call WosCareerStats___WCS_CreateBackdrop(WosCareerStats___WCS_DetailPage , 0.400 , 0.325 , 0.325 , 0.132 , 150 , 8700)
    call WosCareerStats___WCS_CreateBackdrop(WosCareerStats___WCS_DetailPage , 0.315 , 0.221 , 0.155 , 0.062 , 155 , 8701)
    call WosCareerStats___WCS_CreateBackdrop(WosCareerStats___WCS_DetailPage , 0.485 , 0.221 , 0.155 , 0.062 , 155 , 8702)
    set WosCareerStats___WCS_DetailHeroIcon=BlzCreateFrameByType("BACKDROP", "WcsDetailHeroIcon", WosCareerStats___WCS_DetailPage, "", 8710)
    call BlzFrameSetAbsPoint(WosCareerStats___WCS_DetailHeroIcon, FRAMEPOINT_CENTER, 0.255, 0.398)
    call BlzFrameSetSize(WosCareerStats___WCS_DetailHeroIcon, 0.036, 0.036)
    set WosCareerStats___WCS_DetailHeroName=WosCareerStats___WCS_CreateText(WosCareerStats___WCS_DetailPage , 0.385 , 0.399 , 0.210 , 0.030 , 0.94 , TEXT_JUSTIFY_CENTER , "" , 8711)
    set WosCareerStats___WCS_DetailPersonal=WosCareerStats___WCS_CreateText(WosCareerStats___WCS_DetailPage , 0.260 , 0.326 , 0.058 , 0.106 , 0.48 , TEXT_JUSTIFY_CENTER , "" , 8720)
    set WosCareerStats___WCS_DetailRounds=WosCareerStats___WCS_CreateText(WosCareerStats___WCS_DetailPage , 0.322 , 0.326 , 0.058 , 0.106 , 0.48 , TEXT_JUSTIFY_CENTER , "" , 8721)
    set WosCareerStats___WCS_DetailAverage=WosCareerStats___WCS_CreateText(WosCareerStats___WCS_DetailPage , 0.384 , 0.326 , 0.058 , 0.106 , 0.48 , TEXT_JUSTIFY_CENTER , "" , 8722)
    set WosCareerStats___WCS_DetailBest=WosCareerStats___WCS_CreateText(WosCareerStats___WCS_DetailPage , 0.446 , 0.326 , 0.058 , 0.106 , 0.48 , TEXT_JUSTIFY_CENTER , "" , 8723)
    call BlzFrameSetTextAlignment(WosCareerStats___WCS_DetailPersonal, TEXT_JUSTIFY_TOP, TEXT_JUSTIFY_CENTER)
    call BlzFrameSetTextAlignment(WosCareerStats___WCS_DetailRounds, TEXT_JUSTIFY_TOP, TEXT_JUSTIFY_CENTER)
    call BlzFrameSetTextAlignment(WosCareerStats___WCS_DetailAverage, TEXT_JUSTIFY_TOP, TEXT_JUSTIFY_CENTER)
    call BlzFrameSetTextAlignment(WosCareerStats___WCS_DetailBest, TEXT_JUSTIFY_TOP, TEXT_JUSTIFY_CENTER)
    loop
        exitwhen relationType >= WosCareerStats___WCS_RELATION_ROW_COUNT
        set y=0.378 - I2R(relationType) * 0.032
        set WosCareerStats___WCS_RelationTitle[relationType]=WosCareerStats___WCS_CreateText(WosCareerStats___WCS_DetailPage , 0.520 , y , 0.088 , 0.010 , 0.38 , TEXT_JUSTIFY_CENTER , "|cffffd36b" + WosCareerStats___WCS_RelationName(relationType) + "|r" , 8730 + relationType)
        set slot=0
        loop
            exitwhen slot >= WosCareerStats___WCS_RELATION_SLOT_COUNT
            set index=relationType * WosCareerStats___WCS_RELATION_SLOT_COUNT + slot
            set x=0.492 + I2R(slot) * 0.014
            set WosCareerStats___WCS_RelationButton[index]=WosCareerStats___WCS_CreateIconButton(WosCareerStats___WCS_DetailPage , x , y - 0.015 , 0.012 , 8740 + index)
            set WosCareerStats___WCS_RelationIcon[index]=WosCareerStats___WCS_CreateIcon(WosCareerStats___WCS_RelationButton[index] , WosCareerStats___WCS_TEX_EMPTY , 8770 + index)
            set tooltipText=WosCareerStats___WCS_CreateTooltip(WosCareerStats___WCS_RelationButton[index] , 0.145 , 0.043 , 8800 + index)
            set WosCareerStats___WCS_RelationTooltipText[index]=tooltipText
            set WosCareerStats___WCS_RelationTooltip[index]=WosCareerStats___WCS_LastCreatedTooltip
            call BlzFrameSetScale(tooltipText, 0.66)
            set slot=slot + 1
        endloop
        set relationType=relationType + 1
    endloop
    set WosCareerStats___WCS_DetailLastTitle=WosCareerStats___WCS_CreateText(WosCareerStats___WCS_DetailPage , 0.315 , 0.245 , 0.145 , 0.012 , 0.58 , TEXT_JUSTIFY_CENTER , "|cffffd36bLAST MATCH BUILD|r" , 8900)
    set slot=0
    loop
        exitwhen slot >= WosCareerStats___WCS_LAST_ITEM_COUNT
        set x=0.259 + I2R(slot) * 0.0224
        set WosCareerStats___WCS_LastItemButton[slot]=WosCareerStats___WCS_CreateIconButton(WosCareerStats___WCS_DetailPage , x , 0.220 , 0.019 , 8910 + slot)
        set WosCareerStats___WCS_LastItemIcon[slot]=WosCareerStats___WCS_CreateIcon(WosCareerStats___WCS_LastItemButton[slot] , WosCareerStats___WCS_TEX_EMPTY , 8920 + slot)
        set WosCareerStats___WCS_LastItemText[slot]=WosCareerStats___WCS_CreateText(WosCareerStats___WCS_DetailPage , x , 0.198 , 0.023 , 0.012 , 0.50 , TEXT_JUSTIFY_CENTER , "" , 8930 + slot)
        set tooltipText=WosCareerStats___WCS_CreateTooltip(WosCareerStats___WCS_LastItemButton[slot] , 0.205 , 0.058 , 8940 + slot)
        set WosCareerStats___WCS_LastItemTooltipText[slot]=tooltipText
        set WosCareerStats___WCS_LastItemTooltip[slot]=WosCareerStats___WCS_LastCreatedTooltip
        call BlzFrameSetScale(tooltipText, 0.61)
        set slot=slot + 1
    endloop
    set WosCareerStats___WCS_DetailBestItemsTitle=WosCareerStats___WCS_CreateText(WosCareerStats___WCS_DetailPage , 0.485 , 0.245 , 0.145 , 0.012 , 0.58 , TEXT_JUSTIFY_CENTER , "|cffffd36bBEST WIN RATE|r" , 8950)
    set slot=0
    loop
        exitwhen slot >= WosCareerStats___WCS_BEST_ITEM_COUNT
        set x=0.429 + I2R(slot) * 0.0224
        set WosCareerStats___WCS_BestItemButton[slot]=WosCareerStats___WCS_CreateIconButton(WosCareerStats___WCS_DetailPage , x , 0.220 , 0.019 , 8960 + slot)
        set WosCareerStats___WCS_BestItemIcon[slot]=WosCareerStats___WCS_CreateIcon(WosCareerStats___WCS_BestItemButton[slot] , WosCareerStats___WCS_TEX_EMPTY , 8980 + slot)
        set WosCareerStats___WCS_BestItemText[slot]=WosCareerStats___WCS_CreateText(WosCareerStats___WCS_DetailPage , x , 0.197 , 0.024 , 0.016 , 0.42 , TEXT_JUSTIFY_CENTER , "" , 9000 + slot)
        set tooltipText=WosCareerStats___WCS_CreateTooltip(WosCareerStats___WCS_BestItemButton[slot] , 0.205 , 0.058 , 9020 + slot)
        set WosCareerStats___WCS_BestItemTooltipText[slot]=tooltipText
        set WosCareerStats___WCS_BestItemTooltip[slot]=WosCareerStats___WCS_LastCreatedTooltip
        call BlzFrameSetScale(tooltipText, 0.61)
        set slot=slot + 1
    endloop
    set tooltipText=null
endfunction

function WosCareerStats___WCS_CreateUI takes nothing returns nothing
    local framehandle gameUI= BlzGetFrameByName("ConsoleUIBackdrop", 0)
    local integer pid= 0
    set WosCareerStats___WCS_OpenButton=WosCareerStats___WCS_CreateIconButton(gameUI , WosCareerStats___WCS_OPEN_X , WosCareerStats___WCS_OPEN_Y , WosCareerStats___WCS_OPEN_SIZE , 8200)
    set WosCareerStats___WCS_OpenIcon=WosCareerStats___WCS_CreateIcon(WosCareerStats___WCS_OpenButton , WosCareerStats___WCS_TEX_OPEN , 8201)
    call BlzFrameSetVisible(WosCareerStats___WCS_OpenButton, false)
    call BlzFrameSetLevel(WosCareerStats___WCS_OpenButton, 100)
    call BlzFrameSetLevel(WosCareerStats___WCS_OpenIcon, 101)

    set WosCareerStats___WCS_Main=BlzCreateFrame("ListBoxWar3", gameUI, 0, 8210)
    call BlzFrameSetAbsPoint(WosCareerStats___WCS_Main, FRAMEPOINT_CENTER, WosCareerStats___WCS_PANEL_X, WosCareerStats___WCS_PANEL_Y)
    call BlzFrameSetSize(WosCareerStats___WCS_Main, WosCareerStats___WCS_PANEL_WIDTH, WosCareerStats___WCS_PANEL_HEIGHT)
    // КРИТИЧНО: панель изначально всегда скрыта.
call BlzFrameSetVisible(WosCareerStats___WCS_Main, false)
    set WosCareerStats___WCS_Title=WosCareerStats___WCS_CreateText(WosCareerStats___WCS_Main , 0.445 , 0.436 , 0.160 , 0.018 , 0.76 , TEXT_JUSTIFY_CENTER , "|cffffd36bWOS2 CAREER STATISTICS|r" , 8211)

    set WosCareerStats___WCS_CloseButton=WosCareerStats___WCS_CreateIconButton(WosCareerStats___WCS_Main , 0.560 , 0.438 , 0.012 , 8212)
    set WosCareerStats___WCS_CloseIcon=WosCareerStats___WCS_CreateIcon(WosCareerStats___WCS_CloseButton , WosCareerStats___WCS_TEX_CLOSE , 8213)
    set WosCareerStats___WCS_HomeButton=WosCareerStats___WCS_CreateTextButton(WosCareerStats___WCS_Main , 0.258 , 0.430 , 0.064 , 0.024 , "HOME" , 8214)
    set WosCareerStats___WCS_HeroesButton=WosCareerStats___WCS_CreateTextButton(WosCareerStats___WCS_Main , 0.334 , 0.430 , 0.078 , 0.024 , "HEROES" , 8216)
    set WosCareerStats___WCS_HomePage=BlzCreateFrameByType("FRAME", "WcsHomePage", WosCareerStats___WCS_Main, "", 8230)
    set WosCareerStats___WCS_HeroesPage=BlzCreateFrameByType("FRAME", "WcsHeroesPage", WosCareerStats___WCS_Main, "", 8231)
    set WosCareerStats___WCS_DetailPage=BlzCreateFrameByType("FRAME", "WcsDetailPage", WosCareerStats___WCS_Main, "", 8232)
    call BlzFrameSetAllPoints(WosCareerStats___WCS_HomePage, WosCareerStats___WCS_Main)
    call BlzFrameSetAllPoints(WosCareerStats___WCS_HeroesPage, WosCareerStats___WCS_Main)
    call BlzFrameSetAllPoints(WosCareerStats___WCS_DetailPage, WosCareerStats___WCS_Main)
    call BlzFrameSetLevel(WosCareerStats___WCS_HomePage, 1)
    call BlzFrameSetLevel(WosCareerStats___WCS_HeroesPage, 1)
    call BlzFrameSetLevel(WosCareerStats___WCS_DetailPage, 1)

    // Navigation is deliberately above every page container so pages cannot
    // intercept HOME, HEROES, or CLOSE mouse events.
    call BlzFrameSetLevel(WosCareerStats___WCS_Title, 90)
    call BlzFrameSetLevel(WosCareerStats___WCS_HomeButton, 100)
    call BlzFrameSetLevel(WosCareerStats___WCS_HeroesButton, 100)
    call BlzFrameSetLevel(WosCareerStats___WCS_CloseButton, 100)
    call BlzFrameSetLevel(WosCareerStats___WCS_CloseIcon, 101)

    set WosCareerStats___WCS_OpenTrigger=CreateTrigger()
    set WosCareerStats___WCS_CloseTrigger=CreateTrigger()
    set WosCareerStats___WCS_HomeTrigger=CreateTrigger()
    set WosCareerStats___WCS_HeroesTrigger=CreateTrigger()
    set WosCareerStats___WCS_CategoryTrigger=CreateTrigger()
    set WosCareerStats___WCS_HeroTrigger=CreateTrigger()
    set WosCareerStats___WCS_HotkeyTrigger=CreateTrigger()
    call BlzTriggerRegisterFrameEvent(WosCareerStats___WCS_OpenTrigger, WosCareerStats___WCS_OpenButton, FRAMEEVENT_CONTROL_CLICK)
    call BlzTriggerRegisterFrameEvent(WosCareerStats___WCS_CloseTrigger, WosCareerStats___WCS_CloseButton, FRAMEEVENT_CONTROL_CLICK)
    call BlzTriggerRegisterFrameEvent(WosCareerStats___WCS_HomeTrigger, WosCareerStats___WCS_HomeButton, FRAMEEVENT_CONTROL_CLICK)
    call BlzTriggerRegisterFrameEvent(WosCareerStats___WCS_HeroesTrigger, WosCareerStats___WCS_HeroesButton, FRAMEEVENT_CONTROL_CLICK)
    call TriggerAddAction(WosCareerStats___WCS_OpenTrigger, function WosCareerStats___WCS_OnOpen)
    call TriggerAddAction(WosCareerStats___WCS_CloseTrigger, function WosCareerStats___WCS_OnClose)
    call TriggerAddAction(WosCareerStats___WCS_HomeTrigger, function WosCareerStats___WCS_OnHome)
    call TriggerAddAction(WosCareerStats___WCS_HeroesTrigger, function WosCareerStats___WCS_OnHeroes)
    call TriggerAddAction(WosCareerStats___WCS_CategoryTrigger, function WosCareerStats___WCS_OnCategory)
    call TriggerAddAction(WosCareerStats___WCS_HeroTrigger, function WosCareerStats___WCS_OnHero)
    call TriggerAddAction(WosCareerStats___WCS_HotkeyTrigger, function WosCareerStats___WCS_OnHotkey)

    call WosCareerStats___WCS_CreateHomePage()
    call WosCareerStats___WCS_CreateHeroesPage()
    call WosCareerStats___WCS_CreateDetailPage()
    loop
        exitwhen pid >= WosCareerStats___WCS_PLAYER_COUNT
        call BlzTriggerRegisterPlayerKeyEvent(WosCareerStats___WCS_HotkeyTrigger, Player(pid), OSKEY_F5, 0, false)
        set WosCareerStats___WCS_Page[pid]=0
        set WosCareerStats___WCS_Category[pid]=1
        set WosCareerStats___WCS_DetailHeroId[pid]=0
        set WosCareerStats___WCS_IsOpen[pid]=false
        set pid=pid + 1
    endloop
    // Initial visibility is also applied per client without storing
    // GetLocalPlayer() in any variable.
    set pid=0
    loop
        exitwhen pid >= WosCareerStats___WCS_PLAYER_COUNT
        if GetLocalPlayer() == Player(pid) then
            if GetPlayerId(GetLocalPlayer()) < WosCareerStats___WCS_PLAYER_COUNT then
    call BlzFrameSetVisible(WosCareerStats___WCS_OpenButton, true)
else

    call BlzFrameSetVisible(WosCareerStats___WCS_OpenButton, false)
    call BlzFrameSetVisible(WosCareerStats___WCS_Main, false)
endif
        endif
        set pid=pid + 1
    endloop
    set gameUI=null
endfunction

function WosCareerStats___WCS_DelayedInit takes nothing returns nothing
    local timer initTimer= GetExpiredTimer()
    call WosCareerStats___WCS_CreateUI()
    // MyHeroIdInit fills all pages atomically from the map's 1-second trigger.
    // Retry until at least one real ID exists and no pick/ban has written 12.
    set WosCareerStats___WCS_CatalogTimer=CreateTimer()
    call TimerStart(WosCareerStats___WCS_CatalogTimer, 0.10, true, function WosCareerStats___WCS_CatalogTick)
    call DestroyTimer(initTimer)
    set initTimer=null
endfunction

function WosCareerStats___WCS_Init takes nothing returns nothing
    local timer initTimer= CreateTimer()
    call TimerStart(initTimer, 0.00, false, function WosCareerStats___WCS_DelayedInit)
    set initTimer=null
endfunction


//library WosCareerStats ends
//library WosScoreboard:


//===========================================================================
// Форматирование и геометрия
//===========================================================================
function WosScoreboard___WOS_STATS_FormatK takes integer value returns string
    // Одинаковое округление в скорборде и HeroIcon.
    return FormatK(value)
endfunction

function WosScoreboard___WOS_STATS_Pad2 takes integer value returns string
    if value < 10 then
        return "0" + I2S(value)
    endif
    return I2S(value)
endfunction

// The statistics source can briefly underflow while round data is reset.
// Never let that transient value leak into the scoreboard, team total or MVP score.
function WosScoreboard___WOS_STATS_NonNegative takes integer value returns integer
    if value < 0 then
        return 0
    endif
    return value
endfunction

function WosScoreboard___WOS_STATS_PlayerSlotColor takes integer pid,integer alpha returns integer
    if pid == 0 then
        return BlzConvertColor(alpha, 255, 3, 3)
    elseif pid == 1 then
        return BlzConvertColor(alpha, 0, 66, 255)
    elseif pid == 2 then
        return BlzConvertColor(alpha, 28, 230, 185)
    elseif pid == 3 then
        return BlzConvertColor(alpha, 84, 0, 129)
    elseif pid == 4 then
        return BlzConvertColor(alpha, 255, 252, 1)
    elseif pid == 5 then
        return BlzConvertColor(alpha, 254, 138, 14)
    elseif pid == 6 then
        return BlzConvertColor(alpha, 32, 192, 0)
    elseif pid == 7 then
        return BlzConvertColor(alpha, 229, 91, 176)
    elseif pid == 8 then
        return BlzConvertColor(alpha, 149, 150, 151)
    endif
    return BlzConvertColor(alpha, 126, 191, 241)
endfunction

function WosScoreboard___WOS_STATS_GameTime takes nothing returns string
    if FRAME_GameTimerHour > 0 then
        return I2S(FRAME_GameTimerHour) + ":" + WosScoreboard___WOS_STATS_Pad2(FRAME_GameTimerMin) + ":" + WosScoreboard___WOS_STATS_Pad2(FRAME_GameTimerSec)
    endif
    return WosScoreboard___WOS_STATS_Pad2(FRAME_GameTimerMin) + ":" + WosScoreboard___WOS_STATS_Pad2(FRAME_GameTimerSec)
endfunction

function WosScoreboard___WOS_STATS_Percent takes integer part,integer total returns string
    if total <= 0 then
        return "0.0%"
    endif
    return R2SW(100.00 * I2R(part) / I2R(total), 0, 1) + "%"
endfunction

function WosScoreboard___WOS_STATS_OneLine takes string value returns string
    local integer index= 0
    local integer length= StringLength(value)
    local string result= ""

    loop
        exitwhen index >= length
        if index + 2 <= length and SubString(value, index, index + 2) == "|n" then
            set index=index + 2
        else
            set result=result + SubString(value, index, index + 1)
            set index=index + 1
        endif
    endloop
    return result
endfunction

function WosScoreboard___WOS_STATS_ColumnX takes integer column returns real
    if column == 0 then
        return 0.340
    elseif column == 1 then
        return 0.365
    elseif column == 2 then
        return 0.405
    elseif column == 3 then
        return 0.455
    endif
    return 0.490
endfunction

function WosScoreboard___WOS_STATS_ColumnWidth takes integer column returns real
    if column == 0 then
        return 0.055
    elseif column == 1 then
        return 0.038
    elseif column == 2 then
        return 0.052
    elseif column == 3 then
        return 0.042
    endif
    return 0.042
endfunction

// Семь отдельных статистических колонок подробного режима:
// Kills, Deaths, Physical/Magical Dealt, Heal, Physical/Magical Taken.
function WosScoreboard___WOS_STATS_ExpandedColumnX takes integer column returns real
    if column == 0 then
        return 0.230
    elseif column == 1 then
        return 0.275
    elseif column == 2 then
        return 0.335
    elseif column == 3 then
        return 0.395
    elseif column == 4 then
        return 0.450
    elseif column == 5 then
        return 0.515
    endif
    return 0.575
endfunction

function WosScoreboard___WOS_STATS_ExpandedColumnWidth takes integer column returns real
    if column == 0 or column == 1 then
        return 0.040
    elseif column == 4 then
        return 0.045
    endif
    return 0.055
endfunction

function WosScoreboard___WOS_STATS_RowY takes integer row returns real
    if row < WosScoreboard___WOS_STATS_TEAM_SIZE then
        return 0.428 - I2R(row) * WosScoreboard___WOS_STATS_ROW_STEP
    endif
    return 0.313 - I2R(row - WosScoreboard___WOS_STATS_TEAM_SIZE) * WosScoreboard___WOS_STATS_ROW_STEP
endfunction

// Возвращает pid из сохранённых Captain-составов без запасных подстановок.
function WosScoreboard___WOS_STATS_GetCaptainPidForRowRaw takes integer row returns integer
    local integer teamSlot

    if row < 0 or row >= WosScoreboard___WOS_STATS_PLAYER_COUNT then
        return - 1
    endif
    if row < WosScoreboard___WOS_STATS_TEAM_SIZE then
        if row < FullTeam1Size then
            return FullTeam1[row]
        endif
        return - 1
    endif
    set teamSlot=row - WosScoreboard___WOS_STATS_TEAM_SIZE
    if teamSlot < FullTeam2Size then
        return FullTeam2[teamSlot]
    endif
    return - 1
endfunction

// Один pid разрешён только в первой найденной строке. Это защищает табло,
// даже если внешняя логика состава временно записала игрока повторно.
function WosScoreboard___WOS_STATS_IsCaptainPidUsedBeforeRow takes integer pid,integer row returns boolean
    local integer previousRow= 0

    loop
        exitwhen previousRow >= row
        if WosScoreboard___WOS_STATS_GetCaptainPidForRowRaw(previousRow) == pid then
            return true
        endif
        set previousRow=previousRow + 1
    endloop
    return false
endfunction

// Проверяет, присутствует ли игрок хотя бы в одной сохранённой команде.
// Такой pid нельзя повторно показывать как запасной номер пустой строки.
function WosScoreboard___WOS_STATS_IsCaptainPidSaved takes integer pid returns boolean
    local integer row= 0

    loop
        exitwhen row >= WosScoreboard___WOS_STATS_PLAYER_COUNT
        if WosScoreboard___WOS_STATS_GetCaptainPidForRowRaw(row) == pid then
            return true
        endif
        set row=row + 1
    endloop
    return false
endfunction

function WosScoreboard___WOS_STATS_GetPidForRow takes integer row returns integer
    local integer pid

    if CaptainMode then
        // После окончания матча CapPickPhase может быть уже сброшен, но
        // финальная таблица всё равно должна брать сохранённые составы команд.
        if CapPickPhase < 4 and END1 == 0 then
            return - 1
        endif
        set pid=WosScoreboard___WOS_STATS_GetCaptainPidForRowRaw(row)
        if pid < 0 or pid >= WosScoreboard___WOS_STATS_PLAYER_COUNT then
            return - 1
        endif
        if WosScoreboard___WOS_STATS_IsCaptainPidUsedBeforeRow(pid , row) then
            return - 1
        endif
        return pid
    endif
    return row
endfunction

// После формирования составов запасной pid разрешён только игрокам, которых
// вообще нет в сохранённых командах. Поэтому неактивные игроки остаются
// видимыми, но уже назначенный игрок не может появиться второй раз.
function WosScoreboard___WOS_STATS_GetDisplayPidForRow takes integer row returns integer
    local integer pid= WosScoreboard___WOS_STATS_GetPidForRow(row)

    if pid < 0 and WOS_STATS_SHOW_INACTIVE_PLAYERS then
        if not CaptainMode or ( CapPickPhase < 4 and END1 == 0 ) then
            return row
        endif
        if not WosScoreboard___WOS_STATS_IsCaptainPidSaved(row) then
            return row
        endif
    endif
    return pid
endfunction

function WosScoreboard___WOS_STATS_ShouldDisplayPid takes integer pid returns boolean
    if pid < 0 or pid >= WosScoreboard___WOS_STATS_PLAYER_COUNT then
        return false
    endif
    if WOS_STATS_SHOW_INACTIVE_PLAYERS then
        return true
    endif
    return Hero[pid] != null and GetPlayerSlotState(Player(pid)) == PLAYER_SLOT_STATE_PLAYING
endfunction

//===========================================================================
// Единый масштаб интерфейса
// X масштабируется относительно центра экрана, Y — относительно верхнего
// края панели. Поэтому увеличение не уводит верхнюю рамку за предел экрана.
//===========================================================================
function WosScoreboard___WOS_STATS_GetUIScale takes nothing returns real
    if WOS_STATS_UI_SCALE < 0.50 then
        return 0.50
    elseif WOS_STATS_UI_SCALE > 1.50 then
        return 1.50
    endif
    return WOS_STATS_UI_SCALE
endfunction

function WosScoreboard___WOS_STATS_ScaleX takes real x returns real
    return WosScoreboard___WOS_STATS_PANEL_X + ( x - WosScoreboard___WOS_STATS_PANEL_X ) * WosScoreboard___WOS_STATS_GetUIScale()
endfunction

function WosScoreboard___WOS_STATS_ScaleY takes real y returns real
    return WosScoreboard___WOS_STATS_PANEL_TOP - ( WosScoreboard___WOS_STATS_PANEL_TOP - y ) * WosScoreboard___WOS_STATS_GetUIScale()
endfunction

function WosScoreboard___WOS_STATS_ScaleSize takes real value returns real
    return value * WosScoreboard___WOS_STATS_GetUIScale()
endfunction

function WosScoreboard___WOS_STATS_CreateText takes framehandle parent,real x,real y,real width,real height,real scale,textaligntype horizontal,string value,integer context returns framehandle
    local framehandle textFrame= BlzCreateFrameByType("TEXT", "WosStatsText", parent, "", context)

    call BlzFrameSetAbsPoint(textFrame, FRAMEPOINT_CENTER, (WosScoreboard___WOS_STATS_PANEL_X + ( ((x)*1.0) - WosScoreboard___WOS_STATS_PANEL_X ) * WosScoreboard___WOS_STATS_GetUIScale()), (WosScoreboard___WOS_STATS_PANEL_TOP - ( WosScoreboard___WOS_STATS_PANEL_TOP - ((y)*1.0) ) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
    call BlzFrameSetSize(textFrame, (((width)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((height)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
    call BlzFrameSetTextAlignment(textFrame, TEXT_JUSTIFY_MIDDLE, horizontal)
    call BlzFrameSetScale(textFrame, scale * WosScoreboard___WOS_STATS_GetUIScale())
    call BlzFrameSetText(textFrame, value)
    return textFrame
endfunction

function WosScoreboard___WOS_STATS_CreateBackdrop takes framehandle parent,string texture,real x,real y,real width,real height,integer alpha,integer context returns framehandle
    local framehandle back= BlzCreateFrameByType("BACKDROP", "WosStatsBackdrop", parent, "", context)

    call BlzFrameSetAbsPoint(back, FRAMEPOINT_CENTER, (WosScoreboard___WOS_STATS_PANEL_X + ( ((x)*1.0) - WosScoreboard___WOS_STATS_PANEL_X ) * WosScoreboard___WOS_STATS_GetUIScale()), (WosScoreboard___WOS_STATS_PANEL_TOP - ( WosScoreboard___WOS_STATS_PANEL_TOP - ((y)*1.0) ) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
    call BlzFrameSetSize(back, (((width)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((height)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
    call BlzFrameSetTexture(back, texture, 0, true)
    call BlzFrameSetAlpha(back, alpha)
    return back
endfunction

function WosScoreboard___WOS_STATS_CreateHoverArea takes framehandle parent,real x,real y,real width,real height,integer context returns framehandle
    local framehandle hover= BlzCreateFrameByType("BUTTON", "WosStatsHoverArea", parent, "", context)

    call BlzFrameSetAbsPoint(hover, FRAMEPOINT_CENTER, (WosScoreboard___WOS_STATS_PANEL_X + ( ((x)*1.0) - WosScoreboard___WOS_STATS_PANEL_X ) * WosScoreboard___WOS_STATS_GetUIScale()), (WosScoreboard___WOS_STATS_PANEL_TOP - ( WosScoreboard___WOS_STATS_PANEL_TOP - ((y)*1.0) ) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
    call BlzFrameSetSize(hover, (((width)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((height)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
    call BlzFrameSetAlpha(hover, 0)
    call BlzFrameSetLevel(hover, 20)
    return hover
endfunction

//===========================================================================
// Подсказки
//===========================================================================
function WosScoreboard___WOS_STATS_VisibleTextLength takes string text returns integer
    local integer index= 0
    local integer length= StringLength(text)
    local integer visibleLength= 0

    loop
        exitwhen index >= length
        if index + 10 <= length and SubString(text, index, index + 2) == "|c" then
            set index=index + 10
        elseif index + 2 <= length and SubString(text, index, index + 2) == "|r" then
            set index=index + 2
        else
            set visibleLength=visibleLength + 1
            set index=index + 1
        endif
    endloop
    return visibleLength
endfunction

function WosScoreboard___WOS_STATS_ResizeItemTooltip takes framehandle tooltipText,string itemName returns nothing
    local framehandle tooltip= BlzFrameGetParent(tooltipText)
    local real width= 0.010 + I2R(WosScoreboard___WOS_STATS_VisibleTextLength(itemName)) * 0.0030

    if width < 0.032 then
        set width=0.032
    elseif width > 0.110 then
        set width=0.110
    endif
    call BlzFrameSetSize(tooltip, (((width)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((0.016)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
    set tooltip=null
endfunction

function WosScoreboard___WOS_STATS_CreateItemTooltip takes framehandle whichFrame,integer index returns nothing
    local framehandle tooltip= BlzCreateFrameByType("BACKDROP", "WosStatsItemTooltip", WosScoreboard___WOS_STATS_Main, "", 5000 + index)
    local framehandle tooltipText= BlzCreateFrameByType("TEXT", "WosStatsItemTooltipText", tooltip, "", 5000 + index)

    call BlzFrameSetPoint(tooltip, FRAMEPOINT_BOTTOM, whichFrame, FRAMEPOINT_TOP, 0.0, (((0.002)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
    call BlzFrameSetSize(tooltip, (((0.040)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((0.016)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
    call BlzFrameSetTexture(tooltip, WosScoreboard___WOS_STATS_TEX_TOOLTIP, 0, true)
    call BlzFrameSetAlpha(tooltip, WosScoreboard___WOS_STATS_TOOLTIP_ALPHA)
    call BlzFrameSetLevel(tooltip, 80)
    call BlzFrameSetAllPoints(tooltipText, tooltip)
    call BlzFrameSetTextAlignment(tooltipText, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
    call BlzFrameSetScale(tooltipText, 0.64 * WosScoreboard___WOS_STATS_GetUIScale())
    call BlzFrameSetText(tooltipText, "")
    call BlzFrameSetVisible(tooltip, false)
    call BlzFrameSetTooltip(whichFrame, tooltip)

    set WosScoreboard___WOS_STATS_ItemTooltip[index]=tooltip
    set WosScoreboard___WOS_STATS_ItemTooltipText[index]=tooltipText
    set tooltip=null
    set tooltipText=null
endfunction

function WosScoreboard___WOS_STATS_CreateCombatTooltip takes framehandle whichFrame,integer index returns nothing
    local framehandle tooltip= BlzCreateFrameByType("BACKDROP", "WosStatsCombatTooltip", WosScoreboard___WOS_STATS_Main, "", 5200 + index)
    local framehandle tooltipText= BlzCreateFrameByType("TEXT", "WosStatsCombatTooltipText", tooltip, "", 5200 + index)

    call BlzFrameSetPoint(tooltip, FRAMEPOINT_BOTTOM, whichFrame, FRAMEPOINT_TOP, 0.0, (((0.002)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
    call BlzFrameSetSize(tooltip, (((0.105)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((0.046)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
    call BlzFrameSetTexture(tooltip, WosScoreboard___WOS_STATS_TEX_TOOLTIP, 0, true)
    call BlzFrameSetAlpha(tooltip, WosScoreboard___WOS_STATS_TOOLTIP_ALPHA)
    call BlzFrameSetLevel(tooltip, 85)
    call BlzFrameSetAllPoints(tooltipText, tooltip)
    call BlzFrameSetTextAlignment(tooltipText, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
    call BlzFrameSetScale(tooltipText, 0.62 * WosScoreboard___WOS_STATS_GetUIScale())
    call BlzFrameSetText(tooltipText, "")
    call BlzFrameSetVisible(tooltip, false)
    call BlzFrameSetTooltip(whichFrame, tooltip)

    set WosScoreboard___WOS_STATS_CombatTooltip[index]=tooltip
    set WosScoreboard___WOS_STATS_CombatTooltipText[index]=tooltipText
    set tooltip=null
    set tooltipText=null
endfunction

function WosScoreboard___WOS_STATS_SetCombatTooltipText takes integer index,string title,integer physical,integer magical returns nothing
    local integer total= physical + magical
    local integer longest= StringLength(title)
    local integer current
    local real width
    local framehandle tooltip= WosScoreboard___WOS_STATS_CombatTooltip[index]
    local string physicalLine= "Physical: " + I2S(physical) + " (" + WosScoreboard___WOS_STATS_Percent(physical , total) + ")"
    local string magicalLine= "Magical: " + I2S(magical) + " (" + WosScoreboard___WOS_STATS_Percent(magical , total) + ")"
    local string totalLine= "Total: " + I2S(total)

    set current=StringLength(physicalLine)
    if current > longest then
        set longest=current
    endif
    set current=StringLength(magicalLine)
    if current > longest then
        set longest=current
    endif
    set current=StringLength(totalLine)
    if current > longest then
        set longest=current
    endif
    set width=0.010 + I2R(longest) * 0.0030
    if width < 0.078 then
        set width=0.078
    elseif width > 0.135 then
        set width=0.135
    endif
    call BlzFrameSetSize(tooltip, (((width)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((0.046)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!

    call BlzFrameSetText(WosScoreboard___WOS_STATS_CombatTooltipText[index], "|cffffd36b" + title + "|r\n|cffff7777Physical: |r" + I2S(physical) + "  |cff9aa7b4(" + WosScoreboard___WOS_STATS_Percent(physical , total) + ")|r\n|cff6fa8ffMagical: |r" + I2S(magical) + "  |cff9aa7b4(" + WosScoreboard___WOS_STATS_Percent(magical , total) + ")|r\n|cffffffffTotal: " + I2S(total) + "|r")
    set tooltip=null
    set physicalLine=null
    set magicalLine=null
    set totalLine=null
endfunction

function WosScoreboard___WOS_STATS_SetDamageTooltip takes integer row,integer physical,integer magical returns nothing
    call WosScoreboard___WOS_STATS_SetCombatTooltipText(row * 2 , "DAMAGE DEALT" , physical , magical)
endfunction

function WosScoreboard___WOS_STATS_SetTakenTooltip takes integer row,integer physical,integer magical returns nothing
    call WosScoreboard___WOS_STATS_SetCombatTooltipText(row * 2 + 1 , "DAMAGE TAKEN" , physical , magical)
endfunction

function WosScoreboard___WOS_STATS_CreateSimpleTooltip takes framehandle whichFrame,string value,real width,real height,integer context returns nothing
    local framehandle tooltip= BlzCreateFrameByType("BACKDROP", "WosStatsSimpleTooltip", WosScoreboard___WOS_STATS_Main, "", context)
    local framehandle tooltipText= BlzCreateFrameByType("TEXT", "WosStatsSimpleTooltipText", tooltip, "", context)

    call BlzFrameSetPoint(tooltip, FRAMEPOINT_BOTTOM, whichFrame, FRAMEPOINT_TOP, 0.0, (((0.002)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
    call BlzFrameSetSize(tooltip, (((width)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((height)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
    call BlzFrameSetTexture(tooltip, WosScoreboard___WOS_STATS_TEX_TOOLTIP, 0, true)
    call BlzFrameSetAlpha(tooltip, WosScoreboard___WOS_STATS_TOOLTIP_ALPHA)
    call BlzFrameSetLevel(tooltip, 85)
    call BlzFrameSetAllPoints(tooltipText, tooltip)
    call BlzFrameSetTextAlignment(tooltipText, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
    call BlzFrameSetScale(tooltipText, 0.60 * WosScoreboard___WOS_STATS_GetUIScale())
    call BlzFrameSetText(tooltipText, value)
    call BlzFrameSetVisible(tooltip, false)
    call BlzFrameSetTooltip(whichFrame, tooltip)

    set tooltip=null
    set tooltipText=null
endfunction

//===========================================================================
// MVP
//===========================================================================
// До конца матча игрок видит свои текущие значения без суффикса All,
// а статистику остальных игроков — из накопительных массивов *All.
// После END1 == 1 накопительные значения используются для всех строк.
function WosScoreboard___WOS_STATS_UseAllStats takes integer viewerPid,integer pid returns boolean
    return END1 == 1 or viewerPid != pid
endfunction

function WosScoreboard___WOS_STATS_GetDamagePhysical takes integer viewerPid,integer pid returns integer
    if (END1 == 1 or (viewerPid ) != ( pid)) then // INLINED!!
        return PlayerDamagePhysAll[pid]
    endif
    return PlayerDamagePhys[pid]
endfunction

function WosScoreboard___WOS_STATS_GetDamageMagical takes integer viewerPid,integer pid returns integer
    if (END1 == 1 or (viewerPid ) != ( pid)) then // INLINED!!
        return PlayerDamageMagAll[pid]
    endif
    return PlayerDamageMag[pid]
endfunction

function WosScoreboard___WOS_STATS_GetTakenPhysical takes integer viewerPid,integer pid returns integer
    if (END1 == 1 or (viewerPid ) != ( pid)) then // INLINED!!
        return R2I(PlayerDamageTakenPhysAll[pid])
    endif
    return R2I(PlayerDamageTakenPhys[pid])
endfunction

function WosScoreboard___WOS_STATS_GetTakenMagical takes integer viewerPid,integer pid returns integer
    if (END1 == 1 or (viewerPid ) != ( pid)) then // INLINED!!
        return R2I(PlayerDamageTakenMagAll[pid])
    endif
    return R2I(PlayerDamageTakenMag[pid])
endfunction

function WosScoreboard___WOS_STATS_GetHeal takes integer viewerPid,integer pid returns integer
    if (END1 == 1 or (viewerPid ) != ( pid)) then // INLINED!!
        return WosScoreboard___WOS_STATS_NonNegative(PlayerHealAll[pid])
    endif
    return WosScoreboard___WOS_STATS_NonNegative(PlayerHeal[pid])
endfunction

function WosScoreboard___WOS_STATS_MvpScore takes integer viewerPid,integer pid returns real
    local integer damage= WosScoreboard___WOS_STATS_GetDamagePhysical(viewerPid , pid) + WosScoreboard___WOS_STATS_GetDamageMagical(viewerPid , pid)
    local integer taken= WosScoreboard___WOS_STATS_GetTakenPhysical(viewerPid , pid) + WosScoreboard___WOS_STATS_GetTakenMagical(viewerPid , pid)

    return I2R(PlayerKill[pid]) * WosScoreboard___WOS_STATS_MVP_KILL_WEIGHT - I2R(PlayerDeath[pid]) * WosScoreboard___WOS_STATS_MVP_DEATH_PENALTY + I2R(damage) / WosScoreboard___WOS_STATS_MVP_DAMAGE_DIVISOR + I2R(WosScoreboard___WOS_STATS_GetHeal(viewerPid , pid)) / WosScoreboard___WOS_STATS_MVP_HEAL_DIVISOR + I2R(taken) / WosScoreboard___WOS_STATS_MVP_TAKEN_DIVISOR
endfunction

function WosScoreboard___WOS_STATS_GetMvpPid takes integer viewerPid returns integer
    local integer pid= 0
    local integer bestPid= - 1
    local real score
    local real bestScore= 0.00

    loop
        exitwhen pid >= WosScoreboard___WOS_STATS_PLAYER_COUNT
        if Hero[pid] != null and WosScoreboard___WOS_STATS_ShouldDisplayPid(pid) then
            set score=WosScoreboard___WOS_STATS_MvpScore(viewerPid , pid)
            if score > bestScore then
                set bestScore=score
                set bestPid=pid
            elseif score == bestScore and bestPid >= 0 then
                if PlayerKill[pid] > PlayerKill[bestPid] then
                    set bestPid=pid
                elseif PlayerKill[pid] == PlayerKill[bestPid] and WosScoreboard___WOS_STATS_GetDamagePhysical(viewerPid , pid) + WosScoreboard___WOS_STATS_GetDamageMagical(viewerPid , pid) > WosScoreboard___WOS_STATS_GetDamagePhysical(viewerPid , bestPid) + WosScoreboard___WOS_STATS_GetDamageMagical(viewerPid , bestPid) then
                    set bestPid=pid
                endif
            endif
        endif
        set pid=pid + 1
    endloop
    return bestPid
endfunction

//===========================================================================
// Обновление строк, предметов и итогов
//===========================================================================
function WosScoreboard___WOS_STATS_UpdateItems takes integer row,unit heroUnit returns nothing
    local integer slot= 0
    local integer index
    local integer itemId
    local string itemName
    local item whichItem

    loop
        exitwhen slot >= WosScoreboard___WOS_STATS_ITEM_COUNT
        set index=row * WosScoreboard___WOS_STATS_ITEM_COUNT + slot
        set whichItem=UnitItemInSlot(heroUnit, slot)

        if whichItem == null then
            set itemId=0
            call BlzFrameSetVisible(WosScoreboard___WOS_STATS_ItemButton[index], false)
        else
            set itemId=GetItemTypeId(whichItem)
            call BlzFrameSetVisible(WosScoreboard___WOS_STATS_ItemButton[index], true)
            if WosScoreboard___WOS_STATS_LastItemId[index] != itemId then
                set itemName=GetObjectName(itemId)
                call BlzFrameSetTexture(WosScoreboard___WOS_STATS_ItemIcon[index], BlzGetAbilityIcon(itemId), 0, false)
                call WosScoreboard___WOS_STATS_ResizeItemTooltip(WosScoreboard___WOS_STATS_ItemTooltipText[index] , itemName)
                call BlzFrameSetText(WosScoreboard___WOS_STATS_ItemTooltipText[index], "|cffffffff" + itemName + "|r")
            endif
        endif

        set WosScoreboard___WOS_STATS_LastItemId[index]=itemId
        set whichItem=null
        set slot=slot + 1
    endloop
endfunction

function WosScoreboard___WOS_STATS_ClearItems takes integer row returns nothing
    local integer slot= 0
    local integer index

    loop
        exitwhen slot >= WosScoreboard___WOS_STATS_ITEM_COUNT
        set index=row * WosScoreboard___WOS_STATS_ITEM_COUNT + slot
        set WosScoreboard___WOS_STATS_LastItemId[index]=0
        call BlzFrameSetVisible(WosScoreboard___WOS_STATS_ItemButton[index], false)
        set slot=slot + 1
    endloop
endfunction

function WosScoreboard___WOS_STATS_UpdateRow takes integer row,integer viewerPid,integer mvpPid returns nothing
    local integer pid= WosScoreboard___WOS_STATS_GetDisplayPidForRow(row)
    local integer heroType
    local integer damagePhysical
    local integer damageMagical
    local integer takenPhysical
    local integer takenMagical
    local integer rowAlpha
    local unit heroUnit
    local string heroTexture
    local string playerName
    local boolean playerLeft
    local boolean heroDead
    local boolean expanded= WosScoreboard___WOS_STATS_IsExpanded[viewerPid]
    local boolean opaque= WosScoreboard___WOS_STATS_IsOpaque[viewerPid]

    if not WosScoreboard___WOS_STATS_ShouldDisplayPid(pid) then
        call BlzFrameSetVisible(WosScoreboard___WOS_STATS_RowBack[row], false)
        call BlzFrameSetVisible(WosScoreboard___WOS_STATS_RowContent[row], false)
        call WosScoreboard___WOS_STATS_ClearItems(row)
        set WosScoreboard___WOS_STATS_LastRowPid[row]=- 1
        set WosScoreboard___WOS_STATS_LastHeroType[row]=0
        set WosScoreboard___WOS_STATS_LastHeroDead[row]=false
        return
    endif

    set heroUnit=Hero[pid]
    set damagePhysical=WosScoreboard___WOS_STATS_GetDamagePhysical(viewerPid , pid)
    set damageMagical=WosScoreboard___WOS_STATS_GetDamageMagical(viewerPid , pid)
    set takenPhysical=WosScoreboard___WOS_STATS_GetTakenPhysical(viewerPid , pid)
    set takenMagical=WosScoreboard___WOS_STATS_GetTakenMagical(viewerPid , pid)
    call BlzFrameSetVisible(WosScoreboard___WOS_STATS_RowBack[row], true)
    call BlzFrameSetVisible(WosScoreboard___WOS_STATS_RowContent[row], true)

    if heroUnit == null then
        if WosScoreboard___WOS_STATS_LastRowPid[row] != pid or WosScoreboard___WOS_STATS_LastHeroType[row] != 0 or WosScoreboard___WOS_STATS_LastHeroDead[row] then
            call BlzFrameSetTexture(WosScoreboard___WOS_STATS_HeroIcon[row], WosScoreboard___WOS_STATS_TEX_EMPTY, 0, false)
        endif
        set WosScoreboard___WOS_STATS_LastHeroType[row]=0
        set WosScoreboard___WOS_STATS_LastHeroDead[row]=false
        call WosScoreboard___WOS_STATS_ClearItems(row)
    else
        set heroType=GetUnitTypeId(heroUnit)
        set heroDead=IsUnitType(heroUnit, UNIT_TYPE_DEAD)
        set heroTexture=BlzGetAbilityIcon(heroType)
        if heroDead then
            set heroTexture=ConvertBTNtoDISBTN(heroTexture)
        endif
        if WosScoreboard___WOS_STATS_LastRowPid[row] != pid or WosScoreboard___WOS_STATS_LastHeroType[row] != heroType or WosScoreboard___WOS_STATS_LastHeroDead[row] != heroDead then
            call BlzFrameSetTexture(WosScoreboard___WOS_STATS_HeroIcon[row], heroTexture, 0, false)
            set WosScoreboard___WOS_STATS_LastHeroType[row]=heroType
            set WosScoreboard___WOS_STATS_LastHeroDead[row]=heroDead
        endif
    endif

    set playerName=WosScoreboard___WOS_STATS_OneLine(SplitName(GetPlayerName(Player(pid))))
    if StringLength(playerName) == 0 then
        set playerName="Player " + I2S(pid + 1)
    endif
    // На финальном экране не затемняем строки после Victory/Defeat,
    // поскольку движок уже может пометить игроков как вышедших.
    set playerLeft=GetPlayerSlotState(Player(pid)) != PLAYER_SLOT_STATE_PLAYING and not WosScoreboard___WOS_STATS_IsFinal[viewerPid]

    if pid == mvpPid then
        call BlzFrameSetText(WosScoreboard___WOS_STATS_MvpText[row], "|cffffd36bMVP|r")
    else
        call BlzFrameSetText(WosScoreboard___WOS_STATS_MvpText[row], "")
    endif

    // Р‘РµР»Р°СЏ С‚РµРєСЃС‚СѓСЂР° РѕРєСЂР°С€РёРІР°РµС‚СЃСЏ РІ С†РІРµС‚ СЃР»РѕС‚Р° РІ РѕР±РѕРёС… СЂРµР¶РёРјР°С… С„РѕРЅР°.
    // РњРµРЅСЏРµС‚СЃСЏ С‚РѕР»СЊРєРѕ Р°Р»СЊС„Р°: РЅР° РЅРµРїСЂРѕР·СЂР°С‡РЅРѕРј С„РѕРЅРµ РїРѕР»РѕСЃС‹ РЅР°СЃС‹С‰РµРЅРЅРµРµ.
    // Transparent mode: black strips. Opaque mode: subtle slot-colored strips.
    if opaque then
        call BlzFrameSetTexture(WosScoreboard___WOS_STATS_RowBack[row], WosScoreboard___WOS_STATS_TEX_ROW, 0, true)
        if playerLeft then
            call BlzFrameSetText(WosScoreboard___WOS_STATS_PlayerName[row], "|cff777777" + playerName + "|r")
            set rowAlpha=8
        elseif pid == viewerPid then
            call BlzFrameSetText(WosScoreboard___WOS_STATS_PlayerName[row], "|cffffd36b" + playerName + "|r")
            set rowAlpha=35
        elseif pid == mvpPid then
            call BlzFrameSetText(WosScoreboard___WOS_STATS_PlayerName[row], GetPlayerColorString(Player(pid)) + playerName + "|r")
            set rowAlpha=28
        elseif row - ( row / 2 ) * 2 == 0 then
            call BlzFrameSetText(WosScoreboard___WOS_STATS_PlayerName[row], GetPlayerColorString(Player(pid)) + playerName + "|r")
            set rowAlpha=18
        else
            call BlzFrameSetText(WosScoreboard___WOS_STATS_PlayerName[row], GetPlayerColorString(Player(pid)) + playerName + "|r")
            set rowAlpha=12
        endif
        // В непрозрачном режиме подсветка всегда белая и полупрозрачная.
        // Содержимое строки находится в отдельном слое и не наследует эту alpha.
        call BlzFrameSetVertexColor(WosScoreboard___WOS_STATS_RowBack[row], BlzConvertColor(255, 255, 255, 255))
        call BlzFrameSetAlpha(WosScoreboard___WOS_STATS_RowBack[row], rowAlpha)
    else
        call BlzFrameSetTexture(WosScoreboard___WOS_STATS_RowBack[row], WosScoreboard___WOS_STATS_TEX_PANEL_FILL, 0, true)
        call BlzFrameSetVertexColor(WosScoreboard___WOS_STATS_RowBack[row], BlzConvertColor(255, 255, 255, 255))
        if playerLeft then
            call BlzFrameSetText(WosScoreboard___WOS_STATS_PlayerName[row], "|cff777777" + playerName + "|r")
            call BlzFrameSetAlpha(WosScoreboard___WOS_STATS_RowBack[row], 75)
        elseif pid == viewerPid then
            call BlzFrameSetText(WosScoreboard___WOS_STATS_PlayerName[row], "|cffffd36b" + playerName + "|r")
            call BlzFrameSetAlpha(WosScoreboard___WOS_STATS_RowBack[row], 205)
        elseif pid == mvpPid then
            call BlzFrameSetText(WosScoreboard___WOS_STATS_PlayerName[row], GetPlayerColorString(Player(pid)) + playerName + "|r")
            call BlzFrameSetAlpha(WosScoreboard___WOS_STATS_RowBack[row], 160)
        else
            call BlzFrameSetText(WosScoreboard___WOS_STATS_PlayerName[row], GetPlayerColorString(Player(pid)) + playerName + "|r")
            if row - ( row / 2 ) * 2 == 0 then
                call BlzFrameSetAlpha(WosScoreboard___WOS_STATS_RowBack[row], 128)
            else
                call BlzFrameSetAlpha(WosScoreboard___WOS_STATS_RowBack[row], 92)
            endif
        endif
    endif

    if expanded then
        call BlzFrameSetText(WosScoreboard___WOS_STATS_KillText[row], I2S(PlayerKill[pid]))
        call BlzFrameSetText(WosScoreboard___WOS_STATS_DeathText[row], I2S(PlayerDeath[pid]))
        call BlzFrameSetText(WosScoreboard___WOS_STATS_DamageText[row], (FormatK((damagePhysical)))) // INLINED!!
        call BlzFrameSetText(WosScoreboard___WOS_STATS_DamageMagText[row], (FormatK((damageMagical)))) // INLINED!!
        call BlzFrameSetText(WosScoreboard___WOS_STATS_TakenText[row], (FormatK((takenPhysical)))) // INLINED!!
        call BlzFrameSetText(WosScoreboard___WOS_STATS_TakenMagText[row], (FormatK((takenMagical)))) // INLINED!!
    else
        call BlzFrameSetText(WosScoreboard___WOS_STATS_KillText[row], I2S(PlayerKill[pid]) + " / " + I2S(PlayerDeath[pid]))
        call BlzFrameSetText(WosScoreboard___WOS_STATS_DamageText[row], (FormatK((damagePhysical + damageMagical)))) // INLINED!!
        call BlzFrameSetText(WosScoreboard___WOS_STATS_TakenText[row], (FormatK((takenPhysical + takenMagical)))) // INLINED!!
    endif
    call BlzFrameSetText(WosScoreboard___WOS_STATS_HealText[row], (FormatK((WosScoreboard___WOS_STATS_GetHeal(viewerPid , pid))))) // INLINED!!
    call WosScoreboard___WOS_STATS_SetCombatTooltipText((row ) * 2 , "DAMAGE DEALT" , ( damagePhysical ) , ( damageMagical)) // INLINED!!
    call WosScoreboard___WOS_STATS_SetCombatTooltipText((row ) * 2 + 1 , "DAMAGE TAKEN" , ( takenPhysical ) , ( takenMagical)) // INLINED!!
    if heroUnit != null then
        call WosScoreboard___WOS_STATS_UpdateItems(row , heroUnit)
    endif

    set WosScoreboard___WOS_STATS_LastRowPid[row]=pid
    set heroUnit=null
endfunction

function WosScoreboard___WOS_STATS_UpdateTeamTotal takes integer viewerPid,integer team,boolean expanded returns nothing
    local integer row= team * WosScoreboard___WOS_STATS_TEAM_SIZE
    local integer rowEnd= row + WosScoreboard___WOS_STATS_TEAM_SIZE
    local integer pid
    local integer kills= 0
    local integer deaths= 0
    local integer damagePhysical= 0
    local integer damageMagical= 0
    local integer heal= 0
    local integer takenPhysical= 0
    local integer takenMagical= 0
    local integer base= team * 7

    loop
        exitwhen row >= rowEnd
        set pid=WosScoreboard___WOS_STATS_GetPidForRow(row)
        if WosScoreboard___WOS_STATS_ShouldDisplayPid(pid) then
            if Hero[pid] != null then
                set kills=kills + PlayerKill[pid]
                set deaths=deaths + PlayerDeath[pid]
                set damagePhysical=damagePhysical + WosScoreboard___WOS_STATS_GetDamagePhysical(viewerPid , pid)
                set damageMagical=damageMagical + WosScoreboard___WOS_STATS_GetDamageMagical(viewerPid , pid)
                set heal=heal + WosScoreboard___WOS_STATS_GetHeal(viewerPid , pid)
                set takenPhysical=takenPhysical + WosScoreboard___WOS_STATS_GetTakenPhysical(viewerPid , pid)
                set takenMagical=takenMagical + WosScoreboard___WOS_STATS_GetTakenMagical(viewerPid , pid)
            endif
        endif
        set row=row + 1
    endloop

    if expanded then
        call BlzFrameSetText(WosScoreboard___WOS_STATS_TotalText[base + 0], I2S(kills))
        call BlzFrameSetText(WosScoreboard___WOS_STATS_TotalText[base + 1], I2S(deaths))
        call BlzFrameSetText(WosScoreboard___WOS_STATS_TotalText[base + 2], (FormatK((damagePhysical)))) // INLINED!!
        call BlzFrameSetText(WosScoreboard___WOS_STATS_TotalText[base + 3], (FormatK((damageMagical)))) // INLINED!!
        call BlzFrameSetText(WosScoreboard___WOS_STATS_TotalText[base + 4], (FormatK((heal)))) // INLINED!!
        call BlzFrameSetText(WosScoreboard___WOS_STATS_TotalText[base + 5], (FormatK((takenPhysical)))) // INLINED!!
        call BlzFrameSetText(WosScoreboard___WOS_STATS_TotalText[base + 6], (FormatK((takenMagical)))) // INLINED!!
    else
        call BlzFrameSetText(WosScoreboard___WOS_STATS_TotalText[base + 0], I2S(kills) + " / " + I2S(deaths))
        call BlzFrameSetText(WosScoreboard___WOS_STATS_TotalText[base + 2], (FormatK((damagePhysical + damageMagical)))) // INLINED!!
        call BlzFrameSetText(WosScoreboard___WOS_STATS_TotalText[base + 4], (FormatK((heal)))) // INLINED!!
        call BlzFrameSetText(WosScoreboard___WOS_STATS_TotalText[base + 5], (FormatK((takenPhysical + takenMagical)))) // INLINED!!
    endif
    call WosScoreboard___WOS_STATS_SetCombatTooltipText(20 + team * 2 , "TEAM DAMAGE DEALT" , damagePhysical , damageMagical)
    call WosScoreboard___WOS_STATS_SetCombatTooltipText(21 + team * 2 , "TEAM DAMAGE TAKEN" , takenPhysical , takenMagical)
endfunction

//===========================================================================
// Динамическая плотная раскладка
// Скрытые слоты не оставляют пустые строки, а высота панели меняется под
// фактическое количество героев.
//===========================================================================
function WosScoreboard___WOS_STATS_MoveFrame takes framehandle whichFrame,real x,real y returns nothing
    call BlzFrameClearAllPoints(whichFrame)
    call BlzFrameSetAbsPoint(whichFrame, FRAMEPOINT_CENTER, (WosScoreboard___WOS_STATS_PANEL_X + ( ((x)*1.0) - WosScoreboard___WOS_STATS_PANEL_X ) * WosScoreboard___WOS_STATS_GetUIScale()), (WosScoreboard___WOS_STATS_PANEL_TOP - ( WosScoreboard___WOS_STATS_PANEL_TOP - ((y)*1.0) ) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
endfunction

function WosScoreboard___WOS_STATS_ResizeText takes framehandle whichFrame,real width,real height,real scale returns nothing
    call BlzFrameSetSize(whichFrame, (((width)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((height)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
    call BlzFrameSetScale(whichFrame, scale * WosScoreboard___WOS_STATS_GetUIScale())
endfunction

function WosScoreboard___WOS_STATS_MoveRow takes integer row,real y,boolean expanded returns nothing
    local integer slot= 0
    local integer itemIndex
    local real itemX
    local real itemStep
    local real itemSize
    local real mvpX
    local real heroX
    local real playerX

    call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_RowBack[row] , WosScoreboard___WOS_STATS_PANEL_X , y)
    call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_RowContent[row] , WosScoreboard___WOS_STATS_PANEL_X , y)

    if expanded then
        // В подробном режиме сдвигаем портрет и имя немного вправо,
        // освобождая отдельное место для крупной метки MVP.
        set mvpX=0.073
        set heroX=0.100
        set playerX=0.160
        // Р“СЂСѓРїРїР° РїСЂРµРґРјРµС‚РѕРІ С†РµРЅС‚СЂРёСЂРѕРІР°РЅР° РјРµР¶РґСѓ РїРѕСЃР»РµРґРЅРµР№ СЃС‚Р°С‚РѕР№ Рё РїСЂР°РІС‹Рј РєСЂР°РµРј.
        set itemX=0.621
        set itemStep=0.020
        set itemSize=0.0175
        call BlzFrameSetSize(WosScoreboard___WOS_STATS_RowBack[row], (((WosScoreboard___WOS_STATS_EXPANDED_ROW_WIDTH)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((WosScoreboard___WOS_STATS_EXPANDED_ROW_HEIGHT)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
        call BlzFrameSetSize(WosScoreboard___WOS_STATS_RowContent[row], (((WosScoreboard___WOS_STATS_EXPANDED_ROW_WIDTH)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((WosScoreboard___WOS_STATS_EXPANDED_ROW_HEIGHT)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
        call BlzFrameSetSize(WosScoreboard___WOS_STATS_HeroIcon[row], (((0.021)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((0.021)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_PlayerName[row] , 0.096 , 0.016 , 0.61)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_MvpText[row] , 0.030 , 0.012 , 0.56)
        call BlzFrameSetSize(WosScoreboard___WOS_STATS_MvpHover[row], (((0.032)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((WosScoreboard___WOS_STATS_EXPANDED_ROW_HEIGHT)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_KillText[row] , WosScoreboard___WOS_STATS_ExpandedColumnWidth(0) , 0.017 , 0.76)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_DeathText[row] , WosScoreboard___WOS_STATS_ExpandedColumnWidth(1) , 0.017 , 0.76)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_DamageText[row] , WosScoreboard___WOS_STATS_ExpandedColumnWidth(2) , 0.017 , 0.72)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_DamageMagText[row] , WosScoreboard___WOS_STATS_ExpandedColumnWidth(3) , 0.017 , 0.72)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_HealText[row] , WosScoreboard___WOS_STATS_ExpandedColumnWidth(4) , 0.017 , 0.72)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_TakenText[row] , WosScoreboard___WOS_STATS_ExpandedColumnWidth(5) , 0.017 , 0.70)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_TakenMagText[row] , WosScoreboard___WOS_STATS_ExpandedColumnWidth(6) , 0.017 , 0.70)
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_KillText[row] , WosScoreboard___WOS_STATS_ExpandedColumnX(0) , y)
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_DeathText[row] , WosScoreboard___WOS_STATS_ExpandedColumnX(1) , y)
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_DamageText[row] , WosScoreboard___WOS_STATS_ExpandedColumnX(2) , y)
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_DamageMagText[row] , WosScoreboard___WOS_STATS_ExpandedColumnX(3) , y)
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_HealText[row] , WosScoreboard___WOS_STATS_ExpandedColumnX(4) , y)
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_TakenText[row] , WosScoreboard___WOS_STATS_ExpandedColumnX(5) , y)
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_TakenMagText[row] , WosScoreboard___WOS_STATS_ExpandedColumnX(6) , y)
        call BlzFrameSetVisible(WosScoreboard___WOS_STATS_DeathText[row], true)
        call BlzFrameSetVisible(WosScoreboard___WOS_STATS_DamageMagText[row], true)
        call BlzFrameSetVisible(WosScoreboard___WOS_STATS_TakenMagText[row], true)
        call BlzFrameSetVisible(WosScoreboard___WOS_STATS_DamageHover[row], false)
        call BlzFrameSetVisible(WosScoreboard___WOS_STATS_TakenHover[row], false)
    else
        set mvpX=0.211
        set heroX=0.233
        set playerX=0.275
        // РЎРёРјРјРµС‚СЂРёС‡РЅС‹Р№ Р·Р°РїР°СЃ СЃР»РµРІР° Рё СЃРїСЂР°РІР° РѕС‚ РїРѕР»РЅРѕРіРѕ СЂСЏРґР° РёР· С€РµСЃС‚Рё РїСЂРµРґРјРµС‚РѕРІ.
        set itemX=0.527
        set itemStep=WosScoreboard___WOS_STATS_ITEM_STEP
        set itemSize=WosScoreboard___WOS_STATS_ITEM_ICON_SIZE
        call BlzFrameSetSize(WosScoreboard___WOS_STATS_RowBack[row], (((WosScoreboard___WOS_STATS_ROW_WIDTH)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((WosScoreboard___WOS_STATS_ROW_HEIGHT)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
        call BlzFrameSetSize(WosScoreboard___WOS_STATS_RowContent[row], (((WosScoreboard___WOS_STATS_ROW_WIDTH)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((WosScoreboard___WOS_STATS_ROW_HEIGHT)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
        call BlzFrameSetSize(WosScoreboard___WOS_STATS_HeroIcon[row], (((WosScoreboard___WOS_STATS_HERO_ICON_SIZE)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((WosScoreboard___WOS_STATS_HERO_ICON_SIZE)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_PlayerName[row] , 0.070 , 0.012 , 0.52)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_MvpText[row] , 0.028 , 0.0095 , 0.46)
        call BlzFrameSetSize(WosScoreboard___WOS_STATS_MvpHover[row], (((0.030)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((WosScoreboard___WOS_STATS_ROW_HEIGHT)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_KillText[row] , WosScoreboard___WOS_STATS_ColumnWidth(0) , 0.012 , 0.56)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_DamageText[row] , WosScoreboard___WOS_STATS_ColumnWidth(2) , 0.012 , 0.54)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_HealText[row] , WosScoreboard___WOS_STATS_ColumnWidth(3) , 0.012 , 0.54)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_TakenText[row] , WosScoreboard___WOS_STATS_ColumnWidth(4) , 0.012 , 0.52)
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_KillText[row] , WosScoreboard___WOS_STATS_ColumnX(0) , y)
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_DamageText[row] , WosScoreboard___WOS_STATS_ColumnX(2) , y)
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_HealText[row] , WosScoreboard___WOS_STATS_ColumnX(3) , y)
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_TakenText[row] , WosScoreboard___WOS_STATS_ColumnX(4) , y)
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_DamageHover[row] , WosScoreboard___WOS_STATS_ColumnX(2) , y)
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_TakenHover[row] , WosScoreboard___WOS_STATS_ColumnX(4) , y)
        call BlzFrameSetVisible(WosScoreboard___WOS_STATS_DeathText[row], false)
        call BlzFrameSetVisible(WosScoreboard___WOS_STATS_DamageMagText[row], false)
        call BlzFrameSetVisible(WosScoreboard___WOS_STATS_TakenMagText[row], false)
        call BlzFrameSetVisible(WosScoreboard___WOS_STATS_DamageHover[row], true)
        call BlzFrameSetVisible(WosScoreboard___WOS_STATS_TakenHover[row], true)
    endif

    // MVP находится в отдельной области слева и не перекрывает портрет.
    call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_HeroIcon[row] , heroX , y)
    call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_MvpText[row] , mvpX , y)
    call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_MvpHover[row] , mvpX , y)
    call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_PlayerName[row] , playerX , y)

    loop
        exitwhen slot >= WosScoreboard___WOS_STATS_ITEM_COUNT
        set itemIndex=row * WosScoreboard___WOS_STATS_ITEM_COUNT + slot
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_ItemButton[itemIndex] , itemX + I2R(slot) * itemStep , y)
        call BlzFrameSetSize(WosScoreboard___WOS_STATS_ItemButton[itemIndex], (((itemSize)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((itemSize)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
        set slot=slot + 1
    endloop
endfunction

function WosScoreboard___WOS_STATS_ConfigureHeaders takes integer team,real y,boolean expanded returns nothing
    local integer base= team * 9
    local integer index= 0

    if expanded then
        call BlzFrameSetText(WosScoreboard___WOS_STATS_HeaderText[base + 0], "|cffc6cbd1PLAYER|r")
        call BlzFrameSetText(WosScoreboard___WOS_STATS_HeaderText[base + 1], "|cffffd36bKILLS|r")
        call BlzFrameSetText(WosScoreboard___WOS_STATS_HeaderText[base + 2], "|cffd58cffDEATHS|r")
        call BlzFrameSetText(WosScoreboard___WOS_STATS_HeaderText[base + 3], "|cffff8a73PHYS DEALT|r")
        call BlzFrameSetText(WosScoreboard___WOS_STATS_HeaderText[base + 4], "|cff6fa8ffMAG DEALT|r")
        call BlzFrameSetText(WosScoreboard___WOS_STATS_HeaderText[base + 5], "|cff63e692HEAL|r")
        call BlzFrameSetText(WosScoreboard___WOS_STATS_HeaderText[base + 6], "|cffff7777PHYS TAKEN|r")
        call BlzFrameSetText(WosScoreboard___WOS_STATS_HeaderText[base + 7], "|cff91b8ffMAG TAKEN|r")
        call BlzFrameSetText(WosScoreboard___WOS_STATS_HeaderText[base + 8], "|cffc6cbd1ITEMS|r")
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_HeaderText[base + 0] , 0.145 , y)
        loop
            exitwhen index >= 7
            call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_HeaderText[base + 1 + index] , WosScoreboard___WOS_STATS_ExpandedColumnX(index) , y)
            call BlzFrameSetVisible(WosScoreboard___WOS_STATS_HeaderText[base + 1 + index], true)
            set index=index + 1
        endloop
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_HeaderText[base + 8] , 0.671 , y)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_HeaderText[base + 0] , 0.115 , 0.020 , 0.62)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_HeaderText[base + 1] , 0.040 , 0.020 , 0.64)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_HeaderText[base + 2] , 0.040 , 0.020 , 0.64)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_HeaderText[base + 3] , 0.055 , 0.020 , 0.58)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_HeaderText[base + 4] , 0.055 , 0.020 , 0.58)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_HeaderText[base + 5] , 0.045 , 0.020 , 0.64)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_HeaderText[base + 6] , 0.055 , 0.020 , 0.58)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_HeaderText[base + 7] , 0.055 , 0.020 , 0.58)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_HeaderText[base + 8] , 0.115 , 0.020 , 0.62)
    else
        call BlzFrameSetText(WosScoreboard___WOS_STATS_HeaderText[base + 0], "|cffc6cbd1PLAYER|r")
        call BlzFrameSetText(WosScoreboard___WOS_STATS_HeaderText[base + 1], "|cffffd36bK|r |cffc6cbd1/|r |cffd58cffD|r")
        call BlzFrameSetText(WosScoreboard___WOS_STATS_HeaderText[base + 3], "|cffff8a73DAMAGE|r")
        call BlzFrameSetText(WosScoreboard___WOS_STATS_HeaderText[base + 5], "|cff63e692HEAL|r")
        call BlzFrameSetText(WosScoreboard___WOS_STATS_HeaderText[base + 6], "|cff91b8ffTAKEN DAMAGE|r")
        call BlzFrameSetText(WosScoreboard___WOS_STATS_HeaderText[base + 8], "|cffc6cbd1ITEMS|r")
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_HeaderText[base + 0] , 0.275 , y)
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_HeaderText[base + 1] , WosScoreboard___WOS_STATS_ColumnX(0) , y)
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_HeaderText[base + 3] , WosScoreboard___WOS_STATS_ColumnX(2) , y)
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_HeaderText[base + 5] , WosScoreboard___WOS_STATS_ColumnX(3) , y)
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_HeaderText[base + 6] , WosScoreboard___WOS_STATS_ColumnX(4) , y)
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_HeaderText[base + 8] , 0.560 , y)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_HeaderText[base + 0] , 0.100 , 0.015 , 0.50)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_HeaderText[base + 1] , 0.060 , 0.015 , 0.48)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_HeaderText[base + 3] , 0.075 , 0.015 , 0.44)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_HeaderText[base + 5] , 0.060 , 0.015 , 0.48)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_HeaderText[base + 6] , 0.100 , 0.015 , 0.40)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_HeaderText[base + 8] , 0.080 , 0.015 , 0.48)
        call BlzFrameSetVisible(WosScoreboard___WOS_STATS_HeaderText[base + 2], false)
        call BlzFrameSetVisible(WosScoreboard___WOS_STATS_HeaderText[base + 4], false)
        call BlzFrameSetVisible(WosScoreboard___WOS_STATS_HeaderText[base + 7], false)
    endif
    call BlzFrameSetVisible(WosScoreboard___WOS_STATS_HeaderText[base + 0], true)
    call BlzFrameSetVisible(WosScoreboard___WOS_STATS_HeaderText[base + 1], true)
    call BlzFrameSetVisible(WosScoreboard___WOS_STATS_HeaderText[base + 3], true)
    call BlzFrameSetVisible(WosScoreboard___WOS_STATS_HeaderText[base + 5], true)
    call BlzFrameSetVisible(WosScoreboard___WOS_STATS_HeaderText[base + 6], true)
    call BlzFrameSetVisible(WosScoreboard___WOS_STATS_HeaderText[base + 8], true)
endfunction

function WosScoreboard___WOS_STATS_LayoutTeam takes integer team,real titleY,boolean expanded returns real
    local integer row= team * WosScoreboard___WOS_STATS_TEAM_SIZE
    local integer rowEnd= row + WosScoreboard___WOS_STATS_TEAM_SIZE
    local integer pid
    local integer totalBase= team * 7
    local integer column= 0
    local real headerY
    local real rowY
    local real totalY

    if expanded then
        set headerY=titleY - 0.019
        set rowY=headerY - 0.0195
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_TeamTitle[team] , 0.145 , titleY)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_TeamTitle[team] , 0.140 , 0.018 , 0.84)
    else
        set headerY=titleY - 0.013
        set rowY=headerY - 0.014
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_TeamTitle[team] , 0.285 , titleY)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_TeamTitle[team] , 0.130 , 0.014 , 0.72)
    endif
    call WosScoreboard___WOS_STATS_ConfigureHeaders(team , headerY , expanded)

    loop
        exitwhen row >= rowEnd
        set pid=WosScoreboard___WOS_STATS_GetDisplayPidForRow(row)
        if WosScoreboard___WOS_STATS_ShouldDisplayPid(pid) then
            call WosScoreboard___WOS_STATS_MoveRow(row , rowY , expanded)
            if expanded then
                set rowY=rowY - WosScoreboard___WOS_STATS_EXPANDED_ROW_STEP
            else
                set rowY=rowY - WosScoreboard___WOS_STATS_ROW_STEP
            endif
        endif
        set row=row + 1
    endloop

    set totalY=rowY + 0.001
    if expanded then
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_TotalLabel[team] , 0.145 , totalY)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_TotalLabel[team] , 0.115 , 0.016 , 0.56)
        loop
            exitwhen column >= 7
            call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_TotalText[totalBase + column] , WosScoreboard___WOS_STATS_ExpandedColumnX(column) , totalY)
            call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_TotalText[totalBase + column] , WosScoreboard___WOS_STATS_ExpandedColumnWidth(column) , 0.017 , 0.70)
            call BlzFrameSetVisible(WosScoreboard___WOS_STATS_TotalText[totalBase + column], true)
            set column=column + 1
        endloop
        call BlzFrameSetVisible(WosScoreboard___WOS_STATS_TotalDamageHover[team], false)
        call BlzFrameSetVisible(WosScoreboard___WOS_STATS_TotalTakenHover[team], false)
        return totalY - 0.018
    endif

    call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_TotalLabel[team] , 0.263 , totalY)
    call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_TotalLabel[team] , 0.100 , 0.012 , 0.42)
    call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_TotalText[totalBase + 0] , WosScoreboard___WOS_STATS_ColumnX(0) , totalY)
    call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_TotalText[totalBase + 2] , WosScoreboard___WOS_STATS_ColumnX(2) , totalY)
    call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_TotalText[totalBase + 4] , WosScoreboard___WOS_STATS_ColumnX(3) , totalY)
    call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_TotalText[totalBase + 5] , WosScoreboard___WOS_STATS_ColumnX(4) , totalY)
    call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_TotalText[totalBase + 0] , WosScoreboard___WOS_STATS_ColumnWidth(0) , 0.012 , 0.52)
    call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_TotalText[totalBase + 2] , WosScoreboard___WOS_STATS_ColumnWidth(2) , 0.012 , 0.52)
    call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_TotalText[totalBase + 4] , WosScoreboard___WOS_STATS_ColumnWidth(3) , 0.012 , 0.52)
    call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_TotalText[totalBase + 5] , WosScoreboard___WOS_STATS_ColumnWidth(4) , 0.012 , 0.52)
    call BlzFrameSetVisible(WosScoreboard___WOS_STATS_TotalText[totalBase + 0], true)
    call BlzFrameSetVisible(WosScoreboard___WOS_STATS_TotalText[totalBase + 1], false)
    call BlzFrameSetVisible(WosScoreboard___WOS_STATS_TotalText[totalBase + 2], true)
    call BlzFrameSetVisible(WosScoreboard___WOS_STATS_TotalText[totalBase + 3], false)
    call BlzFrameSetVisible(WosScoreboard___WOS_STATS_TotalText[totalBase + 4], true)
    call BlzFrameSetVisible(WosScoreboard___WOS_STATS_TotalText[totalBase + 5], true)
    call BlzFrameSetVisible(WosScoreboard___WOS_STATS_TotalText[totalBase + 6], false)
    call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_TotalDamageHover[team] , WosScoreboard___WOS_STATS_ColumnX(2) , totalY)
    call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_TotalTakenHover[team] , WosScoreboard___WOS_STATS_ColumnX(4) , totalY)
    call BlzFrameSetVisible(WosScoreboard___WOS_STATS_TotalDamageHover[team], true)
    call BlzFrameSetVisible(WosScoreboard___WOS_STATS_TotalTakenHover[team], true)
    return totalY - 0.015
endfunction

function WosScoreboard___WOS_STATS_Layout takes integer viewerPid returns nothing
    local boolean expanded= WosScoreboard___WOS_STATS_IsExpanded[viewerPid]
    local real nextY
    local real bottom
    local real height
    local real centerY
    local real width
    local real contentWidth
    local real panelTop= WosScoreboard___WOS_STATS_PANEL_TOP
    local real yOffset= 0.0

    if expanded then
        set yOffset=WosScoreboard___WOS_STATS_EXPANDED_Y_OFFSET
        // После скрытия стандартного интерфейса финальное окно визуально
        // оказывается выше обычного. Немного опускаем только финальный режим.
        if WosScoreboard___WOS_STATS_IsFinal[viewerPid] then
            set yOffset=0.040
        endif
        set panelTop=WosScoreboard___WOS_STATS_PANEL_TOP + yOffset
        set nextY=WosScoreboard___WOS_STATS_LayoutTeam(0 , 0.468 + yOffset , true)
        set nextY=WosScoreboard___WOS_STATS_LayoutTeam(1 , nextY , true)
        set width=WosScoreboard___WOS_STATS_EXPANDED_WIDTH
        set contentWidth=WosScoreboard___WOS_STATS_EXPANDED_CONTENT_WIDTH
    else
        set nextY=WosScoreboard___WOS_STATS_LayoutTeam(0 , 0.474 , false)
        set nextY=WosScoreboard___WOS_STATS_LayoutTeam(1 , nextY , false)
        set width=WosScoreboard___WOS_STATS_PANEL_WIDTH
        set contentWidth=WosScoreboard___WOS_STATS_CONTENT_WIDTH
    endif
    // После удаления Hover-надписи возвращаем край сразу после штатного
    // отступа итоговой строки; отдельного резерва под текст больше нет.
    set bottom=nextY
    set height=panelTop - bottom
    if height < 0.125 then
        set height=0.125
        set bottom=panelTop - height
    endif
    set centerY=( panelTop + bottom ) * 0.50

    call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_Main , WosScoreboard___WOS_STATS_PANEL_X , centerY)
    call BlzFrameSetSize(WosScoreboard___WOS_STATS_Main, (((width)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((height)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
    call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_OpaqueBack , WosScoreboard___WOS_STATS_PANEL_X , centerY)
    call BlzFrameSetSize(WosScoreboard___WOS_STATS_OpaqueBack, (((contentWidth)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((height - 0.012)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
    call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_Inner , WosScoreboard___WOS_STATS_PANEL_X , centerY)
    call BlzFrameSetSize(WosScoreboard___WOS_STATS_Inner, (((contentWidth)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((height - 0.012)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
    call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_Score , 0.400 , 0.491 + yOffset)
    if expanded then
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_Title , 0.160 , 0.020 , 0.72)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_Score , 0.100 , 0.024 , 1.35)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_MatchInfo , 0.080 , 0.020 , 1.05)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_ScreenshotClock , 0.085 , 0.020 , 0.82)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_GameClock , 0.065 , 0.020 , 1.14)
        if WosScoreboard___WOS_STATS_IsFinal[viewerPid] then
            call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_Title , 0.135 , 0.492 + yOffset)
            call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_ScreenshotClock , 0.495 , 0.492 + yOffset)
            call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_MatchInfo , 0.585 , 0.492 + yOffset)
            call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_GameClock , 0.680 , 0.492 + yOffset)
        else
            call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_Title , 0.135 , 0.492 + yOffset)
            call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_MatchInfo , 0.565 , 0.492 + yOffset)
            call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_GameClock , 0.640 , 0.492 + yOffset)
        endif
        call BlzFrameSetVisible(WosScoreboard___WOS_STATS_ScreenshotClock, WosScoreboard___WOS_STATS_IsFinal[viewerPid])
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_OpacityButton , 0.684 , 0.492 + yOffset)
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_ExpandButton , 0.706 , 0.492 + yOffset)
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_CloseButton , 0.728 , 0.492 + yOffset)
    else
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_Title , 0.145 , 0.015 , 0.62)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_Score , 0.085 , 0.021 , 1.20)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_MatchInfo , 0.074 , 0.016 , 0.90)
        call WosScoreboard___WOS_STATS_ResizeText(WosScoreboard___WOS_STATS_GameClock , 0.058 , 0.017 , 1.02)
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_Title , 0.270 , 0.492)
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_MatchInfo , 0.470 , 0.492)
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_GameClock , 0.525 , 0.492)
        call BlzFrameSetVisible(WosScoreboard___WOS_STATS_ScreenshotClock, false)
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_OpacityButton , 0.558 , 0.492)
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_ExpandButton , 0.578 , 0.492)
        call WosScoreboard___WOS_STATS_MoveFrame(WosScoreboard___WOS_STATS_CloseButton , 0.598 , 0.492)
    endif
    call BlzFrameSetVisible(WosScoreboard___WOS_STATS_OpaqueBack, WosScoreboard___WOS_STATS_IsOpaque[viewerPid] or WosScoreboard___WOS_STATS_IsFinal[viewerPid])
    if WosScoreboard___WOS_STATS_IsOpaque[viewerPid] then
        call BlzFrameSetTexture(WosScoreboard___WOS_STATS_OpacityIcon, WosScoreboard___WOS_STATS_TEX_OPACITY_ON, 0, true)
    else
        call BlzFrameSetTexture(WosScoreboard___WOS_STATS_OpacityIcon, WosScoreboard___WOS_STATS_TEX_OPACITY_OFF, 0, true)
    endif
    if expanded then
        call BlzFrameSetTexture(WosScoreboard___WOS_STATS_ExpandIcon, WosScoreboard___WOS_STATS_TEX_COLLAPSE, 0, true)
    else
        call BlzFrameSetTexture(WosScoreboard___WOS_STATS_ExpandIcon, WosScoreboard___WOS_STATS_TEX_EXPAND, 0, true)
    endif
endfunction

function WosScoreboard___WOS_STATS_UpdateForPlayer takes integer viewerPid returns nothing
    local integer row= 0
    local integer mvpPid= WosScoreboard___WOS_STATS_GetMvpPid(viewerPid)
    local integer screenshotSeconds= 20 - END2

    call WosScoreboard___WOS_STATS_Layout(viewerPid)
    call BlzFrameSetText(WosScoreboard___WOS_STATS_MatchInfo, "|cffb7c0caRound |r|cffffd36b" + I2S(CurrentRound) + "|r")
    call BlzFrameSetText(WosScoreboard___WOS_STATS_Score, "|cffff4040" + I2S(Team1Round) + "|r |cffffffff:|r |cff4080ff" + I2S(Team2Round) + "|r")
    call BlzFrameSetText(WosScoreboard___WOS_STATS_GameClock, "|cffc6cbd1" + WosScoreboard___WOS_STATS_GameTime() + "|r")
    if WosScoreboard___WOS_STATS_IsFinal[viewerPid] then
        if screenshotSeconds < 0 then
            set screenshotSeconds=0
        endif
        call BlzFrameSetText(WosScoreboard___WOS_STATS_ScreenshotClock, "|cffffd36bScreenshot: |r|cffffffff" + I2S(screenshotSeconds) + "s|r")
    else
        call BlzFrameSetText(WosScoreboard___WOS_STATS_ScreenshotClock, "")
    endif

    loop
        exitwhen row >= WosScoreboard___WOS_STATS_PLAYER_COUNT
        call WosScoreboard___WOS_STATS_UpdateRow(row , viewerPid , mvpPid)
        set row=row + 1
    endloop
    call WosScoreboard___WOS_STATS_UpdateTeamTotal(viewerPid , 0 , WosScoreboard___WOS_STATS_IsExpanded[viewerPid])
    call WosScoreboard___WOS_STATS_UpdateTeamTotal(viewerPid , 1 , WosScoreboard___WOS_STATS_IsExpanded[viewerPid])
endfunction

//===========================================================================
// Совместимость со старым F2-интерфейсом
//===========================================================================
function WosScoreboard___WOS_STATS_SaveAndHideLegacyUI takes integer pid returns nothing
    if FRAME_StatusHeroMain != null then
        set WosScoreboard___WOS_STATS_OldTopVisible[pid]=BlzFrameIsVisible(FRAME_StatusHeroMain)
        call BlzFrameSetVisible(FRAME_StatusHeroMain, false)
    endif
    if FRAME_StatusHeroMain2 != null then
        set WosScoreboard___WOS_STATS_OldTakenVisible[pid]=BlzFrameIsVisible(FRAME_StatusHeroMain2)
        call BlzFrameSetVisible(FRAME_StatusHeroMain2, false)
    endif
    if FRAME_StatusHeroMain3 != null then
        set WosScoreboard___WOS_STATS_OldOptionsVisible[pid]=BlzFrameIsVisible(FRAME_StatusHeroMain3)
        call BlzFrameSetVisible(FRAME_StatusHeroMain3, false)
    endif
    if FRAME_StatusHeroMain4 != null then
        set WosScoreboard___WOS_STATS_OldCameraVisible[pid]=BlzFrameIsVisible(FRAME_StatusHeroMain4)
        call BlzFrameSetVisible(FRAME_StatusHeroMain4, false)
    endif
    if FRAME_StatsMain != null then
        set WosScoreboard___WOS_STATS_OldHeroStatsVisible[pid]=BlzFrameIsVisible(FRAME_StatsMain)
        call BlzFrameSetVisible(FRAME_StatsMain, false)
    endif
endfunction

function WosScoreboard___WOS_STATS_HideLegacyUI takes nothing returns nothing
    if FRAME_StatusHeroMain != null then
        call BlzFrameSetVisible(FRAME_StatusHeroMain, false)
    endif
    if FRAME_StatusHeroMain2 != null then
        call BlzFrameSetVisible(FRAME_StatusHeroMain2, false)
    endif
    if FRAME_StatusHeroMain3 != null then
        call BlzFrameSetVisible(FRAME_StatusHeroMain3, false)
    endif
    if FRAME_StatusHeroMain4 != null then
        call BlzFrameSetVisible(FRAME_StatusHeroMain4, false)
    endif
    if FRAME_StatsMain != null then
        call BlzFrameSetVisible(FRAME_StatsMain, false)
    endif
endfunction

//===========================================================================
// Финальный экран матча. Вызывается один раз после установки END1 = 1.
// У каждого клиента открывает его локальную копию табло в подробном режиме.
//===========================================================================
function WOS_STATS_ShowFinal takes nothing returns nothing
    local integer pid= 0

    // Всегда оставляем десять строк, включая игроков без активного героя.
    set WOS_STATS_SHOW_INACTIVE_PLAYERS=true

    loop
        exitwhen pid >= WosScoreboard___WOS_STATS_VIEWER_COUNT
        // Состояние записывается одинаково на всех клиентах.
        set WosScoreboard___WOS_STATS_IsOpen[pid]=true
        set WosScoreboard___WOS_STATS_IsExpanded[pid]=true
        set WosScoreboard___WOS_STATS_IsFinal[pid]=true
        set WosScoreboard___WOS_STATS_IsOpaque[pid]=true

        // GetLocalPlayer используется только в условии локальной работы
        // с сообщениями и фреймами. Локальный pid нигде не сохраняется.
        if GetLocalPlayer() == Player(pid) then
            // Удаляет с экрана чат и сообщения DisplayTimedTextToPlayer.
            call ClearTextMessages()
            call WosScoreboard___WOS_STATS_HideLegacyUI()
            call BlzFrameSetVisible(WosScoreboard___WOS_STATS_Main, true)
            call BlzFrameSetVisible(WosScoreboard___WOS_STATS_Inner, true)
            call WosScoreboard___WOS_STATS_UpdateForPlayer(pid)
            call BlzFrameSetAlpha(WosScoreboard___WOS_STATS_OpaqueBack, 255)
            call BlzFrameSetVisible(WosScoreboard___WOS_STATS_OpaqueBack, true)

            // На финальном экране управление больше не требуется.
            call BlzFrameSetVisible(WosScoreboard___WOS_STATS_OpacityButton, false)
            call BlzFrameSetVisible(WosScoreboard___WOS_STATS_ExpandButton, false)
            call BlzFrameSetVisible(WosScoreboard___WOS_STATS_CloseButton, false)
        endif
        set pid=pid + 1
    endloop
endfunction

function WosScoreboard___WOS_STATS_RestoreLegacyUI takes integer pid returns nothing
    if FRAME_StatusHeroMain != null then
        call BlzFrameSetVisible(FRAME_StatusHeroMain, WosScoreboard___WOS_STATS_OldTopVisible[pid])
    endif
    if FRAME_StatusHeroMain2 != null then
        call BlzFrameSetVisible(FRAME_StatusHeroMain2, WosScoreboard___WOS_STATS_OldTakenVisible[pid])
    endif
    if FRAME_StatusHeroMain3 != null then
        call BlzFrameSetVisible(FRAME_StatusHeroMain3, WosScoreboard___WOS_STATS_OldOptionsVisible[pid])
    endif
    if FRAME_StatusHeroMain4 != null then
        call BlzFrameSetVisible(FRAME_StatusHeroMain4, WosScoreboard___WOS_STATS_OldCameraVisible[pid])
    endif
    if FRAME_StatsMain != null then
        if IsObserverSlot(pid) then
            call BlzFrameSetVisible(FRAME_StatsMain, false)
        else
            call BlzFrameSetVisible(FRAME_StatsMain, WosScoreboard___WOS_STATS_OldHeroStatsVisible[pid])
        endif
    endif
endfunction

function WosScoreboard___WOS_STATS_SetOpen takes player whichPlayer,boolean open returns nothing
    local integer pid= GetPlayerId(whichPlayer)

    if pid < 0 or pid >= WosScoreboard___WOS_STATS_VIEWER_COUNT then
        return
    endif
    set WosScoreboard___WOS_STATS_IsOpen[pid]=open
    if GetLocalPlayer() == whichPlayer then
        if open then
            call WosScoreboard___WOS_STATS_SaveAndHideLegacyUI(pid)
            call BlzFrameSetVisible(WosScoreboard___WOS_STATS_Main, true)
            call BlzFrameSetVisible(WosScoreboard___WOS_STATS_Inner, true)
            call WosScoreboard___WOS_STATS_UpdateForPlayer(pid)
        else
            call BlzFrameSetVisible(WosScoreboard___WOS_STATS_Main, false)
            call WosScoreboard___WOS_STATS_RestoreLegacyUI(pid)
        endif
    endif
endfunction

function WosScoreboard___WOS_STATS_OnKey takes nothing returns nothing
    local player whichPlayer= GetTriggerPlayer()
    local integer pid= GetPlayerId(whichPlayer)

    if END1 != 0 then
        set whichPlayer=null
        return
    endif
    call WosScoreboard___WOS_STATS_SetOpen(whichPlayer , not WosScoreboard___WOS_STATS_IsOpen[pid])
    set whichPlayer=null
endfunction

function WosScoreboard___WOS_STATS_OnClose takes nothing returns nothing
    local player whichPlayer= GetTriggerPlayer()

    if END1 != 0 then
        set whichPlayer=null
        return
    endif
    call WosScoreboard___WOS_STATS_SetOpen(whichPlayer , false)
    set whichPlayer=null
endfunction

function WosScoreboard___WOS_STATS_OnOpacity takes nothing returns nothing
    local player whichPlayer= GetTriggerPlayer()
    local integer pid= GetPlayerId(whichPlayer)

    if END1 != 0 then
        set whichPlayer=null
        return
    endif
    set WosScoreboard___WOS_STATS_IsOpaque[pid]=not WosScoreboard___WOS_STATS_IsOpaque[pid]
    if GetLocalPlayer() == whichPlayer then
        call BlzFrameSetEnable(WosScoreboard___WOS_STATS_OpacityButton, false)
        call BlzFrameSetEnable(WosScoreboard___WOS_STATS_OpacityButton, true)
        call WosScoreboard___WOS_STATS_UpdateForPlayer(pid)
    endif
    set whichPlayer=null
endfunction

function WosScoreboard___WOS_STATS_OnExpand takes nothing returns nothing
    local player whichPlayer= GetTriggerPlayer()
    local integer pid= GetPlayerId(whichPlayer)

    if END1 != 0 then
        set whichPlayer=null
        return
    endif
    set WosScoreboard___WOS_STATS_IsExpanded[pid]=not WosScoreboard___WOS_STATS_IsExpanded[pid]
    if GetLocalPlayer() == whichPlayer then
        call BlzFrameSetEnable(WosScoreboard___WOS_STATS_ExpandButton, false)
        call BlzFrameSetEnable(WosScoreboard___WOS_STATS_ExpandButton, true)
        call WosScoreboard___WOS_STATS_UpdateForPlayer(pid)
    endif
    set whichPlayer=null
endfunction

function WosScoreboard___WOS_STATS_Periodic takes nothing returns nothing
    local integer pid= 0

    loop
        exitwhen pid >= WosScoreboard___WOS_STATS_VIEWER_COUNT
        if WosScoreboard___WOS_STATS_IsOpen[pid] and GetLocalPlayer() == Player(pid) then
            // Очищаем и новые сообщения локально на протяжении всего времени,
            // пока у этого игрока открыто финальное табло.
            if WosScoreboard___WOS_STATS_IsFinal[pid] then
                call ClearTextMessages()
            endif
            call WosScoreboard___WOS_STATS_HideLegacyUI()
            call BlzFrameSetVisible(WosScoreboard___WOS_STATS_Main, true)
            call WosScoreboard___WOS_STATS_UpdateForPlayer(pid)
        endif
        set pid=pid + 1
    endloop
endfunction

//===========================================================================
// Создание интерфейса
//===========================================================================
function WosScoreboard___WOS_STATS_CreateHeaders takes nothing returns nothing
    local integer team= 0
    local integer column
    local integer index
    local real headerY
    local real totalY
    local string teamColor
    local string teamName

    loop
        exitwhen team >= 2
        if team == 0 then
            set headerY=0.441
            set totalY=0.326
            set teamColor="|cffff4040"
            set teamName="Wos Enjoyers"
            set WosScoreboard___WOS_STATS_TeamTitle[team]=WosScoreboard___WOS_STATS_CreateText(WosScoreboard___WOS_STATS_Inner , 0.285 , 0.474 , 0.130 , 0.013 , 0.64 , TEXT_JUSTIFY_LEFT , teamColor + teamName + "|r" , 100 + team)
        else
            set headerY=0.294
            set totalY=0.179
            set teamColor="|cff4080ff"
            set teamName="Wos Haters"
            set WosScoreboard___WOS_STATS_TeamTitle[team]=WosScoreboard___WOS_STATS_CreateText(WosScoreboard___WOS_STATS_Inner , 0.285 , 0.340 , 0.130 , 0.013 , 0.64 , TEXT_JUSTIFY_LEFT , teamColor + teamName + "|r" , 100 + team)
        endif

        set index=team * 9
        set WosScoreboard___WOS_STATS_HeaderText[index + 0]=WosScoreboard___WOS_STATS_CreateText(WosScoreboard___WOS_STATS_Inner , 0.275 , headerY , 0.100 , 0.014 , 0.44 , TEXT_JUSTIFY_LEFT , "|cffc6cbd1PLAYER|r" , 200 + index)
        set WosScoreboard___WOS_STATS_HeaderText[index + 1]=WosScoreboard___WOS_STATS_CreateText(WosScoreboard___WOS_STATS_Inner , WosScoreboard___WOS_STATS_ColumnX(0) , headerY , 0.060 , 0.014 , 0.42 , TEXT_JUSTIFY_CENTER , "|cffffd36bK|r |cffc6cbd1/|r |cffd58cffD|r" , 201 + index)
        set WosScoreboard___WOS_STATS_HeaderText[index + 2]=WosScoreboard___WOS_STATS_CreateText(WosScoreboard___WOS_STATS_Inner , WosScoreboard___WOS_STATS_ExpandedColumnX(1) , headerY , 0.065 , 0.014 , 0.38 , TEXT_JUSTIFY_CENTER , "|cffd58cffDEATHS|r" , 202 + index)
        set WosScoreboard___WOS_STATS_HeaderText[index + 3]=WosScoreboard___WOS_STATS_CreateText(WosScoreboard___WOS_STATS_Inner , WosScoreboard___WOS_STATS_ColumnX(2) , headerY , 0.075 , 0.014 , 0.38 , TEXT_JUSTIFY_CENTER , "|cffff8a73DAMAGE|r" , 203 + index)
        set WosScoreboard___WOS_STATS_HeaderText[index + 4]=WosScoreboard___WOS_STATS_CreateText(WosScoreboard___WOS_STATS_Inner , WosScoreboard___WOS_STATS_ExpandedColumnX(3) , headerY , 0.075 , 0.014 , 0.34 , TEXT_JUSTIFY_CENTER , "|cff6fa8ffMAGICAL DEALT|r" , 204 + index)
        set WosScoreboard___WOS_STATS_HeaderText[index + 5]=WosScoreboard___WOS_STATS_CreateText(WosScoreboard___WOS_STATS_Inner , WosScoreboard___WOS_STATS_ColumnX(3) , headerY , 0.060 , 0.014 , 0.42 , TEXT_JUSTIFY_CENTER , "|cff63e692HEAL|r" , 205 + index)
        set WosScoreboard___WOS_STATS_HeaderText[index + 6]=WosScoreboard___WOS_STATS_CreateText(WosScoreboard___WOS_STATS_Inner , WosScoreboard___WOS_STATS_ColumnX(4) , headerY , 0.100 , 0.014 , 0.34 , TEXT_JUSTIFY_CENTER , "|cff91b8ffTAKEN DAMAGE|r" , 206 + index)
        set WosScoreboard___WOS_STATS_HeaderText[index + 7]=WosScoreboard___WOS_STATS_CreateText(WosScoreboard___WOS_STATS_Inner , WosScoreboard___WOS_STATS_ExpandedColumnX(6) , headerY , 0.075 , 0.014 , 0.34 , TEXT_JUSTIFY_CENTER , "|cff91b8ffMAGICAL TAKEN|r" , 207 + index)
        set WosScoreboard___WOS_STATS_HeaderText[index + 8]=WosScoreboard___WOS_STATS_CreateText(WosScoreboard___WOS_STATS_Inner , 0.560 , headerY , 0.080 , 0.014 , 0.42 , TEXT_JUSTIFY_CENTER , "|cffc6cbd1ITEMS|r" , 208 + index)
        call BlzFrameSetVisible(WosScoreboard___WOS_STATS_HeaderText[index + 2], false)
        call BlzFrameSetVisible(WosScoreboard___WOS_STATS_HeaderText[index + 4], false)
        call BlzFrameSetVisible(WosScoreboard___WOS_STATS_HeaderText[index + 7], false)

        set WosScoreboard___WOS_STATS_TotalLabel[team]=WosScoreboard___WOS_STATS_CreateText(WosScoreboard___WOS_STATS_Inner , 0.263 , totalY , 0.100 , 0.011 , 0.36 , TEXT_JUSTIFY_LEFT , teamColor + "TEAM TOTAL|r" , 300 + team)
        set column=0
        loop
            exitwhen column >= 7
            set WosScoreboard___WOS_STATS_TotalText[team * 7 + column]=WosScoreboard___WOS_STATS_CreateText(WosScoreboard___WOS_STATS_Inner , WosScoreboard___WOS_STATS_ExpandedColumnX(column) , totalY , WosScoreboard___WOS_STATS_ExpandedColumnWidth(column) , 0.014 , 0.45 , TEXT_JUSTIFY_CENTER , "|cffffffff0|r" , 320 + team * 7 + column)
            set column=column + 1
        endloop
        set WosScoreboard___WOS_STATS_TotalDamageHover[team]=WosScoreboard___WOS_STATS_CreateHoverArea(WosScoreboard___WOS_STATS_Inner , WosScoreboard___WOS_STATS_ColumnX(2) , totalY , WosScoreboard___WOS_STATS_ColumnWidth(2) , 0.012 , 360 + team * 2)
        set WosScoreboard___WOS_STATS_TotalTakenHover[team]=WosScoreboard___WOS_STATS_CreateHoverArea(WosScoreboard___WOS_STATS_Inner , WosScoreboard___WOS_STATS_ColumnX(4) , totalY , WosScoreboard___WOS_STATS_ColumnWidth(4) , 0.012 , 361 + team * 2)
        call WosScoreboard___WOS_STATS_CreateCombatTooltip(WosScoreboard___WOS_STATS_TotalDamageHover[team] , 20 + team * 2)
        call WosScoreboard___WOS_STATS_CreateCombatTooltip(WosScoreboard___WOS_STATS_TotalTakenHover[team] , 21 + team * 2)
        set team=team + 1
    endloop
endfunction

function WosScoreboard___WOS_STATS_CreateRows takes nothing returns nothing
    local integer row= 0
    local integer slot
    local integer itemIndex
    local real y
    local real itemX
    local framehandle icon

    loop
        exitwhen row >= WosScoreboard___WOS_STATS_PLAYER_COUNT
        set y=WosScoreboard___WOS_STATS_RowY(row)
        set WosScoreboard___WOS_STATS_RowBack[row]=WosScoreboard___WOS_STATS_CreateBackdrop(WosScoreboard___WOS_STATS_Inner , WosScoreboard___WOS_STATS_TEX_ROW , WosScoreboard___WOS_STATS_PANEL_X , y , WosScoreboard___WOS_STATS_ROW_WIDTH , WosScoreboard___WOS_STATS_ROW_HEIGHT , 105 , 600 + row)
        call BlzFrameSetLevel(WosScoreboard___WOS_STATS_RowBack[row], 3)

        // Содержимое является соседним слоем, а не ребёнком полупрозрачной полосы.
        // Поэтому alpha RowBack больше не затрагивает портрет, текст и предметы.
        set WosScoreboard___WOS_STATS_RowContent[row]=BlzCreateFrameByType("FRAME", "WosStatsRowContent", WosScoreboard___WOS_STATS_Inner, "", 650 + row)
        call BlzFrameSetAbsPoint(WosScoreboard___WOS_STATS_RowContent[row], FRAMEPOINT_CENTER, (WosScoreboard___WOS_STATS_PANEL_X + ( ((WosScoreboard___WOS_STATS_PANEL_X)*1.0) - WosScoreboard___WOS_STATS_PANEL_X ) * WosScoreboard___WOS_STATS_GetUIScale()), (WosScoreboard___WOS_STATS_PANEL_TOP - ( WosScoreboard___WOS_STATS_PANEL_TOP - ((y)*1.0) ) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
        call BlzFrameSetSize(WosScoreboard___WOS_STATS_RowContent[row], (((WosScoreboard___WOS_STATS_ROW_WIDTH)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((WosScoreboard___WOS_STATS_ROW_HEIGHT)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
        call BlzFrameSetLevel(WosScoreboard___WOS_STATS_RowContent[row], 10)
        call BlzFrameSetAlpha(WosScoreboard___WOS_STATS_RowContent[row], 255)

        set WosScoreboard___WOS_STATS_HeroIcon[row]=BlzCreateFrameByType("BACKDROP", "WosStatsHeroIcon", WosScoreboard___WOS_STATS_RowContent[row], "", 700 + row)
        call BlzFrameSetAbsPoint(WosScoreboard___WOS_STATS_HeroIcon[row], FRAMEPOINT_CENTER, (WosScoreboard___WOS_STATS_PANEL_X + ( ((0.233)*1.0) - WosScoreboard___WOS_STATS_PANEL_X ) * WosScoreboard___WOS_STATS_GetUIScale()), (WosScoreboard___WOS_STATS_PANEL_TOP - ( WosScoreboard___WOS_STATS_PANEL_TOP - ((y)*1.0) ) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
        call BlzFrameSetSize(WosScoreboard___WOS_STATS_HeroIcon[row], (((WosScoreboard___WOS_STATS_HERO_ICON_SIZE)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((WosScoreboard___WOS_STATS_HERO_ICON_SIZE)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
        call BlzFrameSetTexture(WosScoreboard___WOS_STATS_HeroIcon[row], WosScoreboard___WOS_STATS_TEX_EMPTY, 0, false)

        set WosScoreboard___WOS_STATS_MvpText[row]=WosScoreboard___WOS_STATS_CreateText(WosScoreboard___WOS_STATS_RowContent[row] , 0.211 , y , 0.028 , 0.0095 , 0.46 , TEXT_JUSTIFY_CENTER , "" , 680 + row)
        call BlzFrameSetLevel(WosScoreboard___WOS_STATS_MvpText[row], 30)
        set WosScoreboard___WOS_STATS_MvpHover[row]=WosScoreboard___WOS_STATS_CreateHoverArea(WosScoreboard___WOS_STATS_RowContent[row] , 0.211 , y , 0.030 , WosScoreboard___WOS_STATS_ROW_HEIGHT , 690 + row)
        call WosScoreboard___WOS_STATS_CreateSimpleTooltip(WosScoreboard___WOS_STATS_MvpHover[row] , "|cffffd36bMVP|r = highest contribution\nKills + damage + healing + tanking - deaths" , 0.120 , 0.030 , 5400 + row)

        set WosScoreboard___WOS_STATS_PlayerName[row]=WosScoreboard___WOS_STATS_CreateText(WosScoreboard___WOS_STATS_RowContent[row] , 0.275 , y , 0.068 , 0.011 , 0.46 , TEXT_JUSTIFY_LEFT , "" , 800 + row)
        set WosScoreboard___WOS_STATS_KillText[row]=WosScoreboard___WOS_STATS_CreateText(WosScoreboard___WOS_STATS_RowContent[row] , WosScoreboard___WOS_STATS_ColumnX(0) , y , WosScoreboard___WOS_STATS_ColumnWidth(0) , 0.011 , 0.49 , TEXT_JUSTIFY_CENTER , "0" , 820 + row)
        set WosScoreboard___WOS_STATS_DeathText[row]=WosScoreboard___WOS_STATS_CreateText(WosScoreboard___WOS_STATS_RowContent[row] , WosScoreboard___WOS_STATS_ColumnX(1) , y , WosScoreboard___WOS_STATS_ColumnWidth(1) , 0.011 , 0.49 , TEXT_JUSTIFY_CENTER , "0" , 840 + row)
        set WosScoreboard___WOS_STATS_DamageText[row]=WosScoreboard___WOS_STATS_CreateText(WosScoreboard___WOS_STATS_RowContent[row] , WosScoreboard___WOS_STATS_ColumnX(2) , y , WosScoreboard___WOS_STATS_ColumnWidth(2) , 0.011 , 0.47 , TEXT_JUSTIFY_CENTER , "0" , 860 + row)
        set WosScoreboard___WOS_STATS_DamageMagText[row]=WosScoreboard___WOS_STATS_CreateText(WosScoreboard___WOS_STATS_RowContent[row] , WosScoreboard___WOS_STATS_ExpandedColumnX(3) , y , WosScoreboard___WOS_STATS_ExpandedColumnWidth(3) , 0.014 , 0.47 , TEXT_JUSTIFY_CENTER , "0" , 870 + row)
        set WosScoreboard___WOS_STATS_HealText[row]=WosScoreboard___WOS_STATS_CreateText(WosScoreboard___WOS_STATS_RowContent[row] , WosScoreboard___WOS_STATS_ColumnX(3) , y , WosScoreboard___WOS_STATS_ColumnWidth(3) , 0.011 , 0.47 , TEXT_JUSTIFY_CENTER , "0" , 880 + row)
        set WosScoreboard___WOS_STATS_TakenText[row]=WosScoreboard___WOS_STATS_CreateText(WosScoreboard___WOS_STATS_RowContent[row] , WosScoreboard___WOS_STATS_ColumnX(4) , y , WosScoreboard___WOS_STATS_ColumnWidth(4) , 0.011 , 0.45 , TEXT_JUSTIFY_CENTER , "0" , 900 + row)
        set WosScoreboard___WOS_STATS_TakenMagText[row]=WosScoreboard___WOS_STATS_CreateText(WosScoreboard___WOS_STATS_RowContent[row] , WosScoreboard___WOS_STATS_ExpandedColumnX(6) , y , WosScoreboard___WOS_STATS_ExpandedColumnWidth(6) , 0.014 , 0.45 , TEXT_JUSTIFY_CENTER , "0" , 910 + row)
        call BlzFrameSetVisible(WosScoreboard___WOS_STATS_DeathText[row], false)
        call BlzFrameSetVisible(WosScoreboard___WOS_STATS_DamageMagText[row], false)
        call BlzFrameSetVisible(WosScoreboard___WOS_STATS_TakenMagText[row], false)

        set WosScoreboard___WOS_STATS_DamageHover[row]=WosScoreboard___WOS_STATS_CreateHoverArea(WosScoreboard___WOS_STATS_RowContent[row] , WosScoreboard___WOS_STATS_ColumnX(2) , y , WosScoreboard___WOS_STATS_ColumnWidth(2) , WosScoreboard___WOS_STATS_ROW_HEIGHT , 920 + row)
        set WosScoreboard___WOS_STATS_TakenHover[row]=WosScoreboard___WOS_STATS_CreateHoverArea(WosScoreboard___WOS_STATS_RowContent[row] , WosScoreboard___WOS_STATS_ColumnX(4) , y , WosScoreboard___WOS_STATS_ColumnWidth(4) , WosScoreboard___WOS_STATS_ROW_HEIGHT , 940 + row)
        call WosScoreboard___WOS_STATS_CreateCombatTooltip(WosScoreboard___WOS_STATS_DamageHover[row] , row * 2)
        call WosScoreboard___WOS_STATS_CreateCombatTooltip(WosScoreboard___WOS_STATS_TakenHover[row] , row * 2 + 1)

        set slot=0
        loop
            exitwhen slot >= WosScoreboard___WOS_STATS_ITEM_COUNT
            set itemIndex=row * WosScoreboard___WOS_STATS_ITEM_COUNT + slot
            set itemX=0.527 + I2R(slot) * WosScoreboard___WOS_STATS_ITEM_STEP
            set WosScoreboard___WOS_STATS_ItemButton[itemIndex]=BlzCreateFrameByType("BUTTON", "WosStatsItemButton", WosScoreboard___WOS_STATS_RowContent[row], "ScoreScreenTabButtonTemplate", 1000 + itemIndex)
            call BlzFrameSetAbsPoint(WosScoreboard___WOS_STATS_ItemButton[itemIndex], FRAMEPOINT_CENTER, (WosScoreboard___WOS_STATS_PANEL_X + ( ((itemX)*1.0) - WosScoreboard___WOS_STATS_PANEL_X ) * WosScoreboard___WOS_STATS_GetUIScale()), (WosScoreboard___WOS_STATS_PANEL_TOP - ( WosScoreboard___WOS_STATS_PANEL_TOP - ((y)*1.0) ) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
            call BlzFrameSetSize(WosScoreboard___WOS_STATS_ItemButton[itemIndex], (((WosScoreboard___WOS_STATS_ITEM_ICON_SIZE)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((WosScoreboard___WOS_STATS_ITEM_ICON_SIZE)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
            call BlzFrameSetLevel(WosScoreboard___WOS_STATS_ItemButton[itemIndex], 25)

            set icon=BlzCreateFrameByType("BACKDROP", "WosStatsItemIcon", WosScoreboard___WOS_STATS_ItemButton[itemIndex], "", 1100 + itemIndex)
            call BlzFrameSetAllPoints(icon, WosScoreboard___WOS_STATS_ItemButton[itemIndex])
            call BlzFrameSetLevel(icon, 26)
            call BlzFrameSetTexture(icon, WosScoreboard___WOS_STATS_TEX_EMPTY, 0, false)
            set WosScoreboard___WOS_STATS_ItemIcon[itemIndex]=icon
            call WosScoreboard___WOS_STATS_CreateItemTooltip(WosScoreboard___WOS_STATS_ItemButton[itemIndex] , itemIndex)
            call BlzFrameSetVisible(WosScoreboard___WOS_STATS_ItemButton[itemIndex], false)
            set slot=slot + 1
        endloop

        set WosScoreboard___WOS_STATS_LastRowPid[row]=- 1
        set WosScoreboard___WOS_STATS_LastHeroType[row]=0
        set WosScoreboard___WOS_STATS_LastHeroDead[row]=false
        call BlzFrameSetVisible(WosScoreboard___WOS_STATS_RowBack[row], false)
        call BlzFrameSetVisible(WosScoreboard___WOS_STATS_RowContent[row], false)
        set row=row + 1
    endloop
    set icon=null
endfunction

function WosScoreboard___WOS_STATS_CreateCloseTooltip takes nothing returns nothing
    call WosScoreboard___WOS_STATS_CreateSimpleTooltip(WosScoreboard___WOS_STATS_CloseButton , "|cffffffffClose [F2]|r" , 0.060 , 0.016 , 5490)
endfunction

function WosScoreboard___WOS_STATS_CreateUI takes nothing returns nothing
    local integer pid= 0
    local framehandle gameUI= BlzGetFrameByName("ConsoleUIBackdrop", 0)

    // Компактная рамка ListBoxWar3: тоньше EscMenuBackdrop и не подрезает
    // верхнюю строку интерфейса толстой каменной кромкой.
    set WosScoreboard___WOS_STATS_Main=BlzCreateFrame(WosScoreboard___WOS_STATS_FRAME_TEMPLATE, gameUI, 0, 4700)
    call BlzFrameSetAbsPoint(WosScoreboard___WOS_STATS_Main, FRAMEPOINT_CENTER, (WosScoreboard___WOS_STATS_PANEL_X + ( ((WosScoreboard___WOS_STATS_PANEL_X)*1.0) - WosScoreboard___WOS_STATS_PANEL_X ) * WosScoreboard___WOS_STATS_GetUIScale()), (WosScoreboard___WOS_STATS_PANEL_TOP - ( WosScoreboard___WOS_STATS_PANEL_TOP - ((WosScoreboard___WOS_STATS_PANEL_Y)*1.0) ) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
    call BlzFrameSetSize(WosScoreboard___WOS_STATS_Main, (((WosScoreboard___WOS_STATS_PANEL_WIDTH)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((WosScoreboard___WOS_STATS_PANEL_HEIGHT)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
    set WosScoreboard___WOS_STATS_OpaqueBack=WosScoreboard___WOS_STATS_CreateBackdrop(WosScoreboard___WOS_STATS_Main , WosScoreboard___WOS_STATS_TEX_PANEL_FILL , WosScoreboard___WOS_STATS_PANEL_X , WosScoreboard___WOS_STATS_PANEL_Y , WosScoreboard___WOS_STATS_CONTENT_WIDTH , WosScoreboard___WOS_STATS_CONTENT_HEIGHT , 255 , 4709)
    call BlzFrameSetLevel(WosScoreboard___WOS_STATS_OpaqueBack, 1)
    call BlzFrameSetVisible(WosScoreboard___WOS_STATS_OpaqueBack, false)
    // Невидимый контейнер: он не закрывает текстуру ListBoxWar3 у Main.
    // Чёрный фон остаётся только у WOS_STATS_RowBack каждой строки игрока.
    set WosScoreboard___WOS_STATS_Inner=BlzCreateFrameByType("FRAME", "WosStatsInner", WosScoreboard___WOS_STATS_Main, "", 4701)
    call BlzFrameSetAbsPoint(WosScoreboard___WOS_STATS_Inner, FRAMEPOINT_CENTER, (WosScoreboard___WOS_STATS_PANEL_X + ( ((WosScoreboard___WOS_STATS_PANEL_X)*1.0) - WosScoreboard___WOS_STATS_PANEL_X ) * WosScoreboard___WOS_STATS_GetUIScale()), (WosScoreboard___WOS_STATS_PANEL_TOP - ( WosScoreboard___WOS_STATS_PANEL_TOP - ((WosScoreboard___WOS_STATS_PANEL_Y)*1.0) ) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
    call BlzFrameSetSize(WosScoreboard___WOS_STATS_Inner, (((WosScoreboard___WOS_STATS_CONTENT_WIDTH)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((WosScoreboard___WOS_STATS_CONTENT_HEIGHT)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
    call BlzFrameSetLevel(WosScoreboard___WOS_STATS_Inner, 2)

    set WosScoreboard___WOS_STATS_Title=WosScoreboard___WOS_STATS_CreateText(WosScoreboard___WOS_STATS_Inner , 0.285 , 0.492 , 0.140 , 0.014 , 0.55 , TEXT_JUSTIFY_LEFT , "|cffffd36bWOS2 STATISTICS|r" , 4702)
    set WosScoreboard___WOS_STATS_Score=WosScoreboard___WOS_STATS_CreateText(WosScoreboard___WOS_STATS_Inner , 0.400 , 0.491 , 0.085 , 0.020 , 1.10 , TEXT_JUSTIFY_CENTER , "" , 4707)
    set WosScoreboard___WOS_STATS_MatchInfo=WosScoreboard___WOS_STATS_CreateText(WosScoreboard___WOS_STATS_Inner , 0.480 , 0.492 , 0.072 , 0.015 , 0.81 , TEXT_JUSTIFY_CENTER , "" , 4703)
    set WosScoreboard___WOS_STATS_ScreenshotClock=WosScoreboard___WOS_STATS_CreateText(WosScoreboard___WOS_STATS_Inner , 0.495 , 0.492 , 0.085 , 0.016 , 0.82 , TEXT_JUSTIFY_CENTER , "" , 4714)
    call BlzFrameSetVisible(WosScoreboard___WOS_STATS_ScreenshotClock, false)
    set WosScoreboard___WOS_STATS_GameClock=WosScoreboard___WOS_STATS_CreateText(WosScoreboard___WOS_STATS_Inner , 0.540 , 0.492 , 0.055 , 0.016 , 0.92 , TEXT_JUSTIFY_CENTER , "" , 4708)

    // Обычный BUTTON без шаблона: hitbox совпадает с визуальной позицией.
    set WosScoreboard___WOS_STATS_CloseButton=BlzCreateFrameByType("BUTTON", "WosStatsCloseButton", WosScoreboard___WOS_STATS_Main, "", 4704)
    call BlzFrameSetAbsPoint(WosScoreboard___WOS_STATS_CloseButton, FRAMEPOINT_CENTER, (WosScoreboard___WOS_STATS_PANEL_X + ( ((0.598)*1.0) - WosScoreboard___WOS_STATS_PANEL_X ) * WosScoreboard___WOS_STATS_GetUIScale()), (WosScoreboard___WOS_STATS_PANEL_TOP - ( WosScoreboard___WOS_STATS_PANEL_TOP - ((0.492)*1.0) ) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
    call BlzFrameSetSize(WosScoreboard___WOS_STATS_CloseButton, (((0.018)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((0.018)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
    call BlzFrameSetLevel(WosScoreboard___WOS_STATS_CloseButton, 60)
    set WosScoreboard___WOS_STATS_CloseIcon=BlzCreateFrameByType("BACKDROP", "WosStatsCloseIcon", WosScoreboard___WOS_STATS_CloseButton, "", 4705)
    call BlzFrameSetPoint(WosScoreboard___WOS_STATS_CloseIcon, FRAMEPOINT_CENTER, WosScoreboard___WOS_STATS_CloseButton, FRAMEPOINT_CENTER, 0.0, 0.0)
    call BlzFrameSetSize(WosScoreboard___WOS_STATS_CloseIcon, (((0.011)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((0.011)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
    call BlzFrameSetLevel(WosScoreboard___WOS_STATS_CloseIcon, 61)
    call BlzFrameSetTexture(WosScoreboard___WOS_STATS_CloseIcon, WosScoreboard___WOS_STATS_TEX_CLOSE, 0, true)

    set WosScoreboard___WOS_STATS_OpacityButton=BlzCreateFrameByType("BUTTON", "WosStatsOpacityButton", WosScoreboard___WOS_STATS_Main, "", 4710)
    call BlzFrameSetAbsPoint(WosScoreboard___WOS_STATS_OpacityButton, FRAMEPOINT_CENTER, (WosScoreboard___WOS_STATS_PANEL_X + ( ((0.558)*1.0) - WosScoreboard___WOS_STATS_PANEL_X ) * WosScoreboard___WOS_STATS_GetUIScale()), (WosScoreboard___WOS_STATS_PANEL_TOP - ( WosScoreboard___WOS_STATS_PANEL_TOP - ((0.492)*1.0) ) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
    call BlzFrameSetSize(WosScoreboard___WOS_STATS_OpacityButton, (((0.018)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((0.018)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
    call BlzFrameSetLevel(WosScoreboard___WOS_STATS_OpacityButton, 60)
    set WosScoreboard___WOS_STATS_OpacityIcon=BlzCreateFrameByType("BACKDROP", "WosStatsOpacityIcon", WosScoreboard___WOS_STATS_OpacityButton, "", 4711)
    call BlzFrameSetPoint(WosScoreboard___WOS_STATS_OpacityIcon, FRAMEPOINT_CENTER, WosScoreboard___WOS_STATS_OpacityButton, FRAMEPOINT_CENTER, 0.0, 0.0)
    call BlzFrameSetSize(WosScoreboard___WOS_STATS_OpacityIcon, (((0.011)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((0.011)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
    call BlzFrameSetLevel(WosScoreboard___WOS_STATS_OpacityIcon, 61)
    call BlzFrameSetTexture(WosScoreboard___WOS_STATS_OpacityIcon, WosScoreboard___WOS_STATS_TEX_OPACITY_OFF, 0, true)

    set WosScoreboard___WOS_STATS_ExpandButton=BlzCreateFrameByType("BUTTON", "WosStatsExpandButton", WosScoreboard___WOS_STATS_Main, "", 4712)
    call BlzFrameSetAbsPoint(WosScoreboard___WOS_STATS_ExpandButton, FRAMEPOINT_CENTER, (WosScoreboard___WOS_STATS_PANEL_X + ( ((0.578)*1.0) - WosScoreboard___WOS_STATS_PANEL_X ) * WosScoreboard___WOS_STATS_GetUIScale()), (WosScoreboard___WOS_STATS_PANEL_TOP - ( WosScoreboard___WOS_STATS_PANEL_TOP - ((0.492)*1.0) ) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
    call BlzFrameSetSize(WosScoreboard___WOS_STATS_ExpandButton, (((0.018)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((0.018)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
    call BlzFrameSetLevel(WosScoreboard___WOS_STATS_ExpandButton, 60)
    set WosScoreboard___WOS_STATS_ExpandIcon=BlzCreateFrameByType("BACKDROP", "WosStatsExpandIcon", WosScoreboard___WOS_STATS_ExpandButton, "", 4713)
    call BlzFrameSetPoint(WosScoreboard___WOS_STATS_ExpandIcon, FRAMEPOINT_CENTER, WosScoreboard___WOS_STATS_ExpandButton, FRAMEPOINT_CENTER, 0.0, 0.0)
    call BlzFrameSetSize(WosScoreboard___WOS_STATS_ExpandIcon, (((0.011)*1.0) * WosScoreboard___WOS_STATS_GetUIScale()), (((0.011)*1.0) * WosScoreboard___WOS_STATS_GetUIScale())) // INLINED!!
    call BlzFrameSetLevel(WosScoreboard___WOS_STATS_ExpandIcon, 61)
    call BlzFrameSetTexture(WosScoreboard___WOS_STATS_ExpandIcon, WosScoreboard___WOS_STATS_TEX_EXPAND, 0, true)

    call WosScoreboard___WOS_STATS_CreateSimpleTooltip(WosScoreboard___WOS_STATS_CloseButton , "|cffffffffClose [F2]|r" , 0.060 , 0.016 , 5490) // INLINED!!
    call WosScoreboard___WOS_STATS_CreateSimpleTooltip(WosScoreboard___WOS_STATS_OpacityButton , "|cffffffffTransparent / opaque background|r" , 0.105 , 0.016 , 5491)
    call WosScoreboard___WOS_STATS_CreateSimpleTooltip(WosScoreboard___WOS_STATS_ExpandButton , "|cffffffffExpand / minimize details|r" , 0.095 , 0.016 , 5492)
    call WosScoreboard___WOS_STATS_CreateHeaders()
    call WosScoreboard___WOS_STATS_CreateRows()

    set WosScoreboard___WOS_STATS_KeyTrigger=CreateTrigger()
    set WosScoreboard___WOS_STATS_CloseTrigger=CreateTrigger()
    set WosScoreboard___WOS_STATS_OpacityTrigger=CreateTrigger()
    set WosScoreboard___WOS_STATS_ExpandTrigger=CreateTrigger()
    loop
        exitwhen pid >= WosScoreboard___WOS_STATS_VIEWER_COUNT
        call BlzTriggerRegisterPlayerKeyEvent(WosScoreboard___WOS_STATS_KeyTrigger, Player(pid), OSKEY_F2, 0, false)
        set pid=pid + 1
    endloop
    call BlzTriggerRegisterFrameEvent(WosScoreboard___WOS_STATS_CloseTrigger, WosScoreboard___WOS_STATS_CloseButton, FRAMEEVENT_CONTROL_CLICK)
    call BlzTriggerRegisterFrameEvent(WosScoreboard___WOS_STATS_OpacityTrigger, WosScoreboard___WOS_STATS_OpacityButton, FRAMEEVENT_CONTROL_CLICK)
    call BlzTriggerRegisterFrameEvent(WosScoreboard___WOS_STATS_ExpandTrigger, WosScoreboard___WOS_STATS_ExpandButton, FRAMEEVENT_CONTROL_CLICK)
    call TriggerAddAction(WosScoreboard___WOS_STATS_KeyTrigger, function WosScoreboard___WOS_STATS_OnKey)
    call TriggerAddAction(WosScoreboard___WOS_STATS_CloseTrigger, function WosScoreboard___WOS_STATS_OnClose)
    call TriggerAddAction(WosScoreboard___WOS_STATS_OpacityTrigger, function WosScoreboard___WOS_STATS_OnOpacity)
    call TriggerAddAction(WosScoreboard___WOS_STATS_ExpandTrigger, function WosScoreboard___WOS_STATS_OnExpand)

    set WosScoreboard___WOS_STATS_UpdateTimer=CreateTimer()
    call TimerStart(WosScoreboard___WOS_STATS_UpdateTimer, WosScoreboard___WOS_STATS_UPDATE_PERIOD, true, function WosScoreboard___WOS_STATS_Periodic)
    call BlzFrameSetVisible(WosScoreboard___WOS_STATS_Main, false)
    set gameUI=null
endfunction

function WosScoreboard___WOS_STATS_DelayedInit takes nothing returns nothing
    local timer initTimer= GetExpiredTimer()

    call WosScoreboard___WOS_STATS_CreateUI()
    call DestroyTimer(initTimer)
    set initTimer=null
endfunction

function WosScoreboard___WOS_STATS_Init takes nothing returns nothing
    local timer initTimer= CreateTimer()

    call TimerStart(initTimer, 0.00, false, function WosScoreboard___WOS_STATS_DelayedInit)
    set initTimer=null
endfunction


//library WosScoreboard ends
//library ErzaBase:
   
    //----------------------------Erza-----------------------------------------------
     
    function ErzaBaseAbiBlock takes unit c,boolean b returns nothing
        local integer i= GetPlayerId(GetOwningPlayer(c))
        call h__SetPlayerAbilityAvailable(Player(i), ErzaQ_ID, b)
        call h__SetPlayerAbilityAvailable(Player(i), ErzaW_ID, b)
        call h__SetPlayerAbilityAvailable(Player(i), ErzaE_ID, b)
        call h__SetPlayerAbilityAvailable(Player(i), ErzaR_ID, b)
        call h__SetPlayerAbilityAvailable(Player(i), ErzaT_ID, b)
        if b == false then
            call DestroyEffect(EffectSpawn("war3mapimported\\wos_0706Red.mdl" , GetUnitX(c) , GetUnitY(c) , 0 , 1 , 3.5 , 110))
            call DestroyEffect(EffectSpawn("war3mapimported\\wos_mard effect 2.mdl" , GetUnitX(c) , GetUnitY(c) , 0 , 1 , 1.35 , 0))
        else
            if CheckCoordsInRect(gg_rct_Base , GetUnitX(c) , GetUnitY(c)) == false then
                if GetRandomInt(1, 2) == 1 then
                    call MakeSound("war3mapImported\\Hero_Erza_F_Cancel")
                else
                    call MakeSound("war3mapImported\\Hero_Erza_F_Cancel2")
                endif
            endif
        endif
    endfunction
    function ErzaAbiArmorAdd takes unit c,integer id1,integer id2,integer id3,integer id4,integer id5,integer id6,boolean b,integer level returns nothing
        local integer i= GetPlayerId(GetOwningPlayer(c))
        local real cd
        local real cd2
        local real cd3
        if b == true then
            call h__SetPlayerAbilityAvailable(Player(i), id1, b)
            call h__SetPlayerAbilityAvailable(Player(i), id2, b)
            call h__SetPlayerAbilityAvailable(Player(i), id3, b)
            call h__SetPlayerAbilityAvailable(Player(i), id4, b)
            call h__SetPlayerAbilityAvailable(Player(i), id5, b)
            if id6 != 0 then
                call h__SetPlayerAbilityAvailable(Player(i), id6, b)
            endif
            if GetUnitAbilityLevel(c, id1) == 0 then
                call UnitAddAbility(c, id1)
                call UnitAddAbility(c, id2)
                call UnitAddAbility(c, id3)
                call UnitAddAbility(c, id4)
                call UnitAddAbility(c, id5)
                if id6 != 0 then
                    call UnitAddAbility(c, id6)
                    call UnitMakeAbilityPermanent(c, b, id6)
                endif
                call UnitMakeAbilityPermanent(c, b, id1)
                call UnitMakeAbilityPermanent(c, b, id2)
                call UnitMakeAbilityPermanent(c, b, id3)
                call UnitMakeAbilityPermanent(c, b, id4)
                call UnitMakeAbilityPermanent(c, b, id5)
                call SetUnitAbilityLevel(c, id1, level)
                call SetUnitAbilityLevel(c, id2, level)
                call SetUnitAbilityLevel(c, id3, level)
                call SetUnitAbilityLevel(c, id4, level)
                call SetUnitAbilityLevel(c, id5, level)
            else
                call SetUnitAbilityLevel(c, id1, level)
                call SetUnitAbilityLevel(c, id2, level)
                call SetUnitAbilityLevel(c, id3, level)
                call SetUnitAbilityLevel(c, id4, level)
                call SetUnitAbilityLevel(c, id5, level)
            endif
     //-------------------------------------------------------
            if id1 == Erza1Q_ID or id1 == Erza2Q_ID or id1 == Erza3Q_ID then
                set cd=BlzGetUnitAbilityCooldownRemaining(c, Erza1Q_ID)
                set cd2=BlzGetUnitAbilityCooldownRemaining(c, Erza2Q_ID)
                set cd3=BlzGetUnitAbilityCooldownRemaining(c, Erza3Q_ID)
                if cd > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza2Q_ID, cd)
                    call BlzStartUnitAbilityCooldown(c, Erza3Q_ID, cd)
                elseif cd2 > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza1Q_ID, cd2)
                    call BlzStartUnitAbilityCooldown(c, Erza3Q_ID, cd2)
                elseif cd3 > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza1Q_ID, cd3)
                    call BlzStartUnitAbilityCooldown(c, Erza2Q_ID, cd3)
                endif
            endif
            if id4 == Erza2R_ID or id4 == Erza3R_ID then
                set cd2=BlzGetUnitAbilityCooldownRemaining(c, Erza2R_ID)
                set cd3=BlzGetUnitAbilityCooldownRemaining(c, Erza3R_ID)
                if cd2 > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza3R_ID, cd2)
                elseif cd3 > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza2R_ID, cd3)
                endif
            endif
            if id5 == Erza1T_ID or id5 == Erza2T_ID or id5 == Erza3T_ID then
                set cd=BlzGetUnitAbilityCooldownRemaining(c, Erza1T_ID)
                set cd2=BlzGetUnitAbilityCooldownRemaining(c, Erza2T_ID)
                set cd3=BlzGetUnitAbilityCooldownRemaining(c, Erza3T_ID)
                if cd > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza2T_ID, cd)
                    call BlzStartUnitAbilityCooldown(c, Erza3T_ID, cd)
                elseif cd2 > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza1T_ID, cd2)
                    call BlzStartUnitAbilityCooldown(c, Erza3T_ID, cd2)
                elseif cd3 > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza1T_ID, cd3)
                    call BlzStartUnitAbilityCooldown(c, Erza2T_ID, cd3)
                endif
            endif
    //--------------R and T LoadInteger(hs,GetHandleId(c),StringHash("erza g2 type"))--------------------------------
            if id1 == Erza4Q_ID or id1 == Erza5Q_ID then
                set cd=BlzGetUnitAbilityCooldownRemaining(c, Erza4Q_ID)
                set cd2=BlzGetUnitAbilityCooldownRemaining(c, Erza5Q_ID)
                if cd > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza5Q_ID, cd)
                elseif cd2 > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza4Q_ID, cd2)
                endif
            endif
            if id2 == Erza4W_ID or id2 == Erza5W_ID then
                set cd=BlzGetUnitAbilityCooldownRemaining(c, Erza4W_ID)
                set cd2=BlzGetUnitAbilityCooldownRemaining(c, Erza5W_ID)
                if cd > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza5W_ID, cd)
                elseif cd2 > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza4W_ID, cd2)
                endif
            endif
            if id3 == Erza4E_ID or id3 == Erza5E_ID then
                set cd=BlzGetUnitAbilityCooldownRemaining(c, Erza4E_ID)
                set cd2=BlzGetUnitAbilityCooldownRemaining(c, Erza5E_ID)
                if cd > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza5E_ID, cd)
                elseif cd2 > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza4E_ID, cd2)
                endif
            endif
            if id4 == Erza4R_ID or id4 == Erza5R_ID then
                set cd=BlzGetUnitAbilityCooldownRemaining(c, Erza4R_ID)
                set cd2=BlzGetUnitAbilityCooldownRemaining(c, Erza5R_ID)
                if cd > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza5R_ID, cd)
                elseif cd2 > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza4R_ID, cd2)
                endif
            endif
            if id5 == Erza4T_ID or id5 == Erza5T_ID then
                set cd=BlzGetUnitAbilityCooldownRemaining(c, Erza4T_ID)
                set cd2=BlzGetUnitAbilityCooldownRemaining(c, Erza5T_ID)
                if cd > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza5T_ID, cd)
                elseif cd2 > 0 then
                    call BlzStartUnitAbilityCooldown(c, Erza4T_ID, cd2)
                endif
            endif
    //-----------------------------------------------------------
        else
            call h__SetPlayerAbilityAvailable(Player(i), id1, b)
            call h__SetPlayerAbilityAvailable(Player(i), id2, b)
            call h__SetPlayerAbilityAvailable(Player(i), id3, b)
            call h__SetPlayerAbilityAvailable(Player(i), id4, b)
            call h__SetPlayerAbilityAvailable(Player(i), id5, b)
            if id6 != 0 then
                call h__SetPlayerAbilityAvailable(Player(i), id6, b)
            endif
        endif
    endfunction
    function ErzaF_Start takes unit c returns nothing
        local integer id= GetHandleId(c)
        local integer i= GetPlayerId(GetOwningPlayer(c))
        local integer sh1= StringHash("q armor active")
        local integer sh2= StringHash("w armor active")
        local integer sh3= StringHash("e armor active")
        local integer sh4= StringHash("r armor active")
        local integer sh5= StringHash("t armor active")
        local integer sh6= StringHash("g armor active")
        local integer k
        local real hp= GetUnitState(c, UNIT_STATE_LIFE) / GetUnitState(c, UNIT_STATE_MAX_LIFE)
        local real cd
        local integer check= 0
        if GetUnitAbilityLevel(c, ErzaG2_ID) > 0 then
            call h__SetPlayerAbilityAvailable(GetOwningPlayer(c), ErzaG2_ID, true)
            call h__SetPlayerAbilityAvailable(GetOwningPlayer(c), ErzaG_ID, false)
        else
            call h__SetPlayerAbilityAvailable(GetOwningPlayer(c), ErzaG_ID, true)
        endif
        if LoadInteger(hs, id, sh1) == 1 then
            set check=1
            call BlzSetUnitMaxHP(c, BlzGetUnitMaxHP(c) - ErzaQ_ArmorStatHpBase - ( ErzaQ_ArmorStatHpStep * ( GetUnitAbilityLevel(c, ErzaQ_ID) - 1 ) ))
            call SetUnitState(c, UNIT_STATE_LIFE, GetUnitState(c, UNIT_STATE_MAX_LIFE) * hp)
            call UnitRemoveAbility(c, ErzaQ_ArmorStat_ID)
            call ErzaAbiArmorAdd(c , Erza1Q_ID , Erza1W_ID , Erza1E_ID , Erza1R_ID , Erza1T_ID , 0 , false , GetUnitAbilityLevel(c, ErzaQ_ID))
            call ErzaBaseAbiBlock(c , true)
            call SaveInteger(hs, id, sh1, 0)
        elseif LoadInteger(hs, id, sh2) == 1 then
            call ErzaBaseAbiBlock(c , true)
            set check=1
            call UnitRemoveAbility(c, ErzaW_Regen0_ID)
            call UnitRemoveAbility(c, ErzaW_Regen1_ID)
            call UnitRemoveAbility(c, ErzaW_Regen2_ID)
            call UnitRemoveAbility(c, ErzaW_Regen3_ID)
            call UnitRemoveAbility(c, ErzaW_Regen4_ID)
            //call BlzSetUnitRealField(c, UNIT_RF_HIT_POINTS_REGENERATION_RATE, BlzGetUnitRealField(c, UNIT_RF_HIT_POINTS_REGENERATION_RATE) - (ErzaW_ArmorStatHpRegenBase + (ErzaW_ArmorStatHpRegenStep * (GetUnitAbilityLevel(c, ErzaW_ID) - 1))))
            call ErzaAbiArmorAdd(c , Erza2Q_ID , Erza2W_ID , Erza2E_ID , Erza2R_ID , Erza2T_ID , 0 , false , GetUnitAbilityLevel(c, ErzaW_ID))
            call SaveInteger(hs, id, sh2, 0)
        elseif LoadInteger(hs, id, sh3) == 1 then
            call ErzaBaseAbiBlock(c , true)
            set check=1
            call AddSpellLevel(c , 'A01C' , ErzaE_ArmorMS_LvLBase_ID + ( ErzaE_ArmorMS_LvLStep_ID * ( GetUnitAbilityLevel(c, ErzaW_ID) - 1 ) ) , false)
            call BlzSetUnitRealField(c, UNIT_RF_MANA_REGENERATION, BlzGetUnitRealField(c, UNIT_RF_MANA_REGENERATION) - ( ErzaE_ArmorStatMpRegenBase + ( ErzaE_ArmorStatMpRegenStep * ( GetUnitAbilityLevel(c, ErzaE_ID) - 1 ) ) ))
            call SaveInteger(hs, id, sh3, 0)
            call ErzaAbiArmorAdd(c , Erza3Q_ID , Erza3W_ID , Erza3E_ID , Erza3R_ID , Erza3T_ID , 0 , false , GetUnitAbilityLevel(c, ErzaE_ID))
        elseif LoadInteger(hs, id, sh4) == 1 then
            call BlzSetUnitMaxHP(c, BlzGetUnitMaxHP(c) - ( ErzaR_ArmorStatHpBase + ( ErzaR_ArmorStatHpStep * ( GetUnitAbilityLevel(c, ErzaR_ID) - 1 ) ) ))
            call SetUnitState(c, UNIT_STATE_LIFE, GetUnitState(c, UNIT_STATE_MAX_LIFE) * hp)
            call AddSpellLevel(c , 'A01C' , ErzaR_ArmorMS_LvLBase_ID + ( ErzaR_ArmorMS_LvLStep_ID * ( GetUnitAbilityLevel(c, ErzaR_ID) - 1 ) ) , false)
            call UnitRemoveAbility(c, ErzaR_ArmorStatAS_ID)
            call UnitRemoveAbility(c, ErzaR_ArmorStatEvade_ID)
            call ErzaBaseAbiBlock(c , true)
            set check=1
            call SaveInteger(hs, id, sh4, 0)
            set k=LoadInteger(hs, GetHandleId(c), StringHash("e stacks"))
            set cd=BlzGetUnitAbilityCooldown(c, Erza4E_ID, GetUnitAbilityLevel(c, Erza4E_ID) - 1)
            if k > 0 then
                call s__GearSystems2__KS_Flush_Start((GetHandleId(c) ) , ( StringHash("e stacks") ) , ( 0 ) , (( 1)*1.0)) // INLINED!!
                call BlzStartUnitAbilityCooldown(c, Erza4E_ID, cd)
            endif
            call SaveInteger(hs, GetHandleId(c), StringHash("e stacks"), 0)
            call ErzaAbiArmorAdd(c , Erza4Q_ID , Erza4W_ID , Erza4E_ID , Erza4R_ID , Erza4T_ID , Erza4F_ID , false , GetUnitAbilityLevel(c, ErzaR_ID))
        elseif LoadInteger(hs, id, sh5) == 1 then
            set check=1
            call BlzSetUnitMaxHP(c, BlzGetUnitMaxHP(c) - ErzaT_ArmorStatHpBase)
            call SetUnitState(c, UNIT_STATE_LIFE, GetUnitState(c, UNIT_STATE_MAX_LIFE) * hp)
            call ErzaBaseAbiBlock(c , true)
            call SaveInteger(hs, id, sh5, 0)
            call ErzaAbiArmorAdd(c , Erza5Q_ID , Erza5W_ID , Erza5E_ID , Erza5R_ID , Erza5T_ID , Erza5F_ID , false , GetUnitAbilityLevel(c, ErzaT_ID))
        elseif LoadInteger(hs, id, sh6) == 1 then
            set check=1
            call BlzSetUnitMaxHP(c, BlzGetUnitMaxHP(c) - ErzaT_ArmorStatHpBase)
            call SetUnitState(c, UNIT_STATE_LIFE, GetUnitState(c, UNIT_STATE_MAX_LIFE) * hp)
            call SaveInteger(hs, GetHandleId(c), StringHash("erza g2 active"), 0)
            call ErzaBaseAbiBlock(c , true)
            call SaveInteger(hs, id, sh6, 0)
            call ErzaAbiArmorAdd(c , Erza6Q_ID , Erza6W_ID , Erza6E_ID , Erza6R_ID , Erza6T_ID , 0 , false , GetUnitAbilityLevel(c, ErzaG2_ID))
            call ErzaAbiArmorAdd(c , Erza7Q_ID , Erza7W_ID , Erza7E_ID , Erza7R_ID , Erza7T_ID , 0 , false , GetUnitAbilityLevel(c, ErzaG2_ID))
        endif
        // The synergy dummy belongs only to the R armor. Clear it on every
        // form exit as a safeguard against stale armor flags and repicks.
        if s__ErzaR_NatsuGrayDummy[i] != null then
            call RemoveUnit(s__ErzaR_NatsuGrayDummy[i])
            set s__ErzaR_NatsuGrayDummy[i]= null
        endif
        if check > 0 then
            call BlzSetUnitSkin(c, ErzaUnitSkin_ID)
            call FixAura(c)
            call DestroyEffect(AddSpecialEffectTarget("war3mapimported\\wos_[dz_spell]002_blue5.mdl", c, "origin"))
        endif
    endfunction
    function ErzaQ_Start takes unit c returns nothing
        local integer id= GetHandleId(c)
        local integer i= GetPlayerId(GetOwningPlayer(c))
        local integer sh= StringHash("q armor active")
        local real hp= GetUnitState(c, UNIT_STATE_LIFE) / GetUnitState(c, UNIT_STATE_MAX_LIFE)
        call BlzSetUnitSkin(c, ErzaQ_UnitSkin_ID)
        call FixAura(c)
        call SaveInteger(hs, id, sh, 1)
        call ErzaBaseAbiBlock(c , false)
        call s__ErzaQSpells__ErzaE_KS_ErzaE_Start((c)) // INLINED!!
        if GetUnitAbilityLevel(c, ErzaG2_ID) > 0 then
            call h__SetPlayerAbilityAvailable(GetOwningPlayer(c), ErzaG2_ID, false)
            call h__SetPlayerAbilityAvailable(GetOwningPlayer(c), ErzaG_ID, true)
        endif
        call BlzSetUnitMaxHP(c, BlzGetUnitMaxHP(c) + ErzaQ_ArmorStatHpBase + ( ErzaQ_ArmorStatHpStep * ( GetUnitAbilityLevel(c, ErzaQ_ID) - 1 ) ))
        call SetUnitState(c, UNIT_STATE_LIFE, GetUnitState(c, UNIT_STATE_MAX_LIFE) * hp)
        call UnitAddAbility(c, ErzaQ_ArmorStat_ID)
        call SetUnitAbilityLevel(c, ErzaQ_ArmorStat_ID, GetUnitAbilityLevel(c, ErzaQ_ID))
        if LoadInteger(hs, i, StringHash("sound cd2")) == 0 then
            call SaveInteger(hs, i, StringHash("sound cd2"), 1)
            call s__GearSystems2__KS_Flush_Start((i ) , ( StringHash("sound cd2") ) , ( 0 ) , (( 10)*1.0)) // INLINED!!
            if GetRandomInt(1, 2) == 1 then
                call MakeSound("war3mapImported\\Hero_Erza1_Start")
            else
                call MakeSound("war3mapImported\\Hero_Erza1_Start2")
            endif
        endif
        call ErzaAbiArmorAdd(c , Erza1Q_ID , Erza1W_ID , Erza1E_ID , Erza1R_ID , Erza1T_ID , 0 , true , GetUnitAbilityLevel(c, ErzaQ_ID))
    endfunction
    function ErzaW_Start takes unit c returns nothing
        local integer id= GetHandleId(c)
        local integer i= GetPlayerId(GetOwningPlayer(c))
        local integer sh= StringHash("w armor active")
        //call BlzSetUnitRealField(c, UNIT_RF_HIT_POINTS_REGENERATION_RATE, BlzGetUnitRealField(c, UNIT_RF_HIT_POINTS_REGENERATION_RATE) + ErzaW_ArmorStatHpRegenBase + (ErzaW_ArmorStatHpRegenStep * (GetUnitAbilityLevel(c, ErzaW_ID) - 1)))
        if GetUnitAbilityLevel(c, ErzaW_ID) == 1 then
            call UnitAddAbility(c, ErzaW_Regen0_ID)
        elseif GetUnitAbilityLevel(c, ErzaW_ID) == 2 then
            call UnitAddAbility(c, ErzaW_Regen1_ID)
        elseif GetUnitAbilityLevel(c, ErzaW_ID) == 3 then
            call UnitAddAbility(c, ErzaW_Regen2_ID)
        elseif GetUnitAbilityLevel(c, ErzaW_ID) == 4 then
            call UnitAddAbility(c, ErzaW_Regen3_ID)
        elseif GetUnitAbilityLevel(c, ErzaW_ID) == 5 then
            call UnitAddAbility(c, ErzaW_Regen4_ID)
        endif
        if GetUnitAbilityLevel(c, ErzaG2_ID) > 0 then
            call h__SetPlayerAbilityAvailable(GetOwningPlayer(c), ErzaG2_ID, false)
            call h__SetPlayerAbilityAvailable(GetOwningPlayer(c), ErzaG_ID, true)
        endif
        call BlzSetUnitSkin(c, ErzaW_UnitSkin_ID)
        call FixAura(c)
        call SaveInteger(hs, id, sh, 1)
        call ErzaBaseAbiBlock(c , false)
        if LoadInteger(hs, i, StringHash("sound cd3")) == 0 then
            call SaveInteger(hs, i, StringHash("sound cd3"), 1)
            call s__GearSystems2__KS_Flush_Start((i ) , ( StringHash("sound cd3") ) , ( 0 ) , (( 10)*1.0)) // INLINED!!
            call MakeSound("war3mapImported\\Hero_Erza2_Start")
        endif
        call ErzaAbiArmorAdd(c , Erza2Q_ID , Erza2W_ID , Erza2E_ID , Erza2R_ID , Erza2T_ID , 0 , true , GetUnitAbilityLevel(c, ErzaW_ID))
    endfunction
    function ErzaE_Start takes unit c returns nothing
        local integer id= GetHandleId(c)
        local integer i= GetPlayerId(GetOwningPlayer(c))
        local integer sh= StringHash("e armor active")
        call BlzSetUnitSkin(c, ErzaE_UnitSkin_ID)
        call FixAura(c)
        call SaveInteger(hs, id, sh, 1)
        call AddSpellLevel(c , 'A01C' , ErzaE_ArmorMS_LvLBase_ID + ( ErzaE_ArmorMS_LvLStep_ID * ( GetUnitAbilityLevel(c, ErzaW_ID) - 1 ) ) , true)
        call BlzSetUnitRealField(c, UNIT_RF_MANA_REGENERATION, BlzGetUnitRealField(c, UNIT_RF_MANA_REGENERATION) + ( ErzaE_ArmorStatMpRegenBase + ( ErzaE_ArmorStatMpRegenStep * ( GetUnitAbilityLevel(c, ErzaE_ID) - 1 ) ) ))
        call ErzaBaseAbiBlock(c , false)
        if LoadInteger(hs, i, StringHash("sound cd4")) == 0 then
            call SaveInteger(hs, i, StringHash("sound cd4"), 1)
            call s__GearSystems2__KS_Flush_Start((i ) , ( StringHash("sound cd4") ) , ( 0 ) , (( 10)*1.0)) // INLINED!!
            call MakeSound("war3mapImported\\Hero_Erza3_Start")
        endif
        if GetUnitAbilityLevel(c, ErzaG2_ID) > 0 then
            call h__SetPlayerAbilityAvailable(GetOwningPlayer(c), ErzaG2_ID, false)
            call h__SetPlayerAbilityAvailable(GetOwningPlayer(c), ErzaG_ID, true)
        endif
        call ErzaAbiArmorAdd(c , Erza3Q_ID , Erza3W_ID , Erza3E_ID , Erza3R_ID , Erza3T_ID , 0 , true , GetUnitAbilityLevel(c, ErzaE_ID))
    endfunction
    function ErzaR_Start takes unit c returns nothing
        local integer id= GetHandleId(c)
        local integer i= GetPlayerId(GetOwningPlayer(c))
        local integer sh= StringHash("r armor active")
        local integer stacks= 3 - LoadInteger(hs, GetHandleId(c), StringHash("e stacks"))
        local real hp= GetUnitState(c, UNIT_STATE_LIFE) / GetUnitState(c, UNIT_STATE_MAX_LIFE)
        local real x= GetUnitX(c)
        local real y= GetUnitY(c)
        local group g= CreateGroup()
        local unit u= null
        local integer k2= 0
        local integer k3= 0
        call GroupEnumUnitsInRange(g, x, y, 1800, NoDecor_Cond)
        loop
            set u=FirstOfGroup(g)
            exitwhen u == null
            if IsUnitAlly(u, GetOwningPlayer(c)) and GetWidgetLife(u) > 0.405 and not IsUnitType(u, UNIT_TYPE_DEAD) and not IsUnitHidden(u) then
                if GetUnitTypeId(u) == Gray_ID1 or GetUnitTypeId(u) == Gray_ID2 then
                    set k2=k2 + 1
                endif
                if GetUnitTypeId(u) == Natsu_ID then
                    set k3=k3 + 1
                endif
            endif
            call GroupRemoveUnit(g, u)
        endloop
        if k2 > 0 and k3 > 0 then
            if s__ErzaR_NatsuGrayDummy[i] == null then
                set s__ErzaR_NatsuGrayDummy[i]= CreateUnit(GetOwningPlayer(c), ErzaR_DummyElementalId, x, y, 0)
            endif
        else
            if s__ErzaR_NatsuGrayDummy[i] != null then
                call RemoveUnit(s__ErzaR_NatsuGrayDummy[i])
                set s__ErzaR_NatsuGrayDummy[i]= null
            endif
        endif
        if GetUnitAbilityLevel(c, ErzaG2_ID) > 0 then
            call h__SetPlayerAbilityAvailable(GetOwningPlayer(c), ErzaG2_ID, false)
        else
            call h__SetPlayerAbilityAvailable(GetOwningPlayer(c), ErzaG_ID, false)
        endif
        call BlzSetUnitMaxHP(c, BlzGetUnitMaxHP(c) + ( ErzaR_ArmorStatHpBase + ( ErzaR_ArmorStatHpStep * ( GetUnitAbilityLevel(c, ErzaR_ID) - 1 ) ) ))
        call SetUnitState(c, UNIT_STATE_LIFE, GetUnitState(c, UNIT_STATE_MAX_LIFE) * hp)
        call AddSpellLevel(c , 'A01C' , ErzaR_ArmorMS_LvLBase_ID + ( ErzaR_ArmorMS_LvLStep_ID * ( GetUnitAbilityLevel(c, ErzaR_ID) - 1 ) ) , true)
        call UnitAddAbility(c, ErzaR_ArmorStatAS_ID)
        call SetUnitAbilityLevel(c, ErzaR_ArmorStatAS_ID, GetUnitAbilityLevel(c, ErzaR_ID))
        call UnitAddAbility(c, ErzaR_ArmorStatEvade_ID)
        call h__SetPlayerAbilityAvailable(GetOwningPlayer(c), ErzaR_ArmorStatEvade_ID, false)
        call BlzSetUnitSkin(c, ErzaR_UnitSkin_ID)
        call FixAura(c)
        call SaveInteger(hs, id, sh, 1)
