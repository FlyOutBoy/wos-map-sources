                                    if SpellBool(s__BarraganSpells___HeroSpells_Q_u[this]) and IsUnitEnemy(s__BarraganSpells___HeroSpells_Q_u[this], GetOwningPlayer(s__BarraganSpells___HeroSpells_Q_c[this])) and IsUnitInGroup(s__BarraganSpells___HeroSpells_Q_u[this], s__BarraganSpells___HeroSpells_Q_g2[this]) == false then
                                        call dmgmag(s__BarraganSpells___HeroSpells_Q_c[this] , s__BarraganSpells___HeroSpells_Q_u[this] , s__BarraganSpells___HeroSpells_Q_dmg[this])
                                        call GroupAddUnit(s__BarraganSpells___HeroSpells_Q_g2[this], s__BarraganSpells___HeroSpells_Q_u[this])
                                    endif
