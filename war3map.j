    function BambiettaG_Start takes unit c returns nothing
        if LoadInteger(hs, GetHandleId(GetOwningPlayer(c)), StringHash("morph t")) == 0 then
            call s__GearSystems2__KS_FakeCooldown_FakeCD_Start1((c ) , ( BambiettaG_ID ) , (( BambiettaG_CD )*1.0) , ( 0 ) , ( 0)) // INLINED!!
        else
            call s__KS_SpellStacks_MyRemoveStack((c)) // INLINED!!
            if LoadInteger(hs, GetHandleId(c), StringHash("stack_count")) == 0 then
                call s__GearSystems2__KS_FakeCooldown_FakeCD_Start1((c ) , ( BambiettaG_ID ) , (( BambiettaG_CD )*1.0) , ( 0 ) , ( 0)) // INLINED!!
            endif
        endif
    endfunction

    function BambiettaG2_Start takes unit c,real x,real y returns nothing
        local group g= CreateGroup()
        local unit u= null
        local real a= GAngle2(c , x , y)
        local real aoe= 400
        local real dmg= 0
        call MakeSound("war3mapimported\\Hero_Bambietta_G")
        if GetHeroLevel(c) >= 35 then
            set dmg=BambiettaG_DamageAgiBase35 * GetHeroAgi(c, true)
        elseif GetHeroLevel(c) >= 25 then
            set dmg=BambiettaG_DamageAgiBase25 * GetHeroAgi(c, true)
        else
            set dmg=BambiettaG_DamageAgiBase12 * GetHeroAgi(c, true)
        endif
        if LoadInteger(hs, GetHandleId(GetOwningPlayer(c)), StringHash("morph t")) == 0 then
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_AZ_D073.mdl" , x , y , a * bj_RADTODEG , 1.35 , 1 , 1))
            call ColorEffDummy3(EffectSpawn("war3mapImported\\wos_A_P_blast3.mdl" , x , y , a * bj_RADTODEG , 2.15 , 1 , 1) , 0.15 , 255 , 255 , 255 , 0.45)
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_YC_CrossFlash.mdl" , x + 25 * Cos(a) , y + 25 * Sin(a) , 1 , 1.15 , 1.475 , 125))
        else
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_AZ_D073red.mdl" , x , y , a * bj_RADTODEG , 1.35 , 1 , 1))
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_YC_CrossFlashred.mdl" , x + 25 * Cos(a) , y + 25 * Sin(a) , 1 , 1.15 , 1.475 , 125))
            call ColorEffDummy3(EffectSpawn("war3mapImported\\wos_A_P_blast3red.mdl" , x , y , a * bj_RADTODEG , 2.15 , 1 , 1) , 0.15 , 255 , 255 , 255 , 0.45)
        endif
        call VisionTimed(GetOwningPlayer(c) , x , y , 700 , 1.5)
        call DecorRemove(c , x , y , aoe , BambiettaG_DecorDamage)
        call GroupEnumUnitsInRange(g, x, y, aoe, NoDecor_Cond)
        loop
            set u=FirstOfGroup(g)
            exitwhen u == null
            if SpellBool(u) and IsUnitEnemy(u, GetOwningPlayer(c)) then
                call s__GearSystems2__KS_DelayedDamage_NextDmg_Start((c ) , ( u ) , (( dmg )*1.0) , ( 0 ) , (( 0.1)*1.0)) // INLINED!!
            endif
            call GroupRemoveUnit(g, u)
        endloop
        call DestroyGroup(g)
        set u=null
        set g=null
    endfunction

//library BambiettaSpells ends
//library BarraganSpells:
    function BarraganPassiveBurn takes unit c,unit td returns nothing
    local real dmg= 0
    if GetHeroLevel(c) >= 35 then
    set dmg=BarraganG_Damage2Static_35
    elseif GetHeroLevel(c) >= 25 then
    set dmg=BarraganG_Damage2Static_25
    else
    set dmg=BarraganG_Damage2Static_6
    endif
    set dmg=dmg + ( GetHeroInt(c, true) * BarraganG_DamageIntBase )
        call s__GearSystems2__KS_DamageOverTime_DmgPTime_Start((c ) , ( td ) , (( dmg )*1.0) , (( BarraganG_DamageDuration )*1.0) , (( BarraganG_DamagePeriodic )*1.0) , ( 1) , "") // INLINED!!
        call EffectSpawnTarget("war3mapImported\\wos_zz-fire-ore-hit1-zihei_2.mdx" , td , "origin" , GetRandomReal(0, 359) , 1.15 , 2 , 0 , BarraganG_DamageDuration)
    endfunction
    

        function s__BarraganSpells___HeroSpells_Q_Loop_BarraganQ takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__BarraganSpells___HeroSpells_Q_MUI_BarraganQ
                set this=s__BarraganSpells___HeroSpells_Q_m_BarraganQ[i]
                if SpellBoolCaster(s__BarraganSpells___HeroSpells_Q_c[this]) and s__BarraganSpells___HeroSpells_Q_r[this] <= s__BarraganSpells___HeroSpells_Q_rmax[this] then
                    set s__BarraganSpells___HeroSpells_Q_r[this]=s__BarraganSpells___HeroSpells_Q_r[this] + 0.03
                    if s__BarraganSpells___HeroSpells_Q_k2[this] == 0 then // 0 - normal spell, 1 - morph spell, 2( only for q) enchaned with T morph spell
                        if s__BarraganSpells___HeroSpells_Q_check[this] == 0 then
                            if s__BarraganSpells___HeroSpells_Q_r[this] >= 0.57 then
                                call StopSpellUnit2(s__BarraganSpells___HeroSpells_Q_c[this])
                                call DestroyEffect(s__BarraganSpells___HeroSpells_Q_e2[this])
                                set s__BarraganSpells___HeroSpells_Q_check[this]=1
                                call MakeSound("war3mapimported\\Hero_Barragan_Q2")
                                set s__BarraganSpells___HeroSpells_Q_x1[this]=( GetUnitX(s__BarraganSpells___HeroSpells_Q_c[this]) + 20 * Cos(s__BarraganSpells___HeroSpells_Q_a[this] + 90 * bj_DEGTORAD) ) + 79 * Cos(s__BarraganSpells___HeroSpells_Q_a[this])
                                set s__BarraganSpells___HeroSpells_Q_y1[this]=( GetUnitY(s__BarraganSpells___HeroSpells_Q_c[this]) + 20 * Sin(s__BarraganSpells___HeroSpells_Q_a[this] + 90 * bj_DEGTORAD) ) + 79 * Sin(s__BarraganSpells___HeroSpells_Q_a[this])
                                set s__BarraganSpells___HeroSpells_Q_move[this]=0
                                set s__BarraganSpells___HeroSpells_Q_scale[this]=0.5
                                set s__BarraganSpells___HeroSpells_Q_rmax[this]=1.5
                                set s__BarraganSpells___HeroSpells_Q_r[this]=0
                                set s__BarraganSpells___HeroSpells_Q_r7[this]=0
                            endif
                        elseif s__BarraganSpells___HeroSpells_Q_check[this] == 1 then
                           
                            set s__BarraganSpells___HeroSpells_Q_k[this]=0
                            loop
                                exitwhen s__BarraganSpells___HeroSpells_Q_k[this] > 1
                                if s__BarraganSpells___HeroSpells_Q_r[this] < 0.09 then
                                    set s__BarraganSpells___HeroSpells_Q_move[this]=s__BarraganSpells___HeroSpells_Q_move[this] + 9 + ( s__BarraganSpells___HeroSpells_Q_scale[this] * 8 )
                                else
                                    set s__BarraganSpells___HeroSpells_Q_move[this]=s__BarraganSpells___HeroSpells_Q_move[this] + 18 + ( s__BarraganSpells___HeroSpells_Q_scale[this] * 9 )
                                endif
                                if (CheckCoordsInRect(gg_rct_Arena , ((s__BarraganSpells___HeroSpells_Q_x1[this] + s__BarraganSpells___HeroSpells_Q_move[this] * Cos(s__BarraganSpells___HeroSpells_Q_a[this]) )*1.0) , (( s__BarraganSpells___HeroSpells_Q_y1[this] + s__BarraganSpells___HeroSpells_Q_move[this] * Sin(s__BarraganSpells___HeroSpells_Q_a[this]))*1.0))) then // INLINED!!
                                    set s__BarraganSpells___HeroSpells_Q_x[this]=s__BarraganSpells___HeroSpells_Q_x1[this] + s__BarraganSpells___HeroSpells_Q_move[this] * Cos(s__BarraganSpells___HeroSpells_Q_a[this])
                                    set s__BarraganSpells___HeroSpells_Q_y[this]=s__BarraganSpells___HeroSpells_Q_y1[this] + s__BarraganSpells___HeroSpells_Q_move[this] * Sin(s__BarraganSpells___HeroSpells_Q_a[this])
                                endif
                                call EffectSpawnColor2("war3mapimported\\wos_ulqashar.mdx" , s__BarraganSpells___HeroSpells_Q_x[this] , s__BarraganSpells___HeroSpells_Q_y[this] , s__BarraganSpells___HeroSpells_Q_a[this] * bj_RADTODEG , 1 , s__BarraganSpells___HeroSpells_Q_scale[this] , 180 + s__BarraganSpells___HeroSpells_Q_r[this] * 80 , 0.51 , 255 , 25 , 25 , 255)
                                call EffectSpawnColor2("war3mapimported\\wos_ulqashar.mdx" , s__BarraganSpells___HeroSpells_Q_x[this] , s__BarraganSpells___HeroSpells_Q_y[this] , s__BarraganSpells___HeroSpells_Q_a[this] * bj_RADTODEG , 1 , s__BarraganSpells___HeroSpells_Q_scale[this] * 0.7 , 180 + s__BarraganSpells___HeroSpells_Q_r[this] * 80 , 0.45 , 225 , 225 , 225 , 205)
                                
                                set s__BarraganSpells___HeroSpells_Q_scale[this]=s__BarraganSpells___HeroSpells_Q_scale[this] + 0.3
                                set s__BarraganSpells___HeroSpells_Q_k[this]=s__BarraganSpells___HeroSpells_Q_k[this] + 1
                            endloop
                            set s__BarraganSpells___HeroSpells_Q_r7[this]=s__BarraganSpells___HeroSpells_Q_r7[this] + s__BarraganSpells___HeroSpells_Q_move[this]
