            local integer loopPlayers= 0
            loop
                exitwhen i > s__GearSystems2__KS_TextTagDelay_MUI_21
                set this=s__GearSystems2__KS_TextTagDelay_m_21[i]
                if s__GearSystems2__KS_TextTagDelay_r[this] < s__GearSystems2__KS_TextTagDelay_rmax[this] then
                    set s__GearSystems2__KS_TextTagDelay_r[this]=RoundReal(s__GearSystems2__KS_TextTagDelay_r[this] + 0.05 , 3)
                else
                    set l__txt=CreateTextTag()
                    call SetTextTagVisibility(l__txt, false)
                    loop
                        exitwhen loopPlayers >= 11
                        if IsUnitVisible(s__GearSystems2__KS_TextTagDelay_c[this], Player(loopPlayers)) then
                            if GetLocalPlayer() == Player(loopPlayers) then
                                call SetTextTagVisibility(l__txt, true)
                            endif
                        endif
                        set loopPlayers=loopPlayers + 1
                    endloop
                    call SetTextTagText(l__txt, s__GearSystems2__KS_TextTagDelay_s[this], s__GearSystems2__KS_TextTagDelay_scale[this])
                    call SetTextTagPosUnit(l__txt, s__GearSystems2__KS_TextTagDelay_c[this], 20)
                    call SetTextTagColor(l__txt, s__GearSystems2__KS_TextTagDelay_red_i[this], s__GearSystems2__KS_TextTagDelay_green_i[this], s__GearSystems2__KS_TextTagDelay_blue_i[this], s__GearSystems2__KS_TextTagDelay_check[this])
                    call SetTextTagVelocity(l__txt, 0.1 * Cos(1.571), 0.1 * Sin(1.571))
                    call SetTextTagFadepoint(l__txt, .5)
                    call SetTextTagLifespan(l__txt, 0.85)
                    call SetTextTagPermanent(l__txt, false)
                    set s__GearSystems2__KS_TextTagDelay_c[this]=null
                    set s__GearSystems2__KS_TextTagDelay_s[this]=null
                    set s__GearSystems2__KS_TextTagDelay_m_21[i]=s__GearSystems2__KS_TextTagDelay_m_21[s__GearSystems2__KS_TextTagDelay_MUI_21]
                    set s__GearSystems2__KS_TextTagDelay_MUI_21=s__GearSystems2__KS_TextTagDelay_MUI_21 - 1
                    if s__GearSystems2__KS_TextTagDelay_MUI_21 == - 1 then
                        call GearTimer05Release()
                    endif
                    call s__GearSystems2__KS_TextTagDelay_deallocate(this)
                    set i=i - 1
                endif
                set i=i + 1
            endloop
            set l__txt=null
        endfunction

