            call MakeSound("war3mapImported\\Hero_Patriot_W")
            set s__PatriotSpells___PatriotSpells_W_k2[this]=PatriotW_DurationBase + ( PatriotW_DurationStep * ( level - 1 ) )
            set s__PatriotSpells___PatriotSpells_W_dmg[this]=GetHeroAgi(s__PatriotSpells___PatriotSpells_W_c[this], true) * ( PatriotW_DamageAgiBase + ( PatriotW_DamageAgiStep * ( level - 1 ) ) )
            set s__PatriotSpells___PatriotSpells_W_dmg[this]=s__PatriotSpells___PatriotSpells_W_dmg[this] + PatriotW_Damage2StaticBase + ( PatriotW_Damage2StaticStep * ( level - 1 ) )
            set s__PatriotSpells___PatriotSpells_W_dmg2[this]=GetHeroAgi(s__PatriotSpells___PatriotSpells_W_c[this], true) * ( PatriotW_HealAgiBase + ( PatriotW_HealAgiStep * ( level - 1 ) ) )
            set s__PatriotSpells___PatriotSpells_W_dmg2[this]=s__PatriotSpells___PatriotSpells_W_dmg2[this] + PatriotW_Heal2StaticBase + ( PatriotW_Heal2StaticStep * ( level - 1 ) )
            set s__PatriotSpells___PatriotSpells_W_rmax[this]=15.0
