                                    call dmgphys(s__AinzSpells__AinzW_KS_c[this] , s__AinzSpells__AinzW_KS_u[this] , s__AinzSpells__AinzW_KS_dmg[this])
                                endif
                                set wallMove=s__UnitMoveWall_GetMoveDistance(s__AinzSpells__AinzW_KS_d[this] , GetUnitX(s__AinzSpells__AinzW_KS_d[this]) , GetUnitY(s__AinzSpells__AinzW_KS_d[this]) , s__AinzSpells__AinzW_KS_a[this] , AinzW_KnightSpeed)
                                if wallMove < AinzW_KnightSpeed then
                                    if not IsUnitInGroup(s__AinzSpells__AinzW_KS_u[this], s__AinzSpells__AinzW_KS_g3[this]) then
