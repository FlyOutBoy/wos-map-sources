                                        call GroupAddUnit(s__RaidenSpells__RaidenQ_KS_g2[this], s__RaidenSpells__RaidenQ_KS_u[this])
                                        call dmgmag(s__RaidenSpells__RaidenQ_KS_c[this] , s__RaidenSpells__RaidenQ_KS_u[this] , s__RaidenSpells__RaidenQ_KS_dmg[this])
                                        call StunUnit(s__RaidenSpells__RaidenQ_KS_c[this] , s__RaidenSpells__RaidenQ_KS_u[this] , RaidenQ_StunTime)
                                        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", s__RaidenSpells__RaidenQ_KS_u[this], "chest"))
                                        call MUE(s__RaidenSpells__RaidenQ_KS_u[this] , RaidenQ_PushRange , RaidenQ_PushDuration , s__RaidenSpells__RaidenQ_KS_a[this])
                                    endif
                                    call GroupRemoveUnit(s__RaidenSpells__RaidenQ_KS_g[this], s__RaidenSpells__RaidenQ_KS_u[this])
                                endloop
                                set s__RaidenSpells__RaidenQ_KS_u[this]=null
                            else
                                set s__RaidenSpells__RaidenQ_KS_r2[this]=s__RaidenSpells__RaidenQ_KS_r2[this] + 0.03
                            endif
                        endif
                        set s__RaidenSpells__RaidenQ_KS_x[this]=GetUnitX(s__RaidenSpells__RaidenQ_KS_c[this]) + 85 * Cos(s__RaidenSpells__RaidenQ_KS_a[this])
                        set s__RaidenSpells__RaidenQ_KS_y[this]=GetUnitY(s__RaidenSpells__RaidenQ_KS_c[this]) + 85 * Sin(s__RaidenSpells__RaidenQ_KS_a[this])
                        call DebugUnit2(s__RaidenSpells__RaidenQ_KS_c[this])
                        if s__RaidenSpells__RaidenQ_KS_r[this] == s__RaidenSpells__RaidenQ_KS_r_prepare[this] + 0.03 then
                            call SetUnitAnimationByIndex(s__RaidenSpells__RaidenQ_KS_c[this], 11)
                        endif
                        if s__RaidenSpells__RaidenQ_KS_r[this] == s__RaidenSpells__RaidenQ_KS_r_prepare[this] + 0.15 then
                            call ColorEffDummy3(EffectSpawn("war3mapImported\\wos_RaidenEi-12.mdl" , s__RaidenSpells__RaidenQ_KS_x[this] + 105 * Cos(s__RaidenSpells__RaidenQ_KS_a[this]) , s__RaidenSpells__RaidenQ_KS_y[this] + 105 * Sin(s__RaidenSpells__RaidenQ_KS_a[this]) , s__RaidenSpells__RaidenQ_KS_a[this] * bj_RADTODEG , 1.15 , s__RaidenSpells__RaidenQ_KS_scale[this] * 0.164 , 215) , 1 , 255 , 255 , 255 , 0.06)
                        endif
                        if s__RaidenSpells__RaidenQ_KS_r[this] == s__RaidenSpells__RaidenQ_KS_r_prepare[this] + 0.30 then
                            call ColorEffDummy3(EffectSpawn("war3mapImported\\wos_RaidenEi-11.mdl" , s__RaidenSpells__RaidenQ_KS_x[this] + 105 * Cos(s__RaidenSpells__RaidenQ_KS_a[this]) , s__RaidenSpells__RaidenQ_KS_y[this] + 105 * Sin(s__RaidenSpells__RaidenQ_KS_a[this]) , s__RaidenSpells__RaidenQ_KS_a[this] * bj_RADTODEG , 1.15 , s__RaidenSpells__RaidenQ_KS_scale[this] * 0.164 , 215) , 1 , 255 , 255 , 255 , 0.06)
                        endif
                    endif
                else
                    call SaveInteger(hs, GetHandleId(s__RaidenSpells__RaidenQ_KS_c[this]), StringHash("q abi"), 0)
                    call SetUnitAnimation(s__RaidenSpells__RaidenQ_KS_c[this], "stand")
                    call StopSpellUnit2(s__RaidenSpells__RaidenQ_KS_c[this])
                    call DestroyGroup(s__RaidenSpells__RaidenQ_KS_g[this])
