                    if s__BazzBSpells___BazzBSpells_T_g2[this] != null then
                        call DestroyGroup(s__BazzBSpells___BazzBSpells_T_g2[this])
                    endif
                    set s__BazzBSpells___BazzBSpells_T_g[this]=null
                    set s__BazzBSpells___BazzBSpells_T_g2[this]=null
                    set s__BazzBSpells___BazzBSpells_T_c[this]=null
                    set u=null
                    set s__BazzBSpells___BazzBSpells_T_m_BazzBT[i]=s__BazzBSpells___BazzBSpells_T_m_BazzBT[s__BazzBSpells___BazzBSpells_T_MUI_BazzBT]
                    set s__BazzBSpells___BazzBSpells_T_MUI_BazzBT=s__BazzBSpells___BazzBSpells_T_MUI_BazzBT - 1
                    call s__BazzBSpells___BazzBSpells_T_deallocate(this)
                    if s__BazzBSpells___BazzBSpells_T_MUI_BazzBT == - 1 then
                        call BazzBSpells___BazzBTimer03Release()
                    endif
                else
                    set i=i + 1
                endif
            endloop
            set u=null
        endfunction

        function s__BazzBSpells___BazzBSpells_T_BazzBT_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this
            if NewC == null or GetUnitTypeId(NewC) == 0 or GetWidgetLife(NewC) <= 0.405 then
                return
            endif
            set this=s__BazzBSpells___BazzBSpells_T__allocate()
            set s__BazzBSpells___BazzBSpells_T_MUI_BazzBT=s__BazzBSpells___BazzBSpells_T_MUI_BazzBT + 1
            set s__BazzBSpells___BazzBSpells_T_m_BazzBT[s__BazzBSpells___BazzBSpells_T_MUI_BazzBT]=this
            set s__BazzBSpells___BazzBSpells_T_c[this]=NewC
            set s__BazzBSpells___BazzBSpells_T_x[this]=NewX
            set s__BazzBSpells___BazzBSpells_T_y[this]=NewY
            set s__BazzBSpells___BazzBSpells_T_r[this]=0.0
            set s__BazzBSpells___BazzBSpells_T_r2[this]=0.0
            set s__BazzBSpells___BazzBSpells_T_r3[this]=0.0
            set s__BazzBSpells___BazzBSpells_T_r4[this]=0.0
            set s__BazzBSpells___BazzBSpells_T_r5[this]=0.0
            set s__BazzBSpells___BazzBSpells_T_r6[this]=0.0
            set s__BazzBSpells___BazzBSpells_T_r7[this]=0.0
            set s__BazzBSpells___BazzBSpells_T_check[this]=0
            call StartSpellUnit(s__BazzBSpells___BazzBSpells_T_c[this])
            set s__BazzBSpells___BazzBSpells_T_g[this]=CreateGroup()
            set s__BazzBSpells___BazzBSpells_T_g2[this]=CreateGroup()
            set s__BazzBSpells___BazzBSpells_T_a[this]=GAngle2(s__BazzBSpells___BazzBSpells_T_c[this] , s__BazzBSpells___BazzBSpells_T_x[this] , s__BazzBSpells___BazzBSpells_T_y[this])
            call DestroyEffect(EffectSpawn("war3mapimported\\wos_HakkeStart.mdx" , GetUnitX(s__BazzBSpells___BazzBSpells_T_c[this]) , GetUnitY(s__BazzBSpells___BazzBSpells_T_c[this]) , GetRandomReal(0.0, 359.0) , 0.3 , 1.45 , 7.0))
            set s__BazzBSpells___BazzBSpells_T_e6[this]=AddSpecialEffectTarget("war3mapImported\\wos_firacharge2.mdx", s__BazzBSpells___BazzBSpells_T_c[this], "hand right")
            set s__BazzBSpells___BazzBSpells_T_aoe[this]=BazzBT_DamageAoe
            set s__BazzBSpells___BazzBSpells_T_dmg[this]=GetHeroAgi(s__BazzBSpells___BazzBSpells_T_c[this], true) * BazzBT_DamageAgiBase
            set s__BazzBSpells___BazzBSpells_T_rmax[this]=3.0
            call s__GearSystems2__KS_RemoveEffect_MyRemoveEff_Start((AddSpecialEffectTarget("war3mapImported\\wos_summon3missle.mdl", s__BazzBSpells___BazzBSpells_T_c[this], "hand right") ) , (( 1.41)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
            call s__GearSystems2__KS_RemoveEffect_MyRemoveEff_Start((AddSpecialEffectTarget("war3mapImported\\wos_summon3missle.mdl", s__BazzBSpells___BazzBSpells_T_c[this], "hand left") ) , (( 1.41)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
            call SetUnitAnimationByIndex(s__BazzBSpells___BazzBSpells_T_c[this], 3)
            call SetUnitTimeScale(s__BazzBSpells___BazzBSpells_T_c[this], 0.65)
            call MakeSound("war3mapimported\\Hero_BazzB_T")
            if s__BazzBSpells___BazzBSpells_T_MUI_BazzBT == 0 then
                call BazzBSpells___BazzBTimer03Acquire()
            endif
        endfunction

