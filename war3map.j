                                    call dmgmag(s__PatriotSpells___PatriotSpells_W_c[this] , u , s__PatriotSpells___PatriotSpells_W_dmg[this] * ( s__PatriotSpells___PatriotSpells_W_k2[this] - s__PatriotSpells___PatriotSpells_W_k3[this] ))
                                endif
