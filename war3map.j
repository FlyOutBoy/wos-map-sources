                    call SaveInteger(hs, GetHandleId(GetOwningPlayer(s__GearSystems2__KS_SpellTimer_c[this])), StringHash(I2S(s__GearSystems2__KS_SpellTimer_k2[this])), 0)
                    set s__GearSystems2__KS_SpellTimer_c[this]=null
                    set s__GearSystems2__KS_SpellTimer_p[this]=null
                    set s__GearSystems2__KS_SpellTimer_m_6[i]=s__GearSystems2__KS_SpellTimer_m_6[s__GearSystems2__KS_SpellTimer_MUI_6]
                    set s__GearSystems2__KS_SpellTimer_MUI_6=s__GearSystems2__KS_SpellTimer_MUI_6 - 1
