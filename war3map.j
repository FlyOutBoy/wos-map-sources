                            call GroupClear(s__BarraganSpells___HeroSpells_Q_g[this])
                            call GroupEnumUnitsInRange(s__BarraganSpells___HeroSpells_Q_g[this], s__BarraganSpells___HeroSpells_Q_x[this] + s__BarraganSpells___HeroSpells_Q_r2[this] * Cos(s__BarraganSpells___HeroSpells_Q_a[this]), s__BarraganSpells___HeroSpells_Q_y[this] + s__BarraganSpells___HeroSpells_Q_r2[this] * Sin(s__BarraganSpells___HeroSpells_Q_a[this]), s__BarraganSpells___HeroSpells_Q_aoe[this], NoDecor_Cond)
