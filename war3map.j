                    else
                        set s__GearSystems2__KS_Fear_r2[this]=s__GearSystems2__KS_Fear_r2[this] + 0.03
                    endif
                else
                    if GetLocalPlayer() == GetOwningPlayer(s__GearSystems2__KS_Fear_c[this]) then
                        call EnableUserControl(true)
                    endif
                    call IssueImmediateOrder(s__GearSystems2__KS_Fear_c[this], "stop")
                    call UnitRemoveAbility(s__GearSystems2__KS_Fear_c[this], 'Abun')
                    call UnitRemoveAbility(s__GearSystems2__KS_Fear_c[this], 'B0A5')
                    call DestroyEffect(s__GearSystems2__KS_Fear_e[this])
                    call SaveInteger(hs, GetHandleId(s__GearSystems2__KS_Fear_c[this]), StringHash("AsNodt pas"), 0)
                    set s__GearSystems2__KS_Fear_c[this]=null
                    set s__GearSystems2__KS_Fear_e[this]=null
                    set s__GearSystems2__KS_Fear_m_22[i]=s__GearSystems2__KS_Fear_m_22[s__GearSystems2__KS_Fear_MUI_22]
