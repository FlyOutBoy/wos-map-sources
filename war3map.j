//library LocalMp3Player:


//===========================================================================
// Public track registration API
//===========================================================================
function LocalMp3Player_AddTrackEx takes string filePath,string displayName,integer durationSeconds returns nothing
    if LocalMp3Player___lmpTrackCount >= LocalMp3Player___LMP_MAX_TRACKS then
        return
    endif

    if durationSeconds <= 0 then
        return
    endif

    set LocalMp3Player___lmpTrackCount=LocalMp3Player___lmpTrackCount + 1
    set LocalMp3Player___lmpPath[LocalMp3Player___lmpTrackCount]=filePath
    set LocalMp3Player___lmpTitle[LocalMp3Player___lmpTrackCount]=displayName
    set LocalMp3Player___lmpDurationMs[LocalMp3Player___lmpTrackCount]=durationSeconds * 1000
endfunction
function LocalMp3Player_AddTrack takes string filePath,string displayName returns nothing
    call LocalMp3Player_AddTrackEx(filePath , displayName , 0)
endfunction

function LocalMp3Player_GetTrackCount takes nothing returns integer
    return LocalMp3Player___lmpTrackCount
endfunction

//===========================================================================
// TRACK CONFIG
//
// Local files are checked automatically after map startup:
// Music\1.mp3 ... Music\30.mp3
//
// The scan is intentionally staggered. It does not open all MP3 files inside
// the library initializer.
//===========================================================================

//===========================================================================
// Internal helpers
//===========================================================================
function LocalMp3Player___LMP_MaxOffset takes nothing returns integer
    if LocalMp3Player___lmpTrackCount > LocalMp3Player___LMP_ROWS then
        return LocalMp3Player___lmpTrackCount - LocalMp3Player___LMP_ROWS
    endif
    return 0
endfunction

function LocalMp3Player___LMP_ClampOffset takes integer value returns integer
    local integer maxOffset= LocalMp3Player___LMP_MaxOffset()

    if value < 0 then
        return 0
    endif
    if value > maxOffset then
        return maxOffset
    endif
    return value
endfunction

function LocalMp3Player___LMP_OrderKey takes integer pid,integer position returns integer
    return pid * LocalMp3Player___LMP_MAX_TRACKS + position
endfunction

function LocalMp3Player___LMP_GetOrderedTrack takes integer pid,integer position returns integer
    local integer trackIndex

    if position < 1 or position > LocalMp3Player___lmpTrackCount then
        return 0
    endif

    set trackIndex=LocalMp3Player___lmpOrder[((pid ) * LocalMp3Player___LMP_MAX_TRACKS + ( position))] // INLINED!!
    if trackIndex <= 0 or trackIndex > LocalMp3Player___lmpTrackCount then
        return position
    endif
    return trackIndex
endfunction

function LocalMp3Player___LMP_ResetOrder takes integer pid returns nothing
    local integer position= 1

    loop
        exitwhen position > LocalMp3Player___lmpTrackCount
        set LocalMp3Player___lmpOrder[((pid ) * LocalMp3Player___LMP_MAX_TRACKS + ( position))]=position // INLINED!!
        set position=position + 1
    endloop
endfunction

function LocalMp3Player___LMP_FindOrderPosition takes integer pid,integer trackIndex returns integer
    local integer position= 1

    loop
        exitwhen position > LocalMp3Player___lmpTrackCount
        if LocalMp3Player___LMP_GetOrderedTrack(pid , position) == trackIndex then
            return position
        endif
        set position=position + 1
    endloop
    return 0
endfunction

function LocalMp3Player___LMP_GetNextTrack takes integer pid returns integer
    local integer position

    if LocalMp3Player___lmpTrackCount <= 0 then
        return 0
    endif

    set position=LocalMp3Player___LMP_FindOrderPosition(pid , LocalMp3Player___lmpCurrent[pid])
    if position <= 0 or position >= LocalMp3Player___lmpTrackCount then
        set position=1
    else
        set position=position + 1
    endif
    return LocalMp3Player___LMP_GetOrderedTrack(pid , position)
endfunction

function LocalMp3Player___LMP_GetPreviousTrack takes integer pid returns integer
    local integer position

    if LocalMp3Player___lmpTrackCount <= 0 then
        return 0
    endif

    set position=LocalMp3Player___LMP_FindOrderPosition(pid , LocalMp3Player___lmpCurrent[pid])
    if position <= 1 then
        set position=LocalMp3Player___lmpTrackCount
    else
        set position=position - 1
    endif
    return LocalMp3Player___LMP_GetOrderedTrack(pid , position)
endfunction

function LocalMp3Player___LMP_ShuffleOrder takes integer pid returns nothing
    local integer position
    local integer swapPosition
    local integer firstKey
    local integer secondKey
    local integer temporaryTrack
    local integer seed

    call LocalMp3Player___LMP_ResetOrder(pid)
    set LocalMp3Player___lmpShuffleNonce[pid]=LocalMp3Player___lmpShuffleNonce[pid] + 1

    // Small deterministic PRNG: does not touch Warcraft's gameplay RNG.
    set seed=ModuloInteger(( pid + 1 ) * 7919 + LocalMp3Player___lmpShuffleNonce[pid] * 1049 + LocalMp3Player___lmpTrackCount * 101, 32749)
    set position=LocalMp3Player___lmpTrackCount

    loop
        exitwhen position <= 1
        set seed=ModuloInteger(seed * 25173 + 13849, 32749)
        set swapPosition=ModuloInteger(seed, position) + 1
        set firstKey=((pid ) * LocalMp3Player___LMP_MAX_TRACKS + ( position)) // INLINED!!
        set secondKey=((pid ) * LocalMp3Player___LMP_MAX_TRACKS + ( swapPosition)) // INLINED!!
        set temporaryTrack=LocalMp3Player___lmpOrder[firstKey]
        set LocalMp3Player___lmpOrder[firstKey]=LocalMp3Player___lmpOrder[secondKey]
        set LocalMp3Player___lmpOrder[secondKey]=temporaryTrack
        set position=position - 1
    endloop
endfunction

function LocalMp3Player___LMP_FormatTime takes integer totalSeconds returns string
    local integer minutes
    local integer seconds

    if totalSeconds < 0 then
        set totalSeconds=0
    endif

    set minutes=totalSeconds / 60
    set seconds=totalSeconds - minutes * 60

    if seconds < 10 then
        return I2S(minutes) + ":0" + I2S(seconds)
    endif
    return I2S(minutes) + ":" + I2S(seconds)
endfunction

function LocalMp3Player___LMP_SetProgress takes player whichPlayer,real value returns nothing
    if value < 0.00 then
        set value=0.00
    elseif value > 1000.00 then
        set value=1000.00
    endif

    if GetLocalPlayer() == whichPlayer then
        call BlzFrameSetValue(LocalMp3Player___lmpSeek, value)
    endif
endfunction

function LocalMp3Player___LMP_StopTrackMusic takes player whichPlayer returns nothing
    local integer pid= GetPlayerId(whichPlayer)

    // Frame callbacks only enqueue music work. The periodic timer performs all
    // music natives outside Warcraft's UI event stack.
    set LocalMp3Player___lmpPendingMusicTrack[pid]=0
    set LocalMp3Player___lmpPendingMusicPositionMs[pid]=0
    set LocalMp3Player___lmpMusicSwitchPhase[pid]=1
    set LocalMp3Player___lmpSkipElapsedTick[pid]=true
endfunction

function LocalMp3Player___LMP_StartTrackMusic takes player whichPlayer,integer trackIndex,integer positionMs returns nothing
    local integer pid= GetPlayerId(whichPlayer)

    if positionMs < 0 then
        set positionMs=0
    endif

    set LocalMp3Player___lmpPendingMusicTrack[pid]=trackIndex
    set LocalMp3Player___lmpPendingMusicPositionMs[pid]=positionMs
    set LocalMp3Player___lmpMusicSwitchPhase[pid]=1
    set LocalMp3Player___lmpSkipElapsedTick[pid]=true
endfunction

function LocalMp3Player___LMP_ProcessMusicSwitch takes player whichPlayer returns nothing
    local integer pid= GetPlayerId(whichPlayer)
    local integer trackIndex

    if GetLocalPlayer() != whichPlayer then
        return
    endif

    if not LocalMp3Player___LMP_AUDIO_ENABLED then
        set LocalMp3Player___lmpActiveMusicTrack[pid]=0
        set LocalMp3Player___lmpMusicSwitchPhase[pid]=0
        set LocalMp3Player___lmpMusicVolumeDirty[pid]=false
        return
    endif

    if LocalMp3Player___lmpMusicVolumeDirty[pid] then
        call SetMusicVolume(LocalMp3Player___lmpPendingMusicVolume[pid])
        set LocalMp3Player___lmpMusicVolumeDirty[pid]=false
    endif

    if LocalMp3Player___lmpMusicSwitchPhase[pid] == 1 then
        // Reset Warcraft's internal music queue before every start. Without
        // ClearMapMusic the client may keep/restart the previously cached MP3.
        call StopMusic(false)
        call ClearMapMusic()
        set LocalMp3Player___lmpActiveMusicTrack[pid]=0
        if LocalMp3Player___lmpPendingMusicTrack[pid] > 0 then
            set LocalMp3Player___lmpMusicSwitchPhase[pid]=2
        else
            set LocalMp3Player___lmpMusicSwitchPhase[pid]=0
        endif
    elseif LocalMp3Player___lmpMusicSwitchPhase[pid] == 2 then
        set trackIndex=LocalMp3Player___lmpPendingMusicTrack[pid]
        if trackIndex > 0 and trackIndex <= LocalMp3Player___lmpTrackCount then
            // Start from zero first. Seeking a freshly loaded external MP3 in
            // the same call is unreliable on Reforged.
            set LocalMp3Player___lmpSkipElapsedTick[pid]=true
            call PlayMusicEx(LocalMp3Player___lmpPath[trackIndex], 0, 0)
            set LocalMp3Player___lmpActiveMusicTrack[pid]=trackIndex
            if LocalMp3Player___lmpPendingMusicPositionMs[pid] > 0 then
                set LocalMp3Player___lmpMusicSwitchPhase[pid]=3
            else
                set LocalMp3Player___lmpPendingMusicTrack[pid]=0
                set LocalMp3Player___lmpPendingMusicPositionMs[pid]=0
                set LocalMp3Player___lmpMusicSwitchPhase[pid]=0
            endif
        else
            set LocalMp3Player___lmpPendingMusicTrack[pid]=0
            set LocalMp3Player___lmpPendingMusicPositionMs[pid]=0
            set LocalMp3Player___lmpMusicSwitchPhase[pid]=0
        endif
    elseif LocalMp3Player___lmpMusicSwitchPhase[pid] == 3 then
        // Apply the offset one timer tick after PlayMusicEx, when the new MP3
        // has already become the active music stream.
        set LocalMp3Player___lmpSkipElapsedTick[pid]=true
        call SetMusicPlayPosition(LocalMp3Player___lmpPendingMusicPositionMs[pid])
        set LocalMp3Player___lmpPendingMusicTrack[pid]=0
        set LocalMp3Player___lmpPendingMusicPositionMs[pid]=0
        set LocalMp3Player___lmpMusicSwitchPhase[pid]=0
    endif
endfunction

function LocalMp3Player___LMP_ApplyVolume takes player whichPlayer,integer volume returns nothing
    local integer pid= GetPlayerId(whichPlayer)
    local integer percent

    if volume < 0 then
        set volume=0
    elseif volume > 127 then
        set volume=127
    endif

    set LocalMp3Player___lmpVolume[pid]=volume
    set percent=R2I(I2R(volume) * 100.00 / 127.00 + 0.50)

    if GetLocalPlayer() == whichPlayer then
        // Apply on the timer, not inside FRAMEEVENT_SLIDER_VALUE_CHANGED.
        set LocalMp3Player___lmpPendingMusicVolume[pid]=volume
        set LocalMp3Player___lmpMusicVolumeDirty[pid]=true
        call BlzFrameSetText(LocalMp3Player___lmpVolumeText, "|cffffffffVOLUME " + I2S(percent) + "%|r")
    endif
endfunction

function LocalMp3Player___LMP_UpdateList takes player whichPlayer returns nothing
    local integer pid= GetPlayerId(whichPlayer)
    local integer row= 0
    local integer listPosition
    local integer trackIndex
    local string prefix

    if GetLocalPlayer() == whichPlayer then
        loop
            exitwhen row >= LocalMp3Player___LMP_ROWS
            set listPosition=LocalMp3Player___lmpListOffset[pid] + row + 1
            set trackIndex=LocalMp3Player___LMP_GetOrderedTrack(pid , listPosition)

            if trackIndex > 0 and trackIndex <= LocalMp3Player___lmpTrackCount then
                set LocalMp3Player___lmpRowTrack[row]=trackIndex
                if trackIndex == LocalMp3Player___lmpCurrent[pid] then
                    set prefix="|cffffcc00> "
                else
                    set prefix="|cffdddddd  "
                endif
                call BlzFrameSetText(LocalMp3Player___lmpRow[row], prefix + I2S(trackIndex) + ". " + LocalMp3Player___lmpTitle[trackIndex] + "|r")
                call BlzFrameSetEnable(LocalMp3Player___lmpRow[row], true)
            else
                set LocalMp3Player___lmpRowTrack[row]=0
                call BlzFrameSetText(LocalMp3Player___lmpRow[row], "")
                call BlzFrameSetEnable(LocalMp3Player___lmpRow[row], false)
            endif

            set row=row + 1
        endloop
    endif
endfunction

function LocalMp3Player___LMP_UpdateHeader takes player whichPlayer returns nothing
    local integer pid= GetPlayerId(whichPlayer)
    local integer trackIndex= LocalMp3Player___lmpCurrent[pid]
    local integer durationSeconds= 0

    if GetLocalPlayer() == whichPlayer then
        if trackIndex > 0 and trackIndex <= LocalMp3Player___lmpTrackCount then
            call BlzFrameSetText(LocalMp3Player___lmpNowPlaying, "|cffffcc00" + LocalMp3Player___lmpTitle[trackIndex] + "|r")
            set durationSeconds=( LocalMp3Player___lmpDurationMs[trackIndex] + 500 ) / 1000
            call BlzFrameSetText(LocalMp3Player___lmpTimeText, LocalMp3Player___LMP_FormatTime(R2I(LocalMp3Player___lmpElapsed[pid])) + " / " + LocalMp3Player___LMP_FormatTime(durationSeconds))
        else
            call BlzFrameSetText(LocalMp3Player___lmpNowPlaying, "|cffaaaaaaNo tracks imported|r")
            call BlzFrameSetText(LocalMp3Player___lmpTimeText, "0:00 / 0:00")
        endif

        if LocalMp3Player___lmpLoop[pid] then
            call BlzFrameSetTexture(LocalMp3Player___lmpLoopIcon, LocalMp3Player___LMP_TEX_LOOP_ON, 0, true)
        else
            call BlzFrameSetTexture(LocalMp3Player___lmpLoopIcon, LocalMp3Player___LMP_TEX_LOOP_OFF, 0, true)
        endif

        if LocalMp3Player___lmpShuffle[pid] then
            call BlzFrameSetTexture(LocalMp3Player___lmpShuffleIcon, LocalMp3Player___LMP_TEX_SHUFFLE_ON, 0, true)
        else
            call BlzFrameSetTexture(LocalMp3Player___lmpShuffleIcon, LocalMp3Player___LMP_TEX_SHUFFLE_OFF, 0, true)
        endif

        // One transport button: show PAUSE while audio is running and PLAY
        // while it is paused, stopped, or has not started yet.
        if LocalMp3Player___lmpPlaying[pid] then
            call BlzFrameSetTexture(LocalMp3Player___lmpPlayPauseIcon, LocalMp3Player___LMP_TEX_PAUSE, 0, true)
        else
            call BlzFrameSetTexture(LocalMp3Player___lmpPlayPauseIcon, LocalMp3Player___LMP_TEX_PLAY, 0, true)
            call BlzFrameSetText(LocalMp3Player___lmpEqualizer, "|cff666666_____________|r")
        endif
    endif
endfunction

function LocalMp3Player___LMP_UpdateTimeText takes player whichPlayer returns nothing
    local integer pid= GetPlayerId(whichPlayer)
    local integer trackIndex= LocalMp3Player___lmpCurrent[pid]
    local integer durationSeconds= 0

    if GetLocalPlayer() == whichPlayer then
        if trackIndex > 0 and trackIndex <= LocalMp3Player___lmpTrackCount then
            set durationSeconds=( LocalMp3Player___lmpDurationMs[trackIndex] + 500 ) / 1000
            call BlzFrameSetText(LocalMp3Player___lmpTimeText, LocalMp3Player___LMP_FormatTime(R2I(LocalMp3Player___lmpElapsed[pid])) + " / " + LocalMp3Player___LMP_FormatTime(durationSeconds))
        else
            call BlzFrameSetText(LocalMp3Player___lmpTimeText, "0:00 / 0:00")
        endif
    endif
endfunction

function LocalMp3Player___LMP_UpdateAll takes player whichPlayer returns nothing
    call LocalMp3Player___LMP_UpdateList(whichPlayer)
    call LocalMp3Player___LMP_UpdateHeader(whichPlayer)
endfunction

function LocalMp3Player___LMP_SetVisible takes player whichPlayer,boolean flag returns nothing
    local integer pid= GetPlayerId(whichPlayer)

    set LocalMp3Player___lmpVisible[pid]=flag

    // On the first opening, enqueue stopping the map's default music. All music
    // natives are executed later by the periodic timer.
    if flag and not LocalMp3Player___lmpDefaultMusicStopped[pid] then
        set LocalMp3Player___lmpDefaultMusicStopped[pid]=true
        call LocalMp3Player___LMP_StopTrackMusic(whichPlayer)
    endif

    if GetLocalPlayer() == whichPlayer then
        call BlzFrameSetVisible(LocalMp3Player___lmpPanel, flag)
        call BlzFrameSetVisible(LocalMp3Player___lmpSeek, flag)
        call BlzFrameSetVisible(LocalMp3Player___lmpSeekBlocker, flag)
        call BlzFrameSetVisible(LocalMp3Player___lmpVolumeSlider, flag)
        call BlzFrameSetVisible(lmpOpenButton, not flag)
    endif

    if flag then
        call LocalMp3Player___LMP_UpdateAll(whichPlayer)
    endif
endfunction

function LocalMp3Player___LMP_Stop takes player whichPlayer returns nothing
    local integer pid= GetPlayerId(whichPlayer)

    call LocalMp3Player___LMP_StopTrackMusic(whichPlayer)

    set LocalMp3Player___lmpPlaying[pid]=false
    set LocalMp3Player___lmpPaused[pid]=false
    set LocalMp3Player___lmpElapsed[pid]=0.00
    set LocalMp3Player___lmpUiElapsed[pid]=0.00
    set LocalMp3Player___lmpEqualizerElapsed[pid]=0.00
    set LocalMp3Player___lmpEqualizerPhase[pid]=0

    if GetLocalPlayer() == whichPlayer then
        call LocalMp3Player___LMP_SetProgress(whichPlayer , 0.00)
    endif
    call LocalMp3Player___LMP_UpdateHeader(whichPlayer)
endfunction

function LocalMp3Player___LMP_PlayTrack takes player whichPlayer,integer trackIndex returns nothing
    local integer pid= GetPlayerId(whichPlayer)
    local integer orderPosition

    if LocalMp3Player___lmpTrackCount <= 0 then
        return
    endif

    if trackIndex < 1 then
        set trackIndex=LocalMp3Player___lmpTrackCount
    elseif trackIndex > LocalMp3Player___lmpTrackCount then
        set trackIndex=1
    endif

    call LocalMp3Player___LMP_StartTrackMusic(whichPlayer , trackIndex , 0)

    set LocalMp3Player___lmpCurrent[pid]=trackIndex
    set LocalMp3Player___lmpElapsed[pid]=0.00
    set LocalMp3Player___lmpUiElapsed[pid]=0.00
    set LocalMp3Player___lmpEqualizerElapsed[pid]=0.00
    set LocalMp3Player___lmpEqualizerPhase[pid]=0
    set LocalMp3Player___lmpPlaying[pid]=true
    set LocalMp3Player___lmpPaused[pid]=false

    set orderPosition=LocalMp3Player___LMP_FindOrderPosition(pid , trackIndex)
    if orderPosition <= LocalMp3Player___lmpListOffset[pid] then
        set LocalMp3Player___lmpListOffset[pid]=orderPosition - 1
    elseif orderPosition > LocalMp3Player___lmpListOffset[pid] + LocalMp3Player___LMP_ROWS then
        set LocalMp3Player___lmpListOffset[pid]=orderPosition - LocalMp3Player___LMP_ROWS
    endif
    set LocalMp3Player___lmpListOffset[pid]=LocalMp3Player___LMP_ClampOffset(LocalMp3Player___lmpListOffset[pid])

    if GetLocalPlayer() == whichPlayer then
        call LocalMp3Player___LMP_SetProgress(whichPlayer , 0.00)
        call BlzFrameSetValue(LocalMp3Player___lmpScroll, I2R(LocalMp3Player___LMP_MaxOffset() - LocalMp3Player___lmpListOffset[pid]))
    endif

    call LocalMp3Player___LMP_UpdateAll(whichPlayer)
endfunction

function LocalMp3Player___LMP_Play takes player whichPlayer returns nothing
    local integer pid= GetPlayerId(whichPlayer)

    if LocalMp3Player___lmpTrackCount <= 0 then
        return
    endif

    if LocalMp3Player___lmpCurrent[pid] <= 0 then
        call LocalMp3Player___LMP_PlayTrack(whichPlayer , LocalMp3Player___LMP_GetOrderedTrack(pid , 1))
    elseif LocalMp3Player___lmpPaused[pid] then
        call LocalMp3Player___LMP_StartTrackMusic(whichPlayer , LocalMp3Player___lmpCurrent[pid] , R2I(LocalMp3Player___lmpElapsed[pid] * 1000.00))
        set LocalMp3Player___lmpPlaying[pid]=true
        set LocalMp3Player___lmpPaused[pid]=false
        set LocalMp3Player___lmpEqualizerElapsed[pid]=0.00
        call LocalMp3Player___LMP_UpdateHeader(whichPlayer)
    elseif not LocalMp3Player___lmpPlaying[pid] then
        call LocalMp3Player___LMP_StartTrackMusic(whichPlayer , LocalMp3Player___lmpCurrent[pid] , R2I(LocalMp3Player___lmpElapsed[pid] * 1000.00))
        set LocalMp3Player___lmpPlaying[pid]=true
        set LocalMp3Player___lmpPaused[pid]=false
        set LocalMp3Player___lmpEqualizerElapsed[pid]=0.00
        call LocalMp3Player___LMP_UpdateHeader(whichPlayer)
    endif
endfunction

function LocalMp3Player___LMP_Pause takes player whichPlayer returns nothing
    local integer pid= GetPlayerId(whichPlayer)
    local integer trackIndex= LocalMp3Player___lmpCurrent[pid]

    if LocalMp3Player___lmpPlaying[pid] and trackIndex > 0 and trackIndex <= LocalMp3Player___lmpTrackCount then
        call LocalMp3Player___LMP_StopTrackMusic(whichPlayer)

        // Keep lmpElapsed unchanged. PLAY starts PlayMusicEx from this position.
        set LocalMp3Player___lmpPlaying[pid]=false
        set LocalMp3Player___lmpPaused[pid]=true
        set LocalMp3Player___lmpUiElapsed[pid]=0.00
        call LocalMp3Player___LMP_UpdateHeader(whichPlayer)
    endif
endfunction

function LocalMp3Player___LMP_SetPosition takes player whichPlayer,integer positionMs,boolean updateSlider returns nothing
    local integer pid= GetPlayerId(whichPlayer)
    local integer trackIndex= LocalMp3Player___lmpCurrent[pid]
    local integer durationMs
    local boolean wasPaused= LocalMp3Player___lmpPaused[pid]
    local real seekValue

    if LocalMp3Player___lmpTrackCount <= 0 then
        return
    endif

    if trackIndex <= 0 or trackIndex > LocalMp3Player___lmpTrackCount then
        set trackIndex=LocalMp3Player___LMP_GetOrderedTrack(pid , 1)
        set LocalMp3Player___lmpCurrent[pid]=trackIndex
    endif

    set durationMs=LocalMp3Player___lmpDurationMs[trackIndex]
    if durationMs <= 0 then
        return
    endif

    // Reaching/passing the end immediately starts the next track.
    if positionMs >= durationMs then
        call LocalMp3Player___LMP_PlayTrack(whichPlayer , LocalMp3Player___LMP_GetNextTrack(pid))
        return
    endif

    // Rewinding before the beginning clamps to 0:00.
    if positionMs < 0 then
        set positionMs=0
    endif

    if not wasPaused then
        call LocalMp3Player___LMP_StartTrackMusic(whichPlayer , trackIndex , positionMs)
    endif

    set LocalMp3Player___lmpElapsed[pid]=I2R(positionMs) / 1000.00
    set LocalMp3Player___lmpUiElapsed[pid]=0.00

    if wasPaused then
        set LocalMp3Player___lmpPlaying[pid]=false
        set LocalMp3Player___lmpPaused[pid]=true
    else
        set LocalMp3Player___lmpPlaying[pid]=true
        set LocalMp3Player___lmpPaused[pid]=false
    endif

    if updateSlider and GetLocalPlayer() == whichPlayer then
        set seekValue=I2R(positionMs) * 1000.00 / I2R(durationMs)
        call LocalMp3Player___LMP_SetProgress(whichPlayer , seekValue)
    endif

    call LocalMp3Player___LMP_UpdateAll(whichPlayer)
endfunction

function LocalMp3Player___LMP_SkipSeconds takes player whichPlayer,integer deltaSeconds returns nothing
    local integer pid= GetPlayerId(whichPlayer)
    local integer newPositionMs= R2I(LocalMp3Player___lmpElapsed[pid] * 1000.00) + deltaSeconds * 1000

    call LocalMp3Player___LMP_SetPosition(whichPlayer , newPositionMs , true)
endfunction

function LocalMp3Player___LMP_Next takes player whichPlayer returns nothing
    local integer pid= GetPlayerId(whichPlayer)
    call LocalMp3Player___LMP_PlayTrack(whichPlayer , LocalMp3Player___LMP_GetNextTrack(pid))
endfunction

function LocalMp3Player___LMP_Previous takes player whichPlayer returns nothing
    local integer pid= GetPlayerId(whichPlayer)
    call LocalMp3Player___LMP_PlayTrack(whichPlayer , LocalMp3Player___LMP_GetPreviousTrack(pid))
endfunction

function LocalMp3Player___LMP_Rerun takes player whichPlayer returns nothing
    local integer pid= GetPlayerId(whichPlayer)

    if LocalMp3Player___lmpCurrent[pid] > 0 and LocalMp3Player___lmpCurrent[pid] <= LocalMp3Player___lmpTrackCount then
        call LocalMp3Player___LMP_PlayTrack(whichPlayer , LocalMp3Player___lmpCurrent[pid])
    elseif LocalMp3Player___lmpTrackCount > 0 then
        call LocalMp3Player___LMP_PlayTrack(whichPlayer , LocalMp3Player___LMP_GetOrderedTrack(pid , 1))
    endif
endfunction

function LocalMp3Player___LMP_ToggleShuffle takes player whichPlayer returns nothing
    local integer pid= GetPlayerId(whichPlayer)
    local integer orderPosition

    if LocalMp3Player___lmpShuffle[pid] then
        set LocalMp3Player___lmpShuffle[pid]=false
        call LocalMp3Player___LMP_ResetOrder(pid)
    else
        set LocalMp3Player___lmpShuffle[pid]=true
        call LocalMp3Player___LMP_ShuffleOrder(pid)
    endif

    // Keep the current audio untouched and only reveal it in the new order.
    set orderPosition=LocalMp3Player___LMP_FindOrderPosition(pid , LocalMp3Player___lmpCurrent[pid])
    if orderPosition <= 0 then
        set LocalMp3Player___lmpListOffset[pid]=0
    elseif orderPosition <= LocalMp3Player___lmpListOffset[pid] then
        set LocalMp3Player___lmpListOffset[pid]=orderPosition - 1
    elseif orderPosition > LocalMp3Player___lmpListOffset[pid] + LocalMp3Player___LMP_ROWS then
        set LocalMp3Player___lmpListOffset[pid]=orderPosition - LocalMp3Player___LMP_ROWS
    endif
    set LocalMp3Player___lmpListOffset[pid]=LocalMp3Player___LMP_ClampOffset(LocalMp3Player___lmpListOffset[pid])

    if GetLocalPlayer() == whichPlayer then
        call BlzFrameSetValue(LocalMp3Player___lmpScroll, I2R(LocalMp3Player___LMP_MaxOffset() - LocalMp3Player___lmpListOffset[pid]))
    endif
    call LocalMp3Player___LMP_UpdateAll(whichPlayer)
endfunction

function LocalMp3Player___LMP_UpdateEqualizer takes player whichPlayer returns nothing
    local integer pid= GetPlayerId(whichPlayer)
    local integer phase= LocalMp3Player___lmpEqualizerPhase[pid]

    if GetLocalPlayer() == whichPlayer and LocalMp3Player___lmpPlaying[pid] then
        if phase == 0 then
            call BlzFrameSetText(LocalMp3Player___lmpEqualizer, "|cff33ccff___/\\____/\\/\\____/\\___|r")
        elseif phase == 1 then
            call BlzFrameSetText(LocalMp3Player___lmpEqualizer, "|cff33ccff_/\\/\\___/\\____/\\/\\____|r")
        elseif phase == 2 then
            call BlzFrameSetText(LocalMp3Player___lmpEqualizer, "|cff33ccff/\\___/\\/\\__/\\___/\\_/\\_|r")
        else
            call BlzFrameSetText(LocalMp3Player___lmpEqualizer, "|cff33ccff\\____/\\___/\\/\\____/\\__|r")
        endif
    endif
endfunction

//===========================================================================
// Frame event handlers
//===========================================================================
function LocalMp3Player___LMP_OnClick takes nothing returns nothing
    local player p= GetTriggerPlayer()
    local integer pid= GetPlayerId(p)
    local framehandle clicked= BlzGetTriggerFrame()
    local integer row= 0
    local integer trackIndex

    if LocalMp3Player___lmpClickBusy[pid] then
        set clicked=null
        set p=null
        return
    endif
    set LocalMp3Player___lmpClickBusy[pid]=true

    if clicked == lmpOpenButton then
        call LocalMp3Player___LMP_SetVisible(p , true)
    elseif clicked == lmpLinkButton then
        set LocalMp3Player___lmpLinkVisible[pid]=true
        if GetLocalPlayer() == p then
            call BlzFrameSetVisible(lmpLinkButton, false)
            call BlzFrameSetVisible(lmpLinkActiveButton, true)
            call BlzFrameSetVisible(LocalMp3Player___lmpLinkEdit, true)
            call BlzFrameSetEnable(LocalMp3Player___lmpLinkEdit, true)
            call BlzFrameSetFocus(LocalMp3Player___lmpLinkEdit, true)
            call BlzFrameSetText(LocalMp3Player___lmpLinkEdit, "")
            call BlzFrameSetText(LocalMp3Player___lmpLinkEdit, LocalMp3Player___LMP_LINK_URL)
        endif
    elseif clicked == lmpLinkActiveButton then
        set LocalMp3Player___lmpLinkVisible[pid]=false
        if GetLocalPlayer() == p then
        
            call BlzFrameSetFocus(LocalMp3Player___lmpLinkEdit, false)
            call BlzFrameSetVisible(LocalMp3Player___lmpLinkEdit, false)
            call BlzFrameSetVisible(lmpLinkActiveButton, false)
            
            call BlzFrameSetVisible(lmpLinkButton, true)
        endif
    elseif clicked == LocalMp3Player___lmpCloseButton then
        call LocalMp3Player___LMP_SetVisible(p , false)
    elseif clicked == LocalMp3Player___lmpShuffleButton then
        call LocalMp3Player___LMP_ToggleShuffle(p)
    elseif clicked == LocalMp3Player___lmpBack10Button then
        call LocalMp3Player___LMP_SkipSeconds(p , - 10)
    elseif clicked == LocalMp3Player___lmpPreviousButton then
        call LocalMp3Player___LMP_Previous(p)
    elseif clicked == LocalMp3Player___lmpRerunButton then
        call LocalMp3Player___LMP_Rerun(p)
    elseif clicked == LocalMp3Player___lmpPlayPauseButton then
        if LocalMp3Player___lmpPlaying[pid] then
            call LocalMp3Player___LMP_Pause(p)
        else
            call LocalMp3Player___LMP_Play(p)
        endif
    elseif clicked == LocalMp3Player___lmpForward10Button then
        call LocalMp3Player___LMP_SkipSeconds(p , 10)
    elseif clicked == LocalMp3Player___lmpNextButton then
        call LocalMp3Player___LMP_Next(p)
    elseif clicked == LocalMp3Player___lmpLoopButton then
        set LocalMp3Player___lmpLoop[pid]=not LocalMp3Player___lmpLoop[pid]
        call LocalMp3Player___LMP_UpdateHeader(p)
    else
        loop
            exitwhen row >= LocalMp3Player___LMP_ROWS
            if clicked == LocalMp3Player___lmpRow[row] then
                set trackIndex=LocalMp3Player___lmpRowTrack[row]
                if trackIndex > 0 and trackIndex <= LocalMp3Player___lmpTrackCount then
                    call LocalMp3Player___LMP_PlayTrack(p , trackIndex)
                endif
                set row=LocalMp3Player___LMP_ROWS
            endif
            set row=row + 1
        endloop
    endif

    set LocalMp3Player___lmpClickBusy[pid]=false
    set clicked=null
    set p=null
endfunction

function LocalMp3Player___LMP_OnLinkEdit takes nothing returns nothing
    local player p= GetTriggerPlayer()
    local framehandle editBox= BlzGetTriggerFrame()

    if GetLocalPlayer() == p then
        call BlzFrameSetFocus(editBox, true)
        call BlzFrameSetText(editBox, "")
        call BlzFrameSetText(editBox, LocalMp3Player___LMP_LINK_URL)
    endif

    set editBox=null
    set p=null
endfunction

function LocalMp3Player___LMP_OnVolume takes nothing returns nothing
    local player p= GetTriggerPlayer()
    local integer volume= R2I(BlzGetTriggerFrameValue() + 0.50)

    call LocalMp3Player___LMP_ApplyVolume(p , volume)

    set p=null
endfunction

function LocalMp3Player___LMP_OnScroll takes nothing returns nothing
    local player p= GetTriggerPlayer()
    local integer pid= GetPlayerId(p)
    local integer sliderValue= R2I(BlzGetTriggerFrameValue() + 0.50)

    set LocalMp3Player___lmpListOffset[pid]=LocalMp3Player___LMP_ClampOffset(LocalMp3Player___LMP_MaxOffset() - sliderValue)
    call LocalMp3Player___LMP_UpdateList(p)

    set p=null
endfunction

function LocalMp3Player___LMP_OnWheel takes nothing returns nothing
    local player p= GetTriggerPlayer()
    local integer pid= GetPlayerId(p)
    local real wheelValue= BlzGetTriggerFrameValue()

    if wheelValue < 0.00 then
        set LocalMp3Player___lmpListOffset[pid]=LocalMp3Player___LMP_ClampOffset(LocalMp3Player___lmpListOffset[pid] + 1)
    elseif wheelValue > 0.00 then
        set LocalMp3Player___lmpListOffset[pid]=LocalMp3Player___LMP_ClampOffset(LocalMp3Player___lmpListOffset[pid] - 1)
    endif

    if GetLocalPlayer() == p then
        call BlzFrameSetValue(LocalMp3Player___lmpScroll, I2R(LocalMp3Player___LMP_MaxOffset() - LocalMp3Player___lmpListOffset[pid]))
    endif
    call LocalMp3Player___LMP_UpdateList(p)

    set p=null
endfunction

function LocalMp3Player___LMP_OnChat takes nothing returns nothing
    local player p= GetTriggerPlayer()
    local integer pid= GetPlayerId(p)

    call LocalMp3Player___LMP_SetVisible(p , not LocalMp3Player___lmpVisible[pid])
    set p=null
endfunction

function LocalMp3Player___LMP_OnTick takes nothing returns nothing
    local integer pid= 0
    local integer trackIndex
    local integer durationMs
    local integer nextTrack
    local real seekValue
    local player p

    loop
        exitwhen pid >= bj_MAX_PLAYERS
        set p=Player(pid)

        call LocalMp3Player___LMP_ProcessMusicSwitch(p)

        // Playback time is intentionally maintained only on the owning client.
        // При Stop/Clear/Play/Seek звук ещё не прошёл полный тик, поэтому этот
        // тик нельзя добавлять к показанному времени.
        if GetLocalPlayer() == p and LocalMp3Player___lmpPlaying[pid] and not LocalMp3Player___lmpSkipElapsedTick[pid] then
            set trackIndex=LocalMp3Player___lmpCurrent[pid]
            if trackIndex > 0 and trackIndex <= LocalMp3Player___lmpTrackCount then
                set LocalMp3Player___lmpElapsed[pid]=LocalMp3Player___lmpElapsed[pid] + LocalMp3Player___LMP_TICK
                set LocalMp3Player___lmpUiElapsed[pid]=LocalMp3Player___lmpUiElapsed[pid] + LocalMp3Player___LMP_TICK
                set LocalMp3Player___lmpEqualizerElapsed[pid]=LocalMp3Player___lmpEqualizerElapsed[pid] + LocalMp3Player___LMP_TICK
                set durationMs=LocalMp3Player___lmpDurationMs[trackIndex]

                if durationMs > 0 then
                    if LocalMp3Player___lmpElapsed[pid] * 1000.00 >= I2R(durationMs - LocalMp3Player___LMP_END_GUARD_MS) then
                        if LocalMp3Player___lmpLoop[pid] then
                            set nextTrack=trackIndex
                        else
                            set nextTrack=LocalMp3Player___LMP_GetNextTrack(pid)
                        endif
                        call LocalMp3Player___LMP_PlayTrack(p , nextTrack)
                    else
                        // Keep the horizontal thumb moving smoothly.
                        set seekValue=LocalMp3Player___lmpElapsed[pid] * 1000000.00 / I2R(durationMs)
                        call LocalMp3Player___LMP_SetProgress(p , seekValue)

                        if LocalMp3Player___lmpEqualizerElapsed[pid] >= 0.20 then
                            set LocalMp3Player___lmpEqualizerElapsed[pid]=0.00
                            set LocalMp3Player___lmpEqualizerPhase[pid]=ModuloInteger(LocalMp3Player___lmpEqualizerPhase[pid] + 1, 4)
                            call LocalMp3Player___LMP_UpdateEqualizer(p)
                        endif

                        if LocalMp3Player___lmpUiElapsed[pid] >= 0.50 then
                            set LocalMp3Player___lmpUiElapsed[pid]=0.00
                            // Do not reassign button textures from the timer.
                            // Only the elapsed-time label needs periodic work.
                            call LocalMp3Player___LMP_UpdateTimeText(p)
                        endif
                    endif
                endif
            endif
        endif

        if GetLocalPlayer() == p and LocalMp3Player___lmpSkipElapsedTick[pid] then
            set LocalMp3Player___lmpSkipElapsedTick[pid]=false
        endif

        set pid=pid + 1
    endloop

    set p=null
endfunction

//===========================================================================
// Frame construction
//===========================================================================
function LocalMp3Player___LMP_CreateTextButton takes framehandle parent,string text,real x,real y,real width,real height,integer context returns framehandle
    local framehandle newFrame= BlzCreateFrame("ScriptDialogButton", parent, 0, context)

    call BlzFrameSetAbsPoint(newFrame, FRAMEPOINT_CENTER, x, y)
    call BlzFrameSetSize(newFrame, width, height)
    call BlzFrameSetText(newFrame, text)
    call BlzTriggerRegisterFrameEvent(LocalMp3Player___lmpClickTrigger, newFrame, FRAMEEVENT_CONTROL_CLICK)

    return newFrame
endfunction

function LocalMp3Player___LMP_CreateIconButton takes framehandle parent,real x,real y,real size,integer context returns framehandle
    local framehandle newFrame= BlzCreateFrameByType("BUTTON", "LMPIconButton", parent, "ScoreScreenTabButtonTemplate", context)

    call BlzFrameSetAbsPoint(newFrame, FRAMEPOINT_CENTER, x, y)
    call BlzFrameSetSize(newFrame, size, size)
    call BlzTriggerRegisterFrameEvent(LocalMp3Player___lmpClickTrigger, newFrame, FRAMEEVENT_CONTROL_CLICK)

    return newFrame
endfunction

function LocalMp3Player___LMP_CreateIcon takes framehandle iconParent,string texture returns framehandle
    local framehandle icon= BlzCreateFrameByType("BACKDROP", "LMPIcon", iconParent, "", 0)

    call BlzFrameSetAllPoints(icon, iconParent)
    call BlzFrameSetTexture(icon, texture, 0, true)

    return icon
endfunction

function LocalMp3Player___LMP_AttachNativeTooltip takes framehandle whichFrame,string whichText returns nothing
    local integer context= LocalMp3Player___lmpTooltipContext
    local framehandle tooltip= BlzCreateFrameByType("BACKDROP", "LMPNativeTooltip", LocalMp3Player___lmpPanel, "", context)
    local framehandle tooltipText= BlzCreateFrameByType("TEXT", "LMPNativeTooltipText", tooltip, "", context)

    set LocalMp3Player___lmpTooltipContext=LocalMp3Player___lmpTooltipContext + 1

    call BlzFrameSetAbsPoint(tooltip, FRAMEPOINT_CENTER, LocalMp3Player___LMP_TOOLTIP_X, LocalMp3Player___LMP_TOOLTIP_Y)
    call BlzFrameSetSize(tooltip, LocalMp3Player___LMP_TOOLTIP_WIDTH, LocalMp3Player___LMP_TOOLTIP_HEIGHT)
    call BlzFrameSetTexture(tooltip, LocalMp3Player___LMP_TEX_BLACK, 0, true)
    call BlzFrameSetAlpha(tooltip, 235)
    call BlzFrameSetLevel(tooltip, 50)

    call BlzFrameSetAllPoints(tooltipText, tooltip)
    call BlzFrameSetTextAlignment(tooltipText, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
    call BlzFrameSetScale(tooltipText, 0.90)
    call BlzFrameSetText(tooltipText, "|cffffffff" + whichText + "|r")

    // Warcraft owns tooltip visibility. No enter/leave frame events are used.
    call BlzFrameSetVisible(tooltip, false)
    call BlzFrameSetTooltip(whichFrame, tooltip)

    set tooltipText=null
    set tooltip=null
endfunction

function LocalMp3Player___LMP_CreateFrames takes nothing returns nothing
    local framehandle consoleUI= BlzGetFrameByName("ConsoleUIBackdrop", 0)
    local framehandle gameUI= BlzGetOriginFrame(ORIGIN_FRAME_GAME_UI, 0)
    local framehandle title
    local framehandle icon
    local integer row= 0
    local real rowY

    // Independent external buttons: no ResourceBar/Upkeep lookup, mutation or anchor.
    set lmpOpenButton=LocalMp3Player___LMP_CreateIconButton(consoleUI , LocalMp3Player___LMP_OPEN_X , LocalMp3Player___LMP_OPEN_Y , LocalMp3Player___LMP_OPEN_SIZE , 100)
    set icon=LocalMp3Player___LMP_CreateIcon(lmpOpenButton , LocalMp3Player___LMP_TEX_OPEN)
    call BlzFrameSetLevel(lmpOpenButton, 100)
    call BlzFrameSetLevel(icon, 101)
    call BlzFrameSetVisible(lmpOpenButton, false)
    set lmpLinkButton=LocalMp3Player___LMP_CreateIconButton(consoleUI , LocalMp3Player___LMP_LINK_X , LocalMp3Player___LMP_LINK_Y , LocalMp3Player___LMP_LINK_SIZE , 101)
    set LocalMp3Player___lmpLinkIcon=LocalMp3Player___LMP_CreateIcon(lmpLinkButton , LocalMp3Player___LMP_TEX_LINK)
    call BlzFrameSetLevel(lmpLinkButton, 100)
    call BlzFrameSetLevel(LocalMp3Player___lmpLinkIcon, 101)
    call BlzFrameSetVisible(lmpLinkButton, false)
    
    set lmpLinkActiveButton=LocalMp3Player___LMP_CreateIconButton(consoleUI , LocalMp3Player___LMP_LINK_X , LocalMp3Player___LMP_LINK_Y , LocalMp3Player___LMP_LINK_SIZE , 102)
    set LocalMp3Player___lmpLinkActiveIcon=LocalMp3Player___LMP_CreateIcon(lmpLinkActiveButton , LocalMp3Player___LMP_TEX_CLOSE)
    call BlzFrameSetLevel(lmpLinkActiveButton, 100)
    call BlzFrameSetLevel(LocalMp3Player___lmpLinkActiveIcon, 101)
    call BlzFrameSetVisible(lmpLinkActiveButton, false)

    set LocalMp3Player___lmpLinkEdit=BlzCreateFrame("EscMenuEditBoxTemplate", consoleUI, 0, 0)
    call BlzFrameSetAbsPoint(LocalMp3Player___lmpLinkEdit, FRAMEPOINT_CENTER, LocalMp3Player___LMP_LINK_EDIT_X, LocalMp3Player___LMP_LINK_EDIT_Y)
    call BlzFrameClearAllPoints(LocalMp3Player___lmpLinkEdit)
    call BlzFrameSetPoint(LocalMp3Player___lmpLinkEdit, FRAMEPOINT_TOP, lmpLinkButton, FRAMEPOINT_BOTTOM, 0.000, - 0.004)
    call BlzFrameSetSize(LocalMp3Player___lmpLinkEdit, LocalMp3Player___LMP_LINK_EDIT_WIDTH, LocalMp3Player___LMP_LINK_EDIT_HEIGHT)
    call BlzFrameSetText(LocalMp3Player___lmpLinkEdit, LocalMp3Player___LMP_LINK_URL)
    call BlzFrameSetEnable(LocalMp3Player___lmpLinkEdit, true)
    call BlzFrameSetLevel(LocalMp3Player___lmpLinkEdit, 20)
    call BlzFrameSetVisible(LocalMp3Player___lmpLinkEdit, false)
    call BlzTriggerRegisterFrameEvent(LocalMp3Player___lmpLinkEditTrigger, LocalMp3Player___lmpLinkEdit, FRAMEEVENT_EDITBOX_ENTER)
    call BlzTriggerRegisterFrameEvent(LocalMp3Player___lmpLinkEditTrigger, LocalMp3Player___lmpLinkEdit, FRAMEEVENT_CONTROL_CLICK)

    // Plain black translucent background, matching the emoji panel.
    set LocalMp3Player___lmpPanel=BlzCreateFrameByType("BACKDROP", "LMPPanel", consoleUI, "", 0)
    call BlzFrameSetAbsPoint(LocalMp3Player___lmpPanel, FRAMEPOINT_CENTER, LocalMp3Player___LMP_PANEL_X, LocalMp3Player___LMP_PANEL_Y)
    call BlzFrameSetSize(LocalMp3Player___lmpPanel, LocalMp3Player___LMP_PANEL_WIDTH, LocalMp3Player___LMP_PANEL_HEIGHT)
    call BlzFrameSetTexture(LocalMp3Player___lmpPanel, LocalMp3Player___LMP_TEX_BLACK, 0, true)
    call BlzFrameSetAlpha(LocalMp3Player___lmpPanel, 210)

    set title=BlzCreateFrameByType("TEXT", "LMPTitle", LocalMp3Player___lmpPanel, "", 0)
    call BlzFrameSetAbsPoint(title, FRAMEPOINT_CENTER, LocalMp3Player___LMP_TITLE_X, LocalMp3Player___LMP_TITLE_Y)
    call BlzFrameSetSize(title, LocalMp3Player___LMP_TITLE_WIDTH, LocalMp3Player___LMP_TITLE_HEIGHT)
    call BlzFrameSetTextAlignment(title, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
    call BlzFrameSetScale(title, 0.82)
    call BlzFrameSetText(title, "|cffffcc00WOS2 Music|r")

    set LocalMp3Player___lmpCloseButton=LocalMp3Player___LMP_CreateIconButton(LocalMp3Player___lmpPanel , LocalMp3Player___LMP_CLOSE_X , LocalMp3Player___LMP_CLOSE_Y , LocalMp3Player___LMP_CLOSE_SIZE , 103)
    set icon=LocalMp3Player___LMP_CreateIcon(LocalMp3Player___lmpCloseButton , LocalMp3Player___LMP_TEX_CLOSE)

    set LocalMp3Player___lmpNowPlaying=BlzCreateFrameByType("TEXT", "LMPNowPlaying", LocalMp3Player___lmpPanel, "", 0)
    call BlzFrameSetAbsPoint(LocalMp3Player___lmpNowPlaying, FRAMEPOINT_CENTER, LocalMp3Player___LMP_NOW_X, LocalMp3Player___LMP_NOW_Y)
    call BlzFrameSetSize(LocalMp3Player___lmpNowPlaying, LocalMp3Player___LMP_NOW_WIDTH, LocalMp3Player___LMP_NOW_HEIGHT)
    call BlzFrameSetTextAlignment(LocalMp3Player___lmpNowPlaying, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)

    set LocalMp3Player___lmpEqualizer=BlzCreateFrameByType("TEXT", "LMPEqualizer", LocalMp3Player___lmpPanel, "", 0)
    call BlzFrameSetAbsPoint(LocalMp3Player___lmpEqualizer, FRAMEPOINT_CENTER, LocalMp3Player___LMP_EQUALIZER_X, LocalMp3Player___LMP_EQUALIZER_Y)
    call BlzFrameSetSize(LocalMp3Player___lmpEqualizer, LocalMp3Player___LMP_EQUALIZER_WIDTH, LocalMp3Player___LMP_EQUALIZER_HEIGHT)
    call BlzFrameSetTextAlignment(LocalMp3Player___lmpEqualizer, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
    call BlzFrameSetScale(LocalMp3Player___lmpEqualizer, 0.78)
    call BlzFrameSetText(LocalMp3Player___lmpEqualizer, "|cff666666_____________|r")

    set LocalMp3Player___lmpTimeText=BlzCreateFrameByType("TEXT", "LMPTime", LocalMp3Player___lmpPanel, "", 0)
    call BlzFrameSetAbsPoint(LocalMp3Player___lmpTimeText, FRAMEPOINT_CENTER, LocalMp3Player___LMP_TIME_X, LocalMp3Player___LMP_TIME_Y)
    call BlzFrameSetSize(LocalMp3Player___lmpTimeText, LocalMp3Player___LMP_TIME_WIDTH, LocalMp3Player___LMP_TIME_HEIGHT)
    call BlzFrameSetTextAlignment(LocalMp3Player___lmpTimeText, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
    call BlzFrameSetScale(LocalMp3Player___lmpTimeText, 0.78)

    // Native horizontal template from UI\FrameDef\UI\escmenutemplates.fdf.
    // Templates.TOC is loaded immediately before LocalMp3Player_CreateUI.
    set LocalMp3Player___lmpSeek=BlzCreateFrame("EscMenuSliderTemplate", gameUI, 0, 0)
    if LocalMp3Player___lmpSeek == null then
        call BJDebugMsg("|cffff2020LocalMp3Player: native EscMenuSliderTemplate was not created.|r")
        return
    endif
    call BlzFrameClearAllPoints(LocalMp3Player___lmpSeek)
    call BlzFrameSetAbsPoint(LocalMp3Player___lmpSeek, FRAMEPOINT_CENTER, LocalMp3Player___LMP_PROGRESS_X, LocalMp3Player___LMP_PROGRESS_Y)
    call BlzFrameSetSize(LocalMp3Player___lmpSeek, LocalMp3Player___LMP_PROGRESS_WIDTH, LocalMp3Player___LMP_PROGRESS_HEIGHT)
    call BlzFrameSetMinMaxValue(LocalMp3Player___lmpSeek, 0.00, 1000.00)
    call BlzFrameSetStepSize(LocalMp3Player___lmpSeek, 1.00)
    call BlzFrameSetAlpha(LocalMp3Player___lmpSeek, 255)
    call BlzFrameSetValue(LocalMp3Player___lmpSeek, 0.00)
    call BlzFrameSetEnable(LocalMp3Player___lmpSeek, true)
    call BlzFrameSetVisible(LocalMp3Player___lmpSeek, true)
    call BlzFrameSetLevel(LocalMp3Player___lmpSeek, 20)

    // The duration bar is display-only. This transparent frame consumes mouse
    // clicks while leaving the slider and its moving thumb fully visible.
    set LocalMp3Player___lmpSeekBlocker=BlzCreateFrameByType("BUTTON", "LMPProgressBlocker", gameUI, "", 600)
    call BlzFrameClearAllPoints(LocalMp3Player___lmpSeekBlocker)
    call BlzFrameSetAbsPoint(LocalMp3Player___lmpSeekBlocker, FRAMEPOINT_CENTER, LocalMp3Player___LMP_PROGRESS_X, LocalMp3Player___LMP_PROGRESS_Y)
    call BlzFrameSetSize(LocalMp3Player___lmpSeekBlocker, LocalMp3Player___LMP_PROGRESS_WIDTH, LocalMp3Player___LMP_PROGRESS_HEIGHT)
    call BlzFrameSetAlpha(LocalMp3Player___lmpSeekBlocker, 0)
    call BlzFrameSetLevel(LocalMp3Player___lmpSeekBlocker, 21)

    // Three visible tracks; additional tracks are reached by wheel/scrollbar.
    set LocalMp3Player___lmpListBox=BlzCreateFrameByType("BACKDROP", "LMPListBox", LocalMp3Player___lmpPanel, "", 0)
    call BlzFrameSetAbsPoint(LocalMp3Player___lmpListBox, FRAMEPOINT_CENTER, LocalMp3Player___LMP_LIST_X, LocalMp3Player___LMP_LIST_Y)
    call BlzFrameSetSize(LocalMp3Player___lmpListBox, LocalMp3Player___LMP_LIST_WIDTH, LocalMp3Player___LMP_LIST_HEIGHT)
    call BlzFrameSetTexture(LocalMp3Player___lmpListBox, LocalMp3Player___LMP_TEX_BLACK, 0, true)
    call BlzFrameSetAlpha(LocalMp3Player___lmpListBox, 210)
    call BlzFrameSetEnable(LocalMp3Player___lmpListBox, true)
    call BlzTriggerRegisterFrameEvent(LocalMp3Player___lmpWheelTrigger, LocalMp3Player___lmpListBox, FRAMEEVENT_MOUSE_WHEEL)

    loop
        exitwhen row >= LocalMp3Player___LMP_ROWS
        set rowY=LocalMp3Player___LMP_ROW_FIRST_Y - I2R(row) * LocalMp3Player___LMP_ROW_STEP_Y
        set LocalMp3Player___lmpRow[row]=LocalMp3Player___LMP_CreateTextButton(LocalMp3Player___lmpListBox , "" , LocalMp3Player___LMP_ROW_X , rowY , LocalMp3Player___LMP_ROW_WIDTH , LocalMp3Player___LMP_ROW_HEIGHT , 300 + row)
        call BlzTriggerRegisterFrameEvent(LocalMp3Player___lmpWheelTrigger, LocalMp3Player___lmpRow[row], FRAMEEVENT_MOUSE_WHEEL)
        set row=row + 1
    endloop

    set LocalMp3Player___lmpScroll=BlzCreateFrameByType("SLIDER", "LMPScroll", LocalMp3Player___lmpPanel, "QuestMainListScrollBar", 0)
    call BlzFrameSetAbsPoint(LocalMp3Player___lmpScroll, FRAMEPOINT_CENTER, LocalMp3Player___LMP_SCROLL_X, LocalMp3Player___LMP_SCROLL_Y)
    call BlzFrameSetSize(LocalMp3Player___lmpScroll, LocalMp3Player___LMP_SCROLL_WIDTH, LocalMp3Player___LMP_SCROLL_HEIGHT)
    call BlzFrameSetMinMaxValue(LocalMp3Player___lmpScroll, 0.00, I2R(LocalMp3Player___LMP_MaxOffset()))
    call BlzFrameSetStepSize(LocalMp3Player___lmpScroll, 1.00)
    call BlzFrameSetValue(LocalMp3Player___lmpScroll, I2R(LocalMp3Player___LMP_MaxOffset()))
    call BlzTriggerRegisterFrameEvent(LocalMp3Player___lmpScrollTrigger, LocalMp3Player___lmpScroll, FRAMEEVENT_SLIDER_VALUE_CHANGED)

    // First row: previous, -10, play/pause, +10, next.
    set LocalMp3Player___lmpPreviousButton=LocalMp3Player___LMP_CreateIconButton(LocalMp3Player___lmpPanel , LocalMp3Player___LMP_PREVIOUS_X , LocalMp3Player___LMP_CONTROLS_ROW1_Y , LocalMp3Player___LMP_CONTROL_SIZE , 200)
    set icon=LocalMp3Player___LMP_CreateIcon(LocalMp3Player___lmpPreviousButton , LocalMp3Player___LMP_TEX_PREVIOUS)
    set LocalMp3Player___lmpBack10Button=LocalMp3Player___LMP_CreateIconButton(LocalMp3Player___lmpPanel , LocalMp3Player___LMP_BACK_10_X , LocalMp3Player___LMP_CONTROLS_ROW1_Y , LocalMp3Player___LMP_CONTROL_SIZE , 201)
    set icon=LocalMp3Player___LMP_CreateIcon(LocalMp3Player___lmpBack10Button , LocalMp3Player___LMP_TEX_BACK_10)
    set LocalMp3Player___lmpPlayPauseButton=LocalMp3Player___LMP_CreateIconButton(LocalMp3Player___lmpPanel , LocalMp3Player___LMP_PLAY_PAUSE_X , LocalMp3Player___LMP_CONTROLS_ROW1_Y , LocalMp3Player___LMP_CONTROL_SIZE , 202)
    set LocalMp3Player___lmpPlayPauseIcon=LocalMp3Player___LMP_CreateIcon(LocalMp3Player___lmpPlayPauseButton , LocalMp3Player___LMP_TEX_PLAY)
    set LocalMp3Player___lmpForward10Button=LocalMp3Player___LMP_CreateIconButton(LocalMp3Player___lmpPanel , LocalMp3Player___LMP_FORWARD_10_X , LocalMp3Player___LMP_CONTROLS_ROW1_Y , LocalMp3Player___LMP_CONTROL_SIZE , 203)
    set icon=LocalMp3Player___LMP_CreateIcon(LocalMp3Player___lmpForward10Button , LocalMp3Player___LMP_TEX_FORWARD_10)
    set LocalMp3Player___lmpNextButton=LocalMp3Player___LMP_CreateIconButton(LocalMp3Player___lmpPanel , LocalMp3Player___LMP_NEXT_X , LocalMp3Player___LMP_CONTROLS_ROW1_Y , LocalMp3Player___LMP_CONTROL_SIZE , 204)
    set icon=LocalMp3Player___LMP_CreateIcon(LocalMp3Player___lmpNextButton , LocalMp3Player___LMP_TEX_NEXT)

    // Second centered row: restart, loop, shuffle.
    set LocalMp3Player___lmpRerunButton=LocalMp3Player___LMP_CreateIconButton(LocalMp3Player___lmpPanel , LocalMp3Player___LMP_RERUN_X , LocalMp3Player___LMP_CONTROLS_ROW2_Y , LocalMp3Player___LMP_CONTROL_SIZE , 205)
    set icon=LocalMp3Player___LMP_CreateIcon(LocalMp3Player___lmpRerunButton , LocalMp3Player___LMP_TEX_RERUN)
    set LocalMp3Player___lmpLoopButton=LocalMp3Player___LMP_CreateIconButton(LocalMp3Player___lmpPanel , LocalMp3Player___LMP_LOOP_X , LocalMp3Player___LMP_CONTROLS_ROW2_Y , LocalMp3Player___LMP_CONTROL_SIZE , 206)
    set LocalMp3Player___lmpLoopIcon=LocalMp3Player___LMP_CreateIcon(LocalMp3Player___lmpLoopButton , LocalMp3Player___LMP_TEX_LOOP_OFF)
    set LocalMp3Player___lmpShuffleButton=LocalMp3Player___LMP_CreateIconButton(LocalMp3Player___lmpPanel , LocalMp3Player___LMP_SHUFFLE_X , LocalMp3Player___LMP_CONTROLS_ROW2_Y , LocalMp3Player___LMP_CONTROL_SIZE , 207)
    set LocalMp3Player___lmpShuffleIcon=LocalMp3Player___LMP_CreateIcon(LocalMp3Player___lmpShuffleButton , LocalMp3Player___LMP_TEX_SHUFFLE_OFF)

    call LocalMp3Player___LMP_AttachNativeTooltip(LocalMp3Player___lmpPreviousButton , "Previous track")
    call LocalMp3Player___LMP_AttachNativeTooltip(LocalMp3Player___lmpBack10Button , "Rewind 10 seconds")
    call LocalMp3Player___LMP_AttachNativeTooltip(LocalMp3Player___lmpPlayPauseButton , "Play / pause")
    call LocalMp3Player___LMP_AttachNativeTooltip(LocalMp3Player___lmpForward10Button , "Forward 10 seconds")
    call LocalMp3Player___LMP_AttachNativeTooltip(LocalMp3Player___lmpNextButton , "Next track")
    call LocalMp3Player___LMP_AttachNativeTooltip(LocalMp3Player___lmpRerunButton , "Restart current track")
    call LocalMp3Player___LMP_AttachNativeTooltip(LocalMp3Player___lmpLoopButton , "Repeat current track")
    call LocalMp3Player___LMP_AttachNativeTooltip(LocalMp3Player___lmpShuffleButton , "Shuffle playlist")

    // Real horizontal interactive volume slider using the same built-in skin.
    set LocalMp3Player___lmpVolumeText=BlzCreateFrameByType("TEXT", "LMPVolumeText", LocalMp3Player___lmpPanel, "", 0)
    call BlzFrameSetAbsPoint(LocalMp3Player___lmpVolumeText, FRAMEPOINT_CENTER, LocalMp3Player___LMP_VOLUME_TEXT_X, LocalMp3Player___LMP_VOLUME_TEXT_Y)
    call BlzFrameSetSize(LocalMp3Player___lmpVolumeText, LocalMp3Player___LMP_VOLUME_TEXT_WIDTH, LocalMp3Player___LMP_VOLUME_TEXT_HEIGHT)
    call BlzFrameSetTextAlignment(LocalMp3Player___lmpVolumeText, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
    call BlzFrameSetScale(LocalMp3Player___lmpVolumeText, 0.72)
    call BlzFrameSetText(LocalMp3Player___lmpVolumeText, "|cffffffffVOLUME 100%|r")

    set LocalMp3Player___lmpVolumeSlider=BlzCreateFrame("EscMenuSliderTemplate", gameUI, 0, 1)
    if LocalMp3Player___lmpVolumeSlider == null then
        call BJDebugMsg("|cffff2020LocalMp3Player: native volume EscMenuSliderTemplate was not created.|r")
        return
    endif
    call BlzFrameClearAllPoints(LocalMp3Player___lmpVolumeSlider)
    call BlzFrameSetAbsPoint(LocalMp3Player___lmpVolumeSlider, FRAMEPOINT_CENTER, LocalMp3Player___LMP_VOLUME_X, LocalMp3Player___LMP_VOLUME_Y)
    call BlzFrameSetSize(LocalMp3Player___lmpVolumeSlider, LocalMp3Player___LMP_VOLUME_WIDTH, LocalMp3Player___LMP_VOLUME_HEIGHT)
    call BlzFrameSetMinMaxValue(LocalMp3Player___lmpVolumeSlider, 0.00, 127.00)
    call BlzFrameSetStepSize(LocalMp3Player___lmpVolumeSlider, 1.00)
    call BlzFrameSetAlpha(LocalMp3Player___lmpVolumeSlider, 255)
    call BlzFrameSetValue(LocalMp3Player___lmpVolumeSlider, 127.00)
    call BlzFrameSetEnable(LocalMp3Player___lmpVolumeSlider, true)
    call BlzFrameSetVisible(LocalMp3Player___lmpVolumeSlider, true)
    call BlzFrameSetLevel(LocalMp3Player___lmpVolumeSlider, 20)
    call BlzTriggerRegisterFrameEvent(LocalMp3Player___lmpVolumeTrigger, LocalMp3Player___lmpVolumeSlider, FRAMEEVENT_SLIDER_VALUE_CHANGED)

    call BlzFrameSetVisible(LocalMp3Player___lmpPanel, false)
    call BlzFrameSetVisible(LocalMp3Player___lmpSeek, false)
    call BlzFrameSetVisible(LocalMp3Player___lmpSeekBlocker, false)
    call BlzFrameSetVisible(LocalMp3Player___lmpVolumeSlider, false)
    // После полного создания музыкального UI показываем кнопку открытия.
    call BlzFrameSetVisible(lmpOpenButton, true)
    call BlzFrameSetVisible(lmpLinkButton, true)

    call TriggerAddAction(LocalMp3Player___lmpClickTrigger, function LocalMp3Player___LMP_OnClick)
    call TriggerAddAction(LocalMp3Player___lmpScrollTrigger, function LocalMp3Player___LMP_OnScroll)
    call TriggerAddAction(LocalMp3Player___lmpWheelTrigger, function LocalMp3Player___LMP_OnWheel)
    call TriggerAddAction(LocalMp3Player___lmpLinkEditTrigger, function LocalMp3Player___LMP_OnLinkEdit)
    call TriggerAddAction(LocalMp3Player___lmpVolumeTrigger, function LocalMp3Player___LMP_OnVolume)

    set LocalMp3Player___lmpFramesReady=true
    set icon=null
    set title=null
    set gameUI=null
    set consoleUI=null
endfunction

//===========================================================================
// Deferred local MP3 duration scan
//===========================================================================
function LocalMp3Player___LMP_FinishTrackScan takes nothing returns nothing
    local integer pid= 0
    local player p

    call PauseTimer(LocalMp3Player___lmpScanTimer)

    loop
        exitwhen pid >= bj_MAX_PLAYERS
        call LocalMp3Player___LMP_ResetOrder(pid)

        if LocalMp3Player___lmpFramesReady then
            set p=Player(pid)
            if GetLocalPlayer() == p then
                set LocalMp3Player___lmpListOffset[pid]=0
                call BlzFrameSetMinMaxValue(LocalMp3Player___lmpScroll, 0.00, I2R(LocalMp3Player___LMP_MaxOffset()))
                call BlzFrameSetValue(LocalMp3Player___lmpScroll, I2R(LocalMp3Player___LMP_MaxOffset()))
            endif
            call LocalMp3Player___LMP_UpdateAll(p)
        endif

        set pid=pid + 1
    endloop

    set p=null
endfunction

function LocalMp3Player___LMP_ScanTrackTick takes nothing returns nothing
    local string filePath
    local string displayName
    local integer durationMs
    local integer batch= 0

    if LocalMp3Player___lmpScanTrack > LocalMp3Player___LMP_SCAN_FILE_COUNT then
        call LocalMp3Player___LMP_FinishTrackScan()
        return
    endif

    // Один файл за тик ограничивает максимальный синхронный I/O-всплеск.
    loop
        exitwhen batch >= LocalMp3Player___LMP_SCAN_BATCH or LocalMp3Player___lmpScanTrack > LocalMp3Player___LMP_SCAN_FILE_COUNT

        set filePath="Music\\" + I2S(LocalMp3Player___lmpScanTrack) + ".mp3"
        if LocalMp3Player___lmpScanTrack < 10 then
            set displayName="Track 0" + I2S(LocalMp3Player___lmpScanTrack)
        else
            set displayName="Track " + I2S(LocalMp3Player___lmpScanTrack)
        endif

        // Натив читает локальный файл напрямую и не создаёт sound-handle.
        // Поэтому локальная замена Music\\N.mp3 по-прежнему получает свою длительность.
        set durationMs=GetSoundFileDuration(filePath)
        if durationMs > LocalMp3Player___LMP_DURATION_CORRECTION_MS then
            set durationMs=durationMs - LocalMp3Player___LMP_DURATION_CORRECTION_MS
        endif

        if durationMs > 0 and LocalMp3Player___lmpTrackCount < LocalMp3Player___LMP_MAX_TRACKS then
            set LocalMp3Player___lmpTrackCount=LocalMp3Player___lmpTrackCount + 1
            set LocalMp3Player___lmpPath[LocalMp3Player___lmpTrackCount]=filePath
            set LocalMp3Player___lmpTitle[LocalMp3Player___lmpTrackCount]=displayName
            set LocalMp3Player___lmpDurationMs[LocalMp3Player___lmpTrackCount]=durationMs
        endif

        set LocalMp3Player___lmpScanTrack=LocalMp3Player___lmpScanTrack + 1
        set batch=batch + 1
    endloop

    if LocalMp3Player___lmpScanTrack > LocalMp3Player___LMP_SCAN_FILE_COUNT then
        call LocalMp3Player___LMP_FinishTrackScan()
    endif
endfunction

function LocalMp3Player___LMP_BeginTrackScan takes nothing returns nothing
    set LocalMp3Player___lmpScanTrack=1
    set LocalMp3Player___lmpTrackCount=0
    call TimerStart(LocalMp3Player___lmpScanTimer, LocalMp3Player___LMP_SCAN_INTERVAL, true, function LocalMp3Player___LMP_ScanTrackTick)
endfunction
//===========================================================================
// Initialization
//===========================================================================
function LocalMp3Player_CreateUI takes nothing returns nothing
    local integer pid= 0
    local player p

    if LocalMp3Player___lmpFramesReady then
        return
    endif

    // The TOC is normally loaded by the library initializer. Retry once here
    // in case another map system requested the UI unusually early.
    if not LocalMp3Player___lmpTocLoaded then
        set LocalMp3Player___lmpTocLoaded=BlzLoadTOCFile("war3mapImported\\Templates.toc")
    endif

    if not LocalMp3Player___lmpTocLoaded then
        call BJDebugMsg("|cffff2020LocalMp3Player: failed to load war3mapImported\\Templates.toc.|r")
        return
    endif

    call LocalMp3Player___LMP_CreateFrames()

    if LocalMp3Player___lmpFramesReady then
        loop
            exitwhen pid >= bj_MAX_PLAYERS
            set p=Player(pid)
            if GetLocalPlayer() == p then
                call BlzFrameSetText(LocalMp3Player___lmpVolumeText, "|cffffffffVOLUME 100%|r")
            endif
            set pid=pid + 1
        endloop
        call TimerStart(LocalMp3Player___lmpUpdateTimer, LocalMp3Player___LMP_TICK, true, function LocalMp3Player___LMP_OnTick)
    endif

    set p=null
endfunction



function LocalMp3Player___LocalMp3Player_Init takes nothing returns nothing
    local integer pid= 0
    local player p
    // Load all required frame definitions once, before any player UI is built.
    set LocalMp3Player___lmpTocLoaded=BlzLoadTOCFile("war3mapImported\\Templates.toc")
    if not LocalMp3Player___lmpTocLoaded then
        call BJDebugMsg("|cffff2020LocalMp3Player: failed to load war3mapImported\\Templates.toc during initialization.|r")
    endif
    loop
        exitwhen pid >= 10
        set p=Player(pid)
        set LocalMp3Player___lmpCurrent[pid]=0
        set LocalMp3Player___lmpListOffset[pid]=0
        set LocalMp3Player___lmpPlaying[pid]=false
        set LocalMp3Player___lmpPaused[pid]=false
        set LocalMp3Player___lmpLoop[pid]=false
        set LocalMp3Player___lmpShuffle[pid]=false
        set LocalMp3Player___lmpVisible[pid]=false
        set LocalMp3Player___lmpLinkVisible[pid]=false
        set LocalMp3Player___lmpClickBusy[pid]=false
        set LocalMp3Player___lmpShuffleNonce[pid]=0
        set LocalMp3Player___lmpElapsed[pid]=0.00
        set LocalMp3Player___lmpUiElapsed[pid]=0.00
        set LocalMp3Player___lmpEqualizerElapsed[pid]=0.00
        set LocalMp3Player___lmpEqualizerPhase[pid]=0
        set LocalMp3Player___lmpVolume[pid]=127
        set LocalMp3Player___lmpDefaultMusicStopped[pid]=false
        set LocalMp3Player___lmpActiveMusicTrack[pid]=0
        set LocalMp3Player___lmpPendingMusicTrack[pid]=0
        set LocalMp3Player___lmpPendingMusicPositionMs[pid]=0
        set LocalMp3Player___lmpMusicSwitchPhase[pid]=0
        set LocalMp3Player___lmpPendingMusicVolume[pid]=127
        set LocalMp3Player___lmpMusicVolumeDirty[pid]=false
        set LocalMp3Player___lmpSkipElapsedTick[pid]=false
        call LocalMp3Player___LMP_ResetOrder(pid)
        call TriggerRegisterPlayerChatEvent(LocalMp3Player___lmpChatTrigger, p, LocalMp3Player___LMP_COMMAND, true)
        set pid=pid + 1
    endloop

    call TriggerAddAction(LocalMp3Player___lmpChatTrigger, function LocalMp3Player___LMP_OnChat)

    // Let map music and mode-selection initialization finish first.
    call TimerStart(LocalMp3Player___lmpScanTimer, LocalMp3Player___LMP_SCAN_DELAY, false, function LocalMp3Player___LMP_BeginTrackScan)

    set p=null
endfunction


//library LocalMp3Player ends
//library TasAbilityChargeBox:
   
//Adds a custom ChargeBox over Command Buttons to display a xx Text
//requires loading a fdf/toc containing "TasAbilityChargeBox"
//incorrect display when commandbutton Positions colide or in Group selection

//function TasAbilityChargeBox_SetValue takes unit u, integer spellCode, string value returns nothing
   //enforce a wanted Value for that spellCode for unit
//function TasAbilityChargeBox_GetValue takes unit u, integer spellCode returns string
//function TasAbilityChargeBox_Clear(unit u)
//function TasAbilityChargeBox_Init()

   
   function TasAbilityChargeBox_GetUnitSpellCodeKey takes integer unitId,integer spellCode returns integer
      local integer count= LoadInteger(TasAbilityChargeBox_Hash, unitId, 0)
      local integer loopA= 0
      loop
         set loopA=loopA + 1
         exitwhen loopA > count
         if LoadInteger(TasAbilityChargeBox_Hash, unitId, loopA) == spellCode then
            return loopA
         endif
      endloop
      set count=count + 1
      call SaveInteger(TasAbilityChargeBox_Hash, unitId, 0, count)
      call SaveInteger(TasAbilityChargeBox_Hash, unitId, count, spellCode)
      return count
   endfunction

   function TasAbilityChargeBox_SetValue takes unit u,integer spellCode,string value returns nothing
      local integer unitId= GetHandleId(u)
      call TasAbilityChargeBox_GetUnitSpellCodeKey(unitId , spellCode)
      call SaveStr(TasAbilityChargeBox_Hash, unitId, spellCode, value)
   endfunction

   function TasAbilityChargeBox_GetValue takes unit u,integer spellCode returns string
      return LoadStr(TasAbilityChargeBox_Hash, GetHandleId(u), spellCode)
   endfunction

   function TasAbilityChargeBox_Clear takes unit u returns nothing
      call FlushChildHashtable(TasAbilityChargeBox_Hash, GetHandleId(u))
   endfunction

   function TasAbilityChargeBox_Update takes nothing returns nothing
      local integer unitId= GetHandleId(TasAbilityChargeBox_Unit[GetPlayerId(GetLocalPlayer())])
      local integer i= 0
      local integer pos
      local integer spellCode
    
      loop
         exitwhen i > 11
         call BlzFrameSetVisible(TasAbilityChargeBox_FrameBox[i], false)
         set i=i + 1
      endloop

      // One wants to display something specific?
      set i=LoadInteger(TasAbilityChargeBox_Hash, unitId, 0)
      loop
         exitwhen i <= 0
         set spellCode=LoadInteger(TasAbilityChargeBox_Hash, unitId, i)
         set pos=BlzGetAbilityPosX(spellCode) + BlzGetAbilityPosY(spellCode) * 4
         if pos >= 0 and i <= 11 then
            call BlzFrameSetVisible(TasAbilityChargeBox_FrameBox[pos], true)
            call BlzFrameSetText(TasAbilityChargeBox_FrameText[pos], LoadStr(TasAbilityChargeBox_Hash, unitId, spellCode))
         endif
         set i=i - 1
      endloop
   endfunction

   function TasAbilityChargeBox__Create takes nothing returns nothing
      local framehandle commandButton
      local integer i= 0
      local string font= "Fonts/FRIZQT__.TTF"
      if TasAbilityChargeBox_TocPath == null or TasAbilityChargeBox_TocPath == "" or not BlzLoadTOCFile(TasAbilityChargeBox_TocPath) then



         loop
            exitwhen i > 11
            set commandButton=BlzGetOriginFrame(ORIGIN_FRAME_COMMAND_BUTTON, i)
            set TasAbilityChargeBox_FrameBox[i]=BlzCreateSimpleFrame("SimpleInfoPanelIconDamage", commandButton, 21)
            set TasAbilityChargeBox_FrameIcon[i]=BlzGetFrameByName("InfoPanelIconBackdrop", 21)
            set TasAbilityChargeBox_FrameText[i]=BlzGetFrameByName("InfoPanelIconValue", 21)
            call BlzFrameSetText(BlzGetFrameByName("InfoPanelIconLevel", 21), "")
            call BlzFrameSetText(BlzGetFrameByName("InfoPanelIconLabel", 21), "")

            call BlzFrameClearAllPoints(TasAbilityChargeBox_FrameIcon[i])
            call BlzFrameSetPoint(TasAbilityChargeBox_FrameIcon[i], FRAMEPOINT_BOTTOMRIGHT, commandButton, FRAMEPOINT_BOTTOMRIGHT, 0.003, - 0.003)
            call BlzFrameSetSize(TasAbilityChargeBox_FrameIcon[i], 0.02, 0.02)
            call BlzFrameSetTexture(TasAbilityChargeBox_FrameIcon[i], "UI/Widgets/Console/Human/CommandButton/human-button-lvls-overlay.blp", 0, true)

            call BlzFrameClearAllPoints(TasAbilityChargeBox_FrameText[i])
            call BlzFrameSetPoint(TasAbilityChargeBox_FrameText[i], FRAMEPOINT_BOTTOMRIGHT, commandButton, FRAMEPOINT_BOTTOMRIGHT, 0.003, - 0.003)
            call BlzFrameSetSize(TasAbilityChargeBox_FrameText[i], 0.02, 0.02)
            call BlzFrameSetTextAlignment(TasAbilityChargeBox_FrameText[i], TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
            call BlzFrameSetFont(TasAbilityChargeBox_FrameText[i], font, 0.011, 0)

            call BlzFrameSetVisible(TasAbilityChargeBox_FrameBox[i], false)
            set i=i + 1
         endloop
      else
         loop
            exitwhen i > 11
            set TasAbilityChargeBox_FrameBox[i]=BlzCreateSimpleFrame("TasAbilityChargeBox", BlzGetOriginFrame(ORIGIN_FRAME_COMMAND_BUTTON, i), i)
            // reserve HandleId, used Async later
            set TasAbilityChargeBox_FrameText[i]=BlzGetFrameByName("TasAbilityChargeBoxText", i)
            call BlzFrameSetVisible(TasAbilityChargeBox_FrameBox[i], false)
            set i=i + 1
         endloop
         if GetHandleId(TasAbilityChargeBox_FrameBox[1]) == 0 then
            call BJDebugMsg(" Error Creating Frames")
         endif
      endif
   endfunction

   function TasAbilityChargeBox_Select takes nothing returns nothing
      set TasAbilityChargeBox_Unit[GetPlayerId(GetTriggerPlayer())]=GetTriggerUnit()
   endfunction

   function TasAbilityChargeBox_Init takes nothing returns nothing
      local trigger trig
      call TimerStart(CreateTimer(), TasAbilityChargeBox_UpdateIntervale, true, function TasAbilityChargeBox_Update)
      call TasAbilityChargeBox__Create()



      set trig=CreateTrigger()
      call TriggerAddAction(trig, function TasAbilityChargeBox_Select)
      call TriggerRegisterAnyUnitEventBJ(trig, EVENT_PLAYER_UNIT_SELECTED)
      set TasAbilityChargeBox_Hash=InitHashtable()
   endfunction

//library TasAbilityChargeBox ends
//library TooltipBuilder:



        function s__TooltipBuilder_create takes nothing returns integer
            local integer this= s__TooltipBuilder__allocate()
            set s__TooltipBuilder_buffer[this]=""
            set s__TooltipBuilder_hasStats[this]=false
            return this
        endfunction

        function s__TooltipBuilder_addTitle takes integer this,string title returns integer
            set s__TooltipBuilder_buffer[this]=s__TooltipBuilder_buffer[this] + TooltipBuilder___C_TITLE + title + TooltipBuilder___C_RESET
            return this
        endfunction
        
        function s__TooltipBuilder_addDescription takes integer this,string text returns integer
            if ( text != "" ) then
                if ( s__TooltipBuilder_buffer[this] != "" ) then
                    set s__TooltipBuilder_buffer[this]=s__TooltipBuilder_buffer[this] + "|n"
                endif
                set s__TooltipBuilder_buffer[this]=s__TooltipBuilder_buffer[this] + text
            endif
            return this
        endfunction

        function s__TooltipBuilder_addBonus takes integer this,string text returns integer
            local integer len
            if ( text != "" and text != null ) then
                set len=StringLength(text)
                loop
                    exitwhen len < 2 or SubString(text, len - 2, len) != "|n"
                    set text=SubString(text, 0, len - 2)
                    set len=len - 2
                endloop

                if ( text != "" ) then
                    if ( s__TooltipBuilder_buffer[this] != "" ) then
                        set s__TooltipBuilder_buffer[this]=s__TooltipBuilder_buffer[this] + "|n|n" + text
                    else
                        set s__TooltipBuilder_buffer[this]=text
                    endif
                endif
            endif
            return this
        endfunction

        function s__TooltipBuilder_checkFirstStat takes integer this returns nothing
            if not s__TooltipBuilder_hasStats[this] then
                set s__TooltipBuilder_hasStats[this]=true
                if ( s__TooltipBuilder_buffer[this] != "" ) then
                    set s__TooltipBuilder_buffer[this]=s__TooltipBuilder_buffer[this] + "|n"
                endif
            endif
        endfunction

        function s__TooltipBuilder_addDamage takes integer this,integer dmgType,string value returns integer
            local string color= ""
            local string name= ""
            
            if ( dmgType == 1 ) then
                set color=TooltipBuilder___C_PHYS
                set name="Phys. Damage:"
            elseif ( dmgType == 2 ) then
                set color=TooltipBuilder___C_MAGIC
                set name="Mag. Damage:"
            elseif ( dmgType == 3 ) then
                set color=TooltipBuilder___C_TRUE
                set name="True Damage:"
            else
                set color=TooltipBuilder___C_STAT
                set name="Damage:"
            endif

            call s__TooltipBuilder_checkFirstStat(this)
            set s__TooltipBuilder_buffer[this]=s__TooltipBuilder_buffer[this] + "|n" + color + name + "|r " + value
            return this
        endfunction

        function s__TooltipBuilder_addCustomDamage takes integer this,integer dmgType,string name,string value returns integer
            local string color= ""
            
            if ( dmgType == 1 ) then
                set color=TooltipBuilder___C_PHYS
            elseif ( dmgType == 2 ) then
                set color=TooltipBuilder___C_MAGIC
            elseif ( dmgType == 3 ) then
                set color=TooltipBuilder___C_TRUE
            else
                set color=TooltipBuilder___C_STAT
            endif

            call s__TooltipBuilder_checkFirstStat(this)
            set s__TooltipBuilder_buffer[this]=s__TooltipBuilder_buffer[this] + "|n" + color + name + "|r " + value
            return this
        endfunction

        function s__TooltipBuilder_addRange takes integer this,string rangeValue returns integer
            if ( rangeValue != "" and rangeValue != "0" ) then
                call s__TooltipBuilder_checkFirstStat(this)
                set s__TooltipBuilder_buffer[this]=s__TooltipBuilder_buffer[this] + "|n" + TooltipBuilder___C_STAT + "Range:|r " + rangeValue
            endif
            return this
        endfunction

        function s__TooltipBuilder_addMechanic takes integer this,string text returns integer
            local integer len
            if ( text != "" and text != null ) then
                call s__TooltipBuilder_checkFirstStat(this)
                set len=StringLength(text)
                loop
                    exitwhen len < 2 or SubString(text, len - 2, len) != "|n"
                    set text=SubString(text, 0, len - 2)
                    set len=len - 2
                endloop

                if ( text != "" ) then
                    if StringLength(text) >= 2 and SubString(text, 0, 2) == "|n" then
                        set s__TooltipBuilder_buffer[this]=s__TooltipBuilder_buffer[this] + text
                    else
                        set s__TooltipBuilder_buffer[this]=s__TooltipBuilder_buffer[this] + "|n" + text
                    endif
                endif
            endif
            return this
        endfunction
        
        function s__TooltipBuilder_addCooldownEx takes integer this,string cdValue,boolean afterDur returns integer
            if ( cdValue != "" and cdValue != "0" ) then
                call s__TooltipBuilder_checkFirstStat(this)
                if afterDur then
                    set s__TooltipBuilder_buffer[this]=s__TooltipBuilder_buffer[this] + "|n" + TooltipBuilder___C_STAT + "CD:|r " + cdValue + " sec (After duration)"
                else
                    set s__TooltipBuilder_buffer[this]=s__TooltipBuilder_buffer[this] + "|n" + TooltipBuilder___C_STAT + "CD:|r " + cdValue + " sec"
                endif
            endif
            return this
        endfunction

        function s__TooltipBuilder_addCooldown takes integer this,string cdValue returns integer
            return s__TooltipBuilder_addCooldownEx(this,cdValue , false)
        endfunction

        function s__TooltipBuilder_addDecorDamage takes integer this,string val returns integer
            if ( val != "" and val != "0" ) then
                call s__TooltipBuilder_checkFirstStat(this)
                set s__TooltipBuilder_buffer[this]=s__TooltipBuilder_buffer[this] + "|n" + TooltipBuilder___C_DECOR + "Decor Damage:|r " + val
            endif
            return this
        endfunction

        function s__TooltipBuilder_addMana takes integer this,string manaValue returns integer
            if ( manaValue != "" and manaValue != "0" ) then
                call s__TooltipBuilder_checkFirstStat(this)
                set s__TooltipBuilder_buffer[this]=s__TooltipBuilder_buffer[this] + "|n" + TooltipBuilder___C_MAGIC + "Mana:|r " + manaValue
            endif
            return this
        endfunction

        function s__TooltipBuilder_applyToAbility takes integer this,integer abilCode,integer level returns nothing
            call BlzSetAbilityExtendedTooltip(abilCode, s__TooltipBuilder_buffer[this], level - 1)
        endfunction
        
        function s__TooltipBuilder_applyToAbilityLearn takes integer this,integer abilCode,integer level returns nothing
            call BlzSetAbilityResearchExtendedTooltip(abilCode, s__TooltipBuilder_buffer[this], level - 1)
        endfunction

        function s__TooltipBuilder_applyToItem takes integer this,item it returns nothing
            call BlzSetItemExtendedTooltip(it, s__TooltipBuilder_buffer[this])
        endfunction

        function s__TooltipBuilder_get takes integer this returns string
            return s__TooltipBuilder_buffer[this]
        endfunction

        function s__TooltipBuilder_destroy takes integer this returns nothing
            set s__TooltipBuilder_buffer[this]=null
            call s__TooltipBuilder_deallocate(this)
        endfunction


//library TooltipBuilder ends
//library WOS2BotCodec:

//==============================================================================
// Лёгкая защита экспорта статистики WOS2.
//
// Это намеренно небольшой код без SHA/HMAC: он обфусцирует строки и добавляет
// ключевой MAC-подобный тег. Цель — остановить ручную правку файлов, а не
// противостоять человеку, который распаковал карту и восстановил алгоритм.
//==============================================================================


function WOS2BotCodec___WBC_PosMod takes integer value,integer base returns integer
    local integer result= ModuloInteger(value, base)
    if result < 0 then
        set result=result + base
    endif
    return result
endfunction

function WOS2BotCodec___WBC_InitAlphabetIndex takes nothing returns nothing
    local integer i= 0
    if WOS2BotCodec___wbc_AlphabetIndexReady then
        return
    endif
    set WOS2BotCodec___wbc_AlphabetIndex=InitHashtable()
    loop
        exitwhen i >= WOS2BotCodec___WBC_RADIX
        call SaveInteger(WOS2BotCodec___wbc_AlphabetIndex, 0, StringHash(SubString(WOS2BotCodec___WBC_PLAIN, i, i + 1)), i + 1)
        call SaveInteger(WOS2BotCodec___wbc_AlphabetIndex, 1, StringHash(SubString(WOS2BotCodec___WBC_CIPHER, i, i + 1)), i + 1)
        set i=i + 1
    endloop
    set WOS2BotCodec___wbc_AlphabetIndexReady=true
endfunction

function WOS2BotCodec___WBC_PlainIndex takes string ch returns integer
    local integer index
    local integer i
    call WOS2BotCodec___WBC_InitAlphabetIndex()
    set index=LoadInteger(WOS2BotCodec___wbc_AlphabetIndex, 0, StringHash(ch)) - 1

    // StringHash in Warcraft III is case-insensitive. The lowercase entry is
    // therefore stored over the uppercase entry. Restore the exact index by
    // comparing the original character; this keeps the lookup constant-time
    // for the normal alphabet and preserves the original wire format.
    if index >= 0 and SubString(WOS2BotCodec___WBC_PLAIN, index, index + 1) == ch then
        return index
    endif
    set index=index - 26
    if index >= 0 and SubString(WOS2BotCodec___WBC_PLAIN, index, index + 1) == ch then
        return index
    endif

    // Collision-safe fallback for an unlikely non-case StringHash collision.
    set i=0
    loop
        exitwhen i >= WOS2BotCodec___WBC_RADIX
        if SubString(WOS2BotCodec___WBC_PLAIN, i, i + 1) == ch then
            return i
        endif
        set i=i + 1
    endloop
    return - 1
endfunction

function WOS2BotCodec___WBC_CipherIndex takes string ch returns integer
    local integer index
    local integer i
    call WOS2BotCodec___WBC_InitAlphabetIndex()
    set index=LoadInteger(WOS2BotCodec___wbc_AlphabetIndex, 1, StringHash(ch)) - 1
    if index >= 0 and SubString(WOS2BotCodec___WBC_CIPHER, index, index + 1) == ch then
        return index
    endif
    set index=index - 26
    if index >= 0 and SubString(WOS2BotCodec___WBC_CIPHER, index, index + 1) == ch then
        return index
    endif
    set i=0
    loop
        exitwhen i >= WOS2BotCodec___WBC_RADIX
        if SubString(WOS2BotCodec___WBC_CIPHER, i, i + 1) == ch then
            return i
        endif
        set i=i + 1
    endloop
    return - 1
endfunction

function WOS2BotCodec___WBC_Base36Digit takes integer value returns string
    return SubString(WOS2BotCodec___WBC_BASE36, value, value + 1)
endfunction

function WOS2BotCodec___WBC_Base36Fixed4 takes integer value returns string
    local integer divisor= 46656
    local integer digit
    local string result= ""
    set value=WOS2BotCodec___WBC_PosMod(value , 1679616)
    loop
        exitwhen divisor <= 0
        set digit=value / divisor
        set result=result + WOS2BotCodec___WBC_Base36Digit(digit)
        set value=ModuloInteger(value, divisor)
        set divisor=divisor / 36
    endloop
    return result
endfunction

function WOS2BotCodec___WBC_MacFeed takes integer symbolValue returns nothing
    set WOS2BotCodec___wbc_MacA=WOS2BotCodec___WBC_PosMod(WOS2BotCodec___wbc_MacA * 131 + symbolValue * 17 + ModuloInteger(WOS2BotCodec___wbc_MacB, 997) + WOS2BotCodec___wbc_KeyC , WOS2BotCodec___WBC_MOD1)
    set WOS2BotCodec___wbc_MacB=WOS2BotCodec___WBC_PosMod(WOS2BotCodec___wbc_MacB * 137 + symbolValue * 29 + WOS2BotCodec___wbc_MacA + WOS2BotCodec___wbc_KeyD , WOS2BotCodec___WBC_MOD2)
endfunction

function WOS2BotCodec___WBC_ComputeMac takes string cipher,integer seq returns nothing
    local integer i= 0
    local integer length
    local integer symbolValue
    set WOS2BotCodec___wbc_MacA=WOS2BotCodec___WBC_PosMod(WOS2BotCodec___wbc_KeyA + seq * 97 + 1103 , WOS2BotCodec___WBC_MOD1)
    set WOS2BotCodec___wbc_MacB=WOS2BotCodec___WBC_PosMod(WOS2BotCodec___wbc_KeyB + seq * 193 + 2203 , WOS2BotCodec___WBC_MOD2)

    set length=StringLength(WOS2BotCodec___wbc_MatchId)
    loop
        exitwhen i >= length
        set symbolValue=WOS2BotCodec___WBC_PlainIndex(SubString(WOS2BotCodec___wbc_MatchId, i, i + 1)) + 1
        if symbolValue <= 0 then
            set symbolValue=1
        endif
        call WOS2BotCodec___WBC_MacFeed(symbolValue)
        set i=i + 1
    endloop

    // Отдельный код-разделитель не позволяет склеивать контекст и шифротекст.
    call WOS2BotCodec___WBC_MacFeed(127)
    set i=0
    set length=StringLength(cipher)
    loop
        exitwhen i >= length
        set symbolValue=WOS2BotCodec___WBC_CipherIndex(SubString(cipher, i, i + 1)) + 1
        call WOS2BotCodec___WBC_MacFeed(symbolValue)
        set i=i + 1
    endloop
endfunction

function WOS2BotCodec___WBC_UpdateChain takes integer seq returns nothing
    set WOS2BotCodec___wbc_ChainA=WOS2BotCodec___WBC_PosMod(WOS2BotCodec___wbc_ChainA * 149 + WOS2BotCodec___wbc_MacA + seq * 31 + WOS2BotCodec___wbc_KeyA , WOS2BotCodec___WBC_MOD1)
    set WOS2BotCodec___wbc_ChainB=WOS2BotCodec___WBC_PosMod(WOS2BotCodec___wbc_ChainB * 151 + WOS2BotCodec___wbc_MacB + WOS2BotCodec___wbc_ChainA + seq * 47 + WOS2BotCodec___wbc_KeyB , WOS2BotCodec___WBC_MOD2)
endfunction

function WOS2BotCodec___WBC_Encrypt takes string plain,integer seq returns string
    local integer i= 0
    local integer length= StringLength(plain)
    local integer index
    local integer stream= WOS2BotCodec___WBC_PosMod(WOS2BotCodec___wbc_Context + WOS2BotCodec___wbc_KeyB + seq * 389 + 71 , WOS2BotCodec___WBC_MOD1)
    local integer shift
    local integer value
    local string result= ""
    loop
        exitwhen i >= length
        set index=WOS2BotCodec___WBC_PlainIndex(SubString(plain, i, i + 1))
        if index < 0 then
            // Неподдерживаемые символы имени заменяются подчёркиванием.
            set index=WOS2BotCodec___WBC_PlainIndex("_")
        endif
        set stream=WOS2BotCodec___WBC_PosMod(stream * 109 + 1021 + i * 17 + seq * 13 , WOS2BotCodec___WBC_MOD1)
        set shift=WOS2BotCodec___WBC_PosMod(stream + WOS2BotCodec___wbc_KeyD , WOS2BotCodec___WBC_RADIX)
        set value=WOS2BotCodec___WBC_PosMod(index + shift , WOS2BotCodec___WBC_RADIX)
        set result=result + SubString(WOS2BotCodec___WBC_CIPHER, value, value + 1)
        set i=i + 1
    endloop
    return result
endfunction

function WOS2BotCodec_Begin takes string matchId returns nothing
    local integer i= 0
    local integer length= StringLength(matchId)
    local integer symbolValue

    set WOS2BotCodec___wbc_MatchId=matchId
    set WOS2BotCodec___wbc_Seq=0
    set WOS2BotCodec___wbc_KeyA=WOS2BotCodec___WBC_PosMod(WOS2BotCodec___WBC_K0 + WOS2BotCodec___WBC_K2 * 3 - WOS2BotCodec___WBC_K4 + 17041 , WOS2BotCodec___WBC_MOD1)
    set WOS2BotCodec___wbc_KeyB=WOS2BotCodec___WBC_PosMod(WOS2BotCodec___WBC_K1 + WOS2BotCodec___WBC_K3 * 5 + WOS2BotCodec___WBC_K5 + 29011 , WOS2BotCodec___WBC_MOD2)
    set WOS2BotCodec___wbc_KeyC=WOS2BotCodec___WBC_PosMod(WOS2BotCodec___WBC_K4 + WOS2BotCodec___WBC_K0 * 2 - WOS2BotCodec___WBC_K1 + 39019 , WOS2BotCodec___WBC_MOD1)
    set WOS2BotCodec___wbc_KeyD=WOS2BotCodec___WBC_PosMod(WOS2BotCodec___WBC_K5 + WOS2BotCodec___WBC_K2 * 2 - WOS2BotCodec___WBC_K3 + 49009 , WOS2BotCodec___WBC_MOD2)

    set WOS2BotCodec___wbc_Context=WOS2BotCodec___WBC_PosMod(WOS2BotCodec___WBC_K0 + WOS2BotCodec___WBC_K3 + 19081 , WOS2BotCodec___WBC_MOD1)
    loop
        exitwhen i >= length
        set symbolValue=WOS2BotCodec___WBC_PlainIndex(SubString(matchId, i, i + 1)) + 1
        if symbolValue <= 0 then
            set symbolValue=1
        endif
        set WOS2BotCodec___wbc_Context=WOS2BotCodec___WBC_PosMod(WOS2BotCodec___wbc_Context * 127 + symbolValue * 31 + WOS2BotCodec___WBC_K2 , WOS2BotCodec___WBC_MOD1)
        set i=i + 1
    endloop

    set WOS2BotCodec___wbc_ChainA=WOS2BotCodec___WBC_PosMod(WOS2BotCodec___wbc_KeyC + WOS2BotCodec___wbc_Context + 3301 , WOS2BotCodec___WBC_MOD1)
    set WOS2BotCodec___wbc_ChainB=WOS2BotCodec___WBC_PosMod(WOS2BotCodec___wbc_KeyD + WOS2BotCodec___wbc_Context + 4409 , WOS2BotCodec___WBC_MOD2)
    set WOS2BotCodec___wbc_Started=true
endfunction

function WOS2BotCodec_Header takes nothing returns string
    if not WOS2BotCodec___wbc_Started then
        return ""
    endif
    return "WOS2E|v=1|id=" + WOS2BotCodec___wbc_MatchId + "|alg=R87M2"
endfunction

function WOS2BotCodec_SealLine takes string plain returns string
    local integer seq
    local string cipher
    local string tag
    if not WOS2BotCodec___wbc_Started then
        return ""
    endif
    set seq=WOS2BotCodec___wbc_Seq
    set cipher=WOS2BotCodec___WBC_Encrypt(plain , seq)
    call WOS2BotCodec___WBC_ComputeMac(cipher , seq)
    set tag=WOS2BotCodec___WBC_Base36Fixed4(WOS2BotCodec___wbc_MacA) + WOS2BotCodec___WBC_Base36Fixed4(WOS2BotCodec___wbc_MacB)
    call WOS2BotCodec___WBC_UpdateChain(seq)
    set WOS2BotCodec___wbc_Seq=WOS2BotCodec___wbc_Seq + 1
    return "D|s=" + I2S(seq) + "|c=" + cipher + "|t=" + tag
endfunction

function WOS2BotCodec_EndLine takes nothing returns string
    local integer finalA
    local integer finalB
    local string result
    if not WOS2BotCodec___wbc_Started then
        return ""
    endif
    set finalA=WOS2BotCodec___WBC_PosMod(WOS2BotCodec___wbc_ChainA * 157 + WOS2BotCodec___wbc_Seq * 53 + WOS2BotCodec___wbc_KeyC , WOS2BotCodec___WBC_MOD1)
    set finalB=WOS2BotCodec___WBC_PosMod(WOS2BotCodec___wbc_ChainB * 163 + finalA + WOS2BotCodec___wbc_Seq * 59 + WOS2BotCodec___wbc_KeyD , WOS2BotCodec___WBC_MOD2)
    set result="Z|n=" + I2S(WOS2BotCodec___wbc_Seq) + "|t=" + WOS2BotCodec___WBC_Base36Fixed4(finalA) + WOS2BotCodec___WBC_Base36Fixed4(finalB)
    set WOS2BotCodec___wbc_Started=false
    return result
endfunction


//library WOS2BotCodec ends
//library AAINIT:

//==============================================================================
// WOS2 LOCAL-ONLY SAVE
//
// Safety model:
// - no save file is read during map initialization or mode selection;
// - the owner's profile may be read on that owner's explicit Career UI open;
// - no BlzSendSyncData and no transfer of saved data between players;
// - only the local owner's cumulative profile is read again at match end;
// - loaded values are never used by gameplay, selection, timers or synchronized UI;
// - the match export is built only from already synchronized current-match state;
// - the old WOS2_v1/WOS2_v3/VIP files are never opened or overwritten.
//==============================================================================
function AAINIT___IsGamePlayerSlot takes integer pid returns boolean
    return pid >= 0 and pid < 10
endfunction
function AAINIT___IsObserverSlot takes integer pid returns boolean
    return pid >= 10 and pid <= 14
endfunction
function AAINIT___IsActivePlayerSlot takes integer pid returns boolean
    return AAINIT___IsGamePlayerSlot(pid) and GetPlayerSlotState(Player(pid)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(pid)) == MAP_CONTROL_USER
endfunction
function AAINIT___IsActiveObserverSlot takes integer pid returns boolean
    return AAINIT___IsObserverSlot(pid) and GetPlayerSlotState(Player(pid)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(pid)) == MAP_CONTROL_USER
endfunction

//==============================================================================
// LOCAL OWNER CAREER: OVERALL, HEROES AND ITEMS
//==============================================================================

function SaveSystem_PositiveModulo takes integer value,integer base returns integer
    local integer result= ModuloInteger(value, base)
    if result < 0 then
        set result=result + base
    endif
    return result
endfunction

function SaveSystem_EnsureIdentity takes integer pid returns nothing
    local string stableName
    if pid < 0 or pid >= 16 then
        return
    endif
    if ss_Identity[pid] == "" then
        set stableName=GetPlayerName(Player(pid))
        if stableName == "" then
            set stableName="Player" + I2S(pid)
        endif
        set ss_Identity[pid]=stableName
    endif
    if ss_IdentityKeyA[pid] == 0 then
        set ss_IdentityKeyA[pid]=StringHash("WOS2:LOCAL4:A:" + ss_Identity[pid])
        if ss_IdentityKeyA[pid] == 0 then
            set ss_IdentityKeyA[pid]=19001 + pid
        endif
    endif
    if ss_IdentityKeyB[pid] == 0 then
        set ss_IdentityKeyB[pid]=StringHash("WOS2:LOCAL4:B:" + ss_Identity[pid])
        if ss_IdentityKeyB[pid] == 0 then
            set ss_IdentityKeyB[pid]=29001 + pid
        endif
    endif
endfunction

function SaveSystem_LocalChecksum takes integer pid,integer games,integer wins returns integer
    return SaveSystem_PositiveModulo(games * 37 + wins * 61 + ss_IdentityKeyA[pid] * 3 + ss_IdentityKeyB[pid] * 5 + 17041 , 999983)
endfunction

function SaveSystem_LocalFilePath takes integer pid returns string
    call SaveSystem_EnsureIdentity(pid)
    return SAVE_FOLDER + SAVE_LOCAL_PREFIX + I2S(ss_IdentityKeyA[pid]) + "_" + I2S(ss_IdentityKeyB[pid]) + ".txt"
endfunction

function SaveSystem_LocalHeroChecksum takes integer pid,integer heroId,integer games,integer wins,integer roundWins,integer roundLosses,integer combatGames,integer kills,integer deaths,integer bestKills,integer bestDeaths,integer bestKd100 returns integer
    return SaveSystem_PositiveModulo(heroId * 7 + games * 11 + wins * 13 + roundWins * 17 + roundLosses * 19 + combatGames * 23 + kills * 29 + deaths * 31 + bestKills * 37 + bestDeaths * 41 + bestKd100 * 43 + ss_IdentityKeyA[pid] + ss_IdentityKeyB[pid] + 27011 , 999983)
endfunction

function SaveSystem_LocalItemChecksum takes integer pid,integer heroId,integer itemId,integer finalGames,integer finalWins,integer usedGames,integer usedWins returns integer
    return SaveSystem_PositiveModulo(heroId * 7 + itemId * 11 + finalGames * 17 + finalWins * 19 + usedGames * 23 + usedWins * 29 + ss_IdentityKeyA[pid] + ss_IdentityKeyB[pid] + 37003 , 999983)
endfunction

function SaveSystem_LocalBuildChecksum takes integer pid,integer heroId,integer slot,integer itemId returns integer
    return SaveSystem_PositiveModulo(heroId * 13 + slot * 31 + itemId * 17 + ss_IdentityKeyA[pid] + ss_IdentityKeyB[pid] + 47017 , 999983)
endfunction

function SaveSystem_LocalFindHero takes integer heroId returns integer
    local integer record= 0
    loop
        exitwhen record >= ss_LocalHeroCount
        if ss_LocalHeroId[record] == heroId then
            return record
        endif
        set record=record + 1
    endloop
    return - 1
endfunction

function SaveSystem_LocalEnsureHero takes integer heroId returns integer
    local integer record= SaveSystem_LocalFindHero(heroId)
    local integer slot= 0
    if record >= 0 then
        return record
    endif
    if heroId == 0 or ss_LocalHeroCount >= SAVE_LOCAL_MAX_HEROES then
        return - 1
    endif
    set record=ss_LocalHeroCount
    set ss_LocalHeroCount=ss_LocalHeroCount + 1
    set ss_LocalHeroId[record]=heroId
    set ss_LocalHeroGames[record]=0
    set ss_LocalHeroWins[record]=0
    set ss_LocalHeroRoundWins[record]=0
    set ss_LocalHeroRoundLosses[record]=0
    set ss_LocalHeroCombatGames[record]=0
    set ss_LocalHeroTotalKills[record]=0
    set ss_LocalHeroTotalDeaths[record]=0
    set ss_LocalHeroBestKills[record]=0
    set ss_LocalHeroBestDeaths[record]=0
    set ss_LocalHeroBestKd100[record]=0
    loop
        exitwhen slot >= 6
        set ss_LocalLastBuild[record * 6 + slot]=0
        set slot=slot + 1
    endloop
    return record
endfunction

function SaveSystem_LocalFindItem takes integer heroId,integer itemId returns integer
    local integer record= 0
    loop
        exitwhen record >= ss_LocalItemCount
        if ss_LocalItemHeroId[record] == heroId and ss_LocalItemId[record] == itemId then
            return record
        endif
        set record=record + 1
    endloop
    return - 1
endfunction

function SaveSystem_LocalEnsureItem takes integer heroId,integer itemId returns integer
    local integer record= SaveSystem_LocalFindItem(heroId , itemId)
    if record >= 0 then
        return record
    endif
    if heroId == 0 or itemId == 0 or ss_LocalItemCount >= SAVE_LOCAL_MAX_ITEMS then
        return - 1
    endif
    set record=ss_LocalItemCount
    set ss_LocalItemCount=ss_LocalItemCount + 1
    set ss_LocalItemHeroId[record]=heroId
    set ss_LocalItemId[record]=itemId
    set ss_LocalItemFinalGames[record]=0
    set ss_LocalItemFinalWins[record]=0
    set ss_LocalItemUsedGames[record]=0
    set ss_LocalItemUsedWins[record]=0
    return record
endfunction

// Declared before the profile updater because classic pjass does not allow a
// call to a function whose declaration appears later in the script.
function SaveSystem_LocalIsIgnoredItem takes integer itemId returns boolean
    local integer index= 0
    loop
        exitwhen index >= ss_IgnoredItemCount
        if ss_IgnoredItem[index] == itemId then
            return true
        endif
        set index=index + 1
    endloop
    return false
endfunction

function SaveSystem_LocalResetProfile takes nothing returns nothing
    set ss_LocalGames=0
    set ss_LocalWins=0
    set ss_LocalHeroCount=0
    set ss_LocalItemCount=0
    set ss_LocalLoadedRecordCount=0
    set ss_LocalRejectedRecordCount=0
endfunction

// Header loader. The second checksum is accepted only to import the already
// produced WOS2_local4_0_0 file, whose identity keys were accidentally zero.
function SaveSystem_LocalCareerApply takes integer games,integer wins,integer checksum returns nothing
    local integer pid= GetPlayerId(GetLocalPlayer())
    local integer zeroKeyChecksum= SaveSystem_PositiveModulo(games * 37 + wins * 61 + 17041 , 999983)
    if games < 0 or wins < 0 or wins > games or ( checksum != SaveSystem_LocalChecksum(pid , games , wins) and checksum != zeroKeyChecksum ) then
        set ss_LocalRejectedRecordCount=ss_LocalRejectedRecordCount + 1
        return
    endif
    set ss_LocalOwnerPid=pid
    set ss_LocalGames=games
    set ss_LocalWins=wins
    set ss_LocalLoadedRecordCount=ss_LocalLoadedRecordCount + 1
endfunction

function SaveSystem_LocalCareerHeroApply takes integer heroId,integer games,integer wins,integer roundWins,integer roundLosses,integer combatGames,integer kills,integer deaths,integer bestKills,integer bestDeaths,integer bestKd100,integer checksum returns nothing
    local integer pid= GetPlayerId(GetLocalPlayer())
    local integer record
    if heroId == 0 or games < 0 or wins < 0 or wins > games or roundWins < 0 or roundLosses < 0 or combatGames < 0 or kills < 0 or deaths < 0 or bestKills < 0 or bestDeaths < 0 or bestKd100 < 0 then
        set ss_LocalRejectedRecordCount=ss_LocalRejectedRecordCount + 1
        return
    endif
    if checksum != SaveSystem_LocalHeroChecksum(pid , heroId , games , wins , roundWins , roundLosses , combatGames , kills , deaths , bestKills , bestDeaths , bestKd100) then
        set ss_LocalRejectedRecordCount=ss_LocalRejectedRecordCount + 1
        return
    endif
    set record=SaveSystem_LocalEnsureHero(heroId)
    if record < 0 then
        set ss_LocalRejectedRecordCount=ss_LocalRejectedRecordCount + 1
        return
    endif
    set ss_LocalHeroGames[record]=games
    set ss_LocalHeroWins[record]=wins
    set ss_LocalHeroRoundWins[record]=roundWins
    set ss_LocalHeroRoundLosses[record]=roundLosses
    set ss_LocalHeroCombatGames[record]=combatGames
    set ss_LocalHeroTotalKills[record]=kills
    set ss_LocalHeroTotalDeaths[record]=deaths
    set ss_LocalHeroBestKills[record]=bestKills
    set ss_LocalHeroBestDeaths[record]=bestDeaths
    set ss_LocalHeroBestKd100[record]=bestKd100
    set ss_LocalLoadedRecordCount=ss_LocalLoadedRecordCount + 1
endfunction

function SaveSystem_LocalCareerItemApply takes integer heroId,integer itemId,integer finalGames,integer finalWins,integer usedGames,integer usedWins,integer checksum returns nothing
    local integer pid= GetPlayerId(GetLocalPlayer())
    local integer record
    if heroId == 0 or itemId == 0 or finalGames < 0 or finalWins < 0 or finalWins > finalGames or usedGames < 0 or usedWins < 0 or usedWins > usedGames then
        set ss_LocalRejectedRecordCount=ss_LocalRejectedRecordCount + 1
        return
    endif
    if checksum != SaveSystem_LocalItemChecksum(pid , heroId , itemId , finalGames , finalWins , usedGames , usedWins) then
        set ss_LocalRejectedRecordCount=ss_LocalRejectedRecordCount + 1
        return
    endif
    set record=SaveSystem_LocalEnsureItem(heroId , itemId)
    if record < 0 then
        set ss_LocalRejectedRecordCount=ss_LocalRejectedRecordCount + 1
        return
    endif
    set ss_LocalItemFinalGames[record]=finalGames
    set ss_LocalItemFinalWins[record]=finalWins
    set ss_LocalItemUsedGames[record]=usedGames
    set ss_LocalItemUsedWins[record]=usedWins
    set ss_LocalLoadedRecordCount=ss_LocalLoadedRecordCount + 1
endfunction

function SaveSystem_LocalCareerBuildApply takes integer heroId,integer slot,integer itemId,integer checksum returns nothing
    local integer pid= GetPlayerId(GetLocalPlayer())
    local integer record
    if heroId == 0 or slot < 0 or slot >= 6 or itemId == 0 or checksum != SaveSystem_LocalBuildChecksum(pid , heroId , slot , itemId) then
        set ss_LocalRejectedRecordCount=ss_LocalRejectedRecordCount + 1
        return
    endif
    set record=SaveSystem_LocalEnsureHero(heroId)
    if record < 0 then
        set ss_LocalRejectedRecordCount=ss_LocalRejectedRecordCount + 1
        return
    endif
    set ss_LocalLastBuild[record * 6 + slot]=itemId
    set ss_LocalLoadedRecordCount=ss_LocalLoadedRecordCount + 1
endfunction

function SaveSystem_LocalPayloadNextInt takes string payload returns integer
    local integer start= ss_LocalPayloadPos
    local integer length= StringLength(payload)
    loop
        exitwhen ss_LocalPayloadPos >= length or SubString(payload, ss_LocalPayloadPos, ss_LocalPayloadPos + 1) == ","
        set ss_LocalPayloadPos=ss_LocalPayloadPos + 1
    endloop
    set ss_LocalPayloadPos=ss_LocalPayloadPos + 1
    return S2I(SubString(payload, start, ss_LocalPayloadPos - 1))
endfunction

// Parse one record only after Preloader has completely returned. The generated
// file itself contains tooltip natives only and never invokes map code.
function SaveSystem_LocalCareerApplyPayload takes string payload returns nothing
    local string recordType
    local integer v0
    local integer v1
    local integer v2
    local integer v3
    local integer v4
    local integer v5
    local integer v6
    local integer v7
    local integer v8
    local integer v9
    local integer v10
    local integer v11
    if StringLength(payload) < 3 or StringLength(payload) > 240 or SubString(payload, 1, 2) != "," then
        set ss_LocalRejectedRecordCount=ss_LocalRejectedRecordCount + 1
        return
    endif
    set recordType=SubString(payload, 0, 1)
    set ss_LocalPayloadPos=2
    if recordType == "A" then
        set v0=SaveSystem_LocalPayloadNextInt(payload)
        set v1=SaveSystem_LocalPayloadNextInt(payload)
        set v2=SaveSystem_LocalPayloadNextInt(payload)
        call SaveSystem_LocalCareerApply(v0 , v1 , v2)
    elseif recordType == "H" then
        set v0=SaveSystem_LocalPayloadNextInt(payload)
        set v1=SaveSystem_LocalPayloadNextInt(payload)
        set v2=SaveSystem_LocalPayloadNextInt(payload)
        set v3=SaveSystem_LocalPayloadNextInt(payload)
        set v4=SaveSystem_LocalPayloadNextInt(payload)
        set v5=SaveSystem_LocalPayloadNextInt(payload)
        set v6=SaveSystem_LocalPayloadNextInt(payload)
        set v7=SaveSystem_LocalPayloadNextInt(payload)
        set v8=SaveSystem_LocalPayloadNextInt(payload)
        set v9=SaveSystem_LocalPayloadNextInt(payload)
        set v10=SaveSystem_LocalPayloadNextInt(payload)
        set v11=SaveSystem_LocalPayloadNextInt(payload)
        call SaveSystem_LocalCareerHeroApply(v0 , v1 , v2 , v3 , v4 , v5 , v6 , v7 , v8 , v9 , v10 , v11)
    elseif recordType == "B" then
        set v0=SaveSystem_LocalPayloadNextInt(payload)
        set v1=SaveSystem_LocalPayloadNextInt(payload)
        set v2=SaveSystem_LocalPayloadNextInt(payload)
        set v3=SaveSystem_LocalPayloadNextInt(payload)
        call SaveSystem_LocalCareerBuildApply(v0 , v1 , v2 , v3)
    elseif recordType == "I" then
        set v0=SaveSystem_LocalPayloadNextInt(payload)
        set v1=SaveSystem_LocalPayloadNextInt(payload)
        set v2=SaveSystem_LocalPayloadNextInt(payload)
        set v3=SaveSystem_LocalPayloadNextInt(payload)
        set v4=SaveSystem_LocalPayloadNextInt(payload)
        set v5=SaveSystem_LocalPayloadNextInt(payload)
        set v6=SaveSystem_LocalPayloadNextInt(payload)
        call SaveSystem_LocalCareerItemApply(v0 , v1 , v2 , v3 , v4 , v5 , v6)
    else
        set ss_LocalRejectedRecordCount=ss_LocalRejectedRecordCount + 1
    endif
endfunction

function SaveSystem_LocalCareerParseBuffer takes string buffer returns nothing
    local integer length= StringLength(buffer)
    local integer start= StringLength(SAVE_LOCAL_FORMAT)
    local integer index= start
    local string payload
    if length < start or SubString(buffer, 0, start) != SAVE_LOCAL_FORMAT then
        return
    endif
    loop
        exitwhen index >= length
        if SubString(buffer, index, index + 1) == "|" then
            set payload=SubString(buffer, start, index)
            if payload != "" then
                call SaveSystem_LocalCareerApplyPayload(payload)
            endif
            set start=index + 1
        endif
        set index=index + 1
    endloop
    if start < length then
        set payload=SubString(buffer, start, length)
        if payload != "" then
            call SaveSystem_LocalCareerApplyPayload(payload)
        endif
    endif
endfunction

function SaveSystem_WriteLocalHeader takes nothing returns nothing
    call Preload("\")\ncall BlzSetAbilityTooltip(" + I2S(SAVE_ABILITY) + ",\"" + SAVE_LOCAL_FORMAT + "\",0)\n//")
endfunction

function SaveSystem_WriteLocalPayload takes string payload returns nothing
    call Preload("\")\ncall BlzSetAbilityTooltip(" + I2S(SAVE_ABILITY) + ",BlzGetAbilityTooltip(" + I2S(SAVE_ABILITY) + ",0)+\"" + payload + "|\",0)\n//")
endfunction

function SaveSystem_LoadOwnCareerAtFinish takes nothing returns nothing
    local integer pid= GetPlayerId(GetLocalPlayer())
    local string originalTooltip= BlzGetAbilityTooltip(SAVE_ABILITY, 0)
    local string buffer
    if not AAINIT___IsGamePlayerSlot(pid) then
        return
    endif
    set ss_LocalOwnerPid=pid
    call SaveSystem_EnsureIdentity(pid)
    call SaveSystem_LocalResetProfile()
    call BlzSetAbilityTooltip(SAVE_ABILITY, SAVE_LOCAL_EMPTY, 0)
    call Preloader(SaveSystem_LocalFilePath(pid))
    set buffer=BlzGetAbilityTooltip(SAVE_ABILITY, 0)
    if StringLength(buffer) < StringLength(SAVE_LOCAL_FORMAT) or SubString(buffer, 0, StringLength(SAVE_LOCAL_FORMAT)) != SAVE_LOCAL_FORMAT then
        // One-time recovery of the file shown as WOS2_local4_0_0.txt.
        call BlzSetAbilityTooltip(SAVE_ABILITY, SAVE_LOCAL_EMPTY, 0)
        call Preloader(SAVE_FOLDER + SAVE_LOCAL_PREFIX + "0_0.txt")
        set buffer=BlzGetAbilityTooltip(SAVE_ABILITY, 0)
    endif
    // Restore the shared object-data field before parsing any local payload.
    call BlzSetAbilityTooltip(SAVE_ABILITY, originalTooltip, 0)
    call SaveSystem_LocalCareerParseBuffer(buffer)
    set ss_LocalLoadFinished=true
endfunction

function SaveSystem_LocalApplyPendingMatch takes nothing returns nothing
    local integer heroRecord
    local integer itemRecord
    local integer slot= 0
    local integer previous
    local integer itemId
    local integer kd100
    local boolean duplicate
    set ss_LocalGames=ss_LocalGames + 1
    if ss_LocalPendingWin then
        set ss_LocalWins=ss_LocalWins + 1
    endif
    if ss_LocalMatchHeroId == 0 then
        return
    endif
    set heroRecord=SaveSystem_LocalEnsureHero(ss_LocalMatchHeroId)
    if heroRecord < 0 then
        return
    endif
    set ss_LocalHeroGames[heroRecord]=ss_LocalHeroGames[heroRecord] + 1
    if ss_LocalPendingWin then
        set ss_LocalHeroWins[heroRecord]=ss_LocalHeroWins[heroRecord] + 1
    endif
    set ss_LocalHeroRoundWins[heroRecord]=ss_LocalHeroRoundWins[heroRecord] + ss_LocalMatchRoundWins
    set ss_LocalHeroRoundLosses[heroRecord]=ss_LocalHeroRoundLosses[heroRecord] + ss_LocalMatchRoundLosses
    if ss_LocalMatchKills >= 0 and ss_LocalMatchDeaths >= 0 then
        if ss_LocalHeroCombatGames[heroRecord] == 0 or ss_LocalMatchDeaths < ss_LocalHeroBestDeaths[heroRecord] then
            set ss_LocalHeroBestDeaths[heroRecord]=ss_LocalMatchDeaths
        endif
        set ss_LocalHeroCombatGames[heroRecord]=ss_LocalHeroCombatGames[heroRecord] + 1
        set ss_LocalHeroTotalKills[heroRecord]=ss_LocalHeroTotalKills[heroRecord] + ss_LocalMatchKills
        set ss_LocalHeroTotalDeaths[heroRecord]=ss_LocalHeroTotalDeaths[heroRecord] + ss_LocalMatchDeaths
        if ss_LocalMatchKills > ss_LocalHeroBestKills[heroRecord] then
            set ss_LocalHeroBestKills[heroRecord]=ss_LocalMatchKills
        endif
        if ss_LocalMatchDeaths <= 0 then
            set kd100=ss_LocalMatchKills * 100
        else
            set kd100=ss_LocalMatchKills * 100 / ss_LocalMatchDeaths
        endif
        if kd100 > ss_LocalHeroBestKd100[heroRecord] then
            set ss_LocalHeroBestKd100[heroRecord]=kd100
        endif
    endif
    loop
        exitwhen slot >= 6
        set itemId=ss_LocalMatchBuild[slot]
        set ss_LocalLastBuild[heroRecord * 6 + slot]=itemId
        if itemId != 0 and not SaveSystem_LocalIsIgnoredItem(itemId) then
            set duplicate=false
            set previous=0
            loop
                exitwhen previous >= slot
                if ss_LocalMatchBuild[previous] == itemId then
                    set duplicate=true
                    set previous=slot
                else
                    set previous=previous + 1
                endif
            endloop
            if not duplicate then
                set itemRecord=SaveSystem_LocalEnsureItem(ss_LocalMatchHeroId , itemId)
                if itemRecord >= 0 then
                    set ss_LocalItemFinalGames[itemRecord]=ss_LocalItemFinalGames[itemRecord] + 1
                    set ss_LocalItemUsedGames[itemRecord]=ss_LocalItemUsedGames[itemRecord] + 1
                    if ss_LocalPendingWin then
                        set ss_LocalItemFinalWins[itemRecord]=ss_LocalItemFinalWins[itemRecord] + 1
                        set ss_LocalItemUsedWins[itemRecord]=ss_LocalItemUsedWins[itemRecord] + 1
                    endif
                endif
            endif
        endif
        set slot=slot + 1
    endloop
endfunction

function SaveSystem_WriteOwnCareerAtFinish takes nothing returns nothing
    local integer pid= GetPlayerId(GetLocalPlayer())
    local integer checksum
    local integer record= 0
    local integer slot
    if not AAINIT___IsGamePlayerSlot(pid) or not ss_LocalResultPending then
        return
    endif

    // Reading happens here, after gameplay is already over, never at startup.
    call SaveSystem_LoadOwnCareerAtFinish()
    call SaveSystem_LocalApplyPendingMatch()
    set checksum=SaveSystem_LocalChecksum(pid , ss_LocalGames , ss_LocalWins)

    call PreloadGenClear()
    call PreloadGenStart()
    call Preload("\")\ncall BlzSetAbilityTooltip(" + I2S(SAVE_ABILITY) + ",\"" + SAVE_LOCAL_FORMAT + "\",0)\n//") // INLINED!!
    call Preload("\")\ncall BlzSetAbilityTooltip(" + I2S(SAVE_ABILITY) + ",BlzGetAbilityTooltip(" + I2S(SAVE_ABILITY) + ",0)+\"" + ("A," + I2S(ss_LocalGames) + "," + I2S(ss_LocalWins) + "," + I2S(checksum)) + "|\",0)\n//") // INLINED!!
    set ss_LocalSavedRecordCount=1
    loop
        exitwhen record >= ss_LocalHeroCount
        set checksum=SaveSystem_LocalHeroChecksum(pid , ss_LocalHeroId[record] , ss_LocalHeroGames[record] , ss_LocalHeroWins[record] , ss_LocalHeroRoundWins[record] , ss_LocalHeroRoundLosses[record] , ss_LocalHeroCombatGames[record] , ss_LocalHeroTotalKills[record] , ss_LocalHeroTotalDeaths[record] , ss_LocalHeroBestKills[record] , ss_LocalHeroBestDeaths[record] , ss_LocalHeroBestKd100[record])
        call Preload("\")\ncall BlzSetAbilityTooltip(" + I2S(SAVE_ABILITY) + ",BlzGetAbilityTooltip(" + I2S(SAVE_ABILITY) + ",0)+\"" + ("H," + I2S(ss_LocalHeroId[record]) + "," + I2S(ss_LocalHeroGames[record]) + "," + I2S(ss_LocalHeroWins[record]) + "," + I2S(ss_LocalHeroRoundWins[record]) + "," + I2S(ss_LocalHeroRoundLosses[record]) + "," + I2S(ss_LocalHeroCombatGames[record]) + "," + I2S(ss_LocalHeroTotalKills[record]) + "," + I2S(ss_LocalHeroTotalDeaths[record]) + "," + I2S(ss_LocalHeroBestKills[record]) + "," + I2S(ss_LocalHeroBestDeaths[record]) + "," + I2S(ss_LocalHeroBestKd100[record]) + "," + I2S(checksum)) + "|\",0)\n//") // INLINED!!
        set ss_LocalSavedRecordCount=ss_LocalSavedRecordCount + 1
        set slot=0
        loop
            exitwhen slot >= 6
            if ss_LocalLastBuild[record * 6 + slot] != 0 then
                set checksum=SaveSystem_LocalBuildChecksum(pid , ss_LocalHeroId[record] , slot , ss_LocalLastBuild[record * 6 + slot])
                call Preload("\")\ncall BlzSetAbilityTooltip(" + I2S(SAVE_ABILITY) + ",BlzGetAbilityTooltip(" + I2S(SAVE_ABILITY) + ",0)+\"" + ("B," + I2S(ss_LocalHeroId[record]) + "," + I2S(slot) + "," + I2S(ss_LocalLastBuild[record * 6 + slot]) + "," + I2S(checksum)) + "|\",0)\n//") // INLINED!!
                set ss_LocalSavedRecordCount=ss_LocalSavedRecordCount + 1
            endif
            set slot=slot + 1
        endloop
        set record=record + 1
    endloop
    set record=0
    loop
        exitwhen record >= ss_LocalItemCount
        set checksum=SaveSystem_LocalItemChecksum(pid , ss_LocalItemHeroId[record] , ss_LocalItemId[record] , ss_LocalItemFinalGames[record] , ss_LocalItemFinalWins[record] , ss_LocalItemUsedGames[record] , ss_LocalItemUsedWins[record])
        call Preload("\")\ncall BlzSetAbilityTooltip(" + I2S(SAVE_ABILITY) + ",BlzGetAbilityTooltip(" + I2S(SAVE_ABILITY) + ",0)+\"" + ("I," + I2S(ss_LocalItemHeroId[record]) + "," + I2S(ss_LocalItemId[record]) + "," + I2S(ss_LocalItemFinalGames[record]) + "," + I2S(ss_LocalItemFinalWins[record]) + "," + I2S(ss_LocalItemUsedGames[record]) + "," + I2S(ss_LocalItemUsedWins[record]) + "," + I2S(checksum)) + "|\",0)\n//") // INLINED!!
        set ss_LocalSavedRecordCount=ss_LocalSavedRecordCount + 1
        set record=record + 1
    endloop
    call PreloadGenEnd(SaveSystem_LocalFilePath(pid))
    call PreloadGenClear()

    set ss_LocalSaveWritten=true
    set ss_LocalResultPending=false
    set ss_LocalMatchHeroId=0
    set ss_LocalMatchKills=0
    set ss_LocalMatchDeaths=0
    set ss_LocalMatchRoundWins=0
    set ss_LocalMatchRoundLosses=0
endfunction

// Old public entry points remain as no-ops for map compatibility. They must not
// be used to load a profile during initialization.
function SaveSystem_FilePath takes integer pid returns string
    return SaveSystem_LocalFilePath(pid)
endfunction

function SaveSystem_LegacyFilePath takes integer pid returns string
    return ""
endfunction

function SaveSystem_LoadLocalPlayer takes integer pid returns nothing
    if not AAINIT___IsGamePlayerSlot(pid) or GetLocalPlayer() != Player(pid) or ss_LocalLoadFinished then
        return
    endif
    call SaveSystem_LoadOwnCareerAtFinish()
endfunction

function SaveSystem_InitLoad takes nothing returns nothing
endfunction

function SaveSystem_WriteFile takes integer pid returns nothing
endfunction

function SaveSystem_SaveLocalCacheNow takes nothing returns nothing
endfunction

function SaveSystem_SavePlayer takes player whichPlayer returns nothing
endfunction

//==============================================================================
// CURRENT-MATCH EXPORT FOR THE BOT / LOCAL ARCHIVE
//==============================================================================

function SaveSystem_IsIgnoredItem takes integer itemId returns boolean
    local integer i= 0
    loop
        exitwhen i >= ss_IgnoredItemCount
        if ss_IgnoredItem[i] == itemId then
            return true
        endif
        set i=i + 1
    endloop
    return false
endfunction

function SaveSystem_RegisterIgnoredItem takes integer itemId returns nothing
    if itemId != 0 and not SaveSystem_IsIgnoredItem(itemId) and ss_IgnoredItemCount < SAVE_MAX_IGNORED_ITEMS then
        set ss_IgnoredItem[ss_IgnoredItemCount]=itemId
        set ss_IgnoredItemCount=ss_IgnoredItemCount + 1
    endif
endfunction

function SaveSystem_IsMatchPid takes integer pid returns boolean
    return pid >= 0 and pid < SAVE_BOT_MAX_PLAYERS
endfunction

function SaveSystem_MatchEnsureParticipant takes integer pid,string stableName returns nothing
    if not SaveSystem_IsMatchPid(pid) then
        return
    endif
    if not ss_MatchParticipant[pid] then
        set ss_MatchParticipant[pid]=true
        set ss_MatchLeft[pid]=false
        set ss_MatchLobbySlot[pid]=pid
        set ss_MatchVisualSlot[pid]=pid
        set ss_MatchRoundsPlayed[pid]=0
        set ss_MatchRoundWins[pid]=0
        set ss_MatchRoundLosses[pid]=0
        if pid < 5 then
            set ss_MatchTeam[pid]=1
            set ss_MatchTeamSlot[pid]=pid + 1
        else
            set ss_MatchTeam[pid]=2
            set ss_MatchTeamSlot[pid]=pid - 4
        endif
    endif
    if stableName == "" then
        set stableName=ss_Identity[pid]
    endif
    if stableName == "" then
        set stableName=GetPlayerName(Player(pid))
    endif
    if stableName == "" then
        set stableName="Player" + I2S(pid)
    endif
    set ss_MatchStableName[pid]=stableName
endfunction

// Capture the authoritative human lobby roster before any local career work or
// hero-frame interaction. This makes the bot report identical on every client.
function SaveSystem_RegisterLobbyParticipants takes nothing returns nothing
    local integer pid= 0
    loop
        exitwhen pid >= SAVE_BOT_MAX_PLAYERS
        if GetPlayerSlotState(Player(pid)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(pid)) == MAP_CONTROL_USER then
            call SaveSystem_MatchEnsureParticipant(pid , ss_Identity[pid])
        endif
        set pid=pid + 1
    endloop
endfunction

function SaveSystem_MatchSnapshotHero takes integer pid,unit whichHero returns nothing
    local integer slot= 0
    local item whichItem
    local integer itemId
    local integer heroId
    if not SaveSystem_IsMatchPid(pid) or whichHero == null then
        return
    endif
    set heroId=GetUnitTypeId(whichHero)
    // If another leave trigger already removed the unit, keep the last valid
    // hero/item snapshot instead of replacing it with six zeroes.
    if heroId == 0 then
        return
    endif
    set ss_MatchHero[pid]=whichHero
    set ss_MatchHeroId[pid]=heroId
    loop
        exitwhen slot >= 6
        set itemId=0
        set whichItem=UnitItemInSlot(whichHero, slot)
        if whichItem != null then
            set itemId=GetItemTypeId(whichItem)
            if SaveSystem_IsIgnoredItem(itemId) then
                set itemId=0
            endif
        endif
        set ss_MatchItemId[pid * 6 + slot]=itemId
        set whichItem=null
        set slot=slot + 1
    endloop
endfunction

// Called when Captain/player-pick mode has produced a new team layout. Clear
// the lobby defaults first so a player who left before being drafted remains
// explicitly unassigned instead of being written into the old lobby team.
function SaveSystem_BeginReorganizedTeams takes nothing returns nothing
    local integer pid= 0
    set ss_MatchTeamsReorganized=true
    loop
        exitwhen pid >= SAVE_BOT_MAX_PLAYERS
        if ss_MatchParticipant[pid] then
            set ss_MatchTeam[pid]=0
            set ss_MatchTeamSlot[pid]=0
            set ss_MatchVisualSlot[pid]=- 1
        endif
        set pid=pid + 1
    endloop
endfunction

function SaveSystem_SetMatchTeamSlot takes integer pid,integer team,integer teamSlot,integer visualSlot returns nothing
    if not SaveSystem_IsMatchPid(pid) then
        return
    endif
    call SaveSystem_MatchEnsureParticipant(pid , ss_Identity[pid])
    if team != 1 and team != 2 then
        set team=0
    endif
    if teamSlot < 0 then
        set teamSlot=0
    endif
    if visualSlot < - 1 or visualSlot >= SAVE_BOT_MAX_PLAYERS then
        set visualSlot=- 1
    endif
    set ss_MatchTeam[pid]=team
    set ss_MatchTeamSlot[pid]=teamSlot
    set ss_MatchVisualSlot[pid]=visualSlot
endfunction

function SaveSystem_MarkMatchPlayerLeft takes integer pid returns nothing
    if not SaveSystem_IsMatchPid(pid) or not ss_MatchParticipant[pid] then
        return
    endif
    call SaveSystem_MatchSnapshotHero(pid , ss_MatchHero[pid])
    set ss_MatchLeft[pid]=true
endfunction

function SaveSystem_OnMatchPlayerLeave takes nothing returns nothing
    call SaveSystem_MarkMatchPlayerLeft(GetPlayerId(GetTriggerPlayer()))
endfunction

function SaveSystem_IsMatchParticipant takes integer pid returns boolean
    if not SaveSystem_IsMatchPid(pid) then
        return false
    endif
    return ss_MatchParticipant[pid]
endfunction

function SaveSystem_DidMatchPlayerLeave takes integer pid returns boolean
    if not SaveSystem_IsMatchPid(pid) then
        return false
    endif
    return ss_MatchLeft[pid]
endfunction

function SaveSystem_GetMatchTeam takes integer pid returns integer
    if not SaveSystem_IsMatchPid(pid) then
        return 0
    endif
    return ss_MatchTeam[pid]
endfunction

function SaveSystem_GetMatchTeamSlot takes integer pid returns integer
    if not SaveSystem_IsMatchPid(pid) then
        return 0
    endif
    return ss_MatchTeamSlot[pid]
endfunction

function SaveSystem_GetMatchVisualSlot takes integer pid returns integer
    if not SaveSystem_IsMatchPid(pid) then
        return - 1
    endif
    return ss_MatchVisualSlot[pid]
endfunction

function SaveSystem_GetMatchRoundsPlayed takes integer pid returns integer
    if not SaveSystem_IsMatchPid(pid) then
        return 0
    endif
    return ss_MatchRoundsPlayed[pid]
endfunction

function SaveSystem_GetMatchHero takes integer pid returns unit
    if not SaveSystem_IsMatchPid(pid) then
        return null
    endif
    return ss_MatchHero[pid]
endfunction

function SaveSystem_GetMatchStableName takes integer pid returns string
    if not SaveSystem_IsMatchPid(pid) then
        return ""
    endif
    return ss_MatchStableName[pid]
endfunction

function SaveSystem_GetMatchHeroId takes integer pid returns integer
    if not SaveSystem_IsMatchPid(pid) then
        return 0
    endif
    return ss_MatchHeroId[pid]
endfunction

function SaveSystem_MatchSetFinalStats takes integer pid,boolean isWin,integer kills,integer deaths,integer damagePhys,integer damageMagic,integer healing,integer takenPhys,integer takenMagic returns nothing
    if not SaveSystem_IsMatchPid(pid) or not ss_MatchParticipant[pid] then
        return
    endif
    set ss_MatchWin[pid]=isWin
    if kills < 0 then
        set kills=0
    endif
    if deaths < 0 then
        set deaths=0
    endif
    if damagePhys < 0 then
        set damagePhys=0
    endif
    if damageMagic < 0 then
        set damageMagic=0
    endif
    if healing < 0 then
        set healing=0
    endif
    if takenPhys < 0 then
        set takenPhys=0
    endif
    if takenMagic < 0 then
        set takenMagic=0
    endif
    // Combat totals are cumulative. Keeping the maximum also preserves a
    // snapshot made by a leave handler if another system later clears arrays.
    if kills > ss_MatchKills[pid] then
        set ss_MatchKills[pid]=kills
    endif
    if deaths > ss_MatchDeaths[pid] then
        set ss_MatchDeaths[pid]=deaths
    endif
    if damagePhys > ss_MatchDamagePhys[pid] then
        set ss_MatchDamagePhys[pid]=damagePhys
    endif
    if damageMagic > ss_MatchDamageMagic[pid] then
        set ss_MatchDamageMagic[pid]=damageMagic
    endif
    if healing > ss_MatchHealing[pid] then
        set ss_MatchHealing[pid]=healing
    endif
    if takenPhys > ss_MatchTakenPhys[pid] then
        set ss_MatchTakenPhys[pid]=takenPhys
    endif
    if takenMagic > ss_MatchTakenMagic[pid] then
        set ss_MatchTakenMagic[pid]=takenMagic
    endif
endfunction

function SaveSystem_BotSafeText takes string value returns string
    local integer i= 0
    local integer length= StringLength(value)
    local string result= ""
    local string ch
    if length > 48 then
        set length=48
    endif
    loop
        exitwhen i >= length
        set ch=SubString(value, i, i + 1)
        if ch == "|" or ch == "=" or ch == "," or ch == "\"" or ch == "\\" or ch == "\n" or ch == "\r" then
            set result=result + "_"
        else
            set result=result + ch
        endif
        set i=i + 1
    endloop
    return result
endfunction

function SaveSystem_BotNonNegative takes integer value returns integer
    if value < 0 then
        return 0
    endif
    return value
endfunction

function SaveSystem_BotNewMatchId takes nothing returns string
    return I2S(GetRandomInt(10000000, 99999999)) + "-" + I2S(GetRandomInt(10000000, 99999999)) + "-" + I2S(GetRandomInt(10000000, 99999999)) + "-" + I2S(GetRandomInt(10000000, 99999999))
endfunction

function SaveSystem_BotExportBegin takes integer team1Rounds,integer team2Rounds returns nothing
    local integer i= 0
    if ss_BotExportStarted or ss_BotExportWritten then
        return
    endif
    set ss_BotMatchId=(I2S(GetRandomInt(10000000, 99999999)) + "-" + I2S(GetRandomInt(10000000, 99999999)) + "-" + I2S(GetRandomInt(10000000, 99999999)) + "-" + I2S(GetRandomInt(10000000, 99999999))) // INLINED!!
    set ss_BotTeam1Rounds=SaveSystem_BotNonNegative(team1Rounds)
    set ss_BotTeam2Rounds=SaveSystem_BotNonNegative(team2Rounds)
    set ss_BotTrainKills=0
    set ss_BotPlayerCount=0
    set ss_BotItemCount=0
    loop
        exitwhen i >= SAVE_BOT_MAX_PLAYERS
        set ss_BotPlayerLine[i]=""
        set ss_BotStatsLine[i]=""
        set ss_BotItemsLine[i]=""
        set i=i + 1
    endloop
    set i=0
    loop
        exitwhen i >= SAVE_BOT_MAX_ITEMS
        set ss_BotItemId[i]=0
        set ss_BotItemGames[i]=0
        set ss_BotItemWins[i]=0
        set i=i + 1
    endloop
    set ss_BotExportStarted=true
endfunction

function SaveSystem_BotExportSetTrainKills takes integer trainKills returns nothing
    set ss_BotTrainKills=SaveSystem_BotNonNegative(trainKills)
endfunction

function SaveSystem_BotAddItemResult takes integer itemId,boolean isWin returns nothing
    local integer i= 0
    if itemId == 0 or SaveSystem_IsIgnoredItem(itemId) then
        return
    endif
    loop
        exitwhen i >= ss_BotItemCount
        if ss_BotItemId[i] == itemId then
            set ss_BotItemGames[i]=ss_BotItemGames[i] + 1
            if isWin then
                set ss_BotItemWins[i]=ss_BotItemWins[i] + 1
            endif
            return
        endif
        set i=i + 1
    endloop
    if ss_BotItemCount < SAVE_BOT_MAX_ITEMS then
        set ss_BotItemId[ss_BotItemCount]=itemId
        set ss_BotItemGames[ss_BotItemCount]=1
        if isWin then
            set ss_BotItemWins[ss_BotItemCount]=1
        else
            set ss_BotItemWins[ss_BotItemCount]=0
        endif
        set ss_BotItemCount=ss_BotItemCount + 1
    endif
endfunction

function SaveSystem_BotExportAddPlayer takes player whichPlayer,string stableName,unit whichHero,integer team,boolean isWin,integer kills,integer deaths,integer damagePhys,integer damageMagic,integer healing,integer takenPhys,integer takenMagic returns nothing
    local integer index= ss_BotPlayerCount
    local integer pid
    local integer heroId
    local integer winValue= 0
    local integer slot= 0
    local integer previous
    local integer itemId
    local integer previousItemId
    local boolean duplicate
    local item whichItem
    local item previousItem
    local string line
    local integer leftValue= 0
    if not ss_BotExportStarted or ss_BotExportWritten or index >= SAVE_BOT_MAX_PLAYERS or whichPlayer == null then
        return
    endif
    set pid=GetPlayerId(whichPlayer)
    call SaveSystem_MatchEnsureParticipant(pid , stableName)
    if whichHero != null then
        call SaveSystem_MatchSnapshotHero(pid , whichHero)
    endif
    if not ss_MatchParticipant[pid] then
        return
    endif
    set heroId=ss_MatchHeroId[pid]
    if stableName == "" then
        set stableName=ss_MatchStableName[pid]
    endif
    if ss_MatchTeam[pid] == 1 or ss_MatchTeam[pid] == 2 or ss_MatchTeamsReorganized then
        set team=ss_MatchTeam[pid]
    elseif team != 1 and team != 2 then
        set team=0
    endif
    if isWin then
        set winValue=1
    endif
    if ss_MatchLeft[pid] then
        set leftValue=1
    endif
    call SaveSystem_MatchSetFinalStats(pid , isWin , kills , deaths , damagePhys , damageMagic , healing , takenPhys , takenMagic)

    set line="PLAYER|n=" + I2S(index + 1) + "|pid=" + I2S(pid) + "|name=" + SaveSystem_BotSafeText(stableName)
    set line=line + "|team=" + I2S(team) + "|win=" + I2S(winValue) + "|hero_id=" + I2S(heroId)
    if heroId == 0 then
        set line=line + "|hero_name=Unknown"
    else
        set line=line + "|hero_name=" + SaveSystem_BotSafeText(GetObjectName(heroId))
    endif
    set line=line + "|left=" + I2S(leftValue)
    set line=line + "|lobby_slot=" + I2S(ss_MatchLobbySlot[pid]) + "|team_slot=" + I2S(ss_MatchTeamSlot[pid])
    set line=line + "|visual_slot=" + I2S(ss_MatchVisualSlot[pid])
    set ss_BotPlayerLine[index]=line

    set line="STATS|n=" + I2S(index + 1) + "|pid=" + I2S(pid) + "|rounds_played=" + I2S(ss_MatchRoundsPlayed[pid])
    set line=line + "|round_wins=" + I2S(ss_MatchRoundWins[pid]) + "|round_losses=" + I2S(ss_MatchRoundLosses[pid])
    set line=line + "|kills=" + I2S(ss_MatchKills[pid]) + "|deaths=" + I2S(ss_MatchDeaths[pid])
    set line=line + "|damage_phys=" + I2S(ss_MatchDamagePhys[pid]) + "|damage_magic=" + I2S(ss_MatchDamageMagic[pid])
    set line=line + "|damage_total=" + I2S(ss_MatchDamagePhys[pid] + ss_MatchDamageMagic[pid])
    set line=line + "|heal=" + I2S(ss_MatchHealing[pid]) + "|taken_phys=" + I2S(ss_MatchTakenPhys[pid])
    set line=line + "|taken_magic=" + I2S(ss_MatchTakenMagic[pid]) + "|taken_total=" + I2S(ss_MatchTakenPhys[pid] + ss_MatchTakenMagic[pid])
    set ss_BotStatsLine[index]=line

    set line="ITEMS|n=" + I2S(index + 1) + "|pid=" + I2S(pid)
    loop
        exitwhen slot >= 6
        set itemId=ss_MatchItemId[pid * 6 + slot]
        set line=line + "|slot" + I2S(slot + 1) + "=" + I2S(itemId)
        if itemId != 0 then
            set duplicate=false
            set previous=0
            loop
                exitwhen previous >= slot
                set previousItemId=ss_MatchItemId[pid * 6 + previous]
                if previousItemId == itemId then
                    set duplicate=true
                    set previous=slot
                else
                    set previous=previous + 1
                endif
            endloop
            if not duplicate then
                call SaveSystem_BotAddItemResult(itemId , isWin)
            endif
        endif
        set slot=slot + 1
    endloop
    set ss_BotItemsLine[index]=line
    set ss_BotPlayerCount=index + 1
endfunction

function SaveSystem_BotExportWriteTick takes nothing returns nothing
    local timer expired= GetExpiredTimer()
    local integer i= 0
    local integer games
    local integer wins
    local integer reorganized= 0
    local string line

    if ss_BotWritePhase == 0 then
        set ss_BotSealedLine[ss_BotSealedCount]=WOS2BotCodec_SealLine("ID|value=" + ss_BotMatchId + "|format=WOS2_BOT_V2|scope=MATCH")
        set ss_BotSealedCount=ss_BotSealedCount + 1
        set ss_BotWritePhase=1
    elseif ss_BotWritePhase == 1 then
        if ss_MatchTeamsReorganized then
            set reorganized=1
        endif
        set ss_BotSealedLine[ss_BotSealedCount]=WOS2BotCodec_SealLine("MATCH|team1_rounds=" + I2S(ss_BotTeam1Rounds) + "|team2_rounds=" + I2S(ss_BotTeam2Rounds) + "|players=" + I2S(ss_BotPlayerCount) + "|schema=2|teams_reorganized=" + I2S(reorganized) + "|train_kills=" + I2S(ss_BotTrainKills))
        set ss_BotSealedCount=ss_BotSealedCount + 1
        set ss_BotWritePhase=2
    elseif ss_BotWritePhase == 2 then
        if ss_BotWritePlayerIndex >= ss_BotPlayerCount then
            set ss_BotWritePhase=3
        else
            if ss_BotWritePlayerPart == 0 then
                set line=ss_BotPlayerLine[ss_BotWritePlayerIndex]
                set ss_BotWritePlayerPart=1
            elseif ss_BotWritePlayerPart == 1 then
                set line=ss_BotStatsLine[ss_BotWritePlayerIndex]
                set ss_BotWritePlayerPart=2
            else
                set line=ss_BotItemsLine[ss_BotWritePlayerIndex]
                set ss_BotWritePlayerPart=0
                set ss_BotWritePlayerIndex=ss_BotWritePlayerIndex + 1
            endif
            set ss_BotSealedLine[ss_BotSealedCount]=WOS2BotCodec_SealLine(line)
            set ss_BotSealedCount=ss_BotSealedCount + 1
        endif
    elseif ss_BotWritePhase == 3 then
        if ss_BotWriteItemIndex >= ss_BotItemCount then
            set ss_BotWritePhase=4
        else
            set games=ss_BotItemGames[ss_BotWriteItemIndex]
            set wins=ss_BotItemWins[ss_BotWriteItemIndex]
            set line="ITEM_RATE|item_id=" + I2S(ss_BotItemId[ss_BotWriteItemIndex]) + "|item_name=" + SaveSystem_BotSafeText(GetObjectName(ss_BotItemId[ss_BotWriteItemIndex]))
            set line=line + "|games=" + I2S(games) + "|wins=" + I2S(wins)
            if games > 0 then
                set line=line + "|winrate_pct=" + I2S(wins * 100 / games)
            else
                set line=line + "|winrate_pct=0"
            endif
            set ss_BotSealedLine[ss_BotSealedCount]=WOS2BotCodec_SealLine(line)
            set ss_BotSealedCount=ss_BotSealedCount + 1
            set ss_BotWriteItemIndex=ss_BotWriteItemIndex + 1
        endif
    elseif ss_BotWritePhase == 4 then
        set ss_BotSealedLine[ss_BotSealedCount]=WOS2BotCodec_SealLine("END|id=" + ss_BotMatchId)
        set ss_BotSealedCount=ss_BotSealedCount + 1
        set ss_BotWritePhase=5
    elseif ss_BotWritePhase == 5 then
        set ss_BotSealedLine[ss_BotSealedCount]=WOS2BotCodec_EndLine()
        set ss_BotSealedCount=ss_BotSealedCount + 1
        set ss_BotWritePhase=6
    else
        call PauseTimer(expired)
        call DestroyTimer(expired)
        set ss_BotWriteTimer=null
        call PreloadGenClear()
        call PreloadGenStart()
        call Preload(ss_BotSealedHeader)
        loop
            exitwhen i >= ss_BotSealedCount
            call Preload(ss_BotSealedLine[i])
            set ss_BotSealedLine[i]=""
            set i=i + 1
        endloop
        call PreloadGenEnd(SAVE_FOLDER + SAVE_BOT_PREFIX + ss_BotMatchId + ".txt")
        call PreloadGenClear()
        set ss_BotSealedCount=0
        set ss_BotSealedHeader=""
        set ss_BotExportWritten=true
        set ss_BotExportStarted=false
    endif
    set expired=null
endfunction

function SaveSystem_BotExportWrite takes nothing returns nothing
    if not ss_BotExportStarted or ss_BotExportWritten or ss_BotMatchId == "" or ss_BotWriteTimer != null then
        return
    endif
    call WOS2BotCodec_Begin(ss_BotMatchId)
    set ss_BotSealedHeader=WOS2BotCodec_Header()
    set ss_BotWritePhase=0
    set ss_BotWritePlayerIndex=0
    set ss_BotWritePlayerPart=0
    set ss_BotWriteItemIndex=0
    set ss_BotSealedCount=0
    set ss_BotWriteTimer=CreateTimer()
    call TimerStart(ss_BotWriteTimer, 0.03, true, function SaveSystem_BotExportWriteTick)
endfunction

// Both clients create and destroy exactly the same timer handle. Only the file
// payload differs locally. Phase 0 closes its PreloadGen session before phase 1.
function SaveSystem_DeferredSaveTick takes nothing returns nothing
    local timer expired= GetExpiredTimer()
    if ss_DeferredSavePhase == 0 then
        set ss_DeferredSavePhase=1
        set expired=null
        call SaveSystem_WriteOwnCareerAtFinish()
        return
    endif
    call PauseTimer(expired)
    call DestroyTimer(expired)
    set ss_DeferredSaveTimer=null
    set ss_DeferredSavePhase=2
    set expired=null
    call SaveSystem_BotExportWrite()
endfunction

function SaveSystem_ScheduleDeferredWrites takes nothing returns nothing
    if ss_DeferredSaveTimer != null then
        return
    endif
    set ss_DeferredSavePhase=0
    set ss_DeferredSaveTimer=CreateTimer()
    call TimerStart(ss_DeferredSaveTimer, 0.05, true, function SaveSystem_DeferredSaveTick)
endfunction

function SaveSystem_WritePendingPlayerFiles takes nothing returns nothing
    call SaveSystem_WriteOwnCareerAtFinish()
endfunction

//==============================================================================
// GAMEPLAY HOOKS: SAVE DATA NEVER ENTERS GAMEPLAY STATE
//==============================================================================

function SaveSystem_SetCurrentHero takes player whichPlayer,unit whichHero returns nothing
    local integer slot= 0
    local integer heroId= 0
    local integer pid
    if whichPlayer == null then
        return
    endif
    set pid=GetPlayerId(whichPlayer)
    if not AAINIT___IsGamePlayerSlot(pid) then
        return
    endif
    call SaveSystem_MatchEnsureParticipant(pid , ss_Identity[pid])
    if whichHero != null then
        set heroId=GetUnitTypeId(whichHero)
        call SaveSystem_MatchSnapshotHero(pid , whichHero)
    endif
    if GetLocalPlayer() != whichPlayer then
        return
    endif
    if heroId != ss_LocalMatchHeroId then
        set ss_LocalMatchHeroId=heroId
        set ss_LocalMatchRoundWins=0
        set ss_LocalMatchRoundLosses=0
        loop
            exitwhen slot >= 6
            set ss_LocalMatchBuild[slot]=0
            set slot=slot + 1
        endloop
    endif
endfunction

function SaveSystem_ClearMatchItems takes integer pid returns nothing
endfunction

function SaveSystem_MarkItemUsed takes integer pid,integer itemId returns nothing
endfunction

function SaveSystem_OnItemAcquired takes unit whichHero,item whichItem returns nothing
endfunction

function SaveSystem_OnItemPickup takes nothing returns nothing
endfunction

function SaveSystem_RecordItemUsed takes integer source,integer heroId,integer itemId,boolean isWin returns nothing
endfunction

function SaveSystem_RecordItemFinal takes integer source,integer heroId,integer itemId,boolean isWin returns nothing
endfunction

function SaveSystem_RecordHeroRelation takes player whichPlayer,unit whichHero,unit otherHero,boolean isTeammate,boolean isWin returns nothing
endfunction

function SaveSystem_OnRoundEnd takes player whichPlayer,boolean isWin returns nothing
    local integer pid
    if whichPlayer == null then
        return
    endif
    set pid=GetPlayerId(whichPlayer)
    if not AAINIT___IsGamePlayerSlot(pid) then
        return
    endif
    if SaveSystem_IsMatchPid(pid) and ss_MatchParticipant[pid] and not ss_MatchLeft[pid] then
        set ss_MatchRoundsPlayed[pid]=ss_MatchRoundsPlayed[pid] + 1
        if isWin then
            set ss_MatchRoundWins[pid]=ss_MatchRoundWins[pid] + 1
        else
            set ss_MatchRoundLosses[pid]=ss_MatchRoundLosses[pid] + 1
        endif
        call SaveSystem_MatchSnapshotHero(pid , ss_MatchHero[pid])
    endif
    if GetLocalPlayer() != whichPlayer then
        return
    endif
    if isWin then
        set ss_LocalMatchRoundWins=ss_LocalMatchRoundWins + 1
    else
        set ss_LocalMatchRoundLosses=ss_LocalMatchRoundLosses + 1
    endif
endfunction

function SaveSystem_OnGameEndDetailed takes player whichPlayer,unit whichHero,boolean isWin,integer kills,integer deaths returns nothing
    local integer slot= 0
    local integer pid
    local item whichItem
    if whichPlayer == null then
        return
    endif
    set pid=GetPlayerId(whichPlayer)
    if not AAINIT___IsGamePlayerSlot(pid) then
        return
    endif
    if SaveSystem_IsMatchPid(pid) and ss_MatchParticipant[pid] then
        if whichHero == null then
            set whichHero=ss_MatchHero[pid]
        endif
        call SaveSystem_MatchSnapshotHero(pid , whichHero)
    endif
    // This branch changes only local scalars. It creates no handles and performs
    // no disk I/O. The synchronized final scheduler does the actual write later.
    if GetLocalPlayer() == whichPlayer and not ss_LocalResultPending then
        set ss_LocalOwnerPid=pid
        set ss_LocalPendingWin=isWin
        if whichHero != null then
            set ss_LocalMatchHeroId=GetUnitTypeId(whichHero)
        endif
        if kills < 0 then
            set kills=0
        endif
        if deaths < 0 then
            set deaths=0
        endif
        set ss_LocalMatchKills=kills
        set ss_LocalMatchDeaths=deaths
        loop
            exitwhen slot >= 6
            set ss_LocalMatchBuild[slot]=0
            if whichHero != null then
                set whichItem=UnitItemInSlot(whichHero, slot)
                if whichItem != null then
                    set ss_LocalMatchBuild[slot]=GetItemTypeId(whichItem)
                endif
            endif
            set whichItem=null
            set slot=slot + 1
        endloop
        set ss_LocalResultPending=true
    endif
    set whichItem=null
endfunction

function SaveSystem_OnGameEndEx takes player whichPlayer,unit whichHero,boolean isWin returns nothing
    call SaveSystem_OnGameEndDetailed(whichPlayer , whichHero , isWin , - 1 , - 1)
endfunction

function SaveSystem_OnGameEnd takes player whichPlayer,boolean isWin returns nothing
    call SaveSystem_OnGameEndDetailed(whichPlayer , null , isWin , - 1 , - 1)
endfunction

