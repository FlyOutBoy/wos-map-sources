    function SacredGearBooster takes unit c,real dmg returns real
    if HasCachedItem(c , SacredGearBooster_Item_ID) > 0 and GetUnitAbilityLevel(c, SacredGearBooster_CDAbility_ID) > 0 and BlzGetUnitAbilityCooldownRemaining(c, SacredGearBooster_CDAbility_ID) == 0 then
            set dmg=dmg + ( GetMainStatValue(c , true) * SacredGearBooster_Damage )
            call BlzStartUnitAbilityCooldown(c, SacredGearBooster_CDAbility_ID, SacredGearBooster_CD)
            endif
            return dmg
    endfunction

        function s__ItemsSpells__ItemsSpells_FunnyBarrel_Loop_FunnyBarrel takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__ItemsSpells__ItemsSpells_FunnyBarrel_MUI_Item1
                set this=s__ItemsSpells__ItemsSpells_FunnyBarrel_m_Item1[i]
                if s__ItemsSpells__ItemsSpells_FunnyBarrel_r[this] <= s__ItemsSpells__ItemsSpells_FunnyBarrel_rmax[this] then
                    set s__ItemsSpells__ItemsSpells_FunnyBarrel_r[this]=s__ItemsSpells__ItemsSpells_FunnyBarrel_r[this] + 0.03
                    call MoveEff(s__ItemsSpells__ItemsSpells_FunnyBarrel_e[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_move[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_a[this])
                    set s__ItemsSpells__ItemsSpells_FunnyBarrel_r3[this]=s__ItemsSpells__ItemsSpells_FunnyBarrel_r3[this] + s__ItemsSpells__ItemsSpells_FunnyBarrel_move[this]
                    set s__ItemsSpells__ItemsSpells_FunnyBarrel_r2[this]=s__ItemsSpells__ItemsSpells_FunnyBarrel_r2[this] + 9
                    call BlzSetSpecialEffectHeight(s__ItemsSpells__ItemsSpells_FunnyBarrel_e[this], Parabola(800 , s__ItemsSpells__ItemsSpells_FunnyBarrel_sr[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_r3[this]))
                    call BlzSetSpecialEffectRoll(s__ItemsSpells__ItemsSpells_FunnyBarrel_e[this], s__ItemsSpells__ItemsSpells_FunnyBarrel_r2[this] * bj_DEGTORAD)
                    if s__ItemsSpells__ItemsSpells_FunnyBarrel_k3[this] == 1 then
                    call MoveEff(s__ItemsSpells__ItemsSpells_FunnyBarrel_e2[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_move[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_a[this])
                    call BlzSetSpecialEffectHeight(s__ItemsSpells__ItemsSpells_FunnyBarrel_e2[this], Parabola(800 , s__ItemsSpells__ItemsSpells_FunnyBarrel_sr[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_r3[this]))
                    endif
                else
                    call GroupEnumUnitsInRange(s__ItemsSpells__ItemsSpells_FunnyBarrel_g[this], s__ItemsSpells__ItemsSpells_FunnyBarrel_x[this], s__ItemsSpells__ItemsSpells_FunnyBarrel_y[this], s__ItemsSpells__ItemsSpells_FunnyBarrel_aoe[this], NoDecor_Cond)
                    loop
                        set s__ItemsSpells__ItemsSpells_FunnyBarrel_u[this]=FirstOfGroup(s__ItemsSpells__ItemsSpells_FunnyBarrel_g[this])
                        exitwhen s__ItemsSpells__ItemsSpells_FunnyBarrel_u[this] == null
                        if SpellBool(s__ItemsSpells__ItemsSpells_FunnyBarrel_u[this]) and IsUnitEnemy(s__ItemsSpells__ItemsSpells_FunnyBarrel_u[this], GetOwningPlayer(s__ItemsSpells__ItemsSpells_FunnyBarrel_c[this])) then
                            call dmgmag(s__ItemsSpells__ItemsSpells_FunnyBarrel_c[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_u[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_dmg[this])
                            call ErzaPassive(s__ItemsSpells__ItemsSpells_FunnyBarrel_c[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_u[this] , 1)
                        endif
                        call GroupRemoveUnit(s__ItemsSpells__ItemsSpells_FunnyBarrel_g[this], s__ItemsSpells__ItemsSpells_FunnyBarrel_u[this])
                    endloop
                    call DecorRemove(s__ItemsSpells__ItemsSpells_FunnyBarrel_c[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_x[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_y[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_aoe[this] , 20)
                     if s__ItemsSpells__ItemsSpells_FunnyBarrel_k3[this] == 1 then
                    call DestroyEffect(s__ItemsSpells__ItemsSpells_FunnyBarrel_e2[this])
                    call BambiettaG2_Start(s__ItemsSpells__ItemsSpells_FunnyBarrel_c[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_x[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_y[this])
		    set s__ItemsSpells__ItemsSpells_FunnyBarrel_k3[this]=0
                    endif

                    call DestroyEffect(EffectSpawn("war3mapimported\\wos_GZ_jntxn (11)_R1-200.mdl" , s__ItemsSpells__ItemsSpells_FunnyBarrel_x[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_y[this] , 1 , 1 , 0.65 , 1))
                    call UnitSpawn(Player(PLAYER_NEUTRAL_PASSIVE) , Fire_ID , s__ItemsSpells__ItemsSpells_FunnyBarrel_x[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_y[this] , 1 , 1 , 1.75 , 45 , FunnyBarrel_FireExist)
                    call ColorEffDummy3(s__ItemsSpells__ItemsSpells_FunnyBarrel_e[this] , 0 , 255 , 255 , 255 , 1)
                    call DestroyGroup(s__ItemsSpells__ItemsSpells_FunnyBarrel_g[this])
                    set s__ItemsSpells__ItemsSpells_FunnyBarrel_c[this]=null
                    set s__ItemsSpells__ItemsSpells_FunnyBarrel_g[this]=null
                    set s__ItemsSpells__ItemsSpells_FunnyBarrel_u[this]=null
                    set s__ItemsSpells__ItemsSpells_FunnyBarrel_e[this]=null
                    set s__ItemsSpells__ItemsSpells_FunnyBarrel_m_Item1[i]=s__ItemsSpells__ItemsSpells_FunnyBarrel_m_Item1[s__ItemsSpells__ItemsSpells_FunnyBarrel_MUI_Item1]
                    set s__ItemsSpells__ItemsSpells_FunnyBarrel_MUI_Item1=s__ItemsSpells__ItemsSpells_FunnyBarrel_MUI_Item1 - 1
                    if s__ItemsSpells__ItemsSpells_FunnyBarrel_MUI_Item1 == - 1 then
                        call PauseTimer(s__ItemsSpells__ItemsSpells_FunnyBarrel_t_Item1)
                    endif
                    call s__ItemsSpells__ItemsSpells_FunnyBarrel_deallocate(this)
                    set i=i - 1
                endif
                set i=i + 1
            endloop
        endfunction

        function s__ItemsSpells__ItemsSpells_FunnyBarrel_FunnyBarrel_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__ItemsSpells__ItemsSpells_FunnyBarrel__allocate()
            set s__ItemsSpells__ItemsSpells_FunnyBarrel_MUI_Item1=s__ItemsSpells__ItemsSpells_FunnyBarrel_MUI_Item1 + 1
            set s__ItemsSpells__ItemsSpells_FunnyBarrel_m_Item1[s__ItemsSpells__ItemsSpells_FunnyBarrel_MUI_Item1]=this
            set s__ItemsSpells__ItemsSpells_FunnyBarrel_c[this]=NewC
            set s__ItemsSpells__ItemsSpells_FunnyBarrel_x[this]=NewX
            set s__ItemsSpells__ItemsSpells_FunnyBarrel_y[this]=NewY
            set s__ItemsSpells__ItemsSpells_FunnyBarrel_g[this]=CreateGroup()
            set s__ItemsSpells__ItemsSpells_FunnyBarrel_u[this]=null
            set s__ItemsSpells__ItemsSpells_FunnyBarrel_a[this]=GAngle2(s__ItemsSpells__ItemsSpells_FunnyBarrel_c[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_x[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_y[this])
            set s__ItemsSpells__ItemsSpells_FunnyBarrel_rmax[this]=FunnyBarrel_Time
            set s__ItemsSpells__ItemsSpells_FunnyBarrel_sr[this]=SR3(s__ItemsSpells__ItemsSpells_FunnyBarrel_c[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_x[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_y[this])
            set s__ItemsSpells__ItemsSpells_FunnyBarrel_move[this]=SR3(s__ItemsSpells__ItemsSpells_FunnyBarrel_c[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_x[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_y[this]) / ( s__ItemsSpells__ItemsSpells_FunnyBarrel_rmax[this] * 100 / 3 )
            set s__ItemsSpells__ItemsSpells_FunnyBarrel_dmg[this]=FunnyBarrel_Damage + GetHeroLevel(s__ItemsSpells__ItemsSpells_FunnyBarrel_c[this]) * FunnyBarrel_DamageLvlMultiplier
            set s__ItemsSpells__ItemsSpells_FunnyBarrel_aoe[this]=FunnyBarrel_Aoe
            set s__ItemsSpells__ItemsSpells_FunnyBarrel_dmg[this]=SacredGearBooster(s__ItemsSpells__ItemsSpells_FunnyBarrel_c[this] , s__ItemsSpells__ItemsSpells_FunnyBarrel_dmg[this])
            set s__ItemsSpells__ItemsSpells_FunnyBarrel_r[this]=0
            set s__ItemsSpells__ItemsSpells_FunnyBarrel_r2[this]=0
            set s__ItemsSpells__ItemsSpells_FunnyBarrel_r3[this]=0
            call SetUnitAnimation(s__ItemsSpells__ItemsSpells_FunnyBarrel_c[this], "attack")
