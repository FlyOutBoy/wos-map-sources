            call ColorEffDummy3(EffectSpawnColor("war3mapimported\\wos_afb (43).mdl" , s__KenjakuSpells__KenjakuSummon_KS_x[this] , s__KenjakuSpells__KenjakuSummon_KS_y[this] , 1 , 1 , 0.45 , 1 , 255 , 25 , 25 , 255) , 0 , 255 , 255 , 255 , 1.1)
