                        set s__BazzBSpells___BazzBSpells_T_y1[this]=s__BazzBSpells___BazzBSpells_T_y1[this] + s__BazzBSpells___BazzBSpells_T_move[this] * Sin(s__BazzBSpells___BazzBSpells_T_a[this])

                        if s__BazzBSpells___BazzBSpells_T_r6[this] >= 0.0 then
                            set s__BazzBSpells___BazzBSpells_T_r6[this]=0.0
                            call DecorRemove(s__BazzBSpells___BazzBSpells_T_c[this] , s__BazzBSpells___BazzBSpells_T_x1[this] , s__BazzBSpells___BazzBSpells_T_y1[this] , s__BazzBSpells___BazzBSpells_T_aoe[this] , BazzBT_DecorDamage)
                            call GroupClear(s__BazzBSpells___BazzBSpells_T_g[this])
                            call GroupEnumUnitsInRange(s__BazzBSpells___BazzBSpells_T_g[this], s__BazzBSpells___BazzBSpells_T_x1[this], s__BazzBSpells___BazzBSpells_T_y1[this], s__BazzBSpells___BazzBSpells_T_aoe[this], Condition(function NoDecor_Filter))
                            loop
                                set u=FirstOfGroup(s__BazzBSpells___BazzBSpells_T_g[this])
                                exitwhen u == null
                                call GroupRemoveUnit(s__BazzBSpells___BazzBSpells_T_g[this], u)
                                if SpellBool(u) and IsUnitEnemy(u, GetOwningPlayer(s__BazzBSpells___BazzBSpells_T_c[this])) and not IsUnitInGroup(u, s__BazzBSpells___BazzBSpells_T_g2[this]) then
                                    call dmgmag(s__BazzBSpells___BazzBSpells_T_c[this] , u , s__BazzBSpells___BazzBSpells_T_dmg[this])
                                    call MUE(u , BazzBT_Push , BazzBT_PushDuration , s__BazzBSpells___BazzBSpells_T_a[this])
                                    if BazzBT_StunDuration > 0.0 then
                                        call StunUnit(s__BazzBSpells___BazzBSpells_T_c[this] , u , BazzBT_StunDuration)
                                    endif
                                    call GroupAddUnit(s__BazzBSpells___BazzBSpells_T_g2[this], u)
                                endif
                            endloop
                        else
                            set s__BazzBSpells___BazzBSpells_T_r6[this]=s__BazzBSpells___BazzBSpells_T_r6[this] + 0.03
                        endif

                        if s__BazzBSpells___BazzBSpells_T_r2[this] >= 0.0 then
                            set s__BazzBSpells___BazzBSpells_T_r2[this]=0.0
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_firefly-rq-sfx2.mdl" , s__BazzBSpells___BazzBSpells_T_x1[this] , s__BazzBSpells___BazzBSpells_T_y1[this] , GetRandomReal(0.0, 359.0) , GetRandomReal(1.0, 2.0) , 2.5 , 105.0))
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_opdef (652).mdl" , s__BazzBSpells___BazzBSpells_T_x1[this] , s__BazzBSpells___BazzBSpells_T_y1[this] , GetRandomReal(0.0, 359.0) , 2.0 , 1.0 , 150.0))
                            call VisionTimed(GetOwningPlayer(s__BazzBSpells___BazzBSpells_T_c[this]) , s__BazzBSpells___BazzBSpells_T_x1[this] , s__BazzBSpells___BazzBSpells_T_y1[this] , 1200.0 , 1.0)
                        else
                            set s__BazzBSpells___BazzBSpells_T_r2[this]=s__BazzBSpells___BazzBSpells_T_r2[this] + 0.03
                        endif
                    endif
                else
                    set remove=true
                endif

                if remove then
                    if s__BazzBSpells___BazzBSpells_T_c[this] != null and GetUnitTypeId(s__BazzBSpells___BazzBSpells_T_c[this]) != 0 then
                        call StopSpellUnit(s__BazzBSpells___BazzBSpells_T_c[this])
                        call SetUnitTimeScale(s__BazzBSpells___BazzBSpells_T_c[this], 1.0)
                    endif
                    if s__BazzBSpells___BazzBSpells_T_e[this] != null then
