                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_yc_shockwave_b.mdl" , s__NeuvilletteSpells___NeuvilletteSpells_Q_x[this] , s__NeuvilletteSpells___NeuvilletteSpells_Q_y[this] , 1 , 1 , 2.45 , 125))
