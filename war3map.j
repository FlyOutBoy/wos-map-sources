                            if SpellBool(s__LaxusSpells___LaxusW_KS_u[this]) and IsUnitEnemy(s__LaxusSpells___LaxusW_KS_u[this], GetOwningPlayer(s__LaxusSpells___LaxusW_KS_c[this])) then
                                if LoadInteger(hs, GetHandleId(s__LaxusSpells___LaxusW_KS_c[this]), StringHash("mode g")) == 1 and LaxusW2_Debuff > 0 then
                                    call ErzaPassive(s__LaxusSpells___LaxusW_KS_c[this] , s__LaxusSpells___LaxusW_KS_u[this] , LaxusW2_Debuff)
                                endif
                                call dmgmag(s__LaxusSpells___LaxusW_KS_c[this] , s__LaxusSpells___LaxusW_KS_u[this] , s__LaxusSpells___LaxusW_KS_dmg2[this])
                            endif
                            call GroupRemoveUnit(s__LaxusSpells___LaxusW_KS_g[this], s__LaxusSpells___LaxusW_KS_u[this])
                        endloop
                        set s__LaxusSpells___LaxusW_KS_u[this]=null
                        set s__LaxusSpells___LaxusW_KS_r[this]=9999.0
                        call MakeSound("war3mapimported\\Hero_Laxus_W2 3")
                        if s__LaxusSpells___LaxusW_KS_check2[this] == 0 then
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_YellowBoom.mdx" , s__LaxusSpells___LaxusW_KS_x[this] , s__LaxusSpells___LaxusW_KS_y[this] , 1.0 , 1.25 , 6.0 , 110.0))
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_by_wood_effect_yubanmeiqin_lightning_zhenzhengdeluolei_yellow.mdl" , s__LaxusSpells___LaxusW_KS_x[this] , s__LaxusSpells___LaxusW_KS_y[this] , 1.0 , 1.0 , 3.0 , 1.0))
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_YellowMissile.mdl" , s__LaxusSpells___LaxusW_KS_x[this] , s__LaxusSpells___LaxusW_KS_y[this] , 1.0 , 1.0 , 8.0 , 100.0))
                        else
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_RedBoom.mdx" , s__LaxusSpells___LaxusW_KS_x[this] , s__LaxusSpells___LaxusW_KS_y[this] , 1.0 , 1.25 , 6.0 , 110.0))
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_by_wood_effect_yubanmeiqin_lightning_zhenzhengdeluolei_red.mdl" , s__LaxusSpells___LaxusW_KS_x[this] , s__LaxusSpells___LaxusW_KS_y[this] , 1.0 , 1.0 , 3.0 , 1.0))
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_RedMissile.mdl" , s__LaxusSpells___LaxusW_KS_x[this] , s__LaxusSpells___LaxusW_KS_y[this] , 1.0 , 1.0 , 8.0 , 100.0))
                        endif
                    endif
                else
                    // Гарантированный сброс обратно на W при завершении или отмене W2
                   //if c != null and GetUnitAbilityLevel(c, LaxusW2_ID) > 0 then
                     //   call SwapAbility(c, 3, LaxusW_ID, LaxusW2_ID)
                      //  call MyFrame(c, 3, "BTNHero_Laxus_W", false, 0)
                    //endif
                    if s__LaxusSpells___LaxusW_KS_e[this] != null then
                        call DestroyEffect(s__LaxusSpells___LaxusW_KS_e[this])
                    endif
                    if s__LaxusSpells___LaxusW_KS_e2[this] != null then
                        call DestroyEffect(s__LaxusSpells___LaxusW_KS_e2[this])
                    endif
                    if s__LaxusSpells___LaxusW_KS_e3[this] != null then
                        call DestroyEffect(s__LaxusSpells___LaxusW_KS_e3[this])
                    endif
                    call SetUnitTimeScale(s__LaxusSpells___LaxusW_KS_c[this], 1.0)
                    if s__LaxusSpells___LaxusW_KS_r[this] < 0.60 then
                        if LaxusW2_IsInvul then
                            call StopSpellUnit(s__LaxusSpells___LaxusW_KS_c[this])
                            call StopSpellUnit(s__LaxusSpells___LaxusW_KS_td[this])
                        else
                            call StopSpellUnit2(s__LaxusSpells___LaxusW_KS_c[this])
                            call StopSpellUnit2(s__LaxusSpells___LaxusW_KS_td[this])
                        endif
                    endif
                    if s__LaxusSpells___LaxusW_KS_g[this] != null then
                        call DestroyGroup(s__LaxusSpells___LaxusW_KS_g[this])
                    endif
                    set s__LaxusSpells___LaxusW_KS_c[this]=null
                    set s__LaxusSpells___LaxusW_KS_td[this]=null
                    set s__LaxusSpells___LaxusW_KS_e[this]=null
                    set s__LaxusSpells___LaxusW_KS_g[this]=null
                    set s__LaxusSpells___LaxusW_KS_u[this]=null
                    set s__LaxusSpells___LaxusW_KS_e2[this]=null
                    set s__LaxusSpells___LaxusW_KS_e3[this]=null
                    set s__LaxusSpells___LaxusW_KS_m_LaxusW2[i]=s__LaxusSpells___LaxusW_KS_m_LaxusW2[s__LaxusSpells___LaxusW_KS_MUI_LaxusW2]
                    set s__LaxusSpells___LaxusW_KS_MUI_LaxusW2=s__LaxusSpells___LaxusW_KS_MUI_LaxusW2 - 1
                    if s__LaxusSpells___LaxusW_KS_MUI_LaxusW2 == - 1 then
                        call LaxusSpells___LaxusTimer03Release()
                    endif
                    call s__LaxusSpells___LaxusW_KS_deallocate(this)
                    set i=i - 1
                endif
                set i=i + 1
            endloop
        endfunction

        function s__LaxusSpells___LaxusW_KS_LaxusW2_Start takes unit NewC,unit NewTd returns nothing
            local integer this= s__LaxusSpells___LaxusW_KS__allocate()
            set s__LaxusSpells___LaxusW_KS_MUI_LaxusW2=s__LaxusSpells___LaxusW_KS_MUI_LaxusW2 + 1
            set s__LaxusSpells___LaxusW_KS_m_LaxusW2[s__LaxusSpells___LaxusW_KS_MUI_LaxusW2]=this
            set s__LaxusSpells___LaxusW_KS_c[this]=NewC
            set s__LaxusSpells___LaxusW_KS_td[this]=NewTd
            set s__LaxusSpells___LaxusW_KS_r[this]=0.0
            set s__LaxusSpells___LaxusW_KS_g[this]=CreateGroup()
            set s__LaxusSpells___LaxusW_KS_rmax[this]=LaxusW2_MaxDuration
            set s__LaxusSpells___LaxusW_KS_u[this]=null
            if LaxusW2_IsInvul then
                call StartSpellUnit(s__LaxusSpells___LaxusW_KS_c[this])
            else
                call StartSpellUnit2(s__LaxusSpells___LaxusW_KS_c[this])
            endif
            call SetUnitAnimationByIndex(s__LaxusSpells___LaxusW_KS_c[this], 10)
            call SetUnitTimeScale(s__LaxusSpells___LaxusW_KS_c[this], 1.10)
            set s__LaxusSpells___LaxusW_KS_aoe[this]=LaxusW2_DamageAoe
            call MakeSound("war3mapimported\\Hero_Laxus_W2 1")
            set s__LaxusSpells___LaxusW_KS_dmg[this]=GetHeroStr(s__LaxusSpells___LaxusW_KS_c[this], true) * ( LaxusW2_DamageStrBase + ( LaxusW2_DamageStrStep * ( GetUnitAbilityLevel(s__LaxusSpells___LaxusW_KS_c[this], LaxusW2_ID) - 1 ) ) )
            set s__LaxusSpells___LaxusW_KS_dmg2[this]=GetHeroStr(s__LaxusSpells___LaxusW_KS_c[this], true) * ( LaxusW2_DamageStrBase2 + ( LaxusW2_DamageStrStep2 * ( GetUnitAbilityLevel(s__LaxusSpells___LaxusW_KS_c[this], LaxusW2_ID) - 1 ) ) )
            set s__LaxusSpells___LaxusW_KS_a[this]=GAngle(s__LaxusSpells___LaxusW_KS_c[this] , s__LaxusSpells___LaxusW_KS_td[this])
            call PosUnit(s__LaxusSpells___LaxusW_KS_c[this] , GetUnitX(s__LaxusSpells___LaxusW_KS_td[this]) - 150.0 * Cos(s__LaxusSpells___LaxusW_KS_a[this]) , GetUnitY(s__LaxusSpells___LaxusW_KS_td[this]) - 150.0 * Sin(s__LaxusSpells___LaxusW_KS_a[this]))
            set s__LaxusSpells___LaxusW_KS_check2[this]=0
            if LoadInteger(hs, GetHandleId(s__LaxusSpells___LaxusW_KS_c[this]), StringHash("mode g")) == 1 then
                set s__LaxusSpells___LaxusW_KS_dmg[this]=s__LaxusSpells___LaxusW_KS_dmg[this] + GetHeroStr(s__LaxusSpells___LaxusW_KS_c[this], true) * LaxusGW2_DamageStrBonus
                set s__LaxusSpells___LaxusW_KS_dmg2[this]=s__LaxusSpells___LaxusW_KS_dmg2[this] + GetHeroStr(s__LaxusSpells___LaxusW_KS_c[this], true) * LaxusGW2_DamageStrBonus
                if LoadInteger(hs, GetHandleId(s__LaxusSpells___LaxusW_KS_c[this]), StringHash("lvl5")) == 1 then
                    set s__LaxusSpells___LaxusW_KS_check2[this]=1
                    set s__LaxusSpells___LaxusW_KS_dmg[this]=s__LaxusSpells___LaxusW_KS_dmg[this] + GetHeroStr(s__LaxusSpells___LaxusW_KS_c[this], true) * LaxusGW2_DamageStrBonus2
                    set s__LaxusSpells___LaxusW_KS_dmg2[this]=s__LaxusSpells___LaxusW_KS_dmg2[this] + GetHeroStr(s__LaxusSpells___LaxusW_KS_c[this], true) * LaxusGW2_DamageStrBonus2
                endif
            endif
            if s__LaxusSpells___LaxusW_KS_check2[this] == 1 then
                set s__LaxusSpells___LaxusW_KS_e[this]=AddSpecialEffectTarget("war3mapImported\\wos_RedMissile.mdl", s__LaxusSpells___LaxusW_KS_c[this], "hand left")
                set s__LaxusSpells___LaxusW_KS_e2[this]=AddSpecialEffectTarget("war3mapImported\\wos_RedMissile.mdl", s__LaxusSpells___LaxusW_KS_c[this], "hand left")
            else
                set s__LaxusSpells___LaxusW_KS_e[this]=AddSpecialEffectTarget("war3mapImported\\wos_YellowMissile.mdl", s__LaxusSpells___LaxusW_KS_c[this], "hand left")
                set s__LaxusSpells___LaxusW_KS_e2[this]=AddSpecialEffectTarget("war3mapImported\\wos_YellowMissile.mdl", s__LaxusSpells___LaxusW_KS_c[this], "hand left")
            endif
            if s__LaxusSpells___LaxusW_KS_MUI_LaxusW2 == 0 then
                call LaxusSpells___LaxusTimer03Acquire()
            endif
        endfunction

        function s__LaxusSpells___LaxusW_KS_Loop_LaxusW takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__LaxusSpells___LaxusW_KS_MUI_LaxusW
                set this=s__LaxusSpells___LaxusW_KS_m_LaxusW[i]
                if SpellBoolCaster(s__LaxusSpells___LaxusW_KS_c[this]) and s__LaxusSpells___LaxusW_KS_r[this] <= s__LaxusSpells___LaxusW_KS_rmax[this] and SpellBoolCaster(s__LaxusSpells___LaxusW_KS_td[this]) then
                    set s__LaxusSpells___LaxusW_KS_r[this]=RoundReal(s__LaxusSpells___LaxusW_KS_r[this] + 0.03 , 3)
                    set s__LaxusSpells___LaxusW_KS_a[this]=GAngle(s__LaxusSpells___LaxusW_KS_c[this] , s__LaxusSpells___LaxusW_KS_td[this])
                    call SetUnitFacing(s__LaxusSpells___LaxusW_KS_c[this], s__LaxusSpells___LaxusW_KS_a[this] * bj_RADTODEG)
                    if s__LaxusSpells___LaxusW_KS_r[this] == LaxusW_CastTime then
                        if s__LaxusSpells___LaxusW_KS_check[this] == 1 then
                            call s__GearSystems2__KS_DelayedSound_NextSound_Start(("war3mapimported\\Hero_Laxus_W2" ) , (( 0.30)*1.0)) // INLINED!!
                        elseif s__LaxusSpells___LaxusW_KS_check[this] == 3 then
                            call s__GearSystems2__KS_DelayedSound_NextSound_Start(("war3mapimported\\Hero_Laxus_W5" ) , (( 0.30)*1.0)) // INLINED!!
                        endif
                    endif
                    if s__LaxusSpells___LaxusW_KS_r[this] > LaxusW_CastTime then
                        if SR2(s__LaxusSpells___LaxusW_KS_c[this] , s__LaxusSpells___LaxusW_KS_td[this]) > 100.0 then
                            call MoveUnit(s__LaxusSpells___LaxusW_KS_c[this] , s__LaxusSpells___LaxusW_KS_move[this] , s__LaxusSpells___LaxusW_KS_a[this])
                        else
                            call dmgphys(s__LaxusSpells___LaxusW_KS_c[this] , s__LaxusSpells___LaxusW_KS_td[this] , s__LaxusSpells___LaxusW_KS_dmg[this])
                            call StunUnit(s__LaxusSpells___LaxusW_KS_c[this] , s__LaxusSpells___LaxusW_KS_td[this] , LaxusW_Stun)
                            if LoadInteger(hs, GetHandleId(s__LaxusSpells___LaxusW_KS_c[this]), StringHash("mode g")) == 1 and LaxusW_Debuff > 0 then
                                call ErzaPassive(s__LaxusSpells___LaxusW_KS_c[this] , s__LaxusSpells___LaxusW_KS_td[this] , LaxusW_Debuff)
                            endif
                            call MUE(s__LaxusSpells___LaxusW_KS_td[this] , LaxusW_PushRange , LaxusW_PushDuration , s__LaxusSpells___LaxusW_KS_a[this])
                            call MakeSound("war3mapimported\\Hero_Laxus_W")
                            set s__LaxusSpells___LaxusW_KS_x[this]=GetUnitX(s__LaxusSpells___LaxusW_KS_td[this])
                            set s__LaxusSpells___LaxusW_KS_y[this]=GetUnitY(s__LaxusSpells___LaxusW_KS_td[this])
                            call DecorRemove(s__LaxusSpells___LaxusW_KS_c[this] , s__LaxusSpells___LaxusW_KS_x[this] , s__LaxusSpells___LaxusW_KS_y[this] , 350.0 , LaxusW_DecorDamage)

                            // Разблокировка W2 при 5 уровне способности с таймером автовозврата на 3 секунды
                            if GetUnitAbilityLevel(s__LaxusSpells___LaxusW_KS_c[this], LaxusW_ID) >= 5 then
                                call s__GearSystems2__KS_SpellTimer_SpellTimer_Timer_Start((s__LaxusSpells___LaxusW_KS_c[this] ) , (( 3 )*1.0) , ( LaxusW2_ID ) , ( LaxusW_ID) , 0) // INLINED!!
                                call s__GearSystems2__KS_BuffTimer_MyBuffTime_Start((s__LaxusSpells___LaxusW_KS_c[this] ) , 0 , (( 3 )*1.0) , ( "BTNHero_Laxus_W2" ) , ( false ) , - 1 , 1 , 0 , ( 0)) // INLINED!!
                            endif

                            set s__LaxusSpells___LaxusW_KS_r[this]=99999.0
                            set s__LaxusSpells___LaxusW_KS_x[this]=GetUnitX(s__LaxusSpells___LaxusW_KS_td[this]) + 130.0 * Cos(s__LaxusSpells___LaxusW_KS_a[this])
                            set s__LaxusSpells___LaxusW_KS_y[this]=GetUnitY(s__LaxusSpells___LaxusW_KS_td[this]) + 130.0 * Sin(s__LaxusSpells___LaxusW_KS_a[this])
                            if s__LaxusSpells___LaxusW_KS_check2[this] == 0 then
                                call DestroyEffect(EffectSpawn("war3mapImported\\wos_YellowBoom.mdx" , s__LaxusSpells___LaxusW_KS_x[this] , s__LaxusSpells___LaxusW_KS_y[this] , 1.0 , 1.25 , 2.5 , 110.0))
                                call DestroyEffect(EffectSpawn("war3mapImported\\wos_SlamYellow.mdl" , s__LaxusSpells___LaxusW_KS_x[this] , s__LaxusSpells___LaxusW_KS_y[this] , 1.0 , 1.0 , 4.0 , 1.0))
                                call DestroyEffect(EffectSpawn("war3mapImported\\wos_YellowMissile.mdl" , s__LaxusSpells___LaxusW_KS_x[this] , s__LaxusSpells___LaxusW_KS_y[this] , 1.0 , 1.0 , 4.0 , 100.0))
                            else
                                call DestroyEffect(EffectSpawn("war3mapImported\\wos_OPm (434)3small.mdl" , s__LaxusSpells___LaxusW_KS_x[this] , s__LaxusSpells___LaxusW_KS_y[this] , GetRandomReal(0.0, 359.0) , 1.0 , 3.0 , 145.0))
                                call DestroyEffect(EffectSpawn("war3mapImported\\wos_ZarakiWCrack2.mdx" , s__LaxusSpells___LaxusW_KS_x[this] , s__LaxusSpells___LaxusW_KS_y[this] , GetRandomReal(0.0, 359.0) , 1.0 , 3.0 , 0.0))
                                call DestroyEffect(EffectSpawn("war3mapimported\\wos_BY_Wood_Eff_Ord_DanGe_Wav_Kuosan_1_3_0_5s.mdx" , s__LaxusSpells___LaxusW_KS_x[this] , s__LaxusSpells___LaxusW_KS_y[this] , 1.0 , 1.0 , 1.0 , 100.0))
                                call DestroyEffect(EffectSpawn("war3mapImported\\wos_YC_CrossFlashred.mdl" , s__LaxusSpells___LaxusW_KS_x[this] + 25.0 * Cos(s__LaxusSpells___LaxusW_KS_a[this]) , s__LaxusSpells___LaxusW_KS_y[this] + 25.0 * Sin(s__LaxusSpells___LaxusW_KS_a[this]) , 1.0 , 1.25 , 2.5 , 255.0))
                                call DestroyEffect(EffectSpawn("war3mapImported\\wos_RedBoom.mdx" , s__LaxusSpells___LaxusW_KS_x[this] , s__LaxusSpells___LaxusW_KS_y[this] , 1.0 , 1.25 , 2.5 , 110.0))
                                call DestroyEffect(EffectSpawn("war3mapImported\\wos_SlamRed.mdl" , s__LaxusSpells___LaxusW_KS_x[this] , s__LaxusSpells___LaxusW_KS_y[this] , 1.0 , 1.0 , 4.0 , 1.0))
                                call DestroyEffect(EffectSpawn("war3mapImported\\wos_RedMissile.mdl" , s__LaxusSpells___LaxusW_KS_x[this] , s__LaxusSpells___LaxusW_KS_y[this] , 1.0 , 1.0 , 4.0 , 100.0))
                            endif
                        endif
                    endif
                else
                    if s__LaxusSpells___LaxusW_KS_e[this] != null then
                        call DestroyEffect(s__LaxusSpells___LaxusW_KS_e[this])
                    endif
                    if s__LaxusSpells___LaxusW_KS_e2[this] != null then
                        call DestroyEffect(s__LaxusSpells___LaxusW_KS_e2[this])
                    endif
                    if s__LaxusSpells___LaxusW_KS_e3[this] != null then
                        call DestroyEffect(s__LaxusSpells___LaxusW_KS_e3[this])
                    endif
                    if LaxusW_IsInvul then
                        call StopSpellUnit(s__LaxusSpells___LaxusW_KS_c[this])
                    else
                        call StopSpellUnit2(s__LaxusSpells___LaxusW_KS_c[this])
                    endif
                    call SetUnitTimeScale(s__LaxusSpells___LaxusW_KS_c[this], 1.0)
                    set s__LaxusSpells___LaxusW_KS_c[this]=null
                    set s__LaxusSpells___LaxusW_KS_td[this]=null
                    set s__LaxusSpells___LaxusW_KS_e[this]=null
                    set s__LaxusSpells___LaxusW_KS_e2[this]=null
                    set s__LaxusSpells___LaxusW_KS_e3[this]=null
                    set s__LaxusSpells___LaxusW_KS_m_LaxusW[i]=s__LaxusSpells___LaxusW_KS_m_LaxusW[s__LaxusSpells___LaxusW_KS_MUI_LaxusW]
                    set s__LaxusSpells___LaxusW_KS_MUI_LaxusW=s__LaxusSpells___LaxusW_KS_MUI_LaxusW - 1
                    if s__LaxusSpells___LaxusW_KS_MUI_LaxusW == - 1 then
                        call LaxusSpells___LaxusTimer03Release()
                    endif
                    call s__LaxusSpells___LaxusW_KS_deallocate(this)
                    set i=i - 1
                endif
                set i=i + 1
            endloop
        endfunction

        function s__LaxusSpells___LaxusW_KS_LaxusW_Start takes unit NewC,unit NewTd returns nothing
            local integer this= s__LaxusSpells___LaxusW_KS__allocate()
            local integer k= 0
            set s__LaxusSpells___LaxusW_KS_MUI_LaxusW=s__LaxusSpells___LaxusW_KS_MUI_LaxusW + 1
            set s__LaxusSpells___LaxusW_KS_m_LaxusW[s__LaxusSpells___LaxusW_KS_MUI_LaxusW]=this
            set s__LaxusSpells___LaxusW_KS_c[this]=NewC
            set s__LaxusSpells___LaxusW_KS_td[this]=NewTd
            set s__LaxusSpells___LaxusW_KS_r[this]=0.0
            set s__LaxusSpells___LaxusW_KS_move[this]=80.0
            set s__LaxusSpells___LaxusW_KS_rmax[this]=LaxusW_MaxDuration
            if LaxusW_IsInvul then
                call StartSpellUnit(s__LaxusSpells___LaxusW_KS_c[this])
            else
                call StartSpellUnit2(s__LaxusSpells___LaxusW_KS_c[this])
            endif
            call SetUnitAnimationByIndex(s__LaxusSpells___LaxusW_KS_c[this], 11)
            call SetUnitTimeScale(s__LaxusSpells___LaxusW_KS_c[this], 1.10)
            set k=GetRandomInt(1, 3)
            if k == 1 then
                call MakeSound("war3mapimported\\Hero_Laxus_W1")
                set s__LaxusSpells___LaxusW_KS_check[this]=1
            elseif k == 2 then
                set s__LaxusSpells___LaxusW_KS_check[this]=2
                call MakeSound("war3mapimported\\Hero_Laxus_W3")
            else
                set s__LaxusSpells___LaxusW_KS_check[this]=3
                call MakeSound("war3mapimported\\Hero_Laxus_W4")
            endif
            set s__LaxusSpells___LaxusW_KS_dmg[this]=GetHeroStr(s__LaxusSpells___LaxusW_KS_c[this], true) * ( LaxusW_DamageStrBase + ( LaxusW_DamageStrStep * ( GetUnitAbilityLevel(s__LaxusSpells___LaxusW_KS_c[this], LaxusW_ID) - 1 ) ) )
            set s__LaxusSpells___LaxusW_KS_dmg[this]=s__LaxusSpells___LaxusW_KS_dmg[this] + LaxusW_Damage2StaticBase + ( LaxusW_Damage2StaticStep * ( GetUnitAbilityLevel(s__LaxusSpells___LaxusW_KS_c[this], LaxusW_ID) - 1 ) )
            set s__LaxusSpells___LaxusW_KS_check2[this]=0
