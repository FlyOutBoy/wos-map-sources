        set BambiettaSpells___BambiettaTimer05=CreateTimer()
        set BambiettaSpells___BambiettaTimer03Callback=function BambiettaSpells___BambiettaTimer03Loop
        set BambiettaSpells___BambiettaTimer05Callback=function BambiettaSpells___BambiettaTimer05Loop
    endfunction

    function BambiettaQ_Start takes unit c,real x,real y returns nothing
        if LoadInteger(hs, GetHandleId(GetOwningPlayer(c)), StringHash("morph t")) > 0 then
            call s__BambiettaSpells___BambiettaSpells_Q_BambiettaTQ_Start(c , x , y)
        else
            call s__BambiettaSpells___BambiettaSpells_Q_BambiettaQ_Start(c , x , y)
        endif
    endfunction

