                        set s__MilimSpells__MilimEKS_r7[this]=0.1 * 0.75 // scale
                        set s__MilimSpells__MilimEKS_r8[this]=50 // move
                        set s__MilimSpells__MilimEKS_scale[this]=0.45
                        set s__MilimSpells__MilimEKS_fly[this]=550
                        set s__MilimSpells__MilimEKS_fly2[this]=7
                        set s__MilimSpells__MilimEKS_fly3[this]=31 * 0.75
            set s__MilimSpells__MilimEKS_e[this]=EffectSpawn3("war3mapImported\\wos_file00005542.mdl" , GetUnitX(s__MilimSpells__MilimEKS_c[this]) + ( 450 ) * Cos(s__MilimSpells__MilimEKS_a[this]) , GetUnitY(s__MilimSpells__MilimEKS_c[this]) + ( 450 ) * Sin(s__MilimSpells__MilimEKS_a[this]) , s__MilimSpells__MilimEKS_a[this] * bj_RADTODEG , 1 , s__MilimSpells__MilimEKS_scale[this] , s__MilimSpells__MilimEKS_fly[this] , - 60)
            call BlzPlaySpecialEffect(s__MilimSpells__MilimEKS_e[this], ANIM_TYPE_STAND)
            set s__MilimSpells__MilimEKS_r9[this]=- 50
                    endif
                    if s__MilimSpells__MilimEKS_check[this] == 20 then
                    set s__MilimSpells__MilimEKS_check[this]=21
                    call ColorEffDummy3(s__MilimSpells__MilimEKS_e[this] , 0 , 255 , 255 , 255 , 0.35)
                    endif
                    if s__MilimSpells__MilimEKS_r[this] > 0.45 and s__MilimSpells__MilimEKS_check[this] < 20 then
                        if s__MilimSpells__MilimEKS_r5[this] < s__MilimSpells__MilimEKS_r4[this] then
                            set s__MilimSpells__MilimEKS_r5[this]=s__MilimSpells__MilimEKS_r5[this] + s__MilimSpells__MilimEKS_move[this]
                        else
                            set s__MilimSpells__MilimEKS_r[this]=9999
                        endif
                        set s__MilimSpells__MilimEKS_check[this]=s__MilimSpells__MilimEKS_check[this] + 1
                        set s__MilimSpells__MilimEKS_r9[this]=s__MilimSpells__MilimEKS_r9[this] - 3 * 0.75
                        call BlzSetSpecialEffectPitch(s__MilimSpells__MilimEKS_e[this], s__MilimSpells__MilimEKS_r9[this] * bj_DEGTORAD)
                        set s__MilimSpells__MilimEKS_scale[this]=s__MilimSpells__MilimEKS_scale[this] + s__MilimSpells__MilimEKS_r7[this]
                        call BlzSetSpecialEffectScale(s__MilimSpells__MilimEKS_e[this], s__MilimSpells__MilimEKS_scale[this])
                        call MoveEff2(s__MilimSpells__MilimEKS_e[this] , s__MilimSpells__MilimEKS_r8[this] + ( s__MilimSpells__MilimEKS_check[this] * ( 3 * 0.75 ) ) , s__MilimSpells__MilimEKS_a[this])
                        if s__MilimSpells__MilimEKS_check[this] < 9 then
                        set s__MilimSpells__MilimEKS_fly[this]=s__MilimSpells__MilimEKS_fly[this] - ( s__MilimSpells__MilimEKS_fly2[this] + s__MilimSpells__MilimEKS_check[this] * 5 )
                        else
                        if s__MilimSpells__MilimEKS_check[this] >= 15 then
                        set s__MilimSpells__MilimEKS_fly[this]=s__MilimSpells__MilimEKS_fly[this] + ( s__MilimSpells__MilimEKS_fly3[this] + ( s__MilimSpells__MilimEKS_check[this] * 3.5 ) )
                        else
