        function s__DarkShikiSpells___DarkShikiPas_KS_DarkShikiPas_Start takes unit NewC,unit NewTd returns nothing
            local integer this= s__DarkShikiSpells___DarkShikiPas_KS__allocate()
            set s__DarkShikiSpells___DarkShikiPas_KS_MUI_DarkShikiPas=s__DarkShikiSpells___DarkShikiPas_KS_MUI_DarkShikiPas + 1
            set s__DarkShikiSpells___DarkShikiPas_KS_m_DarkShikiPas[s__DarkShikiSpells___DarkShikiPas_KS_MUI_DarkShikiPas]=this
            set s__DarkShikiSpells___DarkShikiPas_KS_c[this]=NewC
            set s__DarkShikiSpells___DarkShikiPas_KS_td[this]=NewTd
            set s__DarkShikiSpells___DarkShikiPas_KS_r[this]=0
            set s__DarkShikiSpells___DarkShikiPas_KS_scale[this]=4
            set s__DarkShikiSpells___DarkShikiPas_KS_scale2[this]=0.85
            set s__DarkShikiSpells___DarkShikiPas_KS_check[this]=LoadInteger(hs, GetHandleId(s__DarkShikiSpells___DarkShikiPas_KS_td[this]), StringHash("DarkShiki pas"))
            set s__DarkShikiSpells___DarkShikiPas_KS_x[this]=GetUnitX(s__DarkShikiSpells___DarkShikiPas_KS_td[this])
            set s__DarkShikiSpells___DarkShikiPas_KS_y[this]=GetUnitY(s__DarkShikiSpells___DarkShikiPas_KS_td[this])
            set s__DarkShikiSpells___DarkShikiPas_KS_dmg[this]=GetHeroAgi(s__DarkShikiSpells___DarkShikiPas_KS_c[this], true) * DarkShikiG_Damage
            set s__DarkShikiSpells___DarkShikiPas_KS_check2[this]=0
            if GetHeroLevel(s__DarkShikiSpells___DarkShikiPas_KS_c[this]) >= 35 then
                set s__DarkShikiSpells___DarkShikiPas_KS_r5[this]=0.14
                set s__DarkShikiSpells___DarkShikiPas_KS_rmax[this]=DarkShikiG_Time + DarkShikiG_Time35BonusAdd
            else
                set s__DarkShikiSpells___DarkShikiPas_KS_r5[this]=0.21
                set s__DarkShikiSpells___DarkShikiPas_KS_rmax[this]=DarkShikiG_Time
            endif
            if IsUnitIllusion(s__DarkShikiSpells___DarkShikiPas_KS_td[this]) == false then
                set s__DarkShikiSpells___DarkShikiPas_KS_check2[this]=1
            endif
            if s__DarkShikiSpells___DarkShikiPas_KS_check2[this] == 1 then
                            if GetHeroLevel(s__DarkShikiSpells___DarkShikiPas_KS_c[this]) >= 35 then
                                set s__DarkShikiSpells___DarkShikiPas_KS_dmg[this]=( DarkShikiG_Damage + DarkShikiG_Damage35BonusAdd ) * GetHeroAgi(s__DarkShikiSpells___DarkShikiPas_KS_c[this], true)
                            else
                                set s__DarkShikiSpells___DarkShikiPas_KS_dmg[this]=DarkShikiG_Damage * GetHeroAgi(s__DarkShikiSpells___DarkShikiPas_KS_c[this], true)
                            endif
                call DestroyEffect(EffectSpawn("war3mapimported\\wos_ldeff (5).mdx" , s__DarkShikiSpells___DarkShikiPas_KS_x[this] , s__DarkShikiSpells___DarkShikiPas_KS_y[this] , GAngle(s__DarkShikiSpells___DarkShikiPas_KS_c[this] , s__DarkShikiSpells___DarkShikiPas_KS_td[this]) * bj_RADTODEG , 1 , 2.5 , 165))
                call s__GearSystems2__KS_DelayedDamage_NextDmg_Start((s__DarkShikiSpells___DarkShikiPas_KS_c[this] ) , ( s__DarkShikiSpells___DarkShikiPas_KS_td[this] ) , (( s__DarkShikiSpells___DarkShikiPas_KS_dmg[this] )*1.0) , ( 0 ) , (( 0.05)*1.0)) // INLINED!!
                set s__DarkShikiSpells___DarkShikiPas_KS_e3[this]=EffectSpawn("war3mapImported\\wos_ShikiCounter.mdl" , GetUnitX(s__DarkShikiSpells___DarkShikiPas_KS_c[this]) , GetUnitY(s__DarkShikiSpells___DarkShikiPas_KS_c[this]) , 0 , s__DarkShikiSpells___DarkShikiPas_KS_r5[this] , 4.5 , 155)
                set s__DarkShikiSpells___DarkShikiPas_KS_e2[this]=EffectSpawn("war3mapimported\\wos_AZ_EVEMD.mdl" , s__DarkShikiSpells___DarkShikiPas_KS_x[this] , s__DarkShikiSpells___DarkShikiPas_KS_y[this] , 0 , s__DarkShikiSpells___DarkShikiPas_KS_scale2[this] , 1.75 , 1)
                set s__DarkShikiSpells___DarkShikiPas_KS_e[this]=EffectSpawn("war3mapImported\\wos_DarkShikiClock_1.mdl" , s__DarkShikiSpells___DarkShikiPas_KS_x[this] , s__DarkShikiSpells___DarkShikiPas_KS_y[this] , 0 , s__DarkShikiSpells___DarkShikiPas_KS_scale2[this] , s__DarkShikiSpells___DarkShikiPas_KS_scale[this] , 0)
            endif
            if s__DarkShikiSpells___DarkShikiPas_KS_MUI_DarkShikiPas == 0 then
                call TimerStart(s__DarkShikiSpells___DarkShikiPas_KS_t_DarkShikiPas, 0.03, true, function s__DarkShikiSpells___DarkShikiPas_KS_Loop_DarkShikiPas)
            endif
        endfunction

        function s__DarkShikiSpells___DarkShikiPassive_KS_DarkShikiPassiveApply takes unit c,unit td returns nothing
            local integer i= GetPlayerId(GetOwningPlayer(td))
            local integer h= GetHandleId(td)
            local integer sh= StringHash("DarkShiki pas")
            local unit d= LoadUnitHandle(hs, GetHandleId(c), StringHash("passive target"))
            if GetHeroLevel(c) >= 6 and GetUnitAbilityLevel(td, 'Aloc') == 0 and IsUnitType(td, UNIT_TYPE_HERO) then
                if d != td then
                endif
                if LoadInteger(hs, h, sh) == 0 or d != td then
                    call SaveInteger(hs, h, sh, 1)
                    call SaveUnitHandle(hs, GetHandleId(c), StringHash("passive target"), td)
                    call s__DarkShikiSpells___DarkShikiPas_KS_DarkShikiPas_Start(c , td)
                elseif LoadInteger(hs, h, sh) == 1 and d == td then
                    call SaveInteger(hs, h, sh, 2)
                elseif LoadInteger(hs, h, sh) == 2 and d == td then
                    call SaveInteger(hs, h, sh, 3)
