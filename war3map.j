            else
                call BlzFrameSetPoint(Frame_Cap1_5[i], FRAMEPOINT_BOTTOM, Frame_Cap1_3[i], FRAMEPOINT_BOTTOMLEFT, ( x + 0.017 + 0.03 ) - ( 0.059 + 0.05 * I2R(i2) ), ( y - 0.0575 ) - 0.0165 - 0.02) // - 0.03 * i)
            endif
        else
