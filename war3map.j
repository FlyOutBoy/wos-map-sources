            set s__RimuruSpells___RimuruR_KS_r7[this]=800
            set s__RimuruSpells___RimuruR_KS_r2[this]=1
            set s__RimuruSpells___RimuruR_KS_r4[this]=0
            set s__RimuruSpells___RimuruR_KS_x1[this]=GetUnitX(s__RimuruSpells___RimuruR_KS_c[this])
            set s__RimuruSpells___RimuruR_KS_y1[this]=GetUnitY(s__RimuruSpells___RimuruR_KS_c[this])
            set s__RimuruSpells___RimuruR_KS_sr[this]=SR2(s__RimuruSpells___RimuruR_KS_c[this] , s__RimuruSpells___RimuruR_KS_td[this])
            set s__RimuruSpells___RimuruR_KS_check[this]=0
            set s__RimuruSpells___RimuruR_KS_rmax[this]=2.4
            set s__RimuruSpells___RimuruR_KS_scale[this]=1
            set s__RimuruSpells___RimuruR_KS_k2[this]=GetPlayerId(GetOwningPlayer(s__RimuruSpells___RimuruR_KS_c[this]))
            set s__RimuruSpells___RimuruR_KS_k3[this]=RimuruEvol1_MagiculeDmg
            call StartSpellUnit2(s__RimuruSpells___RimuruR_KS_c[this])
            set s__RimuruSpells___RimuruR_KS_dmg[this]=GetHeroInt(s__RimuruSpells___RimuruR_KS_c[this], true) * ( RimuruR_DamageIntBase + ( RimuruR_DamageIntStep * ( GetUnitAbilityLevel(s__RimuruSpells___RimuruR_KS_c[this], RimuruR_ID) - 1 ) ) )
            set s__RimuruSpells___RimuruR_KS_dmg[this]=s__RimuruSpells___RimuruR_KS_dmg[this] / 6
            call SetUnitFacing(s__RimuruSpells___RimuruR_KS_c[this], GAngle(s__RimuruSpells___RimuruR_KS_c[this] , s__RimuruSpells___RimuruR_KS_td[this]) * bj_RADTODEG)
