    local integer i= 0
    set gg_trg_ArrowLeft=CreateTrigger()
    loop
        exitwhen i == 10
        call TriggerRegisterPlayerKeyEventBJ(gg_trg_ArrowLeft, Player(i), bj_KEYEVENTTYPE_DEPRESS, bj_KEYEVENTKEY_LEFT)
