            elseif ( PlayerFrameCurrentPage_ID[pid] == 5 and Hero_ID4[k3] != 0 ) or ( PlayerFrameCurrentPage_ID[pid] == 6 and Hero_ID5[k3] != 0 ) then
                if GetHeroId(PlayerFrameCurrentPage_ID[pid] , k3) == Gojo_ID then
