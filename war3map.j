endif
// ... rest of setup
            call h__SetPlayerAbilityAvailable(GetOwningPlayer(s__GearSystems2__KS_FakeCooldown_c[this]), s__GearSystems2__KS_FakeCooldown_check[this], false)
            if GetLocalPlayer() == GetOwningPlayer(s__GearSystems2__KS_FakeCooldown_c[this]) then
            call BlzSetAbilityPosX(s__GearSystems2__KS_FakeCooldown_k3[this], BlzGetAbilityPosX(s__GearSystems2__KS_FakeCooldown_check[this]))
            call BlzSetAbilityPosY(s__GearSystems2__KS_FakeCooldown_k3[this], BlzGetAbilityPosY(s__GearSystems2__KS_FakeCooldown_check[this]))
            call BlzSetAbilityIcon(s__GearSystems2__KS_FakeCooldown_k3[this], BlzGetAbilityIcon(s__GearSystems2__KS_FakeCooldown_check[this]))
            call BlzSetAbilityTooltip(s__GearSystems2__KS_FakeCooldown_k3[this], BlzGetAbilityStringLevelField(BlzGetUnitAbility(s__GearSystems2__KS_FakeCooldown_c[this], s__GearSystems2__KS_FakeCooldown_check[this]), ABILITY_SLF_TOOLTIP_NORMAL, GetUnitAbilityLevel(s__GearSystems2__KS_FakeCooldown_c[this], s__GearSystems2__KS_FakeCooldown_check[this]) - 1), 0)
