                    call SetUnitTimeScale(s__MilimSpells__MilimEKS_c[this], 1)
                    call DestroyGroup(s__MilimSpells__MilimEKS_g[this])
                    call DestroyGroup(s__MilimSpells__MilimEKS_g2[this])
                    set s__MilimSpells__MilimEKS_g[this]=null
                    set s__MilimSpells__MilimEKS_g2[this]=null
                    set s__MilimSpells__MilimEKS_c[this]=null
                    set s__MilimSpells__MilimEKS_e[this]=null
                    set s__MilimSpells__MilimEKS_u[this]=null
                    set s__MilimSpells__MilimEKS_m_MilimE[i]=s__MilimSpells__MilimEKS_m_MilimE[s__MilimSpells__MilimEKS_MUI_MilimE]
                    set s__MilimSpells__MilimEKS_MUI_MilimE=s__MilimSpells__MilimEKS_MUI_MilimE - 1
                    if s__MilimSpells__MilimEKS_MUI_MilimE == - 1 then
                        call PauseTimer(s__MilimSpells__MilimEKS_t_MilimE)
                    endif
                    call s__MilimSpells__MilimEKS_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction
        function s__MilimSpells__MilimEKS_MilimE_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__MilimSpells__MilimEKS__allocate()
            local real mm= 0
            set s__MilimSpells__MilimEKS_MUI_MilimE=s__MilimSpells__MilimEKS_MUI_MilimE + 1
            set s__MilimSpells__MilimEKS_m_MilimE[s__MilimSpells__MilimEKS_MUI_MilimE]=this
            set s__MilimSpells__MilimEKS_c[this]=NewC
            set s__MilimSpells__MilimEKS_x[this]=NewX
            set s__MilimSpells__MilimEKS_y[this]=NewY
            set s__MilimSpells__MilimEKS_x1[this]=GetUnitX(s__MilimSpells__MilimEKS_c[this])
            set s__MilimSpells__MilimEKS_y1[this]=GetUnitY(s__MilimSpells__MilimEKS_c[this])
            set s__MilimSpells__MilimEKS_r[this]=0
            set s__MilimSpells__MilimEKS_r2[this]=0
            set s__MilimSpells__MilimEKS_move[this]=80
            set s__MilimSpells__MilimEKS_r5[this]=0
            set s__MilimSpells__MilimEKS_a[this]=GAngle2(s__MilimSpells__MilimEKS_c[this] , s__MilimSpells__MilimEKS_x[this] , s__MilimSpells__MilimEKS_y[this]) // Angle Between points
            set s__MilimSpells__MilimEKS_r4[this]=MilimE_RangeBase + ( MilimE_RangeStep * ( GetUnitAbilityLevel(s__MilimSpells__MilimEKS_c[this], MilimE_ID) - 1 ) )
            
            call StartSpellUnit2(s__MilimSpells__MilimEKS_c[this])
            call BlinkEff(s__MilimSpells__MilimEKS_c[this])
            set mm=SR3(s__MilimSpells__MilimEKS_c[this] , s__MilimSpells__MilimEKS_x[this] , s__MilimSpells__MilimEKS_y[this])
            if mm < 700 then
                call PosUnit(s__MilimSpells__MilimEKS_c[this] , s__MilimSpells__MilimEKS_x1[this] - ( 700 - mm ) * Cos(s__MilimSpells__MilimEKS_a[this]) , s__MilimSpells__MilimEKS_y1[this] - ( 700 - mm ) * Sin(s__MilimSpells__MilimEKS_a[this]))
            endif
            set s__MilimSpells__MilimEKS_x1[this]=GetUnitX(s__MilimSpells__MilimEKS_c[this])
            set s__MilimSpells__MilimEKS_y1[this]=GetUnitY(s__MilimSpells__MilimEKS_c[this])
            call SetFly(s__MilimSpells__MilimEKS_c[this] , 700)
            set s__MilimSpells__MilimEKS_scale[this]=0.5
            set s__MilimSpells__MilimEKS_r5[this]=600
            set s__MilimSpells__MilimEKS_g[this]=CreateGroup()
            set s__MilimSpells__MilimEKS_g2[this]=CreateGroup()
            set s__MilimSpells__MilimEKS_u[this]=null
            set s__MilimSpells__MilimEKS_aoe[this]=MilimE_DamageAoe
            set s__MilimSpells__MilimEKS_dmg[this]=GetHeroAgi(s__MilimSpells__MilimEKS_c[this], true) * ( MilimE_DamageAgiBase + ( MilimE_DamageAgiStep * ( GetUnitAbilityLevel(s__MilimSpells__MilimEKS_c[this], MilimE_ID) - 1 ) ) )
            if LoadInteger(hs, GetHandleId(s__MilimSpells__MilimEKS_c[this]), StringHash("mode t")) == 1 then
                set s__MilimSpells__MilimEKS_dmg[this]=s__MilimSpells__MilimEKS_dmg[this] + MilimT_DmgAdd * GetHeroAgi(s__MilimSpells__MilimEKS_c[this], true)
            endif
            
            set s__MilimSpells__MilimEKS_rmax[this]=1.11
            call SetUnitAnimationByIndex(s__MilimSpells__MilimEKS_c[this], 7)
            call SetUnitTimeScale(s__MilimSpells__MilimEKS_c[this], 0.95)
            call MakeSound("war3mapimported\\Hero_Milim_E")
            if s__MilimSpells__MilimEKS_MUI_MilimE == 0 then
                call TimerStart(s__MilimSpells__MilimEKS_t_MilimE, 0.03, true, function s__MilimSpells__MilimEKS_Loop_MilimE)
            endif
        endfunction
   
    // Ýòîò áëîê ìîæíî îáúåäèíèòü ñ ñóùåñòâóþùèì globals áèáëèîòåêè MilimSpells.


// Ïîëíîñòüþ îòâå÷àåò çà ïîë¸ò îäíîãî ñíàðÿäà, çàäåðæêó è âçðûâ.


    function s__MilimSpells__MilimRProjectileKS_Loop_MilimRProjectile takes nothing returns nothing
        local integer this
        local integer i= 0
        local real progress
        local real ellipseProgress
        local real ellipseOffset
        local real oldX
        local real oldY
        local real moveDistance
        local real moveAngle
        local real x
        local real y
        local integer sharedGroupId
        local integer remainingProjectiles

        loop
            exitwhen i > s__MilimSpells__MilimRProjectileKS_MUI_MilimRProjectile
            set this=s__MilimSpells__MilimRProjectileKS_m_MilimRProjectile[i]

            if s__MilimSpells__MilimRProjectileKS_check[this] == 0 then
                set s__MilimSpells__MilimRProjectileKS_r[this]=s__MilimSpells__MilimRProjectileKS_r[this] + 0.03
                if s__MilimSpells__MilimRProjectileKS_r[this] > s__MilimSpells__MilimRProjectileKS_rmax[this] then
                    set s__MilimSpells__MilimRProjectileKS_r[this]=s__MilimSpells__MilimRProjectileKS_rmax[this]
                endif

                set progress=s__MilimSpells__MilimRProjectileKS_r[this] / s__MilimSpells__MilimRProjectileKS_rmax[this]

                // Ïîëîâèíà ýëëèïñà: ñòàðò è ôèíèø ñîâïàäàþò ñ çàäàííûìè òî÷êàìè,
                // à arcSide âûáèðàåò çàêðóãëåíèå íà +90 èëè -90 ãðàäóñîâ.
                set ellipseProgress=0.50 - 0.50 * Cos(bj_PI * progress)
                set ellipseOffset=Sin(bj_PI * progress) * s__MilimSpells__MilimRProjectileKS_arcSize[this] * s__MilimSpells__MilimRProjectileKS_arcSide[this]
                set oldX=s__MilimSpells__MilimRProjectileKS_currentX[this]
                set oldY=s__MilimSpells__MilimRProjectileKS_currentY[this]
                set s__MilimSpells__MilimRProjectileKS_currentX[this]=s__MilimSpells__MilimRProjectileKS_startX[this] + ( s__MilimSpells__MilimRProjectileKS_targetX[this] - s__MilimSpells__MilimRProjectileKS_startX[this] ) * ellipseProgress + ellipseOffset * Cos(s__MilimSpells__MilimRProjectileKS_a[this] + 90.00 * bj_DEGTORAD)
                set s__MilimSpells__MilimRProjectileKS_currentY[this]=s__MilimSpells__MilimRProjectileKS_startY[this] + ( s__MilimSpells__MilimRProjectileKS_targetY[this] - s__MilimSpells__MilimRProjectileKS_startY[this] ) * ellipseProgress + ellipseOffset * Sin(s__MilimSpells__MilimRProjectileKS_a[this] + 90.00 * bj_DEGTORAD)

                call BlzSetSpecialEffectPosition(s__MilimSpells__MilimRProjectileKS_e[this], s__MilimSpells__MilimRProjectileKS_currentX[this], s__MilimSpells__MilimRProjectileKS_currentY[this], s__MilimSpells__MilimRProjectileKS_fly[this])
                call BlzSetSpecialEffectYaw(s__MilimSpells__MilimRProjectileKS_e[this], Atan2(s__MilimSpells__MilimRProjectileKS_currentY[this] - oldY, s__MilimSpells__MilimRProjectileKS_currentX[this] - oldX))
                call BlzSetSpecialEffectPosition(s__MilimSpells__MilimRProjectileKS_e2[this], s__MilimSpells__MilimRProjectileKS_currentX[this], s__MilimSpells__MilimRProjectileKS_currentY[this], s__MilimSpells__MilimRProjectileKS_fly[this])
                call BlzSetSpecialEffectYaw(s__MilimSpells__MilimRProjectileKS_e2[this], Atan2(s__MilimSpells__MilimRProjectileKS_currentY[this] - oldY, s__MilimSpells__MilimRProjectileKS_currentX[this] - oldX))
                set moveDistance=SquareRoot(( s__MilimSpells__MilimRProjectileKS_currentX[this] - oldX ) * ( s__MilimSpells__MilimRProjectileKS_currentX[this] - oldX ) + ( s__MilimSpells__MilimRProjectileKS_currentY[this] - oldY ) * ( s__MilimSpells__MilimRProjectileKS_currentY[this] - oldY ))
                set moveAngle=Atan2(s__MilimSpells__MilimRProjectileKS_currentY[this] - oldY, s__MilimSpells__MilimRProjectileKS_currentX[this] - oldX)

                if s__MilimSpells__MilimRProjectileKS_r2[this] >= MilimR_CarryScanPeriod then
                    set s__MilimSpells__MilimRProjectileKS_r2[this]=0.00
                    call GroupEnumUnitsInRange(s__MilimSpells__MilimRProjectileKS_g[this], s__MilimSpells__MilimRProjectileKS_currentX[this], s__MilimSpells__MilimRProjectileKS_currentY[this], MilimR_CarryAoe, NoDecor_Cond)
                    loop
                        set s__MilimSpells__MilimRProjectileKS_u[this]=FirstOfGroup(s__MilimSpells__MilimRProjectileKS_g[this])
                        exitwhen s__MilimSpells__MilimRProjectileKS_u[this] == null
                        if SpellBool(s__MilimSpells__MilimRProjectileKS_u[this]) and IsUnitEnemy(s__MilimSpells__MilimRProjectileKS_u[this], GetOwningPlayer(s__MilimSpells__MilimRProjectileKS_c[this])) and not IsUnitInGroup(s__MilimSpells__MilimRProjectileKS_u[this], s__MilimSpells__MilimRProjectileKS_g4[this]) then
                            call GroupAddUnit(s__MilimSpells__MilimRProjectileKS_g3[this], s__MilimSpells__MilimRProjectileKS_u[this])
                            call GroupAddUnit(s__MilimSpells__MilimRProjectileKS_g4[this], s__MilimSpells__MilimRProjectileKS_u[this])
                        endif
                        call GroupRemoveUnit(s__MilimSpells__MilimRProjectileKS_g[this], s__MilimSpells__MilimRProjectileKS_u[this])
                    endloop
                else
                    set s__MilimSpells__MilimRProjectileKS_r2[this]=s__MilimSpells__MilimRProjectileKS_r2[this] + 0.03
                endif

                call GroupClear(s__MilimSpells__MilimRProjectileKS_g[this])
                loop
                    set s__MilimSpells__MilimRProjectileKS_u[this]=FirstOfGroup(s__MilimSpells__MilimRProjectileKS_g3[this])
                    exitwhen s__MilimSpells__MilimRProjectileKS_u[this] == null
                    call GroupRemoveUnit(s__MilimSpells__MilimRProjectileKS_g3[this], s__MilimSpells__MilimRProjectileKS_u[this])
                    if SpellBool(s__MilimSpells__MilimRProjectileKS_u[this]) then
                        call MoveUnit(s__MilimSpells__MilimRProjectileKS_u[this] , moveDistance , moveAngle)
                        call GroupAddUnit(s__MilimSpells__MilimRProjectileKS_g[this], s__MilimSpells__MilimRProjectileKS_u[this])
                    else
                        call GroupRemoveUnit(s__MilimSpells__MilimRProjectileKS_g4[this], s__MilimSpells__MilimRProjectileKS_u[this])
                    endif
                endloop
                loop
                    set s__MilimSpells__MilimRProjectileKS_u[this]=FirstOfGroup(s__MilimSpells__MilimRProjectileKS_g[this])
                    exitwhen s__MilimSpells__MilimRProjectileKS_u[this] == null
                    call GroupRemoveUnit(s__MilimSpells__MilimRProjectileKS_g[this], s__MilimSpells__MilimRProjectileKS_u[this])
                    call GroupAddUnit(s__MilimSpells__MilimRProjectileKS_g3[this], s__MilimSpells__MilimRProjectileKS_u[this])
                endloop

                if s__MilimSpells__MilimRProjectileKS_visionTick[this] >= MilimR_VisionPeriod then
                    set s__MilimSpells__MilimRProjectileKS_visionTick[this]=0.00
                    call VisionTimed(GetOwningPlayer(s__MilimSpells__MilimRProjectileKS_c[this]) , s__MilimSpells__MilimRProjectileKS_currentX[this] , s__MilimSpells__MilimRProjectileKS_currentY[this] , MilimR_DamageAoe * 2.00 , MilimR_VisionPeriod * 2.00)
                else
                    set s__MilimSpells__MilimRProjectileKS_visionTick[this]=s__MilimSpells__MilimRProjectileKS_visionTick[this] + 0.03
                endif
                if s__MilimSpells__MilimRProjectileKS_r[this] >= s__MilimSpells__MilimRProjectileKS_rmax[this] then
                    call BlzSetSpecialEffectScale(s__MilimSpells__MilimRProjectileKS_e[this], 0.001)
                    call DestroyEffect(s__MilimSpells__MilimRProjectileKS_e[this])
                    set s__MilimSpells__MilimRProjectileKS_e[this]=null
                    call DestroyEffect(s__MilimSpells__MilimRProjectileKS_e2[this])
                    set s__MilimSpells__MilimRProjectileKS_e2[this]=null
                    set s__MilimSpells__MilimRProjectileKS_currentX[this]=s__MilimSpells__MilimRProjectileKS_targetX[this]
                    set s__MilimSpells__MilimRProjectileKS_currentY[this]=s__MilimSpells__MilimRProjectileKS_targetY[this]

                    // ÇÀÒÛ×ÊÀ: ýôôåêò â òî÷êå ïðèçåìëåíèÿ ñíàðÿäà.
                    set s__MilimSpells__MilimRProjectileKS_e3[this]=EffectSpawn("war3mapImported\\wos_file00000417.mdl" , s__MilimSpells__MilimRProjectileKS_targetX[this] , s__MilimSpells__MilimRProjectileKS_targetY[this] , GetRandomReal(0, 359) , 2.25 , GetRandomReal(1.8, 3.25) , GetRandomReal(125, 400))
                    set s__MilimSpells__MilimRProjectileKS_check[this]=1
                    set s__MilimSpells__MilimRProjectileKS_r[this]=0.00
                endif
            else
                set s__MilimSpells__MilimRProjectileKS_r[this]=s__MilimSpells__MilimRProjectileKS_r[this] + 0.03
                if s__MilimSpells__MilimRProjectileKS_r[this] == 0.06 and IntegerCd(s__MilimSpells__MilimRProjectileKS_c[this] , "cd exp" , 2) then
                call MakeSound("war3mapimported\\Hero_Milim_R 4")
                endif
                if s__MilimSpells__MilimRProjectileKS_r[this] >= 0.15 then
                    call DestroyEffect(s__MilimSpells__MilimRProjectileKS_e3[this])
                    set s__MilimSpells__MilimRProjectileKS_e3[this]=null
                    set x=s__MilimSpells__MilimRProjectileKS_targetX[this]
                    set y=s__MilimSpells__MilimRProjectileKS_targetY[this]

                    // Âèçóàëüíûé âçðûâ ñîçäàþò òîëüêî ïðîñòðàíñòâåííî ðàçíåñ¸ííûå ñíàðÿäû.
                    // Ïðîâåðêà óðîíà íèæå âûïîëíÿåòñÿ ó âñåõ ñíàðÿäîâ áåç èñêëþ÷åíèÿ.
                    if s__MilimSpells__MilimRProjectileKS_showExplosionFx[this] then
                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_by_wood_eff_sel_elp_qiuxingbaozha.mdl" , x , y , GetRandomReal(0, 359) , GetRandomReal(1, 1.35) , GetRandomReal(4.00, 6.50) , 0))
                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_afb (2080).mdl" , x , y , s__MilimSpells__MilimRProjectileKS_a[this] * bj_RADTODEG , 0.85 , 1.9 , 1))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_YC_CrossFlash.mdl" , x + 25 * Cos(s__MilimSpells__MilimRProjectileKS_a[this]) , y + 25 * Sin(s__MilimSpells__MilimRProjectileKS_a[this]) , 0 , 0.5 , 2.94 , GetRandomReal(200, 450)))
                    endif

                    call DecorRemove(s__MilimSpells__MilimRProjectileKS_c[this] , s__MilimSpells__MilimRProjectileKS_targetX[this] , s__MilimSpells__MilimRProjectileKS_targetY[this] , MilimR_DamageAoe , 40)
                    call GroupEnumUnitsInRange(s__MilimSpells__MilimRProjectileKS_g[this], s__MilimSpells__MilimRProjectileKS_targetX[this], s__MilimSpells__MilimRProjectileKS_targetY[this], MilimR_DamageAoe, NoDecor_Cond)
                    loop
                        set s__MilimSpells__MilimRProjectileKS_u[this]=FirstOfGroup(s__MilimSpells__MilimRProjectileKS_g[this])
                        exitwhen s__MilimSpells__MilimRProjectileKS_u[this] == null
                        if SpellBool(s__MilimSpells__MilimRProjectileKS_u[this]) and IsUnitEnemy(s__MilimSpells__MilimRProjectileKS_u[this], GetOwningPlayer(s__MilimSpells__MilimRProjectileKS_c[this])) and not IsUnitInGroup(s__MilimSpells__MilimRProjectileKS_u[this], s__MilimSpells__MilimRProjectileKS_g2[this]) then
                            call GroupAddUnit(s__MilimSpells__MilimRProjectileKS_g2[this], s__MilimSpells__MilimRProjectileKS_u[this])
                            call dmgmag(s__MilimSpells__MilimRProjectileKS_c[this] , s__MilimSpells__MilimRProjectileKS_u[this] , s__MilimSpells__MilimRProjectileKS_dmg[this])
                            call SlowUnit(s__MilimSpells__MilimRProjectileKS_c[this] , s__MilimSpells__MilimRProjectileKS_u[this] , MilimR_Slow , MilimR_SlowDuration)
                        endif
                        call GroupRemoveUnit(s__MilimSpells__MilimRProjectileKS_g[this], s__MilimSpells__MilimRProjectileKS_u[this])
                    endloop

                    // Îáùàÿ ãðóïïà æèâ¸ò, ïîêà íå âçîðâ¸òñÿ ïîñëåäíèé ñíàðÿä êàñòà.
                    set sharedGroupId=GetHandleId(s__MilimSpells__MilimRProjectileKS_g2[this])
                    set remainingProjectiles=LoadInteger(hs, sharedGroupId, StringHash("MilimR projectiles left")) - 1
                    if remainingProjectiles <= 0 then
                        call FlushChildHashtable(hs, sharedGroupId)
                        call DestroyGroup(s__MilimSpells__MilimRProjectileKS_g2[this])
                        call DestroyGroup(s__MilimSpells__MilimRProjectileKS_g4[this])
                    else
                        call SaveInteger(hs, sharedGroupId, StringHash("MilimR projectiles left"), remainingProjectiles)
                    endif

                    call DestroyGroup(s__MilimSpells__MilimRProjectileKS_g[this])
                    call DestroyGroup(s__MilimSpells__MilimRProjectileKS_g3[this])
                    set s__MilimSpells__MilimRProjectileKS_g[this]=null
                    set s__MilimSpells__MilimRProjectileKS_g2[this]=null
                    set s__MilimSpells__MilimRProjectileKS_g3[this]=null
                    set s__MilimSpells__MilimRProjectileKS_g4[this]=null
                    set s__MilimSpells__MilimRProjectileKS_e[this]=null
                    set s__MilimSpells__MilimRProjectileKS_e2[this]=null
                    set s__MilimSpells__MilimRProjectileKS_e3[this]=null
                    set s__MilimSpells__MilimRProjectileKS_u[this]=null
                    set s__MilimSpells__MilimRProjectileKS_c[this]=null

                    set s__MilimSpells__MilimRProjectileKS_m_MilimRProjectile[i]=s__MilimSpells__MilimRProjectileKS_m_MilimRProjectile[s__MilimSpells__MilimRProjectileKS_MUI_MilimRProjectile]
                    set s__MilimSpells__MilimRProjectileKS_MUI_MilimRProjectile=s__MilimSpells__MilimRProjectileKS_MUI_MilimRProjectile - 1
                    if s__MilimSpells__MilimRProjectileKS_MUI_MilimRProjectile == - 1 then
                        call PauseTimer(s__MilimSpells__MilimRProjectileKS_t_MilimRProjectile)
                    endif
                    call s__MilimSpells__MilimRProjectileKS_deallocate(this)
                    set i=i - 1
                endif
            endif

            set i=i + 1
        endloop
    endfunction

    function s__MilimSpells__MilimRProjectileKS_MilimRProjectile_Start takes unit NewC,real NewStartX,real NewStartY,real NewTargetX,real NewTargetY,real NewArcSide,real NewArcSize,real NewFly,real NewDuration,real NewDamage,group NewDamagedGroup,group NewPushedGroup,boolean NewShowExplosionFx returns nothing
        local integer this= s__MilimSpells__MilimRProjectileKS__allocate()

        set s__MilimSpells__MilimRProjectileKS_MUI_MilimRProjectile=s__MilimSpells__MilimRProjectileKS_MUI_MilimRProjectile + 1
        set s__MilimSpells__MilimRProjectileKS_m_MilimRProjectile[s__MilimSpells__MilimRProjectileKS_MUI_MilimRProjectile]=this
        set s__MilimSpells__MilimRProjectileKS_c[this]=NewC
        set s__MilimSpells__MilimRProjectileKS_startX[this]=NewStartX
        set s__MilimSpells__MilimRProjectileKS_startY[this]=NewStartY
        set s__MilimSpells__MilimRProjectileKS_targetX[this]=NewTargetX
        set s__MilimSpells__MilimRProjectileKS_targetY[this]=NewTargetY
        set s__MilimSpells__MilimRProjectileKS_currentX[this]=s__MilimSpells__MilimRProjectileKS_startX[this]
        set s__MilimSpells__MilimRProjectileKS_currentY[this]=s__MilimSpells__MilimRProjectileKS_startY[this]
        set s__MilimSpells__MilimRProjectileKS_a[this]=Atan2(s__MilimSpells__MilimRProjectileKS_targetY[this] - s__MilimSpells__MilimRProjectileKS_startY[this], s__MilimSpells__MilimRProjectileKS_targetX[this] - s__MilimSpells__MilimRProjectileKS_startX[this])
        set s__MilimSpells__MilimRProjectileKS_arcSide[this]=NewArcSide
        set s__MilimSpells__MilimRProjectileKS_arcSize[this]=NewArcSize
        set s__MilimSpells__MilimRProjectileKS_fly[this]=NewFly
        set s__MilimSpells__MilimRProjectileKS_r[this]=0.00
        set s__MilimSpells__MilimRProjectileKS_r2[this]=0.00
        set s__MilimSpells__MilimRProjectileKS_visionTick[this]=0.00
        set s__MilimSpells__MilimRProjectileKS_rmax[this]=NewDuration
        set s__MilimSpells__MilimRProjectileKS_dmg[this]=NewDamage
        set s__MilimSpells__MilimRProjectileKS_check[this]=0
        set s__MilimSpells__MilimRProjectileKS_g[this]=CreateGroup()
        set s__MilimSpells__MilimRProjectileKS_g2[this]=NewDamagedGroup
        set s__MilimSpells__MilimRProjectileKS_g3[this]=CreateGroup()
        set s__MilimSpells__MilimRProjectileKS_g4[this]=NewPushedGroup
        set s__MilimSpells__MilimRProjectileKS_showExplosionFx[this]=NewShowExplosionFx

        // ÇÀÒÛ×ÊÀ: ìîäåëü ëåòÿùåãî ñíàðÿäà. war3mapImported\.mdl
        set s__MilimSpells__MilimRProjectileKS_e[this]=EffectSpawn("war3mapImported\\wos_summon3missle_blue2.mdl" , s__MilimSpells__MilimRProjectileKS_startX[this] , s__MilimSpells__MilimRProjectileKS_startY[this] , ( s__MilimSpells__MilimRProjectileKS_a[this] + s__MilimSpells__MilimRProjectileKS_arcSide[this] * 90.00 * bj_DEGTORAD ) * bj_RADTODEG , 1.00 , 0.5 , s__MilimSpells__MilimRProjectileKS_fly[this])
        set s__MilimSpells__MilimRProjectileKS_e2[this]=EffectSpawn("war3mapImported\\wos_file00004263.mdl" , s__MilimSpells__MilimRProjectileKS_startX[this] , s__MilimSpells__MilimRProjectileKS_startY[this] , ( s__MilimSpells__MilimRProjectileKS_a[this] + s__MilimSpells__MilimRProjectileKS_arcSide[this] * 90.00 * bj_DEGTORAD ) * bj_RADTODEG , 1.00 , 2.75 , s__MilimSpells__MilimRProjectileKS_fly[this])

        if s__MilimSpells__MilimRProjectileKS_MUI_MilimRProjectile == 0 then
            call TimerStart(s__MilimSpells__MilimRProjectileKS_t_MilimRProjectile, 0.03, true, function s__MilimSpells__MilimRProjectileKS_Loop_MilimRProjectile)
        endif
    endfunction

// Îñíîâíàÿ ñòðóêòóðà: êàñò, íåóÿçâèìîñòü, ïàóçà è âûïóñê âñåõ ñíàðÿäîâ.



    function s__MilimSpells__MilimRKS_Loop_MilimR takes nothing returns nothing
        local integer this
        local integer i= 0
        local integer slotIndex
        local real releaseInterval
        local real releaseOffset
        local real slotWidth
        local real lateralOffset
        local real forwardOffset
        local real targetX
        local real targetY
        local real arcSide
        local real add= 90
        local real flightTime
        local boolean createExplosionFx

        loop
            exitwhen i > s__MilimSpells__MilimRKS_MUI_MilimR
            set this=s__MilimSpells__MilimRKS_m_MilimR[i]

            if SpellBoolCaster(s__MilimSpells__MilimRKS_c[this]) and s__MilimSpells__MilimRKS_launched[this] < s__MilimSpells__MilimRKS_MISSILE_COUNT then
                set s__MilimSpells__MilimRKS_r[this]=s__MilimSpells__MilimRKS_r[this] + 0.03
                call DebugUnit(s__MilimSpells__MilimRKS_c[this])
                if s__MilimSpells__MilimRKS_r[this] == 0.3 then
        set s__MilimSpells__MilimRKS_e[this]=EffectSpawnScale("war3mapImported\\wos_file00000739.mdl" , GetUnitX(s__MilimSpells__MilimRKS_c[this]) + add * Cos(s__MilimSpells__MilimRKS_a[this]) , GetUnitY(s__MilimSpells__MilimRKS_c[this]) + add * Sin(s__MilimSpells__MilimRKS_a[this]) , s__MilimSpells__MilimRKS_a[this] * bj_RADTODEG , 1.00 , 1.5 , 100.00 , 0.75 , 1 , 3.45)
        call BlzSetSpecialEffectAlpha(s__MilimSpells__MilimRKS_e[this], 150)
        set s__MilimSpells__MilimRKS_e2[this]=EffectSpawnScale("war3mapImported\\wos_ChuShou_BY_Wood_Effect_Glow_GuiPaiQiGong_XuLiblue.mdl" , GetUnitX(s__MilimSpells__MilimRKS_c[this]) + 90 * Cos(s__MilimSpells__MilimRKS_a[this]) , GetUnitY(s__MilimSpells__MilimRKS_c[this]) + 90 * Sin(s__MilimSpells__MilimRKS_a[this]) , s__MilimSpells__MilimRKS_a[this] * bj_RADTODEG , 1.00 , 1 , 100.00 , 0.75 , 1 , 2.5)
        set s__MilimSpells__MilimRKS_e3[this]=EffectSpawnScale("war3mapImported\\wos_xtyball2.mdx" , GetUnitX(s__MilimSpells__MilimRKS_c[this]) + add * Cos(s__MilimSpells__MilimRKS_a[this]) , GetUnitY(s__MilimSpells__MilimRKS_c[this]) + add * Sin(s__MilimSpells__MilimRKS_a[this]) , s__MilimSpells__MilimRKS_a[this] * bj_RADTODEG , 1.00 , 1 , 0.00 , 0.75 , 1 , 1.85)
        
                endif
                if s__MilimSpells__MilimRKS_r[this] > 0.3 then
                call BlzSetSpecialEffectPosition(s__MilimSpells__MilimRKS_e[this], GetUnitX(s__MilimSpells__MilimRKS_c[this]) + add * Cos(s__MilimSpells__MilimRKS_a[this]), GetUnitY(s__MilimSpells__MilimRKS_c[this]) + add * Sin(s__MilimSpells__MilimRKS_a[this]), 0.00)
                call BlzSetSpecialEffectPosition(s__MilimSpells__MilimRKS_e2[this], GetUnitX(s__MilimSpells__MilimRKS_c[this]) + add * Cos(s__MilimSpells__MilimRKS_a[this]), GetUnitY(s__MilimSpells__MilimRKS_c[this]) + add * Sin(s__MilimSpells__MilimRKS_a[this]), 165.00)
                endif
                set releaseInterval=s__MilimSpells__MilimRKS_MISSILE_RELEASE_WINDOW / I2R(s__MilimSpells__MilimRKS_MISSILE_COUNT - 1)
                set releaseOffset=I2R(s__MilimSpells__MilimRKS_launched[this]) * releaseInterval
                if s__MilimSpells__MilimRKS_r[this] == s__MilimSpells__MilimRKS_CAST_DELAY + releaseOffset then
                if IntegerCd(s__MilimSpells__MilimRKS_c[this] , "cd start" , 1.5) then
        call MakeSound("war3mapimported\\Hero_Milim_R 3")
        endif
        endif
                if s__MilimSpells__MilimRKS_r[this] >= s__MilimSpells__MilimRKS_CAST_DELAY + releaseOffset then
                    // Î÷åð¸äíîñòü 0, 5, 1, 4, 2, 3: ñíàðÿäû ÷åðåäóþòñÿ ñëåâà è ñïðàâà.
                    if ModuloInteger(s__MilimSpells__MilimRKS_launched[this], 2) == 0 then
                        set slotIndex=s__MilimSpells__MilimRKS_launched[this] / 2
                        set arcSide=1.00
                    else
                        set slotIndex=s__MilimSpells__MilimRKS_MISSILE_COUNT - 1 - s__MilimSpells__MilimRKS_launched[this] / 2
                        set arcSide=- 1.00
                    endif

                    // Ýôôåêòû ðàñïðåäåëåíû ïî âñåé øèðèíå ïðÿìîóãîëüíèêà:
                    // îáà êðàÿ, ïðèìåðíî 1/3 è 2/3 îáëàñòè. Äëÿ 10 ñíàðÿäîâ ýòî
                    // ñëîòû 0, 3, 6 è 9 — îíè ìàêñèìàëüíî óäàëåíû äðóã îò äðóãà.
                    set createExplosionFx=slotIndex == 0 or slotIndex == ( s__MilimSpells__MilimRKS_MISSILE_COUNT - 1 ) / 3 or slotIndex == ( s__MilimSpells__MilimRKS_MISSILE_COUNT - 1 ) * 2 / 3 or slotIndex == s__MilimSpells__MilimRKS_MISSILE_COUNT - 1

                    // Ïî îäíîé ñëó÷àéíîé òî÷êå â êàæäîé ïîëîñå ïðÿìîóãîëüíèêà RECT_WIDTH.
                    set slotWidth=s__MilimSpells__MilimRKS_RECT_WIDTH / I2R(s__MilimSpells__MilimRKS_MISSILE_COUNT)
                    set lateralOffset=- s__MilimSpells__MilimRKS_RECT_WIDTH * 0.50 + slotWidth * I2R(slotIndex) + GetRandomReal(0.00, slotWidth)
                    set forwardOffset=GetRandomReal(- s__MilimSpells__MilimRKS_RECT_DEPTH * 0.50, s__MilimSpells__MilimRKS_RECT_DEPTH * 0.50)
                    set targetX=s__MilimSpells__MilimRKS_x[this] + forwardOffset * Cos(s__MilimSpells__MilimRKS_a[this]) + lateralOffset * Cos(s__MilimSpells__MilimRKS_a[this] + 90.00 * bj_DEGTORAD)
                    set targetY=s__MilimSpells__MilimRKS_y[this] + forwardOffset * Sin(s__MilimSpells__MilimRKS_a[this]) + lateralOffset * Sin(s__MilimSpells__MilimRKS_a[this] + 90.00 * bj_DEGTORAD)

                    // ×åì ïîçæå âûëåòåë ñíàðÿä, òåì ìåíüøå âðåìÿ ïîë¸òà.
                    // Âñå øåñòü ïðèëåòàþò ïðèìåðíî â îäèí ìîìåíò.
                    set flightTime=s__MilimSpells__MilimRKS_MISSILE_MIN_FLIGHT_TIME + s__MilimSpells__MilimRKS_MISSILE_RELEASE_WINDOW - releaseOffset

                    // ÇÀÒÛ×ÊÀ: êîðîòêèé ýôôåêò ïðè âûïóñêå êàæäîãî ñíàðÿäà.
                    call DestroyEffect(EffectSpawn("war3mapImported\\wos_effect lvse-magic-shousuo blue.mdl" , GetUnitX(s__MilimSpells__MilimRKS_c[this]) + add * Cos(s__MilimSpells__MilimRKS_a[this]) , GetUnitY(s__MilimSpells__MilimRKS_c[this]) + add * Sin(s__MilimSpells__MilimRKS_a[this]) , GetRandomReal(0, 359) , 1.00 , 2.00 , 120.00))
                    call SaveInteger(hs, GetHandleId(s__MilimSpells__MilimRKS_g[this]), StringHash("MilimR projectiles left"), LoadInteger(hs, GetHandleId(s__MilimSpells__MilimRKS_g[this]), StringHash("MilimR projectiles left")) + 1)
                    call s__MilimSpells__MilimRProjectileKS_MilimRProjectile_Start(s__MilimSpells__MilimRKS_c[this] , GetUnitX(s__MilimSpells__MilimRKS_c[this]) + add * Cos(s__MilimSpells__MilimRKS_a[this]) , GetUnitY(s__MilimSpells__MilimRKS_c[this]) + add * Sin(s__MilimSpells__MilimRKS_a[this]) , targetX , targetY , arcSide , GetRandomReal(s__MilimSpells__MilimRKS_ARC_MIN, s__MilimSpells__MilimRKS_ARC_MAX) , GetUnitFlyHeight(s__MilimSpells__MilimRKS_c[this]) + GetRandomReal(110.00, 230.00) , flightTime , s__MilimSpells__MilimRKS_dmg[this] , s__MilimSpells__MilimRKS_g[this] , s__MilimSpells__MilimRKS_g2[this] , createExplosionFx)
                    set s__MilimSpells__MilimRKS_launched[this]=s__MilimSpells__MilimRKS_launched[this] + 1
                endif
            else
                call PauseUnit(s__MilimSpells__MilimRKS_c[this], false)
                call StopSpellUnit(s__MilimSpells__MilimRKS_c[this])
                call SetUnitTimeScale(s__MilimSpells__MilimRKS_c[this], 1.00)
                call DestroyEffect(s__MilimSpells__MilimRKS_e[this])
                call DestroyEffect(s__MilimSpells__MilimRKS_e2[this])
                call DestroyEffect(s__MilimSpells__MilimRKS_e3[this])
                if LoadInteger(hs, GetHandleId(s__MilimSpells__MilimRKS_g[this]), StringHash("MilimR projectiles left")) <= 0 then
                    call FlushChildHashtable(hs, GetHandleId(s__MilimSpells__MilimRKS_g[this]))
                    call DestroyGroup(s__MilimSpells__MilimRKS_g[this])
                    call DestroyGroup(s__MilimSpells__MilimRKS_g2[this])
                endif
                set s__MilimSpells__MilimRKS_e[this]=null
                set s__MilimSpells__MilimRKS_e2[this]=null
                set s__MilimSpells__MilimRKS_e3[this]=null
                set s__MilimSpells__MilimRKS_g[this]=null
                set s__MilimSpells__MilimRKS_g2[this]=null
                set s__MilimSpells__MilimRKS_c[this]=null

                set s__MilimSpells__MilimRKS_m_MilimR[i]=s__MilimSpells__MilimRKS_m_MilimR[s__MilimSpells__MilimRKS_MUI_MilimR]
                set s__MilimSpells__MilimRKS_MUI_MilimR=s__MilimSpells__MilimRKS_MUI_MilimR - 1
                if s__MilimSpells__MilimRKS_MUI_MilimR == - 1 then
                    call PauseTimer(s__MilimSpells__MilimRKS_t_MilimR)
                endif
                call s__MilimSpells__MilimRKS_deallocate(this)
                set i=i - 1
            endif

            set i=i + 1
        endloop
    endfunction

    function s__MilimSpells__MilimRKS_MilimR_Start takes unit NewC,real NewX,real NewY returns nothing
        local integer this= s__MilimSpells__MilimRKS__allocate()

        set s__MilimSpells__MilimRKS_MUI_MilimR=s__MilimSpells__MilimRKS_MUI_MilimR + 1
        set s__MilimSpells__MilimRKS_m_MilimR[s__MilimSpells__MilimRKS_MUI_MilimR]=this
        set s__MilimSpells__MilimRKS_c[this]=NewC
        set s__MilimSpells__MilimRKS_x[this]=NewX
        set s__MilimSpells__MilimRKS_y[this]=NewY
        set s__MilimSpells__MilimRKS_a[this]=GAngle2(s__MilimSpells__MilimRKS_c[this] , s__MilimSpells__MilimRKS_x[this] , s__MilimSpells__MilimRKS_y[this])
        set s__MilimSpells__MilimRKS_r[this]=0.00
        set s__MilimSpells__MilimRKS_launched[this]=0

        // Ëþáîé þíèò ïîëó÷àåò ýòîò ïîëíûé óðîí òîëüêî îò ïåðâîãî ïîïàâøåãî ñíàðÿäà.
        set s__MilimSpells__MilimRKS_dmg[this]=GetHeroAgi(s__MilimSpells__MilimRKS_c[this], true) * ( MilimR_DamageAgiBase + MilimR_DamageAgiStep * ( GetUnitAbilityLevel(s__MilimSpells__MilimRKS_c[this], MilimR_ID) - 1 ) )
        if LoadInteger(hs, GetHandleId(s__MilimSpells__MilimRKS_c[this]), StringHash("mode t")) == 1 then
            set s__MilimSpells__MilimRKS_dmg[this]=s__MilimSpells__MilimRKS_dmg[this] + MilimT_DmgAdd * GetHeroAgi(s__MilimSpells__MilimRKS_c[this], true)
        endif
        set s__MilimSpells__MilimRKS_g[this]=CreateGroup()
        set s__MilimSpells__MilimRKS_g2[this]=CreateGroup()
        call SaveInteger(hs, GetHandleId(s__MilimSpells__MilimRKS_g[this]), StringHash("MilimR projectiles left"), 0)

        call SaveInteger(hs, GetHandleId(GetOwningPlayer(s__MilimSpells__MilimRKS_c[this])), StringHash(I2S(MilimR_ID)), 0)
        call StartSpellUnit(s__MilimSpells__MilimRKS_c[this])
        call SetUnitAnimationByIndex(s__MilimSpells__MilimRKS_c[this], 7)
        call MakeSound("war3mapimported\\Hero_Milim_R 1")
        call MakeSound("war3mapimported\\Hero_Milim_R 2")
        // ÇÀÒÛ×ÊÀ: ýôôåêò ïîäãîòîâêè ê âûïóñêó ñíàðÿäîâ.

        if s__MilimSpells__MilimRKS_MUI_MilimR == 0 then
            call TimerStart(s__MilimSpells__MilimRKS_t_MilimR, 0.03, true, function s__MilimSpells__MilimRKS_Loop_MilimR)
        endif
    endfunction



        function s__MilimSpells__MilimTKS_Loop_MilimT takes nothing returns nothing
