                exitwhen i > s__AstaSpells___AstaSpells_F_MUI_AstaF
                set this=s__AstaSpells___AstaSpells_F_m_AstaF[i]
                if SpellBool(s__AstaSpells___AstaSpells_F_c[this]) and s__AstaSpells___AstaSpells_F_r[this] <= s__AstaSpells___AstaSpells_F_rmax[this] then
                    set s__AstaSpells___AstaSpells_F_r[this]=RoundReal(s__AstaSpells___AstaSpells_F_r[this] + 0.03 , 3)
                    set s__AstaSpells___AstaSpells_F_x[this]=GetUnitX(s__AstaSpells___AstaSpells_F_c[this])
                    set s__AstaSpells___AstaSpells_F_y[this]=GetUnitY(s__AstaSpells___AstaSpells_F_c[this])
