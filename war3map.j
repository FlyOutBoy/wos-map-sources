                call BlzFrameSetSize(s___OkarunSpells___OkarunF_KS_frame_pas4[s__OkarunSpells___OkarunF_KS_frame_pas4[this]+s__OkarunSpells___OkarunF_KS_k2[this]], 0.03, 0.03)
                call BlzFrameSetTexture(s___OkarunSpells___OkarunF_KS_frame_pas4[s__OkarunSpells___OkarunF_KS_frame_pas4[this]+s__OkarunSpells___OkarunF_KS_k2[this]], "ReplaceableTextures\\CommandButtons\\BTNHero_Okarun_F", 0, false)
                set s___OkarunSpells___OkarunF_KS_frame_pas5[s__OkarunSpells___OkarunF_KS_frame_pas5[this]+s__OkarunSpells___OkarunF_KS_k2[this]]=BlzCreateFrameByType("TEXT", "MyPlayerName", s___OkarunSpells___OkarunF_KS_frame_pas1[s__OkarunSpells___OkarunF_KS_frame_pas1[this]+s__OkarunSpells___OkarunF_KS_k2[this]], "", 0)
                call BlzFrameSetAbsPoint(s___OkarunSpells___OkarunF_KS_frame_pas5[s__OkarunSpells___OkarunF_KS_frame_pas5[this]+s__OkarunSpells___OkarunF_KS_k2[this]], FRAMEPOINT_CENTER, 0.07, 0.185)
                call BlzFrameSetText(s___OkarunSpells___OkarunF_KS_frame_pas5[s__OkarunSpells___OkarunF_KS_frame_pas5[this]+s__OkarunSpells___OkarunF_KS_k2[this]], "|c00FFFF00Current speed:|r")
                call BlzFrameSetScale(s___OkarunSpells___OkarunF_KS_frame_pas5[s__OkarunSpells___OkarunF_KS_frame_pas5[this]+s__OkarunSpells___OkarunF_KS_k2[this]], 0.9)
                set s___OkarunSpells___OkarunF_KS_frame_pas6[s__OkarunSpells___OkarunF_KS_frame_pas6[this]+s__OkarunSpells___OkarunF_KS_k2[this]]=BlzCreateFrameByType("TEXT", "MyPlayerName", s___OkarunSpells___OkarunF_KS_frame_pas1[s__OkarunSpells___OkarunF_KS_frame_pas1[this]+s__OkarunSpells___OkarunF_KS_k2[this]], "", 0)
                call BlzFrameSetAbsPoint(s___OkarunSpells___OkarunF_KS_frame_pas6[s__OkarunSpells___OkarunF_KS_frame_pas6[this]+s__OkarunSpells___OkarunF_KS_k2[this]], FRAMEPOINT_CENTER, 0.07, 0.17)
                call BlzFrameSetText(s___OkarunSpells___OkarunF_KS_frame_pas6[s__OkarunSpells___OkarunF_KS_frame_pas6[this]+s__OkarunSpells___OkarunF_KS_k2[this]], "|c00FFFF00" + R2SW(Test_real, 0, 2) + "|r")
                call BlzFrameSetScale(s___OkarunSpells___OkarunF_KS_frame_pas6[s__OkarunSpells___OkarunF_KS_frame_pas6[this]+s__OkarunSpells___OkarunF_KS_k2[this]], 0.9)
            else
                if GetLocalPlayer() == GetOwningPlayer(s__OkarunSpells___OkarunF_KS_c[this]) then
                    call BlzFrameSetVisible(s___OkarunSpells___OkarunF_KS_frame_pas1[s__OkarunSpells___OkarunF_KS_frame_pas1[this]+s__OkarunSpells___OkarunF_KS_k2[this]], true)
                endif
                call BlzFrameSetValue(s___OkarunSpells___OkarunF_KS_frame_pas3[s__OkarunSpells___OkarunF_KS_frame_pas3[this]+s__OkarunSpells___OkarunF_KS_k2[this]], s__OkarunSpells___OkarunF_KS_r2[this])
