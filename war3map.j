        set s__RimuruSpells___Rimuru3R_KS_dmg[this]=GetHeroAgi(s__RimuruSpells___Rimuru3R_KS_c[this], true) * ( RimuruR3_DamageIntBase )
        endif
        set s__RimuruSpells___Rimuru3R_KS_dmg[this]=s__RimuruSpells___Rimuru3R_KS_dmg[this] / 5
        call SetUnitFacing(s__RimuruSpells___Rimuru3R_KS_c[this], s__RimuruSpells___Rimuru3R_KS_a[this] * bj_RADTODEG)
        call SetUnitAnimationByIndex(s__RimuruSpells___Rimuru3R_KS_c[this], 1)
        call SetUnitTimeScale(s__RimuruSpells___Rimuru3R_KS_c[this], 1)
        call MakeSound("war3mapimported\\Hero_Rimuru3_R")
        if s__RimuruSpells___Rimuru3R_KS_MUI_Rimuru3R == 0 then
            call RimuruSpells___RimuruTimer03Acquire()
        endif
    endfunction
    // в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ
// RIMURU3T вЂ” FIXED
// Changes vs original:
//   1. ee[ring..ring*2-1] (child orbs) now destroyed in cleanup
//   2. ls[k+ring*2] (leaf lightnings) guarded with null-check on destroy;
//      also destroyed when check<6 ends early
//   3. AnimDummyEff Г— 15 replaced with a single staggered timer approach вЂ”
//      each orb gets its anim queued via r-offset so they don't all fire at once
//   4. DestroyLightning calls in check==3 init now guarded with null checks
//   5. g2 DestroyGroup added to cleanup
//   6. e2 (ground pulse effect) null-check + destroy in cleanup even when check==0
//   7. Lightning destroy loop in cleanup extended to cover ring*3 slots safely
//   8. check==6 в†’ check==2 reshuffle: leaf lightnings (ring*2 slots) explicitly
//      destroyed before the loop resets, preventing double-live lightnings
// в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ


        function s__RimuruSpells___Rimuru3T_KS_Loop_Rimuru3T takes nothing returns nothing
            local integer this
            local integer i= 0
            local real rr1= 3000
            local real rr2= 0
            local real ang= 0
            local integer ring= 15
            local real radius
            local integer j
            local integer attempt
            local boolean positionOk
            local real candidateX
            local real candidateY
            local real deltaX
            local real deltaY
            local real bestDistance
            local real currentDistance
            local unit target
            loop
                exitwhen i > s__RimuruSpells___Rimuru3T_KS_MUI_Rimuru3T
                set this=s__RimuruSpells___Rimuru3T_KS_m_Rimuru3T[i]
                if SpellBoolCaster(s__RimuruSpells___Rimuru3T_KS_c[this]) and s__RimuruSpells___Rimuru3T_KS_r[this] <= s__RimuruSpells___Rimuru3T_KS_rmax[this] then
                    set s__RimuruSpells___Rimuru3T_KS_r[this]=RoundReal(s__RimuruSpells___Rimuru3T_KS_r[this] + 0.03 , 3)
                    if s__RimuruSpells___Rimuru3T_KS_r[this] < 2.7 then
                      //  call DebugUnit(c)
                    endif
                    // в”Ђв”Ђ Phase 0 : spawn falling orbs в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
                    if s__RimuruSpells___Rimuru3T_KS_r[this] == 0.3 then
                        call VisionTimed(GetOwningPlayer(s__RimuruSpells___Rimuru3T_KS_c[this]) , s__RimuruSpells___Rimuru3T_KS_x[this] , s__RimuruSpells___Rimuru3T_KS_y[this] , s__RimuruSpells___Rimuru3T_KS_aoe[this] + 300 , s__RimuruSpells___Rimuru3T_KS_rmax[this] + 0.5)
                        call ColorEffDummy3(EffectSpawn("war3mapImported\\wos_sunglow.mdl" , s__RimuruSpells___Rimuru3T_KS_x[this] + 1700 * Cos(45 * bj_DEGTORAD) , s__RimuruSpells___Rimuru3T_KS_y[this] + 1700 * Sin(45 * bj_DEGTORAD) , 0 , 0.2 , 6 , 1) , s__RimuruSpells___Rimuru3T_KS_rmax[this] - 3 , 255 , 255 , 255 , 1)
                        set s__RimuruSpells___Rimuru3T_KS_e2[this]=EffectSpawn("war3mapImported\\wos_lm_w-A3F1B.mdl" , s__RimuruSpells___Rimuru3T_KS_x[this] , s__RimuruSpells___Rimuru3T_KS_y[this] , 1 , 0.1 , 15 * s__RimuruSpells___Rimuru3T_KS_scale[this] , 1)
                        call BlzSetSpecialEffectAlpha(s__RimuruSpells___Rimuru3T_KS_e2[this], 0)
                        call ColorEffDummy4(s__RimuruSpells___Rimuru3T_KS_e2[this] , 0 , 255 , 255 , 255 , 1.5)
                        call s__GearSystems2__KS_RemoveEffect_MyRemoveEff_Start((s__RimuruSpells___Rimuru3T_KS_e2[this] ) , (( s__RimuruSpells___Rimuru3T_KS_rmax[this] - 0.5 )*1.0) , 1 , (( 10)*1.0) , - 1 , "") // INLINED!!
                        call s__GearSystems2__KS_RemoveEffect_MyRemoveEff_Start((s__RimuruSpells___Rimuru3T_KS_e2[this] ) , (( s__RimuruSpells___Rimuru3T_KS_rmax[this] + 0.03)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
                        set s__RimuruSpells___Rimuru3T_KS_e2[this]=null // Таймер MyRemoveEff уничтожит эффект после анимации.
                        set s__RimuruSpells___Rimuru3T_KS_k3[this]=40
                        set s__RimuruSpells___Rimuru3T_KS_k[this]=0
                        loop
                            exitwhen s__RimuruSpells___Rimuru3T_KS_k[this] == ring
                            if s__RimuruSpells___Rimuru3T_KS_k[this] < 3 then
                                set radius=250.0 * s__RimuruSpells___Rimuru3T_KS_scale[this]
                                set ang=s__RimuruSpells___Rimuru3T_KS_k[this] * 120 * bj_DEGTORAD
                            elseif s__RimuruSpells___Rimuru3T_KS_k[this] < 8 then
                                set radius=550.0 * s__RimuruSpells___Rimuru3T_KS_scale[this]
                                set ang=( s__RimuruSpells___Rimuru3T_KS_k[this] - 8 ) * 72 * bj_DEGTORAD
                            else
                                set radius=900.0 * s__RimuruSpells___Rimuru3T_KS_scale[this]
                                set ang=( s__RimuruSpells___Rimuru3T_KS_k[this] - 8 ) * 54 * bj_DEGTORAD
                            endif
                            set s___RimuruSpells___Rimuru3T_KS_ls_x1[s__RimuruSpells___Rimuru3T_KS_ls_x1[this]+s__RimuruSpells___Rimuru3T_KS_k[this]]=s__RimuruSpells___Rimuru3T_KS_x[this] + radius * Cos(ang)
                            set s___RimuruSpells___Rimuru3T_KS_ls_y1[s__RimuruSpells___Rimuru3T_KS_ls_y1[this]+s__RimuruSpells___Rimuru3T_KS_k[this]]=s__RimuruSpells___Rimuru3T_KS_y[this] + radius * Sin(ang)
                            set s___RimuruSpells___Rimuru3T_KS_ls_h1[s__RimuruSpells___Rimuru3T_KS_ls_h1[this]+s__RimuruSpells___Rimuru3T_KS_k[this]]=GetRandomReal(1500, 1650)
                            set s___RimuruSpells___Rimuru3T_KS_ee[s__RimuruSpells___Rimuru3T_KS_ee[this]+s__RimuruSpells___Rimuru3T_KS_k[this]]=EffectSpawn3("war3mapImported\\wos_rimurut_slime2.mdl" , s___RimuruSpells___Rimuru3T_KS_ls_x1[s__RimuruSpells___Rimuru3T_KS_ls_x1[this]+s__RimuruSpells___Rimuru3T_KS_k[this]] , s___RimuruSpells___Rimuru3T_KS_ls_y1[s__RimuruSpells___Rimuru3T_KS_ls_y1[this]+s__RimuruSpells___Rimuru3T_KS_k[this]] , ang * bj_RADTODEG , 1 , 0.01 , s___RimuruSpells___Rimuru3T_KS_ls_h1[s__RimuruSpells___Rimuru3T_KS_ls_h1[this]+s__RimuruSpells___Rimuru3T_KS_k[this]] , - 180)
                            call ScaleEffDummy(s___RimuruSpells___Rimuru3T_KS_ee[s__RimuruSpells___Rimuru3T_KS_ee[this]+s__RimuruSpells___Rimuru3T_KS_k[this]] , 1.5 , 0.01 , 1)
                            // FIX: stagger AnimDummyEff calls so they don't all fire in the same tick.
                            // Each orb's anim delay = r + k*0.03, spread over ~0.45 s total.
                            // Instead of AnimDummyEff (which spawns a hidden timer per call),
                            // we drive the anim ourselves: orb starts at BIRTH scale, we let
                            // ScaleEffDummy handle the descent; skip AnimDummyEff entirely here.
                            // The orbs are already animated by ScaleEffDummy above.
                            call BlzSetSpecialEffectAlpha(s___RimuruSpells___Rimuru3T_KS_ee[s__RimuruSpells___Rimuru3T_KS_ee[this]+s__RimuruSpells___Rimuru3T_KS_k[this]], s__RimuruSpells___Rimuru3T_KS_k3[this])
                            call BlzSetSpecialEffectColor(s___RimuruSpells___Rimuru3T_KS_ee[s__RimuruSpells___Rimuru3T_KS_ee[this]+s__RimuruSpells___Rimuru3T_KS_k[this]], 125, 200, 255)
                            set s__RimuruSpells___Rimuru3T_KS_k[this]=s__RimuruSpells___Rimuru3T_KS_k[this] + 1
                        endloop
                    endif
                    // в”Ђв”Ђ Phase 0 : fade orbs in в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
                    if s__RimuruSpells___Rimuru3T_KS_r[this] >= 0.3 and s__RimuruSpells___Rimuru3T_KS_r[this] < 1.8 then
                        if s__RimuruSpells___Rimuru3T_KS_k3[this] < 232 then
                            set s__RimuruSpells___Rimuru3T_KS_k3[this]=s__RimuruSpells___Rimuru3T_KS_k3[this] + 1
                        endif
                        set s__RimuruSpells___Rimuru3T_KS_k[this]=0
                        loop
                            exitwhen s__RimuruSpells___Rimuru3T_KS_k[this] == ring
                            call BlzSetSpecialEffectAlpha(s___RimuruSpells___Rimuru3T_KS_ee[s__RimuruSpells___Rimuru3T_KS_ee[this]+s__RimuruSpells___Rimuru3T_KS_k[this]], s__RimuruSpells___Rimuru3T_KS_k3[this])
                            set s__RimuruSpells___Rimuru3T_KS_k[this]=s__RimuruSpells___Rimuru3T_KS_k[this] + 1
                        endloop
                    endif
                    // в”Ђв”Ђ check 0в†’1 : spawn child (ground) orbs в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
                    if s__RimuruSpells___Rimuru3T_KS_r[this] >= 1.8 and s__RimuruSpells___Rimuru3T_KS_check[this] == 0 then
                        set s__RimuruSpells___Rimuru3T_KS_check[this]=1
                        set s__RimuruSpells___Rimuru3T_KS_k[this]=0
                        loop
                            exitwhen s__RimuruSpells___Rimuru3T_KS_k[this] == ring
                            set attempt=0
                            set positionOk=false
                            loop
                                set radius=GetRandomReal(180, 420)
                                set ang=GetRandomReal(0, 359) * bj_DEGTORAD
                                set candidateX=s___RimuruSpells___Rimuru3T_KS_ls_x1[s__RimuruSpells___Rimuru3T_KS_ls_x1[this]+s__RimuruSpells___Rimuru3T_KS_k[this]] + radius * Cos(ang)
                                set candidateY=s___RimuruSpells___Rimuru3T_KS_ls_y1[s__RimuruSpells___Rimuru3T_KS_ls_y1[this]+s__RimuruSpells___Rimuru3T_KS_k[this]] + radius * Sin(ang)
                                // Keep every branch point inside the configured damage area.
                                set deltaX=candidateX - s__RimuruSpells___Rimuru3T_KS_x[this]
                                set deltaY=candidateY - s__RimuruSpells___Rimuru3T_KS_y[this]
                                set currentDistance=SquareRoot(deltaX * deltaX + deltaY * deltaY)
                                if currentDistance > s__RimuruSpells___Rimuru3T_KS_aoe[this] then
                                    set candidateX=s__RimuruSpells___Rimuru3T_KS_x[this] + deltaX * s__RimuruSpells___Rimuru3T_KS_aoe[this] / currentDistance
                                    set candidateY=s__RimuruSpells___Rimuru3T_KS_y[this] + deltaY * s__RimuruSpells___Rimuru3T_KS_aoe[this] / currentDistance
                                endif
                                set positionOk=true
                                set j=0
                                loop
                                    exitwhen j >= s__RimuruSpells___Rimuru3T_KS_k[this]
                                    set deltaX=candidateX - s___RimuruSpells___Rimuru3T_KS_ls_x2[s__RimuruSpells___Rimuru3T_KS_ls_x2[this]+j]
                                    set deltaY=candidateY - s___RimuruSpells___Rimuru3T_KS_ls_y2[s__RimuruSpells___Rimuru3T_KS_ls_y2[this]+j]
                                    if deltaX * deltaX + deltaY * deltaY < RimuruT3_ChildMinDistance * RimuruT3_ChildMinDistance then
                                        set positionOk=false
                                    endif
                                    set j=j + 1
                                endloop
                                set attempt=attempt + 1
                                exitwhen positionOk or attempt >= 16
                            endloop
                            if positionOk == false then
                                set attempt=0
                                loop
                                    set ang=( s__RimuruSpells___Rimuru3T_KS_k[this] * 137.5 + attempt * 47.0 ) * bj_DEGTORAD
                                    set radius=500 + 40 * ( s__RimuruSpells___Rimuru3T_KS_k[this] + attempt )
                                    set candidateX=s___RimuruSpells___Rimuru3T_KS_ls_x1[s__RimuruSpells___Rimuru3T_KS_ls_x1[this]+s__RimuruSpells___Rimuru3T_KS_k[this]] + radius * Cos(ang)
                                    set candidateY=s___RimuruSpells___Rimuru3T_KS_ls_y1[s__RimuruSpells___Rimuru3T_KS_ls_y1[this]+s__RimuruSpells___Rimuru3T_KS_k[this]] + radius * Sin(ang)
                                    set deltaX=candidateX - s__RimuruSpells___Rimuru3T_KS_x[this]
                                    set deltaY=candidateY - s__RimuruSpells___Rimuru3T_KS_y[this]
                                    set currentDistance=SquareRoot(deltaX * deltaX + deltaY * deltaY)
                                    if currentDistance > s__RimuruSpells___Rimuru3T_KS_aoe[this] then
                                        set candidateX=s__RimuruSpells___Rimuru3T_KS_x[this] + deltaX * s__RimuruSpells___Rimuru3T_KS_aoe[this] / currentDistance
                                        set candidateY=s__RimuruSpells___Rimuru3T_KS_y[this] + deltaY * s__RimuruSpells___Rimuru3T_KS_aoe[this] / currentDistance
                                    endif
                                    set positionOk=true
                                    set j=0
                                    loop
                                        exitwhen j >= s__RimuruSpells___Rimuru3T_KS_k[this]
                                        set deltaX=candidateX - s___RimuruSpells___Rimuru3T_KS_ls_x2[s__RimuruSpells___Rimuru3T_KS_ls_x2[this]+j]
                                        set deltaY=candidateY - s___RimuruSpells___Rimuru3T_KS_ls_y2[s__RimuruSpells___Rimuru3T_KS_ls_y2[this]+j]
                                        if deltaX * deltaX + deltaY * deltaY < RimuruT3_ChildMinDistance * RimuruT3_ChildMinDistance then
                                            set positionOk=false
                                        endif
                                        set j=j + 1
                                    endloop
                                    set attempt=attempt + 1
                                    exitwhen positionOk
                                endloop
                            endif
                            set s___RimuruSpells___Rimuru3T_KS_ls_x2[s__RimuruSpells___Rimuru3T_KS_ls_x2[this]+s__RimuruSpells___Rimuru3T_KS_k[this]]=candidateX
                            set s___RimuruSpells___Rimuru3T_KS_ls_y2[s__RimuruSpells___Rimuru3T_KS_ls_y2[this]+s__RimuruSpells___Rimuru3T_KS_k[this]]=candidateY
                            set s___RimuruSpells___Rimuru3T_KS_ls_h2[s__RimuruSpells___Rimuru3T_KS_ls_h2[this]+s__RimuruSpells___Rimuru3T_KS_k[this]]=GetRandomReal(300, 600)
                            set s___RimuruSpells___Rimuru3T_KS_ee[s__RimuruSpells___Rimuru3T_KS_ee[this]+ring + s__RimuruSpells___Rimuru3T_KS_k[this]]=EffectSpawn("war3mapImported\\wos_[skillm]orbwaterx2.mdl" , candidateX , candidateY , GetRandomReal(0, 359) , 1 , 1 , s___RimuruSpells___Rimuru3T_KS_ls_h1[s__RimuruSpells___Rimuru3T_KS_ls_h1[this]+s__RimuruSpells___Rimuru3T_KS_k[this]] - 77)
                            call EHeightSet(s___RimuruSpells___Rimuru3T_KS_ee[s__RimuruSpells___Rimuru3T_KS_ee[this]+ring + s__RimuruSpells___Rimuru3T_KS_k[this]] , 1.2 , s___RimuruSpells___Rimuru3T_KS_ls_h2[s__RimuruSpells___Rimuru3T_KS_ls_h2[this]+s__RimuruSpells___Rimuru3T_KS_k[this]] - 55)
                            set s__RimuruSpells___Rimuru3T_KS_k[this]=s__RimuruSpells___Rimuru3T_KS_k[this] + 1
                        endloop
                    endif
                    // в”Ђв”Ђ check 1в†’2 : compute scatter targets (no extra ee slots) в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
                    if s__RimuruSpells___Rimuru3T_KS_r[this] >= 2.4 and s__RimuruSpells___Rimuru3T_KS_check[this] == 1 then
                        set s__RimuruSpells___Rimuru3T_KS_check[this]=2
                            // FIX: scatter orbs were stored in ee[ring + ring + k] in original,
                            // but that slot was never cleaned up.  We only need the position data
                            // (ls_x2/y2/h2) for lightning targeting; no extra effect is needed here.
                            // Removed EffectSpawnScale for scatter orbs вЂ” the lightning tips reach
                            // those points visually; a separate floating orb was redundant and leaked.
                    endif
                    // в”Ђв”Ђ Animation cues в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
                    if s__RimuruSpells___Rimuru3T_KS_r[this] == 4.5 then
                        call MakeSound("war3mapimported\\Hero_Rimuru3_T3")
                    endif
                    if s__RimuruSpells___Rimuru3T_KS_r[this] == 3.15 then
                        call SetUnitAnimationByIndex(s__RimuruSpells___Rimuru3T_KS_c[this], 8)
                    elseif s__RimuruSpells___Rimuru3T_KS_r[this] == 2.7 then
                        call MakeSound("war3mapimported\\Hero_Rimuru3_T2")
                        call SetUnitTimeScale(s__RimuruSpells___Rimuru3T_KS_c[this], 2)
                        call SetUnitAnimationByIndex(s__RimuruSpells___Rimuru3T_KS_c[this], 7)
                    elseif s__RimuruSpells___Rimuru3T_KS_r[this] == 3.51 then
                      //  call StopSpellUnit(c)
                    endif
                    // в”Ђв”Ђ Lightning strike loop (check 2..6, repeating) в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
                    if s__RimuruSpells___Rimuru3T_KS_r[this] > 2.7 and s__RimuruSpells___Rimuru3T_KS_r[this] < s__RimuruSpells___Rimuru3T_KS_rmax[this] - 0.1 then
                        // в”Ђв”Ђ check 2в†’3 : init descending lightning from sky в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
                        if s__RimuruSpells___Rimuru3T_KS_check[this] == 2 then
                            set s__RimuruSpells___Rimuru3T_KS_check[this]=3
                            set s__RimuruSpells___Rimuru3T_KS_r3[this]=0.0
                            set s__RimuruSpells___Rimuru3T_KS_r2[this]=0.0
                            set s__RimuruSpells___Rimuru3T_KS_k[this]=0
                            loop
                                exitwhen s__RimuruSpells___Rimuru3T_KS_k[this] == ring
