            endif
            if HasCachedItem(s__GearSystems2__KS_FakeCooldown_c[this] , 'I011') > 0 and BlzGetUnitIntegerField(s__GearSystems2__KS_FakeCooldown_c[this], UNIT_IF_PRIMARY_ATTRIBUTE) == 2 then
             call BlzStartUnitAbilityCooldown(s__GearSystems2__KS_FakeCooldown_c[this], s__GearSystems2__KS_FakeCooldown_k3[this], s__GearSystems2__KS_FakeCooldown_r4[this] * ( 1 - OkarunEggReduceCD / 100 ))
            else
             call BlzStartUnitAbilityCooldown(s__GearSystems2__KS_FakeCooldown_c[this], s__GearSystems2__KS_FakeCooldown_k3[this], s__GearSystems2__KS_FakeCooldown_r4[this])
            endif
