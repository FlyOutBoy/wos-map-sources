        function s__AstaSpells___AstaSpells_Q_AstaQ_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__AstaSpells___AstaSpells_Q__allocate()
            local integer level= GetUnitAbilityLevel(NewC, AstaQ_ID)
            if level < 1 then
                set level=1
            endif
            set s__AstaSpells___AstaSpells_Q_MUI_AstaQ=s__AstaSpells___AstaSpells_Q_MUI_AstaQ + 1
            set s__AstaSpells___AstaSpells_Q_m_AstaQ[s__AstaSpells___AstaSpells_Q_MUI_AstaQ]=this
            set s__AstaSpells___AstaSpells_Q_c[this]=NewC
            set s__AstaSpells___AstaSpells_Q_x[this]=NewX
            set s__AstaSpells___AstaSpells_Q_y[this]=NewY
            set s__AstaSpells___AstaSpells_Q_r[this]=0.0
            set s__AstaSpells___AstaSpells_Q_r5[this]=0.0
            set s__AstaSpells___AstaSpells_Q_r6[this]=AstaQ_RangeBase + AstaQ_RangeStep * ( level - 1 )
            set s__AstaSpells___AstaSpells_Q_r2[this]=1.0
            set s__AstaSpells___AstaSpells_Q_g[this]=CreateGroup()
            set s__AstaSpells___AstaSpells_Q_g2[this]=CreateGroup()
            call StartSpellUnit2(s__AstaSpells___AstaSpells_Q_c[this])
            set s__AstaSpells___AstaSpells_Q_u[this]=null
            set s__AstaSpells___AstaSpells_Q_a[this]=GAngle2(s__AstaSpells___AstaSpells_Q_c[this] , s__AstaSpells___AstaSpells_Q_x[this] , s__AstaSpells___AstaSpells_Q_y[this])
            set s__AstaSpells___AstaSpells_Q_rmax[this]=AstaQ_CastTime + AstaQ_Duration
            set s__AstaSpells___AstaSpells_Q_move[this]=80.0
            set s__AstaSpells___AstaSpells_Q_aoe[this]=AstaQ_DamageAoe
            set s__AstaSpells___AstaSpells_Q_dmg[this]=GetHeroAgi(s__AstaSpells___AstaSpells_Q_c[this], true) * ( AstaQ_DamageAgiBase + AstaQ_DamageAgiStep * ( level - 1 ) ) + AstaQ_Damage2StaticBase + AstaQ_Damage2StaticStep * ( level - 1 )
            call SetUnitFacing(s__AstaSpells___AstaSpells_Q_c[this], s__AstaSpells___AstaSpells_Q_a[this] * bj_RADTODEG)
            call SetUnitAnimationByIndex(s__AstaSpells___AstaSpells_Q_c[this], 3)
            call SetUnitTimeScale(s__AstaSpells___AstaSpells_Q_c[this], 0.7)
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_OPm (434)3small.mdl" , GetUnitX(s__AstaSpells___AstaSpells_Q_c[this]) , GetUnitY(s__AstaSpells___AstaSpells_Q_c[this]) , 0 , 1.5 , 1.15 , 120))
            call MakeSound("war3mapimported\\Hero_Asta_Q")
            if s__AstaSpells___AstaSpells_Q_MUI_AstaQ == 0 then
                call AstaSpells___AstaTimer03Acquire()
            endif
        endfunction

