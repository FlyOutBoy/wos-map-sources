            set s__KenjakuSpells__KenjakuQ_KS_dmg[this]=s__KenjakuSpells__KenjakuQ_KS_dmg[this] + GetHeroInt(s__KenjakuSpells__KenjakuQ_KS_c[this], true) * ( KenjakuQ_HealIntBase + ( KenjakuQ_HealIntStep * ( GetUnitAbilityLevel(s__KenjakuSpells__KenjakuQ_KS_c[this], KenjakuQ_ID) - 1 ) ) )
            if GetHeroLevel(s__KenjakuSpells__KenjakuQ_KS_c[this]) >= 25 then
            set s__KenjakuSpells__KenjakuQ_KS_dmg[this]=s__KenjakuSpells__KenjakuQ_KS_dmg[this] + ( KenjakuQ_HealInt25lvlBonus * GetHeroInt(s__KenjakuSpells__KenjakuQ_KS_c[this], true) )
            set s__KenjakuSpells__KenjakuQ_KS_r4[this]=s__KenjakuSpells__KenjakuQ_KS_r4[this] + KenjakuQ_Reduce25lvlBonusQ3W3E3_CD
            endif
            call ReduceCooldown(s__KenjakuSpells__KenjakuQ_KS_c[this] , KenjakuQ3_ID , s__KenjakuSpells__KenjakuQ_KS_r4[this])
            call ReduceCooldown(s__KenjakuSpells__KenjakuQ_KS_c[this] , KenjakuW3_ID , s__KenjakuSpells__KenjakuQ_KS_r4[this])
            call ReduceCooldown(s__KenjakuSpells__KenjakuQ_KS_c[this] , KenjakuE3_ID , s__KenjakuSpells__KenjakuQ_KS_r4[this])
            call ReduceCooldown(s__KenjakuSpells__KenjakuQ_KS_c[this] , KenjakuQ2_ID , s__KenjakuSpells__KenjakuQ_KS_r4[this])
            call ReduceCooldown(s__KenjakuSpells__KenjakuQ_KS_c[this] , KenjakuW2_ID , s__KenjakuSpells__KenjakuQ_KS_r4[this])
            call ReduceCooldown(s__KenjakuSpells__KenjakuQ_KS_c[this] , KenjakuE2_ID , s__KenjakuSpells__KenjakuQ_KS_r4[this])
           set s__KenjakuSpells__KenjakuQ_KS_rmax[this]=KenjakuQ_Duration + 0.15
            set s__KenjakuSpells__KenjakuQ_KS_r3[this]=KenjakuQ_HealPeriodic
