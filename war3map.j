            set s__ErzaWSpells__Erza2R_KS_r2[this]=10
            set s__ErzaWSpells__Erza2R_KS_r3[this]=10
            set s__ErzaWSpells__Erza2R_KS_g[this]=CreateGroup()
            set s__ErzaWSpells__Erza2R_KS_g2[this]=CreateGroup()
            call StartSpellUnit2(s__ErzaWSpells__Erza2R_KS_c[this])
            set s__ErzaWSpells__Erza2R_KS_dmg[this]=GetHeroAgi(s__ErzaWSpells__Erza2R_KS_c[this], true) * ( Erza2R_DamageAgiBase + ( Erza2R_DamageAgiStep * ( GetUnitAbilityLevel(s__ErzaWSpells__Erza2R_KS_c[this], Erza2R_ID) - 1 ) ) )
            set s__ErzaWSpells__Erza2R_KS_r[this]=0
            set s__ErzaWSpells__Erza2R_KS_aoe[this]=Erza2R_DamageAoe
            set s__ErzaWSpells__Erza2R_KS_a[this]=GAngle2(s__ErzaWSpells__Erza2R_KS_c[this] , s__ErzaWSpells__Erza2R_KS_x[this] , s__ErzaWSpells__Erza2R_KS_y[this]) // Angle Between points
            set s__ErzaWSpells__Erza2R_KS_rmax[this]=1.2
            set s__ErzaWSpells__Erza2R_KS_move[this]=Erza2R_Range / 20
            call MakeSound("war3mapImported\\Hero_Erza2_R")
            set s__ErzaWSpells__Erza2R_KS_e2[this]=AddSpecialEffectTarget("war3mapimported\\wos_laz (167).mdx", s__ErzaWSpells__Erza2R_KS_c[this], "weapon")
            call SetUnitFacing(s__ErzaWSpells__Erza2R_KS_c[this], s__ErzaWSpells__Erza2R_KS_a[this] * bj_RADTODEG)
            call SetUnitAnimationByIndex(s__ErzaWSpells__Erza2R_KS_c[this], 5)
            call SetUnitTimeScale(s__ErzaWSpells__Erza2R_KS_c[this], 0.5)
            if s__ErzaWSpells__Erza2R_KS_MUI_ErzaR == 0 then
                call TimerStart(s__ErzaWSpells__Erza2R_KS_t_ErzaR, 0.03, true, function s__ErzaWSpells__Erza2R_KS_Loop_ErzaR)
            endif
        endfunction

        function s__ErzaWSpells__Erza2T_KS_Loop_ErzaT takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__ErzaWSpells__Erza2T_KS_MUI_ErzaT
                set this=s__ErzaWSpells__Erza2T_KS_m_ErzaT[i]
                if SpellBoolCaster(s__ErzaWSpells__Erza2T_KS_c[this]) and SpellBoolCaster(s__ErzaWSpells__Erza2T_KS_td[this]) and s__ErzaWSpells__Erza2T_KS_r[this] <= s__ErzaWSpells__Erza2T_KS_rmax[this] then
                    set s__ErzaWSpells__Erza2T_KS_r[this]=s__ErzaWSpells__Erza2T_KS_r[this] + 0.03
                    if s__ErzaWSpells__Erza2T_KS_check[this] < 2 then
                        set s__ErzaWSpells__Erza2T_KS_a[this]=GAngle(s__ErzaWSpells__Erza2T_KS_c[this] , s__ErzaWSpells__Erza2T_KS_td[this])
                        call SetUnitFacing(s__ErzaWSpells__Erza2T_KS_c[this], s__ErzaWSpells__Erza2T_KS_a[this] * bj_RADTODEG)
                    endif
                    if s__ErzaWSpells__Erza2T_KS_check[this] == 0 then
                        if s__ErzaWSpells__Erza2T_KS_r[this] == 0.66 then
                            call SetUnitAnimationByIndex(s__ErzaWSpells__Erza2T_KS_c[this], 12)
                            call SetUnitTimeScale(s__ErzaWSpells__Erza2T_KS_c[this], 0.65)
                            set s__ErzaWSpells__Erza2T_KS_e2[this]=AddSpecialEffectTarget("war3mapimported\\wos_ChuShou_BY_Wood_Effect_Glow_GuiPaiQiGong_XuLiRed.mdx", s__ErzaWSpells__Erza2T_KS_c[this], "weapon")
                            set s__ErzaWSpells__Erza2T_KS_r2[this]=10
                        endif
                        if s__ErzaWSpells__Erza2T_KS_r[this] == 1.02 then
                            call SetUnitTimeScale(s__ErzaWSpells__Erza2T_KS_c[this], 0.45)
                        endif
                        if s__ErzaWSpells__Erza2T_KS_r[this] > 1.02 then
                            if SR2(s__ErzaWSpells__Erza2T_KS_c[this] , s__ErzaWSpells__Erza2T_KS_td[this]) > s__ErzaWSpells__Erza2T_KS_move[this] * 1.25 then
                                call MoveUnit(s__ErzaWSpells__Erza2T_KS_c[this] , s__ErzaWSpells__Erza2T_KS_move[this] , s__ErzaWSpells__Erza2T_KS_a[this])
                                if s__ErzaWSpells__Erza2T_KS_r2[this] > 0.09 then
                                    set s__ErzaWSpells__Erza2T_KS_r2[this]=0
                                    call EffectSpawn2("war3mapImported\\wos_Bubbles2.mdx" , GetUnitX(s__ErzaWSpells__Erza2T_KS_c[this]) , GetUnitY(s__ErzaWSpells__Erza2T_KS_c[this]) , GetRandomReal(0, 359) , 1 , 10 , GetRandomReal(50, 150) , 0.7)
                                    call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_Kamijo-6blue.mdl" , GetUnitX(s__ErzaWSpells__Erza2T_KS_c[this]) , GetUnitY(s__ErzaWSpells__Erza2T_KS_c[this]) , s__ErzaWSpells__Erza2T_KS_a[this] * bj_RADTODEG , 1 , 2.35 , 0 , 255 , 255 , 255 , 200))
                                    call DestroyEffect(EffectSpawn("war3mapImported\\wos_BY_Wood_Effect_Kula_2_YiYingCun0.mdl" , GetUnitX(s__ErzaWSpells__Erza2T_KS_c[this]) , GetUnitY(s__ErzaWSpells__Erza2T_KS_c[this]) , s__ErzaWSpells__Erza2T_KS_a[this] * bj_RADTODEG , 0.5 , 3.75 , 75))
                                else
                                    set s__ErzaWSpells__Erza2T_KS_r2[this]=s__ErzaWSpells__Erza2T_KS_r2[this] + 0.03
                                endif
                            else
                                set s__ErzaWSpells__Erza2T_KS_check[this]=1
                                set s__ErzaWSpells__Erza2T_KS_r[this]=0
                                set s__ErzaWSpells__Erza2T_KS_rmax[this]=0.03
                                call SetUnitTimeScale(s__ErzaWSpells__Erza2T_KS_c[this], 1)
                                call MakeSound("war3mapImported\\Hero_Erza1_T4")
                                call PosUnit(s__ErzaWSpells__Erza2T_KS_td[this] , GetUnitX(s__ErzaWSpells__Erza2T_KS_c[this]) + 130 * Cos(s__ErzaWSpells__Erza2T_KS_a[this]) , GetUnitY(s__ErzaWSpells__Erza2T_KS_c[this]) + 130 * Sin(s__ErzaWSpells__Erza2T_KS_a[this]))
                            endif
                        endif
                    elseif s__ErzaWSpells__Erza2T_KS_check[this] == 1 then
                        set s__ErzaWSpells__Erza2T_KS_x[this]=GetUnitX(s__ErzaWSpells__Erza2T_KS_td[this])
                        set s__ErzaWSpells__Erza2T_KS_y[this]=GetUnitY(s__ErzaWSpells__Erza2T_KS_td[this])
                        if s__ErzaWSpells__Erza2T_KS_r[this] == s__ErzaWSpells__Erza2T_KS_rmax[this] then
                            call SetUnitAnimation(s__ErzaWSpells__Erza2T_KS_td[this], "death")
                        call DecorRemove(s__ErzaWSpells__Erza2T_KS_c[this] , s__ErzaWSpells__Erza2T_KS_x[this] , s__ErzaWSpells__Erza2T_KS_y[this] , s__ErzaWSpells__Erza2T_KS_aoe[this] , 70)
                            call VisionTimed(GetOwningPlayer(s__ErzaWSpells__Erza2T_KS_c[this]) , s__ErzaWSpells__Erza2T_KS_x[this] , s__ErzaWSpells__Erza2T_KS_y[this] , 1250 , 2)
                            call ColorEffDummy3(EffectSpawn("war3mapImported\\wos_blue spin slash.mdl" , s__ErzaWSpells__Erza2T_KS_x[this] , s__ErzaWSpells__Erza2T_KS_y[this] , s__ErzaWSpells__Erza2T_KS_a[this] * bj_RADTODEG + 120 , 1 , 0.75 , 1) , 0.5 , 255 , 255 , 255 , 0.675)
                            call ColorEffDummy3(EffectSpawn("war3mapImported\\wos_blue spin slash.mdl" , s__ErzaWSpells__Erza2T_KS_x[this] , s__ErzaWSpells__Erza2T_KS_y[this] , s__ErzaWSpells__Erza2T_KS_a[this] * bj_RADTODEG + 240 , 1 , 1.25 , 1) , 0.5 , 255 , 255 , 255 , 0.675)
                            call ColorEffDummy3(EffectSpawn("war3mapImported\\wos_blue spin slash.mdl" , s__ErzaWSpells__Erza2T_KS_x[this] , s__ErzaWSpells__Erza2T_KS_y[this] , s__ErzaWSpells__Erza2T_KS_a[this] * bj_RADTODEG + 360 , 1 , 1.75 , 1) , 0.5 , 255 , 255 , 255 , 0.675)
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_Opdef17 (1110).mdl" , s__ErzaWSpells__Erza2T_KS_x[this] , s__ErzaWSpells__Erza2T_KS_y[this] , GetRandomReal(0, 359) , 1.15 , 1.5 , 35))
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_obr08 (214).mdl" , s__ErzaWSpells__Erza2T_KS_x[this] , s__ErzaWSpells__Erza2T_KS_y[this] , GetRandomReal(0, 359) , 1.15 , 2.5 , 1))
                            call GroupEnumUnitsInRange(s__ErzaWSpells__Erza2T_KS_g[this], s__ErzaWSpells__Erza2T_KS_x[this], s__ErzaWSpells__Erza2T_KS_y[this], s__ErzaWSpells__Erza2T_KS_aoe[this], NoDecor_Cond)
                            loop
                                set s__ErzaWSpells__Erza2T_KS_u[this]=FirstOfGroup(s__ErzaWSpells__Erza2T_KS_g[this])
                                exitwhen s__ErzaWSpells__Erza2T_KS_u[this] == null
                                if IsUnitEnemy(s__ErzaWSpells__Erza2T_KS_u[this], GetOwningPlayer(s__ErzaWSpells__Erza2T_KS_c[this])) and SpellBool(s__ErzaWSpells__Erza2T_KS_u[this]) then
                                    call dmgmag(s__ErzaWSpells__Erza2T_KS_c[this] , s__ErzaWSpells__Erza2T_KS_u[this] , s__ErzaWSpells__Erza2T_KS_dmg[this])
                                    call ErzaPassive(s__ErzaWSpells__Erza2T_KS_c[this] , s__ErzaWSpells__Erza2T_KS_u[this] , 2)
                                endif
                                call GroupRemoveUnit(s__ErzaWSpells__Erza2T_KS_g[this], s__ErzaWSpells__Erza2T_KS_u[this])
                            endloop
                           
                        endif
                    endif
                else
                    call DestroyEffect(s__ErzaWSpells__Erza2T_KS_e[this])
                    call DestroyEffect(s__ErzaWSpells__Erza2T_KS_e2[this])
                    call StopSpellUnit2(s__ErzaWSpells__Erza2T_KS_c[this])
                    call DestroyGroup(s__ErzaWSpells__Erza2T_KS_g[this])
                    set s__ErzaWSpells__Erza2T_KS_g[this]=null
                    set s__ErzaWSpells__Erza2T_KS_c[this]=null
                    set s__ErzaWSpells__Erza2T_KS_td[this]=null
                    set s__ErzaWSpells__Erza2T_KS_e[this]=null
                    set s__ErzaWSpells__Erza2T_KS_e2[this]=null
                    set s__ErzaWSpells__Erza2T_KS_u[this]=null
                    set s__ErzaWSpells__Erza2T_KS_m_ErzaT[i]=s__ErzaWSpells__Erza2T_KS_m_ErzaT[s__ErzaWSpells__Erza2T_KS_MUI_ErzaT]
                    set s__ErzaWSpells__Erza2T_KS_MUI_ErzaT=s__ErzaWSpells__Erza2T_KS_MUI_ErzaT - 1
                    if s__ErzaWSpells__Erza2T_KS_MUI_ErzaT == - 1 then
                        call PauseTimer(s__ErzaWSpells__Erza2T_KS_t_ErzaT)
                    endif
                    call s__ErzaWSpells__Erza2T_KS_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction
        function s__ErzaWSpells__Erza2T_KS_ErzaT_Start takes unit NewC,unit NewTd returns nothing
            local integer this= s__ErzaWSpells__Erza2T_KS__allocate()
            set s__ErzaWSpells__Erza2T_KS_MUI_ErzaT=s__ErzaWSpells__Erza2T_KS_MUI_ErzaT + 1
            set s__ErzaWSpells__Erza2T_KS_m_ErzaT[s__ErzaWSpells__Erza2T_KS_MUI_ErzaT]=this
            set s__ErzaWSpells__Erza2T_KS_c[this]=NewC
            set s__ErzaWSpells__Erza2T_KS_td[this]=NewTd
            set s__ErzaWSpells__Erza2T_KS_r[this]=0
            set s__ErzaWSpells__Erza2T_KS_r2[this]=0
            set s__ErzaWSpells__Erza2T_KS_check[this]=0
            call StartSpellUnit2(s__ErzaWSpells__Erza2T_KS_c[this])
            set s__ErzaWSpells__Erza2T_KS_g[this]=CreateGroup()
            set s__ErzaWSpells__Erza2T_KS_u[this]=null
            set s__ErzaWSpells__Erza2T_KS_a[this]=GAngle(s__ErzaWSpells__Erza2T_KS_c[this] , s__ErzaWSpells__Erza2T_KS_td[this]) // Angle Between points
            call SetUnitFacing(s__ErzaWSpells__Erza2T_KS_c[this], s__ErzaWSpells__Erza2T_KS_a[this] * bj_RADTODEG)
            set s__ErzaWSpells__Erza2T_KS_aoe[this]=Erza2T_DamageAoe
            set s__ErzaWSpells__Erza2T_KS_dmg[this]=GetHeroAgi(s__ErzaWSpells__Erza2T_KS_c[this], true) * Erza2T_DamageAgiBase
            set s__ErzaWSpells__Erza2T_KS_rmax[this]=5
            set s__ErzaWSpells__Erza2T_KS_move[this]=80
            set s__ErzaWSpells__Erza2T_KS_e[this]=AddSpecialEffectTarget("war3mapImported\\wos_aurapartred2.mdx", s__ErzaWSpells__Erza2T_KS_c[this], "origin")
            call SetUnitTimeScale(s__ErzaWSpells__Erza2T_KS_c[this], 0.65)
            call SetUnitAnimationByIndex(s__ErzaWSpells__Erza2T_KS_c[this], 5)
            call MakeSound("war3mapImported\\Hero_Erza2_T")
            if s__ErzaWSpells__Erza2T_KS_MUI_ErzaT == 0 then
                call TimerStart(s__ErzaWSpells__Erza2T_KS_t_ErzaT, 0.03, true, function s__ErzaWSpells__Erza2T_KS_Loop_ErzaT)
            endif
        endfunction

    //----------------------------Erza-----------------------------------------------
      
    function Erza2Q_Start takes unit c,unit td returns nothing
        call s__ErzaWSpells__Erza2Q_KS_ErzaQ_Start(c , td)
    endfunction
    function Erza2W_Start takes unit c returns nothing
        call s__ErzaWSpells__Erza2W_KS_ErzaW_Start(c)
    endfunction
    function Erza2E_Start takes unit c,real x,real y returns nothing
        call s__ErzaWSpells__Erza2E_KS_ErzaE_Start(c , x , y)
    endfunction
    function Erza2R_Start takes unit c,real x,real y returns nothing
        call s__ErzaWSpells__Erza2R_KS_ErzaR_Start(c , x , y)
    endfunction
    function Erza2T_Start takes unit c,unit td returns nothing
        call s__ErzaWSpells__Erza2T_KS_ErzaT_Start(c , td)
    endfunction
   

//library ErzaWSpells ends
//library HeroUnitPanelStats:

    function HeroUnitPanelStats___UNITSTAT_CreateText takes string frameName,integer context,real width returns framehandle
        local framehandle result= BlzCreateFrameByType("TEXT", frameName, HeroUnitPanelStats___UNITSTAT_GameUI, "", context)
        call BlzFrameSetSize(result, width, 0.012)
        call BlzFrameSetTextAlignment(result, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_LEFT)
        call BlzFrameSetScale(result, HeroUnitPanelStats___UNITSTAT_TEXT_SCALE)
        call BlzFrameSetLevel(result, 25)
        return result
    endfunction

    function HeroUnitPanelStats___UNITSTAT_Update takes nothing returns nothing
        local integer i= 0
        local unit selected= null
        
        local boolean showVitals
        local boolean showHero
        local boolean invulnerable
        
        local string hpRegenStr= ""
        local string mpRegenStr= ""
        local string physResStr= ""
        local string magResStr= ""
        local string msStr= ""
        local string asStr= ""

        local integer maxMp

        loop
            exitwhen i >= bj_MAX_PLAYER_SLOTS
            if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i)) == MAP_CONTROL_USER then
                
                call GroupClear(HeroUnitPanelStats___UNITSTAT_SelectedGroup)
                call GroupEnumUnitsSelected(HeroUnitPanelStats___UNITSTAT_SelectedGroup, Player(i), null)
                set selected=FirstOfGroup(HeroUnitPanelStats___UNITSTAT_SelectedGroup)

                set showVitals=false
                set showHero=false
                set invulnerable=false
                set maxMp=0

                if selected != null then
                    set showVitals=true
                    set showHero=true //IsUnitType(selected, UNIT_TYPE_HERO) or IsHeroUnitId(GetUnitTypeId(selected))
                    set invulnerable=GetUnitAbilityLevel(selected, HeroUnitPanelStats___UNITSTAT_INVUL_ABILITY) > 0 and CheckCoordsInRect(gg_rct_Base , GetUnitX(selected) , GetUnitY(selected)) == false

                    set maxMp=BlzGetUnitMaxMana(selected)

                    set hpRegenStr="|cff62ff62HP: +" + R2SW(GetHpRegen(selected), 0, 2) + "|r"
                    set mpRegenStr="|cff6fa8ffMP: +" + R2SW(GetMpRegen(selected), 0, 2) + "|r"

                    if showHero then
                        set physResStr="|cffff6b6bPhys Res: |r|cffffffff" + R2SW(GetPhysRes(selected), 0, 2) + "%|r"
                        set magResStr="|cff6fa8ffMag Res: |r|cffffffff" + R2SW(GetMagRes(selected), 0, 2) + "%|r"
                        set msStr="|cffffd36bMS: |r|cffffffff" + I2S(R2I(GetUnitMoveSpeed(selected))) + "|r"
                        set asStr="|cffdededeAS: |r|cffffffff" + R2SW(GetAS(selected), 0, 2) + "s|r"
                    endif
                endif

                if GetLocalPlayer() == Player(i) then
                    if not showVitals then
                        call BlzFrameSetVisible(HeroUnitPanelStats___UNITSTAT_HpRegen, false)
                        call BlzFrameSetVisible(HeroUnitPanelStats___UNITSTAT_MpRegen, false)
                        call BlzFrameSetVisible(HeroUnitPanelStats___UNITSTAT_PhysRes, false)
                        call BlzFrameSetVisible(HeroUnitPanelStats___UNITSTAT_MagRes, false)
                        call BlzFrameSetVisible(HeroUnitPanelStats___UNITSTAT_MoveSpeed, false)
                        call BlzFrameSetVisible(HeroUnitPanelStats___UNITSTAT_AttackSpeed, false)
                        call BlzFrameSetVisible(HeroUnitPanelStats___UNITSTAT_Invulnerable, false)
                    else
                        call BlzFrameSetText(HeroUnitPanelStats___UNITSTAT_HpRegen, hpRegenStr)
                        call BlzFrameSetText(HeroUnitPanelStats___UNITSTAT_MpRegen, mpRegenStr)
                        
                        call BlzFrameSetVisible(HeroUnitPanelStats___UNITSTAT_HpRegen, true)

                        if maxMp <= 0 then
                            call BlzFrameSetVisible(HeroUnitPanelStats___UNITSTAT_MpRegen, false)
                        else
                            call BlzFrameSetVisible(HeroUnitPanelStats___UNITSTAT_MpRegen, true)
                        endif

                        if not showHero then
                            call BlzFrameSetVisible(HeroUnitPanelStats___UNITSTAT_PhysRes, false)
                            call BlzFrameSetVisible(HeroUnitPanelStats___UNITSTAT_MagRes, false)
                            call BlzFrameSetVisible(HeroUnitPanelStats___UNITSTAT_MoveSpeed, false)
                            call BlzFrameSetVisible(HeroUnitPanelStats___UNITSTAT_AttackSpeed, false)
                            call BlzFrameSetVisible(HeroUnitPanelStats___UNITSTAT_Invulnerable, false)
                           // call BJDebugMsg("not")
                        else
                           // call BJDebugMsg("true")
                            call BlzFrameSetText(HeroUnitPanelStats___UNITSTAT_PhysRes, physResStr)
                            call BlzFrameSetText(HeroUnitPanelStats___UNITSTAT_MagRes, magResStr)
                            call BlzFrameSetText(HeroUnitPanelStats___UNITSTAT_MoveSpeed, msStr)
                            call BlzFrameSetText(HeroUnitPanelStats___UNITSTAT_AttackSpeed, asStr)
                            
                            if invulnerable then
                                call BlzFrameSetVisible(HeroUnitPanelStats___UNITSTAT_PhysRes, false)
                                call BlzFrameSetVisible(HeroUnitPanelStats___UNITSTAT_MagRes, false)
                                call BlzFrameSetVisible(HeroUnitPanelStats___UNITSTAT_Invulnerable, true)
                            else
                                call BlzFrameSetVisible(HeroUnitPanelStats___UNITSTAT_PhysRes, true)
                                call BlzFrameSetVisible(HeroUnitPanelStats___UNITSTAT_MagRes, true)
                                call BlzFrameSetVisible(HeroUnitPanelStats___UNITSTAT_Invulnerable, false)
                            endif
                            
                            call BlzFrameSetVisible(HeroUnitPanelStats___UNITSTAT_MoveSpeed, true)
                            call BlzFrameSetVisible(HeroUnitPanelStats___UNITSTAT_AttackSpeed, true)
                        endif
                    endif
                endif
            endif
            set i=i + 1
        endloop

        set selected=null
    endfunction

    function HeroUnitPanelStats___UNITSTAT_DelayedInit takes nothing returns nothing
        local timer initTimer= GetExpiredTimer()
        local framehandle armorBackdrop
        local framehandle heroContainer
        local framehandle heroIcon
        local framehandle heroText

        call DestroyTimer(initTimer)

        set armorBackdrop=BlzGetFrameByName("InfoPanelIconBackdrop", 2)
        if armorBackdrop != null then
            call BlzFrameClearAllPoints(armorBackdrop)
            call BlzFrameSetSize(armorBackdrop, HeroUnitPanelStats___UNITSTAT_ARMOR_TINY_SIZE, HeroUnitPanelStats___UNITSTAT_ARMOR_TINY_SIZE)
            call BlzFrameSetAbsPoint(armorBackdrop, FRAMEPOINT_BOTTOM, HeroUnitPanelStats___UNITSTAT_ARMOR_OFFSCREEN_X, HeroUnitPanelStats___UNITSTAT_ARMOR_OFFSCREEN_Y)
        endif

        set HeroUnitPanelStats___UNITSTAT_ArmorContainer=BlzGetFrameByName("SimpleInfoPanelIconArmor", 2)
        if HeroUnitPanelStats___UNITSTAT_ArmorContainer != null then
            call BlzFrameClearAllPoints(HeroUnitPanelStats___UNITSTAT_PhysRes)
            call BlzFrameClearAllPoints(HeroUnitPanelStats___UNITSTAT_MagRes)
            call BlzFrameClearAllPoints(HeroUnitPanelStats___UNITSTAT_MoveSpeed)
            call BlzFrameClearAllPoints(HeroUnitPanelStats___UNITSTAT_AttackSpeed)
            call BlzFrameClearAllPoints(HeroUnitPanelStats___UNITSTAT_Invulnerable)
            call BlzFrameClearAllPoints(HeroUnitPanelStats___UNITSTAT_HpRegen)
            call BlzFrameClearAllPoints(HeroUnitPanelStats___UNITSTAT_MpRegen)

            call BlzFrameSetPoint(HeroUnitPanelStats___UNITSTAT_HpRegen, FRAMEPOINT_LEFT, HeroUnitPanelStats___UNITSTAT_ArmorContainer, FRAMEPOINT_LEFT, HeroUnitPanelStats___UNITSTAT_HP_REGEN_X, HeroUnitPanelStats___UNITSTAT_HP_REGEN_Y)
            call BlzFrameSetPoint(HeroUnitPanelStats___UNITSTAT_MpRegen, FRAMEPOINT_LEFT, HeroUnitPanelStats___UNITSTAT_ArmorContainer, FRAMEPOINT_LEFT, HeroUnitPanelStats___UNITSTAT_MP_REGEN_X, HeroUnitPanelStats___UNITSTAT_MP_REGEN_Y)
            call BlzFrameSetPoint(HeroUnitPanelStats___UNITSTAT_PhysRes, FRAMEPOINT_LEFT, HeroUnitPanelStats___UNITSTAT_ArmorContainer, FRAMEPOINT_LEFT, HeroUnitPanelStats___UNITSTAT_PHYS_RES_X, HeroUnitPanelStats___UNITSTAT_PHYS_RES_Y)
            call BlzFrameSetPoint(HeroUnitPanelStats___UNITSTAT_MagRes, FRAMEPOINT_LEFT, HeroUnitPanelStats___UNITSTAT_ArmorContainer, FRAMEPOINT_LEFT, HeroUnitPanelStats___UNITSTAT_MAG_RES_X, HeroUnitPanelStats___UNITSTAT_MAG_RES_Y)
            call BlzFrameSetPoint(HeroUnitPanelStats___UNITSTAT_MoveSpeed, FRAMEPOINT_LEFT, HeroUnitPanelStats___UNITSTAT_ArmorContainer, FRAMEPOINT_LEFT, HeroUnitPanelStats___UNITSTAT_MOVE_SPEED_X, HeroUnitPanelStats___UNITSTAT_MOVE_SPEED_Y)
            call BlzFrameSetPoint(HeroUnitPanelStats___UNITSTAT_AttackSpeed, FRAMEPOINT_LEFT, HeroUnitPanelStats___UNITSTAT_ArmorContainer, FRAMEPOINT_LEFT, HeroUnitPanelStats___UNITSTAT_ATTACK_SPEED_X, HeroUnitPanelStats___UNITSTAT_ATTACK_SPEED_Y)
            call BlzFrameSetPoint(HeroUnitPanelStats___UNITSTAT_Invulnerable, FRAMEPOINT_LEFT, HeroUnitPanelStats___UNITSTAT_ArmorContainer, FRAMEPOINT_LEFT, HeroUnitPanelStats___UNITSTAT_INVULNERABLE_X, HeroUnitPanelStats___UNITSTAT_INVULNERABLE_Y)
        endif

        set heroContainer=BlzGetFrameByName("SimpleInfoPanelIconHero", 6)
        set heroIcon=BlzGetFrameByName("InfoPanelIconHeroIcon", 6)
        set heroText=BlzGetFrameByName("SimpleInfoPanelIconHeroText", 6)
        if heroContainer != null and heroIcon != null and heroText != null then
            call BlzFrameClearAllPoints(heroIcon)
            call BlzFrameSetPoint(heroIcon, FRAMEPOINT_TOPLEFT, heroContainer, FRAMEPOINT_TOPLEFT, 0.002, - 0.003)

            call BlzFrameClearAllPoints(heroText)
            call BlzFrameSetPoint(heroText, FRAMEPOINT_LEFT, heroIcon, FRAMEPOINT_RIGHT, 0.006, 0.000)
            call BlzFrameSetPoint(heroText, FRAMEPOINT_RIGHT, heroContainer, FRAMEPOINT_RIGHT, 0.000, 0.000)
            call BlzFrameSetPoint(heroText, FRAMEPOINT_TOP, heroContainer, FRAMEPOINT_TOP, 0.000, 0.000)
            call BlzFrameSetPoint(heroText, FRAMEPOINT_BOTTOM, heroContainer, FRAMEPOINT_BOTTOM, 0.000, 0.000)
        endif

        call ClearSelection()
        call RemoveUnit(HeroUnitPanelStats___UNITSTAT_DummyHero)
        set HeroUnitPanelStats___UNITSTAT_DummyHero=null

        set HeroUnitPanelStats___UNITSTAT_UpdateTimer=CreateTimer()
        call TimerStart(HeroUnitPanelStats___UNITSTAT_UpdateTimer, HeroUnitPanelStats___UNITSTAT_UPDATE_PERIOD, true, function HeroUnitPanelStats___UNITSTAT_Update)
    endfunction

    function HeroUnitPanelStats___UNITSTAT_CreateUI takes nothing returns nothing
        set HeroUnitPanelStats___UNITSTAT_GameUI=BlzGetOriginFrame(ORIGIN_FRAME_GAME_UI, 0)
        set HeroUnitPanelStats___UNITSTAT_SelectedGroup=CreateGroup()

        set HeroUnitPanelStats___UNITSTAT_PhysRes=HeroUnitPanelStats___UNITSTAT_CreateText("HeroPanelPhysRes" , 6100 , 0.086)
        set HeroUnitPanelStats___UNITSTAT_MagRes=HeroUnitPanelStats___UNITSTAT_CreateText("HeroPanelMagRes" , 6101 , 0.086)
        set HeroUnitPanelStats___UNITSTAT_HpRegen=HeroUnitPanelStats___UNITSTAT_CreateText("HeroPanelHpRegen" , 6104 , 0.045)
        set HeroUnitPanelStats___UNITSTAT_MpRegen=HeroUnitPanelStats___UNITSTAT_CreateText("HeroPanelMpRegen" , 6105 , 0.045)
        set HeroUnitPanelStats___UNITSTAT_MoveSpeed=HeroUnitPanelStats___UNITSTAT_CreateText("HeroPanelMoveSpeed" , 6106 , 0.080)
        set HeroUnitPanelStats___UNITSTAT_AttackSpeed=HeroUnitPanelStats___UNITSTAT_CreateText("HeroPanelAttackSpeed" , 6107 , 0.080)
        set HeroUnitPanelStats___UNITSTAT_Invulnerable=HeroUnitPanelStats___UNITSTAT_CreateText("HeroPanelInvulnerable" , 6108 , 0.095)
        
        call BlzFrameSetScale(HeroUnitPanelStats___UNITSTAT_PhysRes, 0.78)
        call BlzFrameSetScale(HeroUnitPanelStats___UNITSTAT_MagRes, 0.78)
        call BlzFrameSetScale(HeroUnitPanelStats___UNITSTAT_HpRegen, HeroUnitPanelStats___UNITSTAT_HP_REGEN_SCALE)
        call BlzFrameSetScale(HeroUnitPanelStats___UNITSTAT_MpRegen, HeroUnitPanelStats___UNITSTAT_MP_REGEN_SCALE)
        call BlzFrameSetScale(HeroUnitPanelStats___UNITSTAT_Invulnerable, 0.90)
        call BlzFrameSetText(HeroUnitPanelStats___UNITSTAT_Invulnerable, "|cffff2020INVUL|r")

        call BlzFrameSetSize(HeroUnitPanelStats___UNITSTAT_HpRegen, 0.072, 0.012)
        call BlzFrameSetSize(HeroUnitPanelStats___UNITSTAT_MpRegen, 0.072, 0.012)
        call BlzFrameSetTextAlignment(HeroUnitPanelStats___UNITSTAT_HpRegen, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_LEFT)
        call BlzFrameSetTextAlignment(HeroUnitPanelStats___UNITSTAT_MpRegen, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_LEFT)

        // Visible fallback until the dummy Paladin exposes the armor container.
        call BlzFrameSetAbsPoint(HeroUnitPanelStats___UNITSTAT_HpRegen, FRAMEPOINT_LEFT, HeroUnitPanelStats___UNITSTAT_FALLBACK_X + HeroUnitPanelStats___UNITSTAT_HP_REGEN_X, HeroUnitPanelStats___UNITSTAT_FALLBACK_Y + HeroUnitPanelStats___UNITSTAT_HP_REGEN_Y)
        call BlzFrameSetAbsPoint(HeroUnitPanelStats___UNITSTAT_MpRegen, FRAMEPOINT_LEFT, HeroUnitPanelStats___UNITSTAT_FALLBACK_X + HeroUnitPanelStats___UNITSTAT_MP_REGEN_X, HeroUnitPanelStats___UNITSTAT_FALLBACK_Y + HeroUnitPanelStats___UNITSTAT_MP_REGEN_Y)
        call BlzFrameSetAbsPoint(HeroUnitPanelStats___UNITSTAT_PhysRes, FRAMEPOINT_LEFT, HeroUnitPanelStats___UNITSTAT_FALLBACK_X + HeroUnitPanelStats___UNITSTAT_PHYS_RES_X, HeroUnitPanelStats___UNITSTAT_FALLBACK_Y + HeroUnitPanelStats___UNITSTAT_PHYS_RES_Y)
        call BlzFrameSetAbsPoint(HeroUnitPanelStats___UNITSTAT_MagRes, FRAMEPOINT_LEFT, HeroUnitPanelStats___UNITSTAT_FALLBACK_X + HeroUnitPanelStats___UNITSTAT_MAG_RES_X, HeroUnitPanelStats___UNITSTAT_FALLBACK_Y + HeroUnitPanelStats___UNITSTAT_MAG_RES_Y)
        call BlzFrameSetAbsPoint(HeroUnitPanelStats___UNITSTAT_MoveSpeed, FRAMEPOINT_LEFT, HeroUnitPanelStats___UNITSTAT_FALLBACK_X + HeroUnitPanelStats___UNITSTAT_MOVE_SPEED_X, HeroUnitPanelStats___UNITSTAT_FALLBACK_Y + HeroUnitPanelStats___UNITSTAT_MOVE_SPEED_Y)
        call BlzFrameSetAbsPoint(HeroUnitPanelStats___UNITSTAT_AttackSpeed, FRAMEPOINT_LEFT, HeroUnitPanelStats___UNITSTAT_FALLBACK_X + HeroUnitPanelStats___UNITSTAT_ATTACK_SPEED_X, HeroUnitPanelStats___UNITSTAT_FALLBACK_Y + HeroUnitPanelStats___UNITSTAT_ATTACK_SPEED_Y)
        call BlzFrameSetAbsPoint(HeroUnitPanelStats___UNITSTAT_Invulnerable, FRAMEPOINT_LEFT, HeroUnitPanelStats___UNITSTAT_FALLBACK_X + HeroUnitPanelStats___UNITSTAT_INVULNERABLE_X, HeroUnitPanelStats___UNITSTAT_FALLBACK_Y + HeroUnitPanelStats___UNITSTAT_INVULNERABLE_Y)

        call BlzFrameSetVisible(HeroUnitPanelStats___UNITSTAT_PhysRes, false)
        call BlzFrameSetVisible(HeroUnitPanelStats___UNITSTAT_MagRes, false)
        call BlzFrameSetVisible(HeroUnitPanelStats___UNITSTAT_MoveSpeed, false)
        call BlzFrameSetVisible(HeroUnitPanelStats___UNITSTAT_AttackSpeed, false)
        call BlzFrameSetVisible(HeroUnitPanelStats___UNITSTAT_Invulnerable, false)
        call BlzFrameSetVisible(HeroUnitPanelStats___UNITSTAT_HpRegen, false)
        call BlzFrameSetVisible(HeroUnitPanelStats___UNITSTAT_MpRegen, false)
    endfunction

    function HeroUnitPanelStats___HeroUnitPanelStats_Init takes nothing returns nothing
        local timer initTimer= CreateTimer()
        
        call HeroUnitPanelStats___UNITSTAT_CreateUI()
        
        set HeroUnitPanelStats___UNITSTAT_DummyHero=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'Hpal', 0, 0, 0)
        call BlzSetUnitRealField(HeroUnitPanelStats___UNITSTAT_DummyHero, UNIT_RF_SCALING_VALUE, 0.01)
        
        call SelectUnit(HeroUnitPanelStats___UNITSTAT_DummyHero, true)

        call TimerStart(initTimer, 0.10, false, function HeroUnitPanelStats___UNITSTAT_DelayedInit)
        set initTimer=null
    endfunction

//library HeroUnitPanelStats ends
//library LaxusSpells:

    //===========================================================================
    // МОДУЛЬ ORDER TRACKING (БЕГ БЕЗ ОСТАНОВКИ)
    //===========================================================================
    function LaxusSpells___OnHeroPointOrder takes nothing returns boolean
        local unit u= GetOrderedUnit()
        local integer ord= GetIssuedOrderId()
        if GetUnitTypeId(u) == Laxus_ID then
            if ord == 851971 or ord == 851986 or ord == 851990 then
                call SaveInteger(hs, GetHandleId(u), StringHash("ord_mode"), 1)
                call SaveInteger(hs, GetHandleId(u), StringHash("ord_id"), ord)
                call SaveReal(hs, GetHandleId(u), StringHash("ord_x"), GetOrderPointX())
                call SaveReal(hs, GetHandleId(u), StringHash("ord_y"), GetOrderPointY())
            endif
        endif
        set u=null
        return false
    endfunction

    function LaxusSpells___OnHeroTargetOrder takes nothing returns boolean
        local unit u= GetOrderedUnit()
        local integer ord= GetIssuedOrderId()
        if GetUnitTypeId(u) == Laxus_ID then
            if ord == 851971 or ord == 851983 then
                call SaveInteger(hs, GetHandleId(u), StringHash("ord_mode"), 2)
                call SaveInteger(hs, GetHandleId(u), StringHash("ord_id"), ord)
                call SaveUnitHandle(hs, GetHandleId(u), StringHash("ord_target"), GetOrderTargetUnit())
            endif
        endif
        set u=null
        return false
    endfunction

    function LaxusSpells___OnHeroImmediateOrder takes nothing returns boolean
        local unit u= GetOrderedUnit()
        local integer ord= GetIssuedOrderId()
        if GetUnitTypeId(u) == Laxus_ID then
            if ord == 851972 or ord == 851993 then
                call SaveInteger(hs, GetHandleId(u), StringHash("ord_mode"), 0)
            endif
        endif
        set u=null
        return false
    endfunction

    function Laxus_RestoreOrder takes unit c,integer animIndex returns nothing
        local integer mode= LoadInteger(hs, GetHandleId(c), StringHash("ord_mode"))
        local real ox
        local real oy
        local real dx
        local real dy
        local integer oid
        local unit tu

        if mode == 1 then
            set ox=LoadReal(hs, GetHandleId(c), StringHash("ord_x"))
            set oy=LoadReal(hs, GetHandleId(c), StringHash("ord_y"))
            set dx=ox - GetUnitX(c)
            set dy=oy - GetUnitY(c)
            if ( dx * dx + dy * dy ) > 5625.0 then
                set oid=LoadInteger(hs, GetHandleId(c), StringHash("ord_id"))
                call IssuePointOrderById(c, oid, ox, oy)
                return
            endif
        elseif mode == 2 then
            set tu=LoadUnitHandle(hs, GetHandleId(c), StringHash("ord_target"))
            if tu != null and GetWidgetLife(tu) > 0.405 then
                set oid=LoadInteger(hs, GetHandleId(c), StringHash("ord_id"))
                call IssueTargetOrderById(c, oid, tu)
                set tu=null
                return
            endif
            set tu=null
        endif

        call SetUnitAnimationByIndex(c, animIndex)
    endfunction

        function s__LaxusSpells___LaxusOrderInit_onInit takes nothing returns nothing
            local trigger tPoint= CreateTrigger()
            local trigger tTarget= CreateTrigger()
            local trigger tImmediate= CreateTrigger()
            local integer i= 0
            loop
                exitwhen i >= 16
                call TriggerRegisterPlayerUnitEvent(tPoint, Player(i), EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER, null)
                call TriggerRegisterPlayerUnitEvent(tTarget, Player(i), EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER, null)
                call TriggerRegisterPlayerUnitEvent(tImmediate, Player(i), EVENT_PLAYER_UNIT_ISSUED_ORDER, null)
                set i=i + 1
            endloop
            call TriggerAddCondition(tPoint, Condition(function LaxusSpells___OnHeroPointOrder))
            call TriggerAddCondition(tTarget, Condition(function LaxusSpells___OnHeroTargetOrder))
            call TriggerAddCondition(tImmediate, Condition(function LaxusSpells___OnHeroImmediateOrder))
        endfunction

    //===========================================================================
    // ТАЙМЕРЫ И МЕНЕДЖМЕНТ
    //===========================================================================
    function LaxusSpells___LaxusTimer03Acquire takes nothing returns nothing
        set LaxusSpells___LaxusTimer03Users=LaxusSpells___LaxusTimer03Users + 1
        if LaxusSpells___LaxusTimer03Users == 1 then
            call TimerStart(LaxusSpells___LaxusTimer03, 0.03, true, LaxusSpells___LaxusTimer03Callback)
        endif
    endfunction

    function LaxusSpells___LaxusTimer03Release takes nothing returns nothing
        set LaxusSpells___LaxusTimer03Users=LaxusSpells___LaxusTimer03Users - 1
        if LaxusSpells___LaxusTimer03Users <= 0 then
            set LaxusSpells___LaxusTimer03Users=0
            call PauseTimer(LaxusSpells___LaxusTimer03)
        endif
    endfunction

    //===========================================================================
    // СИСТЕМА ОБРАТНОЙ ЗАМЕНЫ W2 -> W ПРИ ИСТЕЧЕНИИ 3 СЕКУНД
    //===========================================================================


        function s__LaxusSpells___LaxusW2_Revert_Loop takes nothing returns nothing
            local integer i= 0
            local integer this
            loop
                exitwhen i > s__LaxusSpells___LaxusW2_Revert_m_count
                set this=s__LaxusSpells___LaxusW2_Revert_m_instances[i]
                set s__LaxusSpells___LaxusW2_Revert_elapsed[this]=s__LaxusSpells___LaxusW2_Revert_elapsed[this] + 0.03
                if s__LaxusSpells___LaxusW2_Revert_elapsed[this] >= LaxusW2_AvailableDuration or s__LaxusSpells___LaxusW2_Revert_c[this] == null or GetWidgetLife(s__LaxusSpells___LaxusW2_Revert_c[this]) <= 0.405 or GetUnitAbilityLevel(s__LaxusSpells___LaxusW2_Revert_c[this], LaxusW2_ID) == 0 then
                    if s__LaxusSpells___LaxusW2_Revert_c[this] != null and GetUnitAbilityLevel(s__LaxusSpells___LaxusW2_Revert_c[this], LaxusW2_ID) > 0 then
                        call s__GearSystems2__KS_SpellTimer_SpellTimer_Timer_Start((s__LaxusSpells___LaxusW2_Revert_c[this] ) , (( 3 )*1.0) , ( LaxusW_ID ) , ( LaxusW2_ID) , 0) // INLINED!!
                        call s__GearSystems2__KS_BuffTimer_MyBuffTime_Start((s__LaxusSpells___LaxusW2_Revert_c[this] ) , 0 , (( 3 )*1.0) , ( "BTNHero_Laxus_W" ) , ( false ) , - 1 , 1 , 0 , ( 0)) // INLINED!!
                    endif
                    set s__LaxusSpells___LaxusW2_Revert_c[this]=null
                    set s__LaxusSpells___LaxusW2_Revert_m_instances[i]=s__LaxusSpells___LaxusW2_Revert_m_instances[s__LaxusSpells___LaxusW2_Revert_m_count]
                    set s__LaxusSpells___LaxusW2_Revert_m_count=s__LaxusSpells___LaxusW2_Revert_m_count - 1
                    call s__LaxusSpells___LaxusW2_Revert_deallocate(this)
                    set i=i - 1
                endif
                set i=i + 1
            endloop
        endfunction

        function s__LaxusSpells___LaxusW2_Revert_Start takes unit hero returns nothing
            local integer this= s__LaxusSpells___LaxusW2_Revert__allocate()
            set s__LaxusSpells___LaxusW2_Revert_m_count=s__LaxusSpells___LaxusW2_Revert_m_count + 1
            set s__LaxusSpells___LaxusW2_Revert_m_instances[s__LaxusSpells___LaxusW2_Revert_m_count]=this
            set s__LaxusSpells___LaxusW2_Revert_c[this]=hero
            set s__LaxusSpells___LaxusW2_Revert_elapsed[this]=0.0
        endfunction

    //===========================================================================
    // СТРУКТУРЫ СПОСОБНОСТЕЙ
    //===========================================================================


        function s__LaxusSpells___LaxusQ_KS_Loop_LaxusQ2 takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__LaxusSpells___LaxusQ_KS_MUI_LaxusQ2
                set this=s__LaxusSpells___LaxusQ_KS_m_LaxusQ2[i]

                if SpellBoolCaster(s__LaxusSpells___LaxusQ_KS_c[this]) and s__LaxusSpells___LaxusQ_KS_r[this] <= s__LaxusSpells___LaxusQ_KS_rmax[this] then
                    set s__LaxusSpells___LaxusQ_KS_r[this]=RoundReal(s__LaxusSpells___LaxusQ_KS_r[this] + 0.03 , 3)

                    if s__LaxusSpells___LaxusQ_KS_check[this] == 0 then
                        if s__LaxusSpells___LaxusQ_KS_r[this] == LaxusQ2_CastTime then
                            call SetUnitTimeScale(s__LaxusSpells___LaxusQ_KS_c[this], 1.0)
                            set s__LaxusSpells___LaxusQ_KS_move[this]=180.0
                            if s__LaxusSpells___LaxusQ_KS_e[this] != null then
                                call DestroyEffect(s__LaxusSpells___LaxusQ_KS_e[this])
                                set s__LaxusSpells___LaxusQ_KS_e[this]=null
                            endif
                            set s__LaxusSpells___LaxusQ_KS_x[this]=GetUnitX(s__LaxusSpells___LaxusQ_KS_c[this]) + 10.0 * Cos(s__LaxusSpells___LaxusQ_KS_a[this])
                            set s__LaxusSpells___LaxusQ_KS_y[this]=GetUnitY(s__LaxusSpells___LaxusQ_KS_c[this]) + 10.0 * Sin(s__LaxusSpells___LaxusQ_KS_a[this])
                            if s__LaxusSpells___LaxusQ_KS_check2[this] == 0 then
                                set s__LaxusSpells___LaxusQ_KS_l[this]=AddLightningEx("LX01", false, GetUnitX(s__LaxusSpells___LaxusQ_KS_c[this]) + 10.0 * Cos(s__LaxusSpells___LaxusQ_KS_a[this]), GetUnitY(s__LaxusSpells___LaxusQ_KS_c[this]) + 10.0 * Sin(s__LaxusSpells___LaxusQ_KS_a[this]), GetUnitFlyHeight(s__LaxusSpells___LaxusQ_KS_c[this]) + LaxusQ_CasterLightningHeight2, s__LaxusSpells___LaxusQ_KS_x[this], s__LaxusSpells___LaxusQ_KS_y[this], GetUnitFlyHeight(s__LaxusSpells___LaxusQ_KS_c[this]) + LaxusQ_CasterLightningHeight2)
                            else
                                set s__LaxusSpells___LaxusQ_KS_l[this]=AddLightningEx("LX02", false, GetUnitX(s__LaxusSpells___LaxusQ_KS_c[this]) + 10.0 * Cos(s__LaxusSpells___LaxusQ_KS_a[this]), GetUnitY(s__LaxusSpells___LaxusQ_KS_c[this]) + 10.0 * Sin(s__LaxusSpells___LaxusQ_KS_a[this]), GetUnitFlyHeight(s__LaxusSpells___LaxusQ_KS_c[this]) + LaxusQ_CasterLightningHeight2, s__LaxusSpells___LaxusQ_KS_x[this], s__LaxusSpells___LaxusQ_KS_y[this], GetUnitFlyHeight(s__LaxusSpells___LaxusQ_KS_c[this]) + LaxusQ_CasterLightningHeight2)
                            endif
                            call s__GearSystems2__KS_DelayedSound_NextSound_Start(("war3mapimported\\Hero_Laxus_Q4" ) , (( 0.15)*1.0)) // INLINED!!
                            call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_tx-ha_nitu.mdl" , GetUnitX(s__LaxusSpells___LaxusQ_KS_c[this]) , GetUnitY(s__LaxusSpells___LaxusQ_KS_c[this]) , s__LaxusSpells___LaxusQ_KS_a[this] * bj_RADTODEG , 2.0 , 1.25 , 1.0 , 255 , 255 , 255 , 225))
                        endif

                        if s__LaxusSpells___LaxusQ_KS_r[this] > 0.03 then
                            if s__LaxusSpells___LaxusQ_KS_r[this] > LaxusQ2_CastTime then
                                if s__LaxusSpells___LaxusQ_KS_r4[this] > 0.00 then
                                    set s__LaxusSpells___LaxusQ_KS_r4[this]=0.0
                                    set s__LaxusSpells___LaxusQ_KS_move[this]=s__LaxusSpells___LaxusQ_KS_move[this] + 5.0
                                    if s__LaxusSpells___LaxusQ_KS_check2[this] == 0 then
                                        call s__GearSystems2__KS_RemoveEffect_MyRemoveEff_Start((EffectSpawn4("war3mapImported\\wos_krk (1849)2.mdx" , s__LaxusSpells___LaxusQ_KS_x[this] , s__LaxusSpells___LaxusQ_KS_y[this] , s__LaxusSpells___LaxusQ_KS_a[this] * bj_RADTODEG , 1.0 , 1.25 , 145.0 , - 90.0) ) , (( 0.5)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
                                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_bx_leidiandaji.mdx" , s__LaxusSpells___LaxusQ_KS_x[this] , s__LaxusSpells___LaxusQ_KS_y[this] , GetRandomReal(0.0, 359.0) , 1.5 , 2.0 , 1.0))
                                    else
                                        call s__GearSystems2__KS_RemoveEffect_MyRemoveEff_Start((EffectSpawn4("war3mapImported\\wos_krk (1849)4.mdx" , s__LaxusSpells___LaxusQ_KS_x[this] , s__LaxusSpells___LaxusQ_KS_y[this] , s__LaxusSpells___LaxusQ_KS_a[this] * bj_RADTODEG , 1.0 , 1.25 , 145.0 , - 90.0) ) , (( 0.5)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
                                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_bx_leidiandaji_red.mdx" , s__LaxusSpells___LaxusQ_KS_x[this] , s__LaxusSpells___LaxusQ_KS_y[this] , GetRandomReal(0.0, 359.0) , 1.5 , 2.0 , 1.0))
                                    endif
                                else
                                    set s__LaxusSpells___LaxusQ_KS_r4[this]=s__LaxusSpells___LaxusQ_KS_r4[this] + 0.03
                                endif
                            else
                                if s__LaxusSpells___LaxusQ_KS_r4[this] > 0.03 then
                                    set s__LaxusSpells___LaxusQ_KS_r4[this]=0.0
                                    if GetRandomInt(1, 2) == 1 then
                                        if s__LaxusSpells___LaxusQ_KS_check2[this] == 0 then
                                            call s__GearSystems2__KS_RemoveEffect_MyRemoveEff_Start((EffectSpawn4("war3mapImported\\wos_krk (1849)2.mdx" , s__LaxusSpells___LaxusQ_KS_x[this] , s__LaxusSpells___LaxusQ_KS_y[this] , s__LaxusSpells___LaxusQ_KS_a[this] * bj_RADTODEG + 90.0 , 1.0 , 1.0 , 145.0 , - 90.0) ) , (( 0.15)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
                                        else
                                            call s__GearSystems2__KS_RemoveEffect_MyRemoveEff_Start((EffectSpawn4("war3mapImported\\wos_krk (1849)4.mdx" , s__LaxusSpells___LaxusQ_KS_x[this] , s__LaxusSpells___LaxusQ_KS_y[this] , s__LaxusSpells___LaxusQ_KS_a[this] * bj_RADTODEG + 90.0 , 1.0 , 1.0 , 145.0 , - 90.0) ) , (( 0.15)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
                                        endif
                                    else
                                        if s__LaxusSpells___LaxusQ_KS_check2[this] == 0 then
                                            call s__GearSystems2__KS_RemoveEffect_MyRemoveEff_Start((EffectSpawn4("war3mapImported\\wos_krk (1849)2.mdx" , s__LaxusSpells___LaxusQ_KS_x[this] , s__LaxusSpells___LaxusQ_KS_y[this] , s__LaxusSpells___LaxusQ_KS_a[this] * bj_RADTODEG - 90.0 , 1.0 , 1.0 , 145.0 , - 90.0) ) , (( 0.15)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
                                        else
                                            call s__GearSystems2__KS_RemoveEffect_MyRemoveEff_Start((EffectSpawn4("war3mapImported\\wos_krk (1849)4.mdx" , s__LaxusSpells___LaxusQ_KS_x[this] , s__LaxusSpells___LaxusQ_KS_y[this] , s__LaxusSpells___LaxusQ_KS_a[this] * bj_RADTODEG - 90.0 , 1.0 , 1.0 , 145.0 , - 90.0) ) , (( 0.15)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
                                        endif
                                    endif
                                else
                                    set s__LaxusSpells___LaxusQ_KS_r4[this]=s__LaxusSpells___LaxusQ_KS_r4[this] + 0.03
                                endif
                            endif
                        endif

                        if s__LaxusSpells___LaxusQ_KS_r[this] < LaxusQ2_CastTime then
                            if LaxusQ2_IsInvul then
                                call DebugUnit(s__LaxusSpells___LaxusQ_KS_c[this])
                            else
                                call DebugUnit2(s__LaxusSpells___LaxusQ_KS_c[this])
                            endif
