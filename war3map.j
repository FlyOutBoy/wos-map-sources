        function s__NatsuSpells__NatsuFT_KS_NatsuFT_Start takes unit NewC,unit NewTd returns nothing
            local integer this= s__NatsuSpells__NatsuFT_KS__allocate()
            local real rr1= 100
            set s__NatsuSpells__NatsuFT_KS_MUI_NatsuFT=s__NatsuSpells__NatsuFT_KS_MUI_NatsuFT + 1
            set s__NatsuSpells__NatsuFT_KS_m_NatsuFT[s__NatsuSpells__NatsuFT_KS_MUI_NatsuFT]=this
            set s__NatsuSpells__NatsuFT_KS_c[this]=NewC
            set s__NatsuSpells__NatsuFT_KS_td[this]=NewTd
            set s__NatsuSpells__NatsuFT_KS_x[this]=GetUnitX(s__NatsuSpells__NatsuFT_KS_td[this])
            set s__NatsuSpells__NatsuFT_KS_y[this]=GetUnitY(s__NatsuSpells__NatsuFT_KS_td[this])
            set s__NatsuSpells__NatsuFT_KS_r[this]=0
            set s__NatsuSpells__NatsuFT_KS_r2[this]=10
            call StartSpellUnit(s__NatsuSpells__NatsuFT_KS_c[this])
            set s__NatsuSpells__NatsuFT_KS_rmax[this]=6
            set s__NatsuSpells__NatsuFT_KS_move[this]=120
            set s__NatsuSpells__NatsuFT_KS_check[this]=0
            set s__NatsuSpells__NatsuFT_KS_a[this]=GAngle2(s__NatsuSpells__NatsuFT_KS_c[this] , s__NatsuSpells__NatsuFT_KS_x[this] , s__NatsuSpells__NatsuFT_KS_y[this])
            set s__NatsuSpells__NatsuFT_KS_g[this]=CreateGroup()
            set s__NatsuSpells__NatsuFT_KS_g2[this]=CreateGroup()
            set s__NatsuSpells__NatsuFT_KS_aoe[this]=NatsuT_DamageAoe
            call SetUnitAnimationByIndex(s__NatsuSpells__NatsuFT_KS_c[this], 16)
            call SetUnitTimeScale(s__NatsuSpells__NatsuFT_KS_c[this], 1)
            set s__NatsuSpells__NatsuFT_KS_k2[this]=0
            set s__NatsuSpells__NatsuFT_KS_r5[this]=10
            set s__NatsuSpells__NatsuFT_KS_dmg[this]=GetHeroAgi(s__NatsuSpells__NatsuFT_KS_c[this], true) * NatsuFT_DamageAgiBase
            if LoadInteger(hs, GetHandleId(s__NatsuSpells__NatsuFT_KS_c[this]), StringHash("mode g")) > 0 then
           //     set dmg = dmg + GetHeroAgi(c, true) * NatsuGT_DamageAgiBonus
                set s__NatsuSpells__NatsuFT_KS_k2[this]=1
            endif
            call MakeSound("war3mapimported\\Hero_Natsu_FT1")
            set s__NatsuSpells__NatsuFT_KS_e[this]=AddSpecialEffectTarget("war3mapImported\\wos_File00000712.mdl", s__NatsuSpells__NatsuFT_KS_c[this], "hand right")
            set s__NatsuSpells__NatsuFT_KS_e2[this]=AddSpecialEffectTarget("war3mapImported\\wos_File00000712.mdl", s__NatsuSpells__NatsuFT_KS_c[this], "hand left")
            if s__NatsuSpells__NatsuFT_KS_MUI_NatsuFT == 0 then
                call TimerStart(s__NatsuSpells__NatsuFT_KS_t_NatsuFT, 0.03, true, function s__NatsuSpells__NatsuFT_KS_Loop_NatsuFT)
            endif
        endfunction

