                        call IssuePointOrder(s__GearSystems2__KS_Fear_c[this], "move", GetUnitX(s__GearSystems2__KS_Fear_c[this]) + 600 * Cos(s__GearSystems2__KS_Fear_a[this]), GetUnitY(s__GearSystems2__KS_Fear_c[this]) + 600 * Sin(s__GearSystems2__KS_Fear_a[this]))
                        call UnitAddAbility(s__GearSystems2__KS_Fear_c[this], 'Abun')
