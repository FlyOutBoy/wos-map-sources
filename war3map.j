        set AstaSpells___AstaTimer05Users=AstaSpells___AstaTimer05Users - 1
        if AstaSpells___AstaTimer05Users <= 0 then
            set AstaSpells___AstaTimer05Users=0
            call PauseTimer(AstaSpells___AstaTimer05)
        endif
    endfunction

