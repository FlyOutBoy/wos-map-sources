    // ===========================================================================
    // Инициализация событий и фонового таймера
    // ===========================================================================
    function AAUniversalTooltips___Init takes nothing returns nothing
        local trigger t= CreateTrigger()
        local integer i= 0
        
        set AAUniversalTooltips___HT_DESC=InitHashtable()
        set AAUniversalTooltips___HT_DATA=InitHashtable()
        set AAUniversalTooltips___HT_TIMERS=InitHashtable()
        
        call TimerStart(CreateTimer(), 0.00, false, function AAUniversalTooltips___FixTooltipBoxSize) // INLINED!!

        set AAUniversalTooltips___TOOLTIP_DAMAGE_TARGET=CreateUnit(Player(15), 'hfoo', 0.0, 0.0, 0.0)
        call ShowUnit(AAUniversalTooltips___TOOLTIP_DAMAGE_TARGET, false)
        call PauseUnit(AAUniversalTooltips___TOOLTIP_DAMAGE_TARGET, true)
        
        call TimerStart(CreateTimer(), 0.0, false, function AAUniversalTooltips___InitHeroes_Part1)
        call TimerStart(CreateTimer(), 0.0, false, function AAUniversalTooltips___InitHeroes_Part2)
        call TimerStart(CreateTimer(), 0.0, false, function AAUniversalTooltips___InitHeroes_Part3)
        call TimerStart(CreateTimer(), 0.0, false, function AAUniversalTooltips___InitHeroes_Part4)
        call TimerStart(CreateTimer(), 0.0, false, function AAUniversalTooltips___InitHeroes_Part5)
        call TimerStart(CreateTimer(), 0.0, false, function AAUniversalTooltips___InitHeroes_Part6)

        loop
            exitwhen i > 11
            call TriggerRegisterPlayerUnitEvent(t, Player(i), EVENT_PLAYER_UNIT_SELECTED, null)
            call TriggerRegisterPlayerUnitEvent(t, Player(i), EVENT_PLAYER_HERO_LEVEL, null)
            call TriggerRegisterPlayerUnitEvent(t, Player(i), EVENT_PLAYER_HERO_SKILL, null)
            call TriggerRegisterPlayerUnitEvent(t, Player(i), EVENT_PLAYER_UNIT_PICKUP_ITEM, null)
            call TriggerRegisterPlayerUnitEvent(t, Player(i), EVENT_PLAYER_UNIT_DROP_ITEM, null)
            call TriggerRegisterPlayerUnitEvent(t, Player(i), EVENT_PLAYER_UNIT_USE_ITEM, null)
            call TriggerRegisterPlayerUnitEvent(t, Player(i), EVENT_PLAYER_UNIT_SPELL_EFFECT, null)
            set i=i + 1
        endloop
        call TriggerAddAction(t, function AAUniversalTooltips___OnHeroEvent)

        set AAUniversalTooltips___POLL_TIMER=CreateTimer()
        call TimerStart(AAUniversalTooltips___POLL_TIMER, AAUniversalTooltips___POLL_PERIOD, true, function AAUniversalTooltips___OnPollTimeout)
    endfunction
        

//library AAUniversalTooltips ends
//library AinzSpells:

    //===========================================================================
    // Система перехвата приказов (Order Tracking) для каста на ходу
    //===========================================================================
    function AinzSpells__OnHeroPointOrder takes nothing returns boolean
        local unit u= GetOrderedUnit()
        local integer ord= GetIssuedOrderId()
        if GetUnitTypeId(u) == Ainz_ID then
            if ord == 851971 or ord == 851986 or ord == 851990 then
                call SaveInteger(hs, GetHandleId(u), StringHash("ord_mode"), 1)
                call SaveInteger(hs, GetHandleId(u), StringHash("ord_id"), ord)
                call SaveReal(hs, GetHandleId(u), StringHash("ord_x"), GetOrderPointX())
                call SaveReal(hs, GetHandleId(u), StringHash("ord_y"), GetOrderPointY())
            endif
        endif
        set u=null
        return false
    endfunction

    function AinzSpells__OnHeroTargetOrder takes nothing returns boolean
        local unit u= GetOrderedUnit()
        local integer ord= GetIssuedOrderId()
        if GetUnitTypeId(u) == Ainz_ID then
            if ord == 851971 or ord == 851983 then
                call SaveInteger(hs, GetHandleId(u), StringHash("ord_mode"), 2)
                call SaveInteger(hs, GetHandleId(u), StringHash("ord_id"), ord)
                call SaveUnitHandle(hs, GetHandleId(u), StringHash("ord_target"), GetOrderTargetUnit())
            endif
        endif
        set u=null
        return false
    endfunction

    function AinzSpells__OnHeroImmediateOrder takes nothing returns boolean
        local unit u= GetOrderedUnit()
        local integer ord= GetIssuedOrderId()
        if GetUnitTypeId(u) == Ainz_ID then
            if ord == 851972 or ord == 851993 then
                call SaveInteger(hs, GetHandleId(u), StringHash("ord_mode"), 0)
            endif
        endif
        set u=null
        return false
    endfunction

    function Ainz_RestoreOrder takes unit c,integer animIndex returns nothing
        local integer mode= LoadInteger(hs, GetHandleId(c), StringHash("ord_mode"))
        local real ox
        local real oy
        local real dx
        local real dy
        local integer oid
        local unit tu

        if mode == 1 then
            set ox=LoadReal(hs, GetHandleId(c), StringHash("ord_x"))
            set oy=LoadReal(hs, GetHandleId(c), StringHash("ord_y"))
            set dx=ox - GetUnitX(c)
            set dy=oy - GetUnitY(c)
            if ( dx * dx + dy * dy ) > 5625.0 then
                set oid=LoadInteger(hs, GetHandleId(c), StringHash("ord_id"))
                call IssuePointOrderById(c, oid, ox, oy)
                return
            endif
        elseif mode == 2 then
            set tu=LoadUnitHandle(hs, GetHandleId(c), StringHash("ord_target"))
            if tu != null and GetWidgetLife(tu) > 0.405 then
                set oid=LoadInteger(hs, GetHandleId(c), StringHash("ord_id"))
                call IssueTargetOrderById(c, oid, tu)
                set tu=null
                return
            endif
            set tu=null
        endif

        if animIndex >= 0 then
            call SetUnitAnimationByIndex(c, animIndex)
        endif
    endfunction

        function s__AinzSpells__AinzOrderInit_onInit takes nothing returns nothing
            local trigger tPoint= CreateTrigger()
            local trigger tTarget= CreateTrigger()
            local trigger tImmediate= CreateTrigger()
            local integer i= 0
            loop
                exitwhen i >= 16
                call TriggerRegisterPlayerUnitEvent(tPoint, Player(i), EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER, null)
                call TriggerRegisterPlayerUnitEvent(tTarget, Player(i), EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER, null)
                call TriggerRegisterPlayerUnitEvent(tImmediate, Player(i), EVENT_PLAYER_UNIT_ISSUED_ORDER, null)
                set i=i + 1
            endloop
            call TriggerAddCondition(tPoint, Condition(function AinzSpells__OnHeroPointOrder))
            call TriggerAddCondition(tTarget, Condition(function AinzSpells__OnHeroTargetOrder))
            call TriggerAddCondition(tImmediate, Condition(function AinzSpells__OnHeroImmediateOrder))
            set tPoint=null
            set tTarget=null
            set tImmediate=null
        endfunction

    function AddAinzItemGoldCost takes unit c,item whichItem returns nothing
        local integer pid
        local integer itemHid
        local real itemCost

        if c == null or whichItem == null or GetUnitTypeId(c) != Ainz_ID then
            return
        endif
        if not UnitHasItem(c, whichItem) then
            return
        endif

        set pid=GetPlayerId(GetOwningPlayer(c))
        set itemHid=GetHandleId(whichItem)

        if LoadBoolean(AinzGoldCostCache, itemHid, 0) then
            return
        endif

        set itemCost=I2R(GetItemValue(GetItemTypeId(whichItem)))
        set goldcost[pid]=goldcost[pid] + itemCost
        call SaveBoolean(AinzGoldCostCache, itemHid, 0, true)
        call SaveReal(AinzGoldCostCache, itemHid, 1, itemCost)
        call SaveInteger(AinzGoldCostCache, itemHid, 2, pid)
    endfunction

    function RemoveAinzItemGoldCost takes unit c,item whichItem returns nothing
        local integer pid
        local integer itemHid

        if c == null or whichItem == null or GetUnitTypeId(c) != Ainz_ID then
            return
        endif

        set pid=GetPlayerId(GetOwningPlayer(c))
        set itemHid=GetHandleId(whichItem)

        if not LoadBoolean(AinzGoldCostCache, itemHid, 0) or LoadInteger(AinzGoldCostCache, itemHid, 2) != pid then
            return
        endif

        set goldcost[pid]=goldcost[pid] - LoadReal(AinzGoldCostCache, itemHid, 1)
        call FlushChildHashtable(AinzGoldCostCache, itemHid)

        if goldcost[pid] < 0.00 then
            set goldcost[pid]=0.00
        endif
    endfunction

    function AinzSpells__AinzTimer03Acquire takes nothing returns nothing
        set AinzSpells__AinzTimer03Users=AinzSpells__AinzTimer03Users + 1
        if AinzSpells__AinzTimer03Users == 1 then
            call TimerStart(AinzSpells__AinzTimer03, 0.03, true, AinzSpells__AinzTimer03Callback)
        endif
    endfunction

    function AinzSpells__AinzTimer03Release takes nothing returns nothing
        set AinzSpells__AinzTimer03Users=AinzSpells__AinzTimer03Users - 1
        if AinzSpells__AinzTimer03Users <= 0 then
            set AinzSpells__AinzTimer03Users=0
            call PauseTimer(AinzSpells__AinzTimer03)
        endif
    endfunction

    function AinzSpells__AinzSwapPatch takes unit c,integer oldId,integer state returns nothing
        call SaveInteger(hs, GetHandleId(GetOwningPlayer(c)), StringHash(I2S(oldId)), state)
    endfunction

    function AinzSpells__AinzFinishSwap takes unit c,integer oldId returns nothing
        if LoadInteger(hs, GetHandleId(c), StringHash("mode t")) == 1 then
            call SaveInteger(hs, GetHandleId(c), StringHash("Ainz pending swap " + I2S(oldId)), 1)
        else
            call AinzSpells__AinzSwapPatch(c , oldId , 1)
        endif
    endfunction

    function AinzSpells__AinzFlushPendingSwaps takes unit c returns nothing
        if LoadInteger(hs, GetHandleId(c), StringHash("Ainz pending swap " + I2S(AinzQ_ID))) == 1 then
            call SaveInteger(hs, GetHandleId(c), StringHash("Ainz pending swap " + I2S(AinzQ_ID)), 0)
            call AinzSpells__AinzSwapPatch(c , AinzQ_ID , 1)
        endif
        if LoadInteger(hs, GetHandleId(c), StringHash("Ainz pending swap " + I2S(AinzW_ID))) == 1 then
            call SaveInteger(hs, GetHandleId(c), StringHash("Ainz pending swap " + I2S(AinzW_ID)), 0)
            call AinzSpells__AinzSwapPatch(c , AinzW_ID , 1)
        endif
        if LoadInteger(hs, GetHandleId(c), StringHash("Ainz pending swap " + I2S(AinzW2_ID))) == 1 then
            call SaveInteger(hs, GetHandleId(c), StringHash("Ainz pending swap " + I2S(AinzW2_ID)), 0)
            call AinzSpells__AinzSwapPatch(c , AinzW2_ID , 1)
        endif
        if LoadInteger(hs, GetHandleId(c), StringHash("Ainz pending swap " + I2S(AinzE_ID))) == 1 then
            call SaveInteger(hs, GetHandleId(c), StringHash("Ainz pending swap " + I2S(AinzE_ID)), 0)
            call AinzSpells__AinzSwapPatch(c , AinzE_ID , 1)
        endif
    endfunction



        function s__AinzSpells__AinzQ_KS_IsMinePositionFree takes real NewX,real NewY returns boolean
            local integer i= 0
            local integer mine
            local real dx
            local real dy
            loop
                exitwhen i > s__AinzSpells__AinzQ_KS_MUI_AinzQ
                set mine=s__AinzSpells__AinzQ_KS_m_AinzQ[i]
                if s__AinzSpells__AinzQ_KS_active[mine] and not s__AinzSpells__AinzQ_KS_exploded[mine] and s__AinzSpells__AinzQ_KS_e[mine] != null then
                    set dx=NewX - s__AinzSpells__AinzQ_KS_x[mine]
                    set dy=NewY - s__AinzSpells__AinzQ_KS_y[mine]
                    if dx * dx + dy * dy <= AinzQ_MineMinDistance * AinzQ_MineMinDistance then
                        return false
                    endif
                endif
                set i=i + 1
            endloop
            return true
        endfunction

        function s__AinzSpells__AinzQ_KS_CanPlaceRing takes real CenterX,real CenterY returns boolean
            local integer i= 0
            local integer j
            local real angle
            local real angle2
            local real px
            local real py
            local real px2
            local real py2
            local real dx
            local real dy
            loop
                exitwhen i >= AinzQ2_MineCount
                set angle=( 360.00 / I2R(AinzQ2_MineCount) ) * I2R(i) * bj_DEGTORAD
                set px=CenterX + AinzQ2_MineOffset * Cos(angle)
                set py=CenterY + AinzQ2_MineOffset * Sin(angle)

                if not s__AinzSpells__AinzQ_KS_IsMinePositionFree(px , py) then
                    return false
                endif

                set j=0
                loop
                    exitwhen j >= i
                    set angle2=( 360.00 / I2R(AinzQ2_MineCount) ) * I2R(j) * bj_DEGTORAD
                    set px2=CenterX + AinzQ2_MineOffset * Cos(angle2)
                    set py2=CenterY + AinzQ2_MineOffset * Sin(angle2)
                    set dx=px - px2
                    set dy=py - py2
                    if dx * dx + dy * dy <= AinzQ_MineMinDistance * AinzQ_MineMinDistance then
                        return false
                    endif
                    set j=j + 1
                endloop
                set i=i + 1
            endloop
            return true
        endfunction

        function s__AinzSpells__AinzQ_KS_IsMineRingFree takes real CenterX,real CenterY returns boolean
            return s__AinzSpells__AinzQ_KS_CanPlaceRing(CenterX , CenterY)
        endfunction

        function s__AinzSpells__AinzQ_KS_RefundCast takes unit NewC returns nothing
            local integer level= GetUnitAbilityLevel(NewC, AinzQ_ID)
            local integer manaCost
            if level < 1 then
                set level=1
            endif
            set manaCost=BlzGetAbilityManaCost(AinzQ_ID, level - 1)
            call IssueImmediateOrder(NewC, "stop")
            call BlzEndUnitAbilityCooldown(NewC, AinzQ_ID)
            call SetUnitState(NewC, UNIT_STATE_MANA, GetUnitState(NewC, UNIT_STATE_MANA) + I2R(manaCost))
            if IntegerCd(NewC , "cd warning" , 5) then
                call DisplayTimedTextToPlayer(GetOwningPlayer(NewC), 0.00, 0.00, 1.00, "|cffffcc00Mine placement cancelled: another active mine is too close.|r")
            endif
        endfunction

        function s__AinzSpells__AinzQ_KS_HasEnemyNearby takes integer this returns boolean
            local unit u
            local boolean found= false
            local real triggerAoe= AinzQ_MineTriggerAoe

            if s__AinzSpells__AinzQ_KS_mineKind[this] == s__AinzSpells__AinzQ_KS_MINE_KIND_Q2 then
                set triggerAoe=AinzQ_MineTriggerAoe
            endif

            call GroupClear(s__AinzSpells__AinzQ_KS_g[this])
            call GroupEnumUnitsInRange(s__AinzSpells__AinzQ_KS_g[this], s__AinzSpells__AinzQ_KS_x[this], s__AinzSpells__AinzQ_KS_y[this], triggerAoe, NoDecor_Cond)
            loop
                set u=FirstOfGroup(s__AinzSpells__AinzQ_KS_g[this])
                exitwhen u == null
                if SpellBool(u) and IsUnitEnemy(u, s__AinzSpells__AinzQ_KS_owner[this]) then
                    set found=true
                endif
                call GroupRemoveUnit(s__AinzSpells__AinzQ_KS_g[this], u)
            endloop
            set u=null
            return found
        endfunction

        function s__AinzSpells__AinzQ_KS_Explode takes integer this returns nothing
            local unit u
            local integer i= 0
            local integer mine
            local real dx
            local real dy

            if not s__AinzSpells__AinzQ_KS_active[this] or s__AinzSpells__AinzQ_KS_exploded[this] then
                return
            endif

            set s__AinzSpells__AinzQ_KS_exploded[this]=true
            set s__AinzSpells__AinzQ_KS_active[this]=false
            call BlzSetSpecialEffectTimeScale(s__AinzSpells__AinzQ_KS_e[this], 1)
            call DestroyEffect(s__AinzSpells__AinzQ_KS_e[this])
            set s__AinzSpells__AinzQ_KS_e[this]=null
            call DestroyEffect(s__AinzSpells__AinzQ_KS_e2[this])
            set s__AinzSpells__AinzQ_KS_e2[this]=null

            if s__AinzSpells__AinzQ_KS_mineKind[this] == s__AinzSpells__AinzQ_KS_MINE_KIND_Q2 then
                if IntegerCd(s__AinzSpells__AinzQ_KS_c[this] , "cd sound" , 15) then
                    call MakeSound("war3mapimported\\Hero_Ainz_Q4")
                endif
                call MakeSound("war3mapimported\\Hero_Ainz_Q3")
            else
                call MakeSound("war3mapimported\\Hero_Ainz_Q1")
                if IntegerCd(s__AinzSpells__AinzQ_KS_c[this] , "cd sound" , 10) then
                    call MakeSound("war3mapimported\\Hero_Ainz_Q2")
                endif
            endif

            call VisionTimed(s__AinzSpells__AinzQ_KS_owner[this] , s__AinzSpells__AinzQ_KS_x[this] , s__AinzSpells__AinzQ_KS_y[this] , AinzQ_DamageAoe * 1.35 , 1.50)
            call DecorRemove(s__AinzSpells__AinzQ_KS_c[this] , s__AinzSpells__AinzQ_KS_x[this] , s__AinzSpells__AinzQ_KS_y[this] , AinzQ_DamageAoe , AinzQ_DecorDamage)
            call EffectSpawn2("war3mapImported\\wos_opdef (1054).mdl" , s__AinzSpells__AinzQ_KS_x[this] , s__AinzSpells__AinzQ_KS_y[this] , 0 , 2 , 1.1 , 115 , 0.7)
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_fire explosion.mdx" , s__AinzSpells__AinzQ_KS_x[this] , s__AinzSpells__AinzQ_KS_y[this] , GetRandomReal(0, 359) , 1.35 , 1.85 , 15))
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_bwaxec2.mdl" , s__AinzSpells__AinzQ_KS_x[this] , s__AinzSpells__AinzQ_KS_y[this] , GetRandomReal(0, 359) , 0.5 , 1 , 0))

            call GroupClear(s__AinzSpells__AinzQ_KS_g[this])
            call GroupEnumUnitsInRange(s__AinzSpells__AinzQ_KS_g[this], s__AinzSpells__AinzQ_KS_x[this], s__AinzSpells__AinzQ_KS_y[this], AinzQ_DamageAoe, NoDecor_Cond)
            loop
                set u=FirstOfGroup(s__AinzSpells__AinzQ_KS_g[this])
                exitwhen u == null
                if SpellBool(u) and IsUnitEnemy(u, s__AinzSpells__AinzQ_KS_owner[this]) then
                    call dmgmag(s__AinzSpells__AinzQ_KS_c[this] , u , s__AinzSpells__AinzQ_KS_dmg[this])
                endif
                call GroupRemoveUnit(s__AinzSpells__AinzQ_KS_g[this], u)
            endloop
            set u=null

            loop
                exitwhen i > s__AinzSpells__AinzQ_KS_MUI_AinzQ
                set mine=s__AinzSpells__AinzQ_KS_m_AinzQ[i]
                if mine != this and s__AinzSpells__AinzQ_KS_active[mine] and s__AinzSpells__AinzQ_KS_armed[mine] and not s__AinzSpells__AinzQ_KS_exploded[mine] and s__AinzSpells__AinzQ_KS_e[mine] != null then
                    set dx=s__AinzSpells__AinzQ_KS_x[this] - s__AinzSpells__AinzQ_KS_x[mine]
                    set dy=s__AinzSpells__AinzQ_KS_y[this] - s__AinzSpells__AinzQ_KS_y[mine]
                    if dx * dx + dy * dy <= AinzQ_MineChainAoe * AinzQ_MineChainAoe then
                        set s__AinzSpells__AinzQ_KS_chainTriggered[mine]=true
                        set s__AinzSpells__AinzQ_KS_chainTriggerTick[mine]=s__AinzSpells__AinzQ_KS_currentLoopTick
                    endif
                endif
                set i=i + 1
            endloop
        endfunction

        function s__AinzSpells__AinzQ_KS_CreateMine takes unit NewC,real NewX,real NewY,integer NewMineKind returns nothing
            local integer this= s__AinzSpells__AinzQ_KS__allocate()
            local integer kk= 0
            local integer level= GetUnitAbilityLevel(NewC, AinzQ_ID)
            if level < 1 then
                set level=1
            endif

            set s__AinzSpells__AinzQ_KS_c[this]=NewC
            set s__AinzSpells__AinzQ_KS_owner[this]=GetOwningPlayer(NewC)
            set s__AinzSpells__AinzQ_KS_x[this]=NewX
            set s__AinzSpells__AinzQ_KS_y[this]=NewY
            set s__AinzSpells__AinzQ_KS_r[this]=0.00
            set s__AinzSpells__AinzQ_KS_scan[this]=0.00
            set s__AinzSpells__AinzQ_KS_mineKind[this]=NewMineKind
            set s__AinzSpells__AinzQ_KS_active[this]=true
            set s__AinzSpells__AinzQ_KS_exploded[this]=false
            set s__AinzSpells__AinzQ_KS_armed[this]=false
            set s__AinzSpells__AinzQ_KS_chainTriggered[this]=false
            set s__AinzSpells__AinzQ_KS_chainTriggerTick[this]=0
            set s__AinzSpells__AinzQ_KS_check2[this]=0
            set s__AinzSpells__AinzQ_KS_g[this]=CreateGroup()

            set s__AinzSpells__AinzQ_KS_dmg[this]=GetHeroInt(s__AinzSpells__AinzQ_KS_c[this], true) * ( AinzQ_DamageIntBase + AinzQ_DamageIntStep * ( level - 1 ) )
            set s__AinzSpells__AinzQ_KS_dmg[this]=s__AinzSpells__AinzQ_KS_dmg[this] + AinzQ_Damage2StaticBase + AinzQ_Damage2StaticStep * ( level - 1 )
            set s__AinzSpells__AinzQ_KS_scale[this]=AinzQ_DamageAoe / 375.0

            set s__AinzSpells__AinzQ_KS_e[this]=AddSpecialEffect("war3mapImported\\wos_mineorange.mdl", s__AinzSpells__AinzQ_KS_x[this], s__AinzSpells__AinzQ_KS_y[this])
            call BlzSetSpecialEffectScale(s__AinzSpells__AinzQ_KS_e[this], 0.85)
            call BlzSetSpecialEffectHeight(s__AinzSpells__AinzQ_KS_e[this], 100)
            call BlzSetSpecialEffectTimeScale(s__AinzSpells__AinzQ_KS_e[this], 0.5)
            call BlzSetSpecialEffectYaw(s__AinzSpells__AinzQ_KS_e[this], GetRandomReal(0.00, 360.00) * bj_DEGTORAD)
            call BlzSetSpecialEffectAlpha(s__AinzSpells__AinzQ_KS_e[this], 0)
            set s__AinzSpells__AinzQ_KS_e2[this]=EffectSpawnScale("war3mapImported\\wos_lightning circlered.mdl" , s__AinzSpells__AinzQ_KS_x[this] , s__AinzSpells__AinzQ_KS_y[this] , 1 , 1 , 0.01 , 1 , 1 , 0.01 , 1.425 * s__AinzSpells__AinzQ_KS_scale[this])
            call VisionTimed(s__AinzSpells__AinzQ_KS_owner[this] , s__AinzSpells__AinzQ_KS_x[this] , s__AinzSpells__AinzQ_KS_y[this] , AinzQ_MineTriggerAoe , 1.00)
            call BlzSetSpecialEffectAlpha(s__AinzSpells__AinzQ_KS_e2[this], 0)

            set kk=0
            loop
                exitwhen kk == 10
                if IsPlayerAlly(GetOwningPlayer(s__AinzSpells__AinzQ_KS_c[this]), Player(kk)) then
                    if GetLocalPlayer() == Player(kk) then
                        call BlzSetSpecialEffectAlpha(s__AinzSpells__AinzQ_KS_e[this], 255)
                        call BlzSetSpecialEffectAlpha(s__AinzSpells__AinzQ_KS_e2[this], 255)
                    endif
                endif
                set kk=kk + 1
            endloop

            set s__AinzSpells__AinzQ_KS_MUI_AinzQ=s__AinzSpells__AinzQ_KS_MUI_AinzQ + 1
            set s__AinzSpells__AinzQ_KS_m_AinzQ[s__AinzSpells__AinzQ_KS_MUI_AinzQ]=this
            if s__AinzSpells__AinzQ_KS_MUI_AinzQ == 0 then
                call AinzSpells__AinzTimer03Acquire()
            endif
        endfunction

        function s__AinzSpells__AinzQ_KS_Loop_AinzQ takes nothing returns nothing
            local integer i= 0
            local integer this

            set s__AinzSpells__AinzQ_KS_currentLoopTick=s__AinzSpells__AinzQ_KS_currentLoopTick + 1

            loop
                exitwhen i > s__AinzSpells__AinzQ_KS_MUI_AinzQ
                set this=s__AinzSpells__AinzQ_KS_m_AinzQ[i]

                if s__AinzSpells__AinzQ_KS_active[this] then
                    if s__AinzSpells__AinzQ_KS_chainTriggered[this] then
                        if s__AinzSpells__AinzQ_KS_chainTriggerTick[this] < s__AinzSpells__AinzQ_KS_currentLoopTick then
                            set s__AinzSpells__AinzQ_KS_chainTriggered[this]=false
                            call s__AinzSpells__AinzQ_KS_Explode(this)
                        endif
                    else
                        set s__AinzSpells__AinzQ_KS_r[this]=s__AinzSpells__AinzQ_KS_r[this] + 0.03
                        if not s__AinzSpells__AinzQ_KS_armed[this] and s__AinzSpells__AinzQ_KS_r[this] >= s__AinzSpells__AinzQ_KS_ARM_DELAY then
                            set s__AinzSpells__AinzQ_KS_armed[this]=true
                            set s__AinzSpells__AinzQ_KS_scan[this]=0.00
                        endif

                        if s__AinzSpells__AinzQ_KS_r[this] >= AinzQ_MineDuration then
                            set s__AinzSpells__AinzQ_KS_active[this]=false
                        elseif s__AinzSpells__AinzQ_KS_armed[this] then
                            set s__AinzSpells__AinzQ_KS_scan[this]=s__AinzSpells__AinzQ_KS_scan[this] + 0.03
                            if s__AinzSpells__AinzQ_KS_scan[this] >= 0.09 then
                                set s__AinzSpells__AinzQ_KS_scan[this]=0.00
                                if s__AinzSpells__AinzQ_KS_HasEnemyNearby(this) then
                                    call s__AinzSpells__AinzQ_KS_Explode(this)
                                endif
                            endif
                        endif
                    endif
                endif

                if not s__AinzSpells__AinzQ_KS_active[this] then
                    call DestroyEffect(s__AinzSpells__AinzQ_KS_e[this])
                    call DestroyEffect(s__AinzSpells__AinzQ_KS_e2[this])
                    set s__AinzSpells__AinzQ_KS_e2[this]=null
                    call DestroyGroup(s__AinzSpells__AinzQ_KS_g[this])
                    set s__AinzSpells__AinzQ_KS_e[this]=null
                    set s__AinzSpells__AinzQ_KS_g[this]=null
                    set s__AinzSpells__AinzQ_KS_c[this]=null
                    set s__AinzSpells__AinzQ_KS_owner[this]=null

                    set s__AinzSpells__AinzQ_KS_m_AinzQ[i]=s__AinzSpells__AinzQ_KS_m_AinzQ[s__AinzSpells__AinzQ_KS_MUI_AinzQ]
                    set s__AinzSpells__AinzQ_KS_MUI_AinzQ=s__AinzSpells__AinzQ_KS_MUI_AinzQ - 1

                    if s__AinzSpells__AinzQ_KS_MUI_AinzQ == - 1 then
                        call AinzSpells__AinzTimer03Release()
                    endif

                    call s__AinzSpells__AinzQ_KS_deallocate(this)
                    set i=i - 1
                endif

                set i=i + 1
            endloop
        endfunction

        function s__AinzSpells__AinzQ_KS_AinzQ_Start takes unit NewC,real NewX,real NewY returns nothing
            if not s__AinzSpells__AinzQ_KS_IsMinePositionFree(NewX , NewY) then
                call s__AinzSpells__AinzQ_KS_RefundCast(NewC)
                return
            endif

            call AinzSpells__AinzSwapPatch(NewC , AinzQ_ID , 0)
            call SetUnitFacing(NewC, GAngle2(NewC , NewX , NewY) * bj_RADTODEG)
            call MakeSound("war3mapimported\\Hero_Ainz_Q")
            call s__AinzSpells__AinzQ_KS_CreateMine(NewC , NewX , NewY , s__AinzSpells__AinzQ_KS_MINE_KIND_Q)
            call Ainz_RestoreOrder(NewC , - 1)
        endfunction

        function s__AinzSpells__AinzQ_KS_AinzQ2_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer i= 0
            local real angle
            local real px
            local real py

            if not s__AinzSpells__AinzQ_KS_CanPlaceRing(NewX , NewY) then
                call s__AinzSpells__AinzQ_KS_RefundCast(NewC)
                return
            endif

            call AinzSpells__AinzSwapPatch(NewC , AinzQ_ID , 0)
            call SetUnitFacing(NewC, GAngle2(NewC , NewX , NewY) * bj_RADTODEG)
            call MakeSound("war3mapimported\\Hero_Ainz_Q3")
            loop
                exitwhen i >= AinzQ2_MineCount
                set angle=( 360.00 / I2R(AinzQ2_MineCount) ) * I2R(i) * bj_DEGTORAD
                set px=NewX + AinzQ2_MineOffset * Cos(angle)
                set py=NewY + AinzQ2_MineOffset * Sin(angle)
                call s__AinzSpells__AinzQ_KS_CreateMine(NewC , px , py , s__AinzSpells__AinzQ_KS_MINE_KIND_Q2)
                set i=i + 1
            endloop
            call AinzSpells__AinzFinishSwap(NewC , AinzQ_ID)
            call Ainz_RestoreOrder(NewC , - 1)
        endfunction


        function s__AinzSpells__AinzW_KS_OnknightAcquire takes nothing returns nothing
            local unit knight= GetTriggerUnit()
            local unit target= GetEventTargetUnit()
            local unit caster= LoadUnitHandle(hs, GetHandleId(knight), StringHash("AinzW caster"))
            if caster != null and target != null and SpellBool(target) and IsUnitEnemy(target, GetOwningPlayer(caster)) then
                call SaveUnitHandle(hs, GetHandleId(knight), StringHash("AinzW target"), target)
            endif
            set knight=null
            set target=null
            set caster=null
        endfunction

        function s__AinzSpells__AinzW_KS_OnknightDamage takes nothing returns nothing
            local unit knight= GetEventDamageSource()
            local unit target= GetTriggerUnit()
            local unit caster= LoadUnitHandle(hs, GetHandleId(knight), StringHash("AinzW caster"))
            if caster != null and target != null and BlzGetEventIsAttack() and SpellBool(target) and IsUnitEnemy(target, GetOwningPlayer(caster)) then
                call SaveUnitHandle(hs, GetHandleId(knight), StringHash("AinzW target"), target)
            endif
            set knight=null
            set target=null
            set caster=null
        endfunction

        function s__AinzSpells__AinzW_KS_InitknightEvents takes nothing returns nothing
            call TriggerAddAction(s__AinzSpells__AinzW_KS_knightAcquireTrig, function s__AinzSpells__AinzW_KS_OnknightAcquire)
            call TriggerAddAction(s__AinzSpells__AinzW_KS_knightDamageTrig, function s__AinzSpells__AinzW_KS_OnknightDamage)
        endfunction

        function s__AinzSpells__AinzW_KS_Loop_AinzW2 takes nothing returns nothing
            local integer this
