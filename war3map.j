                            call ColorEffDummy3(EffectSpawn("war3mapimported\\wos_yc_firebeam2.mdx" , s__FrierenSpells__FrierenSpells_E_x[this] , s__FrierenSpells__FrierenSpells_E_y[this] , GetRandomReal(0, 359) , 1.35 , 0.82 , 0) , 0.3 , 255 , 255 , 255 , 0.5)
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_tx033_5.mdl" , s__FrierenSpells__FrierenSpells_E_x[this] , s__FrierenSpells__FrierenSpells_E_y[this] , 1 , 2 , 1.75 , 1))
