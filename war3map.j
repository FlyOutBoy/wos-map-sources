function OnClickFrameLink takes nothing returns nothing
    local framehandle clicked= BlzGetTriggerFrame()
    local integer i= 0
    local integer i2= 0
    local player p= GetTriggerPlayer()
    local integer pid= GetPlayerId(p)
    local real x= 0.025
    local real y= - 0.05
    local integer k= 0
    if clicked == FRAME_LINK2 then
        if GetLocalPlayer() == p then
        call BlzFrameSetText(FRAME_LINK, "")
        call BlzFrameSetVisible(FRAME_LINK2, false)
        call BlzFrameSetVisible(FRAME_LINK, true)
        call BlzFrameSetVisible(FRAME_LINK4, true)
        call BlzFrameSetVisible(FRAME_LINK5, true)
        call BlzFrameSetVisible(FRAME_LINK3, true)
        call BlzFrameSetText(FRAME_LINK, "discord.gg/wos2")
        endif
    endif
     if clicked == FRAME_Chat1 or clicked == FRAME_Chat2 or clicked == FRAME_Chat3 or clicked == FRAME_Chat4 or clicked == FRAME_Chat5 or clicked == FRAME_Chat6 then
     if clicked == FRAME_Chat1 then
     call s__GearSystems2__KS_RemoveEffect_MyRemoveEff_Start((AddSpecialEffectTarget("war3mapimported\\wos_emoji_11.mdx", Hero[pid], "origin") ) , (( 3.5)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
     elseif clicked == FRAME_Chat2 then
     call s__GearSystems2__KS_RemoveEffect_MyRemoveEff_Start((AddSpecialEffectTarget("war3mapimported\\wos_emoji_3.mdx", Hero[pid], "origin") ) , (( 3.5)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
     elseif clicked == FRAME_Chat3 then
     call s__GearSystems2__KS_RemoveEffect_MyRemoveEff_Start((AddSpecialEffectTarget("war3mapimported\\wos_emoji_5.mdx", Hero[pid], "origin") ) , (( 3.5)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
     elseif clicked == FRAME_Chat4 then
     call s__GearSystems2__KS_RemoveEffect_MyRemoveEff_Start((AddSpecialEffectTarget("war3mapimported\\wos_emoji_7.mdx", Hero[pid], "origin") ) , (( 3.5)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
     elseif clicked == FRAME_Chat5 then
     call s__GearSystems2__KS_RemoveEffect_MyRemoveEff_Start((AddSpecialEffectTarget("war3mapimported\\wos_emoji_8.mdx", Hero[pid], "origin") ) , (( 3.5)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
     elseif clicked == FRAME_Chat6 then
     call s__GearSystems2__KS_RemoveEffect_MyRemoveEff_Start((AddSpecialEffectTarget("war3mapimported\\wos_emoji_9.mdx", Hero[pid], "origin") ) , (( 3.5)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
     endif
     call SaveInteger(hs, GetHandleId(p), StringHash("chat cd"), 1)
     call s__GearSystems2__KS_Flush_Start((GetHandleId(p) ) , ( StringHash("chat cd") ) , ( 0 ) , (( 3.25)*1.0)) // INLINED!!
        set Chat_Active[pid]=false
        if GetLocalPlayer() == p then
        call BlzFrameSetVisible(FRAME_Chat0, false)
        endif
    endif
    if clicked == FRAME_LINK4 then
    if GetLocalPlayer() == p then
        call BlzFrameSetText(FRAME_LINK, "discord.gg/wos2")
        call BlzFrameSetVisible(FRAME_LINK, false)
        call BlzFrameSetVisible(FRAME_LINK4, false)
        call BlzFrameSetVisible(FRAME_LINK5, false)
        call BlzFrameSetVisible(FRAME_LINK2, true)
        call BlzFrameSetVisible(FRAME_LINK3, true)
        endif
    endif
    set clicked=null
    set p=null
endfunction
    function CreateStatusHeroUI takes nothing returns nothing
        local integer i= 0
        local integer i2= 0
        local integer k= 0
        local real x= heroicon__STATUS_LEFT_FIRST
        local real y= 0.00
        local real r= 0.1
        local real r1= 0.1
        local real r2= 0.1
        local real r3= 0.1
        local real rkek= 1
        local real rkek2= 0
        local real rkek3= 0
        local real rkek4= 0
        local framehandle border
        if heroicon__StatusHeroUICreated then
            return
        endif
        set heroicon__StatusHeroUICreated=true
