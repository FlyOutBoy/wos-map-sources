call SetCameraFieldForPlayer(Player(i), CAMERA_FIELD_FARZ, 50000, 0)
call PanCameraToTimedForPlayer(Player(i), GetRectCenterX(gg_rct_Base), GetRectCenterY(gg_rct_Base), 0)
set i=i + 1
