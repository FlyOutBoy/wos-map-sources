                    if s__AstaSpells___AstaSpells_F_r3[this] > 0.16 then
                        set s__AstaSpells___AstaSpells_F_r3[this]=0.0
                        call s__GearSystems2__KS_MoveEffectToUnit_MoveEffectToUnit_Start((EffectSpawn("war3mapimported\\wos_krk (1971).mdl" , GetUnitX(s__AstaSpells___AstaSpells_F_c[this]) , GetUnitY(s__AstaSpells___AstaSpells_F_c[this]) , GetRandomReal(0, 359) , 0.90 , 1.25 , 1) ) , (( 1.25 )*1.0) , (( 0 )*1.0) , ( s__AstaSpells___AstaSpells_F_c[this]) , 0 , 1 , null) // INLINED!!
                    else
                        set s__AstaSpells___AstaSpells_F_r3[this]=s__AstaSpells___AstaSpells_F_r3[this] + 0.03
                    endif
                    if s__AstaSpells___AstaSpells_F_r2[this] > AstaF_Interval then
                        set s__AstaSpells___AstaSpells_F_r2[this]=0.0
                        set s__AstaSpells___AstaSpells_F_r5[this]=0.0
                        call GroupEnumUnitsInRange(s__AstaSpells___AstaSpells_F_g[this], s__AstaSpells___AstaSpells_F_x[this], s__AstaSpells___AstaSpells_F_y[this], s__AstaSpells___AstaSpells_F_aoe[this], Condition(function NoDecor_Filter))
