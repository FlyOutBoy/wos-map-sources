                    else
                      //  call BlzSetSpecialEffectYaw(e, GetUnitFacing(d) * bj_DEGTORAD)
                        if true then // GetUnitTypeId(d) == Brandish_ID and check == LoadInteger(hs, GetHandleId(d), StringHash("brandish e")) then
                            if LoadInteger(hs, GetHandleId(s__GearSystems2__KS_MoveEffectToUnit_d[this]), StringHash("brandish g ally")) > 0 then
                                set rr=30
                               // call BlzSetSpecialEffectScale(e, 1.65 * (BrandishG_DamageOutputIncreaseScale / 100) )
                            else
                              //  call BlzSetSpecialEffectScale(e, 1.65 )
                            endif
                        endif
                        call EffVision(s__GearSystems2__KS_MoveEffectToUnit_e[this] , s__GearSystems2__KS_MoveEffectToUnit_d[this])
                        call BlzSetSpecialEffectPosition(s__GearSystems2__KS_MoveEffectToUnit_e[this], GetUnitX(s__GearSystems2__KS_MoveEffectToUnit_d[this]), GetUnitY(s__GearSystems2__KS_MoveEffectToUnit_d[this]), GetUnitFlyHeight(s__GearSystems2__KS_MoveEffectToUnit_d[this]) + s__GearSystems2__KS_MoveEffectToUnit_f[this] + rr)
                    endif
                else
