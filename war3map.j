                                set s__ErzaRSpells__Erza4F_KS_frame_pas5[s__ErzaRSpells__Erza4F_KS_k2[this]]=BlzCreateFrameByType("TEXT", "MyPlayerName", s__ErzaRSpells__Erza4F_KS_frame_pas1[s__ErzaRSpells__Erza4F_KS_k2[this]], "", 0)
                                call BlzFrameSetAbsPoint(s__ErzaRSpells__Erza4F_KS_frame_pas5[s__ErzaRSpells__Erza4F_KS_k2[this]], FRAMEPOINT_CENTER, 0.07 + s__ErzaRSpells__Erza4F_KS_r6[this], 0.185)
                                call BlzFrameSetText(s__ErzaRSpells__Erza4F_KS_frame_pas5[s__ErzaRSpells__Erza4F_KS_k2[this]], "|c00FFFF00Elemental swords:|r")
                                call BlzFrameSetScale(s__ErzaRSpells__Erza4F_KS_frame_pas5[s__ErzaRSpells__Erza4F_KS_k2[this]], 0.9)
                                set s__ErzaRSpells__Erza4F_KS_frame_pas6[s__ErzaRSpells__Erza4F_KS_k2[this]]=BlzCreateFrameByType("TEXT", "MyPlayerName", s__ErzaRSpells__Erza4F_KS_frame_pas1[s__ErzaRSpells__Erza4F_KS_k2[this]], "", 0)
                                call BlzFrameSetAbsPoint(s__ErzaRSpells__Erza4F_KS_frame_pas6[s__ErzaRSpells__Erza4F_KS_k2[this]], FRAMEPOINT_CENTER, 0.07 + s__ErzaRSpells__Erza4F_KS_r6[this], 0.17)
                                call BlzFrameSetText(s__ErzaRSpells__Erza4F_KS_frame_pas6[s__ErzaRSpells__Erza4F_KS_k2[this]], "|c00FFFF00" + R2SW(0, 0, 2) + "|r")
                                call BlzFrameSetScale(s__ErzaRSpells__Erza4F_KS_frame_pas6[s__ErzaRSpells__Erza4F_KS_k2[this]], 0.9)
