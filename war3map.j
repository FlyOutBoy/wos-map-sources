                    set s__RoundSpells__RoundEnd_r[this]=s__RoundSpells__RoundEnd_r[this] + 1
                    if s__RoundSpells__RoundEnd_r[this] == 5 then
                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_hakkestart.mdx" , GetUnitX(s__RoundSpells__RoundEnd_c[this]) - 350 * Cos(s__RoundSpells__RoundEnd_a[this]) , GetUnitY(s__RoundSpells__RoundEnd_c[this]) - 350 * Sin(s__RoundSpells__RoundEnd_a[this]) , s__RoundSpells__RoundEnd_a[this] * bj_RADTODEG , 0.15 , 1.8 , 0))
                    elseif s__RoundSpells__RoundEnd_r[this] == 6 then
                        set s__RoundSpells__RoundEnd_e[this]=EffectSpawn("war3mapImported\\wos_SukunaDomain.mdx" , GetUnitX(s__RoundSpells__RoundEnd_c[this]) - 350 * Cos(s__RoundSpells__RoundEnd_a[this]) , GetUnitY(s__RoundSpells__RoundEnd_c[this]) - 350 * Sin(s__RoundSpells__RoundEnd_a[this]) , s__RoundSpells__RoundEnd_a[this] * bj_RADTODEG , 1 , 6.5 , 0)
                    elseif s__RoundSpells__RoundEnd_r[this] == 7 then
                        call PlayersMsg("|c00FF0303Author:|r Struggle if you wish. Destruction is inevitable." , 2)
                        set s__RoundSpells__RoundEnd_e2[this]=EffectSpawnScale("war3mapImported\\wos_OuterCircleRed.mdl" , GetUnitX(s__RoundSpells__RoundEnd_c[this]) , GetUnitY(s__RoundSpells__RoundEnd_c[this]) , s__RoundSpells__RoundEnd_a[this] * bj_RADTODEG , 1 , 22 , 1 , 59 , 22 , 6)
                        set s__RoundSpells__RoundEnd_e4[this]=EffectSpawnScale("war3mapImported\\wos_SukunaDomainArea2.mdl" , GetUnitX(s__RoundSpells__RoundEnd_c[this]) , GetUnitY(s__RoundSpells__RoundEnd_c[this]) , s__RoundSpells__RoundEnd_a[this] * bj_RADTODEG , 1 , 1.92 , 10 , 59 , 1.92 , 0.54)
                        call BlzSetSpecialEffectAlpha(s__RoundSpells__RoundEnd_e4[this], 125)
                    endif
                    if s__RoundSpells__RoundEnd_r[this] > 6 then
                        set s__RoundSpells__RoundEnd_k[this]=0
                        loop
                            exitwhen s__RoundSpells__RoundEnd_k[this] == 10
                            set s__RoundSpells__RoundEnd_r4[this]=GetRandomReal(0.45, 1)
                            set s__RoundSpells__RoundEnd_r5[this]=GetRandomReal(- 0.35, - 0.15)
                            set s__RoundSpells__RoundEnd_r6[this]=GetRandomReal(150, 650)
                            call DestroyEffect(EffectSpawn3("war3mapImported\\wos_az_jingzi_jiansheng01_e1_l2.mdl" , s__RoundSpells__RoundEnd_x[this] + ( s__RoundSpells__RoundEnd_aoe[this] * 1.25 ) * Cos(s__RoundSpells__RoundEnd_k[this] * 36 * bj_DEGTORAD) , s__RoundSpells__RoundEnd_y[this] + ( s__RoundSpells__RoundEnd_aoe[this] * 1.25 ) * Sin(s__RoundSpells__RoundEnd_k[this] * 36 * bj_DEGTORAD) , GetRandomReal(0, 359) , s__RoundSpells__RoundEnd_r4[this] , 1.2 , 155 , s__RoundSpells__RoundEnd_r5[this]))
                            call VisionTimed(Player(s__RoundSpells__RoundEnd_k[this]) , s__RoundSpells__RoundEnd_x[this] , s__RoundSpells__RoundEnd_y[this] , s__RoundSpells__RoundEnd_aoe[this] , 1)
                            set s__RoundSpells__RoundEnd_k[this]=s__RoundSpells__RoundEnd_k[this] + 1
                        endloop
                        set s__RoundSpells__RoundEnd_k[this]=0
                        if s__RoundSpells__RoundEnd_k2[this] != 0 then
                            loop
                                exitwhen s__RoundSpells__RoundEnd_k[this] >= s__RoundSpells__RoundEnd_k2[this]
                                call DestroyEffect(EffectSpawn("war3mapImported\\wos_1hongse_2red.mdl" , s__RoundSpells__RoundEnd_x[this] + ( s__RoundSpells__RoundEnd_aoe[this] ) * Cos(s__RoundSpells__RoundEnd_k[this] * ( 360 / s__RoundSpells__RoundEnd_k2[this] ) * bj_DEGTORAD) , s__RoundSpells__RoundEnd_y[this] + ( s__RoundSpells__RoundEnd_aoe[this] ) * Sin(s__RoundSpells__RoundEnd_k[this] * ( 360 / s__RoundSpells__RoundEnd_k2[this] ) * bj_DEGTORAD) , GetRandomReal(0, 359) , 0.65 , 3 , 1))
                                set s__RoundSpells__RoundEnd_k[this]=s__RoundSpells__RoundEnd_k[this] + 1
                            endloop
                        endif
                        if s__RoundSpells__RoundEnd_r2[this] > 1 and s__RoundSpells__RoundEnd_k2[this] > 0 then
                            set s__RoundSpells__RoundEnd_r2[this]=0
                            set s__RoundSpells__RoundEnd_k2[this]=s__RoundSpells__RoundEnd_k2[this] - 1
                        else
                            set s__RoundSpells__RoundEnd_r2[this]=s__RoundSpells__RoundEnd_r2[this] + 0.5
                        endif
                        if s__RoundSpells__RoundEnd_aoe[this] > 1320 then
                            set s__RoundSpells__RoundEnd_aoe[this]=s__RoundSpells__RoundEnd_aoe[this] - 65.9
                            if s__RoundSpells__RoundEnd_aoe[this] < 1320 then
                                set s__RoundSpells__RoundEnd_aoe[this]=1320
                                set s__RoundSpells__RoundEnd_k2[this]=0
                            endif
                        else
                        endif
                        if s__RoundSpells__RoundEnd_dmg[this] < 1300 then
                            set s__RoundSpells__RoundEnd_dmg[this]=s__RoundSpells__RoundEnd_dmg[this] + 40
                        endif
                        call DecorRemove2(s__RoundSpells__RoundEnd_c[this] , s__RoundSpells__RoundEnd_x[this] , s__RoundSpells__RoundEnd_y[this] , s__RoundSpells__RoundEnd_aoe[this] , 50)
                        call GroupClear(s__RoundSpells__RoundEnd_g[this])
                        call GroupEnumUnitsInRect(s__RoundSpells__RoundEnd_g[this], gg_rct_Arena, Condition(function NoDecor_Filter))
                        loop
                            set s__RoundSpells__RoundEnd_u[this]=FirstOfGroup(s__RoundSpells__RoundEnd_g[this])
                            exitwhen s__RoundSpells__RoundEnd_u[this] == null
                            set distance=SR3(s__RoundSpells__RoundEnd_u[this] , s__RoundSpells__RoundEnd_x[this] , s__RoundSpells__RoundEnd_y[this])
                            if SpellBool(s__RoundSpells__RoundEnd_u[this]) and distance > s__RoundSpells__RoundEnd_aoe[this] then
                                call SetHpCurrent(s__RoundSpells__RoundEnd_u[this] , - s__RoundSpells__RoundEnd_dmg[this])
                                call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\wos_A_[doft]hero_skeletonking_n2s_e_star.mdl", s__RoundSpells__RoundEnd_u[this], "chest"))
                                set s__RoundSpells__RoundEnd_r5[this]=GetRandomReal(- 0.35, - 0.15)
                                if GetLocalPlayer() == GetOwningPlayer(s__RoundSpells__RoundEnd_u[this]) then
                                    call CinematicFilterGenericBJ(2.00, BLEND_MODE_BLEND, "ReplaceableTextures\\CameraMasks\\DreamFilter_Mask.blp", 100.00, 10.00, 10.00, 0.00, 100.00, 10.00, 10.00, 100.00)
                                endif
                                call DestroyEffect(EffectSpawn3("war3mapImported\\wos_az_jingzi_jiansheng01_e1_l2.mdl" , GetUnitX(s__RoundSpells__RoundEnd_u[this]) , GetUnitY(s__RoundSpells__RoundEnd_u[this]) , GetRandomReal(0, 359) , 1 , 1.2 , GetUnitFlyHeight(s__RoundSpells__RoundEnd_u[this]) + 210 , s__RoundSpells__RoundEnd_r5[this]))
                                call DestroyEffect(EffectSpawn3("war3mapImported\\wos_az_jingzi_jiansheng01_e1_l2.mdl" , GetUnitX(s__RoundSpells__RoundEnd_u[this]) , GetUnitY(s__RoundSpells__RoundEnd_u[this]) , GetRandomReal(0, 359) , 1 , 1.2 , GetUnitFlyHeight(s__RoundSpells__RoundEnd_u[this]) + 120 , s__RoundSpells__RoundEnd_r5[this]))
                            elseif distance <= s__RoundSpells__RoundEnd_aoe[this] then
                                if GetLocalPlayer() == GetOwningPlayer(s__RoundSpells__RoundEnd_u[this]) then
                                    call DisplayCineFilter(false)
                                endif
                            endif
                            call GroupRemoveUnit(s__RoundSpells__RoundEnd_g[this], s__RoundSpells__RoundEnd_u[this])
                        endloop
                    endif
                else
                    set s__RoundSpells__RoundEnd_k[this]=0
                    loop
                        exitwhen s__RoundSpells__RoundEnd_k[this] == 10
                        if GetLocalPlayer() == Player(s__RoundSpells__RoundEnd_k[this]) then
                            call DisplayCineFilter(false)
                        endif
                        set s__RoundSpells__RoundEnd_k[this]=s__RoundSpells__RoundEnd_k[this] + 1
                    endloop
                    call StopSound(gg_snd_Round_Sukuna, false, false)
                    call DestroyEffect(s__RoundSpells__RoundEnd_e[this])
                    call DestroyEffect(s__RoundSpells__RoundEnd_e3[this])
                    call DestroyEffect(s__RoundSpells__RoundEnd_e4[this])
                    call BlinkEff(s__RoundSpells__RoundEnd_c[this])
                    call ColorDummy3(s__RoundSpells__RoundEnd_c[this] , 0 , 255 , 255 , 255 , 0.25)
                    call ColorEffDummy3(s__RoundSpells__RoundEnd_e2[this] , 0 , 255 , 255 , 255 , 0.3)
                    call DestroyGroup(s__RoundSpells__RoundEnd_g[this])
                    set s__RoundSpells__RoundEnd_c[this]=null
                    set s__RoundSpells__RoundEnd_g[this]=null
                    set s__RoundSpells__RoundEnd_u[this]=null
                    set s__RoundSpells__RoundEnd_e[this]=null
                    set s__RoundSpells__RoundEnd_e2[this]=null
                    set s__RoundSpells__RoundEnd_e3[this]=null
                    set s__RoundSpells__RoundEnd_e4[this]=null
                    set s__RoundSpells__RoundEnd_m_Round1[i]=s__RoundSpells__RoundEnd_m_Round1[s__RoundSpells__RoundEnd_MUI_Round1]
                    set s__RoundSpells__RoundEnd_MUI_Round1=s__RoundSpells__RoundEnd_MUI_Round1 - 1
                    if s__RoundSpells__RoundEnd_MUI_Round1 == - 1 then
                        call PauseTimer(s__RoundSpells__RoundEnd_t_Round1)
                    endif
                    call s__RoundSpells__RoundEnd_deallocate(this)
                    set i=i - 1
                endif
                set i=i + 1
            endloop
        endfunction
        function s__RoundSpells__RoundEnd_SukunaEnd_Start takes nothing returns nothing
            local integer this= s__RoundSpells__RoundEnd__allocate()
            set s__RoundSpells__RoundEnd_MUI_Round1=s__RoundSpells__RoundEnd_MUI_Round1 + 1
            set s__RoundSpells__RoundEnd_m_Round1[s__RoundSpells__RoundEnd_MUI_Round1]=this
            set s__RoundSpells__RoundEnd_x[this]=GetRectCenterX(gg_rct_Arena) + 100 * Cos(270 * bj_DEGTORAD)
            set s__RoundSpells__RoundEnd_y[this]=GetRectCenterY(gg_rct_Arena) + 100 * Sin(270 * bj_DEGTORAD)
            set s__RoundSpells__RoundEnd_g[this]=CreateGroup()
            set s__RoundSpells__RoundEnd_u[this]=null
            call StartSound(gg_snd_Round_Sukuna)
            set s__RoundSpells__RoundEnd_c[this]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'h005', s__RoundSpells__RoundEnd_x[this], s__RoundSpells__RoundEnd_y[this], 270)
            call BlinkEff2(s__RoundSpells__RoundEnd_c[this])
            set s__RoundSpells__RoundEnd_rmax[this]=180
            set s__RoundSpells__RoundEnd_dmg[this]=75
            set s__RoundSpells__RoundEnd_aoe[this]=5000
            set s__RoundSpells__RoundEnd_k2[this]=36
            set s__RoundSpells__RoundEnd_a[this]=270 * bj_DEGTORAD
            call SetUnitAnimation(s__RoundSpells__RoundEnd_c[this], "spell five")
            set s__RoundSpells__RoundEnd_k[this]=0
            loop
                exitwhen s__RoundSpells__RoundEnd_k[this] == 10
                call VisionTimed(Player(s__RoundSpells__RoundEnd_k[this]) , s__RoundSpells__RoundEnd_x[this] , s__RoundSpells__RoundEnd_y[this] , s__RoundSpells__RoundEnd_aoe[this] , 8)
                set s__RoundSpells__RoundEnd_k[this]=s__RoundSpells__RoundEnd_k[this] + 1
            endloop
            set s__RoundSpells__RoundEnd_r[this]=0
            set s__RoundSpells__RoundEnd_r2[this]=0
            set s__RoundSpells__RoundEnd_r3[this]=0
            call PlayersMsg("|c00FF0303Author:|r Move closer to the center to survive. In a few seconds, Sukuna will shatter the entire arena." , 7)
            set s__RoundSpells__RoundEnd_e3[this]=EffectSpawn("war3mapimported\\wos_ChuShou_BY_Wood_Effect_Glow_GuiPaiQiGong_XuLiRed.mdx" , GetUnitX(s__RoundSpells__RoundEnd_c[this]) + 45 * Cos(s__RoundSpells__RoundEnd_a[this]) , GetUnitY(s__RoundSpells__RoundEnd_c[this]) + 45 * Sin(s__RoundSpells__RoundEnd_a[this]) , s__RoundSpells__RoundEnd_a[this] * bj_RADTODEG , 1 , 2 , 125)
            if s__RoundSpells__RoundEnd_MUI_Round1 == 0 then
                call TimerStart(s__RoundSpells__RoundEnd_t_Round1, 1, true, function s__RoundSpells__RoundEnd_Loop_SukunaEnd)
            endif
        endfunction
        function s__RoundSpells__RoundEnd_soundcheck takes integer this,unit c returns nothing
        if GetUnitTypeId(c) == Natsu_ID and IntegerCd(c , "cd sound train" , 10) then
        if GetRandomInt(1, 2) == 1 then
        call MakeSound("war3mapimported\\wos_NatsuTrain")
        else
        call MakeSound("war3mapimported\\wos_NatsuTrain2")
        endif
        endif
        endfunction
        function s__RoundSpells__RoundEnd_Loop_Train_Start takes nothing returns nothing
            local integer this
            local integer i= 0
            local real a01
            local real a02
            loop
                exitwhen i > s__RoundSpells__RoundEnd_MUI_RoundTrain
                set this=s__RoundSpells__RoundEnd_m_RoundTrain[i]
                if s__RoundSpells__RoundEnd_r[this] <= s__RoundSpells__RoundEnd_rmax[this] and CondArena == 1 then
                    set s__RoundSpells__RoundEnd_r[this]=s__RoundSpells__RoundEnd_r[this] + 0.03
                    set a01=s__RoundSpells__RoundEnd_r6[this] * bj_DEGTORAD
                    set a02=s__RoundSpells__RoundEnd_r7[this] * bj_DEGTORAD
                    if s__RoundSpells__RoundEnd_move[this] < 75 then
                        set s__RoundSpells__RoundEnd_move[this]=s__RoundSpells__RoundEnd_move[this] + 0.5
                    endif
                    if GetDestructableLife(s__RoundSpells__RoundEnd_des1[this]) <= 1 then
                    if s__RoundSpells__RoundEnd_check2[this] == 0 then
                    set s__RoundSpells__RoundEnd_x[this]=GetUnitX(s__RoundSpells__RoundEnd_d[this])
                    set s__RoundSpells__RoundEnd_y[this]=GetUnitY(s__RoundSpells__RoundEnd_d[this])
                    call SetUnitAnimation(s__RoundSpells__RoundEnd_d[this], "death")
                    call ColorDummy3(s__RoundSpells__RoundEnd_d[this] , 0 , 255 , 255 , 255 , 0.75)
                    call GroupClear(s__RoundSpells__RoundEnd_g3[this])
                    call GroupEnumUnitsInRange(s__RoundSpells__RoundEnd_g3[this], s__RoundSpells__RoundEnd_x[this], s__RoundSpells__RoundEnd_y[this], 650, Condition(function NoDecor_Filter))
                    loop
                        set s__RoundSpells__RoundEnd_u[this]=FirstOfGroup(s__RoundSpells__RoundEnd_g3[this])
                        exitwhen s__RoundSpells__RoundEnd_u[this] == null
                        if SpellBool(s__RoundSpells__RoundEnd_u[this]) then
                        if GetUnitState(s__RoundSpells__RoundEnd_u[this], UNIT_STATE_LIFE) - s__RoundSpells__RoundEnd_dmg2[this] <= 3 and IsUnitType(s__RoundSpells__RoundEnd_u[this], UNIT_TYPE_HERO) and IsUnitIllusion(s__RoundSpells__RoundEnd_u[this]) == false then
                        set TrainKill=TrainKill + 1
                        endif
                        call SetHpCurrent(s__RoundSpells__RoundEnd_u[this] , - s__RoundSpells__RoundEnd_dmg2[this])
                        call s__RoundSpells__RoundEnd_soundcheck(this,s__RoundSpells__RoundEnd_u[this])
                        endif
                        call GroupRemoveUnit(s__RoundSpells__RoundEnd_g3[this], s__RoundSpells__RoundEnd_u[this])
                    endloop
                    call ScaleDummy(UnitSpawn(Player(PLAYER_NEUTRAL_PASSIVE) , Fire_ID , s__RoundSpells__RoundEnd_x[this] , s__RoundSpells__RoundEnd_y[this] , 1 , 1 , 1.75 , 45 , 9) , 7.5 , 1.75 , 0.5)
                    call DestroyEffect(EffectSpawn("war3mapImported\\wos_t8_by_wood_effect_order_dange_daoguang_baozha_2_2_clear.mdl" , s__RoundSpells__RoundEnd_x[this] , s__RoundSpells__RoundEnd_y[this] , GetRandomReal(0, 359) , 1 , 1.33 , 1))
                    call DestroyEffect(EffectSpawn("war3mapImported\\wos_BY_Wood_Effect_OnePiece_AiSi_DaYanJieYanDi_2.mdl" , s__RoundSpells__RoundEnd_x[this] , s__RoundSpells__RoundEnd_y[this] , GetRandomReal(0, 359) , 1 , 2.85 , 1))
                    call DestroyEffect(EffectSpawn("war3mapImported\\wos_by_wood_effect_yuzhiboyou_unusual_fenshendabaopo_2.mdl" , s__RoundSpells__RoundEnd_x[this] , s__RoundSpells__RoundEnd_y[this] , GetRandomReal(0, 359) , 1 , 2 , 1))
                    endif
                        set s__RoundSpells__RoundEnd_check2[this]=1
                    endif
                    if s__RoundSpells__RoundEnd_check2[this] == 0 then
                        call MoveUnit2(s__RoundSpells__RoundEnd_d[this] , s__RoundSpells__RoundEnd_move[this] , a01)
                        if GetDestructableLife(s__RoundSpells__RoundEnd_des1[this]) > 0 then
                            // Destructables cannot be moved by the Warcraft III API.
                            call RemoveDestructable(s__RoundSpells__RoundEnd_des1[this])
                            set s__RoundSpells__RoundEnd_des1[this]=null
                            set s__RoundSpells__RoundEnd_des1[this]=CreateDestructable('B017', GetUnitX(s__RoundSpells__RoundEnd_d[this]), GetUnitY(s__RoundSpells__RoundEnd_d[this]), 0, 0.01, 0)
                        endif
                        call GroupClear(s__RoundSpells__RoundEnd_g[this])
                        set s__RoundSpells__RoundEnd_x[this]=GetUnitX(s__RoundSpells__RoundEnd_d[this]) + 550 * Cos(a01)
                        set s__RoundSpells__RoundEnd_y[this]=GetUnitY(s__RoundSpells__RoundEnd_d[this]) + 550 * Sin(a01)
                        call GroupEnumUnitsInRange(s__RoundSpells__RoundEnd_g[this], s__RoundSpells__RoundEnd_x[this], s__RoundSpells__RoundEnd_y[this], s__RoundSpells__RoundEnd_aoe[this], Condition(function NoDecor_Filter))
                        loop
                            set s__RoundSpells__RoundEnd_u[this]=FirstOfGroup(s__RoundSpells__RoundEnd_g[this])
                            exitwhen s__RoundSpells__RoundEnd_u[this] == null
                            if SpellBool(s__RoundSpells__RoundEnd_u[this]) then
                                if IsUnitInGroup(s__RoundSpells__RoundEnd_u[this], s__RoundSpells__RoundEnd_g4[this]) == false then
                                    if IsUnitInGroup(s__RoundSpells__RoundEnd_u[this], s__RoundSpells__RoundEnd_g2[this]) == false then
                                        call GroupAddUnit(s__RoundSpells__RoundEnd_g2[this], s__RoundSpells__RoundEnd_u[this])
                        if GetUnitState(s__RoundSpells__RoundEnd_u[this], UNIT_STATE_LIFE) - s__RoundSpells__RoundEnd_dmg[this] <= 3 and IsUnitType(s__RoundSpells__RoundEnd_u[this], UNIT_TYPE_HERO) and IsUnitIllusion(s__RoundSpells__RoundEnd_u[this]) == false then
                        set TrainKill=TrainKill + 1
                        endif
                                        call SetHpCurrent(s__RoundSpells__RoundEnd_u[this] , - s__RoundSpells__RoundEnd_dmg[this])
                                        call s__RoundSpells__RoundEnd_soundcheck(this,s__RoundSpells__RoundEnd_u[this])
                                        call StunUnit(s__RoundSpells__RoundEnd_u[this] , s__RoundSpells__RoundEnd_u[this] , 1.5)
                                        call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\wos_A_[doft]hero_skeletonking_n2s_e_star.mdl", s__RoundSpells__RoundEnd_u[this], "chest"))
                                    endif
                                    call SetUnitPosition(s__RoundSpells__RoundEnd_u[this], s__RoundSpells__RoundEnd_x[this] + 15 * Cos(a01), s__RoundSpells__RoundEnd_y[this] + 15 * Sin(a01))
                                endif
                            endif
                            call GroupRemoveUnit(s__RoundSpells__RoundEnd_g[this], s__RoundSpells__RoundEnd_u[this])
                        endloop
                    endif
                    if GetDestructableLife(s__RoundSpells__RoundEnd_des2[this]) <= 1 then
                    if s__RoundSpells__RoundEnd_check3[this] == 0 then
                    set s__RoundSpells__RoundEnd_x[this]=GetUnitX(s__RoundSpells__RoundEnd_d2[this])
                    set s__RoundSpells__RoundEnd_y[this]=GetUnitY(s__RoundSpells__RoundEnd_d2[this])
                    call SetUnitAnimation(s__RoundSpells__RoundEnd_d2[this], "death")
