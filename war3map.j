                                call BlzFrameSetAbsPoint(s___MilimSpells__MilimTKS_frame_pas4[s__MilimSpells__MilimTKS_frame_pas4[this]+s__MilimSpells__MilimTKS_k2[this]], FRAMEPOINT_CENTER, 0.005, 0.18)
                                call BlzFrameSetSize(s___MilimSpells__MilimTKS_frame_pas4[s__MilimSpells__MilimTKS_frame_pas4[this]+s__MilimSpells__MilimTKS_k2[this]], 0.03, 0.03)
                                call BlzFrameSetTexture(s___MilimSpells__MilimTKS_frame_pas4[s__MilimSpells__MilimTKS_frame_pas4[this]+s__MilimSpells__MilimTKS_k2[this]], "ReplaceableTextures\\CommandButtons\\BTNHero_Milim_T", 0, false)
                                set s___MilimSpells__MilimTKS_frame_pas5[s__MilimSpells__MilimTKS_frame_pas5[this]+s__MilimSpells__MilimTKS_k2[this]]=BlzCreateFrameByType("TEXT", "MyPlayerName", s___MilimSpells__MilimTKS_frame_pas1[s__MilimSpells__MilimTKS_frame_pas1[this]+s__MilimSpells__MilimTKS_k2[this]], "", 0)
                                call BlzFrameSetAbsPoint(s___MilimSpells__MilimTKS_frame_pas5[s__MilimSpells__MilimTKS_frame_pas5[this]+s__MilimSpells__MilimTKS_k2[this]], FRAMEPOINT_CENTER, 0.07, 0.185)
                                call BlzFrameSetText(s___MilimSpells__MilimTKS_frame_pas5[s__MilimSpells__MilimTKS_frame_pas5[this]+s__MilimSpells__MilimTKS_k2[this]], "|c00FFFF00Morph Time Left:|r")
                                call BlzFrameSetScale(s___MilimSpells__MilimTKS_frame_pas5[s__MilimSpells__MilimTKS_frame_pas5[this]+s__MilimSpells__MilimTKS_k2[this]], 0.9)
                                set s___MilimSpells__MilimTKS_frame_pas6[s__MilimSpells__MilimTKS_frame_pas6[this]+s__MilimSpells__MilimTKS_k2[this]]=BlzCreateFrameByType("TEXT", "MyPlayerName", s___MilimSpells__MilimTKS_frame_pas1[s__MilimSpells__MilimTKS_frame_pas1[this]+s__MilimSpells__MilimTKS_k2[this]], "", 0)
                                call BlzFrameSetAbsPoint(s___MilimSpells__MilimTKS_frame_pas6[s__MilimSpells__MilimTKS_frame_pas6[this]+s__MilimSpells__MilimTKS_k2[this]], FRAMEPOINT_CENTER, 0.07, 0.17)
                                call BlzFrameSetText(s___MilimSpells__MilimTKS_frame_pas6[s__MilimSpells__MilimTKS_frame_pas6[this]+s__MilimSpells__MilimTKS_k2[this]], "|c00FFFF00" + R2SW(0, 0, 2) + "|r")
                                call BlzFrameSetScale(s___MilimSpells__MilimTKS_frame_pas6[s__MilimSpells__MilimTKS_frame_pas6[this]+s__MilimSpells__MilimTKS_k2[this]], 0.9)
                            else
                                if GetLocalPlayer() == GetOwningPlayer(s__MilimSpells__MilimTKS_c[this]) then
                                    call BlzFrameSetVisible(s___MilimSpells__MilimTKS_frame_pas1[s__MilimSpells__MilimTKS_frame_pas1[this]+s__MilimSpells__MilimTKS_k2[this]], true)
                                endif
                                call BlzFrameSetValue(s___MilimSpells__MilimTKS_frame_pas3[s__MilimSpells__MilimTKS_frame_pas3[this]+s__MilimSpells__MilimTKS_k2[this]], s__MilimSpells__MilimTKS_rmax[this])
                            endif
                            call DestroyEffect(EffectSpawn3("war3mapImported\\wos_mei-qqsfx-5.mdl" , GetUnitX(s__MilimSpells__MilimTKS_c[this]) , GetUnitY(s__MilimSpells__MilimTKS_c[this]) , 1 , 0.85 , 4 , 1 , - 90))
                        endif
                    elseif s__MilimSpells__MilimTKS_check[this] == 1 then
                        if IsUnitPaused(s__MilimSpells__MilimTKS_c[this]) == false then
                            set s__MilimSpells__MilimTKS_r[this]=s__MilimSpells__MilimTKS_r[this] + 0.03
                        endif
                        set s__MilimSpells__MilimTKS_r[this]=S2R(R2SW(s__MilimSpells__MilimTKS_r[this], 0, 3))
                        call BlzFrameSetValue(s___MilimSpells__MilimTKS_frame_pas3[s__MilimSpells__MilimTKS_frame_pas3[this]+s__MilimSpells__MilimTKS_k2[this]], s__MilimSpells__MilimTKS_rmax[this] - ( s__MilimSpells__MilimTKS_r[this] + 0.1 ))
                        if s__MilimSpells__MilimTKS_rmax[this] - s__MilimSpells__MilimTKS_r[this] >= 0 then
                            call BlzFrameSetText(s___MilimSpells__MilimTKS_frame_pas6[s__MilimSpells__MilimTKS_frame_pas6[this]+s__MilimSpells__MilimTKS_k2[this]], "|c00FFFF00" + R2SW(s__MilimSpells__MilimTKS_rmax[this] - s__MilimSpells__MilimTKS_r[this], 0, 2) + "|r")
                        endif
                        set s__MilimSpells__MilimTKS_x[this]=GetUnitX(s__MilimSpells__MilimTKS_c[this])
                        set s__MilimSpells__MilimTKS_y[this]=GetUnitY(s__MilimSpells__MilimTKS_c[this])
                    endif
                else
                    set hp=GetUnitState(s__MilimSpells__MilimTKS_c[this], UNIT_STATE_LIFE) / GetUnitState(s__MilimSpells__MilimTKS_c[this], UNIT_STATE_MAX_LIFE)
                    call BlzSetUnitMaxHP(s__MilimSpells__MilimTKS_c[this], BlzGetUnitMaxHP(s__MilimSpells__MilimTKS_c[this]) - MilimT_MaxHpBonus)
                    call SetUnitState(s__MilimSpells__MilimTKS_c[this], UNIT_STATE_LIFE, GetUnitState(s__MilimSpells__MilimTKS_c[this], UNIT_STATE_MAX_LIFE) * hp)
                    call UnitRemoveAbility(s__MilimSpells__MilimTKS_c[this], MilimT_HpRegenAbi)
                    call BlzSetUnitSkin(s__MilimSpells__MilimTKS_c[this], Milim_ID)
                    //call FixAura(c)
                    call BlzSetAbilityIcon(Milim_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Milim_Icon.blp")
                    call SaveInteger(hs, GetHandleId(s__MilimSpells__MilimTKS_c[this]), StringHash("mode t"), 0)
                    call h__SetPlayerAbilityAvailable(GetOwningPlayer(s__MilimSpells__MilimTKS_c[this]), MilimT_ID, true)
                    call h__SetPlayerAbilityAvailable(GetOwningPlayer(s__MilimSpells__MilimTKS_c[this]), MilimT2_ID, false)
                    if s__MilimSpells__MilimTKS_check[this] == 0 then
                        call StopSpellUnit2(s__MilimSpells__MilimTKS_c[this])
                        call DestroyEffect(s__MilimSpells__MilimTKS_e2[this])
                    else
                        call DestroyEffect(s__MilimSpells__MilimTKS_e3[this])
                    endif
                    if GetLocalPlayer() == GetOwningPlayer(s__MilimSpells__MilimTKS_c[this]) then
                        call BlzFrameSetVisible(s___MilimSpells__MilimTKS_frame_pas1[s__MilimSpells__MilimTKS_frame_pas1[this]+s__MilimSpells__MilimTKS_k2[this]], false)
                    endif
                    set s__MilimSpells__MilimTKS_c[this]=null
                    set s__MilimSpells__MilimTKS_e[this]=null
                    set s__MilimSpells__MilimTKS_e2[this]=null
                    set s__MilimSpells__MilimTKS_e3[this]=null
                    set s__MilimSpells__MilimTKS_m_MilimT[i]=s__MilimSpells__MilimTKS_m_MilimT[s__MilimSpells__MilimTKS_MUI_MilimT]
                    set s__MilimSpells__MilimTKS_MUI_MilimT=s__MilimSpells__MilimTKS_MUI_MilimT - 1
                    if s__MilimSpells__MilimTKS_MUI_MilimT == - 1 then
                        call PauseTimer(s__MilimSpells__MilimTKS_t_MilimT)
                    endif
                    call s__MilimSpells__MilimTKS_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction
        function s__MilimSpells__MilimTKS_MilimT_Start takes unit NewC returns nothing
            local integer this= s__MilimSpells__MilimTKS__allocate()
            local real hp
            set s__MilimSpells__MilimTKS_MUI_MilimT=s__MilimSpells__MilimTKS_MUI_MilimT + 1
            set s__MilimSpells__MilimTKS_m_MilimT[s__MilimSpells__MilimTKS_MUI_MilimT]=this
            set s__MilimSpells__MilimTKS_c[this]=NewC
            set hp=GetUnitState(s__MilimSpells__MilimTKS_c[this], UNIT_STATE_LIFE) / GetUnitState(s__MilimSpells__MilimTKS_c[this], UNIT_STATE_MAX_LIFE)
            call BlzSetUnitMaxHP(s__MilimSpells__MilimTKS_c[this], BlzGetUnitMaxHP(s__MilimSpells__MilimTKS_c[this]) + MilimT_MaxHpBonus)
            call SetUnitState(s__MilimSpells__MilimTKS_c[this], UNIT_STATE_LIFE, GetUnitState(s__MilimSpells__MilimTKS_c[this], UNIT_STATE_MAX_LIFE) * hp)
            call UnitAddAbility(s__MilimSpells__MilimTKS_c[this], MilimT_HpRegenAbi)
            set s__MilimSpells__MilimTKS_x[this]=GetUnitX(s__MilimSpells__MilimTKS_c[this])
            set s__MilimSpells__MilimTKS_y[this]=GetUnitY(s__MilimSpells__MilimTKS_c[this])
            call StartSpellUnit2(s__MilimSpells__MilimTKS_c[this])
            set s__MilimSpells__MilimTKS_check[this]=0
            set s__MilimSpells__MilimTKS_r2[this]=0
            set s__MilimSpells__MilimTKS_r[this]=0
            set s__MilimSpells__MilimTKS_k2[this]=GetPlayerId(GetOwningPlayer(s__MilimSpells__MilimTKS_c[this]))
            call SaveInteger(hs, GetHandleId(s__MilimSpells__MilimTKS_c[this]), StringHash("mode t"), 1)
            set s__MilimSpells__MilimTKS_rmax[this]=MilimT_Duration
            call MakeSound("war3mapimported\\Hero_Milim_T 1")
            call MakeSound("war3mapimported\\Hero_Milim_T 2")
            call DestroyEffect(EffectSpawn("war3mapimported\\wos_HakkeStart.mdx" , s__MilimSpells__MilimTKS_x[this] , s__MilimSpells__MilimTKS_y[this] , GetRandomReal(0, 359) , 1 , 1.25 , 5))
            set s__MilimSpells__MilimTKS_e[this]=EffectSpawn("war3mapImported\\wos_ZK-SM_XL8.mdl" , GetUnitX(s__MilimSpells__MilimTKS_c[this]) , GetUnitY(s__MilimSpells__MilimTKS_c[this]) , 1 , 1.25 , 2 , 0)
            call BlzSetAbilityIcon(Milim_ID, "ReplaceableTextures\\CommandButtons\\BTNHero_Milim_T.blp")
            if s__MilimSpells__MilimTKS_MUI_MilimT == 0 then
                call TimerStart(s__MilimSpells__MilimTKS_t_MilimT, 0.03, true, function s__MilimSpells__MilimTKS_Loop_MilimT)
            endif
        endfunction
    // Ýòè ïàðàìåòðû äîáàâèòü â ñóùåñòâóþùèé globals áèáëèîòåêè MilimSpells.




    function s__MilimSpells__MilimT2KS_Loop_MilimT2 takes nothing returns nothing
        local integer this
        local integer i= 0
        local integer damageCount
        local real add= - 1
        local real targetA
        local real angleDiff
        local real maxTurn= s__MilimSpells__MilimT2KS_AIM_TURN_SPEED * bj_DEGTORAD * 0.03
        local real turnLimit= s__MilimSpells__MilimT2KS_AIM_TURN_LIMIT * bj_DEGTORAD
        local real beamEffectLife
        local real damageMove
        local real damageAoe
        local real damageX
        local real damageY
        local effect beamEffect
        local integer beamSegment

        loop
            exitwhen i > s__MilimSpells__MilimT2KS_MUI_MilimT2
            set this=s__MilimSpells__MilimT2KS_m_MilimT2[i]

            if SpellBoolCaster(s__MilimSpells__MilimT2KS_c[this]) and s__MilimSpells__MilimT2KS_check[this] < 2 then
                call DebugUnit(s__MilimSpells__MilimT2KS_c[this])
                    if s__MilimSpells__MilimT2KS_r3[this] > 0.22 then
                    set s__MilimSpells__MilimT2KS_r3[this]=0
                    call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_13684996917731847118.mdl" , GetUnitX(s__MilimSpells__MilimT2KS_c[this]) + add * Cos(s__MilimSpells__MilimT2KS_a[this]) , GetUnitY(s__MilimSpells__MilimT2KS_c[this]) + add * Sin(s__MilimSpells__MilimT2KS_a[this]) , GetRandomReal(0, 359) , 1.50 , 2.00 , 255.00 , 255 , 255 , 255 , 165))
                    else
                    set s__MilimSpells__MilimT2KS_r3[this]=s__MilimSpells__MilimT2KS_r3[this] + 0.03
                    endif
                if s__MilimSpells__MilimT2KS_check[this] == 0 then
                    set s__MilimSpells__MilimT2KS_r[this]=s__MilimSpells__MilimT2KS_r[this] + 0.03

                    // Æåëàåìûé óãîë ìûøè ñíà÷àëà îãðàíè÷èâàåòñÿ ñåêòîðîì
                    // baseA - 120 ãðàäóñîâ ... baseA + 120 ãðàäóñîâ.
                    set targetA=GAngle2(s__MilimSpells__MilimT2KS_c[this] , GetMouseX(GetOwningPlayer(s__MilimSpells__MilimT2KS_c[this])) , GetMouseY(GetOwningPlayer(s__MilimSpells__MilimT2KS_c[this])))
                    set angleDiff=targetA - s__MilimSpells__MilimT2KS_baseA[this]
                    if angleDiff > bj_PI then
                        set angleDiff=angleDiff - 2.00 * bj_PI
                    elseif angleDiff < - bj_PI then
                        set angleDiff=angleDiff + 2.00 * bj_PI
                    endif

                    if angleDiff > turnLimit then
                        set targetA=s__MilimSpells__MilimT2KS_baseA[this] + turnLimit
                    elseif angleDiff < - turnLimit then
                        set targetA=s__MilimSpells__MilimT2KS_baseA[this] - turnLimit
                    else
                        set targetA=s__MilimSpells__MilimT2KS_baseA[this] + angleDiff
                    endif
                    
                    // Ãåðîé è ýôôåêò ïëàâíî èäóò ê ðàçðåø¸ííîìó óãëó.
                    set angleDiff=targetA - s__MilimSpells__MilimT2KS_a[this]
                    if angleDiff > bj_PI then
                        set angleDiff=angleDiff - 2.00 * bj_PI
                    elseif angleDiff < - bj_PI then
                        set angleDiff=angleDiff + 2.00 * bj_PI
                    endif

                    if angleDiff > maxTurn then
                        set s__MilimSpells__MilimT2KS_a[this]=s__MilimSpells__MilimT2KS_a[this] + maxTurn
                    elseif angleDiff < - maxTurn then
                        set s__MilimSpells__MilimT2KS_a[this]=s__MilimSpells__MilimT2KS_a[this] - maxTurn
                    else
                        set s__MilimSpells__MilimT2KS_a[this]=targetA
                    endif

                    call BlzSetUnitFacingEx(s__MilimSpells__MilimT2KS_c[this], s__MilimSpells__MilimT2KS_a[this] * bj_RADTODEG)
                    call BlzSetSpecialEffectPosition(s__MilimSpells__MilimT2KS_e[this], GetUnitX(s__MilimSpells__MilimT2KS_c[this]), GetUnitY(s__MilimSpells__MilimT2KS_c[this]), 0.00)
                    call BlzSetSpecialEffectYaw(s__MilimSpells__MilimT2KS_e[this], s__MilimSpells__MilimT2KS_a[this])
                    call BlzSetSpecialEffectYaw(s__MilimSpells__MilimT2KS_e4[this], s__MilimSpells__MilimT2KS_a[this])

                    // Keep the additional R-style charge effects in front of Milim
                    // while she turns towards the mouse cursor.
                    if s__MilimSpells__MilimT2KS_r[this] == 0.30 then
                        set s__MilimSpells__MilimT2KS_castFrontFx[this]=EffectSpawnScale("war3mapImported\\wos_file00000739.mdl" , GetUnitX(s__MilimSpells__MilimT2KS_c[this]) + 90.00 * Cos(s__MilimSpells__MilimT2KS_a[this]) , GetUnitY(s__MilimSpells__MilimT2KS_c[this]) + 90.00 * Sin(s__MilimSpells__MilimT2KS_a[this]) , s__MilimSpells__MilimT2KS_a[this] * bj_RADTODEG , 1.00 , 1 , 100.00 , 0.75 , 1 , 3.45)
                        call BlzSetSpecialEffectAlpha(s__MilimSpells__MilimT2KS_castFrontFx[this], 150)
                        set s__MilimSpells__MilimT2KS_castFrontGlowFx[this]=EffectSpawnScale("war3mapImported\\wos_ChuShou_BY_Wood_Effect_Glow_GuiPaiQiGong_XuLiblue.mdl" , GetUnitX(s__MilimSpells__MilimT2KS_c[this]) + 90.00 * Cos(s__MilimSpells__MilimT2KS_a[this]) , GetUnitY(s__MilimSpells__MilimT2KS_c[this]) + 90.00 * Sin(s__MilimSpells__MilimT2KS_a[this]) , s__MilimSpells__MilimT2KS_a[this] * bj_RADTODEG , 1.00 , 1 , 100.00 , 0.75 , 1 , 2.50)
                        set s__MilimSpells__MilimT2KS_castFrontBallFx[this]=EffectSpawnScale("war3mapImported\\wos_xtyball2.mdx" , GetUnitX(s__MilimSpells__MilimT2KS_c[this]) + 90.00 * Cos(s__MilimSpells__MilimT2KS_a[this]) , GetUnitY(s__MilimSpells__MilimT2KS_c[this]) + 90.00 * Sin(s__MilimSpells__MilimT2KS_a[this]) , s__MilimSpells__MilimT2KS_a[this] * bj_RADTODEG , 1.00 , 1 , 0.00 , 0.75 , 1 , 1.85)
                    endif
                    if s__MilimSpells__MilimT2KS_castFrontFx[this] != null then
                        call BlzSetSpecialEffectPosition(s__MilimSpells__MilimT2KS_castFrontFx[this], GetUnitX(s__MilimSpells__MilimT2KS_c[this]) + 90.00 * Cos(s__MilimSpells__MilimT2KS_a[this]), GetUnitY(s__MilimSpells__MilimT2KS_c[this]) + 90.00 * Sin(s__MilimSpells__MilimT2KS_a[this]), 100.00)
                        call BlzSetSpecialEffectYaw(s__MilimSpells__MilimT2KS_castFrontFx[this], s__MilimSpells__MilimT2KS_a[this])
                        call BlzSetSpecialEffectPosition(s__MilimSpells__MilimT2KS_castFrontGlowFx[this], GetUnitX(s__MilimSpells__MilimT2KS_c[this]) + 90.00 * Cos(s__MilimSpells__MilimT2KS_a[this]), GetUnitY(s__MilimSpells__MilimT2KS_c[this]) + 90.00 * Sin(s__MilimSpells__MilimT2KS_a[this]), 165.00)
                        call BlzSetSpecialEffectYaw(s__MilimSpells__MilimT2KS_castFrontGlowFx[this], s__MilimSpells__MilimT2KS_a[this])
                        call BlzSetSpecialEffectPosition(s__MilimSpells__MilimT2KS_castFrontBallFx[this], GetUnitX(s__MilimSpells__MilimT2KS_c[this]) + 90.00 * Cos(s__MilimSpells__MilimT2KS_a[this]), GetUnitY(s__MilimSpells__MilimT2KS_c[this]) + 90.00 * Sin(s__MilimSpells__MilimT2KS_a[this]), 0.00)
                        call BlzSetSpecialEffectYaw(s__MilimSpells__MilimT2KS_castFrontBallFx[this], s__MilimSpells__MilimT2KS_a[this])
                    endif

                    if s__MilimSpells__MilimT2KS_r[this] == 1.5 then
                        call MakeSound("war3mapimported\\Hero_Milim_T2 2")
                        call MakeSound("war3mapimported\\Hero_Milim_T2 3")
                    endif

                    if s__MilimSpells__MilimT2KS_r[this] >= MilimT2_ChargeTime then
                        set s__MilimSpells__MilimT2KS_check[this]=1
                        set s__MilimSpells__MilimT2KS_r[this]=0.00
                        set s__MilimSpells__MilimT2KS_r2[this]=0.00
                        set s__MilimSpells__MilimT2KS_move[this]=0.00
                        set s__MilimSpells__MilimT2KS_x[this]=GetUnitX(s__MilimSpells__MilimT2KS_c[this])
                        set s__MilimSpells__MilimT2KS_y[this]=GetUnitY(s__MilimSpells__MilimT2KS_c[this])

                        call MakeSound("war3mapimported\\Hero_Milim_T2 4")
                        call MouseOff(GetOwningPlayer(s__MilimSpells__MilimT2KS_c[this]))
                        call ColorEffDummy3(s__MilimSpells__MilimT2KS_e[this] , 0 , 255 , 1 , 1 , 0.20)
                        call DestroyEffect(s__MilimSpells__MilimT2KS_e2[this])
                        call DestroyEffect(s__MilimSpells__MilimT2KS_castFrontFx[this])
                        call DestroyEffect(s__MilimSpells__MilimT2KS_castFrontGlowFx[this])
                        call DestroyEffect(s__MilimSpells__MilimT2KS_castFrontBallFx[this])
                        set s__MilimSpells__MilimT2KS_e[this]=null
                        set s__MilimSpells__MilimT2KS_e2[this]=null
                        set s__MilimSpells__MilimT2KS_castFrontFx[this]=null
                        set s__MilimSpells__MilimT2KS_castFrontGlowFx[this]=null
                        set s__MilimSpells__MilimT2KS_castFrontBallFx[this]=null
                        call ColorEffDummy3(EffectSpawn3("war3mapImported\\wos_file00005542_21.mdl" , s__MilimSpells__MilimT2KS_x[this] + 2800 * Cos(s__MilimSpells__MilimT2KS_a[this]) , s__MilimSpells__MilimT2KS_y[this] + 2800 * Sin(s__MilimSpells__MilimT2KS_a[this]) , s__MilimSpells__MilimT2KS_a[this] * bj_RADTODEG , 1.00 , 2.7 , 110.00 , - 90) , MilimT2_BeamDuration , 255 , 255 , 255 , 0.25)
                        call SetUnitAnimationByIndex(s__MilimSpells__MilimT2KS_c[this], 15)
                        call SetUnitTimeScale(s__MilimSpells__MilimT2KS_c[this], 1.00)
                        call MakeSound("war3mapimported\\Hero_Milim_TT4")
                        call VisionTimed(GetOwningPlayer(s__MilimSpells__MilimT2KS_c[this]) , s__MilimSpells__MilimT2KS_x[this] + 800 * Cos(s__MilimSpells__MilimT2KS_a[this]) , s__MilimSpells__MilimT2KS_y[this] + 800 * Sin(s__MilimSpells__MilimT2KS_a[this]) , 1200 , 4)
                        call VisionTimed(GetOwningPlayer(s__MilimSpells__MilimT2KS_c[this]) , s__MilimSpells__MilimT2KS_x[this] + 1600 * Cos(s__MilimSpells__MilimT2KS_a[this]) , s__MilimSpells__MilimT2KS_y[this] + 1600 * Sin(s__MilimSpells__MilimT2KS_a[this]) , 1200 , 4)
                        call VisionTimed(GetOwningPlayer(s__MilimSpells__MilimT2KS_c[this]) , s__MilimSpells__MilimT2KS_x[this] + 2400 * Cos(s__MilimSpells__MilimT2KS_a[this]) , s__MilimSpells__MilimT2KS_y[this] + 2400 * Sin(s__MilimSpells__MilimT2KS_a[this]) , 1200 , 4)

                        // Beam parameters copied from Starrk Q (k2 == 1).
                        // Every spawned segment is removed only after the damage phase ends.
                        set s__MilimSpells__MilimT2KS_beamFxMove[this]=175.00
                        set s__MilimSpells__MilimT2KS_beamFxScale[this]=6.20
                        set s__MilimSpells__MilimT2KS_beamRingScale[this]=1.25
                        set s__MilimSpells__MilimT2KS_beamRingTimer[this]=0.00
                    endif
                else
                    set s__MilimSpells__MilimT2KS_r[this]=s__MilimSpells__MilimT2KS_r[this] + 0.03
                    set s__MilimSpells__MilimT2KS_r2[this]=s__MilimSpells__MilimT2KS_r2[this] + 0.03
                    if s__MilimSpells__MilimT2KS_r[this] > 0.3 then
                    set beamEffectLife=MilimT2_BeamDuration - s__MilimSpells__MilimT2KS_r[this] + 0.0
                    set beamSegment=0
                    loop
                        exitwhen beamSegment > 3 or s__MilimSpells__MilimT2KS_beamFxMove[this] >= MilimT2_BeamRange - 150.00
                        if s__MilimSpells__MilimT2KS_r[this] < 0.09 then
                            set s__MilimSpells__MilimT2KS_beamFxMove[this]=s__MilimSpells__MilimT2KS_beamFxMove[this] + 9.00 + s__MilimSpells__MilimT2KS_beamFxScale[this] * 8.00
                        else
                            set s__MilimSpells__MilimT2KS_beamFxMove[this]=s__MilimSpells__MilimT2KS_beamFxMove[this] + 18.00 + s__MilimSpells__MilimT2KS_beamFxScale[this] * 9.00
                        endif
                        if s__MilimSpells__MilimT2KS_beamFxMove[this] > MilimT2_BeamRange then
                            set s__MilimSpells__MilimT2KS_beamFxMove[this]=MilimT2_BeamRange
                        endif

                        set s__MilimSpells__MilimT2KS_x1[this]=s__MilimSpells__MilimT2KS_x[this] + ( 150.00 + s__MilimSpells__MilimT2KS_beamFxMove[this] ) * Cos(s__MilimSpells__MilimT2KS_a[this])
                        set s__MilimSpells__MilimT2KS_y1[this]=s__MilimSpells__MilimT2KS_y[this] + ( 150.00 + s__MilimSpells__MilimT2KS_beamFxMove[this] ) * Sin(s__MilimSpells__MilimT2KS_a[this])
                       
                        call ColorEffDummy3(EffectSpawnColor("war3mapimported\\wos_ulqashar.mdx" , s__MilimSpells__MilimT2KS_x1[this] , s__MilimSpells__MilimT2KS_y1[this] , s__MilimSpells__MilimT2KS_a[this] * bj_RADTODEG , 1.00 , s__MilimSpells__MilimT2KS_beamFxScale[this] , 180.00 + s__MilimSpells__MilimT2KS_r[this] * 80.00 , 25 , 125 , 255 , 65) , beamEffectLife , 25 , 125 , 255 , 0.3)
                      //  call EffectSpawnColor2("war3mapimported\\wos_ulqashar.mdx", x1, y1, a * bj_RADTODEG, 1.00, beamFxScale * 0.70, 180.00 + r * 80.00, beamEffectLife, 225, 225, 225, 205)
                        set s__MilimSpells__MilimT2KS_beamFxScale[this]=s__MilimSpells__MilimT2KS_beamFxScale[this] + 0.005
                        set beamSegment=beamSegment + 1
                    endloop

                    if s__MilimSpells__MilimT2KS_beamRingTimer[this] > 0.00 and s__MilimSpells__MilimT2KS_beamFxMove[this] < MilimT2_BeamRange then
                        set s__MilimSpells__MilimT2KS_beamRingTimer[this]=0.00
                        set s__MilimSpells__MilimT2KS_beamRingScale[this]=s__MilimSpells__MilimT2KS_beamRingScale[this] + 0.005
                        set beamEffect=EffectSpawn("war3mapImported\\wos_krk (1849)6.mdl" , s__MilimSpells__MilimT2KS_x1[this] + 450 * Cos(s__MilimSpells__MilimT2KS_a[this] + 90 * bj_DEGTORAD) , s__MilimSpells__MilimT2KS_y1[this] + 450 * Sin(s__MilimSpells__MilimT2KS_a[this] + 90 * bj_DEGTORAD) , s__MilimSpells__MilimT2KS_a[this] * bj_RADTODEG + 15 , 1.75 , s__MilimSpells__MilimT2KS_beamRingScale[this] , 125.00)
                        call s__GearSystems2__KS_RemoveEffect_MyRemoveEff_Start((beamEffect ) , (( beamEffectLife)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
                        set beamEffect=EffectSpawn("war3mapImported\\wos_krk (1849)6.mdl" , s__MilimSpells__MilimT2KS_x1[this] + 450 * Cos(s__MilimSpells__MilimT2KS_a[this] - 90 * bj_DEGTORAD) , s__MilimSpells__MilimT2KS_y1[this] + 450 * Sin(s__MilimSpells__MilimT2KS_a[this] - 90 * bj_DEGTORAD) , s__MilimSpells__MilimT2KS_a[this] * bj_RADTODEG - 15 , 1.75 , s__MilimSpells__MilimT2KS_beamRingScale[this] , 125.00)
                        call s__GearSystems2__KS_RemoveEffect_MyRemoveEff_Start((beamEffect ) , (( beamEffectLife)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
                        set beamEffect=null
                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_BY_Wood_Eff_Ord_YeYe_Eat_DiBanZhaKai2.mdx" , s__MilimSpells__MilimT2KS_x1[this] , s__MilimSpells__MilimT2KS_y1[this] , GetRandomReal(0, 359) , 2 , 1.85 , 0))
                        call DestroyEffect(EffectSpawnColor("war3mapimported\\wos_Mdx_Effect_05 Mikoto AZ_Dust Rush 01.mdl" , s__MilimSpells__MilimT2KS_x1[this] , s__MilimSpells__MilimT2KS_y1[this] , s__MilimSpells__MilimT2KS_a[this] * bj_RADTODEG , 1 , 1.5 , 1 , 255 , 255 , 255 , 115))
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_1baozha_90.mdl" , s__MilimSpells__MilimT2KS_x1[this] , s__MilimSpells__MilimT2KS_y1[this] , 1 , 0.5 , 2.5 , 1))
                            call DestroyEffect(EffectSpawnColor("war3mapimported\\wos_cf2.mdx" , s__MilimSpells__MilimT2KS_x1[this] , s__MilimSpells__MilimT2KS_y1[this] , s__MilimSpells__MilimT2KS_a[this] * bj_RADTODEG , 1 , 1.8 , 15 , 255 , 255 , 255 , 125))
                    else
                        set s__MilimSpells__MilimT2KS_beamRingTimer[this]=s__MilimSpells__MilimT2KS_beamRingTimer[this] + 0.03
                    endif
                    endif
                    // Êîíè÷åñêîå AOE: îò 20% âîçëå êàñòåðà äî 65% â êîíöå ëó÷à.
                    // Ðàäèóñ ìåíÿåòñÿ ïëàâíî îòíîñèòåëüíî ïðîéäåííîé äëèíû.
                    set s__MilimSpells__MilimT2KS_aoe[this]=MilimT2_DamageAoe * ( s__MilimSpells__MilimT2KS_AOE_START_FACTOR + ( s__MilimSpells__MilimT2KS_AOE_END_FACTOR - s__MilimSpells__MilimT2KS_AOE_START_FACTOR ) * s__MilimSpells__MilimT2KS_move[this] / MilimT2_BeamRange )
                    set s__MilimSpells__MilimT2KS_x1[this]=s__MilimSpells__MilimT2KS_x[this] + s__MilimSpells__MilimT2KS_move[this] * Cos(s__MilimSpells__MilimT2KS_a[this])
                    set s__MilimSpells__MilimT2KS_y1[this]=s__MilimSpells__MilimT2KS_y[this] + s__MilimSpells__MilimT2KS_move[this] * Sin(s__MilimSpells__MilimT2KS_a[this])
                    call DecorRemove(s__MilimSpells__MilimT2KS_c[this] , s__MilimSpells__MilimT2KS_x1[this] , s__MilimSpells__MilimT2KS_y1[this] , MilimT2_DamageAoe , 100)

                    set s__MilimSpells__MilimT2KS_move[this]=s__MilimSpells__MilimT2KS_move[this] + MilimT2_BeamScanStep
                    if s__MilimSpells__MilimT2KS_move[this] > MilimT2_BeamRange then
                        set s__MilimSpells__MilimT2KS_move[this]=0.00
                    endif

                    if s__MilimSpells__MilimT2KS_r2[this] + 0.001 >= MilimT2_DamagePeriod then
                        set s__MilimSpells__MilimT2KS_r2[this]=0.00

                        // Build the target list again for every damage tick. A unit
                        // receives damage only while it is inside the current beam AOE.
                        call GroupClear(s__MilimSpells__MilimT2KS_g2[this])
                        set damageMove=0.00
                        loop
                            set damageAoe=MilimT2_DamageAoe * ( s__MilimSpells__MilimT2KS_AOE_START_FACTOR + ( s__MilimSpells__MilimT2KS_AOE_END_FACTOR - s__MilimSpells__MilimT2KS_AOE_START_FACTOR ) * damageMove / MilimT2_BeamRange )
                            set damageX=s__MilimSpells__MilimT2KS_x[this] + damageMove * Cos(s__MilimSpells__MilimT2KS_a[this])
                            set damageY=s__MilimSpells__MilimT2KS_y[this] + damageMove * Sin(s__MilimSpells__MilimT2KS_a[this])
                            call GroupClear(s__MilimSpells__MilimT2KS_g[this])
                            call GroupEnumUnitsInRange(s__MilimSpells__MilimT2KS_g[this], damageX, damageY, damageAoe, NoDecor_Cond)
                            loop
                                set s__MilimSpells__MilimT2KS_u[this]=FirstOfGroup(s__MilimSpells__MilimT2KS_g[this])
                                exitwhen s__MilimSpells__MilimT2KS_u[this] == null
                                call GroupRemoveUnit(s__MilimSpells__MilimT2KS_g[this], s__MilimSpells__MilimT2KS_u[this])
                                if SpellBool(s__MilimSpells__MilimT2KS_u[this]) and IsUnitEnemy(s__MilimSpells__MilimT2KS_u[this], GetOwningPlayer(s__MilimSpells__MilimT2KS_c[this])) and not IsUnitInGroup(s__MilimSpells__MilimT2KS_u[this], s__MilimSpells__MilimT2KS_g2[this]) then
                                    call GroupAddUnit(s__MilimSpells__MilimT2KS_g2[this], s__MilimSpells__MilimT2KS_u[this])
                                endif
                            endloop

                            set damageMove=damageMove + MilimT2_BeamScanStep
                            exitwhen damageMove > MilimT2_BeamRange
                        endloop

                        loop
                            set s__MilimSpells__MilimT2KS_u[this]=FirstOfGroup(s__MilimSpells__MilimT2KS_g2[this])
                            exitwhen s__MilimSpells__MilimT2KS_u[this] == null
                            call GroupRemoveUnit(s__MilimSpells__MilimT2KS_g2[this], s__MilimSpells__MilimT2KS_u[this])
                            set damageCount=LoadInteger(hs, GetHandleId(s__MilimSpells__MilimT2KS_g2[this]), GetHandleId(s__MilimSpells__MilimT2KS_u[this]))
    
                            if SpellBool(s__MilimSpells__MilimT2KS_u[this]) and IsUnitEnemy(s__MilimSpells__MilimT2KS_u[this], GetOwningPlayer(s__MilimSpells__MilimT2KS_c[this])) then
                                if damageCount < MilimT2_DamageTicks then
                                    call dmgmag(s__MilimSpells__MilimT2KS_c[this] , s__MilimSpells__MilimT2KS_u[this] , s__MilimSpells__MilimT2KS_dmg[this])
                                    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", s__MilimSpells__MilimT2KS_u[this], "chest"))

                                    call SlowUnit(s__MilimSpells__MilimT2KS_c[this] , s__MilimSpells__MilimT2KS_u[this] , MilimT2_Slow , MilimT2_SlowDuration)

                                    set damageCount=damageCount + 1
                                    call SaveInteger(hs, GetHandleId(s__MilimSpells__MilimT2KS_g2[this]), GetHandleId(s__MilimSpells__MilimT2KS_u[this]), damageCount)
                                endif
                            endif
                        endloop
                    endif

                    if s__MilimSpells__MilimT2KS_r[this] >= MilimT2_BeamDuration then
                        set s__MilimSpells__MilimT2KS_check[this]=2
                    endif
                endif
            else
                call MouseOff(GetOwningPlayer(s__MilimSpells__MilimT2KS_c[this]))
                call StopSpellUnit(s__MilimSpells__MilimT2KS_c[this])
                call SetUnitAnimation(s__MilimSpells__MilimT2KS_c[this], "stand")
                call SetUnitTimeScale(s__MilimSpells__MilimT2KS_c[this], 1.00)

                if s__MilimSpells__MilimT2KS_e[this] != null then
                    call ColorEffDummy3(s__MilimSpells__MilimT2KS_e[this] , 0 , 255 , 255 , 255 , 0.20)
                endif
                call DestroyEffect(s__MilimSpells__MilimT2KS_e2[this])

                call SetFly(s__MilimSpells__MilimT2KS_c[this] , 0)
                call FlushChildHashtable(hs, GetHandleId(s__MilimSpells__MilimT2KS_g2[this]))
                call DestroyGroup(s__MilimSpells__MilimT2KS_g[this])
                call DestroyGroup(s__MilimSpells__MilimT2KS_g2[this])
                call DestroyEffect(s__MilimSpells__MilimT2KS_e[this])
                call DestroyEffect(s__MilimSpells__MilimT2KS_e2[this])
                call DestroyEffect(s__MilimSpells__MilimT2KS_e4[this])
                call DestroyEffect(s__MilimSpells__MilimT2KS_castFrontFx[this])
                call DestroyEffect(s__MilimSpells__MilimT2KS_castFrontGlowFx[this])
                call DestroyEffect(s__MilimSpells__MilimT2KS_castFrontBallFx[this])
                set s__MilimSpells__MilimT2KS_g[this]=null
                set s__MilimSpells__MilimT2KS_g2[this]=null
                set s__MilimSpells__MilimT2KS_u[this]=null
                set s__MilimSpells__MilimT2KS_e[this]=null
                set s__MilimSpells__MilimT2KS_e2[this]=null
                set s__MilimSpells__MilimT2KS_e4[this]=null
                set s__MilimSpells__MilimT2KS_castFrontFx[this]=null
                set s__MilimSpells__MilimT2KS_castFrontGlowFx[this]=null
                set s__MilimSpells__MilimT2KS_castFrontBallFx[this]=null
                set s__MilimSpells__MilimT2KS_c[this]=null

                set s__MilimSpells__MilimT2KS_m_MilimT2[i]=s__MilimSpells__MilimT2KS_m_MilimT2[s__MilimSpells__MilimT2KS_MUI_MilimT2]
                set s__MilimSpells__MilimT2KS_MUI_MilimT2=s__MilimSpells__MilimT2KS_MUI_MilimT2 - 1
                if s__MilimSpells__MilimT2KS_MUI_MilimT2 == - 1 then
                    call PauseTimer(s__MilimSpells__MilimT2KS_t_MilimT2)
                endif
                call s__MilimSpells__MilimT2KS_deallocate(this)
                set i=i - 1
            endif

            set i=i + 1
        endloop
    endfunction

    function s__MilimSpells__MilimT2KS_MilimT2_Start takes unit NewC,real NewX,real NewY returns nothing
        local integer this= s__MilimSpells__MilimT2KS__allocate()

        set s__MilimSpells__MilimT2KS_MUI_MilimT2=s__MilimSpells__MilimT2KS_MUI_MilimT2 + 1
        set s__MilimSpells__MilimT2KS_m_MilimT2[s__MilimSpells__MilimT2KS_MUI_MilimT2]=this
        set s__MilimSpells__MilimT2KS_c[this]=NewC
        set s__MilimSpells__MilimT2KS_x[this]=NewX
        set s__MilimSpells__MilimT2KS_y[this]=NewY
        set s__MilimSpells__MilimT2KS_baseA[this]=GAngle2(s__MilimSpells__MilimT2KS_c[this] , s__MilimSpells__MilimT2KS_x[this] , s__MilimSpells__MilimT2KS_y[this])
        set s__MilimSpells__MilimT2KS_a[this]=s__MilimSpells__MilimT2KS_baseA[this]
        set s__MilimSpells__MilimT2KS_r[this]=0.00
        set s__MilimSpells__MilimT2KS_r2[this]=0.00
        set s__MilimSpells__MilimT2KS_r3[this]=0.00
        set s__MilimSpells__MilimT2KS_r4[this]=0.00
        set s__MilimSpells__MilimT2KS_beamFxMove[this]=0.00
        set s__MilimSpells__MilimT2KS_beamFxScale[this]=1.20
        set s__MilimSpells__MilimT2KS_beamRingScale[this]=1.25
        set s__MilimSpells__MilimT2KS_beamRingTimer[this]=0.00
        set s__MilimSpells__MilimT2KS_move[this]=0.00
        set s__MilimSpells__MilimT2KS_check[this]=0
        set s__MilimSpells__MilimT2KS_castFrontFx[this]=null
        set s__MilimSpells__MilimT2KS_castFrontGlowFx[this]=null
        set s__MilimSpells__MilimT2KS_castFrontBallFx[this]=null
        set s__MilimSpells__MilimT2KS_aoe[this]=MilimT2_DamageAoe * s__MilimSpells__MilimT2KS_AOE_START_FACTOR
        set s__MilimSpells__MilimT2KS_dmg[this]=GetHeroAgi(s__MilimSpells__MilimT2KS_c[this], true) * MilimT2_DamageAgiBase / I2R(MilimT2_DamageTicks)
        call SetFly(s__MilimSpells__MilimT2KS_c[this] , 150)
        set s__MilimSpells__MilimT2KS_g[this]=CreateGroup()
        set s__MilimSpells__MilimT2KS_g2[this]=CreateGroup()

        call DebuffClear(s__MilimSpells__MilimT2KS_c[this])
        call StartSpellUnit(s__MilimSpells__MilimT2KS_c[this])
        call SetUnitAnimationByIndex(s__MilimSpells__MilimT2KS_c[this], 0)
        call SetUnitTimeScale(s__MilimSpells__MilimT2KS_c[this], 1.50)
        call MouseOn(GetOwningPlayer(s__MilimSpells__MilimT2KS_c[this]))
        set MouseX[GetPlayerId(GetOwningPlayer(s__MilimSpells__MilimT2KS_c[this]))]=s__MilimSpells__MilimT2KS_x[this]
        set MouseY[GetPlayerId(GetOwningPlayer(s__MilimSpells__MilimT2KS_c[this]))]=s__MilimSpells__MilimT2KS_y[this]
        call BlzSetUnitFacingEx(s__MilimSpells__MilimT2KS_c[this], s__MilimSpells__MilimT2KS_a[this] * bj_RADTODEG)
        call MakeSound("war3mapimported\\Hero_Milim_T2 1")
        call SetUnitAnimationByIndex(s__MilimSpells__MilimT2KS_c[this], 7)

        set s__MilimSpells__MilimT2KS_e[this]=EffectSpawnColor("war3mapImported\\wos_mr_war3_sxxq3.mdx" , GetUnitX(s__MilimSpells__MilimT2KS_c[this]) , GetUnitY(s__MilimSpells__MilimT2KS_c[this]) , s__MilimSpells__MilimT2KS_a[this] * bj_RADTODEG , 1.50 , 7.00 , 0.00 , 255 , 1 , 1 , 255)
        set s__MilimSpells__MilimT2KS_e2[this]=AddSpecialEffectTarget("war3mapImported\\wos_ly-r-sg.mdx", s__MilimSpells__MilimT2KS_c[this], "chest")
        set s__MilimSpells__MilimT2KS_e4[this]=EffectSpawn("war3mapImported\\wos_4xpinkpillar_3.mdl" , GetUnitX(s__MilimSpells__MilimT2KS_c[this]) , GetUnitY(s__MilimSpells__MilimT2KS_c[this]) , s__MilimSpells__MilimT2KS_a[this] * bj_RADTODEG , 1.50 , 4.50 , 255.00)

        if s__MilimSpells__MilimT2KS_MUI_MilimT2 == 0 then
            call TimerStart(s__MilimSpells__MilimT2KS_t_MilimT2, 0.03, true, function s__MilimSpells__MilimT2KS_Loop_MilimT2)
        endif
    endfunction


    function s__MilimSpells__MilimGKS_GetMaxDamage takes unit c returns real
        if GetHeroLevel(c) >= 35 then
            return MilimG_DamagetoStats3
        elseif GetHeroLevel(c) >= 25 then
            return MilimG_DamagetoStats2
        endif
        return MilimG_DamagetoStats1
    endfunction

    function s__MilimSpells__MilimGKS_UpdateFrame takes unit c returns nothing
        local integer pid= GetPlayerId(GetOwningPlayer(c))
        local real maxDamage= s__MilimSpells__MilimGKS_GetMaxDamage(c)
        local real damage= LoadReal(hs, GetHandleId(c), StringHash("milim g dmg"))

        if damage > maxDamage then
            set damage=maxDamage
            call SaveReal(hs, GetHandleId(c), StringHash("milim g dmg"), damage)
        endif
        if s__MilimSpells__MilimGKS_frame1[pid] != null then
            call BlzFrameSetMinMaxValue(s__MilimSpells__MilimGKS_frame3[pid], 0.00, maxDamage)
            call BlzFrameSetValue(s__MilimSpells__MilimGKS_frame3[pid], damage)
            call BlzFrameSetText(s__MilimSpells__MilimGKS_frame6[pid], "|c00FFFF00" + I2S(R2I(damage)) + "/" + I2S(R2I(maxDamage)) + "|r")
        endif
    endfunction

    function s__MilimSpells__MilimGKS_Start takes unit c returns nothing
        local integer pid
        local real tmpY= 0.0375
        local real maxDamage

        if c == null or GetHeroLevel(c) < 12 then
            return
        endif

        set pid=GetPlayerId(GetOwningPlayer(c))
        set maxDamage=s__MilimSpells__MilimGKS_GetMaxDamage(c)
        if s__MilimSpells__MilimGKS_frame1[pid] == null then
            set s__MilimSpells__MilimGKS_frame1[pid]=BlzCreateFrameByType("BACKDROP", "SS", main_frame, "", 0)
            call BlzFrameSetAbsPoint(s__MilimSpells__MilimGKS_frame1[pid], FRAMEPOINT_CENTER, 0.055, 0.18 + tmpY)
            call BlzFrameSetSize(s__MilimSpells__MilimGKS_frame1[pid], 0.135, 0.035)
            call BlzFrameSetTexture(s__MilimSpells__MilimGKS_frame1[pid], "UI\\Feedback\\XPBar\\human-xpbar-border.blp", 0, false)
            call BlzFrameSetVisible(s__MilimSpells__MilimGKS_frame1[pid], false)

            set s__MilimSpells__MilimGKS_frame2[pid]=BlzCreateFrame("EscMenuControlBackdropTemplate", s__MilimSpells__MilimGKS_frame1[pid], 0, 0)
            call BlzFrameSetAbsPoint(s__MilimSpells__MilimGKS_frame2[pid], FRAMEPOINT_CENTER, 0.07, 0.185 + tmpY)
            call BlzFrameSetSize(s__MilimSpells__MilimGKS_frame2[pid], 0.1, 0.019)

            set s__MilimSpells__MilimGKS_frame3[pid]=BlzCreateFrameByType("STATUSBAR", "", s__MilimSpells__MilimGKS_frame1[pid], "", 0)
            call BlzFrameSetSize(s__MilimSpells__MilimGKS_frame3[pid], 0.1, 0.035)
            call BlzFrameSetScale(s__MilimSpells__MilimGKS_frame3[pid], 0.5)
            call BlzFrameSetModel(s__MilimSpells__MilimGKS_frame3[pid], "ui/feedback/XpBar/XpBarConsole.mdx", 0)
            call BlzFrameSetAbsPoint(s__MilimSpells__MilimGKS_frame3[pid], FRAMEPOINT_CENTER, 0.05, 0.175 + tmpY)
            call BlzFrameSetMinMaxValue(s__MilimSpells__MilimGKS_frame3[pid], 0.00, maxDamage + 10)
            call BlzFrameSetValue(s__MilimSpells__MilimGKS_frame3[pid], 0.00)

            set s__MilimSpells__MilimGKS_frame4[pid]=BlzCreateFrameByType("BACKDROP", "SS", s__MilimSpells__MilimGKS_frame1[pid], "", 0)
            call BlzFrameSetAbsPoint(s__MilimSpells__MilimGKS_frame4[pid], FRAMEPOINT_CENTER, 0.005, 0.18 + tmpY)
            call BlzFrameSetSize(s__MilimSpells__MilimGKS_frame4[pid], 0.03, 0.03)
            call BlzFrameSetTexture(s__MilimSpells__MilimGKS_frame4[pid], "ReplaceableTextures\\CommandButtons\\BTNHero_Milim_G.blp", 0, false)

            set s__MilimSpells__MilimGKS_frame5[pid]=BlzCreateFrameByType("TEXT", "MyPlayerName", s__MilimSpells__MilimGKS_frame1[pid], "", 0)
            call BlzFrameSetAbsPoint(s__MilimSpells__MilimGKS_frame5[pid], FRAMEPOINT_CENTER, 0.07, 0.185 + tmpY)
            call BlzFrameSetText(s__MilimSpells__MilimGKS_frame5[pid], "|c00FFFF00Damage received:|r")
            call BlzFrameSetScale(s__MilimSpells__MilimGKS_frame5[pid], 0.9)

            set s__MilimSpells__MilimGKS_frame6[pid]=BlzCreateFrameByType("TEXT", "MyPlayerName", s__MilimSpells__MilimGKS_frame1[pid], "", 0)
            call BlzFrameSetAbsPoint(s__MilimSpells__MilimGKS_frame6[pid], FRAMEPOINT_CENTER, 0.07, 0.17 + tmpY)
            call BlzFrameSetScale(s__MilimSpells__MilimGKS_frame6[pid], 0.9)
        endif

        if GetLocalPlayer() == GetOwningPlayer(c) then
            call BlzFrameSetVisible(s__MilimSpells__MilimGKS_frame1[pid], true)
        endif
        call s__MilimSpells__MilimGKS_UpdateFrame(c)
    endfunction

    function s__MilimSpells__MilimGKS_AddDamage takes unit c,real amount returns nothing
        local real oldDamage
        local real newDamage
        local real maxDamage

        if c == null or amount <= 0.00 or GetHeroLevel(c) < 12 then
            return
        endif

        set oldDamage=LoadReal(hs, GetHandleId(c), StringHash("milim g dmg"))
        set maxDamage=s__MilimSpells__MilimGKS_GetMaxDamage(c)
        set newDamage=oldDamage + amount
        if newDamage > maxDamage then
            set newDamage=maxDamage
        endif
        call SaveReal(hs, GetHandleId(c), StringHash("milim g dmg"), newDamage)

        if oldDamage < MilimG_DamagetoStats1 and newDamage >= MilimG_DamagetoStats1 then
            if GetUnitAbilityLevel(c, MilimG_Stat_ID1) == 0 then
                call UnitAddAbility(c, MilimG_Stat_ID1)
                call UnitMakeAbilityPermanent(c, true, MilimG_Stat_ID1)
            endif
            call MakeSound("war3mapimported\\Hero_Milim_G1")
        endif
        if GetHeroLevel(c) >= 25 and oldDamage < MilimG_DamagetoStats2 and newDamage >= MilimG_DamagetoStats2 then
            if GetUnitAbilityLevel(c, MilimG_Stat_ID2) == 0 then
                call UnitAddAbility(c, MilimG_Stat_ID2)
                call UnitMakeAbilityPermanent(c, true, MilimG_Stat_ID2)
            endif
            call MakeSound("war3mapimported\\Hero_Milim_G2")
        endif
        if GetHeroLevel(c) >= 35 and oldDamage < MilimG_DamagetoStats3 and newDamage >= MilimG_DamagetoStats3 then
            if GetUnitAbilityLevel(c, MilimG_Stat_ID3) == 0 then
                call UnitAddAbility(c, MilimG_Stat_ID3)
                call UnitMakeAbilityPermanent(c, true, MilimG_Stat_ID3)
            endif
            call MakeSound("war3mapimported\\Hero_Milim_G3")
        endif

        call s__MilimSpells__MilimGKS_Start(c)
    endfunction

    function s__MilimSpells__MilimGKS_Reset takes unit c returns nothing
        if c == null then
            return
        endif
        call UnitRemoveAbility(c, MilimG_Stat_ID1)
        call UnitRemoveAbility(c, MilimG_Stat_ID2)
        call UnitRemoveAbility(c, MilimG_Stat_ID3)
        call SaveReal(hs, GetHandleId(c), StringHash("milim g dmg"), 0.00)
        if GetHeroLevel(c) >= 12 then
            call s__MilimSpells__MilimGKS_Start(c)
        endif
    endfunction




    
