                call BlzFrameSetAbsPoint(s__LaxusSpells___LaxusG_KS_frame_pas1[s__LaxusSpells___LaxusG_KS_k2[this]], FRAMEPOINT_CENTER, 0.055, 0.18)
                call BlzFrameSetSize(s__LaxusSpells___LaxusG_KS_frame_pas1[s__LaxusSpells___LaxusG_KS_k2[this]], 0.135, 0.035)
                call BlzFrameSetTexture(s__LaxusSpells___LaxusG_KS_frame_pas1[s__LaxusSpells___LaxusG_KS_k2[this]], "UI\\Feedback\\XPBar\\human-xpbar-border.blp", 0, false)
