                    call BlzFrameSetEnable(FRAME_Pick[4], false)
                    call BlzFrameSetEnable(FRAME_ICON_Pick[4], false)
                call BlzFrameSetTexture(FRAME_ICON_Pick[4], "Pick\\PickButton_Pick_Ban2", 0, true)
                endif
