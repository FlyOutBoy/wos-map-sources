                    if s__StarrkSpells___StarrkSpells_R_r[this] > 0. and s__StarrkSpells___StarrkSpells_R_r[this] < 0.15 then
                        if s__StarrkSpells___StarrkSpells_R_r2[this] > 0.03 then
