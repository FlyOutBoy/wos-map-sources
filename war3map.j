                    call EffVision(s__GearSystems2__KS_Fear_e[this] , s__GearSystems2__KS_Fear_c[this])
                    call BlzSetSpecialEffectPosition(s__GearSystems2__KS_Fear_e[this], GetUnitX(s__GearSystems2__KS_Fear_c[this]), GetUnitY(s__GearSystems2__KS_Fear_c[this]), GetUnitFlyHeight(s__GearSystems2__KS_Fear_c[this]))
                    if s__GearSystems2__KS_Fear_r2[this] > 0.12 then
