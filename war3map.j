function GearSystems2__InitGearSystems2 takes nothing returns nothing
    set GearTimer03Callback=function GearSystems2__GearTimer03Loop
    set GearTimer05Callback=function GearSystems2__GearTimer05Loop
    set GearTimer10Callback=function GearSystems2__GearTimer10Loop
    set GearTimer03Users=0
    set GearTimer05Users=0
    set GearTimer10Users=0
    set GearTimer03=CreateTimer()
    set GearTimer05=CreateTimer()
    set GearTimer10=CreateTimer()
endfunction


