                    if s__GearSystems2__KS_MoveEffectToUnit_check[this] == StringHash("alucard bullet") then
                        set s__GearSystems2__KS_MoveEffectToUnit_b[this]=s__GearSystems2__KS_MoveEffectToUnit_r[this] < s__GearSystems2__KS_MoveEffectToUnit_rmax[this] and s__GearSystems2__KS_MoveEffectToUnit_e[this] != null and LoadInteger(hs, GetHandleId(s__GearSystems2__KS_MoveEffectToUnit_d[this]), StringHash("alucard bullet")) > 0 and IsUnitType(s__GearSystems2__KS_MoveEffectToUnit_d[this], UNIT_TYPE_DEAD) == false
                
                    endif
                   
                elseif s__GearSystems2__KS_MoveEffectToUnit_check2[this] == 1 then
                    set s__GearSystems2__KS_MoveEffectToUnit_b[this]=s__GearSystems2__KS_MoveEffectToUnit_r[this] < s__GearSystems2__KS_MoveEffectToUnit_rmax[this] and s__GearSystems2__KS_MoveEffectToUnit_e[this] != null
                endif
                if s__GearSystems2__KS_MoveEffectToUnit_b[this] then
                    set s__GearSystems2__KS_MoveEffectToUnit_r[this]=RoundReal(s__GearSystems2__KS_MoveEffectToUnit_r[this] + 0.03 , 3)
