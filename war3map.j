        function s__GearSystems2__KS_DamageOverTime_Loop_DmgPTime takes nothing returns nothing
    local integer this
    local integer i= 0
    loop
        exitwhen i > s__GearSystems2__KS_DamageOverTime_MUI_5
        set this=s__GearSystems2__KS_DamageOverTime_m_5[i]
        if s__GearSystems2__KS_DamageOverTime_r[this] < s__GearSystems2__KS_DamageOverTime_rmax[this] and GetWidgetLife(s__GearSystems2__KS_DamageOverTime_td[this]) > 0.405 then
            set s__GearSystems2__KS_DamageOverTime_r3[this]=RoundReal(s__GearSystems2__KS_DamageOverTime_r3[this] + 0.05 , 3)
            if s__GearSystems2__KS_DamageOverTime_r3[this] >= s__GearSystems2__KS_DamageOverTime_r2[this] - 0.001 then // small epsilon avoids float comparison miss
                set s__GearSystems2__KS_DamageOverTime_r3[this]=0
                set s__GearSystems2__KS_DamageOverTime_r[this]=s__GearSystems2__KS_DamageOverTime_r[this] + 1 // count ticks as integer
                if s__GearSystems2__KS_DamageOverTime_k[this] == 0 then
                if s__GearSystems2__KS_DamageOverTime_s[this] == "murasume" then
                    set MurasameTrigger=true
                    if GetUnitAbilityLevel(s__GearSystems2__KS_DamageOverTime_td[this], 'B005') > 0 then
                    set s__GearSystems2__KS_DamageOverTime_r[this]=999
                    set s__GearSystems2__KS_DamageOverTime_dmg[this]=0
                    endif
                    endif
                    call dmgphys(s__GearSystems2__KS_DamageOverTime_c[this] , s__GearSystems2__KS_DamageOverTime_td[this] , s__GearSystems2__KS_DamageOverTime_dmg[this])
                if s__GearSystems2__KS_DamageOverTime_s[this] == "murasume" then
                    set MurasameTrigger=false
                    endif
                elseif s__GearSystems2__KS_DamageOverTime_k[this] == 1 then
                    call dmgmag(s__GearSystems2__KS_DamageOverTime_c[this] , s__GearSystems2__KS_DamageOverTime_td[this] , s__GearSystems2__KS_DamageOverTime_dmg[this])
                else
                    if s__GearSystems2__KS_DamageOverTime_s[this] == "murasume" then
                    set MurasameTrigger=true
                    if GetUnitAbilityLevel(s__GearSystems2__KS_DamageOverTime_td[this], 'B005') > 0 then
                    set s__GearSystems2__KS_DamageOverTime_r[this]=999
                    set s__GearSystems2__KS_DamageOverTime_dmg[this]=0
                    endif
                    endif
                    call dmgatk(s__GearSystems2__KS_DamageOverTime_c[this] , s__GearSystems2__KS_DamageOverTime_td[this] , s__GearSystems2__KS_DamageOverTime_dmg[this])
                    if s__GearSystems2__KS_DamageOverTime_s[this] == "murasume" then
                    set MurasameTrigger=false
                    endif
                endif
            endif
        else
            set s__GearSystems2__KS_DamageOverTime_td[this]=null
            set s__GearSystems2__KS_DamageOverTime_c[this]=null
            set s__GearSystems2__KS_DamageOverTime_m_5[i]=s__GearSystems2__KS_DamageOverTime_m_5[s__GearSystems2__KS_DamageOverTime_MUI_5]
            set s__GearSystems2__KS_DamageOverTime_MUI_5=s__GearSystems2__KS_DamageOverTime_MUI_5 - 1
            if s__GearSystems2__KS_DamageOverTime_MUI_5 == - 1 then
                call GearTimer05Release()
            endif
            call s__GearSystems2__KS_DamageOverTime_deallocate(this)
                    set i=i - 1
        endif
        set i=i + 1
    endloop
endfunction
    // in struct, replace r/rmax with integers:
// use r = current tick count, rmax = total tick count (integer)
// r3 stays as period accumulator

function s__GearSystems2__KS_DamageOverTime_DmgPTime_Start takes unit NewC,unit NewTd,real NewDmg,real NewDuration,real NewPeriod,integer NewTD,string NewS returns nothing
    local integer this= s__GearSystems2__KS_DamageOverTime__allocate()
    local integer totalTicks
    set s__GearSystems2__KS_DamageOverTime_MUI_5=s__GearSystems2__KS_DamageOverTime_MUI_5 + 1
    set s__GearSystems2__KS_DamageOverTime_m_5[s__GearSystems2__KS_DamageOverTime_MUI_5]=this
    set s__GearSystems2__KS_DamageOverTime_c[this]=NewC
    set s__GearSystems2__KS_DamageOverTime_td[this]=NewTd
    set s__GearSystems2__KS_DamageOverTime_r[this]=0 // elapsed time * 100 as integer to avoid float drift
    set s__GearSystems2__KS_DamageOverTime_r3[this]=0 // period accumulator
    set s__GearSystems2__KS_DamageOverTime_r2[this]=NewPeriod
    set s__GearSystems2__KS_DamageOverTime_k[this]=NewTD
    set s__GearSystems2__KS_DamageOverTime_s[this]=NewS
    if s__GearSystems2__KS_DamageOverTime_r2[this] <= 0 then
        set s__GearSystems2__KS_DamageOverTime_r2[this]=0.05
    endif
    // round to nearest instead of truncating
    set totalTicks=R2I(NewDuration / s__GearSystems2__KS_DamageOverTime_r2[this] + 0.5)
    if totalTicks < 1 then
        set totalTicks=1
    endif
    set s__GearSystems2__KS_DamageOverTime_rmax[this]=totalTicks // store as tick count
    set s__GearSystems2__KS_DamageOverTime_dmg[this]=NewDmg / totalTicks
    if s__GearSystems2__KS_DamageOverTime_MUI_5 == 0 then
        call GearTimer05Acquire()
    endif
endfunction



        function s__GearSystems2__KS_SpellTimer_LoopSpellTimer takes nothing returns nothing
            local integer this
