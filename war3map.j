    call s__TakeshiSpells___TakeshiSpells_E_TakeshiE_Start(c , x , y)
endfunction
function TakeshiE2_Start takes unit c,unit td returns nothing
    call CurseUnit(c , td , 3)
    call MakeSound("war3mapimported\\Hero_Takeshi_FE")
    call s__GearSystems2__KS_DelayedSound_NextSound_Start(("war3mapimported\\Hero_Takeshi_FE2" ) , (( 0.75)*1.0)) // INLINED!!
    call s__GearSystems2__KS_DelayedSound_NextSound_Start(("war3mapimported\\Hero_Takeshi_FE3" ) , (( 1.12)*1.0)) // INLINED!!
    call s__GearSystems2__KS_BuffTimer_MyBuffTime_Start((td ) , ( TakeshiE2_Buff_ID ) , (( TakeshiE2_Duration )*1.0) , ( "BTNHero_Takeshi_E2" ) , ( true ) , ( GetPlayerId(GetOwningPlayer(c))) , 0 , 0 , 0) // INLINED!!
endfunction
function TakeshiE2_Act takes unit c,unit td returns nothing
    local real a= GAngle(c , td)
    local integer i= GetRandomInt(1, 2)
    local real r1= GetRandomReal(80, 180)
    local real r2= 0
    if i == 1 then
        set r2=- 90
    else
        set r2=90
    endif
    call BlinkEff(c)
    call BlinkEff2(c)
    call MoveUnit(c , r1 , a + r2 * bj_DEGTORAD)
    call BlinkEff(c)
endfunction
function TakeshiR_Start takes unit c,unit td returns nothing
    call s__TakeshiSpells___TakeshiSpells_R_TakeshiR_Start(c , td)
endfunction
function TakeshiR2_Start takes unit c returns nothing
    call s__TakeshiSpells___TakeshiSpells_R_TakeshiR2_Start(c)
endfunction
function TakeshiT_Start takes unit c,real x,real y returns nothing
    call s__TakeshiSpells___TakeshiSpells_T_TakeshiT_Start(c , x , y)
endfunction
function TakeshiF_Start takes unit c returns nothing
    local player p= GetOwningPlayer(c)
    if LoadInteger(hs, GetHandleId(p), StringHash("style")) == 0 then
  //  call SaveInteger(hs, GetHandleId(GetOwningPlayer(c)), StringHash(I2S(TakeshiQ2_ID)),0)
        call SaveInteger(hs, GetHandleId(p), StringHash("style"), 1)
        call h__SetPlayerAbilityAvailable(p, TakeshiQ_ID, false)
        call h__SetPlayerAbilityAvailable(p, TakeshiW_ID, false)
        call h__SetPlayerAbilityAvailable(p, TakeshiE_ID, false)
        call h__SetPlayerAbilityAvailable(p, TakeshiR_ID, false)
        call h__SetPlayerAbilityAvailable(p, TakeshiQ2_ID, true)
        call h__SetPlayerAbilityAvailable(p, TakeshiW2_ID, true)
        call h__SetPlayerAbilityAvailable(p, TakeshiE2_ID, true)
        call h__SetPlayerAbilityAvailable(p, TakeshiR2_ID, true)
        call SetUnitAbilityLevel(c, TakeshiF_ID, 2)
        call UnitAddAbility(c, TakeshiQ2_ID)
        call UnitAddAbility(c, TakeshiW2_ID)
        if GetUnitAbilityLevel(c, TakeshiE_ID) > 0 then
            call UnitAddAbility(c, TakeshiE2_ID)
        endif
        if GetUnitAbilityLevel(c, TakeshiR_ID) > 0 then
            call UnitAddAbility(c, TakeshiR2_ID)
        endif
        call SetUnitAbilityLevel(c, TakeshiQ2_ID, GetUnitAbilityLevel(c, TakeshiQ_ID))
        call SetUnitAbilityLevel(c, TakeshiW2_ID, GetUnitAbilityLevel(c, TakeshiW_ID))
        if GetUnitAbilityLevel(c, TakeshiE2_ID) > 0 then
            call SetUnitAbilityLevel(c, TakeshiE2_ID, GetUnitAbilityLevel(c, TakeshiE_ID))
        endif
        if GetUnitAbilityLevel(c, TakeshiR2_ID) > 0 then
            call SetUnitAbilityLevel(c, TakeshiR2_ID, GetUnitAbilityLevel(c, TakeshiR_ID))
        endif
    else
        call SetUnitAbilityLevel(c, TakeshiF_ID, 1)
        call h__SetPlayerAbilityAvailable(p, TakeshiQ2_ID, false)
        call h__SetPlayerAbilityAvailable(p, TakeshiQ3_ID, false)
        call h__SetPlayerAbilityAvailable(p, TakeshiW2_ID, false)
        call h__SetPlayerAbilityAvailable(p, TakeshiE2_ID, false)
        call h__SetPlayerAbilityAvailable(p, TakeshiR2_ID, false)
        call h__SetPlayerAbilityAvailable(p, TakeshiQ_ID, true)
        call h__SetPlayerAbilityAvailable(p, TakeshiW_ID, true)
        call h__SetPlayerAbilityAvailable(p, TakeshiE_ID, true)
        call h__SetPlayerAbilityAvailable(p, TakeshiR_ID, true)
        call SaveInteger(hs, GetHandleId(p), StringHash("style"), 0)
    endif
    set p=null
endfunction

function TakeshiGOff_Start takes unit c returns nothing
local integer k2= GetPlayerId(GetOwningPlayer(c))
local real dmg2= 0
local real rmax= TakeshiG_TakenDamageToEnter
if s__frameTakeshi_pas1[k2] != null then
                call SaveReal(hs, GetHandleId(c), StringHash("takeshi dmg"), dmg2)
                call BlzFrameSetText(s__frameTakeshi_pas6[k2], "|c00FFFF00" + I2S(R2I(dmg2)) + "/" + I2S(R2I(rmax)) + "|r")
                call BlzFrameSetValue(s__frameTakeshi_pas3[k2], dmg2)
                endif
                if TakeshiDummy != null then
                call RemoveUnit(TakeshiDummy)
                set TakeshiDummy=null
                endif
endfunction

function TakeshiG_Start takes unit c returns nothing
    call SaveInteger(hs, GetHandleId(GetOwningPlayer(c)), StringHash(I2S(TakeshiQ2_ID)), 1)
    call s__TakeshiSpells___TakeshiSpells_G_TakeshiG_Start(c)
    call TakeshiGOff_Start(c)
endfunction
