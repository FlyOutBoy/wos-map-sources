    set gg_trg_ItemLeave=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_ItemLeave, EVENT_PLAYER_UNIT_DROP_ITEM)
    call TriggerAddAction(gg_trg_ItemLeave, function Trig_ItemLeave_Actions)
endfunction

