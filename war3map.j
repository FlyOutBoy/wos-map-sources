                                    call dmgmag(s__FrierenSpells__FrierenSpells_Q_c[this] , s__FrierenSpells__FrierenSpells_Q_u[this] , s__FrierenSpells__FrierenSpells_Q_dmg[this])
                                        //call MUE(u, StarrkEQ_PushDistance, StarrkEQ_PushDuration, a)
                                    call GroupAddUnit(s__FrierenSpells__FrierenSpells_Q_g2[this], s__FrierenSpells__FrierenSpells_Q_u[this])
                                    call GroupAddUnit(s__FrierenSpells__FrierenSpells_Q_g3[this], s__FrierenSpells__FrierenSpells_Q_u[this])
