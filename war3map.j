            set s__FrierenSpells__FrierenSpells_E_c[this]=NewC
            set s__FrierenSpells__FrierenSpells_E_statSource[this]=NewStatSource
            set s__FrierenSpells__FrierenSpells_E_r[this]=0
            set s__FrierenSpells__FrierenSpells_E_r6[this]=0
            set s__FrierenSpells__FrierenSpells_E_g2[this]=CreateGroup()
            set s__FrierenSpells__FrierenSpells_E_r3[this]=0
            set s__FrierenSpells__FrierenSpells_E_aoe2[this]=600
            set s__FrierenSpells__FrierenSpells_E_check2[this]=0
            set s__FrierenSpells__FrierenSpells_E_aoe[this]=FrierenE_DamageAoe
            set s__FrierenSpells__FrierenSpells_E_dmg[this]=GetHeroInt(s__FrierenSpells__FrierenSpells_E_statSource[this], true) * ( FrierenE_DamageIntBase + ( FrierenE_DamageIntStep * ( GetUnitAbilityLevel(s__FrierenSpells__FrierenSpells_E_statSource[this], FrierenE_ID) - 1 ) ) )
            set s__FrierenSpells__FrierenSpells_E_dmg[this]=s__FrierenSpells__FrierenSpells_E_dmg[this] + FrierenE_Damage2StaticBase + ( FrierenE_Damage2StaticStep * ( GetUnitAbilityLevel(s__FrierenSpells__FrierenSpells_E_statSource[this], FrierenE_ID) - 1 ) )
            
            if LoadInteger(hs, GetHandleId(s__FrierenSpells__FrierenSpells_E_c[this]), StringHash("mode t")) == 1 then
                set s__FrierenSpells__FrierenSpells_E_check2[this]=1
                set s__FrierenSpells__FrierenSpells_E_aoe2[this]=950
                set s__FrierenSpells__FrierenSpells_E_dmg[this]=s__FrierenSpells__FrierenSpells_E_dmg[this] + GetInt(s__FrierenSpells__FrierenSpells_E_c[this]) * FrierenTE_DamageIncrease
                set s__FrierenSpells__FrierenSpells_E_aoe[this]=s__FrierenSpells__FrierenSpells_E_aoe[this] * ( 1 + ( FrierenTE_DamageAoeIncrease / 100 ) )
