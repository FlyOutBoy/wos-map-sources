                        call s__GearSystems2__KS_Flush_Start((GetHandleId(s__StarrkSpells___StarrkSpells_T_c[this]) ) , ( StringHash("sond cd2") ) , ( 0 ) , (( 1.5)*1.0)) // INLINED!!
