        function ErzaTSpells__PassiveType takes integer check2,integer check3 returns integer
            local integer check4= 0
            if check2 > 0 and check2 == check3 then
                set check4=check2
            elseif check2 > 0 and check3 > 0 then
                if check2 == 1 and check3 == 2 then
                    set check4=4
                endif
                if check2 == 1 and check3 == 3 then
                    set check4=5
                endif
                if check2 == 2 and check3 == 1 then
                    set check4=4
                endif
                if check2 == 2 and check3 == 3 then
                    set check4=6
                endif
                if check2 == 3 and check3 == 1 then
                    set check4=5
                endif
                if check2 == 3 and check3 == 2 then
                    set check4=6
                endif
            elseif check2 > 0 then
                set check4=check2
            endif
            return check4
        endfunction

        function s__ErzaTSpells__Erza5Q_KS_Loop_ErzaQ takes nothing returns nothing
            local integer this
            local integer i= 0
            local real random
            loop
                exitwhen i > s__ErzaTSpells__Erza5Q_KS_MUI_ErzaQ
                set this=s__ErzaTSpells__Erza5Q_KS_m_ErzaQ[i]
                if SpellBoolCaster(s__ErzaTSpells__Erza5Q_KS_c[this]) and SpellBoolCaster(s__ErzaTSpells__Erza5Q_KS_td[this]) and s__ErzaTSpells__Erza5Q_KS_r[this] <= s__ErzaTSpells__Erza5Q_KS_rmax[this] then
                    set s__ErzaTSpells__Erza5Q_KS_r[this]=s__ErzaTSpells__Erza5Q_KS_r[this] + 0.03
                    call DebugUnit2(s__ErzaTSpells__Erza5Q_KS_c[this])
                    if s__ErzaTSpells__Erza5Q_KS_check[this] < 2 then
                        set s__ErzaTSpells__Erza5Q_KS_a[this]=GAngle(s__ErzaTSpells__Erza5Q_KS_c[this] , s__ErzaTSpells__Erza5Q_KS_td[this])
                        call SetUnitFacing(s__ErzaTSpells__Erza5Q_KS_c[this], s__ErzaTSpells__Erza5Q_KS_a[this] * bj_RADTODEG)
                    endif
                    if s__ErzaTSpells__Erza5Q_KS_check[this] == 0 then
                        if s__ErzaTSpells__Erza5Q_KS_r[this] == 0.21 then
                            call SetUnitTimeScale(s__ErzaTSpells__Erza5Q_KS_c[this], 0.5)
                            set s__ErzaTSpells__Erza5Q_KS_r2[this]=10
                        endif
                        if s__ErzaTSpells__Erza5Q_KS_r[this] == 0.3 then
                            call MakeSound("war3mapImported\\Hero_Erza5_Q03")
                        endif
                        if s__ErzaTSpells__Erza5Q_KS_r[this] == 0.42 then
                            set s__ErzaTSpells__Erza5Q_KS_k[this]=0
                            loop
                                exitwhen s__ErzaTSpells__Erza5Q_KS_k[this] > 4
                                call DestroyEffect(s___ErzaTSpells__Erza5Q_KS_ee[s__ErzaTSpells__Erza5Q_KS_ee[this]+s__ErzaTSpells__Erza5Q_KS_k[this]])
                                call BlzSetSpecialEffectTimeScale(s___ErzaTSpells__Erza5Q_KS_ee[s__ErzaTSpells__Erza5Q_KS_ee[this]+s__ErzaTSpells__Erza5Q_KS_k[this]], 0.4)
                                set s__ErzaTSpells__Erza5Q_KS_k[this]=s__ErzaTSpells__Erza5Q_KS_k[this] + 1
                            endloop
                        endif
                        if s__ErzaTSpells__Erza5Q_KS_r[this] > 0.42 then
                            set s__ErzaTSpells__Erza5Q_KS_x[this]=GetUnitX(s__ErzaTSpells__Erza5Q_KS_td[this])
                            set s__ErzaTSpells__Erza5Q_KS_y[this]=GetUnitY(s__ErzaTSpells__Erza5Q_KS_td[this])
                            set s__ErzaTSpells__Erza5Q_KS_k[this]=0
                            loop
