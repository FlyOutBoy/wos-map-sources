    call CustomChat_RegisterCommand(14 , "ustal" , "war3mapImported\\Emoji_ustal.blp")
    call CustomChat_RegisterCommand(15 , "what" , "war3mapImported\\Emoji_whaaat.blp")
endfunction

function CustomImageChat___ConfigureEmojiAccess takes nothing returns nothing
    // =====================================================================
    // FREE PLAYER: 5 explicitly selected emojis.
    // Change the Count and IDs below. IDs refer to RegisterDefaultEmojis.
    set CustomImageChat___EmojiAccessFreeCount=5
    set CustomImageChat___EmojiAccessFree[1]=1 // kek
    set CustomImageChat___EmojiAccessFree[2]=2 // sadge
    set CustomImageChat___EmojiAccessFree[3]=3 // pog
    set CustomImageChat___EmojiAccessFree[4]=6 // cry
    set CustomImageChat___EmojiAccessFree[5]=15 // what

    // VIP LEVEL 3 (HIGHEST): all 15 registered emojis.
    set CustomImageChat___EmojiAccessVIP3Count=15
    set CustomImageChat___EmojiAccessVIP3[1]=1
    set CustomImageChat___EmojiAccessVIP3[2]=2
    set CustomImageChat___EmojiAccessVIP3[3]=3
    set CustomImageChat___EmojiAccessVIP3[4]=4
    set CustomImageChat___EmojiAccessVIP3[5]=5
    set CustomImageChat___EmojiAccessVIP3[6]=6
    set CustomImageChat___EmojiAccessVIP3[7]=7
    set CustomImageChat___EmojiAccessVIP3[8]=8
    set CustomImageChat___EmojiAccessVIP3[9]=9
    set CustomImageChat___EmojiAccessVIP3[10]=10
    set CustomImageChat___EmojiAccessVIP3[11]=11
    set CustomImageChat___EmojiAccessVIP3[12]=12
    set CustomImageChat___EmojiAccessVIP3[13]=13
    set CustomImageChat___EmojiAccessVIP3[14]=14
    set CustomImageChat___EmojiAccessVIP3[15]=15

    // VIP LEVEL 2: 12 explicitly selected emojis.
    set CustomImageChat___EmojiAccessVIP2Count=12
    set CustomImageChat___EmojiAccessVIP2[1]=1
    set CustomImageChat___EmojiAccessVIP2[2]=2
    set CustomImageChat___EmojiAccessVIP2[3]=3
    set CustomImageChat___EmojiAccessVIP2[4]=4
    set CustomImageChat___EmojiAccessVIP2[5]=5
    set CustomImageChat___EmojiAccessVIP2[6]=6
    set CustomImageChat___EmojiAccessVIP2[7]=7
    set CustomImageChat___EmojiAccessVIP2[8]=8
    set CustomImageChat___EmojiAccessVIP2[9]=9
    set CustomImageChat___EmojiAccessVIP2[10]=10
    set CustomImageChat___EmojiAccessVIP2[11]=11
    set CustomImageChat___EmojiAccessVIP2[12]=12

    // VIP LEVEL 1 (LOWEST VIP): 9 explicitly selected emojis.
    set CustomImageChat___EmojiAccessVIP1Count=9
    set CustomImageChat___EmojiAccessVIP1[1]=1
    set CustomImageChat___EmojiAccessVIP1[2]=2
    set CustomImageChat___EmojiAccessVIP1[3]=3
    set CustomImageChat___EmojiAccessVIP1[4]=4
    set CustomImageChat___EmojiAccessVIP1[5]=5
    set CustomImageChat___EmojiAccessVIP1[6]=6
    set CustomImageChat___EmojiAccessVIP1[7]=7
    set CustomImageChat___EmojiAccessVIP1[8]=10
    set CustomImageChat___EmojiAccessVIP1[9]=15
    // =====================================================================
endfunction

function CustomImageChat___CreateEmojiFeed takes nothing returns nothing
    local integer i= 1

    loop
        exitwhen i > CustomImageChat___EMOJI_FEED_SIZE

        // These output frames are attached directly to Game UI. There is no
        // sized parent FRAME, so no invisible 0.145 x 0.150 mouse-blocking box.
        set CustomImageChat___EmojiFeedName[i]=BlzCreateFrameByType("TEXT", "NativeEmojiFeedName", BlzGetOriginFrame(ORIGIN_FRAME_GAME_UI, 0), "", 0)
        call BlzFrameSetSize(CustomImageChat___EmojiFeedName[i], 0.102, 0.018)
        call BlzFrameSetFont(CustomImageChat___EmojiFeedName[i], "Fonts\\FRIZQT__.TTF", 0.011, 0)
        call BlzFrameSetTextAlignment(CustomImageChat___EmojiFeedName[i], TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_RIGHT)
        call BlzFrameSetEnable(CustomImageChat___EmojiFeedName[i], false)
        call BlzFrameSetVisible(CustomImageChat___EmojiFeedName[i], false)

        set CustomImageChat___EmojiFeedIcon[i]=BlzCreateFrameByType("BACKDROP", "NativeEmojiFeedIcon", BlzGetOriginFrame(ORIGIN_FRAME_GAME_UI, 0), "", 0)
        call BlzFrameSetSize(CustomImageChat___EmojiFeedIcon[i], 0.027, 0.027)
        call BlzFrameSetEnable(CustomImageChat___EmojiFeedIcon[i], false)
        call BlzFrameSetVisible(CustomImageChat___EmojiFeedIcon[i], false)

        set i=i + 1
    endloop
endfunction

function CustomImageChat___CreateEmojiPalette takes nothing returns nothing
    local integer i= 1
    local integer column
    local integer row
    local real x
    local real y

    set EmojiToggle=BlzCreateFrameByType("BUTTON", "NativeEmojiToggle", BlzGetOriginFrame(ORIGIN_FRAME_GAME_UI, 0), "ScoreScreenTabButtonTemplate", 0)
    call BlzFrameSetAbsPoint(EmojiToggle, FRAMEPOINT_CENTER, CustomImageChat___EMOJI_TOGGLE_X, CustomImageChat___EMOJI_TOGGLE_Y)
    call BlzFrameSetSize(EmojiToggle, CustomImageChat___EMOJI_TOGGLE_SIZE, CustomImageChat___EMOJI_TOGGLE_SIZE)
    call BlzFrameSetVisible(EmojiToggle, false)
    set CustomImageChat___EmojiToggleIcon=BlzCreateFrameByType("BACKDROP", "NativeEmojiToggleIcon", EmojiToggle, "", 0)
    call BlzFrameSetAllPoints(CustomImageChat___EmojiToggleIcon, EmojiToggle)
    call BlzFrameSetTexture(CustomImageChat___EmojiToggleIcon, CustomImageChat___EmojiPath[1], 0, true)
    call BlzFrameSetEnable(CustomImageChat___EmojiToggleIcon, false)
    set EmojiMuteButton=BlzCreateFrameByType("BUTTON", "NativeEmojiMuteButton", BlzGetOriginFrame(ORIGIN_FRAME_GAME_UI, 0), "ScoreScreenTabButtonTemplate", 0)
    call BlzFrameSetAbsPoint(EmojiMuteButton, FRAMEPOINT_CENTER, CustomImageChat___EMOJI_MUTE_X, CustomImageChat___EMOJI_MUTE_Y)
    call BlzFrameSetSize(EmojiMuteButton, CustomImageChat___EMOJI_TOGGLE_SIZE, CustomImageChat___EMOJI_TOGGLE_SIZE)

    set CustomImageChat___EmojiMuteIcon=BlzCreateFrameByType("BACKDROP", "NativeEmojiMuteIcon", EmojiMuteButton, "", 0)
    call BlzFrameSetAllPoints(CustomImageChat___EmojiMuteIcon, EmojiMuteButton)
    call BlzFrameSetTexture(CustomImageChat___EmojiMuteIcon, "Pick\\PickButton_Pick_Ban", 0, true)
    call BlzFrameSetEnable(CustomImageChat___EmojiMuteIcon, false)
    
    call BlzFrameSetVisible(EmojiMuteButton, false)
    set CustomImageChat___EmojiPanel=BlzCreateFrameByType("BACKDROP", "NativeEmojiPanel", BlzGetOriginFrame(ORIGIN_FRAME_GAME_UI, 0), "", 0)
    call BlzFrameSetAbsPoint(CustomImageChat___EmojiPanel, FRAMEPOINT_BOTTOMLEFT, CustomImageChat___EMOJI_PANEL_X, CustomImageChat___EMOJI_PANEL_Y)
    call BlzFrameSetSize(CustomImageChat___EmojiPanel, 0.172, 0.106)
    call BlzFrameSetTexture(CustomImageChat___EmojiPanel, "Textures\\black32.blp", 0, true)
    call BlzFrameSetAlpha(CustomImageChat___EmojiPanel, 190)
    call BlzFrameSetLevel(CustomImageChat___EmojiPanel, 1)
    // Disable the semi-transparent backdrop itself. EmojiButton frames are
    // independent Game UI children and remain fully opaque/interactable.
    call BlzFrameSetEnable(CustomImageChat___EmojiPanel, false)

    loop
        exitwhen i > ChatImageCommandCount

        set column=ModuloInteger(i - 1, CustomImageChat___EMOJI_COLUMNS)
        set row=( i - 1 ) / CustomImageChat___EMOJI_COLUMNS
        set x=0.005 + I2R(column) * CustomImageChat___EMOJI_BUTTON_STEP
        set y=0.005 + I2R(2 - row) * CustomImageChat___EMOJI_BUTTON_STEP

        // Parent buttons directly to Game UI. EmojiPanel has alpha 190;
        // keeping buttons outside it prevents inherited transparency.
        set CustomImageChat___EmojiButton[i]=BlzCreateFrameByType("BUTTON", "NativeEmojiButton", BlzGetOriginFrame(ORIGIN_FRAME_GAME_UI, 0), "ScoreScreenTabButtonTemplate", 0)
        call BlzFrameSetPoint(CustomImageChat___EmojiButton[i], FRAMEPOINT_BOTTOMLEFT, CustomImageChat___EmojiPanel, FRAMEPOINT_BOTTOMLEFT, x, y)
        call BlzFrameSetSize(CustomImageChat___EmojiButton[i], CustomImageChat___EMOJI_BUTTON_SIZE, CustomImageChat___EMOJI_BUTTON_SIZE)
        call BlzFrameSetAlpha(CustomImageChat___EmojiButton[i], 255)
        call BlzFrameSetLevel(CustomImageChat___EmojiButton[i], 2)

        set CustomImageChat___EmojiButtonIcon[i]=BlzCreateFrameByType("BACKDROP", "NativeEmojiButtonIcon", CustomImageChat___EmojiButton[i], "", 0)
        call BlzFrameSetAllPoints(CustomImageChat___EmojiButtonIcon[i], CustomImageChat___EmojiButton[i])
        call BlzFrameSetTexture(CustomImageChat___EmojiButtonIcon[i], CustomImageChat___EmojiPath[i], 0, true)
        call BlzFrameSetAlpha(CustomImageChat___EmojiButtonIcon[i], 255)
        call BlzFrameSetEnable(CustomImageChat___EmojiButtonIcon[i], false)
        call BlzFrameSetVisible(CustomImageChat___EmojiButton[i], false)

        call BlzTriggerRegisterFrameEvent(CustomImageChat___EmojiClickTrig, CustomImageChat___EmojiButton[i], FRAMEEVENT_CONTROL_CLICK)

        set i=i + 1
    endloop

    call BlzTriggerRegisterFrameEvent(CustomImageChat___EmojiClickTrig, EmojiToggle, FRAMEEVENT_CONTROL_CLICK)
    call BlzTriggerRegisterFrameEvent(CustomImageChat___EmojiClickTrig, EmojiMuteButton, FRAMEEVENT_CONTROL_CLICK)
    call BlzFrameSetVisible(CustomImageChat___EmojiPanel, false)
endfunction

function CustomImageChat___Init takes nothing returns nothing
    local integer i= 0

    call CustomImageChat___RegisterDefaultEmojis()
    call CustomImageChat___ConfigureEmojiAccess()

    set CustomImageChat___EmojiClickTrig=CreateTrigger()
    set CustomImageChat___EmojiSyncTrig=CreateTrigger()
    set CustomImageChat___EmojiTypedTrig=CreateTrigger()
    set CustomImageChat___EmojiTimer=CreateTimer()

    call CustomImageChat___CreateEmojiFeed()
    call CustomImageChat___CreateEmojiPalette()

    loop
        exitwhen i >= bj_MAX_PLAYERS

        set CustomImageChat___PlayerEmojiEnabled[i]=true
        call BlzTriggerRegisterPlayerSyncEvent(CustomImageChat___EmojiSyncTrig, Player(i), "NEMJ", false)

        if CustomImageChat___EMOJI_ENABLE_TYPED_COMMANDS then
            call TriggerRegisterPlayerChatEvent(CustomImageChat___EmojiTypedTrig, Player(i), "", false)
        endif

        set i=i + 1
    endloop

    call TriggerAddAction(CustomImageChat___EmojiClickTrig, function CustomImageChat___OnEmojiFrameClick)
    call TriggerAddAction(CustomImageChat___EmojiSyncTrig, function CustomImageChat___OnEmojiSync)

    if CustomImageChat___EMOJI_ENABLE_TYPED_COMMANDS then
        call TriggerAddAction(CustomImageChat___EmojiTypedTrig, function CustomImageChat___OnTypedEmoji)
    endif

    call TimerStart(CustomImageChat___EmojiTimer, 0.05, true, function CustomImageChat___EmojiPeriodic)

    // Native chat is never cleared or replaced by this emoji system.
endfunction


