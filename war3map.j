                            call GroupRemoveUnit(s__AstaSpells___AstaSpells_F_g[this], s__AstaSpells___AstaSpells_F_u[this])
                        endloop
                    else
                        set s__AstaSpells___AstaSpells_F_r2[this]=s__AstaSpells___AstaSpells_F_r2[this] + 0.03
                    endif
                else
                    call ColorEffDummy3(s__AstaSpells___AstaSpells_F_e[this] , 0 , 255 , 255 , 255 , 0.35)
                    call DestroyGroup(s__AstaSpells___AstaSpells_F_g[this])
