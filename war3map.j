call SaveInteger(hs, GetHandleId(s__GearSystems2__KS_FakeCooldown_c[this]), StringHash("fake cd count"), LoadInteger(hs, GetHandleId(s__GearSystems2__KS_FakeCooldown_c[this]), StringHash("fake cd count")) + 1)
