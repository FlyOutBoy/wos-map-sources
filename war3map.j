            endif
            set s__BrandishSpells___BrandishSpells_F_scale2[this]=s__BrandishSpells_Utility_GetTotalScale(s__BrandishSpells___BrandishSpells_F_td[this])
            call ScaleDummy(s__BrandishSpells___BrandishSpells_F_td[this] , 0.50 , s__BrandishSpells___BrandishSpells_F_scale[this] , s__BrandishSpells___BrandishSpells_F_scale2[this])
            set s__BrandishSpells___BrandishSpells_F_rmax[this]=BrandishF_Time
            call Brandish_RestoreOrder(s__BrandishSpells___BrandishSpells_F_c[this] , 5)
            if s__BrandishSpells___BrandishSpells_F_MUI_BrandishF == 0 then
                call BrandishSpells___BrandishTimer05Acquire()
            endif
        endfunction

    //===========================================================================
    // Инициализация библиотеки и публичный интерфейс
    //===========================================================================
    function BrandishSpells___BrandishTimer03Loop takes nothing returns nothing
        call s__BrandishSpells___BrandishSpells_Q_Loop_BrandishQ()
    endfunction

    function BrandishSpells___BrandishTimer05Loop takes nothing returns nothing
        call s__BrandishSpells___BrandishSpells_W_Loop_BrandishW()
        call s__BrandishSpells___BrandishSpells_R_Loop_BrandishR()
        call s__BrandishSpells___BrandishSpells_T_Loop_BrandishT()
        call s__BrandishSpells___BrandishSpells_F_Loop_BrandishF()
    endfunction

    function BrandishSpells___BrandishTimerELoop takes nothing returns nothing
        call s__BrandishSpells___BrandishSpells_E_Loop_BrandishE()
    endfunction

    function BrandishSpells___BrandishTimerFLoop takes nothing returns nothing
        call s__BrandishSpells___BrandishSpells_F_Loop_BrandishF()
    endfunction

    function BrandishSpells___InitBrandishSpells takes nothing returns nothing
        set BrandishSpells___BrandishTimer03=CreateTimer()
        set BrandishSpells___BrandishTimer03Callback=function BrandishSpells___BrandishTimer03Loop

        set BrandishSpells___BrandishTimer05=CreateTimer()
        set BrandishSpells___BrandishTimer05Callback=function BrandishSpells___BrandishTimer05Loop

        set BrandishSpells___BrandishTimerE=CreateTimer()
        set BrandishSpells___BrandishTimerECallback=function BrandishSpells___BrandishTimerELoop

        set BrandishSpells___BrandishTimerF=CreateTimer()
        set BrandishSpells___BrandishTimerFCallback=function BrandishSpells___BrandishTimerFLoop
    endfunction

    function BrandishQ_Start takes unit c,real x,real y returns nothing
        call s__BrandishSpells___BrandishSpells_Q_BrandishQ_Start(c , x , y)
    endfunction

    function BrandishW_Start takes unit c,real x,real y returns nothing
        call s__BrandishSpells___BrandishSpells_W_BrandishW_Start(c , x , y)
    endfunction

    function BrandishE_Start takes unit c,unit td returns nothing
        call s__BrandishSpells___BrandishSpells_E_BrandishE_Start(c , td)
    endfunction

    function BrandishR_Start takes unit c,real x,real y returns nothing
        call s__BrandishSpells___BrandishSpells_R_BrandishR_Start(c , x , y)
    endfunction

    function BrandishT_Start takes unit c returns nothing
        call s__BrandishSpells___BrandishSpells_T_BrandishT_Start(c)
    endfunction

    function BrandishF_Start takes unit c,unit td returns nothing
        call s__BrandishSpells___BrandishSpells_F_BrandishF_Start(c , td)
    endfunction


//library BrandishSpells ends
//library CustomImageChat:
function CustomChat_SetPlayerAccessLevel takes player p,integer level returns nothing
    set CustomImageChat___PlayerEmojiAccessLevel[GetPlayerId(p)]=level
endfunction
function CustomImageChat___GetColoredPlayerName takes player p returns string
    local integer id= GetPlayerId(p)

    if id == 0 then
        return "|cffff0303" + GetPlayerName(p)
    elseif id == 1 then
        return "|cff0042ff" + GetPlayerName(p)
    elseif id == 2 then
        return "|cff1be7ba" + GetPlayerName(p)
    elseif id == 3 then
        return "|cff550081" + GetPlayerName(p)
    elseif id == 4 then
        return "|cfffefc00" + GetPlayerName(p)
    elseif id == 5 then
        return "|cfffe890d" + GetPlayerName(p)
    elseif id == 6 then
        return "|cff21bf00" + GetPlayerName(p)
    elseif id == 7 then
        return "|cffe45caf" + GetPlayerName(p)
    elseif id == 8 then
        return "|cff939596" + GetPlayerName(p)
    elseif id == 9 then
        return "|cff7ebff1" + GetPlayerName(p)
    elseif id == 10 then
        return "|cff106247" + GetPlayerName(p)
    elseif id == 11 then
        return "|cff4f2b05" + GetPlayerName(p)
    endif

    return "|cffffffff" + GetPlayerName(p)
endfunction

// VIP3 is the highest level, then VIP2, VIP1 and finally the free list.
// If one nickname is present in several VIPCheck functions, the highest level wins.
function CustomImageChat___GetEmojiAccessLevel takes player p returns integer
    return CustomImageChat___PlayerEmojiAccessLevel[GetPlayerId(p)]
endfunction

function CustomImageChat___GetEmojiAccessCount takes integer accessLevel returns integer
    if accessLevel == 1 then
        return CustomImageChat___EmojiAccessVIP1Count
    elseif accessLevel == 2 then
        return CustomImageChat___EmojiAccessVIP2Count
    elseif accessLevel == 3 then
        return CustomImageChat___EmojiAccessVIP3Count
    endif

    return CustomImageChat___EmojiAccessFreeCount
endfunction

function CustomImageChat___GetEmojiAccessId takes integer accessLevel,integer slot returns integer
    if accessLevel == 1 then
        return CustomImageChat___EmojiAccessVIP1[slot]
    elseif accessLevel == 2 then
        return CustomImageChat___EmojiAccessVIP2[slot]
    elseif accessLevel == 3 then
        return CustomImageChat___EmojiAccessVIP3[slot]
    endif

    return CustomImageChat___EmojiAccessFree[slot]
endfunction

function CustomImageChat___IsEmojiAllowed takes player p,integer emojiId returns boolean
    local integer accessLevel= (CustomImageChat___PlayerEmojiAccessLevel[GetPlayerId((p))]) // INLINED!!
    local integer accessCount= CustomImageChat___GetEmojiAccessCount(accessLevel)
    local integer slot= 1

    loop
        exitwhen slot > accessCount

        if CustomImageChat___GetEmojiAccessId(accessLevel , slot) == emojiId then
            return true
        endif

        set slot=slot + 1
    endloop

    return false
endfunction

function CustomImageChat___GetFeedAlpha takes integer index returns integer
    local real fadeStart= CustomImageChat___EMOJI_DURATION - CustomImageChat___EMOJI_FADE_TIME
    local integer alpha

    if CustomImageChat___FeedAge[index] <= fadeStart then
        return 255
    endif

    set alpha=255 - R2I(( ( CustomImageChat___FeedAge[index] - fadeStart ) / CustomImageChat___EMOJI_FADE_TIME ) * 255.00)

    if alpha < 0 then
        return 0
    endif

    return alpha
endfunction

function CustomImageChat___HideFeedFrames takes nothing returns nothing
    local integer i= 1

    loop
        exitwhen i > CustomImageChat___EMOJI_FEED_SIZE
        call BlzFrameSetVisible(CustomImageChat___EmojiFeedName[i], false)
        call BlzFrameSetVisible(CustomImageChat___EmojiFeedIcon[i], false)
        set i=i + 1
    endloop
endfunction

function CustomImageChat___RenderFeed takes nothing returns nothing
    local integer i= 1
    local integer alpha
    local real y

    call CustomImageChat___HideFeedFrames()

    if not CustomImageChat___PlayerEmojiEnabled[GetPlayerId(GetLocalPlayer())] then
        return
    endif

    loop
        exitwhen i > CustomImageChat___FeedCount

        // The newest post stays at the bottom; older posts move upward.
        set y=I2R(CustomImageChat___FeedCount - i) * CustomImageChat___EMOJI_ROW_HEIGHT
        set alpha=CustomImageChat___GetFeedAlpha(i)

        call BlzFrameClearAllPoints(CustomImageChat___EmojiFeedName[i])
        call BlzFrameSetAbsPoint(CustomImageChat___EmojiFeedName[i], FRAMEPOINT_BOTTOMLEFT, CustomImageChat___EMOJI_FEED_X, CustomImageChat___EMOJI_FEED_Y + y + 0.005)
        call BlzFrameSetText(CustomImageChat___EmojiFeedName[i], CustomImageChat___GetColoredPlayerName(Player(CustomImageChat___FeedSenderPid[i])) + ":|r")
        call BlzFrameSetAlpha(CustomImageChat___EmojiFeedName[i], alpha)
        call BlzFrameSetVisible(CustomImageChat___EmojiFeedName[i], true)

        call BlzFrameClearAllPoints(CustomImageChat___EmojiFeedIcon[i])
        call BlzFrameSetAbsPoint(CustomImageChat___EmojiFeedIcon[i], FRAMEPOINT_BOTTOMLEFT, CustomImageChat___EMOJI_FEED_X + 0.105, CustomImageChat___EMOJI_FEED_Y + y)
        call BlzFrameSetTexture(CustomImageChat___EmojiFeedIcon[i], CustomImageChat___EmojiPath[CustomImageChat___FeedEmojiId[i]], 0, true)
        call BlzFrameSetAlpha(CustomImageChat___EmojiFeedIcon[i], alpha)
        call BlzFrameSetVisible(CustomImageChat___EmojiFeedIcon[i], true)

        set i=i + 1
    endloop
endfunction

function CustomImageChat___ShiftFeedLeft takes nothing returns nothing
    local integer i= 1

    loop
        exitwhen i >= CustomImageChat___FeedCount
        set CustomImageChat___FeedSenderPid[i]=CustomImageChat___FeedSenderPid[i + 1]
        set CustomImageChat___FeedEmojiId[i]=CustomImageChat___FeedEmojiId[i + 1]
        set CustomImageChat___FeedAge[i]=CustomImageChat___FeedAge[i + 1]
        set i=i + 1
    endloop

    if CustomImageChat___FeedCount > 0 then
        set CustomImageChat___FeedSenderPid[CustomImageChat___FeedCount]=0
        set CustomImageChat___FeedEmojiId[CustomImageChat___FeedCount]=0
        set CustomImageChat___FeedAge[CustomImageChat___FeedCount]=0.00
        set CustomImageChat___FeedCount=CustomImageChat___FeedCount - 1
    endif
endfunction

function CustomImageChat___AddEmojiPost takes player sender,integer emojiId returns nothing
    if IsObserverSlot(GetPlayerId(sender)) or emojiId <= 0 or emojiId > ChatImageCommandCount or CustomImageChat___EmojiPath[emojiId] == "" then
        return
    endif

    // This is a local display preference. Feed arrays are used only by frames,
    // so clients are allowed to keep different local histories.
    if not CustomImageChat___PlayerEmojiEnabled[GetPlayerId(GetLocalPlayer())] then
        return
    endif

    if not CustomImageChat___IsEmojiAllowed(sender , emojiId) then
        return
    endif

    if CustomImageChat___FeedCount >= CustomImageChat___EMOJI_FEED_SIZE then
        call CustomImageChat___ShiftFeedLeft()
    endif

    set CustomImageChat___FeedCount=CustomImageChat___FeedCount + 1
    set CustomImageChat___FeedSenderPid[CustomImageChat___FeedCount]=GetPlayerId(sender)
    set CustomImageChat___FeedEmojiId[CustomImageChat___FeedCount]=emojiId
    set CustomImageChat___FeedAge[CustomImageChat___FeedCount]=0.00

    call CustomImageChat___RenderFeed()
endfunction

function CustomImageChat___EmojiPeriodic takes nothing returns nothing
    local integer i= 1

    loop
        exitwhen i > CustomImageChat___FeedCount
        set CustomImageChat___FeedAge[i]=CustomImageChat___FeedAge[i] + 0.05
        set i=i + 1
    endloop

    loop
        exitwhen CustomImageChat___FeedCount == 0 or CustomImageChat___FeedAge[1] < CustomImageChat___EMOJI_DURATION
        call CustomImageChat___ShiftFeedLeft()
    endloop

    call CustomImageChat___RenderFeed()
endfunction

function CustomImageChat___OnEmojiSync takes nothing returns nothing
    local integer emojiId= S2I(BlzGetTriggerSyncData())

    if emojiId > 0 and emojiId <= ChatImageCommandCount then
        call CustomImageChat___AddEmojiPost(GetTriggerPlayer() , emojiId)
    endif
endfunction

function CustomImageChat___HideEmojiPaletteButtons takes nothing returns nothing
    local integer i= 1

    loop
        exitwhen i > ChatImageCommandCount
        call BlzFrameSetVisible(CustomImageChat___EmojiButton[i], false)
        set i=i + 1
    endloop
endfunction

function CustomImageChat___ApplyEmojiPaletteForPlayer takes player p returns nothing
    local integer accessLevel= (CustomImageChat___PlayerEmojiAccessLevel[GetPlayerId((p))]) // INLINED!!
    local integer accessCount= CustomImageChat___GetEmojiAccessCount(accessLevel)
    local integer visibleCount= 0
    local integer visibleSlot= 0
    local integer columnsUsed
    local integer rowsUsed
    local integer emojiId
    local integer column
    local integer row
    local integer i= 1
    local real panelWidth
    local real panelHeight
    local real x
    local real y

    // Hide the complete shared button pool first. Only the local player's
    // explicitly allowed IDs are made visible below.
    call CustomImageChat___HideEmojiPaletteButtons()

    set i=1
    loop
        exitwhen i > accessCount
        set emojiId=CustomImageChat___GetEmojiAccessId(accessLevel , i)

        if emojiId > 0 and emojiId <= ChatImageCommandCount and CustomImageChat___EmojiPath[emojiId] != "" then
            set visibleCount=visibleCount + 1
        endif

        set i=i + 1
    endloop

    if visibleCount <= 0 then
        call BlzFrameSetSize(CustomImageChat___EmojiPanel, 0.040, 0.040)
        return
    endif

    set columnsUsed=visibleCount
    if columnsUsed > CustomImageChat___EMOJI_COLUMNS then
        set columnsUsed=CustomImageChat___EMOJI_COLUMNS
    endif

    set rowsUsed=( visibleCount + CustomImageChat___EMOJI_COLUMNS - 1 ) / CustomImageChat___EMOJI_COLUMNS
    set panelWidth=0.010 + CustomImageChat___EMOJI_BUTTON_SIZE + I2R(columnsUsed - 1) * CustomImageChat___EMOJI_BUTTON_STEP
    set panelHeight=0.010 + CustomImageChat___EMOJI_BUTTON_SIZE + I2R(rowsUsed - 1) * CustomImageChat___EMOJI_BUTTON_STEP
    call BlzFrameSetSize(CustomImageChat___EmojiPanel, panelWidth, panelHeight)

    set i=1
    loop
        exitwhen i > accessCount
        set emojiId=CustomImageChat___GetEmojiAccessId(accessLevel , i)

        if emojiId > 0 and emojiId <= ChatImageCommandCount and CustomImageChat___EmojiPath[emojiId] != "" then
            set column=ModuloInteger(visibleSlot, CustomImageChat___EMOJI_COLUMNS)
            set row=visibleSlot / CustomImageChat___EMOJI_COLUMNS
            set x=0.005 + I2R(column) * CustomImageChat___EMOJI_BUTTON_STEP
            set y=0.005 + I2R(row) * CustomImageChat___EMOJI_BUTTON_STEP

            call BlzFrameClearAllPoints(CustomImageChat___EmojiButton[emojiId])
            call BlzFrameSetPoint(CustomImageChat___EmojiButton[emojiId], FRAMEPOINT_BOTTOMLEFT, CustomImageChat___EmojiPanel, FRAMEPOINT_BOTTOMLEFT, x, y)
            call BlzFrameSetVisible(CustomImageChat___EmojiButton[emojiId], true)

            set visibleSlot=visibleSlot + 1
        endif

        set i=i + 1
    endloop
endfunction

function CustomImageChat___OnEmojiFrameClick takes nothing returns nothing
    local framehandle clicked= BlzGetTriggerFrame()
    local player p= GetTriggerPlayer()
    local integer pid= GetPlayerId(p)
    local integer i= 1

    if clicked == EmojiToggle then
        if GetLocalPlayer() == p then
            set CustomImageChat___EmojiPanelOpen=not CustomImageChat___EmojiPanelOpen
            if CustomImageChat___EmojiPanelOpen then
                call CustomImageChat___ApplyEmojiPaletteForPlayer(p)
            else
                call CustomImageChat___HideEmojiPaletteButtons()
            endif
            call BlzFrameSetVisible(CustomImageChat___EmojiPanel, CustomImageChat___EmojiPanelOpen)
        endif
    elseif clicked == EmojiMuteButton then
        if GetLocalPlayer() == p then
            set CustomImageChat___PlayerEmojiEnabled[pid]=not CustomImageChat___PlayerEmojiEnabled[pid]

            if CustomImageChat___PlayerEmojiEnabled[pid] then
                // The button now offers the "block emojis" action.
                call BlzFrameSetTexture(CustomImageChat___EmojiMuteIcon, "Pick\\PickButton_Pick_Ban", 0, true)
            else
                // The button now offers the "enable emojis" action.
                call BlzFrameSetTexture(CustomImageChat___EmojiMuteIcon, "Pick\\PickButton_Pick_Manual", 0, true)
                set CustomImageChat___FeedCount=0
                call CustomImageChat___HideFeedFrames()
            endif
        endif
    else
        loop
            exitwhen i > ChatImageCommandCount

            if clicked == CustomImageChat___EmojiButton[i] then
                if IsObserverSlot(pid) then
                    set i=ChatImageCommandCount + 1
                else
                if GetLocalPlayer() == p then
                    // Frame clicks are local; sync converts the click into one
                    // deterministic post received by every player.
                    call BlzSendSyncData("NEMJ", I2S(i))
                    set CustomImageChat___EmojiPanelOpen=false
                    call BlzFrameSetVisible(CustomImageChat___EmojiPanel, false)
                    call CustomImageChat___HideEmojiPaletteButtons()
                endif

                set i=ChatImageCommandCount + 1
                endif
            else
                set i=i + 1
            endif
        endloop
    endif

    if GetLocalPlayer() == p then
        call BlzFrameSetEnable(clicked, false)
        call BlzFrameSetEnable(clicked, true)
    endif

    set clicked=null
    set p=null
endfunction

function CustomImageChat___OnTypedEmoji takes nothing returns nothing
    local string message= GetEventPlayerChatString()
    local integer i= 1

    loop
        exitwhen i > ChatImageCommandCount

        if message == ChatImageCommand[i] then
            // A native chat event is already synchronized, so no extra sync is needed.
            call CustomImageChat___AddEmojiPost(GetTriggerPlayer() , i)
            return
        endif

        set i=i + 1
    endloop
endfunction

// Compatibility API retained from the old CustomImageChat library.
function CustomChat_RegisterImage takes integer id,string path returns nothing
    if id > 0 and id <= CustomImageChat___EMOJI_MAX_TYPES then
        set CustomImageChat___EmojiPath[id]=path
    endif
endfunction

function CustomChat_RegisterCommand takes integer id,string command,string texture returns nothing
    if id > 0 and id <= CustomImageChat___EMOJI_MAX_TYPES then
        set ChatImageCommand[id]=command
        set CustomImageChat___EmojiPath[id]=texture

        if id > ChatImageCommandCount then
            set ChatImageCommandCount=id
        endif
    endif
endfunction

function CustomChat_SendImage takes player sender,integer imageId returns nothing
    call CustomImageChat___AddEmojiPost(sender , imageId)
endfunction

function ChatImageSend takes player sender,integer imageId returns nothing
    call CustomImageChat___AddEmojiPost((sender ) , ( imageId)) // INLINED!!
endfunction

function CustomImageChat___RegisterDefaultEmojis takes nothing returns nothing
    // Change command names and imported texture paths here.
    call CustomChat_RegisterCommand(1 , "kek" , "war3mapImported\\Emoji_KEKW.blp")
    call CustomChat_RegisterCommand(2 , "sadge" , "war3mapImported\\Emoji_Sadge.blp")
    call CustomChat_RegisterCommand(3 , "pog" , "war3mapImported\\Emoji_pog.blp")
    call CustomChat_RegisterCommand(4 , "balance" , "war3mapImported\\Emoji_balance.blp")
    call CustomChat_RegisterCommand(5 , "cringe" , "war3mapImported\\Emoji_cringe.blp")
    call CustomChat_RegisterCommand(6 , "cry" , "war3mapImported\\Emoji_cry.blp")
    call CustomChat_RegisterCommand(7 , "excited" , "war3mapImported\\Emoji_excited.blp")
    call CustomChat_RegisterCommand(8 , "gay" , "war3mapImported\\Emoji_gay.blp")
    call CustomChat_RegisterCommand(9 , "gun" , "war3mapImported\\Emoji_gun.blp")
    call CustomChat_RegisterCommand(10 , "heh" , "war3mapImported\\Emoji_heh.blp")
    call CustomChat_RegisterCommand(11 , "oreha" , "war3mapImported\\Emoji_oreha.blp")
    call CustomChat_RegisterCommand(12 , "poebat" , "war3mapImported\\Emoji_poebat.blp")
