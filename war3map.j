        function s__MilimSpells__MilimW2KS_MilimW2_Start takes unit NewC returns nothing
            local integer this= s__MilimSpells__MilimW2KS__allocate()
            set s__MilimSpells__MilimW2KS_MUI_MilimW2=s__MilimSpells__MilimW2KS_MUI_MilimW2 + 1
            set s__MilimSpells__MilimW2KS_m_MilimW2[s__MilimSpells__MilimW2KS_MUI_MilimW2]=this
            set s__MilimSpells__MilimW2KS_c[this]=NewC
            set s__MilimSpells__MilimW2KS_r[this]=0
            set s__MilimSpells__MilimW2KS_r2[this]=0
            set s__MilimSpells__MilimW2KS_r3[this]=0
            set s__MilimSpells__MilimW2KS_r4[this]=0
            set s__MilimSpells__MilimW2KS_r5[this]=0
            call PauseUnit(s__MilimSpells__MilimW2KS_c[this], true)
            set s__MilimSpells__MilimW2KS_a[this]=GetUnitFacing(s__MilimSpells__MilimW2KS_c[this]) * bj_DEGTORAD
            set s__MilimSpells__MilimW2KS_g[this]=CreateGroup()
            set s__MilimSpells__MilimW2KS_rmax[this]=1.5
                set s__MilimSpells__MilimW2KS_check[this]=0
                set s__MilimSpells__MilimW2KS_aoe[this]=MilimW2_DamageAoe
                set s__MilimSpells__MilimW2KS_dmg[this]=GetHeroInt(s__MilimSpells__MilimW2KS_c[this], true) * ( MilimW2_DamageAgiBase + ( MilimW2_DamageAgiStep * ( GetUnitAbilityLevel(s__MilimSpells__MilimW2KS_c[this], MilimW_ID) - 1 ) ) )
                if LoadInteger(hs, GetHandleId(s__MilimSpells__MilimW2KS_c[this]), StringHash("mode t")) == 1 then
                    set s__MilimSpells__MilimW2KS_dmg[this]=s__MilimSpells__MilimW2KS_dmg[this] + MilimT_DmgAdd * GetHeroAgi(s__MilimSpells__MilimW2KS_c[this], true)
                endif
                set s__MilimSpells__MilimW2KS_dmg[this]=s__MilimSpells__MilimW2KS_dmg[this] / 4
                call SetUnitTimeScale(s__MilimSpells__MilimW2KS_c[this], 0.85)
                call SetUnitAnimationByIndex(s__MilimSpells__MilimW2KS_c[this], 9)
                
                call MakeSound("war3mapimported\\Hero_Milim_W2 1")
                //call MakeSound("war3mapimported\\Hero_Barragan_R2")
                call StartSpellUnit2(s__MilimSpells__MilimW2KS_c[this])
                call SaveInteger(hs, GetHandleId(s__MilimSpells__MilimW2KS_c[this]), StringHash("invul"), 1)
            call VisionTimed(GetOwningPlayer(s__MilimSpells__MilimW2KS_c[this]) , GetUnitX(s__MilimSpells__MilimW2KS_c[this]) , GetUnitY(s__MilimSpells__MilimW2KS_c[this]) , 2000 , s__MilimSpells__MilimW2KS_rmax[this])
            if s__MilimSpells__MilimW2KS_MUI_MilimW2 == 0 then
                call TimerStart(s__MilimSpells__MilimW2KS_t_MilimW2, 0.05, true, function s__MilimSpells__MilimW2KS_Loop_MilimW2)
            endif
        endfunction



        function s__MilimSpells__MilimEKS_Loop_MilimE takes nothing returns nothing
