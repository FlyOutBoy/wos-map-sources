        call s__SpellData_setDecor(s__SpellData_createAlt(BambiettaW_ID , 1 , 5 , 2 , 2 , BambiettaTW_DamageAgiBase , BambiettaTW_DamageAgiStep , BambiettaW_Damage2StaticBase , BambiettaW_Damage2StaticStep , AAUniversalTooltips_T_RadExp(BambiettaTW_DamageAoe , BambiettaTW_DamageAoe2) + AAUniversalTooltips_T_CastAuto(BambiettaTW_CastTime , BambiettaTW_IsInvul) + AAUniversalTooltips_T_DurAuto(BambiettaTW_Duration , BambiettaTW_IsInvul) , AAUniversalTooltips_T_Bonus("Form" , "|cffFF0000Vollstandig Form|r")),(I2S(R2I(((BambiettaTW_DecorDamage)*1.0))))) // INLINED!!
