        function s__MilimSpells__MilimQKS_Loop_MilimQ takes nothing returns nothing
            local integer this
            local integer i= 0
            
            loop
                exitwhen i > s__MilimSpells__MilimQKS_MUI_MilimQ
                set this=s__MilimSpells__MilimQKS_m_MilimQ[i]
                if SpellBoolCaster(s__MilimSpells__MilimQKS_c[this]) and s__MilimSpells__MilimQKS_r[this] <= s__MilimSpells__MilimQKS_rmax[this] then
                    set s__MilimSpells__MilimQKS_r[this]=s__MilimSpells__MilimQKS_r[this] + 0.03
                        call DebugUnit2(s__MilimSpells__MilimQKS_c[this])
                        if s__MilimSpells__MilimQKS_check[this] == 0 then
                        if s__MilimSpells__MilimQKS_r[this] == 0.3 then
                        call SetUnitAnimationByIndex(s__MilimSpells__MilimQKS_c[this], 3)
                        
                call SetUnitTimeScale(s__MilimSpells__MilimQKS_c[this], 1.25)
                call DestroyEffect(EffectSpawn("war3mapImported\\wos_bdef (383).mdl" , GetUnitX(s__MilimSpells__MilimQKS_c[this]) , GetUnitY(s__MilimSpells__MilimQKS_c[this]) , s__MilimSpells__MilimQKS_a[this] * bj_RADTODEG , 1.25 , 1 , 1))
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_DustWindFaster3.mdl" , GetUnitX(s__MilimSpells__MilimQKS_c[this]) , GetUnitY(s__MilimSpells__MilimQKS_c[this]) , s__MilimSpells__MilimQKS_a[this] * bj_RADTODEG , 1.25 , 1 , 1))
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_cf1.mdl" , GetUnitX(s__MilimSpells__MilimQKS_c[this]) , GetUnitY(s__MilimSpells__MilimQKS_c[this]) , s__MilimSpells__MilimQKS_a[this] * bj_RADTODEG , 1.25 , 1 , 1))
                        endif
                        if s__MilimSpells__MilimQKS_r[this] == 0.54 then
                        call SetUnitTimeScale(s__MilimSpells__MilimQKS_c[this], 0)
                
                        endif
                        if s__MilimSpells__MilimQKS_r[this] > 0.3 then
                            if s__MilimSpells__MilimQKS_r5[this] <= s__MilimSpells__MilimQKS_r7[this] then //SR3(c, x, y) > 120 then
                                set s__MilimSpells__MilimQKS_r5[this]=s__MilimSpells__MilimQKS_r5[this] + s__MilimSpells__MilimQKS_move[this]
                                call MoveUnit(s__MilimSpells__MilimQKS_c[this] , s__MilimSpells__MilimQKS_move[this] , s__MilimSpells__MilimQKS_a[this])
                                call SetUnitFacing(s__MilimSpells__MilimQKS_c[this], s__MilimSpells__MilimQKS_a[this] * bj_RADTODEG)
                                call GroupClear(s__MilimSpells__MilimQKS_g[this])
                                call DecorRemove(s__MilimSpells__MilimQKS_c[this] , GetUnitX(s__MilimSpells__MilimQKS_c[this]) , GetUnitY(s__MilimSpells__MilimQKS_c[this]) , s__MilimSpells__MilimQKS_aoe[this] , 20)
                                
                                    call GroupEnumUnitsInRange(s__MilimSpells__MilimQKS_g[this], GetUnitX(s__MilimSpells__MilimQKS_c[this]), GetUnitY(s__MilimSpells__MilimQKS_c[this]), s__MilimSpells__MilimQKS_aoe[this] + 25, NoDecor_Cond)
                                    loop
                                        set s__MilimSpells__MilimQKS_u[this]=FirstOfGroup(s__MilimSpells__MilimQKS_g[this])
                                        exitwhen s__MilimSpells__MilimQKS_u[this] == null or s__MilimSpells__MilimQKS_check[this] == 1
                                        if SpellBool(s__MilimSpells__MilimQKS_u[this]) and IsUnitEnemy(s__MilimSpells__MilimQKS_u[this], GetOwningPlayer(s__MilimSpells__MilimQKS_c[this])) then
                                            set s__MilimSpells__MilimQKS_check[this]=1
                                            call s__GearSystems2__KS_RemoveEffect_MyRemoveEff_Start((AddSpecialEffectTarget("war3mapimported\\wos_ChuShou_BY_Wood_Effect_Glow_GuiPaiQiGong_XuLiblue.mdx", s__MilimSpells__MilimQKS_c[this], "hand right") ) , (( 0.18)*1.0) , 0 , - 1 , - 1 , "") // INLINED!!
                                            call SetUnitTimeScale(s__MilimSpells__MilimQKS_c[this], 1.5)
                                            set s__MilimSpells__MilimQKS_td[this]=s__MilimSpells__MilimQKS_u[this]
                                            set s__MilimSpells__MilimQKS_r[this]=0
                                            call SetUnitPosition(s__MilimSpells__MilimQKS_td[this], GetUnitX(s__MilimSpells__MilimQKS_c[this]) + 110 * Cos(s__MilimSpells__MilimQKS_a[this]), GetUnitY(s__MilimSpells__MilimQKS_c[this]) + 110 * Sin(s__MilimSpells__MilimQKS_a[this]))
                                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_HakkeStart.mdx" , GetUnitX(s__MilimSpells__MilimQKS_c[this]) + 110 * Cos(s__MilimSpells__MilimQKS_a[this]) , GetUnitY(s__MilimSpells__MilimQKS_c[this]) + 110 * Sin(s__MilimSpells__MilimQKS_a[this]) , 0 , 1.75 , 0.75 , 5))
                                        endif
                                        call GroupRemoveUnit(s__MilimSpells__MilimQKS_g[this], s__MilimSpells__MilimQKS_u[this])
                                    endloop
                                    set s__MilimSpells__MilimQKS_u[this]=null
                            
                                set s__MilimSpells__MilimQKS_r6[this]=90
                                if s__MilimSpells__MilimQKS_r2[this] > 0.03 then
                                    set s__MilimSpells__MilimQKS_r2[this]=0
                                else
                                    set s__MilimSpells__MilimQKS_r2[this]=s__MilimSpells__MilimQKS_r2[this] + 0.03
                                endif
                            else
                                set s__MilimSpells__MilimQKS_r[this]=9999
                            endif
                        endif
                    elseif s__MilimSpells__MilimQKS_check[this] == 1 then
                        call SetUnitFacing(s__MilimSpells__MilimQKS_c[this], s__MilimSpells__MilimQKS_a[this] * bj_RADTODEG)
                        if s__MilimSpells__MilimQKS_r[this] == 0.03 then
                call MakeSound("war3mapimported\\Hero_Milim_Q 2")
                        endif
                        if s__MilimSpells__MilimQKS_r[this] == 0.3 then
                            set s__MilimSpells__MilimQKS_x[this]=GetUnitX(s__MilimSpells__MilimQKS_td[this])
                            set s__MilimSpells__MilimQKS_y[this]=GetUnitY(s__MilimSpells__MilimQKS_td[this])
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_az_hitheavy.mdl" , s__MilimSpells__MilimQKS_x[this] , s__MilimSpells__MilimQKS_y[this] , s__MilimSpells__MilimQKS_a[this] * bj_RADTODEG , 0.5 , 4.25 , 125))
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_BDEF (124)2.mdx" , s__MilimSpells__MilimQKS_x[this] , s__MilimSpells__MilimQKS_y[this] , GetRandomReal(0, 359) , 1 , 2.5 , 125))
                            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", s__MilimSpells__MilimQKS_td[this], "chest"))
                            call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_tx-ha_nitu.mdl" , GetUnitX(s__MilimSpells__MilimQKS_c[this]) , GetUnitY(s__MilimSpells__MilimQKS_c[this]) , s__MilimSpells__MilimQKS_a[this] * bj_RADTODEG , 2 , 2.45 , 2 , 255 , 255 , 255 , 255))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_senji-wind-impact-2.mdx" , s__MilimSpells__MilimQKS_x[this] + 190 * Cos(s__MilimSpells__MilimQKS_a[this]) , s__MilimSpells__MilimQKS_y[this] + 190 * Sin(s__MilimSpells__MilimQKS_a[this]) , s__MilimSpells__MilimQKS_a[this] * bj_RADTODEG , 2 , 1.15 , 85))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_senji-wind-impact-2.mdx" , s__MilimSpells__MilimQKS_x[this] + 290 * Cos(s__MilimSpells__MilimQKS_a[this]) , s__MilimSpells__MilimQKS_y[this] + 290 * Sin(s__MilimSpells__MilimQKS_a[this]) , s__MilimSpells__MilimQKS_a[this] * bj_RADTODEG , 1.9 , 1.35 , 85))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_senji-wind-impact-2.mdx" , s__MilimSpells__MilimQKS_x[this] + 390 * Cos(s__MilimSpells__MilimQKS_a[this]) , s__MilimSpells__MilimQKS_y[this] + 390 * Sin(s__MilimSpells__MilimQKS_a[this]) , s__MilimSpells__MilimQKS_a[this] * bj_RADTODEG , 1.8 , 1.55 , 85))
                        call EffectSpawn2("war3mapimported\\wos_LD2209 (157).mdx" , s__MilimSpells__MilimQKS_x[this] , s__MilimSpells__MilimQKS_y[this] , GetRandomReal(0, 359) , 1 , 0.8 , 0 , 1)
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_bloodex-special-23.mdl" , GetUnitX(s__MilimSpells__MilimQKS_td[this]) , GetUnitY(s__MilimSpells__MilimQKS_td[this]) , GetRandomReal(0, 359) , 2.5 , 2 , 80))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_az_hitheavy.mdl" , s__MilimSpells__MilimQKS_x[this] + 25 * Cos(s__MilimSpells__MilimQKS_a[this]) , s__MilimSpells__MilimQKS_y[this] + 25 * Sin(s__MilimSpells__MilimQKS_a[this]) , s__MilimSpells__MilimQKS_a[this] * bj_RADTODEG , 1 , 2.25 , 125))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_cf2.mdx" , s__MilimSpells__MilimQKS_x[this] + 125 * Cos(s__MilimSpells__MilimQKS_a[this]) , s__MilimSpells__MilimQKS_y[this] + 125 * Sin(s__MilimSpells__MilimQKS_a[this]) , s__MilimSpells__MilimQKS_a[this] * bj_RADTODEG , 0.6 , 1.45 , 15))
                          call DecorRemove(s__MilimSpells__MilimQKS_c[this] , s__MilimSpells__MilimQKS_x[this] , s__MilimSpells__MilimQKS_y[this] , MilimQ_DamageAoe2 , 25)
                                set s__MilimSpells__MilimQKS_r[this]=99999
                                call GroupEnumUnitsInRange(s__MilimSpells__MilimQKS_g[this], s__MilimSpells__MilimQKS_x[this], s__MilimSpells__MilimQKS_y[this], MilimQ_DamageAoe2, NoDecor_Cond)
                        loop
                            set s__MilimSpells__MilimQKS_u[this]=FirstOfGroup(s__MilimSpells__MilimQKS_g[this])
                            exitwhen s__MilimSpells__MilimQKS_u[this] == null
                            if SpellBool(s__MilimSpells__MilimQKS_u[this]) and IsUnitEnemy(s__MilimSpells__MilimQKS_u[this], GetOwningPlayer(s__MilimSpells__MilimQKS_c[this])) then
                                call dmgphys(s__MilimSpells__MilimQKS_c[this] , s__MilimSpells__MilimQKS_u[this] , s__MilimSpells__MilimQKS_dmg[this])
                                call MUE(s__MilimSpells__MilimQKS_u[this] , MilimQ_PushRange , MilimQ_PushDuration , s__MilimSpells__MilimQKS_a[this])
                            endif
                            call GroupRemoveUnit(s__MilimSpells__MilimQKS_g[this], s__MilimSpells__MilimQKS_u[this])
                        endloop
                           endif
                           endif
                else
                    
                        call StopSpellUnit2(s__MilimSpells__MilimQKS_c[this])
                    call SetUnitTimeScale(s__MilimSpells__MilimQKS_c[this], 1)
                    call DestroyEffect(s__MilimSpells__MilimQKS_e[this])
                    call DestroyEffect(s__MilimSpells__MilimQKS_e2[this])
                    call DestroyEffect(s__MilimSpells__MilimQKS_e3[this])
                    call DestroyGroup(s__MilimSpells__MilimQKS_g[this])
                    call DestroyGroup(s__MilimSpells__MilimQKS_g2[this])
                    set s__MilimSpells__MilimQKS_g[this]=null
                    set s__MilimSpells__MilimQKS_g2[this]=null
                    set s__MilimSpells__MilimQKS_c[this]=null
                    set s__MilimSpells__MilimQKS_e[this]=null
                    set s__MilimSpells__MilimQKS_e2[this]=null
                    set s__MilimSpells__MilimQKS_e3[this]=null
                    set s__MilimSpells__MilimQKS_u[this]=null
                    set s__MilimSpells__MilimQKS_m_MilimQ[i]=s__MilimSpells__MilimQKS_m_MilimQ[s__MilimSpells__MilimQKS_MUI_MilimQ]
                    set s__MilimSpells__MilimQKS_MUI_MilimQ=s__MilimSpells__MilimQKS_MUI_MilimQ - 1
                    if s__MilimSpells__MilimQKS_MUI_MilimQ == - 1 then
                        call PauseTimer(s__MilimSpells__MilimQKS_t_MilimQ)
                    endif
                    call s__MilimSpells__MilimQKS_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction
        function s__MilimSpells__MilimQKS_MilimQ_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__MilimSpells__MilimQKS__allocate()
            set s__MilimSpells__MilimQKS_MUI_MilimQ=s__MilimSpells__MilimQKS_MUI_MilimQ + 1
            set s__MilimSpells__MilimQKS_m_MilimQ[s__MilimSpells__MilimQKS_MUI_MilimQ]=this
            set s__MilimSpells__MilimQKS_c[this]=NewC
            set s__MilimSpells__MilimQKS_td[this]=null
            set s__MilimSpells__MilimQKS_x[this]=NewX
            set s__MilimSpells__MilimQKS_y[this]=NewY
            set s__MilimSpells__MilimQKS_r[this]=0
            set s__MilimSpells__MilimQKS_r2[this]=0
            set s__MilimSpells__MilimQKS_r5[this]=0
            set s__MilimSpells__MilimQKS_k3[this]=0
            set s__MilimSpells__MilimQKS_r7[this]=MilimQ_Range
            set s__MilimSpells__MilimQKS_check[this]=0
            set s__MilimSpells__MilimQKS_move[this]=120
            set s__MilimSpells__MilimQKS_check2[this]=0
            call StartSpellUnit2(s__MilimSpells__MilimQKS_c[this])
            set s__MilimSpells__MilimQKS_g[this]=CreateGroup()
            set s__MilimSpells__MilimQKS_g2[this]=CreateGroup()
            set s__MilimSpells__MilimQKS_u[this]=null
            set s__MilimSpells__MilimQKS_a[this]=GAngle2(s__MilimSpells__MilimQKS_c[this] , s__MilimSpells__MilimQKS_x[this] , s__MilimSpells__MilimQKS_y[this]) // Angle Between points
            set s__MilimSpells__MilimQKS_aoe[this]=MilimQ_DamageAoe
            set s__MilimSpells__MilimQKS_dmg[this]=GetHeroAgi(s__MilimSpells__MilimQKS_c[this], true) * ( MilimQ_DamageAgiBase + ( MilimQ_DamageAgiStep * ( GetUnitAbilityLevel(s__MilimSpells__MilimQKS_c[this], MilimQ_ID) - 1 ) ) )
            set s__MilimSpells__MilimQKS_dmg[this]=s__MilimSpells__MilimQKS_dmg[this] + MilimQ_Damage2StaticBase + ( MilimQ_Damage2StaticStep * ( GetUnitAbilityLevel(s__MilimSpells__MilimQKS_c[this], MilimQ_ID) - 1 ) )
            if LoadInteger(hs, GetHandleId(s__MilimSpells__MilimQKS_c[this]), StringHash("mode t")) == 1 then
                set s__MilimSpells__MilimQKS_dmg[this]=s__MilimSpells__MilimQKS_dmg[this] + MilimT_DmgAdd * GetHeroAgi(s__MilimSpells__MilimQKS_c[this], true)
            endif
            set s__MilimSpells__MilimQKS_rmax[this]=2.1
            set s__MilimSpells__MilimQKS_e[this]=AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdx", s__MilimSpells__MilimQKS_c[this], "hand right")
            set s__MilimSpells__MilimQKS_e2[this]=AddSpecialEffectTarget("war3mapImported\\wos_file00001662.mdl", s__MilimSpells__MilimQKS_c[this], "hand right")
            set s__MilimSpells__MilimQKS_e3[this]=AddSpecialEffectTarget("war3mapimported\\wos_SlidingDustWithRocks.mdx", s__MilimSpells__MilimQKS_c[this], "origin")
                call SetUnitAnimationByIndex(s__MilimSpells__MilimQKS_c[this], 7)
                call SetUnitTimeScale(s__MilimSpells__MilimQKS_c[this], 1.5)
                call MakeSound("war3mapimported\\Hero_Milim_Q 1")
            if s__MilimSpells__MilimQKS_MUI_MilimQ == 0 then
                call TimerStart(s__MilimSpells__MilimQKS_t_MilimQ, 0.03, true, function s__MilimSpells__MilimQKS_Loop_MilimQ)
            endif
        endfunction
   



    // h — ìàêñèìàëüíàÿ âûñîòà, d — äëèòåëüíîñòü, x — ïðîøåäøåå âðåìÿ.
    function s__MilimSpells__MilimWKS_Parabola takes real h,real d,real x returns real
        return ( 4.00 * h / d ) * ( d - x ) * ( x / d )
    endfunction

    function s__MilimSpells__MilimWKS_Loop_MilimW takes nothing returns nothing
        local integer this
        local integer i= 0
        local real currentX
        local real currentY

        loop
            exitwhen i > s__MilimSpells__MilimWKS_MUI_MilimW
            set this=s__MilimSpells__MilimWKS_m_MilimW[i]

            if SpellBoolCaster(s__MilimSpells__MilimWKS_c[this]) and s__MilimSpells__MilimWKS_r[this] < s__MilimSpells__MilimWKS_JUMP_DURATION then
                call DebugUnit2(s__MilimSpells__MilimWKS_c[this])
               // call BlzSetSpecialEffectYaw(e, a-180*bj_DEGTORAD)

                if s__MilimSpells__MilimWKS_delayElapsed[this] < s__MilimSpells__MilimWKS_JUMP_DELAY then
                    set s__MilimSpells__MilimWKS_delayElapsed[this]=s__MilimSpells__MilimWKS_delayElapsed[this] + s__MilimSpells__MilimWKS_TIMER_PERIOD
                    if s__MilimSpells__MilimWKS_delayElapsed[this] > s__MilimSpells__MilimWKS_JUMP_DELAY then
                        set s__MilimSpells__MilimWKS_delayElapsed[this]=s__MilimSpells__MilimWKS_JUMP_DELAY
                    endif
                    if s__MilimSpells__MilimWKS_delayElapsed[this] == 0.03 then
                    
        set s__MilimSpells__MilimWKS_e[this]=EffectSpawn("war3mapImported\\wos_tx-liuying03_pink3.mdl" , GetUnitX(s__MilimSpells__MilimWKS_c[this]) , GetUnitY(s__MilimSpells__MilimWKS_c[this]) , s__MilimSpells__MilimWKS_a[this] * bj_RADTODEG , 2.7 , 0.4 , 150 + s__MilimSpells__MilimWKS_EFFECT_Z_OFFSET)
        call BlzSetSpecialEffectPitch(s__MilimSpells__MilimWKS_e[this], - 180.00 * bj_DEGTORAD)
        call BlzSetSpecialEffectYaw(s__MilimSpells__MilimWKS_e[this], s__MilimSpells__MilimWKS_a[this])
      //  set delayElapsed = 999
                    endif
                    // Äî íà÷àëà ïðûæêà ýôôåêò îñòà¸òñÿ íà êàñòåðå.
                    //call BlzSetSpecialEffectPitch(e, -180.00 * bj_DEGTORAD)
                else
                    set s__MilimSpells__MilimWKS_r[this]=s__MilimSpells__MilimWKS_r[this] + s__MilimSpells__MilimWKS_TIMER_PERIOD
                    if s__MilimSpells__MilimWKS_r[this] > s__MilimSpells__MilimWKS_JUMP_DURATION then
                        set s__MilimSpells__MilimWKS_r[this]=s__MilimSpells__MilimWKS_JUMP_DURATION
                    endif

                    set s__MilimSpells__MilimWKS_progress[this]=s__MilimSpells__MilimWKS_r[this] / s__MilimSpells__MilimWKS_JUMP_DURATION
                    set currentX=s__MilimSpells__MilimWKS_startX[this] + ( s__MilimSpells__MilimWKS_x[this] - s__MilimSpells__MilimWKS_startX[this] ) * s__MilimSpells__MilimWKS_progress[this]
                    set currentY=s__MilimSpells__MilimWKS_startY[this] + ( s__MilimSpells__MilimWKS_y[this] - s__MilimSpells__MilimWKS_startY[this] ) * s__MilimSpells__MilimWKS_progress[this]
                    set s__MilimSpells__MilimWKS_f[this]=s__MilimSpells__MilimWKS_Parabola(s__MilimSpells__MilimWKS_JUMP_HEIGHT , s__MilimSpells__MilimWKS_JUMP_DURATION , s__MilimSpells__MilimWKS_r[this])

                    call PosUnit(s__MilimSpells__MilimWKS_c[this] , currentX , currentY)
                    call SetFly(s__MilimSpells__MilimWKS_c[this] , s__MilimSpells__MilimWKS_f[this])
                    if s__MilimSpells__MilimWKS_r[this] == s__MilimSpells__MilimWKS_JUMP_DURATION / 2 then
                    call DestroyEffect(s__MilimSpells__MilimWKS_e[this])
                    set s__MilimSpells__MilimWKS_e[this]=null
        set s__MilimSpells__MilimWKS_e[this]=EffectSpawn("war3mapImported\\wos_tx-liuying03_pink3.mdl" , GetUnitX(s__MilimSpells__MilimWKS_c[this]) , GetUnitY(s__MilimSpells__MilimWKS_c[this]) , s__MilimSpells__MilimWKS_a[this] * bj_RADTODEG , 1.5 , 0.5 , s__MilimSpells__MilimWKS_f[this] + s__MilimSpells__MilimWKS_EFFECT_Z_OFFSET)
                    endif
                    // Ïëàâíûé pitch îò -180 ãðàäóñîâ äî 0.
                    set s__MilimSpells__MilimWKS_effectProgress[this]=s__MilimSpells__MilimWKS_progress[this] //* progress * (3.00 - 2.00 * progress)
                // call BlzSetSpecialEffectPitch(e, (-180.00 * (1.00 - effectProgress)) * bj_DEGTORAD)

                    // Íà ïîäú¸ìå ýôôåêò íàõîäèòñÿ íàä êàñòåðîì, íà ñïóñêå — ïîä íèì.
                    if s__MilimSpells__MilimWKS_progress[this] <= 0.50 then
                     //   call BlzSetSpecialEffectPitch(e, (-180.00) * bj_DEGTORAD)
                       // call BJDebugMsg("1")
                        call BlzSetSpecialEffectPosition(s__MilimSpells__MilimWKS_e[this], GetUnitX(s__MilimSpells__MilimWKS_c[this]), GetUnitY(s__MilimSpells__MilimWKS_c[this]), s__MilimSpells__MilimWKS_f[this] + s__MilimSpells__MilimWKS_EFFECT_Z_OFFSET)
                    else
                       // call BJDebugMsg("2")
                        call BlzSetSpecialEffectPosition(s__MilimSpells__MilimWKS_e[this], GetUnitX(s__MilimSpells__MilimWKS_c[this]), GetUnitY(s__MilimSpells__MilimWKS_c[this]), s__MilimSpells__MilimWKS_f[this] - s__MilimSpells__MilimWKS_EFFECT_Z_OFFSET)
                    endif

                    if s__MilimSpells__MilimWKS_r[this] >= s__MilimSpells__MilimWKS_JUMP_DURATION then
                        // Ãàðàíòèðóåì òî÷íîå ïðèçåìëåíèå â òî÷êó íàæàòèÿ.
                        set s__MilimSpells__MilimWKS_x[this]=GetUnitX(s__MilimSpells__MilimWKS_c[this])
                        set s__MilimSpells__MilimWKS_y[this]=GetUnitY(s__MilimSpells__MilimWKS_c[this])
                        call PosUnit(s__MilimSpells__MilimWKS_c[this] , s__MilimSpells__MilimWKS_x[this] , s__MilimSpells__MilimWKS_y[this])
                        call SetFly(s__MilimSpells__MilimWKS_c[this] , 0.00)
                     //   call BlzSetSpecialEffectPitch(e, 0.00)
                       // call BlzSetSpecialEffectYaw(e, a)
                        call BlzSetSpecialEffectPosition(s__MilimSpells__MilimWKS_e[this], s__MilimSpells__MilimWKS_x[this], s__MilimSpells__MilimWKS_y[this], 0)
                        
                        call ScaleEffDummy(s__MilimSpells__MilimWKS_e[this] , 0.21 , 0.5 , 1.1)
                        call MakeSound("war3mapimported\\Hero_Milim_W 2")
                        call GroupClear(s__MilimSpells__MilimWKS_g[this])
                        call DecorRemove(s__MilimSpells__MilimWKS_c[this] , s__MilimSpells__MilimWKS_x[this] , s__MilimSpells__MilimWKS_y[this] , s__MilimSpells__MilimWKS_aoe[this] , 40)
                        call MakeSound("war3mapimported\\Hero_Barragan_W2")
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_ZarakiWCrack1.mdx" , s__MilimSpells__MilimWKS_x[this] , s__MilimSpells__MilimWKS_y[this] , GetRandomReal(0, 359) , 1 , 2 , 0))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_ZarakiWCrack2.mdx" , s__MilimSpells__MilimWKS_x[this] , s__MilimSpells__MilimWKS_y[this] , GetRandomReal(0, 359) , 1 , 2 , 0))

                        set s__MilimSpells__MilimWKS_k[this]=0
                        loop
                            exitwhen s__MilimSpells__MilimWKS_k[this] > 4
                            call DestroyEffect(EffectSpawn("war3mapimported\\wos_LD2209 (157).mdx" , s__MilimSpells__MilimWKS_x[this] , s__MilimSpells__MilimWKS_y[this] , GetRandomReal(0, 359) , 1 - s__MilimSpells__MilimWKS_k[this] * 0.2 , 1 + s__MilimSpells__MilimWKS_k[this] * 0.5 , 0))
                            call EffectSpawn2("war3mapimported\\wos_kamni.mdx" , s__MilimSpells__MilimWKS_x[this] , s__MilimSpells__MilimWKS_y[this] , GetRandomReal(0, 359) , 1.25 - s__MilimSpells__MilimWKS_k[this] * 0.1 , 0.8 + s__MilimSpells__MilimWKS_k[this] * 0.45 , 0 , 0.25)
                            call DestroyEffect(EffectSpawn("war3mapimported\\wos_T_dustgaraa2.mdx" , s__MilimSpells__MilimWKS_x[this] , s__MilimSpells__MilimWKS_y[this] , GetRandomReal(0, 359) , 1.0 - s__MilimSpells__MilimWKS_k[this] * 0.1 , 1.9 + s__MilimSpells__MilimWKS_k[this] * 0.42 , 0))
                            set s__MilimSpells__MilimWKS_k[this]=s__MilimSpells__MilimWKS_k[this] + 1
                        endloop
                        set s__MilimSpells__MilimWKS_k[this]=0
                        loop
                        exitwhen s__MilimSpells__MilimWKS_k[this] == 6
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_bdef (383).mdl" , GetUnitX(s__MilimSpells__MilimWKS_c[this]) , GetUnitY(s__MilimSpells__MilimWKS_c[this]) , GetRandomReal(0, 359) , 1.1 , 0.3 * s__MilimSpells__MilimWKS_k[this] + 0.85 , 15))
                            call DestroyEffect(EffectSpawn("war3mapImported\\wos_DustWindFaster3.mdl" , GetUnitX(s__MilimSpells__MilimWKS_c[this]) + 215 * Cos(s__MilimSpells__MilimWKS_k[this] * 60 * bj_DEGTORAD) , GetUnitY(s__MilimSpells__MilimWKS_c[this]) + 215 * Sin(s__MilimSpells__MilimWKS_k[this] * 60 * bj_DEGTORAD) , s__MilimSpells__MilimWKS_k[this] * 60 + 180 , 2 , 1.354 , 155))
                            set s__MilimSpells__MilimWKS_k[this]=s__MilimSpells__MilimWKS_k[this] + 1
                        endloop
                        call GroupEnumUnitsInRange(s__MilimSpells__MilimWKS_g[this], s__MilimSpells__MilimWKS_x[this], s__MilimSpells__MilimWKS_y[this], s__MilimSpells__MilimWKS_aoe[this] + 25, NoDecor_Cond)
                        loop
                            set s__MilimSpells__MilimWKS_u[this]=FirstOfGroup(s__MilimSpells__MilimWKS_g[this])
                            exitwhen s__MilimSpells__MilimWKS_u[this] == null
                            if SpellBool(s__MilimSpells__MilimWKS_u[this]) and IsUnitEnemy(s__MilimSpells__MilimWKS_u[this], GetOwningPlayer(s__MilimSpells__MilimWKS_c[this])) then
                                call dmgphys(s__MilimSpells__MilimWKS_c[this] , s__MilimSpells__MilimWKS_u[this] , s__MilimSpells__MilimWKS_dmg[this])
                                call MUE(s__MilimSpells__MilimWKS_u[this] , MilimW_PushRange , MilimW_PushTime , GAngle(s__MilimSpells__MilimWKS_c[this] , s__MilimSpells__MilimWKS_u[this]))
                            endif
                            call GroupRemoveUnit(s__MilimSpells__MilimWKS_g[this], s__MilimSpells__MilimWKS_u[this])
                        endloop
                        if GetUnitAbilityLevel(s__MilimSpells__MilimWKS_c[this], MilimW_ID) >= 5 then
                        call s__GearSystems2__KS_SpellTimer_SpellTimer_Timer_Start((s__MilimSpells__MilimWKS_c[this] ) , (( MilimW_TimetoSwapAbi )*1.0) , ( MilimW2_ID ) , ( MilimW_ID) , 0) // INLINED!!
                        call s__GearSystems2__KS_BuffTimer_MyBuffTime_Start((s__MilimSpells__MilimWKS_c[this] ) , 0 , (( MilimW_TimetoSwapAbi )*1.0) , ( "BTNHero_Milim_W2" ) , ( false ) , - 1 , 1 , 0 , ( 0)) // INLINED!!
                        
                        endif
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_NewDirtEXNofireNoDust.mdl" , s__MilimSpells__MilimWKS_x[this] , s__MilimSpells__MilimWKS_y[this] , GetRandomReal(0, 359) , 1 , 3.25 , 0))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_NewDirtEXNofireNoDust.mdl" , s__MilimSpells__MilimWKS_x[this] , s__MilimSpells__MilimWKS_y[this] , GetRandomReal(0, 359) , 0.75 , 3.25 , 0))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_NewDirtEXNofireNoDust.mdl" , s__MilimSpells__MilimWKS_x[this] , s__MilimSpells__MilimWKS_y[this] , GetRandomReal(0, 359) , 0.5 , 3.25 , 0))
                        set s__MilimSpells__MilimWKS_u[this]=null
                    endif
                endif
            else
                // Òàêæå âîçâðàùàåì ãåðîÿ íà çåìëþ, åñëè çàêëèíàíèå áûëî ïðåðâàíî.
                call SetFly(s__MilimSpells__MilimWKS_c[this] , 0.00)
                call DestroyEffect(s__MilimSpells__MilimWKS_e[this])
                call DestroyEffect(s__MilimSpells__MilimWKS_e2[this])
                call StopSpellUnit2(s__MilimSpells__MilimWKS_c[this])
                call DestroyGroup(s__MilimSpells__MilimWKS_g[this])
                set s__MilimSpells__MilimWKS_e[this]=null
                set s__MilimSpells__MilimWKS_e2[this]=null
                set s__MilimSpells__MilimWKS_c[this]=null
                set s__MilimSpells__MilimWKS_g[this]=null
                set s__MilimSpells__MilimWKS_u[this]=null

                set s__MilimSpells__MilimWKS_m_MilimW[i]=s__MilimSpells__MilimWKS_m_MilimW[s__MilimSpells__MilimWKS_MUI_MilimW]
                set s__MilimSpells__MilimWKS_MUI_MilimW=s__MilimSpells__MilimWKS_MUI_MilimW - 1
                if s__MilimSpells__MilimWKS_MUI_MilimW == - 1 then
                    call PauseTimer(s__MilimSpells__MilimWKS_t_MilimW)
                endif
                call s__MilimSpells__MilimWKS_deallocate(this)

                // Íà ýòó ïîçèöèþ ïîñòàâëåí ïîñëåäíèé àêòèâíûé ýëåìåíò ìàññèâà.
                set i=i - 1
            endif

            set i=i + 1
        endloop

        set currentX=0.00
        set currentY=0.00
    endfunction

    function s__MilimSpells__MilimWKS_MilimW_Start takes unit NewC,real NewX,real NewY returns nothing
        local integer this= s__MilimSpells__MilimWKS__allocate()

        set s__MilimSpells__MilimWKS_MUI_MilimW=s__MilimSpells__MilimWKS_MUI_MilimW + 1
        set s__MilimSpells__MilimWKS_m_MilimW[s__MilimSpells__MilimWKS_MUI_MilimW]=this
        set s__MilimSpells__MilimWKS_c[this]=NewC
        set s__MilimSpells__MilimWKS_x[this]=NewX
        set s__MilimSpells__MilimWKS_y[this]=NewY
        set s__MilimSpells__MilimWKS_startX[this]=GetUnitX(s__MilimSpells__MilimWKS_c[this])
        set s__MilimSpells__MilimWKS_startY[this]=GetUnitY(s__MilimSpells__MilimWKS_c[this])
        set s__MilimSpells__MilimWKS_delayElapsed[this]=0.00
        set s__MilimSpells__MilimWKS_r[this]=0.00
        set s__MilimSpells__MilimWKS_f[this]=0.00
        set s__MilimSpells__MilimWKS_progress[this]=0.00
        set s__MilimSpells__MilimWKS_effectProgress[this]=0.00

        call SaveInteger(hs, GetHandleId(GetOwningPlayer(s__MilimSpells__MilimWKS_c[this])), StringHash(I2S(MilimW_ID)), 0)
        set s__MilimSpells__MilimWKS_aoe[this]=MilimW_DamageAoe
        set s__MilimSpells__MilimWKS_dmg[this]=GetHeroAgi(s__MilimSpells__MilimWKS_c[this], true) * ( MilimW2_DamageAgiBase + ( MilimW2_DamageAgiStep * ( GetUnitAbilityLevel(s__MilimSpells__MilimWKS_c[this], MilimW_ID) - 1 ) ) )
        set s__MilimSpells__MilimWKS_dmg[this]=s__MilimSpells__MilimWKS_dmg[this] + MilimW2_Damage2StaticBase + ( MilimW2_Damage2StaticStep * ( GetUnitAbilityLevel(s__MilimSpells__MilimWKS_c[this], MilimW_ID) - 1 ) )
        if LoadInteger(hs, GetHandleId(s__MilimSpells__MilimWKS_c[this]), StringHash("mode t")) == 1 then
           set s__MilimSpells__MilimWKS_dmg[this]=s__MilimSpells__MilimWKS_dmg[this] + MilimT_DmgAdd * GetHeroAgi(s__MilimSpells__MilimWKS_c[this], true)
        endif
        call StartSpellUnit2(s__MilimSpells__MilimWKS_c[this])
        set s__MilimSpells__MilimWKS_g[this]=CreateGroup()
        // Ôèêñèðóåì óãîë ñïîñîáíîñòè îò êàñòåðà ê òî÷êå íàæàòèÿ.
        set s__MilimSpells__MilimWKS_a[this]=Atan2(s__MilimSpells__MilimWKS_y[this] - s__MilimSpells__MilimWKS_startY[this], s__MilimSpells__MilimWKS_x[this] - s__MilimSpells__MilimWKS_startX[this])
        call SetUnitTimeScale(s__MilimSpells__MilimWKS_c[this], 0.5)
