    function NatsuG2_Start takes unit c returns nothing
        local real x= GetUnitX(c)
        local real y= GetUnitY(c)
        if LoadInteger(hs, GetHandleId(c), StringHash("mode g")) == 0 then
        call ReduceCooldown(c , NatsuG_ID , 99)
        call MakeSound("war3mapimported\\Hero_Natsu_G3")
        call MakeSound("war3mapimported\\Hero_Natsu_GG")
        call s__NatsuSpells__NatsuG2_KS_NatsuG2_Start(c)
        call DisplayTimedTextToPlayer(GetOwningPlayer(c), 0, 0, 1, "|c00FFFC01Modo Raienryuu|r")
        call s__GearSystems2__KS_MoveEffectToUnit_MoveEffectToUnit_Start((EffectSpawn("war3mapImported\\wos_firefly-rq-sfx2.mdl" , x , y , 1 , 1 , 1.5 , 100) ) , (( 1.5 )*1.0) , (( 100 )*1.0) , ( c) , 0 , 1 , null) // INLINED!!
        call s__GearSystems2__KS_MoveEffectToUnit_MoveEffectToUnit_Start((EffectSpawn("war3mapImported\\wos_5731-sl_8bc718f-F.mdl" , x , y , 1 , 1 , 1.15 , 1) ) , (( 1.5 )*1.0) , (( 1 )*1.0) , ( c) , 0 , 1 , null) // INLINED!!
        call s__GearSystems2__KS_MoveEffectToUnit_MoveEffectToUnit_Start((EffectSpawn("war3mapImported\\wos_firefly-rw-sfx4_01.mdl" , x , y , 0 , 2.25 , 1.5 , 1) ) , (( 1.5 )*1.0) , (( 1 )*1.0) , ( c) , 0 , 1 , null) // INLINED!!
    else
    call IssueImmediateOrder(c, "stop")
    endif
    endfunction

