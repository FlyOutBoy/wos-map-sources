        call AllyHeroAbilityUI___AHUI_AddHeroAbility(whichHero , AllyHeroAbilityUI___AHUI_SLOT_W , AinzW2_ID)
        call AllyHeroAbilityUI___AHUI_AddHeroAbility(whichHero , AllyHeroAbilityUI___AHUI_SLOT_W , AinzW3_ID)
        call AllyHeroAbilityUI___AHUI_AddHeroAbility(whichHero , AllyHeroAbilityUI___AHUI_SLOT_W , AinzW4_ID)
        call AllyHeroAbilityUI___AHUI_AddHeroAbility(whichHero , AllyHeroAbilityUI___AHUI_SLOT_E , AinzE_ID)
        call AllyHeroAbilityUI___AHUI_AddHeroAbility(whichHero , AllyHeroAbilityUI___AHUI_SLOT_E , AinzE2_ID)
        call AllyHeroAbilityUI___AHUI_AddHeroAbility(whichHero , AllyHeroAbilityUI___AHUI_SLOT_E , AinzE3_ID)
        call AllyHeroAbilityUI___AHUI_AddHeroAbility(whichHero , AllyHeroAbilityUI___AHUI_SLOT_R , AinzR_ID)
        call AllyHeroAbilityUI___AHUI_AddHeroAbility(whichHero , AllyHeroAbilityUI___AHUI_SLOT_R , AinzR2_ID)
        call AllyHeroAbilityUI___AHUI_AddHeroAbility(whichHero , AllyHeroAbilityUI___AHUI_SLOT_T , AinzT_ID)
        call AllyHeroAbilityUI___AHUI_AddHeroAbility(whichHero , AllyHeroAbilityUI___AHUI_SLOT_F , AinzF_ID)
