        call s__GearSystems2__KS_DelayedDamage_NextDmg_Start((c ) , ( td ) , (( Gonryomaru_DamageBase * GetMainStatValue(c , true) )*1.0) , ( 0 ) , (( 0.05)*1.0)) // INLINED!!
        call ErzaPassive(c , td , 3)
