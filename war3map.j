                                set s__FrierenSpells__FrierenSpells_E_y[this]=GetUnitY(s__FrierenSpells__FrierenSpells_E_c[this]) + s__FrierenSpells__FrierenSpells_E_r5[this] * Sin(s__FrierenSpells__FrierenSpells_E_r6[this])
                                set positionOk=true
