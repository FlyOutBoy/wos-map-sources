        call s__SpellData_setDecor((s__SpellData_create((BambiettaT2_ID ) , ( 1 ) , ( 2 ) , ( 2 ) , (( BambiettaTT_DamageAgiBase )*1.0) , (( 0.0 )*1.0) , 0.0 , 0.0 , ( AAUniversalTooltips_T_RadExp(BambiettaTT_DamageAoe , BambiettaTT_DamageAoe2) + AAUniversalTooltips_T_DurAuto(BambiettaTT_Duration , BambiettaT2_IsInvul) + AAUniversalTooltips_T_Prop("Explosions" , 21) ) , ( AAUniversalTooltips_T_Bonus("Form" , "|cffFF0000Vollstandig Form|r")))),(I2S(R2I(((BambiettaTT_DecorDamage)*1.0))))) // INLINED!!

