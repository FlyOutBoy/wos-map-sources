                        call DecorRemove(s__LaxusSpells___LaxusT_KS_c[this] , s__LaxusSpells___LaxusT_KS_x[this] , s__LaxusSpells___LaxusT_KS_y[this] , s__LaxusSpells___LaxusT_KS_aoe[this] , LaxusT_DecorDamage)
                        call VisionTimed(GetOwningPlayer(s__LaxusSpells___LaxusT_KS_c[this]) , s__LaxusSpells___LaxusT_KS_x[this] , s__LaxusSpells___LaxusT_KS_y[this] , s__LaxusSpells___LaxusT_KS_aoe[this] , 1.5)
                        set impactEffect=EffectSpawnScale("war3mapImported\\wos_by_wood_bashenan_juqi_2_2_yellow.mdl" , s__LaxusSpells___LaxusT_KS_x[this] , s__LaxusSpells___LaxusT_KS_y[this] , GetRandomReal(0.0, 359.0) , 0.65 , 1.0 , 150.0 , 0.30 , 1.0 , 17.0 * s__LaxusSpells___LaxusT_KS_scale[this])
                        call EHeightSet(impactEffect , 0.30 , 650.0)
                        call s__GearSystems2__KS_RemoveEffect_MyRemoveEff_Start((impactEffect ) , (( 0.40 )*1.0) , 1 , (( 10.0)*1.0) , - 1 , "") // INLINED!!
                        call ColorEffDummy3(impactEffect , 0.50 , 255 , 255 , 255 , 0.10)
                        set impactEffect=null
                        call DestroyEffect(EffectSpawnColor("war3mapImported\\wos_HakkeStartWhite.mdx" , s__LaxusSpells___LaxusT_KS_x[this] , s__LaxusSpells___LaxusT_KS_y[this] , GetRandomReal(0.0, 359.0) , 1.40 , 2.75 * s__LaxusSpells___LaxusT_KS_scale[this] , 0.0 , 255 , 255 , 125 , 255))
                        call DestroyEffect(EffectSpawnScale("war3mapImported\\wos_by_wood_effect_order_dange_yueyun_3yellowlightclear.mdl" , s__LaxusSpells___LaxusT_KS_x[this] , s__LaxusSpells___LaxusT_KS_y[this] , GetRandomReal(0.0, 359.0) , 0.65 , 1.0 , 1.0 , 0.30 , 0.01 , 2.80 * s__LaxusSpells___LaxusT_KS_scale[this]))
                        call GroupClear(s__LaxusSpells___LaxusT_KS_g[this])
                        call GroupEnumUnitsInRange(s__LaxusSpells___LaxusT_KS_g[this], s__LaxusSpells___LaxusT_KS_x[this], s__LaxusSpells___LaxusT_KS_y[this], s__LaxusSpells___LaxusT_KS_aoe[this], Condition(function NoDecor_Filter))
                        loop
                            set s__LaxusSpells___LaxusT_KS_u[this]=FirstOfGroup(s__LaxusSpells___LaxusT_KS_g[this])
                            exitwhen s__LaxusSpells___LaxusT_KS_u[this] == null
                            if SpellBool(s__LaxusSpells___LaxusT_KS_u[this]) and IsUnitEnemy(s__LaxusSpells___LaxusT_KS_u[this], GetOwningPlayer(s__LaxusSpells___LaxusT_KS_c[this])) then
                                if LaxusT_Debuff > 0 then
                                    call ErzaPassive(s__LaxusSpells___LaxusT_KS_c[this] , s__LaxusSpells___LaxusT_KS_u[this] , LaxusT_Debuff)
                                endif
                                call dmgmag(s__LaxusSpells___LaxusT_KS_c[this] , s__LaxusSpells___LaxusT_KS_u[this] , s__LaxusSpells___LaxusT_KS_dmg[this])
                                call SilenceUnit(s__LaxusSpells___LaxusT_KS_c[this] , s__LaxusSpells___LaxusT_KS_u[this] , LaxusT_Silence)
                            endif
                            call GroupRemoveUnit(s__LaxusSpells___LaxusT_KS_g[this], s__LaxusSpells___LaxusT_KS_u[this])
                        endloop
                        set s__LaxusSpells___LaxusT_KS_u[this]=null
