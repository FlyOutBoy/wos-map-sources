                    call SetFly(s__MilimSpells__MilimEKS_c[this] , 0)
                    
                     //   call BlzSetSpecialEffectPitch(e,-120*bj_DEGTORAD)
                    //call BlzPlaySpecialEffect(e,ANIM_TYPE_DEATH)
                    if s__MilimSpells__MilimEKS_check[this] < 20 then
