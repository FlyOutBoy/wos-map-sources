function AllyHeroAbilityUI___AHUI_FormatCooldown takes real remaining returns string
    if remaining >= 10.00 then
        return I2S(R2I(remaining + 0.99))
    endif
    return R2SW(remaining, 1, 1)
endfunction

function AllyHeroAbilityUI___AHUI_HideTooltip takes integer pid returns nothing
    call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_TooltipRoot[pid], false)
    call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_TooltipBackdrop[pid], false)
    call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_TooltipTitle[pid], false)
    call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_TooltipText[pid], false)
    call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_TooltipManaIcon[pid], false)
    call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_TooltipManaText[pid], false)
    call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_TooltipSeparator[pid], false)
endfunction

function AllyHeroAbilityUI___AHUI_HideSlot takes integer pid,integer slot returns nothing
    local integer index= ((pid ) * AllyHeroAbilityUI___AHUI_SLOT_COUNT + ( slot)) // INLINED!!

    set AllyHeroAbilityUI___AHUI_RenderedAbility[index]=0
    set AllyHeroAbilityUI___AHUI_RenderedIconPath[index]=null
    set AllyHeroAbilityUI___AHUI_SlotVisible[index]=false
    set AllyHeroAbilityUI___AHUI_CooldownPeak[index]=0.00
    set AllyHeroAbilityUI___AHUI_LastRemaining[index]=0.00

    // Функция вызывается только из локальной ветки соответствующего pid.
    call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_Root[index], false)
    call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_Icon[index], false)
    call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_CooldownFill[index], false)
    call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_CooldownText[index], false)
    call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_KeyText[index], false)
    call BlzFrameSetAlpha(AllyHeroAbilityUI___AHUI_Icon[index], AllyHeroAbilityUI___AHUI_READY_ALPHA)
    call BlzFrameSetAlpha(AllyHeroAbilityUI___AHUI_CooldownFill[index], 255)
    call BlzFrameSetAlpha(AllyHeroAbilityUI___AHUI_CooldownText[index], 255)
    call BlzFrameSetAlpha(AllyHeroAbilityUI___AHUI_KeyText[index], 255)

    if AllyHeroAbilityUI___AHUI_HoveredSlot[pid] == slot then
        call AllyHeroAbilityUI___AHUI_HideTooltip(pid)
    endif
endfunction

function AllyHeroAbilityUI___AHUI_HideAll takes integer pid returns nothing
    local integer slot= 0

    loop
        exitwhen slot >= AllyHeroAbilityUI___AHUI_SLOT_COUNT
        call AllyHeroAbilityUI___AHUI_HideSlot(pid , slot)
        set slot=slot + 1
    endloop

    call AllyHeroAbilityUI___AHUI_HideTooltip(pid)
endfunction

function AllyHeroAbilityUI___AHUI_RefreshSlot takes integer pid,integer slot returns nothing
    local integer index= ((pid ) * AllyHeroAbilityUI___AHUI_SLOT_COUNT + ( slot)) // INLINED!!
    local integer abilityId= AllyHeroAbilityUI___AHUI_CurrentAbility[slot]
    local integer level= 0
    local real remaining= 0.00
    local real progress= 0.00
    local string iconPath= null

    if abilityId == 0 then
        call AllyHeroAbilityUI___AHUI_HideSlot(pid , slot)
        return
    endif

    set level=GetUnitAbilityLevel(AllyHeroAbilityUI___AHUI_SelectedHero[pid], abilityId)
    set iconPath=BlzGetAbilityIcon(abilityId)

    if AllyHeroAbilityUI___AHUI_RenderedAbility[index] != abilityId or AllyHeroAbilityUI___AHUI_RenderedIconPath[index] != iconPath then
        set AllyHeroAbilityUI___AHUI_RenderedAbility[index]=abilityId
        set AllyHeroAbilityUI___AHUI_RenderedIconPath[index]=iconPath
        set AllyHeroAbilityUI___AHUI_CooldownPeak[index]=0.00
        set AllyHeroAbilityUI___AHUI_LastRemaining[index]=0.00
        call BlzFrameSetTexture(AllyHeroAbilityUI___AHUI_Icon[index], iconPath, 0, true)
        call BlzFrameSetTexture(AllyHeroAbilityUI___AHUI_CooldownFill[index], ConvertBTNtoDISBTN(iconPath), 0, true)
    endif

    set AllyHeroAbilityUI___AHUI_SlotVisible[index]=true
    call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_Root[index], true)
    call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_Icon[index], true)
    call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_KeyText[index], true)

    // Неизученная или сейчас отсутствующая способность остаётся видимой как
    // DISBTN, но без выдуманного таймера.
    if level <= 0 then
        set AllyHeroAbilityUI___AHUI_CooldownPeak[index]=0.00
        set AllyHeroAbilityUI___AHUI_LastRemaining[index]=0.00
        call BlzFrameSetAlpha(AllyHeroAbilityUI___AHUI_Icon[index], 0)
        call BlzFrameSetAlpha(AllyHeroAbilityUI___AHUI_CooldownFill[index], 255)
        call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_CooldownFill[index], true)
        call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_CooldownText[index], false)
        set iconPath=null
        return
    endif

    // Источник прогресса — только фактический remaining юнита. При старте или
    // перезапуске КД запоминается реально наблюдаемая вершина, поэтому ручные
    // BlzStartUnitAbilityCooldown и уменьшения КД не подменяются Object Editor.
    set remaining=BlzGetUnitAbilityCooldownRemaining(AllyHeroAbilityUI___AHUI_SelectedHero[pid], abilityId)
    if remaining > 0.05 then
        if AllyHeroAbilityUI___AHUI_CooldownPeak[index] <= 0.05 or remaining > AllyHeroAbilityUI___AHUI_LastRemaining[index] + 0.15 then
            set AllyHeroAbilityUI___AHUI_CooldownPeak[index]=remaining
        elseif remaining > AllyHeroAbilityUI___AHUI_CooldownPeak[index] then
            set AllyHeroAbilityUI___AHUI_CooldownPeak[index]=remaining
        endif

        set progress=remaining / AllyHeroAbilityUI___AHUI_CooldownPeak[index]
        if progress > 1.00 then
            set progress=1.00
        elseif progress < 0.00 then
            set progress=0.00
        endif

        call BlzFrameSetAlpha(AllyHeroAbilityUI___AHUI_Icon[index], R2I(255.00 * ( 1.00 - progress )))
        call BlzFrameSetAlpha(AllyHeroAbilityUI___AHUI_CooldownFill[index], R2I(255.00 * progress))
        call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_CooldownFill[index], true)
        call BlzFrameSetText(AllyHeroAbilityUI___AHUI_CooldownText[index], "|cffffffff" + AllyHeroAbilityUI___AHUI_FormatCooldown(remaining) + "|r")
        call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_CooldownText[index], true)
    else
        set AllyHeroAbilityUI___AHUI_CooldownPeak[index]=0.00
        call BlzFrameSetAlpha(AllyHeroAbilityUI___AHUI_Icon[index], AllyHeroAbilityUI___AHUI_READY_ALPHA)
        call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_CooldownFill[index], false)
        call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_CooldownText[index], false)
    endif

    set AllyHeroAbilityUI___AHUI_LastRemaining[index]=remaining

    set iconPath=null
endfunction

function AllyHeroAbilityUI___AHUI_RefreshTooltip takes integer pid returns nothing
    local integer slot= AllyHeroAbilityUI___AHUI_HoveredSlot[pid]
    local integer index= 0
    local integer abilityId= 0
    local integer abilityLevel= 0
    local integer objectLevel= 0
    local string title= null
    local string description= null
    local integer manaCost= 0
local real textHeight= 0.0
local real boxHeight= 0.0
local boolean hasMana= false
     if not AllyHeroAbilityUI___AHUI_TooltipsReady then
        call AllyHeroAbilityUI___AHUI_HideTooltip(pid)
        return
    endif
    if slot < 0 or slot >= AllyHeroAbilityUI___AHUI_SLOT_COUNT then
        call AllyHeroAbilityUI___AHUI_HideTooltip(pid)
        return
    endif

    set index=((pid ) * AllyHeroAbilityUI___AHUI_SLOT_COUNT + ( slot)) // INLINED!!
    if not AllyHeroAbilityUI___AHUI_SlotVisible[index] then
        call AllyHeroAbilityUI___AHUI_HideTooltip(pid)
        return
    endif

    set abilityId=AllyHeroAbilityUI___AHUI_CurrentAbility[slot]
    if abilityId == 0 then
        call AllyHeroAbilityUI___AHUI_HideTooltip(pid)
        return
    endif

    set abilityLevel=GetUnitAbilityLevel(AllyHeroAbilityUI___AHUI_SelectedHero[pid], abilityId)
    if abilityLevel > 0 then
        set objectLevel=abilityLevel - 1
    endif

    // Текст перечитывается во время каждого тика, пока мышь над кнопкой.
    // Это учитывает не только смену rawcode/уровня, но и динамическое изменение
    // tooltip другими системами карты.
set title=BlzGetAbilityTooltip(abilityId, objectLevel)
set description=BlzGetAbilityExtendedTooltip(abilityId, objectLevel)
set manaCost=BlzGetAbilityManaCost(abilityId, objectLevel)

// Flame Dash [Level 5] (Q)
set title=title + " (" + AllyHeroAbilityUI___AHUI_GetKeyText(slot) + ")"

call BlzFrameSetText(AllyHeroAbilityUI___AHUI_TooltipTitle[pid], title)
call BlzFrameSetText(AllyHeroAbilityUI___AHUI_TooltipText[pid], description)

// ВАЖНО: пересчитываем layout текста
call BlzFrameSetSize(AllyHeroAbilityUI___AHUI_TooltipText[pid], 0.278, 0.0)

set hasMana=manaCost > 0

if hasMana then
    call BlzFrameSetText(AllyHeroAbilityUI___AHUI_TooltipManaText[pid], "|cffffcc00" + I2S(manaCost) + "|r")

    // Показываем mana + separator
    call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_TooltipManaIcon[pid], true)
    call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_TooltipManaText[pid], true)
    call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_TooltipSeparator[pid], true)

    // Текст начинается НИЖЕ separator
    call BlzFrameClearAllPoints(AllyHeroAbilityUI___AHUI_TooltipText[pid])
    call BlzFrameSetPoint(AllyHeroAbilityUI___AHUI_TooltipText[pid], FRAMEPOINT_TOPLEFT, AllyHeroAbilityUI___AHUI_TooltipRoot[pid], FRAMEPOINT_TOPLEFT, 0.011, - 0.054)
else
    call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_TooltipManaIcon[pid], false)
    call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_TooltipManaText[pid], false)
    call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_TooltipSeparator[pid], false)

    call BlzFrameClearAllPoints(AllyHeroAbilityUI___AHUI_TooltipText[pid])
    call BlzFrameSetPoint(AllyHeroAbilityUI___AHUI_TooltipText[pid], FRAMEPOINT_TOPLEFT, AllyHeroAbilityUI___AHUI_TooltipRoot[pid], FRAMEPOINT_TOPLEFT, 0.011, - 0.032)
endif

set textHeight=BlzFrameGetHeight(AllyHeroAbilityUI___AHUI_TooltipText[pid])

if hasMana then
    set boxHeight=textHeight + 0.067
else
    set boxHeight=textHeight + 0.042
endif

if boxHeight < 0.080 then
    set boxHeight=0.080
endif

call BlzFrameSetSize(AllyHeroAbilityUI___AHUI_TooltipRoot[pid], 0.300, boxHeight)

// Позиция окна
call BlzFrameClearAllPoints(AllyHeroAbilityUI___AHUI_TooltipRoot[pid])
call BlzFrameSetPoint(AllyHeroAbilityUI___AHUI_TooltipRoot[pid], FRAMEPOINT_BOTTOMRIGHT, AllyHeroAbilityUI___AHUI_ConsoleBackdrop, FRAMEPOINT_TOPRIGHT, - 0.006, 0.025)

// Показываем tooltip
call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_TooltipBackdrop[pid], true)
call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_TooltipTitle[pid], true)
call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_TooltipText[pid], true)
call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_TooltipRoot[pid], true)

set title=null
set description=null
endfunction

function AllyHeroAbilityUI___AHUI_IsEligibleHero takes unit whichHero,integer viewerId returns boolean
    local player owner= null
    local boolean result= false

    if whichHero == null or viewerId < 0 or viewerId >= bj_MAX_PLAYER_SLOTS or GetUnitTypeId(whichHero) == 0 then
        return false
    endif
    if not IsUnitType(whichHero, UNIT_TYPE_HERO) or IsUnitIllusion(whichHero) then
        return false
    endif

    // В TestMode оба управляемых тестовых героя разрешены независимо от
    // владельца: TestUnit остаётся юнитом тестового игрока 6 даже после
    // передачи управления текущему игроку.
    if TestMode and ( whichHero == TestUnit or whichHero == TestAllyUnit ) then
        return true
    endif

    set owner=GetOwningPlayer(whichHero)

// Игроки 11-15 могут смотреть cooldown ЛЮБОГО чужого героя,
// независимо от alliance.
if viewerId >= 10 and viewerId <= 14 then
    set result=owner != Player(viewerId)
else
    // Остальные — только союзники, как раньше.
    set result=owner != Player(viewerId) and IsPlayerAlly(Player(viewerId), owner)
endif

set owner=null
return result
endfunction

// Hover определяется только чтением локальной позиции мыши. Никакие BUTTON,
// SIMPLEBUTTON, hitbox-frame или frame mouse events не используются.
function AllyHeroAbilityUI___AHUI_UpdateHoveredSlot takes integer pid returns nothing
    local integer slot= 0
    local integer index= 0
    local real mouseX= 0.00
    local real mouseY= 0.00
    local real centerX= 0.00
    local real centerY= 0.00
    local real halfSize= AllyHeroAbilityUI___AHUI_ICON_SIZE * 0.50

    if GetLocalPlayer() != Player(pid) then
        return
    endif
    if not AllyHeroAbilityUI___AHUI_IsEligibleHero(AllyHeroAbilityUI___AHUI_SelectedHero[pid] , pid) then
        set AllyHeroAbilityUI___AHUI_HoveredSlot[pid]=- 1
        call AllyHeroAbilityUI___AHUI_HideTooltip(pid)
        return
    endif

    set mouseX=BlzPixelToFrameX(BlzGetMouseScreenPosX())
    set mouseY=BlzPixelToFrameY(BlzGetMouseScreenPosY())
    set AllyHeroAbilityUI___AHUI_HoveredSlot[pid]=- 1

    loop
        exitwhen slot >= AllyHeroAbilityUI___AHUI_SLOT_COUNT
        set index=((pid ) * AllyHeroAbilityUI___AHUI_SLOT_COUNT + ( slot)) // INLINED!!
        if AllyHeroAbilityUI___AHUI_SlotVisible[index] then
            set centerX=(AllyHeroAbilityUI___AHUI_COMMAND_X0 + AllyHeroAbilityUI___AHUI_COMMAND_X_STEP * I2R(AllyHeroAbilityUI___AHUI_GetSlotX((slot)))) // INLINED!!
            set centerY=AllyHeroAbilityUI___AHUI_GetSlotCenterY(slot)
            if mouseX >= centerX - halfSize and mouseX <= centerX + halfSize and mouseY >= centerY - halfSize and mouseY <= centerY + halfSize then
                set AllyHeroAbilityUI___AHUI_HoveredSlot[pid]=slot
                call AllyHeroAbilityUI___AHUI_RefreshTooltip(pid)
                return
            endif
        endif
        set slot=slot + 1
    endloop

    call AllyHeroAbilityUI___AHUI_HideTooltip(pid)
endfunction

function AllyHeroAbilityUI___AHUI_ClearSelection takes integer pid returns nothing
    if GetLocalPlayer() != Player(pid) then
        return
    endif

    set AllyHeroAbilityUI___AHUI_SelectedHero[pid]=null
    set AllyHeroAbilityUI___AHUI_HoveredSlot[pid]=- 1
    set AllyHeroAbilityUI___AHUI_AllowCooldownRead=false
    call AllyHeroAbilityUI___AHUI_ClearResolvedAbilities()
    call AllyHeroAbilityUI___AHUI_HideAll(pid)
endfunction

function AllyHeroAbilityUI___AHUI_Refresh takes integer pid returns nothing
    local integer slot= 0

    // Защитный барьер: ни чтение кулдауна, ни изменение фрейма чужого pid
    // никогда не выполняются на этом клиенте.
    if GetLocalPlayer() != Player(pid) then
        return
    endif

    if not AllyHeroAbilityUI___AHUI_IsEligibleHero(AllyHeroAbilityUI___AHUI_SelectedHero[pid] , pid) then
        call AllyHeroAbilityUI___AHUI_ClearSelection(pid)
        return
    endif

    // Никакое состояние не берётся из предыдущего тика: белый список героя и
    // фактический остаток КД каждой его основной/вторичной способности читаются заново.
    call AllyHeroAbilityUI___AHUI_ClearResolvedAbilities()
    set AllyHeroAbilityUI___AHUI_AllowCooldownRead=true
    call AllyHeroAbilityUI___AHUI_ConfigureHeroAbilities(AllyHeroAbilityUI___AHUI_SelectedHero[pid])
    set AllyHeroAbilityUI___AHUI_AllowCooldownRead=false

    loop
        exitwhen slot >= AllyHeroAbilityUI___AHUI_SLOT_COUNT
        call AllyHeroAbilityUI___AHUI_RefreshSlot(pid , slot)
        set slot=slot + 1
    endloop

endfunction

function AllyHeroAbilityUI___AHUI_Periodic takes nothing returns nothing
    local integer pid= 0
    local boolean refreshAbilities= AllyHeroAbilityUI___AHUI_UpdateTick == 0

    loop
        exitwhen pid >= bj_MAX_PLAYER_SLOTS
        if GetLocalPlayer() == Player(pid) then
            if AllyHeroAbilityUI___AHUI_SelectedHero[pid] != null then
                if refreshAbilities then
                    call AllyHeroAbilityUI___AHUI_Refresh(pid)
                endif
                if AllyHeroAbilityUI___AHUI_SelectedHero[pid] != null then
                    call AllyHeroAbilityUI___AHUI_UpdateHoveredSlot(pid)
                endif
            else
                set AllyHeroAbilityUI___AHUI_HoveredSlot[pid]=- 1
                call AllyHeroAbilityUI___AHUI_HideTooltip(pid)
            endif
        endif
        set pid=pid + 1
    endloop

    set AllyHeroAbilityUI___AHUI_UpdateTick=AllyHeroAbilityUI___AHUI_UpdateTick + 1
    if AllyHeroAbilityUI___AHUI_UpdateTick >= AllyHeroAbilityUI___AHUI_REFRESH_TICKS then
        set AllyHeroAbilityUI___AHUI_UpdateTick=0
    endif
endfunction

function AllyHeroAbilityUI___AHUI_OnSelect takes nothing returns nothing
    local unit selected= GetTriggerUnit()
    local integer pid= GetPlayerId(GetTriggerPlayer())

    // Никакой переменной player = GetLocalPlayer(): только прямая проверка.
    if GetLocalPlayer() == Player(pid) then
        if AllyHeroAbilityUI___AHUI_IsEligibleHero(selected , pid) then
            // Полный reset не даёт предыдущему союзнику мигнуть даже один кадр.
            call AllyHeroAbilityUI___AHUI_ClearSelection(pid)
            set AllyHeroAbilityUI___AHUI_SelectedHero[pid]=selected
            call AllyHeroAbilityUI___AHUI_Refresh(pid)
            call AllyHeroAbilityUI___AHUI_UpdateHoveredSlot(pid)
        else
            // Враг, чужой обычный юнит и неосновной собственный юнит сразу
            // очищают локальную панель, поэтому старый кулдаун не мигнёт.
            call AllyHeroAbilityUI___AHUI_ClearSelection(pid)
        endif
    endif

    set selected=null
endfunction

function AllyHeroAbilityUI___AHUI_OnDeselect takes nothing returns nothing
    local unit deselected= GetTriggerUnit()
    local integer pid= GetPlayerId(GetTriggerPlayer())

    if GetLocalPlayer() == Player(pid) and deselected == AllyHeroAbilityUI___AHUI_SelectedHero[pid] then
        call AllyHeroAbilityUI___AHUI_ClearSelection(pid)
    endif

    set deselected=null
endfunction

// Read-only API для ShowTextCD. Он использует тот же белый список, поэтому
// предметные и служебные abilities больше не могут попасть в command slot.
function AHUI_GetAbilityAtCommandSlot takes unit whichUnit,integer commandSlot returns integer
    local integer targetY= 0
    local integer targetX= 0
    local integer logicalSlot= - 1

    if whichUnit == null or commandSlot < 0 or commandSlot > 11 then
        return 0
    endif

    set targetY=R2I(I2R(commandSlot) / 4.00)
    set targetX=commandSlot - targetY * 4
    set logicalSlot=AllyHeroAbilityUI___AHUI_GetLogicalSlot(targetX , targetY)
    if logicalSlot < 0 then
        return 0
    endif

    call AllyHeroAbilityUI___AHUI_ClearResolvedAbilities()
    set AllyHeroAbilityUI___AHUI_AllowCooldownRead=false
    call AllyHeroAbilityUI___AHUI_ConfigureHeroAbilities(whichUnit)
    return AllyHeroAbilityUI___AHUI_CurrentAbility[logicalSlot]
endfunction

function AHUI_IsAbilityLearnedAtCommandSlot takes unit whichUnit,integer commandSlot,integer abilityId returns boolean
    if whichUnit == null or abilityId == 0 or commandSlot < 0 or commandSlot > 11 then
        return false
    endif
    return GetUnitAbilityLevel(whichUnit, abilityId) > 0
endfunction

function AllyHeroAbilityUI___AHUI_CreateSlotFrames takes nothing returns nothing
    local integer pid= 0
    local integer slot= 0
    local integer index= 0
    local framehandle console= BlzGetFrameByName("ConsoleUIBackdrop", 0)

    // Origin-фреймы используются только как визуальные якоря. Hover считается
    // отдельно по локальным screen coordinates мыши.
    loop
        exitwhen slot >= AllyHeroAbilityUI___AHUI_SLOT_COUNT
        set AllyHeroAbilityUI___AHUI_Origin[slot]=BlzGetOriginFrame(ORIGIN_FRAME_COMMAND_BUTTON, AllyHeroAbilityUI___AHUI_GetOriginSlot(slot))
        set slot=slot + 1
    endloop

    // Все клиенты создают одинаковые handle-последовательности. Видимость и
    // содержимое позже меняет только локальный владелец конкретного pid.
    loop
        exitwhen pid >= bj_MAX_PLAYER_SLOTS
        set slot=0
        loop
            exitwhen slot >= AllyHeroAbilityUI___AHUI_SLOT_COUNT
            set index=((pid ) * AllyHeroAbilityUI___AHUI_SLOT_COUNT + ( slot)) // INLINED!!

            set AllyHeroAbilityUI___AHUI_Root[index]=BlzCreateFrameByType("FRAME", "AHUIRoot", console, "", index)
            call BlzFrameClearAllPoints(AllyHeroAbilityUI___AHUI_Root[index])
            call BlzFrameSetSize(AllyHeroAbilityUI___AHUI_Root[index], AllyHeroAbilityUI___AHUI_ICON_SIZE, AllyHeroAbilityUI___AHUI_ICON_SIZE)
            call BlzFrameSetPoint(AllyHeroAbilityUI___AHUI_Root[index], FRAMEPOINT_CENTER, AllyHeroAbilityUI___AHUI_Origin[slot], FRAMEPOINT_CENTER, 0.00, 0.00)
            call BlzFrameSetLevel(AllyHeroAbilityUI___AHUI_Root[index], 100)
            call BlzFrameSetEnable(AllyHeroAbilityUI___AHUI_Root[index], false)
            call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_Root[index], false)

            set AllyHeroAbilityUI___AHUI_Icon[index]=BlzCreateFrameByType("BACKDROP", "AHUIIcon", AllyHeroAbilityUI___AHUI_Root[index], "", index)
            call BlzFrameClearAllPoints(AllyHeroAbilityUI___AHUI_Icon[index])
            call BlzFrameSetAllPoints(AllyHeroAbilityUI___AHUI_Icon[index], AllyHeroAbilityUI___AHUI_Root[index])
            call BlzFrameSetLevel(AllyHeroAbilityUI___AHUI_Icon[index], 101)
            call BlzFrameSetEnable(AllyHeroAbilityUI___AHUI_Icon[index], false)
            call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_Icon[index], false)

            set AllyHeroAbilityUI___AHUI_CooldownFill[index]=BlzCreateFrameByType("BACKDROP", "AHUICooldownFill", AllyHeroAbilityUI___AHUI_Root[index], "", index)
            call BlzFrameClearAllPoints(AllyHeroAbilityUI___AHUI_CooldownFill[index])
            call BlzFrameSetAllPoints(AllyHeroAbilityUI___AHUI_CooldownFill[index], AllyHeroAbilityUI___AHUI_Root[index])
            call BlzFrameSetAlpha(AllyHeroAbilityUI___AHUI_CooldownFill[index], 255)
            call BlzFrameSetLevel(AllyHeroAbilityUI___AHUI_CooldownFill[index], 102)
            call BlzFrameSetEnable(AllyHeroAbilityUI___AHUI_CooldownFill[index], false)
            call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_CooldownFill[index], false)

            set AllyHeroAbilityUI___AHUI_CooldownText[index]=BlzCreateFrameByType("TEXT", "AHUICooldownText", AllyHeroAbilityUI___AHUI_Root[index], "", index)
            call BlzFrameClearAllPoints(AllyHeroAbilityUI___AHUI_CooldownText[index])
            call BlzFrameSetSize(AllyHeroAbilityUI___AHUI_CooldownText[index], AllyHeroAbilityUI___AHUI_ICON_SIZE, AllyHeroAbilityUI___AHUI_ICON_SIZE)
            call BlzFrameSetPoint(AllyHeroAbilityUI___AHUI_CooldownText[index], FRAMEPOINT_CENTER, AllyHeroAbilityUI___AHUI_Root[index], FRAMEPOINT_CENTER, 0.00, 0.00)
            call BlzFrameSetTextAlignment(AllyHeroAbilityUI___AHUI_CooldownText[index], TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
            call BlzFrameSetScale(AllyHeroAbilityUI___AHUI_CooldownText[index], AllyHeroAbilityUI___AHUI_COOLDOWN_TEXT_SCALE)
            call BlzFrameSetAlpha(AllyHeroAbilityUI___AHUI_CooldownText[index], 255)
            call BlzFrameSetLevel(AllyHeroAbilityUI___AHUI_CooldownText[index], 110)
            call BlzFrameSetEnable(AllyHeroAbilityUI___AHUI_CooldownText[index], false)
            call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_CooldownText[index], false)

            set AllyHeroAbilityUI___AHUI_KeyText[index]=BlzCreateFrameByType("TEXT", "AHUIKeyText", AllyHeroAbilityUI___AHUI_Root[index], "", index)
            call BlzFrameClearAllPoints(AllyHeroAbilityUI___AHUI_KeyText[index])
            call BlzFrameSetSize(AllyHeroAbilityUI___AHUI_KeyText[index], 0.014, 0.014)
            call BlzFrameSetPoint(AllyHeroAbilityUI___AHUI_KeyText[index], FRAMEPOINT_TOPLEFT, AllyHeroAbilityUI___AHUI_Root[index], FRAMEPOINT_TOPLEFT, 0.002, - 0.002)
            call BlzFrameSetTextAlignment(AllyHeroAbilityUI___AHUI_KeyText[index], TEXT_JUSTIFY_TOP, TEXT_JUSTIFY_LEFT)
            call BlzFrameSetScale(AllyHeroAbilityUI___AHUI_KeyText[index], 1.15)
            call BlzFrameSetText(AllyHeroAbilityUI___AHUI_KeyText[index], "|cffffcc00" + AllyHeroAbilityUI___AHUI_GetKeyText(slot) + "|r")
            call BlzFrameSetAlpha(AllyHeroAbilityUI___AHUI_KeyText[index], 255)
            call BlzFrameSetLevel(AllyHeroAbilityUI___AHUI_KeyText[index], 111)
            call BlzFrameSetEnable(AllyHeroAbilityUI___AHUI_KeyText[index], false)
            call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_KeyText[index], false)

            set slot=slot + 1
        endloop
        set pid=pid + 1
    endloop

    set console=null
endfunction

function AllyHeroAbilityUI___AHUI_CreateTooltipFrames takes nothing returns nothing
    local integer pid= 0

    loop
        exitwhen pid >= bj_MAX_PLAYER_SLOTS

        // ROOT
        set AllyHeroAbilityUI___AHUI_TooltipRoot[pid]=BlzCreateFrameByType("FRAME", "AHUITooltipRoot", AllyHeroAbilityUI___AHUI_GameUI, "", pid)
        call BlzFrameSetSize(AllyHeroAbilityUI___AHUI_TooltipRoot[pid], 0.300, 0.180)
        call BlzFrameSetLevel(AllyHeroAbilityUI___AHUI_TooltipRoot[pid], 1000)
        call BlzFrameSetEnable(AllyHeroAbilityUI___AHUI_TooltipRoot[pid], false)
        call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_TooltipRoot[pid], false)

        // Warcraft-like backdrop + border
        set AllyHeroAbilityUI___AHUI_TooltipBackdrop[pid]=BlzCreateFrame("EscMenuControlBackdropTemplate", AllyHeroAbilityUI___AHUI_TooltipRoot[pid], 0, pid)
        call BlzFrameSetAllPoints(AllyHeroAbilityUI___AHUI_TooltipBackdrop[pid], AllyHeroAbilityUI___AHUI_TooltipRoot[pid])
        call BlzFrameSetLevel(AllyHeroAbilityUI___AHUI_TooltipBackdrop[pid], 1001)
        call BlzFrameSetEnable(AllyHeroAbilityUI___AHUI_TooltipBackdrop[pid], false)
        call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_TooltipBackdrop[pid], false)

        // TITLE
        set AllyHeroAbilityUI___AHUI_TooltipTitle[pid]=BlzCreateFrameByType("TEXT", "AHUITooltipTitle", AllyHeroAbilityUI___AHUI_TooltipRoot[pid], "", pid)
        call BlzFrameSetSize(AllyHeroAbilityUI___AHUI_TooltipTitle[pid], 0.278, 0.020)
        call BlzFrameSetPoint(AllyHeroAbilityUI___AHUI_TooltipTitle[pid], FRAMEPOINT_TOPLEFT, AllyHeroAbilityUI___AHUI_TooltipRoot[pid], FRAMEPOINT_TOPLEFT, 0.011, - 0.009)
        call BlzFrameSetTextAlignment(AllyHeroAbilityUI___AHUI_TooltipTitle[pid], TEXT_JUSTIFY_TOP, TEXT_JUSTIFY_LEFT)
        call BlzFrameSetScale(AllyHeroAbilityUI___AHUI_TooltipTitle[pid], 1.10)
        call BlzFrameSetLevel(AllyHeroAbilityUI___AHUI_TooltipTitle[pid], 1002)
        call BlzFrameSetEnable(AllyHeroAbilityUI___AHUI_TooltipTitle[pid], false)
        call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_TooltipTitle[pid], false)

        // MANA ICON
        set AllyHeroAbilityUI___AHUI_TooltipManaIcon[pid]=BlzCreateFrameByType("BACKDROP", "AHUITooltipManaIcon", AllyHeroAbilityUI___AHUI_TooltipRoot[pid], "", pid)
call BlzFrameSetSize(AllyHeroAbilityUI___AHUI_TooltipManaIcon[pid], 0.015, 0.015)
call BlzFrameSetPoint(AllyHeroAbilityUI___AHUI_TooltipManaIcon[pid], FRAMEPOINT_TOPLEFT, AllyHeroAbilityUI___AHUI_TooltipRoot[pid], FRAMEPOINT_TOPLEFT, 0.011, - 0.027)
call BlzFrameSetTexture(AllyHeroAbilityUI___AHUI_TooltipManaIcon[pid], "UI\\Widgets\\ToolTips\\Human\\ToolTipManaIcon.blp", 0, false)
        call BlzFrameSetLevel(AllyHeroAbilityUI___AHUI_TooltipManaIcon[pid], 1002)
        call BlzFrameSetEnable(AllyHeroAbilityUI___AHUI_TooltipManaIcon[pid], false)
        call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_TooltipManaIcon[pid], false)

        // MANA VALUE
        set AllyHeroAbilityUI___AHUI_TooltipManaText[pid]=BlzCreateFrameByType("TEXT", "AHUITooltipManaText", AllyHeroAbilityUI___AHUI_TooltipRoot[pid], "", pid)
        call BlzFrameSetSize(AllyHeroAbilityUI___AHUI_TooltipManaText[pid], 0.250, 0.014)
        call BlzFrameSetPoint(AllyHeroAbilityUI___AHUI_TooltipManaText[pid], FRAMEPOINT_LEFT, AllyHeroAbilityUI___AHUI_TooltipManaIcon[pid], FRAMEPOINT_RIGHT, 0.005, 0.0)
        call BlzFrameSetTextAlignment(AllyHeroAbilityUI___AHUI_TooltipManaText[pid], TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_LEFT)
        call BlzFrameSetLevel(AllyHeroAbilityUI___AHUI_TooltipManaText[pid], 1002)
        call BlzFrameSetEnable(AllyHeroAbilityUI___AHUI_TooltipManaText[pid], false)
        call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_TooltipManaText[pid], false)
        
        // Горизонтальный разделитель как в стандартном Warcraft tooltip
set AllyHeroAbilityUI___AHUI_TooltipSeparator[pid]=BlzCreateFrameByType("BACKDROP", "AHUITooltipSeparator", AllyHeroAbilityUI___AHUI_TooltipRoot[pid], "", pid)
call BlzFrameSetSize(AllyHeroAbilityUI___AHUI_TooltipSeparator[pid], 0.278, 0.0012)
call BlzFrameSetPoint(AllyHeroAbilityUI___AHUI_TooltipSeparator[pid], FRAMEPOINT_TOPLEFT, AllyHeroAbilityUI___AHUI_TooltipRoot[pid], FRAMEPOINT_TOPLEFT, 0.011, - 0.047)
call BlzFrameSetTexture(AllyHeroAbilityUI___AHUI_TooltipSeparator[pid], "UI\\Widgets\\ToolTips\\Human\\HorizontalSeparator.blp", 0, false)
call BlzFrameSetLevel(AllyHeroAbilityUI___AHUI_TooltipSeparator[pid], 1002)
call BlzFrameSetEnable(AllyHeroAbilityUI___AHUI_TooltipSeparator[pid], false)
call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_TooltipSeparator[pid], false)
        
        // DESCRIPTION + TooltipBuilder content
        set AllyHeroAbilityUI___AHUI_TooltipText[pid]=BlzCreateFrameByType("TEXT", "AHUITooltipText", AllyHeroAbilityUI___AHUI_TooltipRoot[pid], "", pid)
        call BlzFrameSetSize(AllyHeroAbilityUI___AHUI_TooltipText[pid], 0.278, 0.0)
        call BlzFrameSetPoint(AllyHeroAbilityUI___AHUI_TooltipText[pid], FRAMEPOINT_TOPLEFT, AllyHeroAbilityUI___AHUI_TooltipRoot[pid], FRAMEPOINT_TOPLEFT, 0.011, - 0.050)
        call BlzFrameSetTextAlignment(AllyHeroAbilityUI___AHUI_TooltipText[pid], TEXT_JUSTIFY_TOP, TEXT_JUSTIFY_LEFT)
        call BlzFrameSetLevel(AllyHeroAbilityUI___AHUI_TooltipText[pid], 1002)
        call BlzFrameSetEnable(AllyHeroAbilityUI___AHUI_TooltipText[pid], false)
        call BlzFrameSetVisible(AllyHeroAbilityUI___AHUI_TooltipText[pid], false)

        set pid=pid + 1
    endloop
endfunction

function AllyHeroAbilityUI___AHUI_InitEvents takes nothing returns nothing
    local integer pid= 0

    set AllyHeroAbilityUI___AHUI_SelectTrigger=CreateTrigger()
    set AllyHeroAbilityUI___AHUI_DeselectTrigger=CreateTrigger()

    call TriggerAddAction(AllyHeroAbilityUI___AHUI_SelectTrigger, function AllyHeroAbilityUI___AHUI_OnSelect)
    call TriggerAddAction(AllyHeroAbilityUI___AHUI_DeselectTrigger, function AllyHeroAbilityUI___AHUI_OnDeselect)

    loop
        exitwhen pid >= bj_MAX_PLAYER_SLOTS
        call TriggerRegisterPlayerUnitEvent(AllyHeroAbilityUI___AHUI_SelectTrigger, Player(pid), EVENT_PLAYER_UNIT_SELECTED, null)
        call TriggerRegisterPlayerUnitEvent(AllyHeroAbilityUI___AHUI_DeselectTrigger, Player(pid), EVENT_PLAYER_UNIT_DESELECTED, null)
        set pid=pid + 1
    endloop
endfunction

function AllyHeroAbilityUI___AHUI_InitPlayerState takes nothing returns nothing
    local integer pid= 0

    loop
        exitwhen pid >= bj_MAX_PLAYER_SLOTS
        set AllyHeroAbilityUI___AHUI_SelectedHero[pid]=null
        set AllyHeroAbilityUI___AHUI_HoveredSlot[pid]=- 1
        set pid=pid + 1
    endloop
endfunction

function AllyHeroAbilityUI___InitAllyHeroAbilityUI takes nothing returns nothing
    set AllyHeroAbilityUI___AHUI_GameUI=BlzGetOriginFrame(ORIGIN_FRAME_GAME_UI, 0)
    set AllyHeroAbilityUI___AHUI_ConsoleBackdrop=BlzGetFrameByName("ConsoleUIBackdrop", 0)

    call AllyHeroAbilityUI___AHUI_InitPlayerState()
    call AllyHeroAbilityUI___AHUI_InitEvents()
    call AllyHeroAbilityUI___AHUI_CreateSlotFrames()
    call AllyHeroAbilityUI___AHUI_CreateTooltipFrames()

    set AllyHeroAbilityUI___AHUI_UpdateTimer=CreateTimer()
    call TimerStart(AllyHeroAbilityUI___AHUI_UpdateTimer, AllyHeroAbilityUI___AHUI_UPDATE_PERIOD, true, function AllyHeroAbilityUI___AHUI_Periodic)

    call TimerStart(CreateTimer(), AllyHeroAbilityUI___AHUI_TooltipsDelay, false, function AllyHeroAbilityUI___AHUI_EnableTooltips)
endfunction


