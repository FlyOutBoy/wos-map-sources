    if isEnemy and dmg >= 1 and BlzGetUnitAbilityCooldownRemaining(c, 'A0G0') == 0 and GetUnitAbilityLevel(c, 'A0G0') > 0 then
        call BlzStartUnitAbilityCooldown(c, 'A0G0', 10)
