            set s__AkainuSpells___AkainuSpells_T_r2[this]=0.00
            set s__AkainuSpells___AkainuSpells_T_r3[this]=0.00
            set s__AkainuSpells___AkainuSpells_T_check[this]=0
            call StartSpellUnit(s__AkainuSpells___AkainuSpells_T_c[this])
            set s__AkainuSpells___AkainuSpells_T_a[this]=GAngle2(s__AkainuSpells___AkainuSpells_T_c[this] , s__AkainuSpells___AkainuSpells_T_x[this] , s__AkainuSpells___AkainuSpells_T_y[this])
            set s__AkainuSpells___AkainuSpells_T_aoe[this]=AkainuT_DamageAoe
            set s__AkainuSpells___AkainuSpells_T_rmax[this]=AkainuT_MaxDuration

            call SetUnitAnimationByIndex(s__AkainuSpells___AkainuSpells_T_c[this], 6)
            call SetUnitTimeScale(s__AkainuSpells___AkainuSpells_T_c[this], 3.30)
            call MakeSound("war3mapimported\\Hero_Akainu_T")
            set s__AkainuSpells___AkainuSpells_T_e[this]=AddSpecialEffectTarget("war3mapImported\\wos_magmahandBig-91F172.mdl", s__AkainuSpells___AkainuSpells_T_c[this], "hand right")
            set s__AkainuSpells___AkainuSpells_T_e2[this]=AddSpecialEffectTarget("war3mapImported\\wos_magmahandBig-91F172.mdl", s__AkainuSpells___AkainuSpells_T_c[this], "hand left")

            if s__AkainuSpells___AkainuSpells_T_MUI_AkainuT == 0 then
                call AkainuSpells___AkainuTimer03Acquire()
            endif
        endfunction

    //===========================================================================
    // Инициализация и публичный интерфейс
    //===========================================================================
    function AkainuSpells___AkainuTimer03Loop takes nothing returns nothing
        call s__AkainuSpells___AkainuSpells_Q_Loop_AkainuQ()
        call s__AkainuSpells___AkainuSpells_W_Loop_AkainuW()
        call s__AkainuSpells___AkainuSpells_W2_Loop_AkainuW2()
        call s__AkainuSpells___AkainuSpells_E_Loop_AkainuE()
        call s__AkainuSpells___AkainuSpells_R_Loop_AkainuR()
        call s__AkainuSpells___AkainuSpells_T_Loop_AkainuT()
        call s__AkainuSpells___AkainuSpells_T2_Loop_AkainuT2()
    endfunction

    function AkainuSpells___InitAkainuSpells takes nothing returns nothing
        set AkainuSpells___AkainuTimer03=CreateTimer()
        set AkainuSpells___AkainuTimer03Callback=function AkainuSpells___AkainuTimer03Loop
    endfunction

    function AkainuQ_Start takes unit c,unit td returns nothing
        call s__AkainuSpells___AkainuSpells_Q_AkainuQ_Start(c , td)
    endfunction

    function AkainuW_Start takes unit c,real x,real y returns nothing
        call s__AkainuSpells___AkainuSpells_W_AkainuW_Start(c , x , y)
    endfunction

    function AkainuE_Start takes unit c,unit td returns nothing
        call s__AkainuSpells___AkainuSpells_E_AkainuE_Start(c , td)
    endfunction

    function AkainuR_Start takes unit c,real x,real y returns nothing
        call s__AkainuSpells___AkainuSpells_R_AkainuR_Start(c , x , y)
    endfunction

    function AkainuT_Start takes unit c,real x,real y returns nothing
        call s__AkainuSpells___AkainuSpells_T_AkainuT_Start(c , x , y)
    endfunction

//library AkainuSpells ends
//library AllyHeroAbilityUI:

// Информационная панель способностей выбранного союзного героя.
//
// Важные правила безопасности:
// 1. Фреймы создаются синхронно для каждого pid, но изменяются только внутри
//    прямой проверки GetLocalPlayer() == Player(pid).
// 2. GetLocalPlayer() нигде не присваивается переменной.
// 3. У каждого игрока свой контекст выбранного героя и свой набор фреймов.
// 4. Кулдауны читаются только на локальном клиенте и только для чужого героя
//    союзного игрока. Выбор собственного Hero[pid] очищает панель.
// 5. Игровые объекты, синхронные hashtable и игровое состояние из локальных
//    UI-веток не создаются и не изменяются.
// 6. Стандартные command buttons не скрываются, не перемещаются, не
//    масштабируются и не отключаются. Они используются только как визуальные якоря.

function AllyHeroAbilityUI___AHUI_OnSetPlayerAbilityAvailable takes player whichPlayer,integer abilityId,boolean available returns nothing
    if whichPlayer != null and abilityId != 0 then
        call SaveBoolean(AllyHeroAbilityUI___AHUI_AbilityAvailability, GetPlayerId(whichPlayer), abilityId, available)
    endif
endfunction

//processed hook: hook SetPlayerAbilityAvailable AllyHeroAbilityUI___AHUI_OnSetPlayerAbilityAvailable


function AllyHeroAbilityUI___AHUI_OnBlzUnitHideAbility takes unit whichUnit,integer abilityId,boolean hidden returns nothing
    if whichUnit != null and abilityId != 0 then
        call SaveBoolean(AllyHeroAbilityUI___AHUI_UnitAbilityHidden, GetHandleId(whichUnit), abilityId, hidden)
    endif
endfunction

//processed hook: hook BlzUnitHideAbility AllyHeroAbilityUI___AHUI_OnBlzUnitHideAbility


function AllyHeroAbilityUI___AHUI_OnBlzUnitDisableAbility takes unit whichUnit,integer abilityId,boolean disabled,boolean hideUI returns nothing
    if whichUnit != null and abilityId != 0 then
        call SaveBoolean(AllyHeroAbilityUI___AHUI_UnitAbilityDisabled, GetHandleId(whichUnit), abilityId, disabled)
    endif
endfunction

//processed hook: hook BlzUnitDisableAbility AllyHeroAbilityUI___AHUI_OnBlzUnitDisableAbility


function AllyHeroAbilityUI___AHUI_IsAbilityAvailable takes player owner,integer abilityId returns boolean
    local integer pid

    if owner == null or abilityId == 0 then
        return false
    endif

    set pid=GetPlayerId(owner)

    if HaveSavedBoolean(AllyHeroAbilityUI___AHUI_AbilityAvailability, pid, abilityId) then
        return LoadBoolean(AllyHeroAbilityUI___AHUI_AbilityAvailability, pid, abilityId)
    endif

    // Если SetPlayerAbilityAvailable ещё никогда не вызывался,
    // Warcraft считает ability доступной.
    return true
endfunction





function AllyHeroAbilityUI___AHUI_IsActiveSlotCandidate takes unit whichHero,player owner,integer abilityId returns boolean
    if whichHero == null or owner == null or abilityId == 0 then
        return false
    endif

    if GetUnitAbilityLevel(whichHero, abilityId) <= 0 then
        return false
    endif

    if not AllyHeroAbilityUI___AHUI_IsAbilityAvailable(owner , abilityId) then
        return false
    endif

    if LoadBoolean(AllyHeroAbilityUI___AHUI_UnitAbilityHidden, GetHandleId(whichHero), abilityId) then
        return false
    endif

    if LoadBoolean(AllyHeroAbilityUI___AHUI_UnitAbilityDisabled, GetHandleId(whichHero), abilityId) then
        return false
    endif

    return true
endfunction
function AllyHeroAbilityUI___AHUI_EnableTooltips takes nothing returns nothing
    set AllyHeroAbilityUI___AHUI_TooltipsReady=true
    call DestroyTimer(GetExpiredTimer())
endfunction
function AllyHeroAbilityUI___AHUI_GetLogicalSlot takes integer buttonX,integer buttonY returns integer
    if buttonY == 2 and buttonX >= 0 and buttonX < 4 then
        return buttonX
    elseif buttonY == 1 then
        if buttonX == 3 then
            return AllyHeroAbilityUI___AHUI_SLOT_T
        elseif buttonX == 1 then
            return AllyHeroAbilityUI___AHUI_SLOT_F
        elseif buttonX == 2 then
            return AllyHeroAbilityUI___AHUI_SLOT_G
        endif
    endif
    return - 1
endfunction

function AllyHeroAbilityUI___AHUI_GetSlotX takes integer slot returns integer
    if slot < 4 then
        return slot
    elseif slot == AllyHeroAbilityUI___AHUI_SLOT_T then
        return 3
    elseif slot == AllyHeroAbilityUI___AHUI_SLOT_F then
        return 1
    endif
    return 2
endfunction

function AllyHeroAbilityUI___AHUI_GetSlotY takes integer slot returns integer
    if slot < 4 then
        return 2
    endif
    return 1
endfunction

function AllyHeroAbilityUI___AHUI_GetOriginSlot takes integer slot returns integer
    return GetSlotByXY(AllyHeroAbilityUI___AHUI_GetSlotX(slot) , AllyHeroAbilityUI___AHUI_GetSlotY(slot))
endfunction

function AllyHeroAbilityUI___AHUI_GetSlotCenterX takes integer slot returns real
    return AllyHeroAbilityUI___AHUI_COMMAND_X0 + AllyHeroAbilityUI___AHUI_COMMAND_X_STEP * I2R(AllyHeroAbilityUI___AHUI_GetSlotX(slot))
endfunction

function AllyHeroAbilityUI___AHUI_GetSlotCenterY takes integer slot returns real
    if slot < 4 then
        return AllyHeroAbilityUI___AHUI_COMMAND_BOTTOM_Y
    endif
    return AllyHeroAbilityUI___AHUI_COMMAND_MIDDLE_Y
endfunction

// Индекс собственного набора фреймов игрока. При bj_MAX_PLAYER_SLOTS == 24
// используется только 168 элементов, что безопасно для JASS-массивов.
function AllyHeroAbilityUI___AHUI_FrameIndex takes integer pid,integer slot returns integer
    return pid * AllyHeroAbilityUI___AHUI_SLOT_COUNT + slot
endfunction

function AllyHeroAbilityUI___AHUI_GetKeyText takes integer slot returns string
    if slot == AllyHeroAbilityUI___AHUI_SLOT_Q then
        return "Q"
    elseif slot == AllyHeroAbilityUI___AHUI_SLOT_W then
        return "W"
    elseif slot == AllyHeroAbilityUI___AHUI_SLOT_E then
        return "E"
    elseif slot == AllyHeroAbilityUI___AHUI_SLOT_R then
        return "R"
    elseif slot == AllyHeroAbilityUI___AHUI_SLOT_T then
        return "T"
    elseif slot == AllyHeroAbilityUI___AHUI_SLOT_F then
        return "F"
    endif
    return "G"
endfunction

function AllyHeroAbilityUI___AHUI_ClearResolvedAbilities takes nothing returns nothing
    local integer slot= 0

    loop
        exitwhen slot >= AllyHeroAbilityUI___AHUI_SLOT_COUNT
        set AllyHeroAbilityUI___AHUI_CurrentAbility[slot]=0
        set slot=slot + 1
    endloop
endfunction

// Единственная точка отбора. Способность должна быть явно перечислена у героя
// и реально присутствовать/быть изучена. Слот задаётся вручную в конфигурации:
// это обязательно для F/G-вариантов со служебными координатами (0, 1), иначе
// их кнопки пересекаются с предметными ячейками.
// Первый rawcode каждого слота также служит fallback для ещё не изученной
// способности: она рисуется как DISBTN. Вторичные варианты перечислены после
// базовых и заменяют их во время своего реального КД либо активного SwapAbility.
function AllyHeroAbilityUI___AHUI_AddHeroAbility takes unit whichHero,integer slot,integer abilityId returns nothing
    local integer level= 0
    local integer currentId= 0
    local integer swappedAbility= 0
    local real remaining= 0.00
    local boolean currentActive= false
    local boolean candidateActive= false
    local player owner= null

    if whichHero == null or abilityId == 0 or slot < 0 or slot >= AllyHeroAbilityUI___AHUI_SLOT_COUNT then
        return
    endif

    set owner=GetOwningPlayer(whichHero)
    set level=GetUnitAbilityLevel(whichHero, abilityId)

    // Первый rawcode остаётся fallback для неизученной способности.
    if AllyHeroAbilityUI___AHUI_CurrentAbility[slot] == 0 then
        set AllyHeroAbilityUI___AHUI_CurrentAbility[slot]=abilityId
        set owner=null
        return
    endif

    if level <= 0 then
        set owner=null
        return
    endif

    set currentId=AllyHeroAbilityUI___AHUI_CurrentAbility[slot]

    set candidateActive=AllyHeroAbilityUI___AHUI_IsActiveSlotCandidate(whichHero , owner , abilityId)
    set currentActive=AllyHeroAbilityUI___AHUI_IsActiveSlotCandidate(whichHero , owner , currentId)

    if AllyHeroAbilityUI___AHUI_AllowCooldownRead then
        set remaining=BlzGetUnitAbilityCooldownRemaining(whichHero, abilityId)
    endif

    // Проверяем SwapAbility marker.
    set swappedAbility=LoadInteger(hs, GetHandleId(owner), StringHash("AHUI swap " + I2S(currentId)))

    // Приоритет:
    // 1. SwapAbility
    // 2. Новая доступная кнопка вместо скрытой/disabled старой
    // 3. Способность, которая сейчас реально ушла на CD
    if swappedAbility == abilityId and candidateActive then
        set AllyHeroAbilityUI___AHUI_CurrentAbility[slot]=abilityId

    elseif candidateActive and not currentActive then
        set AllyHeroAbilityUI___AHUI_CurrentAbility[slot]=abilityId

    elseif candidateActive and remaining > 0.05 then
        set AllyHeroAbilityUI___AHUI_CurrentAbility[slot]=abilityId
    endif

    set owner=null
endfunction
// Явный выбор текущей формы для героев, которые переключают command card через
// SetPlayerAbilityAvailable и собственное состояние, а не через SwapAbility.
function AllyHeroAbilityUI___AHUI_SetActiveHeroAbility takes unit whichHero,integer slot,integer abilityId returns nothing
    if whichHero != null and abilityId != 0 and slot >= 0 and slot < AllyHeroAbilityUI___AHUI_SLOT_COUNT and GetUnitAbilityLevel(whichHero, abilityId) > 0 then
        set AllyHeroAbilityUI___AHUI_CurrentAbility[slot]=abilityId
    endif
endfunction

function AllyHeroAbilityUI___AHUI_ConfigureHeroAbilities takes unit whichHero returns nothing
    local integer heroId= GetUnitTypeId(whichHero)
    // Проверяются только базовые unit type ID. Скины и вторичные model ID не
    // меняют GetUnitTypeId героя и поэтому здесь намеренно не перечисляются.
    if heroId == Ainz_ID then
        call AllyHeroAbilityUI___AHUI_AddHeroAbility(whichHero , AllyHeroAbilityUI___AHUI_SLOT_Q , AinzQ_ID)
        call AllyHeroAbilityUI___AHUI_AddHeroAbility(whichHero , AllyHeroAbilityUI___AHUI_SLOT_Q , AinzQ2_ID)
        call AllyHeroAbilityUI___AHUI_AddHeroAbility(whichHero , AllyHeroAbilityUI___AHUI_SLOT_Q , AinzQ3_ID)
