                            exitwhen s__FrierenSpells__FrierenSpells_E_u[this] == null
                            if SpellBool(s__FrierenSpells__FrierenSpells_E_u[this]) and IsUnitEnemy(s__FrierenSpells__FrierenSpells_E_u[this], GetOwningPlayer(s__FrierenSpells__FrierenSpells_E_c[this])) then
                                call dmgmag(s__FrierenSpells__FrierenSpells_E_c[this] , s__FrierenSpells__FrierenSpells_E_u[this] , s__FrierenSpells__FrierenSpells_E_dmg[this])
                                call ErzaPassive(s__FrierenSpells__FrierenSpells_E_c[this] , s__FrierenSpells__FrierenSpells_E_u[this] , 1)
                                call SlowUnit(s__FrierenSpells__FrierenSpells_E_c[this] , s__FrierenSpells__FrierenSpells_E_u[this] , FrierenE_Slow , FrierenE_Duration)
                                if IsUnitInGroup(s__FrierenSpells__FrierenSpells_E_u[this], s__FrierenSpells__FrierenSpells_E_g2[this]) == false then
