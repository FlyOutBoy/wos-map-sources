                        endif
                        endif
                        if s__MilimSpells__MilimEKS_fly[this] <= 0 then
                       set s__MilimSpells__MilimEKS_fly[this]=0.01
                        endif
                        call BlzSetSpecialEffectHeight(s__MilimSpells__MilimEKS_e[this], s__MilimSpells__MilimEKS_fly[this])
                        set s__MilimSpells__MilimEKS_x[this]=s__MilimSpells__MilimEKS_x1[this] + s__MilimSpells__MilimEKS_r5[this] * Cos(s__MilimSpells__MilimEKS_a[this])
                        set s__MilimSpells__MilimEKS_y[this]=s__MilimSpells__MilimEKS_y1[this] + s__MilimSpells__MilimEKS_r5[this] * Sin(s__MilimSpells__MilimEKS_a[this])
                        if s__MilimSpells__MilimEKS_r2[this] > 0.06 then
                        set s__MilimSpells__MilimEKS_r2[this]=0
                        call VisionTimed(GetOwningPlayer(s__MilimSpells__MilimEKS_c[this]) , s__MilimSpells__MilimEKS_x[this] , s__MilimSpells__MilimEKS_y[this] , s__MilimSpells__MilimEKS_aoe[this] * 2.00 , 1.00)
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_13684996917731847118.mdl" , s__MilimSpells__MilimEKS_x[this] , s__MilimSpells__MilimEKS_y[this] , GetRandomReal(0, 359) , GetRandomReal(1.5, 2) , 5.25 , GetRandomReal(240, 365)))
                        call DestroyEffect(EffectSpawn("war3mapImported\\wos_NewDirtEXNofireNoDust.mdl" , s__MilimSpells__MilimEKS_x[this] , s__MilimSpells__MilimEKS_y[this] , GetRandomReal(0, 359) , 1 , 1.5 , 0))
                        call DecorRemove(s__MilimSpells__MilimEKS_c[this] , s__MilimSpells__MilimEKS_x[this] , s__MilimSpells__MilimEKS_y[this] , s__MilimSpells__MilimEKS_aoe[this] , 40)
                        call GroupClear(s__MilimSpells__MilimEKS_g[this])
                        call GroupEnumUnitsInRange(s__MilimSpells__MilimEKS_g[this], s__MilimSpells__MilimEKS_x[this], s__MilimSpells__MilimEKS_y[this], s__MilimSpells__MilimEKS_aoe[this], NoDecor_Cond)
                        loop
                            set s__MilimSpells__MilimEKS_u[this]=FirstOfGroup(s__MilimSpells__MilimEKS_g[this])
                            exitwhen s__MilimSpells__MilimEKS_u[this] == null or s__MilimSpells__MilimEKS_r[this] == 999
                            if SpellBool(s__MilimSpells__MilimEKS_u[this]) and IsUnitEnemy(s__MilimSpells__MilimEKS_u[this], GetOwningPlayer(s__MilimSpells__MilimEKS_c[this])) and IsUnitInGroup(s__MilimSpells__MilimEKS_u[this], s__MilimSpells__MilimEKS_g2[this]) == false then
