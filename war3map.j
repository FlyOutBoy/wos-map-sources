                        call GroupClear(s__AinzSpells__AinzW_KS_g[this])
                        call GroupEnumUnitsInRange(s__AinzSpells__AinzW_KS_g[this], GetUnitX(s__AinzSpells__AinzW_KS_d[this]), GetUnitY(s__AinzSpells__AinzW_KS_d[this]), AinzW_KnightHitAoe, NoDecor_Cond)
                        loop
                            set s__AinzSpells__AinzW_KS_u[this]=FirstOfGroup(s__AinzSpells__AinzW_KS_g[this])
                            exitwhen s__AinzSpells__AinzW_KS_u[this] == null
                            if SpellBool(s__AinzSpells__AinzW_KS_u[this]) and IsUnitEnemy(s__AinzSpells__AinzW_KS_u[this], GetOwningPlayer(s__AinzSpells__AinzW_KS_c[this])) then
                                if not IsUnitInGroup(s__AinzSpells__AinzW_KS_u[this], s__AinzSpells__AinzW_KS_g2[this]) then
