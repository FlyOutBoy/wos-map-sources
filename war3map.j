        function s__TojiSpells__TojiSpells_R_Insectoids_TojiR_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__TojiSpells__TojiSpells_R_Insectoids__allocate()
            local integer n= 0
            local integer level
            local real angle
            local real radius
            local real targetX
            local real targetY
            local real targetZ
            local effect mosquito
            local integer red
            local integer green
            local integer blue
            set s__TojiSpells__TojiSpells_R_Insectoids_MUI_TojiRI=s__TojiSpells__TojiSpells_R_Insectoids_MUI_TojiRI + 1
            set s__TojiSpells__TojiSpells_R_Insectoids_m_TojiRI[s__TojiSpells__TojiSpells_R_Insectoids_MUI_TojiRI]=this
            set s__TojiSpells__TojiSpells_R_Insectoids_c[this]=NewC
