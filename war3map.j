                    if s__MahoragaSpells___MahoragaSpells_G_MUI_MahoragaG == - 1 then
                        call PauseTimer(s__MahoragaSpells___MahoragaSpells_G_t_MahoragaG)
                    endif
                    call s__MahoragaSpells___MahoragaSpells_G_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction

        function s__MahoragaSpells___MahoragaSpells_G_MahoragaG_Start takes unit NewC returns nothing
            local integer this= s__MahoragaSpells___MahoragaSpells_G__allocate()
            set s__MahoragaSpells___MahoragaSpells_G_MUI_MahoragaG=s__MahoragaSpells___MahoragaSpells_G_MUI_MahoragaG + 1
            set s__MahoragaSpells___MahoragaSpells_G_m_MahoragaG[s__MahoragaSpells___MahoragaSpells_G_MUI_MahoragaG]=this
            set s__MahoragaSpells___MahoragaSpells_G_c[this]=NewC
            set s__MahoragaSpells___MahoragaSpells_G_check[this]=1
            set s__MahoragaSpells___MahoragaSpells_G_k2[this]=GetPlayerId(GetOwningPlayer(s__MahoragaSpells___MahoragaSpells_G_c[this]))
            set s__MahoragaSpells___MahoragaSpells_G_r2[this]=0
            set s__MahoragaSpells___MahoragaSpells_G_r3[this]=0
            set s__MahoragaSpells___MahoragaSpells_G_g[this]=CreateGroup()
            set s__MahoragaSpells___MahoragaSpells_G_aoe[this]=MahoragaT_CondAoeFind
            set s__MahoragaSpells___MahoragaSpells_G_r[this]=0
            if s__MahoragaSpells___MahoragaSpells_G_MUI_MahoragaG == 0 then
                call TimerStart(s__MahoragaSpells___MahoragaSpells_G_t_MahoragaG, 0.1, true, function s__MahoragaSpells___MahoragaSpells_G_Loop_MahoragaG)
            endif
        endfunction


    //----------------------------Mahoraga-----------------------------------------------
      
     function BuffMahoragaWheel takes unit c,unit u,integer level returns nothing
            local integer i= GetPlayerId(GetOwningPlayer(c))
            if mahodummy1[i] == null or GetWidgetLife(mahodummy1[i]) < 1 then
                set mahodummy1[i]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'h0C9', GetRectCenterX(gg_rct_Caster), GetRectCenterY(gg_rct_Caster), 0)
                call UnitAddAbility(mahodummy1[i], 'A0D1')
            endif
            if level > 0 then
                if GetUnitAbilityLevel(mahodummy1[i], 'A0D1') == 0 then
                    call UnitAddAbility(mahodummy1[i], 'A0D1')
                endif
                call SetUnitAbilityLevel(mahodummy1[i], 'A0D1', level)
                call SetUnitFacing(mahodummy1[i], GAngle(mahodummy1[i] , u) * bj_RADTODEG)
                call IssueTargetOrder(mahodummy1[i], "curse", u)
            endif
        endfunction
