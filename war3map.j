                    set s__GearSystems2__KS_UnitHeight_f[this]=GetUnitFlyHeight(s__GearSystems2__KS_UnitHeight_c[this])
                if s__GearSystems2__KS_UnitHeight_r3[this] >= s__GearSystems2__KS_UnitHeight_f[this] then
                set s__GearSystems2__KS_UnitHeight_r4[this]=( ( s__GearSystems2__KS_UnitHeight_r3[this] - s__GearSystems2__KS_UnitHeight_f[this] ) / ( s__GearSystems2__KS_UnitHeight_rmax[this] * 100 ) ) * 3
                set s__GearSystems2__KS_UnitHeight_check2[this]=0
            else
                set s__GearSystems2__KS_UnitHeight_r4[this]=( ( s__GearSystems2__KS_UnitHeight_f[this] - s__GearSystems2__KS_UnitHeight_r3[this] ) / ( s__GearSystems2__KS_UnitHeight_rmax[this] * 100 ) ) * 3
                set s__GearSystems2__KS_UnitHeight_check2[this]=1
                set s__GearSystems2__KS_UnitHeight_f[this]=0
            endif
                    endif
                 
                    if s__GearSystems2__KS_UnitHeight_r[this] <= s__GearSystems2__KS_UnitHeight_rmax[this] then
                           set s__GearSystems2__KS_UnitHeight_r[this]=RoundReal(s__GearSystems2__KS_UnitHeight_r[this] + 0.03 , 3)
                            if s__GearSystems2__KS_UnitHeight_check2[this] == 0 then
                                set s__GearSystems2__KS_UnitHeight_f[this]=GetUnitFlyHeight(s__GearSystems2__KS_UnitHeight_c[this]) + s__GearSystems2__KS_UnitHeight_r4[this]
                            else
                                set s__GearSystems2__KS_UnitHeight_f[this]=GetUnitFlyHeight(s__GearSystems2__KS_UnitHeight_c[this]) - s__GearSystems2__KS_UnitHeight_r4[this]
                            endif
                            call SetFly(s__GearSystems2__KS_UnitHeight_c[this] , s__GearSystems2__KS_UnitHeight_f[this])
                        else
                            set s__GearSystems2__KS_UnitHeight_check[this]=1
                        endif
                    endif
                else
                    set s__GearSystems2__KS_UnitHeight_c[this]=null
