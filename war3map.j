        function s__ErzaESpells__Erza3Q_KS_Loop_ErzaQ takes nothing returns nothing
            local integer this
            local integer i= 0
            loop
                exitwhen i > s__ErzaESpells__Erza3Q_KS_MUI_ErzaQ
                set this=s__ErzaESpells__Erza3Q_KS_m_ErzaQ[i]
                if SpellBoolCaster(s__ErzaESpells__Erza3Q_KS_c[this]) and s__ErzaESpells__Erza3Q_KS_r[this] <= s__ErzaESpells__Erza3Q_KS_rmax[this] then
                    set s__ErzaESpells__Erza3Q_KS_r[this]=s__ErzaESpells__Erza3Q_KS_r[this] + 0.03
                    if s__ErzaESpells__Erza3Q_KS_r[this] < 0.51 then
                    call DebugUnit2(s__ErzaESpells__Erza3Q_KS_c[this])
                    endif
                    if s__ErzaESpells__Erza3Q_KS_r[this] == 0.39 then
                        set s__ErzaESpells__Erza3Q_KS_x[this]=GetUnitX(s__ErzaESpells__Erza3Q_KS_c[this]) + 100 * Cos(s__ErzaESpells__Erza3Q_KS_a[this])
                        set s__ErzaESpells__Erza3Q_KS_y[this]=GetUnitY(s__ErzaESpells__Erza3Q_KS_c[this]) + 100 * Sin(s__ErzaESpells__Erza3Q_KS_a[this])
                    elseif s__ErzaESpells__Erza3Q_KS_r[this] == 0.6 then
                        call StopSpellUnit2(s__ErzaESpells__Erza3Q_KS_c[this])
                        call DestroyEffect(s__ErzaESpells__Erza3Q_KS_e2[this])
                        call MakeSound("war3mapImported\\Hero_Erza3_Q2")
                        set s__ErzaESpells__Erza3Q_KS_e[this]=EffectSpawn("war3mapimported\\wos_by_wood_effect_yubanmeiqin_lightning_leijizhiqing.mdl" , GetUnitX(s__ErzaESpells__Erza3Q_KS_c[this]) + 110 * Cos(s__ErzaESpells__Erza3Q_KS_a[this]) , GetUnitY(s__ErzaESpells__Erza3Q_KS_c[this]) + 110 * Sin(s__ErzaESpells__Erza3Q_KS_a[this]) , s__ErzaESpells__Erza3Q_KS_a[this] * bj_RADTODEG , 1.5 , 2 , 150)
                        call DestroyEffect(s__ErzaESpells__Erza3Q_KS_e[this])
                    endif
                    if s__ErzaESpells__Erza3Q_KS_r[this] > 0.6 and s__ErzaESpells__Erza3Q_KS_r[this] < s__ErzaESpells__Erza3Q_KS_rmax[this] - 0.03 then
                        set s__ErzaESpells__Erza3Q_KS_scale[this]=s__ErzaESpells__Erza3Q_KS_scale[this] + 0.08
                        set s__ErzaESpells__Erza3Q_KS_r2[this]=s__ErzaESpells__Erza3Q_KS_r2[this] + s__ErzaESpells__Erza3Q_KS_move[this]
                        call DestroyEffect(EffectSpawn("war3mapimported\\wos_Hashirama_MADARAa (73).mdx" , s__ErzaESpells__Erza3Q_KS_x[this] + s__ErzaESpells__Erza3Q_KS_r2[this] * Cos(s__ErzaESpells__Erza3Q_KS_a[this]) , s__ErzaESpells__Erza3Q_KS_y[this] + s__ErzaESpells__Erza3Q_KS_r2[this] * Sin(s__ErzaESpells__Erza3Q_KS_a[this]) , s__ErzaESpells__Erza3Q_KS_a[this] * bj_RADTODEG , 1.85 , 1.15 , 1))
                        call GroupClear(s__ErzaESpells__Erza3Q_KS_g[this])
                        call DecorRemove(s__ErzaESpells__Erza3Q_KS_c[this] , s__ErzaESpells__Erza3Q_KS_x[this] + s__ErzaESpells__Erza3Q_KS_r2[this] * Cos(s__ErzaESpells__Erza3Q_KS_a[this]) , s__ErzaESpells__Erza3Q_KS_y[this] + s__ErzaESpells__Erza3Q_KS_r2[this] * Sin(s__ErzaESpells__Erza3Q_KS_a[this]) , s__ErzaESpells__Erza3Q_KS_aoe[this] , 40)
                        call GroupEnumUnitsInRange(s__ErzaESpells__Erza3Q_KS_g[this], s__ErzaESpells__Erza3Q_KS_x[this] + s__ErzaESpells__Erza3Q_KS_r2[this] * Cos(s__ErzaESpells__Erza3Q_KS_a[this]), s__ErzaESpells__Erza3Q_KS_y[this] + s__ErzaESpells__Erza3Q_KS_r2[this] * Sin(s__ErzaESpells__Erza3Q_KS_a[this]), s__ErzaESpells__Erza3Q_KS_aoe[this], NoDecor_Cond)
                        loop
                            set s__ErzaESpells__Erza3Q_KS_u[this]=FirstOfGroup(s__ErzaESpells__Erza3Q_KS_g[this])
                            exitwhen s__ErzaESpells__Erza3Q_KS_u[this] == null
                            if IsUnitEnemy(s__ErzaESpells__Erza3Q_KS_u[this], GetOwningPlayer(s__ErzaESpells__Erza3Q_KS_c[this])) and SpellBool(s__ErzaESpells__Erza3Q_KS_u[this]) and IsUnitInGroup(s__ErzaESpells__Erza3Q_KS_u[this], s__ErzaESpells__Erza3Q_KS_g2[this]) == false then
                                call dmgmag(s__ErzaESpells__Erza3Q_KS_c[this] , s__ErzaESpells__Erza3Q_KS_u[this] , s__ErzaESpells__Erza3Q_KS_dmg[this])
                                call DestroyEffect(EffectSpawn("war3mapimported\\wos_BY_Wood_Effect_Order_DanGe_Stf_DaJi_1_3.mdl" , GetUnitX(s__ErzaESpells__Erza3Q_KS_u[this]) , GetUnitY(s__ErzaESpells__Erza3Q_KS_u[this]) , GetRandomReal(0, 359) , 1.85 , 3 , 155))
                                call GroupAddUnit(s__ErzaESpells__Erza3Q_KS_g2[this], s__ErzaESpells__Erza3Q_KS_u[this])
                                call ErzaPassive(s__ErzaESpells__Erza3Q_KS_c[this] , s__ErzaESpells__Erza3Q_KS_u[this] , 3)
                            endif
                            call GroupRemoveUnit(s__ErzaESpells__Erza3Q_KS_g[this], s__ErzaESpells__Erza3Q_KS_u[this])
                        endloop
                        set s__ErzaESpells__Erza3Q_KS_r2[this]=s__ErzaESpells__Erza3Q_KS_r2[this] + s__ErzaESpells__Erza3Q_KS_move[this]
                        if s__ErzaESpells__Erza3Q_KS_r6[this] >= 0.0 then
                            set s__ErzaESpells__Erza3Q_KS_r6[this]=0
                            call VisionTimed(GetOwningPlayer(s__ErzaESpells__Erza3Q_KS_c[this]) , s__ErzaESpells__Erza3Q_KS_x[this] + s__ErzaESpells__Erza3Q_KS_r2[this] * Cos(s__ErzaESpells__Erza3Q_KS_a[this]) , s__ErzaESpells__Erza3Q_KS_y[this] + s__ErzaESpells__Erza3Q_KS_r2[this] * Sin(s__ErzaESpells__Erza3Q_KS_a[this]) , 650 , 2)
                        else
                            set s__ErzaESpells__Erza3Q_KS_r6[this]=s__ErzaESpells__Erza3Q_KS_r6[this] + 0.03
                        endif
                    endif
                else
                    call SetUnitTimeScale(s__ErzaESpells__Erza3Q_KS_c[this], 1)
                    if s__ErzaESpells__Erza3Q_KS_r[this] < 0.51 then
                        call DestroyEffect(s__ErzaESpells__Erza3Q_KS_e2[this])
                        call StopSpellUnit2(s__ErzaESpells__Erza3Q_KS_c[this])
                    endif
                    call DestroyGroup(s__ErzaESpells__Erza3Q_KS_g[this])
                    set s__ErzaESpells__Erza3Q_KS_g[this]=null
                    call DestroyGroup(s__ErzaESpells__Erza3Q_KS_g2[this])
                    set s__ErzaESpells__Erza3Q_KS_g2[this]=null
                    set s__ErzaESpells__Erza3Q_KS_c[this]=null
                    set s__ErzaESpells__Erza3Q_KS_e[this]=null
                    set s__ErzaESpells__Erza3Q_KS_e2[this]=null
                    set s__ErzaESpells__Erza3Q_KS_u[this]=null
                    set s__ErzaESpells__Erza3Q_KS_m_ErzaQ[i]=s__ErzaESpells__Erza3Q_KS_m_ErzaQ[s__ErzaESpells__Erza3Q_KS_MUI_ErzaQ]
                    set s__ErzaESpells__Erza3Q_KS_MUI_ErzaQ=s__ErzaESpells__Erza3Q_KS_MUI_ErzaQ - 1
                    if s__ErzaESpells__Erza3Q_KS_MUI_ErzaQ == - 1 then
                        call PauseTimer(s__ErzaESpells__Erza3Q_KS_t_ErzaQ)
                    endif
                    call s__ErzaESpells__Erza3Q_KS_deallocate(this)
                endif
                set i=i + 1
            endloop
        endfunction
        function s__ErzaESpells__Erza3Q_KS_ErzaQ_Start takes unit NewC,real NewX,real NewY returns nothing
            local integer this= s__ErzaESpells__Erza3Q_KS__allocate()
            set s__ErzaESpells__Erza3Q_KS_MUI_ErzaQ=s__ErzaESpells__Erza3Q_KS_MUI_ErzaQ + 1
            set s__ErzaESpells__Erza3Q_KS_m_ErzaQ[s__ErzaESpells__Erza3Q_KS_MUI_ErzaQ]=this
            set s__ErzaESpells__Erza3Q_KS_c[this]=NewC
            set s__ErzaESpells__Erza3Q_KS_x[this]=NewX
            set s__ErzaESpells__Erza3Q_KS_y[this]=NewY
            set s__ErzaESpells__Erza3Q_KS_r[this]=0
            set s__ErzaESpells__Erza3Q_KS_r2[this]=0
            set s__ErzaESpells__Erza3Q_KS_r6[this]=0
            set s__ErzaESpells__Erza3Q_KS_scale[this]=0.9
            call StartSpellUnit2(s__ErzaESpells__Erza3Q_KS_c[this])
            set s__ErzaESpells__Erza3Q_KS_g[this]=CreateGroup()
            set s__ErzaESpells__Erza3Q_KS_g2[this]=CreateGroup()
            set s__ErzaESpells__Erza3Q_KS_u[this]=null
            set s__ErzaESpells__Erza3Q_KS_a[this]=GAngle2(s__ErzaESpells__Erza3Q_KS_c[this] , s__ErzaESpells__Erza3Q_KS_x[this] , s__ErzaESpells__Erza3Q_KS_y[this]) // Angle Between points
            call SetUnitFacing(s__ErzaESpells__Erza3Q_KS_c[this], s__ErzaESpells__Erza3Q_KS_a[this] * bj_RADTODEG)
            set s__ErzaESpells__Erza3Q_KS_aoe[this]=Erza3Q_DamageAoe
            set s__ErzaESpells__Erza3Q_KS_dmg[this]=Erza3Q_Damage2StaticBase + ( Erza3Q_Damage2StaticStep * ( GetUnitAbilityLevel(s__ErzaESpells__Erza3Q_KS_c[this], Erza3Q_ID) - 1 ) )
            set s__ErzaESpells__Erza3Q_KS_dmg[this]=s__ErzaESpells__Erza3Q_KS_dmg[this] + GetHeroAgi(s__ErzaESpells__Erza3Q_KS_c[this], true) * ( Erza3Q_DamageAgiBase + ( Erza3Q_DamageAgiStep * ( GetUnitAbilityLevel(s__ErzaESpells__Erza3Q_KS_c[this], Erza3Q_ID) - 1 ) ) )
            set s__ErzaESpells__Erza3Q_KS_rmax[this]=0.81
            set s__ErzaESpells__Erza3Q_KS_move[this]=150
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_ev-qilangKsblue.mdl" , GetUnitX(s__ErzaESpells__Erza3Q_KS_c[this]) , GetUnitY(s__ErzaESpells__Erza3Q_KS_c[this]) , GetRandomReal(0, 359) , 0.75 , 1.5 , 1))
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_ev-qilangKsblue.mdl" , GetUnitX(s__ErzaESpells__Erza3Q_KS_c[this]) , GetUnitY(s__ErzaESpells__Erza3Q_KS_c[this]) , GetRandomReal(0, 359) , 0.75 , 1. , 1))
            call DestroyEffect(EffectSpawn("war3mapImported\\wos_ev-qilangKsblue.mdl" , GetUnitX(s__ErzaESpells__Erza3Q_KS_c[this]) , GetUnitY(s__ErzaESpells__Erza3Q_KS_c[this]) , GetRandomReal(0, 359) , 0.75 , 0.5 , 1))
            set s__ErzaESpells__Erza3Q_KS_e2[this]=AddSpecialEffectTarget("war3mapImported\\wos_obr08 (166).mdx", s__ErzaESpells__Erza3Q_KS_c[this], "weapon")
            call SetUnitTimeScale(s__ErzaESpells__Erza3Q_KS_c[this], 1)
            call SetUnitAnimationByIndex(s__ErzaESpells__Erza3Q_KS_c[this], 5)
            call MakeSound("war3mapImported\\Hero_Erza3_Q")
            if s__ErzaESpells__Erza3Q_KS_MUI_ErzaQ == 0 then
                call TimerStart(s__ErzaESpells__Erza3Q_KS_t_ErzaQ, 0.03, true, function s__ErzaESpells__Erza3Q_KS_Loop_ErzaQ)
            endif
        endfunction

        function s__ErzaESpells__Erza3W_KS_Loop_ErzaW takes nothing returns nothing
            local integer this
