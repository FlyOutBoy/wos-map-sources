                                if s__ErzaTSpells__Erza5Q_KS_k[this] != 2 then
                                    if s___ErzaTSpells__Erza5Q_KS_ee[s__ErzaTSpells__Erza5Q_KS_ee[this]+s__ErzaTSpells__Erza5Q_KS_k[this]] != null and SR5(s___ErzaTSpells__Erza5Q_KS_ee[s__ErzaTSpells__Erza5Q_KS_ee[this]+s__ErzaTSpells__Erza5Q_KS_k[this]] , s__ErzaTSpells__Erza5Q_KS_x[this] , s__ErzaTSpells__Erza5Q_KS_y[this]) > s___ErzaTSpells__Erza5Q_KS_ms[s__ErzaTSpells__Erza5Q_KS_ms[this]+s__ErzaTSpells__Erza5Q_KS_k[this]] then
                                        set s__ErzaTSpells__Erza5Q_KS_r5[this]=GAngle5(s___ErzaTSpells__Erza5Q_KS_ee[s__ErzaTSpells__Erza5Q_KS_ee[this]+s__ErzaTSpells__Erza5Q_KS_k[this]] , s__ErzaTSpells__Erza5Q_KS_x[this] , s__ErzaTSpells__Erza5Q_KS_y[this])
                                        call BlzSetSpecialEffectYaw(s___ErzaTSpells__Erza5Q_KS_ee[s__ErzaTSpells__Erza5Q_KS_ee[this]+s__ErzaTSpells__Erza5Q_KS_k[this]], s__ErzaTSpells__Erza5Q_KS_r5[this])
                                        call MoveEff(s___ErzaTSpells__Erza5Q_KS_ee[s__ErzaTSpells__Erza5Q_KS_ee[this]+s__ErzaTSpells__Erza5Q_KS_k[this]] , s___ErzaTSpells__Erza5Q_KS_ms[s__ErzaTSpells__Erza5Q_KS_ms[this]+s__ErzaTSpells__Erza5Q_KS_k[this]] , s__ErzaTSpells__Erza5Q_KS_r5[this])
                                    else
