            set s__TojiSpells__TojiSpells_R_Insectoids_centerY[this]=NewY
            set level=GetUnitAbilityLevel(NewC, TojiR_ID)
            if level < 1 then
                set level=1
            endif
            set s__TojiSpells__TojiSpells_R_Insectoids_elapsed[this]=0.0
            set s__TojiSpells__TojiSpells_R_Insectoids_scanClock[this]=0.0
            set s__TojiSpells__TojiSpells_R_Insectoids_damageClock[this]=0.0
            set s__TojiSpells__TojiSpells_R_Insectoids_casterInside[this]=false
            set s__TojiSpells__TojiSpells_R_Insectoids_invisAdded[this]=false
            set s__TojiSpells__TojiSpells_R_Insectoids_invisPrepared[this]=false
            set s__TojiSpells__TojiSpells_R_Insectoids_damagePerSecond[this]=GetHeroAgi(NewC, true) * ( TojiR_DamageAgiBase + TojiR_DamageAgiStep * ( level - 1 ) )
            set s__TojiSpells__TojiSpells_R_Insectoids_damagePerSecond[this]=s__TojiSpells__TojiSpells_R_Insectoids_damagePerSecond[this] + TojiR_DamageStaticBase + TojiR_DamageStaticStep * ( level - 1 )
            set s__TojiSpells__TojiSpells_R_Insectoids_leapBonus[this]=TojiSpells__TojiE_ConsumeLeapBonus(NewC)
            set s__TojiSpells__TojiSpells_R_Insectoids_scanGroup[this]=CreateGroup()
            set s__TojiSpells__TojiSpells_R_Insectoids_damageGroup[this]=CreateGroup()
            set s__TojiSpells__TojiSpells_R_Insectoids_affectedGroup[this]=CreateGroup()
            set s__TojiSpells__TojiSpells_R_Insectoids_keepGroup[this]=CreateGroup()
            set s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this]=StringHash("TojiR_MosquitoEffects") + this
            loop
                exitwhen n >= 48
                set angle=GetRandomReal(0.0, 2.0 * bj_PI)
                set radius=TojiR_Aoe * SquareRoot(GetRandomReal(0.0, 1.1))
                set targetX=NewX + radius * Cos(angle)
                set targetY=NewY + radius * Sin(angle)
                set targetZ=GetRandomReal(40.0, 280.0)
                if GetRandomInt(1, 2) == 1 then
                    set mosquito=AddSpecialEffect("units\\undead\\Locust\\Locust.mdl", s__TojiSpells__TojiSpells_R_Insectoids_startX[this], s__TojiSpells__TojiSpells_R_Insectoids_startY[this])
                    call BlzSetSpecialEffectScale(mosquito, GetRandomReal(1.75, 2.75))
                else
                    set mosquito=AddSpecialEffect("war3mapimported\\wos_monster_210.mdl", s__TojiSpells__TojiSpells_R_Insectoids_startX[this], s__TojiSpells__TojiSpells_R_Insectoids_startY[this])
                    call BlzSetSpecialEffectScale(mosquito, GetRandomReal(1.75 * 0.4, 2.75 * 0.4))
                endif
                set s__TojiSpells__TojiSpells_R_Insectoids_r5[this]=TojiR_DurationBase + ( TojiR_DurationStep * ( level - 1 ) )
                set red=GetRandomInt(1, 255)
                set green=GetRandomInt(1, 255)
                set blue=GetRandomInt(1, 255)
                call BlzSetSpecialEffectTimeScale(mosquito, GetRandomReal(0.5, 1))
                call BlzSetSpecialEffectPosition(mosquito, s__TojiSpells__TojiSpells_R_Insectoids_startX[this], s__TojiSpells__TojiSpells_R_Insectoids_startY[this], GetRandomReal(25, 125))
                call BlzSetSpecialEffectYaw(mosquito, Atan2(targetY - s__TojiSpells__TojiSpells_R_Insectoids_startY[this], targetX - s__TojiSpells__TojiSpells_R_Insectoids_startX[this]))
                call BlzSetSpecialEffectAlpha(mosquito, 0)
                call ColorEffDummy4(mosquito , 0 , red , green , blue , 0.35)
                call SaveEffectHandle(TojiSpells__TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], n, mosquito)
                call SaveReal(TojiSpells__TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 1000 + n, targetX)
                call SaveReal(TojiSpells__TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 2000 + n, targetY)
                call SaveReal(TojiSpells__TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 3000 + n, targetZ)
                call SaveReal(TojiSpells__TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 4000 + n, 0.80)
                call SaveInteger(TojiSpells__TojiR_Hash, s__TojiSpells__TojiSpells_R_Insectoids_effectParent[this], 12000 + n, 0)
                set n=n + 1
            endloop
            set mosquito=null
            call VisionTimed(GetOwningPlayer(NewC) , NewX , NewY , TojiR_Aoe , 0.80 + s__TojiSpells__TojiSpells_R_Insectoids_r5[this])
            call MakeSound("war3mapImported\\Hero_Toji_R")
            if s__TojiSpells__TojiSpells_R_Insectoids_MUI_TojiRI == 0 then
                call TojiSpells__TojiTimer03Acquire()
            endif
        endfunction



