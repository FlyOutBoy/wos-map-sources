//library OkarunSpells ends
//library PatriotSpells:

    // ===========================================================================
    // Order Tracking & Animation Restore Module
    // ===========================================================================
    function PatriotSpells___OnPatriotPointOrder takes nothing returns boolean
        local unit u= GetOrderedUnit()
        local integer ord= GetIssuedOrderId()
        if GetUnitTypeId(u) == Patriot_ID then
            if ord == 851971 or ord == 851986 or ord == 851990 then
                call SaveInteger(hs, GetHandleId(u), StringHash("ord_mode"), 1)
                call SaveInteger(hs, GetHandleId(u), StringHash("ord_id"), ord)
                call SaveReal(hs, GetHandleId(u), StringHash("ord_x"), GetOrderPointX())
                call SaveReal(hs, GetHandleId(u), StringHash("ord_y"), GetOrderPointY())
            endif
        endif
        set u=null
        return false
    endfunction

    function PatriotSpells___OnPatriotTargetOrder takes nothing returns boolean
        local unit u= GetOrderedUnit()
        local integer ord= GetIssuedOrderId()
        if GetUnitTypeId(u) == Patriot_ID then
            if ord == 851971 or ord == 851983 then
                call SaveInteger(hs, GetHandleId(u), StringHash("ord_mode"), 2)
                call SaveInteger(hs, GetHandleId(u), StringHash("ord_id"), ord)
                call SaveUnitHandle(hs, GetHandleId(u), StringHash("ord_target"), GetOrderTargetUnit())
            endif
        endif
        set u=null
        return false
    endfunction

    function PatriotSpells___OnPatriotImmediateOrder takes nothing returns boolean
        local unit u= GetOrderedUnit()
        local integer ord= GetIssuedOrderId()
        if GetUnitTypeId(u) == Patriot_ID then
            if ord == 851972 or ord == 851993 then
                call SaveInteger(hs, GetHandleId(u), StringHash("ord_mode"), 0)
            endif
        endif
        set u=null
        return false
    endfunction

    function Patriot_RestoreOrder takes unit c,integer animIndex returns nothing
        local integer mode= LoadInteger(hs, GetHandleId(c), StringHash("ord_mode"))
        local real ox
        local real oy
        local real dx
        local real dy
        local integer oid
        local unit tu

        if mode == 1 then
            set ox=LoadReal(hs, GetHandleId(c), StringHash("ord_x"))
            set oy=LoadReal(hs, GetHandleId(c), StringHash("ord_y"))
            set dx=ox - GetUnitX(c)
            set dy=oy - GetUnitY(c)
            if ( dx * dx + dy * dy ) > 5625.0 then
                set oid=LoadInteger(hs, GetHandleId(c), StringHash("ord_id"))
                call IssuePointOrderById(c, oid, ox, oy)
                return
            endif
        elseif mode == 2 then
            set tu=LoadUnitHandle(hs, GetHandleId(c), StringHash("ord_target"))
            if tu != null and GetWidgetLife(tu) > 0.405 then
                set oid=LoadInteger(hs, GetHandleId(c), StringHash("ord_id"))
                call IssueTargetOrderById(c, oid, tu)
                set tu=null
                return
            endif
            set tu=null
        endif

        call SetUnitAnimationByIndex(c, animIndex)
        call s__GearSystems2__KS_RemoveUnit_MyRemoveUnit_Start((c ) , (( 0.03 )*1.0) , 2 , - 1 , ( animIndex) , "") // INLINED!!
    endfunction

        function s__PatriotSpells___PatriotOrderInit_onInit takes nothing returns nothing
            local trigger tPoint= CreateTrigger()
            local trigger tTarget= CreateTrigger()
            local trigger tImmediate= CreateTrigger()
            local integer i= 0
            loop
                exitwhen i >= 16
                call TriggerRegisterPlayerUnitEvent(tPoint, Player(i), EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER, null)
                call TriggerRegisterPlayerUnitEvent(tTarget, Player(i), EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER, null)
                call TriggerRegisterPlayerUnitEvent(tImmediate, Player(i), EVENT_PLAYER_UNIT_ISSUED_ORDER, null)
                set i=i + 1
            endloop
            call TriggerAddCondition(tPoint, Condition(function PatriotSpells___OnPatriotPointOrder))
            call TriggerAddCondition(tTarget, Condition(function PatriotSpells___OnPatriotTargetOrder))
            call TriggerAddCondition(tImmediate, Condition(function PatriotSpells___OnPatriotImmediateOrder))
            set tPoint=null
            set tTarget=null
            set tImmediate=null
        endfunction

    // ===========================================================================
    // Timer Management
    // ===========================================================================
    function PatriotSpells___PatriotTimer03Acquire takes nothing returns nothing
        set PatriotSpells___PatriotTimer03Users=PatriotSpells___PatriotTimer03Users + 1
        if PatriotSpells___PatriotTimer03Users == 1 then
            call TimerStart(PatriotSpells___PatriotTimer03, 0.03, true, PatriotSpells___PatriotTimer03Callback)
        endif
    endfunction

    function PatriotSpells___PatriotTimer03Release takes nothing returns nothing
        set PatriotSpells___PatriotTimer03Users=PatriotSpells___PatriotTimer03Users - 1
        if PatriotSpells___PatriotTimer03Users <= 0 then
            set PatriotSpells___PatriotTimer03Users=0
            call PauseTimer(PatriotSpells___PatriotTimer03)
        endif
    endfunction

    // ===========================================================================
    // Core Helpers
    // ===========================================================================
    function PatriotPas takes unit c,unit td returns nothing
        local real x
        local real y
        if ( c == null or td == null ) or ( GetWidgetLife(td) <= 0.405 ) or ( BlzGetUnitAbilityCooldownRemaining(c, PatriotG_ID) > 0.1 ) then
            return
        endif
        set x=GetUnitX(td)
        set y=GetUnitY(td)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", td, "chest"))
        call s__GearSystems2__KS_MoveEffectToUnit_MoveEffectToUnit_Start((EffectSpawn("war3mapImported\\wos_Satsu-WWSFX-1.mdx" , x , y , 0.0 , 1.25 , 2.0 , 75.0) ) , (( 0.76 )*1.0) , (( 75.0 )*1.0) , ( td) , 0 , 1 , null) // INLINED!!
        call s__GearSystems2__KS_DelayedDamage_NextDmg_Start((c ) , ( td ) , (( PatriotG_DamageAgiBase * GetHeroAgi(c, true) )*1.0) , ( 0 ) , (( 0.10)*1.0)) // INLINED!!
        if LoadInteger(hs, GetHandleId(c), StringHash("patriot e")) == 1 then
        if PatriotG_CD_Atk > 0 then
            call BlzStartUnitAbilityCooldown(c, PatriotG_ID, PatriotG_CD_Atk)
            endif
        else
            call BlzStartUnitAbilityCooldown(c, PatriotG_ID, PatriotG_CD_Def)
        endif
    endfunction

    function BuffUnitPat takes unit c,unit u,integer level returns nothing
        local integer i= GetPlayerId(GetOwningPlayer(c))
        if patdummy1[i] == null or GetWidgetLife(patdummy1[i]) < 1.0 then
            set patdummy1[i]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'h0C9', GetRectCenterX(gg_rct_Caster), GetRectCenterY(gg_rct_Caster), 0.0)
            call UnitAddAbility(patdummy1[i], 'A0EG')
        endif
        if level > 0 then
            if GetUnitAbilityLevel(patdummy1[i], 'A0EG') == 0 then
                call UnitAddAbility(patdummy1[i], 'A0EG')
            endif
            call SetUnitAbilityLevel(patdummy1[i], 'A0EG', level)
            call SetUnitFacing(patdummy1[i], GAngle(patdummy1[i] , u) * bj_RADTODEG)
            call IssueTargetOrder(patdummy1[i], "innerfire", u)
        endif
    endfunction

    // ===========================================================================
    // Abilities MUI Implementation
    // ===========================================================================


        function s__PatriotSpells___PatriotSpells_Q_Loop_PatriotQ takes nothing returns nothing
            local integer i= 0
            local integer this
            local unit u= null
            local real x1
            local real y1
            local real x2
            local real y2
            local real x3
            local real y3
            local real arenaAngle
            local boolean remove

            loop
                exitwhen i > s__PatriotSpells___PatriotSpells_Q_MUI_PatriotQ
                set this=s__PatriotSpells___PatriotSpells_Q_m_PatriotQ[i]
                set remove=false

                if s__PatriotSpells___PatriotSpells_Q_c[this] == null or GetUnitTypeId(s__PatriotSpells___PatriotSpells_Q_c[this]) == 0 or not SpellBoolCaster(s__PatriotSpells___PatriotSpells_Q_c[this]) or s__PatriotSpells___PatriotSpells_Q_r[this] > s__PatriotSpells___PatriotSpells_Q_rmax[this] then
                    set remove=true
                else
                    set s__PatriotSpells___PatriotSpells_Q_r[this]=RoundReal(s__PatriotSpells___PatriotSpells_Q_r[this] + 0.03 , 3)
                    if s__PatriotSpells___PatriotSpells_Q_r[this] < PatriotQ_CastTime then
                        call DebugUnit2(s__PatriotSpells___PatriotSpells_Q_c[this])
                    endif

                    if s__PatriotSpells___PatriotSpells_Q_r[this] == PatriotQ_CastTime then
                        call MakeSound("war3mapimported\\Hero_Patriot_Q2")
                        set s__PatriotSpells___PatriotSpells_Q_e[this]=EffectSpawn4("war3mapImported\\wos_PatriotsSpear.mdx" , GetUnitX(s__PatriotSpells___PatriotSpells_Q_c[this]) + 150.0 * Cos(s__PatriotSpells___PatriotSpells_Q_a[this]) , GetUnitY(s__PatriotSpells___PatriotSpells_Q_c[this]) + 150.0 * Sin(s__PatriotSpells___PatriotSpells_Q_a[this]) , s__PatriotSpells___PatriotSpells_Q_a[this] * bj_RADTODEG , 0.65 , 1.0 , 155.0 , - 20.0)
                        set s__PatriotSpells___PatriotSpells_Q_e3[this]=EffectSpawn("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl" , GetUnitX(s__PatriotSpells___PatriotSpells_Q_c[this]) + 250.0 * Cos(s__PatriotSpells___PatriotSpells_Q_a[this]) , GetUnitY(s__PatriotSpells___PatriotSpells_Q_c[this]) + 250.0 * Sin(s__PatriotSpells___PatriotSpells_Q_a[this]) , s__PatriotSpells___PatriotSpells_Q_a[this] * bj_RADTODEG , 0.65 , 1.0 , 135.0)
                        call MoveEff(s__PatriotSpells___PatriotSpells_Q_e3[this] , 10.0 , s__PatriotSpells___PatriotSpells_Q_a[this])
                        set s__PatriotSpells___PatriotSpells_Q_k3[this]=0
                        call StopSpellUnit2(s__PatriotSpells___PatriotSpells_Q_c[this])
                    endif

                    if s__PatriotSpells___PatriotSpells_Q_r[this] >= PatriotQ_CastTime + 0.12 then
                        if s__PatriotSpells___PatriotSpells_Q_k3[this] == 0 then
                            call MoveEff(s__PatriotSpells___PatriotSpells_Q_e[this] , s__PatriotSpells___PatriotSpells_Q_move[this] , s__PatriotSpells___PatriotSpells_Q_a[this])
                            call MoveEff(s__PatriotSpells___PatriotSpells_Q_e3[this] , s__PatriotSpells___PatriotSpells_Q_move[this] , s__PatriotSpells___PatriotSpells_Q_a[this])
                        endif

                        set s__PatriotSpells___PatriotSpells_Q_x[this]=(BlzGetLocalSpecialEffectX((s__PatriotSpells___PatriotSpells_Q_e[this]))) // INLINED!!
                        set s__PatriotSpells___PatriotSpells_Q_y[this]=(BlzGetLocalSpecialEffectY((s__PatriotSpells___PatriotSpells_Q_e[this]))) // INLINED!!
                        if s__PatriotSpells___PatriotSpells_Q_move[this] > 80.0 then
                            set s__PatriotSpells___PatriotSpells_Q_move[this]=s__PatriotSpells___PatriotSpells_Q_move[this] - 1.25
                        endif

                        if s__PatriotSpells___PatriotSpells_Q_r2[this] > 0.03 then
                            set s__PatriotSpells___PatriotSpells_Q_r2[this]=0.0
                            call DecorRemove(s__PatriotSpells___PatriotSpells_Q_c[this] , s__PatriotSpells___PatriotSpells_Q_x[this] , s__PatriotSpells___PatriotSpells_Q_y[this] , s__PatriotSpells___PatriotSpells_Q_aoe[this] , PatriotQ_DecorDamage)
                            call VisionTimed(GetOwningPlayer(s__PatriotSpells___PatriotSpells_Q_c[this]) , s__PatriotSpells___PatriotSpells_Q_x[this] , s__PatriotSpells___PatriotSpells_Q_y[this] , 1000.0 , 2.0)
                            call ColorEffDummy3(EffectSpawnColor("war3mapImported\\wos_BY_Wood_Eff_Ord_YeYe_Wid_KuoSan_1.mdx" , s__PatriotSpells___PatriotSpells_Q_x[this] , s__PatriotSpells___PatriotSpells_Q_y[this] , s__PatriotSpells___PatriotSpells_Q_a[this] * bj_RADTODEG , 1.25 , 2.65 , 180.0 , 0 , 0 , 0 , 255) , 0.0 , 0 , 0 , 0 , 0.21)
                        else
                            set s__PatriotSpells___PatriotSpells_Q_r2[this]=s__PatriotSpells___PatriotSpells_Q_r2[this] + 0.03
                        endif

                        set s__PatriotSpells___PatriotSpells_Q_r5[this]=s__PatriotSpells___PatriotSpells_Q_r5[this] + s__PatriotSpells___PatriotSpells_Q_move[this]
                        set x1=LoadReal(hs, GetHandleId(s__PatriotSpells___PatriotSpells_Q_c[this]), StringHash("w x"))
                        set y1=LoadReal(hs, GetHandleId(s__PatriotSpells___PatriotSpells_Q_c[this]), StringHash("w y"))
                        set x2=LoadReal(hs, GetHandleId(s__PatriotSpells___PatriotSpells_Q_c[this]), StringHash("r x"))
                        set y2=LoadReal(hs, GetHandleId(s__PatriotSpells___PatriotSpells_Q_c[this]), StringHash("r y"))
                        set x3=LoadReal(hs, GetHandleId(s__PatriotSpells___PatriotSpells_Q_c[this]), StringHash("t x"))
                        set y3=LoadReal(hs, GetHandleId(s__PatriotSpells___PatriotSpells_Q_c[this]), StringHash("t y"))

                        if s__PatriotSpells___PatriotSpells_Q_r5[this] >= s__PatriotSpells___PatriotSpells_Q_r6[this] then
                            set s__PatriotSpells___PatriotSpells_Q_r[this]=9999.0
                        endif

                        if x1 != 0.0 and SR5(s__PatriotSpells___PatriotSpells_Q_e[this] , x1 , y1) < 150.0 then
                            set s__PatriotSpells___PatriotSpells_Q_r[this]=9999.0
                            set s__PatriotSpells___PatriotSpells_Q_k3[this]=1
                            call SaveInteger(hs, GetHandleId(s__PatriotSpells___PatriotSpells_Q_c[this]), StringHash("w act"), 1)
                            call BlzSetSpecialEffectPosition(s__PatriotSpells___PatriotSpells_Q_e[this], x1, y1, 25.0)
                        endif

                        if x2 != 0.0 and SR5(s__PatriotSpells___PatriotSpells_Q_e[this] , x2 , y2) < 275.0 then
                            set s__PatriotSpells___PatriotSpells_Q_k3[this]=1
                            set s__PatriotSpells___PatriotSpells_Q_r[this]=9999.0
                            call SaveInteger(hs, GetHandleId(s__PatriotSpells___PatriotSpells_Q_c[this]), StringHash("r act"), 1)
                            call BlzSetSpecialEffectPosition(s__PatriotSpells___PatriotSpells_Q_e[this], x2, y2, 25.0)
                        endif

                        if x3 != 0.0 or y3 != 0.0 then
                            set s__PatriotSpells___PatriotSpells_Q_r4[this]=SR5(s__PatriotSpells___PatriotSpells_Q_e[this] , x3 , y3)
                            if s__PatriotSpells___PatriotSpells_Q_check3[this] == 0 then
                                set s__PatriotSpells___PatriotSpells_Q_r7[this]=s__PatriotSpells___PatriotSpells_Q_r4[this]
                                set s__PatriotSpells___PatriotSpells_Q_check3[this]=1
                            else
                                // The T arena is one-way for the Q spear: an outward
                                // crossing stops at the inner edge, while an inward
                                // crossing remains free to carry enemies into it.
                                if s__PatriotSpells___PatriotSpells_Q_r7[this] <= PatriotT_DamageAoe - PatriotT_EdgeInset and s__PatriotSpells___PatriotSpells_Q_r4[this] > PatriotT_DamageAoe - PatriotT_EdgeInset then
                                    set s__PatriotSpells___PatriotSpells_Q_k3[this]=1
                                    call SaveInteger(hs, GetHandleId(s__PatriotSpells___PatriotSpells_Q_c[this]), StringHash("t act"), 1)
                                    set arenaAngle=Atan2(s__PatriotSpells___PatriotSpells_Q_y[this] - y3, s__PatriotSpells___PatriotSpells_Q_x[this] - x3)
                                    set s__PatriotSpells___PatriotSpells_Q_x[this]=x3 + ( PatriotT_DamageAoe - PatriotT_EdgeInset ) * Cos(arenaAngle)
                                    set s__PatriotSpells___PatriotSpells_Q_y[this]=y3 + ( PatriotT_DamageAoe - PatriotT_EdgeInset ) * Sin(arenaAngle)
                                    call BlzSetSpecialEffectPosition(s__PatriotSpells___PatriotSpells_Q_e[this], s__PatriotSpells___PatriotSpells_Q_x[this], s__PatriotSpells___PatriotSpells_Q_y[this], 25.0)
                                endif
                                set s__PatriotSpells___PatriotSpells_Q_r7[this]=s__PatriotSpells___PatriotSpells_Q_r4[this]
                            endif
                        endif

                        call GroupClear(s__PatriotSpells___PatriotSpells_Q_g[this])
                        call GroupEnumUnitsInRange(s__PatriotSpells___PatriotSpells_Q_g[this], s__PatriotSpells___PatriotSpells_Q_x[this], s__PatriotSpells___PatriotSpells_Q_y[this], s__PatriotSpells___PatriotSpells_Q_aoe[this], NoDecor_Cond)
                        loop
                            set u=FirstOfGroup(s__PatriotSpells___PatriotSpells_Q_g[this])
                            exitwhen u == null
                            if IsUnitEnemy(u, GetOwningPlayer(s__PatriotSpells___PatriotSpells_Q_c[this])) and SpellBool(u) then
                                set s__PatriotSpells___PatriotSpells_Q_k2[this]=s__PatriotSpells___PatriotSpells_Q_k2[this] + 1
                                if s__PatriotSpells___PatriotSpells_Q_k2[this] == 1 then
                                    call MakeSound("war3mapImported\\Hero_Kirito_Q2")
                                endif
                                if not IsUnitInGroup(u, s__PatriotSpells___PatriotSpells_Q_g2[this]) then
                                    call dmgphys(s__PatriotSpells___PatriotSpells_Q_c[this] , u , s__PatriotSpells___PatriotSpells_Q_dmg[this])
                                    if GetHeroLevel(s__PatriotSpells___PatriotSpells_Q_c[this]) >= 35 then
                                        call PatriotPas(s__PatriotSpells___PatriotSpells_Q_c[this] , u)
                                    endif
                                    call GroupAddUnit(s__PatriotSpells___PatriotSpells_Q_g2[this], u)
                                    call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\wos_FSAeff (198)1.mdl", u, "chest"))
                                    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", u, "chest"))
                                endif
                                if s__PatriotSpells___PatriotSpells_Q_td[this] == null then
                                    set s__PatriotSpells___PatriotSpells_Q_td[this]=u
                                endif
                                if s__PatriotSpells___PatriotSpells_Q_check4[this] == 0 then
                                    call SlowUnit(s__PatriotSpells___PatriotSpells_Q_c[this] , u , PatriotQ_SlowPercent , PatriotQ_SlowDuration)
                                endif
                                if s__PatriotSpells___PatriotSpells_Q_td[this] != null and SpellBool(s__PatriotSpells___PatriotSpells_Q_td[this]) then
                                    set x1=s__PatriotSpells___PatriotSpells_Q_x[this] + s__PatriotSpells___PatriotSpells_Q_move[this] * Cos(s__PatriotSpells___PatriotSpells_Q_a[this])
