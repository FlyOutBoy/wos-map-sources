        set NeuvilletteSpells___NeuvilletteTimer03Users=NeuvilletteSpells___NeuvilletteTimer03Users - 1
        if NeuvilletteSpells___NeuvilletteTimer03Users <= 0 then
            set NeuvilletteSpells___NeuvilletteTimer03Users=0
            call PauseTimer(NeuvilletteSpells___NeuvilletteTimer03)
        endif
    endfunction

