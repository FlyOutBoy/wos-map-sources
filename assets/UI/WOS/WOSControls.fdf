    PushedTexture "WOSQBHUDRemoveActive",
    DisabledTexture "WOSQBHUDRemoveDisabled",
    UseHighlight "WOSQBHUDRemoveHover",
}


// Ubertooltip appearance uses the native skin, not the opaque WOS panel.
// UI/war3skins.txt supplies these keys; the built-in Ubertooltip is engine-owned.
Frame "BACKDROP" "WOSNativeTooltipBackdrop" INHERITS "WOSTooltipBox" {
}

Frame "TEXT" "WOSNativeTooltipTextTemplate" {
    DecorateFileNames,
    LayerStyle "IGNORETRACKEVENTS",
    FrameFont "MasterFont", 0.011, "",
    FontColor 1.0 1.0 1.0 1.0,
    FontShadowColor 0.0 0.0 0.0 0.9,
    FontShadowOffset 0.001 -0.001,
    FontJustificationH JUSTIFYLEFT,
    FontJustificationV JUSTIFYTOP,
}

Frame "TEXT" "WOSNativeTooltipTitleTemplate" INHERITS "WOSNativeTooltipTextTemplate" {
    DecorateFileNames,
    FrameFont "MasterFont", 0.011, "",
}
