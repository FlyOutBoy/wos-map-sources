Frame "BUTTON" "WOSQBslotTemplate" {
    ControlStyle "AUTOTRACK",
}

Texture "WOSQBHUDRemoveNormal" { File "UI\WOS\QuickBuy\qb-hud-remove-normal.blp", AlphaMode "BLEND", }
Texture "WOSQBHUDRemoveActive" { File "UI\WOS\QuickBuy\qb-hud-remove-active.blp", AlphaMode "BLEND", }
