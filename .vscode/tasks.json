{
    "version": "2.0.0",

    "tasks": [
        {
            "label": "WOS Objects: 1. Export map to editable JSON",
            "type": "process",
            "command": "python",
            "args": [
                "${workspaceFolder}\\tools\\sync_war3_project.py",
                "--config",
                "${workspaceFolder}\\object-data.config.json",
                "export"
            ],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "WOS Objects: 2. Validate editable JSON",
            "type": "process",
            "command": "python",
            "args": [
                "${workspaceFolder}\\tools\\sync_war3_project.py",
                "--config",
                "${workspaceFolder}\\object-data.config.json",
                "check"
            ],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "WOS Objects: 3. Save JSON and J into map folder",
            "type": "process",
            "command": "python",
            "args": [
                "${workspaceFolder}\\tools\\sync_war3_project.py",
                "--config",
                "${workspaceFolder}\\object-data.config.json",
                "save"
            ],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "WOS Objects: Prove lossless binary round-trip",
            "type": "process",
            "command": "python",
            "args": [
                "${workspaceFolder}\\tools\\war3_object_data.py",
                "--config",
                "${workspaceFolder}\\object-data.config.json",
                "roundtrip"
            ],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "WOS Objects: Import from unpacked map",
            "type": "process",
            "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-STA",
                "-File",
                "${workspaceFolder}\\.vscode\\import-object-data-from-map.ps1"
            ],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "WOS Imports: Fix dotted filenames and all references",
            "type": "process",
            "command": "python",
            "args": [
                "${workspaceFolder}\\tools\\fix_war3_import_paths.py",
                "--config",
                "${workspaceFolder}\\object-data.config.json",
                "--interactive"
            ],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": true },
            "problemMatcher": []
        },
        {
            "label": "WOS Sources: Import triggers and code from unpacked map",
            "type": "process",
            "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-STA",
                "-File",
                "${workspaceFolder}\\.vscode\\import-triggers-and-code-from-map.ps1"
            ],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "WOS Sources: Apply trigger enabled settings",
            "type": "process",
            "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\apply-trigger-settings.ps1"
            ],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "WOS: Compile all JASS/vJASS (auto dependencies)",

            "type": "process",

            "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",

            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\compile-vjass.ps1",
                "-SourceRoot",
                "${workspaceFolder}\\triggers"
            ],

            "group": {
                "kind": "build",
                "isDefault": true
            },

            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },

            "problemMatcher": []
        },

        {
            "label": "WOS: Copy current JASS for World Editor",

            "type": "process",

            "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",

            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\copy-for-we.ps1",
                "-ActiveFile",
                "${file}"
            ],

            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },

            "problemMatcher": []
        },

        {
            "label": "WOS: BUILD + RUN TEST MAP",

            "type": "process",

            "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",

            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\build-run-w3-map.ps1",
                "-Target",
                "Test"
            ],

            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },

            "problemMatcher": []
        },

        {
            "label": "WOS: BUILD + RUN MAIN MAP",

            "type": "process",

            "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",

            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\build-run-w3-map.ps1",
                "-Target",
                "Main"
            ],

            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },

            "problemMatcher": []
        }
    ]
}
