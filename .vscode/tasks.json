{
    "version": "2.0.0",

    "tasks": [
        {
            "label": "WOS Objects: 1. Export map to editable JSON",
            "type": "process",
            "command": "python",
            "args": [
                "${workspaceFolder}\\tools\\war3_object_workspace.py",
                "--config",
                "${workspaceFolder}\\object-data.config.json",
                "export"
            ],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "WOS Objects: 2. Validate editable JSON",
            "type": "process",
            "command": "python",
            "args": [
                "${workspaceFolder}\\tools\\war3_object_workspace.py",
                "--config",
                "${workspaceFolder}\\object-data.config.json",
                "check"
            ],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "WOS Objects: 3. Save JSON into map folder",
            "type": "process",
            "command": "python",
            "args": [
                "${workspaceFolder}\\tools\\war3_object_workspace.py",
                "--config",
                "${workspaceFolder}\\object-data.config.json",
                "import"
            ],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "WOS Objects: Prove lossless binary round-trip",
            "type": "process",
            "command": "python",
            "args": [
                "${workspaceFolder}\\tools\\war3_object_data.py",
                "--config",
                "${workspaceFolder}\\object-data.config.json",
                "roundtrip"
            ],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "WOS: Compile all JASS/vJASS (auto dependencies)",

            "type": "process",

            "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",

            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\compile-vjass.ps1",
                "-SourceRoot",
                "${workspaceFolder}\\triggers"
            ],

            "group": {
                "kind": "build",
                "isDefault": true
            },

            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },

            "problemMatcher": []
        },

        {
            "label": "WOS: Copy current JASS for World Editor",

            "type": "process",

            "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",

            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\copy-for-we.ps1",
                "-ActiveFile",
                "${file}"
            ],

            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },

            "problemMatcher": []
        },

        {
            "label": "WOS: BUILD + RUN TEST MAP",

            "type": "process",

            "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",

            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\build-run-w3-map.ps1",
                "-Target",
                "Test"
            ],

            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },

            "problemMatcher": []
        },

        {
            "label": "WOS: BUILD + RUN MAIN MAP",

            "type": "process",

            "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",

            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\build-run-w3-map.ps1",
                "-Target",
                "Main"
            ],

            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },

            "problemMatcher": []
        }
    ]
}
